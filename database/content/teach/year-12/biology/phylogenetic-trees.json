                "size": 22,
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "same structure, different jobs",
                "size": 20,
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Human, whale, bat and cat forelimbs share one pattern of bones.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Shared bone pattern highlighted",
            "items": [
              {
                "kind": "rect",

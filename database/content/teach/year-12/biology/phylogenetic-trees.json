{
  "level": "Year 12",
  "subject": "biology",
  "title": "Phylogenetic trees",
  "frames": [
    {
      "heading": "What is a phylogenetic tree?",
      "lines": [
        {
          "say": "A phylogenetic tree shows how species are related through shared ancestors.",
          "write": "phylogenetic tree"
        },
        {
          "say": "We build trees from body structures and from DNA and protein sequences.",
          "write": "structure + molecules"
        },
        {
          "say": "Let us start with the evidence from body form."
        }
      ]
    },
    {
      "heading": "Evidence from body form",
      "lines": [
        {
          "say": "Homologous structures share the same basic structure, from a common ancestor.",
          "write": "homologous = same structure",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Forelimbs of four mammals",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 40,
                "w": 120,
                "h": 50,
                "fill": "blue",
                "label": "Human"
              },
              {
                "kind": "rect",
                "x": 150,
                "y": 40,
                "w": 120,
                "h": 50,
                "fill": "teal",
                "label": "Whale"

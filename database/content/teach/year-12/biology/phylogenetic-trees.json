    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Analogous structures do not show close relationship. Only homologous ones do.",
          "write": "✗ analogous = related"
        },
        {
          "say": "Do not read relatedness from the order of the tips.",
          "write": "✗ tip order"
        },
        {
          "say": "Humans did not evolve from chimps. Both come from a shared ancestor.",
          "write": "✗ from chimps"
        },
        {
          "say": "A group missing some descendants is not a clade.",
          "write": "clade needs ALL"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Homologous shows ancestry. Analogous shows convergence. Vestigial shows past use.",
          "write": "homologous / analogous"

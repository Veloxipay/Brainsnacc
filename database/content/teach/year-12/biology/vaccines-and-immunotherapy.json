    {
      "heading": "Making monoclonal antibodies",
      "lines": [
        {
          "say": "Monoclonal antibodies are identical, from one clone, binding one epitope.",
          "write": "monoclonal antibodies"
        },
        {
          "say": "Inject a mouse with antigen, then take plasma cells from its spleen.",
          "write": "1. plasma cells",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Plasma and myeloma cells",
            "items": [

                "w": 153,
                "h": 70,
                "fill": "green",
                "label": "Hybridoma"
              }
            ]
          }
        },
        {
          "say": "Plasma cells make antibody but do not divide. Fuse them with myeloma cells.",
          "write": "2. fuse with myeloma"
        },

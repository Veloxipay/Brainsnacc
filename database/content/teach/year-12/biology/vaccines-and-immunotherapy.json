        },
        {
          "say": "If the real pathogen comes, memory cells give a fast secondary response.",
          "write": "secondary response"
        },
        {
          "say": "Boosters raise antibody levels and make more memory cells.",
          "write": "booster"
        },
        {
          "say": "Flu vaccines are updated because the virus surface antigens change.",
          "write": "flu changes"
        }
      ]
    },
    {
      "heading": "Types of vaccine",
      "lines": [
        {
          "say": "Live attenuated: a weakened pathogen. Strong immunity, not for weak immune systems.",
          "write": "live attenuated"
        },
        {
          "say": "Inactivated: the whole pathogen killed. Safer, but usually needs boosters.",
          "write": "inactivated"
        },
        {
          "say": "Subunit: just selected antigens. Toxoid: an inactivated toxin, like tetanus.",
          "write": "subunit, toxoid"
        },
        {
          "say": "mRNA vaccines make cells briefly build a protein. The mRNA never changes DNA.",
          "write": "mRNA"
        },
        {
          "say": "Viral vector: a harmless virus carries the antigen gene in.",
          "write": "viral vector"
        },
        {
          "say": "An adjuvant strengthens the immune response.",
          "write": "adjuvant"
        }
      ]
    },

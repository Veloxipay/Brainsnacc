    {
      "heading": "Method, safety and ethics",
      "lines": [
        {
          "say": "Write numbered steps so someone else could repeat it exactly.",
          "write": "repeatable method"
        },
        {
          "say": "Do at least three replicates at each level, then average.",
          "write": "≥ 3 replicates"
        },
        {
          "say": "Run a quick pilot test first to check the method works.",
          "write": "pilot test"
        },
        {
          "say": "Do a risk assessment: hazard, risk, and how you reduce it.",
          "write": "risk assessment"
        },
        {
          "say": "Use yeast, plants or bacteria instead of animals. Report all data honestly.",
          "write": "ethics"
        }
      ]
    },

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Do not write a question that fails to name the variables.",
          "write": "name the variables"
        },
        {
          "say": "Do not say your results prove the hypothesis.",
          "write": "✗ prove"
        },
        {
          "say": "Repeats improve precision, not accuracy.",
          "write": "✗ repeats fix systematic"
        },
        {
          "say": "Never change more than one variable at a time.",
          "write": "one at a time"
        }
      ]
    },

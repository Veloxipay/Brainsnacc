{
  "level": "Year 12",
  "subject": "biology",
  "title": "Planning your practical investigation and poster",
  "frames": [
    {
      "heading": "A focused research question",
      "lines": [
        {
          "say": "Your investigation must link to Unit 3 or Unit 4 content.",
          "write": "link to Unit 3 or 4"
        },
        {
          "say": "Pick something safe, measurable, and repeatable in the time you have.",
          "write": "safe, measurable, repeatable"
        },
        {
          "say": "Weak question: does temperature affect enzymes? Too broad.",
          "write": "✗ too broad"
        },
        {
          "say": "Strong: how does temperature affect oxygen production by potato catalase?",
          "write": "name both variables"
        },
        {
          "say": "A hypothesis says: if this changes, then that changes, because of biology.",
          "write": "if… then… because…"
        },
        {
          "say": "Data never prove a hypothesis. They support it or do not support it.",
          "write": "support, not prove"
        }
      ]
    },

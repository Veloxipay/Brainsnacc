                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "A lysosome fuses with it, and enzymes break the pathogen down.",
          "write": "3. lysosome digests",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 302,
            "alt": "Lysosome digests bacterium",

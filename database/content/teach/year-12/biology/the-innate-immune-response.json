              {
                "kind": "circle",
                "x": 390,
                "y": 150,
                "r": 25,
                "fill": "red",
                "label": "bacterium"
              }
            ]
          }
        },
        {
          "say": "Its membrane wraps around, making a vesicle called a phagosome.",
          "write": "2. phagosome",
          "draw": {

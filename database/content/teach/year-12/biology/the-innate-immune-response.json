    {
      "heading": "Phagocytosis",
      "lines": [
        {
          "say": "A phagocyte binds to the pathogen using surface receptors.",
          "write": "1. bind",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Phagocyte meets bacterium",
            "items": [
              {
                "kind": "circle",

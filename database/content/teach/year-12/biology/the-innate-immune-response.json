{
  "level": "Year 12",
  "subject": "biology",
  "title": "The innate immune response",
  "frames": [
    {
      "heading": "The second line of defence",
      "lines": [
        {
          "say": "If pathogens get past the skin, the second line takes over.",
          "write": "2nd line = innate"
        },
        {
          "say": "It is non-specific. The same response for any pathogen.",
          "write": "non-specific"
        },
        {
          "say": "It is rapid, starting within minutes to hours.",
          "write": "rapid"
        },
        {
          "say": "It has no memory. It does not get stronger next time.",
          "write": "no memory"
        },
        {
          "say": "Cells signal each other with cytokines, small signalling proteins.",
          "write": "cytokines"
        }
      ]
    },
    {
      "heading": "Inflammation, step by step",
      "lines": [

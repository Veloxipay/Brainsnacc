{
  "level": "Year 12", "subject": "biology", "title": "Unit 3 summary and memory tips",
  "frames": [
    { "heading": "Nucleic acids and the code",
      "lines": [
        { "say": "A nucleotide is a phosphate, a sugar and a base.", "write": "phosphate + sugar + base" },
        { "say": "Apple in the tree, car in the garage. A with T, C with G.",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Base pairs A-T and C-G, with U in RNA", "items": [
            {"kind": "rect", "x": 40, "y": 50, "w": 140, "h": 50, "fill": "red", "label": "A – T"},
            {"kind": "rect", "x": 210, "y": 50, "w": 140, "h": 50, "fill": "blue", "label": "C – G"},
            {"kind": "rect", "x": 380, "y": 50, "w": 140, "h": 50, "fill": "orange", "label": "A – U (RNA)", "change": "add"},
            {"kind": "text", "x": 280, "y": 160, "text": "%A = %T, %G = %C", "size": 22, "anchor": "middle"}
          ]}},
        { "say": "If A is 20 percent, T is 20, so G and C are 30 each.", "write": "A 20% → G = C = 30%" },
        { "say": "The code is DUNT. Degenerate, universal, non-overlapping, triplet.", "write": "DUNT" }
      ] },
    { "heading": "From gene to protein",
      "lines": [
        { "say": "Gene expression is copy, edit, read.",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Copy, edit, read", "items": [
            {"kind": "rect", "x": 10, "y": 60, "w": 160, "h": 70, "fill": "blue", "label": "copy: transcribe"},
            {"kind": "arrow", "x": 175, "y": 95, "x2": 200, "y2": 95, "color": "black", "change": "add"},
            {"kind": "rect", "x": 205, "y": 60, "w": 150, "h": 70, "fill": "orange", "label": "edit: process", "change": "add"},
            {"kind": "arrow", "x": 360, "y": 95, "x2": 385, "y2": 95, "color": "black", "change": "add"},
            {"kind": "rect", "x": 390, "y": 60, "w": 160, "h": 70, "fill": "green", "label": "read: translate", "change": "add"}
          ]}},
        { "say": "Processing adds a cap and a tail, and splices out introns.", "write": "introns are intruders" },
        { "say": "Protein shape decides function. Denaturing ruins the shape, not the peptide bonds.", "write": "shape = function" },
        { "say": "Secreted proteins go rough ER, Golgi, then exocytosis.", "write": "ER → Golgi → out" }
      ] },
    { "heading": "The trp operon",
      "lines": [
        { "say": "Think of a thermostat. Too much tryptophan switches the factory off.", "write": "high trp → OFF",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Repressor with tryptophan blocks the operator", "items": [
            {"kind": "rect", "x": 20, "y": 110, "w": 100, "h": 44, "fill": "green", "label": "promoter"},
            {"kind": "rect", "x": 120, "y": 110, "w": 100, "h": 44, "fill": "red", "label": "operator"},
            {"kind": "rect", "x": 220, "y": 110, "w": 320, "h": 44, "fill": "blue", "label": "trpE D C B A"},
            {"kind": "rect", "x": 125, "y": 60, "w": 90, "h": 46, "fill": "purple", "label": "repressor", "change": "add"},
            {"kind": "circle", "x": 230, "y": 50, "r": 16, "fill": "yellow", "label": "trp", "change": "add"}
          ]}},
        { "say": "Tryptophan activates the repressor. It binds the operator and blocks RNA polymerase.", "write": "repressor → operator" },
        { "say": "Attenuation. High trp, three four stops the score. Low trp, two three lets it be.", "write": "3–4 stop, 2–3 go" }
      ] },
    { "heading": "The DNA toolkit",
      "lines": [
        { "say": "Restriction enzymes cut. Ligase glues. Sticky ends are like Velcro.", "write": "cut + glue" },
        { "say": "PCR goes 95, 55, 72. Don't always eat.", "write": "Denature, Anneal, Extend",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "PCR temperatures", "items": [
            {"kind": "rect", "x": 20, "y": 60, "w": 160, "h": 70, "fill": "red", "label": "95 °C denature"},
            {"kind": "rect", "x": 200, "y": 60, "w": 160, "h": 70, "fill": "blue", "label": "55 °C anneal", "change": "add"},
            {"kind": "rect", "x": 380, "y": 60, "w": 160, "h": 70, "fill": "orange", "label": "72 °C extend", "change": "add"},
            {"kind": "text", "x": 280, "y": 170, "text": "copies double each cycle: 2ⁿ", "size": 20, "anchor": "middle"}
          ]}},
        { "say": "In gels, run to red. Small fragments travel furthest.", "write": "small = further" },
        { "say": "Recombinant bacteria grow on ampicillin, not tetracycline.", "write": "amp ✓ tet ✗" },
        { "say": "Transgenic means trans-species. A gene from another species.", "write": "transgenic = other species" }
      ] },
    { "heading": "Enzymes and coenzymes",
      "lines": [
        { "say": "Enzymes rise to an optimum temperature, then denature.", "write": "optimum, then denature" },
        { "say": "Competitive inhibitors block the active site. Non-competitive bind elsewhere.", "write": "competitive vs non-comp." },
        { "say": "Coenzymes are rechargeable batteries. ATP charged, ADP flat.",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "ATP charged battery, ADP flat battery", "items": [
            {"kind": "rect", "x": 60, "y": 60, "w": 160, "h": 70, "fill": "green", "label": "ATP: full"},
            {"kind": "arrow", "x": 225, "y": 80, "x2": 330, "y2": 80, "color": "red", "change": "add"},
            {"kind": "arrow", "x": 330, "y": 115, "x2": 225, "y2": 115, "color": "blue", "change": "add"},
            {"kind": "rect", "x": 340, "y": 60, "w": 160, "h": 70, "fill": "grey", "label": "ADP + Pi: flat"},
            {"kind": "text", "x": 280, "y": 170, "text": "recharged and reused", "size": 20, "anchor": "middle"}
          ]}},
        { "say": "P for photosynthesis. NADPH in plants' light reactions. NADH in respiration.", "write": "NADPH photo, NADH resp" }
      ] },
    { "heading": "Photosynthesis",
      "lines": [
        { "say": "Light in the thylakoid, Calvin in the stroma.",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Two stages linked by ATP and NADPH", "items": [
            {"kind": "rect", "x": 20, "y": 70, "w": 200, "h": 80, "fill": "green", "label": "thylakoid: light"},
            {"kind": "rect", "x": 340, "y": 70, "w": 200, "h": 80, "fill": "orange", "label": "stroma: Calvin"},
            {"kind": "arrow", "x": 225, "y": 110, "x2": 335, "y2": 110, "color": "black", "change": "add"},
            {"kind": "text", "x": 280, "y": 95, "text": "ATP, NADPH", "size": 16, "anchor": "middle", "change": "add"},
            {"kind": "text", "x": 120, "y": 190, "text": "O₂ from water", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "The oxygen released comes from water, not carbon dioxide.", "write": "O₂ from H₂O" },
        { "say": "Rubisco can bind oxygen. That's wasteful photorespiration.", "write": "photorespiration" },
        { "say": "C4 separates in space. CAM is cacti at midnight.", "write": "C4 space, CAM time" }
      ] },
    { "heading": "Respiration",
      "lines": [
        { "say": "Get kids excited. Glycolysis, Krebs, electron transport chain.", "write": "G → K → E",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "ATP from each respiration stage", "items": [
            {"kind": "rect", "x": 20, "y": 60, "w": 150, "h": 70, "fill": "yellow", "label": "cytosol: 2"},
            {"kind": "rect", "x": 190, "y": 60, "w": 150, "h": 70, "fill": "orange", "label": "matrix: 2"},
            {"kind": "rect", "x": 360, "y": 60, "w": 180, "h": 70, "fill": "red", "label": "cristae: 26–28", "change": "highlight"},
            {"kind": "text", "x": 280, "y": 170, "text": "about 30–32 ATP", "size": 22, "anchor": "middle", "bold": true}
          ]}},
        { "say": "Oxygen is the last stop on the electron train. It forms water.", "write": "O₂: final acceptor" },
        { "say": "Muscles get lactic. Yeast gets ethanol and carbon dioxide. Just two ATP.", "write": "fermentation: 2 ATP" },
        { "say": "A limiting factor is the slowest walker. A plateau means someone else is slowest.", "write": "plateau → new limiter" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "DNA makes RNA makes protein. Shape decides function.", "write": "DNA → RNA → protein" },
        { "say": "Cut, copy, sort and paste DNA with the toolkit.", "write": "cut, copy, sort, paste" },
        { "say": "Coenzymes shuttle energy between the stages.", "write": "loaded ⇄ unloaded" },
        { "say": "Photosynthesis stores energy. Respiration releases it as ATP.", "write": "store vs release" }
      ] }
  ]
}

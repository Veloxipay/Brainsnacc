{
  "level": "Year 12", "subject": "biology", "title": "Human evolution",
  "frames": [
    { "heading": "Where humans fit",
      "lines": [
        { "say": "Humans sit inside nested groups. Mammals, primates, hominoids, hominids, hominins.",
          "draw": {"type": "shapes", "width": 560, "height": 300, "alt": "Nested groups from mammals down to hominins", "items": [
            {"kind": "rect", "x": 20, "y": 20, "w": 520, "h": 260, "fill": "grey", "label": ""},
            {"kind": "text", "x": 40, "y": 45, "text": "mammals", "size": 18},
            {"kind": "rect", "x": 60, "y": 60, "w": 450, "h": 200, "fill": "blue"},
            {"kind": "text", "x": 80, "y": 85, "text": "primates", "size": 18, "color": "white"},
            {"kind": "rect", "x": 100, "y": 100, "w": 380, "h": 140, "fill": "teal"},
            {"kind": "text", "x": 120, "y": 125, "text": "hominoids", "size": 18},
            {"kind": "rect", "x": 140, "y": 140, "w": 310, "h": 85, "fill": "orange"},
            {"kind": "text", "x": 160, "y": 165, "text": "hominids", "size": 18},
            {"kind": "rect", "x": 290, "y": 165, "w": 140, "h": 50, "fill": "yellow", "label": "hominins", "change": "highlight"}
          ]}},
        { "say": "Primates have grasping hands, forward-facing eyes and 3D vision.", "write": "primates: grasp + 3D vision" },
        { "say": "Hominins are the human lineage after the split from chimpanzees. They walk upright.", "write": "hominin = bipedal lineage" },
        { "say": "That split was roughly 6 to 7 million years ago.", "write": "split ~6–7 mya" },
        { "say": "We didn't evolve from chimps. We share a common ancestor.", "write": "common ancestor" }
      ] },
    { "heading": "Bipedalism",
      "lines": [
        { "say": "In a chimp, the foramen magnum sits towards the back of the skull.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Chimp skull with foramen magnum at the back", "items": [
            {"kind": "circle", "x": 160, "y": 110, "r": 70, "fill": "grey"},
            {"kind": "circle", "x": 205, "y": 165, "r": 12, "fill": "black"},
            {"kind": "text", "x": 160, "y": 215, "text": "chimp", "size": 18, "anchor": "middle"},
            {"kind": "circle", "x": 400, "y": 110, "r": 70, "fill": "grey"},
            {"kind": "text", "x": 400, "y": 215, "text": "hominin", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "In a hominin, it moves underneath. The head balances on an upright spine.", "write": "foramen magnum central",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Hominin skull with foramen magnum underneath", "items": [
            {"kind": "circle", "x": 160, "y": 110, "r": 70, "fill": "grey"},
            {"kind": "circle", "x": 205, "y": 165, "r": 12, "fill": "black"},
            {"kind": "text", "x": 160, "y": 215, "text": "chimp", "size": 18, "anchor": "middle"},
            {"kind": "circle", "x": 400, "y": 110, "r": 70, "fill": "grey"},
            {"kind": "circle", "x": 400, "y": 178, "r": 12, "fill": "black", "change": "add"},
            {"kind": "text", "x": 400, "y": 215, "text": "hominin", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "An S-shaped spine and a short, bowl-shaped pelvis help balance.", "write": "S-spine, bowl pelvis" },
        { "say": "Femurs angle inwards. The big toe lines up and the foot is arched.", "write": "angled femur, arched foot" },
        { "say": "Bipedalism came well before big brains.", "write": "upright first, brain later" }
      ] },
    { "heading": "Bigger brains, flatter faces",
      "lines": [
        { "say": "Cranial capacity grew over time.",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Bar chart of cranial capacity", "items": [
            {"kind": "rect", "x": 40, "y": 190, "w": 90, "h": 60, "fill": "grey", "label": "~450"},
            {"kind": "rect", "x": 160, "y": 160, "w": 90, "h": 90, "fill": "orange", "label": "~600", "change": "add"},
            {"kind": "rect", "x": 280, "y": 100, "w": 90, "h": 150, "fill": "teal", "label": "~1000", "change": "add"},
            {"kind": "rect", "x": 400, "y": 50, "w": 90, "h": 200, "fill": "blue", "label": "~1350", "change": "add"},
            {"kind": "text", "x": 85, "y": 272, "text": "Australop.", "size": 14, "anchor": "middle"},
            {"kind": "text", "x": 205, "y": 272, "text": "H. habilis", "size": 14, "anchor": "middle"},
            {"kind": "text", "x": 325, "y": 272, "text": "H. erectus", "size": 14, "anchor": "middle"},
            {"kind": "text", "x": 445, "y": 272, "text": "H. sapiens", "size": 14, "anchor": "middle"}
          ]}},
        { "say": "From about 400 cubic centimetres to about 1350 in Homo sapiens.", "write": "~400 → ~1350 cm³" },
        { "say": "The skull got rounder. Brow ridges shrank. The face got flatter.", "write": "less prognathism" },
        { "say": "Teeth got smaller, in a curved arch. And we have a chin.", "write": "parabolic arch, chin" }
      ] },
    { "heading": "Tools and culture",
      "lines": [
        { "say": "Culture is learned behaviour passed on, like tools, language and art.", "write": "culture = learned" },
        { "say": "Homo habilis made simple Oldowan stone flakes.", "write": "H. habilis: Oldowan" },
        { "say": "Homo erectus shaped symmetrical hand axes, and is linked to fire.", "write": "H. erectus: hand axes, fire" },
        { "say": "Neanderthals used fire, clothing and buried some dead.", "write": "Neanderthals" },
        { "say": "Tools and fire got more energy from food, and helped in the cold.", "write": "culture + genes" }
      ] },
    { "heading": "A bushy tree, not a ladder",
      "lines": [
        { "say": "Lucy was Australopithecus afarensis. She walked upright with an ape-sized brain.", "write": "Lucy: A. afarensis" },
        { "say": "Several hominin species lived at the same time. Many lineages ended.",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Branching tree of hominins with dead ends", "items": [
            {"kind": "line", "x": 280, "y": 270, "x2": 280, "y2": 200, "color": "black"},
            {"kind": "line", "x": 280, "y": 200, "x2": 140, "y2": 120, "color": "grey"},
            {"kind": "line", "x": 280, "y": 200, "x2": 330, "y2": 130, "color": "black"},
            {"kind": "line", "x": 330, "y": 130, "x2": 230, "y2": 60, "color": "grey"},
            {"kind": "line", "x": 330, "y": 130, "x2": 420, "y2": 30, "color": "blue", "change": "highlight"},
            {"kind": "text", "x": 140, "y": 110, "text": "ended", "size": 16, "anchor": "middle", "color": "red", "change": "add"},
            {"kind": "text", "x": 230, "y": 50, "text": "Neanderthals", "size": 16, "anchor": "middle", "change": "add"},
            {"kind": "text", "x": 470, "y": 30, "text": "H. sapiens", "size": 16, "anchor": "middle"}
          ]}},
        { "say": "Neanderthals died out around 40 thousand years ago.", "write": "~40 000 years ago" },
        { "say": "Ancient DNA shows our species interbred with Neanderthals and Denisovans.", "write": "interbreeding: DNA" }
      ] },
    { "heading": "Out of Africa",
      "lines": [
        { "say": "The oldest Homo sapiens fossils are from Africa, about 300 thousand years old.", "write": "~300 000 years, Africa" },
        { "say": "Groups later spread out across Asia, Europe, Australia and the Americas.",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Arrows spreading from Africa to other continents", "items": [
            {"kind": "circle", "x": 230, "y": 170, "r": 50, "fill": "orange", "label": "Africa"},
            {"kind": "arrow", "x": 260, "y": 130, "x2": 260, "y2": 50, "color": "black", "change": "add"},
            {"kind": "text", "x": 260, "y": 40, "text": "Europe", "size": 16, "anchor": "middle", "change": "add"},
            {"kind": "arrow", "x": 280, "y": 160, "x2": 400, "y2": 110, "color": "black", "change": "add"},
            {"kind": "text", "x": 430, "y": 100, "text": "Asia", "size": 16, "change": "add"},
            {"kind": "arrow", "x": 280, "y": 190, "x2": 460, "y2": 240, "color": "black", "change": "add"},
            {"kind": "text", "x": 470, "y": 260, "text": "Australia", "size": 16, "anchor": "middle", "change": "add"}
          ]}},
        { "say": "People reached Australia at least 50 thousand years ago, crossing open sea.", "write": "Australia: ≥ 50 000 years" },
        { "say": "African populations have the most mitochondrial DNA diversity. That supports an African origin.", "write": "most mtDNA diversity: Africa" }
      ] },
    { "heading": "Watch out and remember",
      "lines": [
        { "say": "Hominid means great apes and humans. Hominin means just our lineage.", "write": "hominid ≠ hominin" },
        { "say": "Bipedalism is the hominin trademark, and it came first.", "write": "upright first" },
        { "say": "The tree is bushy. Species overlapped.", "write": "bush, not ladder" },
        { "say": "Dates are estimates. They're revised as new fossils turn up.", "write": "dates are approximate" }
      ] }
  ]
}

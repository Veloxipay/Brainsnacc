        {
          "say": "It takes about a week for clonal selection and expansion.",
          "write": "lag ~ 1 week"
        },
        {
          "say": "Second exposure gives 300 units, because memory cells are ready.",
          "write": "secondary: 300 units"
        },
        {
          "say": "Cytotoxic T cells kill infected cells using perforin and granzymes.",
          "write": "cell-mediated"
        },
        {
          "say": "Few helper T cells means B cells are not activated well.",
          "write": "helper T → B cells"
        }
      ]

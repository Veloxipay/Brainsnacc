    {
      "heading": "Allele frequency calculation",
      "lines": [
        {
          "say": "500 mosquitoes: 180 RR, 220 Rr, 100 rr.",
          "write": "180 RR, 220 Rr, 100 rr"
        },
        {
          "say": "Each mosquito carries two copies, so there are 1000 copies in total.",
          "write": "2 × 500 = 1000"
        },
        {
          "say": "RR gives two R each, Rr gives one.",
          "write": "2 × 180 + 220 = 580",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Counting R alleles",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 200,
                "h": 70,
                "fill": "green",
                "label": "RR: 360 R"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 60,
                "w": 200,
                "h": 70,
                "fill": "teal",
                "label": "Rr: 220 R"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "580 ÷ 1000 = 0.58",
                "size": 28,
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So the frequency of R is 0.58.",
          "write": "f(R) = 0.58"
        },
        {
          "say": "The R allele was there before spraying. Selection needs existing variation.",
          "write": "mutation came first"
        }
      ]
    },

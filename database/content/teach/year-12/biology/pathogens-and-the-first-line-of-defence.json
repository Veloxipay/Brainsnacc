    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Viruses and prions are not cells. Worms are cellular pathogens.",
          "write": "✗ viruses are cells"
        },
        {
          "say": "MHC two is not on all cells. Only antigen-presenting cells carry it.",
          "write": "✗ MHC II on all cells"
        },
        {
          "say": "Antibiotics do not treat viral infections, like colds or flu.",
          "write": "✗ antibiotics for flu"
        },
        {
          "say": "Mucus and cilia are physical. Lysozyme and acid are chemical.",
          "write": "sort barriers carefully"
        }
      ]
    },

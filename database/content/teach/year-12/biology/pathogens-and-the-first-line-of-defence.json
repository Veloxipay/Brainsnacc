    {
      "heading": "Cellular pathogens",
      "lines": [
        {
          "say": "Bacteria are prokaryotes, with a cell wall and 70S ribosomes.",
          "write": "bacteria: wall, 70S ribosomes"
        },
        {
          "say": "Many release toxins, like Salmonella, which causes food poisoning.",
          "write": "Salmonella, TB"
        },
        {
          "say": "Fungi are eukaryotes with cell walls made of chitin. Candida causes thrush.",
          "write": "fungi: chitin wall"
        },
        {
          "say": "Protozoa are single-celled eukaryotes. Plasmodium causes malaria.",
          "write": "Plasmodium → malaria"
        },
        {
          "say": "Worms are multicellular animals, like tapeworms and hookworms.",
          "write": "worms: multicellular"
        }
      ]
    },
    {
      "heading": "Viruses and prions",
      "lines": [
        {
          "say": "A virus is DNA or RNA inside a protein coat called a capsid.",
          "write": "nucleic acid + capsid",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Virus with capsid",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 110,
                "fill": "orange",
                "label": ""
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 55,
                "fill": "yellow",
                "label": "DNA or RNA"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 25,
                "text": "capsid",
                "size": 20,
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Some viruses also take a lipid envelope from the host membrane.",
          "write": "+ envelope",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Envelope added around capsid",
            "items": [
              {
                "kind": "circle",

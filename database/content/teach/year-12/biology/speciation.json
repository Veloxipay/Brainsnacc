    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A barrier alone does not make a species. It only stops gene flow.",
          "write": "✗ barrier = species"
        },
        {
          "say": "Finches did not change beaks in their lifetime. Selection acts across generations.",
          "write": "✗ individuals adapt"
        },
        {
          "say": "Hybrid sterility is post-zygotic, because a zygote did form.",
          "write": "sterility = post-zygotic"
        }
      ]
    },

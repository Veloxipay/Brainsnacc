{
  "level": "Year 12",
  "subject": "biology",
  "title": "Speciation",
  "frames": [
    {
      "heading": "What is a species?",
      "lines": [
        {
          "say": "A species is a group that can interbreed in nature.",
          "write": "species"
        },
        {
          "say": "Their offspring must be viable and fertile. Viable means able to survive.",
          "write": "viable + fertile"
        },
        {
          "say": "A horse and a donkey make a mule, but mules are almost always infertile.",
          "write": "horse + donkey → mule",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Horse and donkey make an infertile mule",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 110,
                "w": 153,
                "h": 70,
                "fill": "orange",
                "label": "Horse"
              },
              {
                "kind": "arrow",
                "x": 175,
                "y": 145,
                "x2": 201,
                "y2": 145,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 203,
                "y": 110,
                "w": 153,
                "h": 70,
                "fill": "grey",
                "label": "Donkey"
              },
              {
                "kind": "arrow",
                "x": 359,
                "y": 145,
                "x2": 385,
                "y2": 145,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 387,
                "y": 110,
                "w": 153,
                "h": 70,
                "fill": "red",
                "label": "Mule: infertile",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "So horses and donkeys are separate species."
        },
        {
          "say": "The definition cannot be used for bacteria, fossils, or populations that never meet.",
          "write": "limits"
        }
      ]
    },
    {
      "heading": "Stopping gene flow",
      "lines": [
        {
          "say": "New species form when populations can no longer swap alleles.",
          "write": "reproductive isolation"
        },
        {
          "say": "Once gene flow stops, each gene pool changes on its own.",
          "write": "gene flow stops"
        },
        {
          "say": "Three things change it: mutation, natural selection and genetic drift.",
          "write": "mutation, selection, drift"
        },
        {
          "say": "After many generations, they cannot make fertile offspring together.",
          "write": "new species"
        }
      ]
    },

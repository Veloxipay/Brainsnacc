    {
      "heading": "Sympatric speciation",
      "lines": [
        {
          "say": "Sympatric means same homeland. No geographical barrier at all.",
          "write": "sympatric = same area"
        },
        {
          "say": "Polyploidy: a meiosis error gives gametes with extra whole chromosome sets.",
          "write": "polyploidy"
        },
        {
          "say": "Tetraploid crossed with diploid gives triploid offspring, which are usually sterile.",
          "write": "4n × 2n → 3n sterile",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,

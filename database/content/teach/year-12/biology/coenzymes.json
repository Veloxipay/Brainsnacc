{
  "level": "Year 12", "subject": "biology", "title": "Coenzymes",
  "frames": [
    { "heading": "Biochemical pathways",
      "lines": [
        { "say": "Cells don't do big reactions in one jump. They use chains of small steps.",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "A to D pathway with three enzymes", "items": [
            {"kind": "circle", "x": 50, "y": 100, "r": 32, "fill": "blue", "label": "A"},
            {"kind": "arrow", "x": 85, "y": 100, "x2": 175, "y2": 100, "color": "black"},
            {"kind": "circle", "x": 210, "y": 100, "r": 32, "fill": "blue", "label": "B"},
            {"kind": "arrow", "x": 245, "y": 100, "x2": 335, "y2": 100, "color": "black"},
            {"kind": "circle", "x": 370, "y": 100, "r": 32, "fill": "blue", "label": "C"},
            {"kind": "arrow", "x": 405, "y": 100, "x2": 475, "y2": 100, "color": "black"},
            {"kind": "circle", "x": 510, "y": 100, "r": 32, "fill": "green", "label": "D"},
            {"kind": "text", "x": 130, "y": 80, "text": "E1", "size": 18, "anchor": "middle"},
            {"kind": "text", "x": 290, "y": 80, "text": "E2", "size": 18, "anchor": "middle"},
            {"kind": "text", "x": 440, "y": 80, "text": "E3", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "Each step has its own enzyme. One product is the next step's substrate.", "write": "product → next substrate" },
        { "say": "Small steps let the cell control the pathway and capture energy in packets.", "write": "control + energy capture" },
        { "say": "Now remove enzyme two. B builds up, and C and D aren't made.", "write": "block → before builds up",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Enzyme 2 blocked: B builds up, C and D missing", "items": [
            {"kind": "circle", "x": 50, "y": 100, "r": 32, "fill": "blue", "label": "A"},
            {"kind": "arrow", "x": 85, "y": 100, "x2": 175, "y2": 100, "color": "black"},
            {"kind": "circle", "x": 210, "y": 100, "r": 44, "fill": "blue", "label": "B B B", "change": "highlight"},
            {"kind": "arrow", "x": 255, "y": 100, "x2": 335, "y2": 100, "color": "black", "change": "remove"},
            {"kind": "circle", "x": 370, "y": 100, "r": 32, "fill": "grey", "label": "C", "change": "remove"},
            {"kind": "circle", "x": 510, "y": 100, "r": 32, "fill": "grey", "label": "D", "change": "remove"},
            {"kind": "text", "x": 130, "y": 80, "text": "E1", "size": 18, "anchor": "middle"},
            {"kind": "text", "x": 290, "y": 170, "text": "E2 missing", "size": 20, "anchor": "middle", "color": "red"}
          ]}}
      ] },
    { "heading": "Cofactors and coenzymes",
      "lines": [
        { "say": "Some enzymes need a non-protein helper. That helper is a cofactor.", "write": "cofactor = non-protein helper" },
        { "say": "Metal ions like magnesium two plus are inorganic cofactors.", "write": "Mg²⁺, Zn²⁺, Fe²⁺" },
        { "say": "Coenzymes are small organic molecules, like ATP and NAD plus.",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Coenzymes are a subset of cofactors", "items": [
            {"kind": "circle", "x": 280, "y": 130, "r": 120, "fill": "blue", "label": ""},
            {"kind": "text", "x": 280, "y": 40, "text": "cofactors", "size": 20, "anchor": "middle", "color": "white", "bold": true},
            {"kind": "circle", "x": 330, "y": 150, "r": 60, "fill": "orange", "label": "coenzymes", "change": "add"},
            {"kind": "text", "x": 200, "y": 150, "text": "Mg²⁺", "size": 20, "anchor": "middle", "color": "white"}
          ]}},
        { "say": "All coenzymes are cofactors, but not all cofactors are coenzymes.", "write": "coenzyme ⊂ cofactor" }
      ] },
    { "heading": "Loaded and unloaded",
      "lines": [
        { "say": "A coenzyme picks something up in one reaction. Now it's loaded.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "NAD+ picks up hydrogen to become NADH", "items": [
            {"kind": "rect", "x": 40, "y": 90, "w": 140, "h": 60, "fill": "white", "label": "NAD⁺"},
            {"kind": "arrow", "x": 190, "y": 120, "x2": 350, "y2": 120, "color": "black", "change": "add"},
            {"kind": "circle", "x": 270, "y": 70, "r": 26, "fill": "yellow", "label": "H", "change": "add"},
            {"kind": "rect", "x": 360, "y": 90, "w": 160, "h": 60, "fill": "orange", "label": "NADH", "change": "add"}
          ]}},
        { "say": "It drops it off in another reaction. Then it's unloaded and goes back.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "NADH unloads and returns as NAD+", "items": [
            {"kind": "rect", "x": 40, "y": 90, "w": 140, "h": 60, "fill": "white", "label": "NAD⁺", "change": "highlight"},
            {"kind": "rect", "x": 360, "y": 90, "w": 160, "h": 60, "fill": "orange", "label": "NADH"},
            {"kind": "arrow", "x": 350, "y": 180, "x2": 190, "y2": 180, "color": "purple", "change": "add"},
            {"kind": "text", "x": 270, "y": 220, "text": "unloaded: recycled", "size": 20, "anchor": "middle", "change": "add"}
          ]}},
        { "say": "So coenzymes aren't used up. They're recycled, so cells need only a little.", "write": "recycled, not used up" },
        { "say": "Many coenzymes are made from vitamins in our diet.", "write": "vitamins → coenzymes" }
      ] },
    { "heading": "The four pairs to know",
      "lines": [
        { "say": "ADP plus phosphate loads to ATP. It carries energy.", "write": "ADP + Pi ⇄ ATP   (energy)" },
        { "say": "NAD plus loads to NADH. It carries electrons and a proton in respiration.", "write": "NAD⁺ ⇄ NADH   (respiration)" },
        { "say": "NADP plus loads to NADPH. P for photosynthesis.", "write": "NADP⁺ ⇄ NADPH   (P = photo)" },
        { "say": "FAD loads to FADH two, in the Krebs cycle.", "write": "FAD ⇄ FADH₂   (Krebs)" }
      ] },
    { "heading": "ATP, the energy currency",
      "lines": [
        { "say": "ATP has three phosphate groups.",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "ATP with three phosphates", "items": [
            {"kind": "rect", "x": 40, "y": 70, "w": 160, "h": 60, "fill": "blue", "label": "adenosine"},
            {"kind": "circle", "x": 240, "y": 100, "r": 30, "fill": "yellow", "label": "P"},
            {"kind": "circle", "x": 310, "y": 100, "r": 30, "fill": "yellow", "label": "P"},
            {"kind": "circle", "x": 380, "y": 100, "r": 30, "fill": "yellow", "label": "P"}
          ]}},
        { "say": "Remove the last phosphate and energy is released for the cell to use.", "write": "ATP → ADP + Pi + energy",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Last phosphate removed releasing energy", "items": [
            {"kind": "rect", "x": 40, "y": 70, "w": 160, "h": 60, "fill": "blue", "label": "adenosine"},
            {"kind": "circle", "x": 240, "y": 100, "r": 30, "fill": "yellow", "label": "P"},
            {"kind": "circle", "x": 310, "y": 100, "r": 30, "fill": "yellow", "label": "P"},
            {"kind": "circle", "x": 380, "y": 100, "r": 30, "fill": "yellow", "label": "P", "change": "remove"},
            {"kind": "circle", "x": 480, "y": 100, "r": 30, "fill": "yellow", "label": "Pi", "change": "add"},
            {"kind": "text", "x": 430, "y": 170, "text": "energy!", "size": 22, "anchor": "middle", "bold": true, "color": "red", "change": "add"}
          ]}},
        { "say": "Food or light energy adds the phosphate back again.", "write": "ADP + Pi + energy → ATP" },
        { "say": "ATP is a short-term carrier, not a store. Glucose and starch are stores.", "write": "ATP ≠ energy store" }
      ] },
    { "heading": "Coenzymes link the stages",
      "lines": [
        { "say": "In photosynthesis, the light-dependent stage loads ATP and NADPH.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Coenzymes cycle between light-dependent and light-independent stages", "items": [
            {"kind": "rect", "x": 20, "y": 80, "w": 180, "h": 80, "fill": "green", "label": "light-dependent"},
            {"kind": "rect", "x": 360, "y": 80, "w": 180, "h": 80, "fill": "orange", "label": "Calvin cycle"},
            {"kind": "arrow", "x": 205, "y": 95, "x2": 355, "y2": 95, "color": "red", "change": "add"},
            {"kind": "text", "x": 280, "y": 80, "text": "ATP, NADPH", "size": 18, "anchor": "middle", "change": "add"},
            {"kind": "arrow", "x": 355, "y": 150, "x2": 205, "y2": 150, "color": "blue", "change": "add"},
            {"kind": "text", "x": 280, "y": 185, "text": "ADP + Pi, NADP⁺", "size": 18, "anchor": "middle", "change": "add"}
          ]}},
        { "say": "The Calvin cycle unloads them and sends the empty forms back.", "write": "Calvin cycle unloads" },
        { "say": "In respiration, glycolysis and Krebs load NADH. The transport chain unloads it.", "write": "ETC unloads NADH, FADH₂" },
        { "say": "Run out of an unloaded coenzyme, and the loading stage stops.", "write": "no NADP⁺ → less O₂ released" }
      ] },
    { "heading": "Watch out for these",
      "lines": [
        { "say": "Coenzymes are not proteins or enzymes. They help enzymes.", "write": "coenzyme ≠ enzyme" },
        { "say": "Don't mix up NADH and NADPH. NADPH is photosynthesis.", "write": "NADPH: photosynthesis" },
        { "say": "Magnesium ions are cofactors, but not coenzymes. They're inorganic.", "write": "Mg²⁺: cofactor only" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Pathways are chains of enzyme steps.", "write": "one enzyme per step" },
        { "say": "Coenzymes carry energy, electrons and protons, then get recycled.", "write": "loaded ⇄ unloaded" },
        { "say": "NAD plus for respiration. NADP plus for photosynthesis.", "write": "P for photosynthesis" },
        { "say": "ATP is the energy currency, not the energy store.", "write": "ATP: currency" }
      ] }
  ]
}

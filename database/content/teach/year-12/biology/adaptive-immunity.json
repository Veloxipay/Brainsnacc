{
  "level": "Year 12", "subject": "biology", "title": "Adaptive immunity",
  "frames": [
    { "heading": "The third line of defence",
      "lines": [
        { "say": "The adaptive response is specific, slow at first, and it remembers.", "write": "specific, slow, memory" },
        { "say": "Its cells are lymphocytes. B cells mature in bone marrow, T cells in the thymus.", "write": "B: bone marrow  T: thymus" },
        { "say": "Each lymphocyte has receptors that fit one antigen shape, called an epitope.",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Lymphocytes with different receptors; one fits the antigen", "items": [
            {"kind": "circle", "x": 100, "y": 110, "r": 40, "fill": "blue", "label": "■"},
            {"kind": "circle", "x": 220, "y": 110, "r": 40, "fill": "blue", "label": "●"},
            {"kind": "circle", "x": 340, "y": 110, "r": 40, "fill": "blue", "label": "▲"},
            {"kind": "circle", "x": 460, "y": 110, "r": 40, "fill": "blue", "label": "◆"},
            {"kind": "text", "x": 280, "y": 190, "text": "millions of different receptors", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "The matching lymphocyte already exists. The antigen just selects it.", "write": "antigen selects, not creates",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "The lymphocyte with the triangle receptor is selected", "items": [
            {"kind": "circle", "x": 100, "y": 110, "r": 40, "fill": "blue", "label": "■"},
            {"kind": "circle", "x": 220, "y": 110, "r": 40, "fill": "blue", "label": "●"},
            {"kind": "circle", "x": 340, "y": 110, "r": 40, "fill": "blue", "label": "▲", "change": "highlight"},
            {"kind": "circle", "x": 460, "y": 110, "r": 40, "fill": "blue", "label": "◆"},
            {"kind": "polygon", "points": [[320,40],[360,40],[340,10]], "fill": "red", "change": "add"},
            {"kind": "text", "x": 280, "y": 190, "text": "only the match is selected", "size": 18, "anchor": "middle", "change": "add"}
          ]}}
      ] },
    { "heading": "Presenting the antigen",
      "lines": [
        { "say": "T cells can't see free antigen. It has to be shown on an MHC marker.", "write": "antigen on MHC" },
        { "say": "A dendritic cell engulfs a pathogen and puts fragments on MHC two.", "write": "dendritic cell → MHC II" },
        { "say": "It travels to a lymph node and shows them to helper T cells.", "write": "lymph node" },
        { "say": "Infected body cells show fragments on MHC one instead.", "write": "infected cells: MHC I" }
      ] },
    { "heading": "Clonal selection and expansion",
      "lines": [
        { "say": "The selected lymphocyte divides by mitosis. It makes a clone.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "One lymphocyte becomes many identical cells", "items": [
            {"kind": "circle", "x": 80, "y": 120, "r": 36, "fill": "blue", "label": "▲"},
            {"kind": "arrow", "x": 125, "y": 120, "x2": 200, "y2": 120, "color": "black", "change": "add"},
            {"kind": "circle", "x": 250, "y": 70, "r": 28, "fill": "blue", "label": "▲", "change": "add"},
            {"kind": "circle", "x": 320, "y": 70, "r": 28, "fill": "blue", "label": "▲", "change": "add"},
            {"kind": "circle", "x": 390, "y": 70, "r": 28, "fill": "blue", "label": "▲", "change": "add"},
            {"kind": "circle", "x": 250, "y": 170, "r": 28, "fill": "blue", "label": "▲", "change": "add"},
            {"kind": "circle", "x": 320, "y": 170, "r": 28, "fill": "blue", "label": "▲", "change": "add"},
            {"kind": "circle", "x": 390, "y": 170, "r": 28, "fill": "blue", "label": "▲", "change": "add"},
            {"kind": "text", "x": 480, "y": 125, "text": "clone", "size": 22, "anchor": "middle", "change": "add"}
          ]}},
        { "say": "The clone becomes effector cells for now, and memory cells for later.", "write": "effector + memory" },
        { "say": "That takes days. That's why a first response is slow.", "write": "first response: slow" }
      ] },
    { "heading": "Helper T cells and B cells",
      "lines": [
        { "say": "Helper T cells read MHC two. They release cytokines to activate others.", "write": "helper T → cytokines" },
        { "say": "HIV destroys helper T cells. That weakens the whole adaptive response.", "write": "HIV kills helper T" },
        { "say": "A B cell binds its antigen. A matching helper T cell activates it.", "write": "B cell + helper T" },
        { "say": "It clones into plasma cells and memory B cells. Plasma cells secrete antibodies.",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "B cell becomes plasma cells and memory B cells", "items": [
            {"kind": "circle", "x": 80, "y": 110, "r": 36, "fill": "blue", "label": "B"},
            {"kind": "arrow", "x": 120, "y": 100, "x2": 230, "y2": 60, "color": "black", "change": "add"},
            {"kind": "arrow", "x": 120, "y": 120, "x2": 230, "y2": 160, "color": "black", "change": "add"},
            {"kind": "rect", "x": 240, "y": 30, "w": 160, "h": 56, "fill": "orange", "label": "plasma cell", "change": "add"},
            {"kind": "rect", "x": 240, "y": 135, "w": 160, "h": 56, "fill": "teal", "label": "memory B", "change": "add"},
            {"kind": "text", "x": 470, "y": 65, "text": "Y Y Y", "size": 24, "anchor": "middle", "change": "add"}
          ]}}
      ] },
    { "heading": "Antibodies",
      "lines": [
        { "say": "An antibody is Y-shaped. Two heavy chains and two light chains.",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Y-shaped antibody with variable tips", "items": [
            {"kind": "line", "x": 280, "y": 260, "x2": 280, "y2": 150, "color": "blue"},
            {"kind": "line", "x": 280, "y": 150, "x2": 190, "y2": 50, "color": "blue"},
            {"kind": "line", "x": 280, "y": 150, "x2": 370, "y2": 50, "color": "blue"},
            {"kind": "circle", "x": 190, "y": 50, "r": 20, "fill": "orange", "change": "highlight"},
            {"kind": "circle", "x": 370, "y": 50, "r": 20, "fill": "orange", "change": "highlight"},
            {"kind": "text", "x": 420, "y": 40, "text": "variable", "size": 18},
            {"kind": "text", "x": 300, "y": 220, "text": "constant", "size": 18}
          ]}},
        { "say": "The variable tips bind one epitope. The constant region links to other immune parts.", "write": "variable binds, constant signals" },
        { "say": "Antibodies neutralise viruses and toxins. And they clump pathogens together.", "write": "neutralise, agglutinate" },
        { "say": "They coat pathogens for phagocytes and trigger complement. They don't kill alone.", "write": "opsonise, complement" }
      ] },
    { "heading": "Cell-mediated response",
      "lines": [
        { "say": "Antibodies can't reach viruses hiding inside cells. Cytotoxic T cells can.", "write": "cytotoxic T: infected cells" },
        { "say": "A cytotoxic T cell binds an infected cell showing antigen on MHC one.", "write": "binds MHC I" },
        { "say": "It releases perforin and granzymes. The infected cell dies by apoptosis.",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Cytotoxic T cell kills infected cell", "items": [
            {"kind": "circle", "x": 140, "y": 110, "r": 50, "fill": "purple", "label": "Tc"},
            {"kind": "circle", "x": 400, "y": 110, "r": 60, "fill": "pink", "label": "infected", "change": "remove"},
            {"kind": "arrow", "x": 195, "y": 110, "x2": 335, "y2": 110, "color": "red", "change": "add"},
            {"kind": "text", "x": 265, "y": 90, "text": "perforin, granzymes", "size": 16, "anchor": "middle", "change": "add"},
            {"kind": "text", "x": 400, "y": 200, "text": "apoptosis", "size": 18, "anchor": "middle", "change": "add"}
          ]}},
        { "say": "Memory T cells stay behind too.", "write": "memory T cells" }
      ] },
    { "heading": "Primary and secondary responses",
      "lines": [
        { "say": "First exposure. A lag of days, then a modest antibody peak.",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Primary response small, secondary response larger and faster", "items": [
            {"kind": "arrow", "x": 40, "y": 240, "x2": 530, "y2": 240, "color": "black"},
            {"kind": "arrow", "x": 40, "y": 240, "x2": 40, "y2": 20, "color": "black"},
            {"kind": "polygon", "points": [[60,240],[110,240],[150,190],[200,240]], "fill": "blue"},
            {"kind": "text", "x": 130, "y": 175, "text": "primary", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 290, "y": 270, "text": "time", "size": 16, "anchor": "middle"}
          ]}},
        { "say": "Second exposure. Memory cells respond faster, higher and for longer.", "write": "faster, greater, longer",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Secondary response added", "items": [
            {"kind": "arrow", "x": 40, "y": 240, "x2": 530, "y2": 240, "color": "black"},
            {"kind": "arrow", "x": 40, "y": 240, "x2": 40, "y2": 20, "color": "black"},
            {"kind": "polygon", "points": [[60,240],[110,240],[150,190],[200,240]], "fill": "blue"},
            {"kind": "polygon", "points": [[280,240],[300,240],[340,40],[480,240]], "fill": "orange", "change": "add"},
            {"kind": "text", "x": 130, "y": 175, "text": "primary", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 420, "y": 50, "text": "secondary", "size": 18, "change": "add"},
            {"kind": "text", "x": 290, "y": 270, "text": "time", "size": 16, "anchor": "middle"}
          ]}},
        { "say": "The pathogen is cleared before symptoms. You're immune. That's how vaccines work.", "write": "immune" }
      ] },
    { "heading": "Watch out and remember",
      "lines": [
        { "say": "Plasma cells secrete antibodies, not B cells directly.", "write": "plasma cells make antibodies" },
        { "say": "Helper T reads MHC two. Cytotoxic T reads MHC one.", "write": "helper II, cytotoxic I" },
        { "say": "Humoral uses antibodies outside cells. Cell-mediated kills infected cells.", "write": "humoral vs cell-mediated" },
        { "say": "Secondary is faster, greater and longer, because of memory cells.", "write": "memory cells" }
      ] }
  ]
}

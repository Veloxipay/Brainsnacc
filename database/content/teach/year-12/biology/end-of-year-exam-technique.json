{
  "level": "Year 12", "subject": "biology", "title": "End-of-year exam technique",
  "frames": [
    { "heading": "What the exam looks like",
      "lines": [
        { "say": "The exam covers Units 3 and 4, with lots of unfamiliar scenarios.", "write": "Units 3 + 4: apply it" },
        { "say": "There's a multiple choice section, then a short answer section.",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Reading time, multiple choice, short answer", "items": [
            {"kind": "rect", "x": 20, "y": 60, "w": 120, "h": 70, "fill": "grey", "label": "reading"},
            {"kind": "rect", "x": 140, "y": 60, "w": 160, "h": 70, "fill": "orange", "label": "multiple choice"},
            {"kind": "rect", "x": 300, "y": 60, "w": 240, "h": 70, "fill": "blue", "label": "short answer"},
            {"kind": "text", "x": 280, "y": 170, "text": "check current VCAA specs", "size": 20, "anchor": "middle"}
          ]}},
        { "say": "Many short answers start from a stimulus. A graph, table or experiment.", "write": "stimulus-based" },
        { "say": "Check the current VCAA specifications and sample exam. Formats can change.", "write": "check VCAA" }
      ] },
    { "heading": "Command words",
      "lines": [
        { "say": "Circle the command word first. Identify, describe, explain, compare.", "write": "circle the command word" },
        { "say": "The most common slip is describing what, when it asks you why.",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Describe answers what; explain answers why", "items": [
            {"kind": "rect", "x": 30, "y": 60, "w": 230, "h": 80, "fill": "blue", "label": "describe: what"},
            {"kind": "rect", "x": 300, "y": 60, "w": 230, "h": 80, "fill": "orange", "label": "explain: why", "change": "highlight"},
            {"kind": "text", "x": 280, "y": 190, "text": "answer the word you were given", "size": 20, "anchor": "middle"}
          ]}},
        { "say": "Use the marks as a guide. About one clear idea per mark.", "write": "1 idea per mark",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Three marks, three ideas", "items": [
            {"kind": "rect", "x": 40, "y": 70, "w": 140, "h": 60, "fill": "green", "label": "idea 1"},
            {"kind": "rect", "x": 210, "y": 70, "w": 140, "h": 60, "fill": "green", "label": "idea 2", "change": "add"},
            {"kind": "rect", "x": 380, "y": 70, "w": 140, "h": 60, "fill": "green", "label": "idea 3", "change": "add"},
            {"kind": "text", "x": 280, "y": 170, "text": "3 marks → 3 ideas", "size": 22, "anchor": "middle", "bold": true}
          ]}}
      ] },
    { "heading": "Extended responses",
      "lines": [
        { "say": "Plan for 30 seconds. Jot the key terms and the order of steps.", "write": "plan 30 s" },
        { "say": "Write in a logical chain. Cause, then process, then effect.", "write": "cause → process → effect" },
        { "say": "Use precise words, like clonal expansion or allele frequency.", "write": "precise terms" },
        { "say": "Stay in the scenario. Name the organism or molecule you were given.", "write": "stay in context" },
        { "say": "Re-read the question at the end. Did you answer every part?", "write": "re-read" }
      ] },
    { "heading": "Data questions",
      "lines": [
        { "say": "Use trend, data, interpretation.",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Graph with a trend and a quoted value", "items": [
            {"kind": "arrow", "x": 50, "y": 240, "x2": 530, "y2": 240, "color": "black"},
            {"kind": "arrow", "x": 50, "y": 240, "x2": 50, "y2": 20, "color": "black"},
            {"kind": "line", "x": 60, "y": 60, "x2": 300, "y2": 150, "color": "blue"},
            {"kind": "line", "x": 300, "y": 150, "x2": 500, "y2": 220, "color": "blue"},
            {"kind": "text", "x": 290, "y": 270, "text": "X", "size": 18, "anchor": "middle"},
            {"kind": "text", "x": 30, "y": 30, "text": "Y", "size": 18}
          ]}},
        { "say": "State the pattern. As X increased, Y decreased.", "write": "1. trend" },
        { "say": "Quote values with units, especially where the trend changes.", "write": "2. data with units",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "A data point quoted with units", "items": [
            {"kind": "arrow", "x": 50, "y": 240, "x2": 530, "y2": 240, "color": "black"},
            {"kind": "arrow", "x": 50, "y": 240, "x2": 50, "y2": 20, "color": "black"},
            {"kind": "line", "x": 60, "y": 60, "x2": 300, "y2": 150, "color": "blue"},
            {"kind": "line", "x": 300, "y": 150, "x2": 500, "y2": 220, "color": "blue"},
            {"kind": "circle", "x": 300, "y": 150, "r": 10, "fill": "red", "change": "add"},
            {"kind": "text", "x": 320, "y": 130, "text": "quote this value + unit", "size": 18, "change": "add"},
            {"kind": "text", "x": 290, "y": 270, "text": "X", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "Then explain it with biology. Check axes, units and error bars.", "write": "3. interpret" }
      ] },
    { "heading": "Experimental design",
      "lines": [
        { "say": "Independent is what you change. Dependent is what you measure.", "write": "IV changed, DV measured" },
        { "say": "Name variables as measurable things. Mean plant height in centimetres after 14 days.", "write": "measurable variables" },
        { "say": "Accuracy is close to true. Precision is repeats close together.", "write": "accuracy ≠ precision" },
        { "say": "Validity asks, does it really test what it claims?", "write": "validity" },
        { "say": "Suggest an improvement and say why. Thirty plants per group reduces variation.", "write": "change + reason" }
      ] },
    { "heading": "Your revision plan",
      "lines": [
        { "say": "Turn the study design into a checklist. Rate each point.", "write": "key knowledge checklist" },
        { "say": "Do past exams under timed conditions. Mark with the examiners' reports.", "write": "timed past exams" },
        { "say": "Keep an error log. Review it before every practice exam.", "write": "error log" },
        { "say": "In the final days, focus on your error log, definitions and rest.", "write": "rest matters" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Circle the command word, and answer it.", "write": "command word" },
        { "say": "Stay in the context of the scenario.", "write": "context" },
        { "say": "Trend, data, interpretation.", "write": "trend → data → why" },
        { "say": "Watch your time on the multiple choice.", "write": "manage time" }
      ] }
  ]
}

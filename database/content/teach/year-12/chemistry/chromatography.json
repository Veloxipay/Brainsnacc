{
  "level": "Year 12",
  "subject": "chemistry",
  "title": "Chromatography",
  "frames": [
    {
      "heading": "Two phases",
      "lines": [
        {
          "say": "Chromatography separates a mixture so each part can be identified.",
          "write": "separate a mixture"
        },
        {
          "say": "The stationary phase stays still, like paper or silica.",
          "write": "stationary phase"
        },
        {
          "say": "The mobile phase moves, carrying the mixture with it.",
          "write": "mobile phase"
        },
        {
          "say": "Each component keeps sticking to the stationary phase, then dissolving again.",
          "write": "adsorb ⇄ desorb"
        },
        {
          "say": "Strongly adsorbed parts move slowly. Very soluble parts move fast.",
          "write": "strong attraction → slow"
        }
      ]
    },

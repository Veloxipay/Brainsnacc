    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Measure Rf from the origin line to the spot centre.",
          "write": "from the origin"
        },
        {
          "say": "Lighter molecules do not simply travel further. Attraction decides.",
          "write": "✗ lighter = further"
        },
        {
          "say": "Polar does not always come first. Check both phases.",
          "write": "check polarity"
        },
        {
          "say": "Multiply by the dilution factor at the end.",
          "write": "× dilution factor"
        }
      ]
    },

    {
      "heading": "Which comes out first?",
      "lines": [
        {
          "say": "Here the stationary phase is non-polar. The mobile phase is polar.",
          "write": "non-polar column"
        },
        {
          "say": "Polar P hydrogen bonds with the mobile phase. It leaves at 1.8 minutes.",
          "write": "P: Rt = 1.8 min"
        },
        {
          "say": "Hydrocarbon Q sticks to the column by dispersion forces. 6.5 minutes.",
          "write": "Q: Rt = 6.5 min"
        },
        {
          "say": "Swap the phase polarities, and the order can swap too.",
          "write": "depends on both phases"
        }
      ]
    },

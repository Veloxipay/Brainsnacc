    {
      "heading": "Thermochemical equations",
      "lines": [
        {
          "say": "Add delta H to a balanced equation with states.",
          "write": "ΔH = −890 kJ mol⁻¹"
        },
        {
          "say": "Double the equation, and delta H doubles to minus 1780.",
          "write": "×2 → −1780 kJ mol⁻¹"
        },
        {
          "say": "Halve it, and you get minus 445.",
          "write": "×½ → −445 kJ mol⁻¹"
        },
        {
          "say": "Reverse it, and the sign flips to plus 890.",
          "write": "reverse → +890 kJ mol⁻¹"
        },
        {
          "say": "The data book lists heats of combustion as positive. Add the minus sign.",
          "write": "methane: 890 kJ mol⁻¹"
        }
      ]
    },

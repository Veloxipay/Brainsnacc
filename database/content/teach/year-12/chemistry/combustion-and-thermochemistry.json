    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Combustion delta H is negative, even though the data book shows positive.",
          "write": "ΔH combustion < 0"
        },
        {
          "say": "Scale delta H whenever you change the coefficients.",
          "write": "scale ΔH"
        },
        {
          "say": "At SLC, water is liquid, not gas.",
          "write": "H₂O(l) not H₂O(g)"
        },
        {
          "say": "Measure Ea from the reactants, not from the products or zero.",
          "write": "Ea from reactants"
        }
      ]
    },

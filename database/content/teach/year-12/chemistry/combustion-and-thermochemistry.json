  "frames": [
    {
      "heading": "What is combustion?",
      "lines": [
        {
          "say": "Combustion is a fast reaction between a fuel and oxygen, releasing heat and light.",
          "write": "fuel + O₂ → energy"
        },
        {
          "say": "With plenty of oxygen, complete combustion gives only carbon dioxide and water.",
          "write": "CH₄ + 2O₂ → CO₂ + 2H₂O"
        },
        {
          "say": "With limited oxygen, some carbon becomes carbon monoxide or soot.",
          "write": "2CH₄ + 3O₂ → 2CO + 4H₂O",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Blue flame versus yellow flame",
            "items": [
              {
                "kind": "circle",
                "x": 150,
                "y": 150,
                "r": 80,
                "fill": "blue",
                "label": "complete"
              },
              {
                "kind": "text",
                "x": 150,
                "y": 265,
                "text": "blue flame",
                "size": 20,
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 410,
                "y": 150,
                "r": 80,
                "fill": "yellow",
                "label": "incomplete",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 410,
                "y": 265,
                "text": "yellow, smoky",
                "size": 20,
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Incomplete combustion releases less energy, and CO is toxic.",
          "write": "less energy, toxic CO"
        },
        {
          "say": "A blue flame means complete. A yellow, smoky flame means incomplete.",
          "write": "blue vs yellow"
        }
      ]
    },

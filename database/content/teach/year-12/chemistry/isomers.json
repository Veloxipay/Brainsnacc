{
  "level": "Year 12", "subject": "chemistry", "title": "Isomers",
  "frames": [
    { "heading": "What is an isomer?",
      "lines": [
        { "say": "Take the letters in listen. Rearrange them and you get silent.", "write": "LISTEN → SILENT",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "The letters of LISTEN rearranged to spell SILENT", "items": [
            {"kind": "text", "x": 140, "y": 90, "text": "LISTEN", "size": 40, "bold": true, "anchor": "middle"},
            {"kind": "arrow", "x": 230, "y": 78, "x2": 330, "y2": 78, "color": "purple"},
            {"kind": "text", "x": 420, "y": 90, "text": "SILENT", "size": 40, "bold": true, "anchor": "middle", "color": "teal", "change": "add"},
            {"kind": "text", "x": 280, "y": 160, "text": "same letters, different word", "size": 20, "anchor": "middle"}]}},
        { "say": "Isomers are the same idea. Same molecular formula, different arrangement of atoms.", "write": "Isomers: same formula, new layout" },
        { "say": "Ethanol and methoxymethane are both C two H six O.", "write": "C₂H₆O",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Ethanol and methoxymethane both have formula C2H6O", "items": [
            {"kind": "circle", "x": 60, "y": 100, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 84, "y": 100, "x2": 116, "y2": 100},
            {"kind": "circle", "x": 140, "y": 100, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 164, "y": 100, "x2": 196, "y2": 100},
            {"kind": "circle", "x": 220, "y": 100, "r": 24, "fill": "red", "label": "OH"},
            {"kind": "text", "x": 140, "y": 180, "text": "ethanol (alcohol)", "size": 18, "anchor": "middle"},
            {"kind": "circle", "x": 340, "y": 100, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 364, "y": 100, "x2": 396, "y2": 100},
            {"kind": "circle", "x": 420, "y": 100, "r": 24, "fill": "red", "label": "O", "change": "highlight"},
            {"kind": "line", "x": 444, "y": 100, "x2": 476, "y2": 100},
            {"kind": "circle", "x": 500, "y": 100, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "text", "x": 420, "y": 180, "text": "methoxymethane (ether)", "size": 18, "anchor": "middle"}]}},
        { "say": "But ethanol boils at about 78 degrees. Methoxymethane is a gas at room temperature.", "write": "78 °C liquid  vs  gas" },
        { "say": "Shape and structure decide how a molecule behaves. So isomers act differently." }
      ] },
    { "heading": "Two big families",
      "lines": [
        { "say": "Structural isomers have the atoms joined in a different order.", "write": "Structural: different connectivity" },
        { "say": "Stereoisomers have the same bonding order, but a different arrangement in space.", "write": "Stereo: same bonds, new 3D layout" },
        { "say": "Quick test. Different IUPAC names means structural isomers.", "write": "Different names → structural" },
        { "say": "Same name, but you need cis, trans or which way round? Stereoisomers.", "write": "Same name + extra info → stereo" }
      ] },
    { "heading": "Structural isomers: chain, place, group",
      "lines": [
        { "say": "Chain isomers have a different carbon skeleton. Here is butane, four carbons in a row.", "write": "butane CH₃CH₂CH₂CH₃",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Butane: four carbons in a chain", "items": [
            {"kind": "circle", "x": 120, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 144, "y": 160, "x2": 196, "y2": 160},
            {"kind": "circle", "x": 220, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 244, "y": 160, "x2": 296, "y2": 160},
            {"kind": "circle", "x": 320, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 344, "y": 160, "x2": 396, "y2": 160},
            {"kind": "circle", "x": 420, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "text", "x": 280, "y": 225, "text": "butane, C₄H₁₀", "size": 20, "anchor": "middle"}]}},
        { "say": "Move the end carbon up to become a branch. Now it is 2-methylpropane.", "write": "2-methylpropane CH₃CH(CH₃)CH₃",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "The end carbon moves to a branch on the middle carbon", "items": [
            {"kind": "circle", "x": 120, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 144, "y": 160, "x2": 196, "y2": 160},
            {"kind": "circle", "x": 220, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 244, "y": 160, "x2": 296, "y2": 160},
            {"kind": "circle", "x": 320, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 344, "y": 160, "x2": 396, "y2": 160, "change": "remove"},
            {"kind": "circle", "x": 420, "y": 160, "r": 24, "fill": "grey", "label": "C", "change": "remove"},
            {"kind": "line", "x": 220, "y": 136, "x2": 220, "y2": 84, "change": "add"},
            {"kind": "circle", "x": 220, "y": 60, "r": 24, "fill": "grey", "label": "C", "change": "add"},
            {"kind": "text", "x": 280, "y": 225, "text": "2-methylpropane, still C₄H₁₀", "size": 20, "anchor": "middle"}]}},
        { "say": "Branching makes molecules compact. Weaker dispersion forces, so a lower boiling point.", "write": "more branching → lower b.p." },
        { "say": "Positional isomers move the functional group. Watch the O H move from carbon 1 to carbon 2.", "write": "propan-1-ol → propan-2-ol",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "The OH group moves from the end carbon to the middle carbon", "items": [
            {"kind": "circle", "x": 160, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 184, "y": 160, "x2": 256, "y2": 160},
            {"kind": "circle", "x": 280, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 304, "y": 160, "x2": 376, "y2": 160},
            {"kind": "circle", "x": 400, "y": 160, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 424, "y": 160, "x2": 476, "y2": 160, "change": "remove"},
            {"kind": "circle", "x": 500, "y": 160, "r": 24, "fill": "red", "label": "OH", "change": "remove"},
            {"kind": "line", "x": 280, "y": 136, "x2": 280, "y2": 84, "change": "add"},
            {"kind": "circle", "x": 280, "y": 60, "r": 24, "fill": "red", "label": "OH", "change": "add"},
            {"kind": "text", "x": 280, "y": 225, "text": "primary alcohol → secondary alcohol", "size": 18, "anchor": "middle"}]}},
        { "say": "Functional group isomers change the group itself, like propanal and propanone.", "write": "C₃H₆O: aldehyde vs ketone" },
        { "say": "Remember it as chain, place, group.", "write": "Chain, Place, Group" }
      ] },
    { "heading": "Cis and trans isomers",
      "lines": [
        { "say": "A C double bond C cannot rotate. Turning it would break the pi bond.", "write": "C=C: no rotation" },
        { "say": "In but-2-ene, both C H three groups sit on the same side. That is cis.", "write": "cis = same side",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "cis-but-2-ene with both CH3 groups on the same side", "items": [
            {"kind": "circle", "x": 230, "y": 130, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 254, "y": 124, "x2": 306, "y2": 124},
            {"kind": "line", "x": 254, "y": 136, "x2": 306, "y2": 136},
            {"kind": "circle", "x": 330, "y": 130, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 214, "y": 112, "x2": 170, "y2": 70},
            {"kind": "circle", "x": 150, "y": 55, "r": 28, "fill": "orange", "label": "CH₃", "change": "highlight"},
            {"kind": "line", "x": 346, "y": 112, "x2": 390, "y2": 70},
            {"kind": "circle", "x": 410, "y": 55, "r": 28, "fill": "orange", "label": "CH₃", "change": "highlight"},
            {"kind": "line", "x": 214, "y": 148, "x2": 175, "y2": 190},
            {"kind": "circle", "x": 160, "y": 205, "r": 20, "fill": "white", "label": "H"},
            {"kind": "line", "x": 346, "y": 148, "x2": 385, "y2": 190},
            {"kind": "circle", "x": 400, "y": 205, "r": 20, "fill": "white", "label": "H"}]}},
        { "say": "Swap one side. Now the C H three groups are on opposite sides. That is trans.", "write": "trans = across",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "trans-but-2-ene: the right CH3 and H swap places", "items": [
            {"kind": "circle", "x": 230, "y": 130, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 254, "y": 124, "x2": 306, "y2": 124},
            {"kind": "line", "x": 254, "y": 136, "x2": 306, "y2": 136},
            {"kind": "circle", "x": 330, "y": 130, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "line", "x": 214, "y": 112, "x2": 170, "y2": 70},
            {"kind": "circle", "x": 150, "y": 55, "r": 28, "fill": "orange", "label": "CH₃"},
            {"kind": "line", "x": 346, "y": 112, "x2": 390, "y2": 70},
            {"kind": "circle", "x": 410, "y": 55, "r": 20, "fill": "white", "label": "H", "change": "add"},
            {"kind": "line", "x": 214, "y": 148, "x2": 175, "y2": 190},
            {"kind": "circle", "x": 160, "y": 205, "r": 20, "fill": "white", "label": "H"},
            {"kind": "line", "x": 346, "y": 148, "x2": 385, "y2": 190},
            {"kind": "circle", "x": 405, "y": 210, "r": 28, "fill": "orange", "label": "CH₃", "change": "add"}]}},
        { "say": "The rule: each carbon of the double bond needs two different groups.", "write": "both C's: two different groups" },
        { "say": "But-1-ene has two H atoms on carbon 1. So no cis or trans isomers.", "write": "but-1-ene: no cis/trans" },
        { "say": "Cis and trans differ in polarity, so they have different boiling points.", "write": "different b.p." }
      ] },
    { "heading": "Chiral centres and enantiomers",
      "lines": [
        { "say": "A chiral centre is a carbon bonded to four different groups.", "write": "chiral C: 4 different groups" },
        { "say": "In butan-2-ol, carbon 2 has H, O H, C H three and C H two C H three.", "write": "butan-2-ol: C2 is chiral*",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Carbon 2 of butan-2-ol with four different groups", "items": [
            {"kind": "circle", "x": 280, "y": 140, "r": 28, "fill": "grey", "label": "C*", "change": "highlight"},
            {"kind": "line", "x": 280, "y": 112, "x2": 280, "y2": 70},
            {"kind": "circle", "x": 280, "y": 48, "r": 22, "fill": "white", "label": "H"},
            {"kind": "line", "x": 280, "y": 168, "x2": 280, "y2": 210},
            {"kind": "circle", "x": 280, "y": 236, "r": 26, "fill": "red", "label": "OH"},
            {"kind": "line", "x": 252, "y": 140, "x2": 190, "y2": 140},
            {"kind": "circle", "x": 160, "y": 140, "r": 30, "fill": "orange", "label": "CH₃"},
            {"kind": "line", "x": 308, "y": 140, "x2": 360, "y2": 140},
            {"kind": "rect", "x": 362, "y": 115, "w": 120, "h": 50, "fill": "teal", "label": "CH₂CH₃"}]}},
        { "say": "This gives two mirror images that cannot be stacked. Like left and right hands.", "write": "enantiomers = mirror images",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Two mirror-image forms on either side of a dashed mirror line", "items": [
            {"kind": "line", "x": 280, "y": 20, "x2": 280, "y2": 240, "dashed": true, "color": "purple"},
            {"kind": "circle", "x": 160, "y": 130, "r": 24, "fill": "grey", "label": "C"},
            {"kind": "circle", "x": 80, "y": 130, "r": 24, "fill": "red", "label": "OH"},
            {"kind": "line", "x": 104, "y": 130, "x2": 136, "y2": 130},
            {"kind": "circle", "x": 160, "y": 50, "r": 20, "fill": "white", "label": "H"},
            {"kind": "line", "x": 160, "y": 70, "x2": 160, "y2": 106},
            {"kind": "circle", "x": 230, "y": 200, "r": 26, "fill": "orange", "label": "CH₃"},
            {"kind": "line", "x": 176, "y": 148, "x2": 212, "y2": 182},
            {"kind": "circle", "x": 400, "y": 130, "r": 24, "fill": "grey", "label": "C", "change": "add"},
            {"kind": "circle", "x": 480, "y": 130, "r": 24, "fill": "red", "label": "OH", "change": "add"},
            {"kind": "line", "x": 424, "y": 130, "x2": 456, "y2": 130, "change": "add"},
            {"kind": "circle", "x": 400, "y": 50, "r": 20, "fill": "white", "label": "H", "change": "add"},
            {"kind": "line", "x": 400, "y": 70, "x2": 400, "y2": 106, "change": "add"},
            {"kind": "circle", "x": 330, "y": 200, "r": 26, "fill": "orange", "label": "CH₃", "change": "add"},
            {"kind": "line", "x": 384, "y": 148, "x2": 348, "y2": 182, "change": "add"},
            {"kind": "text", "x": 280, "y": 255, "text": "mirror", "size": 16, "anchor": "middle", "color": "purple"}]}},
        { "say": "Enantiomers have the same boiling point and density.", "write": "same b.p., same density" },
        { "say": "But they rotate plane-polarised light in opposite directions.", "write": "rotate light opposite ways" },
        { "say": "A fifty fifty mix is a racemic mixture. The rotations cancel.", "write": "racemic 50:50 → no rotation" }
      ] },
    { "heading": "Why it matters in medicines",
      "lines": [
        { "say": "Enzymes and receptors in your body are chiral too.", "write": "receptors are chiral" },
        { "say": "One enantiomer fits the site like a hand in a glove. Its mirror image may not.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "One enantiomer fits a receptor site, the mirror image does not", "items": [
            {"kind": "rect", "x": 60, "y": 150, "w": 180, "h": 60, "fill": "blue", "label": "receptor"},
            {"kind": "polygon", "points": [[100, 150], [150, 100], [200, 150]], "fill": "green", "change": "add"},
            {"kind": "text", "x": 150, "y": 80, "text": "fits ✓", "size": 20, "anchor": "middle", "color": "green"},
            {"kind": "rect", "x": 320, "y": 150, "w": 180, "h": 60, "fill": "blue", "label": "receptor"},
            {"kind": "polygon", "points": [[360, 100], [460, 100], [410, 140]], "fill": "red", "change": "remove"},
            {"kind": "text", "x": 410, "y": 80, "text": "poor fit ✗", "size": 20, "anchor": "middle", "color": "red"}]}},
        { "say": "Thalidomide: one enantiomer calmed morning sickness. The other was linked to birth defects.", "write": "thalidomide" },
        { "say": "Now the separate enantiomers of a new chiral drug are tested.", "write": "test each enantiomer" },
        { "say": "Even smell can tell. Carvone smells of spearmint or caraway, depending on the enantiomer.", "write": "carvone: spearmint vs caraway" }
      ] },
    { "heading": "Watch out for these",
      "lines": [
        { "say": "Bending or flipping a drawing doesn't make a new isomer. Name both to check.", "write": "same name → same compound" },
        { "say": "Not every alkene has cis and trans. Check both carbons of the double bond.", "write": "check BOTH carbons" },
        { "say": "Compare whole groups. Pentan-3-ol has two ethyl groups on carbon 3, so it is not chiral.", "write": "pentan-3-ol: not chiral" },
        { "say": "Enantiomers do not have different boiling points. Only the light rotation differs.", "write": "✗ different b.p." }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Isomers share a molecular formula but differ in structure.", "write": "same formula, different structure" },
        { "say": "Structural isomers: chain, place, group. They have different names.", "write": "Chain, Place, Group" },
        { "say": "Cis and trans need a locked double bond with two different groups on each carbon.", "write": "cis = Same Side" },
        { "say": "Four different groups on a carbon make a chiral centre and two enantiomers.", "write": "4 different groups → chiral" }
      ] }
  ]
}

    {
      "heading": "Primary and secondary cells",
      "lines": [
        {
          "say": "A primary cell is used once, then thrown away.",
          "write": "primary: single use"
        },
        {
          "say": "A secondary cell can be recharged, because its reaction can be reversed.",
          "write": "secondary: rechargeable"
        },
        {
          "say": "The products must stay stuck to the electrodes, ready to convert back.",
          "write": "products stay on electrodes"
        },
        {
          "say": "And there must be few side reactions using up materials.",
          "write": "few side reactions"
        }
      ]
    },

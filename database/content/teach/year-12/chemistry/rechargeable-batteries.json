        {
          "say": "Recharging pushes them back into the graphite.",
          "write": "recharge: back to graphite"
        },
        {
          "say": "The electrolyte is non-aqueous, because lithium reacts with water.",
          "write": "organic solvent"
        }
      ]
    },
    {
      "heading": "Why batteries wear out",
      "lines": [
        {
          "say": "Side reactions use up electrode material or electrolyte.",
          "write": "side reactions"
        },
        {
          "say": "Lead sulfate can form hard crystals if left discharged.",
          "write": "hard PbSO₄ crystals"
        },
        {
          "say": "High temperature speeds up side reactions. Cold slows the main reaction.",
          "write": "temperature"
        },
        {
          "say": "Overcharging, fast charging and full discharges all shorten life.",
          "write": "charging habits"
        }
      ]
    },
    {
      "heading": "A charging calculation",
      "lines": [
        {
          "say": "Recharge with 5.00 amps for two hours. That is 7200 seconds.",
          "write": "t = 7200 s"
        },
        {
          "say": "Q is 36 000 coulombs. Divide by 96 500: 0.3731 moles of electrons.",
          "write": "n(e⁻) = 0.3731 mol"
        },
        {
          "say": "Two electrons per lead, so 0.1865 moles of lead.",
          "write": "PbSO₄ + 2e⁻ → Pb + SO₄²⁻"
        },
        {
          "say": "Times 207.2 gives 38.6 grams of lead.",
          "write": "m(Pb) = 38.6 g"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Polarity does not change on recharging. Only the names swap.",
          "write": "✗ polarity changes"
        },
        {
          "say": "Charge positive to positive, not positive to negative.",
          "write": "+ to +"
        },
        {
          "say": "Do not write aqueous states for lithium-ion species.",
          "write": "non-aqueous"
        }
      ]
    },

    {
      "heading": "Industrial electrolysis",
      "lines": [
        {
          "say": "Aluminium oxide dissolves in molten cryolite, and is electrolysed with carbon.",
          "write": "Al₂O₃ in cryolite"
        },
        {
          "say": "The carbon anodes get used up. It takes huge currents.",
          "write": "energy-intensive"
        },
        {
          "say": "The chlor-alkali process electrolyses brine for chlorine, hydrogen and sodium hydroxide.",
          "write": "brine → Cl₂, H₂, NaOH"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Time must be in seconds in Q equals I t.",
          "write": "t in seconds"
        },
        {
          "say": "Divide by the electrons in the half-equation.",
          "write": "use mole ratio"
        },
        {
          "say": "In aqueous solutions, remember water. No sodium metal forms.",
          "write": "don't forget water"
        },
        {
          "say": "In electrolysis, the anode is positive.",
          "write": "electrolytic anode +"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Electrolysis turns electrical energy into chemical energy.",
          "write": "electrical → chemical"
        },
        {
          "say": "Strongest oxidant reduced at the cathode. Strongest reductant oxidised at the anode.",
          "write": "oxidant → cathode"
        },
        {
          "say": "Q equals I t, and n electrons equals Q over F.",
          "write": "Q = It, n = Q ÷ F"
        },

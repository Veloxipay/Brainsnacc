    {
      "heading": "Faraday's laws",
      "lines": [
        {
          "say": "Charge Q equals current times time, in seconds.",
          "write": "Q = I × t"
        },
        {
          "say": "Moles of electrons equal Q over F. F is 96 500.",
          "write": "n(e⁻) = Q ÷ 96 500"
        },
        {
          "say": "Two amps for 30 minutes. That is 1800 seconds, so 3600 coulombs.",
          "write": "Q = 2.00 × 1800 = 3600 C"
        },
        {
          "say": "3600 over 96 500 gives 0.03731 moles of electrons.",
          "write": "n(e⁻) = 0.03731 mol"
        },
        {
          "say": "Copper needs two electrons each, so halve it.",
          "write": "n(Cu) = 0.01865 mol",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Two electrons per copper",
            "items": [

    {
      "heading": "Molten versus aqueous",
      "lines": [
        {
          "say": "In molten sodium chloride, only sodium and chloride ions can react.",
          "write": "molten: no water"
        },
        {
          "say": "Sodium ions are reduced to sodium metal at the cathode.",
          "write": "Na⁺ + e⁻ → Na"
        },
        {
          "say": "Chloride ions are oxidised to chlorine gas at the anode.",
          "write": "2Cl⁻ → Cl₂ + 2e⁻"
        },
        {
          "say": "In water, water competes, and is reduced before sodium ions.",
          "write": "aqueous: H₂ not Na",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Water reduced before sodium",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 60,
                "w": 200,
                "h": 60,
                "fill": "blue",
                "label": "H₂O: −0.83 V",
                "change": "highlight"
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 160,
                "w": 200,
                "h": 60,
                "fill": "grey",
                "label": "Na⁺: −2.71 V"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 95,
                "text": "reduced first",
                "size": 22,
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 195,
                "text": "stays",
                "size": 20,
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "So reactive metals like sodium and aluminium need molten compounds.",
          "write": "molten for Na, Al"
        }
      ]
    },
    {
      "heading": "Predicting products",
      "lines": [
        {
          "say": "List every species, including water and the electrode.",
          "write": "list all species"
        },
        {
          "say": "At the cathode, the strongest oxidant, highest E nought, is reduced.",
          "write": "cathode: highest E° reduced"
        },
        {
          "say": "At the anode, the strongest reductant, lowest E nought, is oxidised.",
          "write": "anode: lowest E° oxidised"
        },
        {
          "say": "Potassium iodide solution: water beats potassium at the cathode.",
          "write": "2H₂O + 2e⁻ → H₂ + 2OH⁻"
        },
        {
          "say": "Iodide at 0.54 beats water at 1.23, so iodine forms.",
          "write": "2I⁻ → I₂ + 2e⁻",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Iodide oxidised before water",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 220,
                "h": 60,
                "fill": "purple",
                "label": "I⁻: +0.54 V",
                "change": "highlight"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 160,
                "w": 220,
                "h": 60,
                "fill": "blue",
                "label": "H₂O: +1.23 V"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 95,
                "text": "oxidised",
                "size": 22,
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 195,
                "text": "stays",
                "size": 20,
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Concentrated brine gives chlorine at the anode. Dilute gives mainly oxygen.",
          "write": "brine → Cl₂"
        }
      ]

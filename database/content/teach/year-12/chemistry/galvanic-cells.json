      "lines": [
        {
          "say": "E nought values only apply at standard conditions.",
          "write": "standard conditions only"
        },
        {
          "say": "The series says if a reaction can happen, not how fast.",
          "write": "not rate"
        },
        {
          "say": "Real cells give lower voltage, because of internal resistance.",
          "write": "internal resistance"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "In a galvanic cell the anode is negative, not positive.",
          "write": "anode is −"
        },
        {
          "say": "Electrons go in the wire. Ions move in the solution.",
          "write": "e⁻ wire, ions solution"
        },
        {
          "say": "Electrons must cancel in the overall equation.",
          "write": "no e⁻ in overall"
        },
        {
          "say": "Use platinum or carbon when there is no solid metal.",
          "write": "Pt or C"
        }
      ]

    {
      "heading": "Comparing fuels",
      "lines": [
        {
          "say": "Per 1000 kilojoules, methane releases 49.4 grams of CO two.",
          "write": "CH₄: 49.4 g"
        },
        {
          "say": "Octane releases 64.5 grams, and ethanol 64.7 grams.",
          "write": "C₈H₁₈ 64.5 g, ethanol 64.7 g",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 307,
            "alt": "CO2 per 1000 kJ",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 200,
                "w": 100,
                "h": 70,
                "fill": "blue",
                "label": "49.4"
              },
              {
                "kind": "rect",
                "x": 230,
                "y": 175,
                "w": 100,
                "h": 95,
                "fill": "grey",

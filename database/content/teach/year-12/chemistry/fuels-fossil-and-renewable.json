                "y": 295,
                "text": "ethanol",
                "size": 16,
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "But ethanol’s carbon came out of the air recently.",
          "write": "recent carbon"
        },
        {
          "say": "Crop fuels raise the food versus fuel debate. Waste avoids it.",
          "write": "food vs fuel"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Biofuels do release CO two. The carbon was just absorbed recently.",
          "write": "✗ no CO₂"
        },
        {
          "say": "Hydrogen is only renewable if made with renewable energy.",
          "write": "say how H₂ is made"
        },
        {
          "say": "Fermentation is anaerobic. Oxygen is not a reactant.",
          "write": "no O₂"
        },
        {
          "say": "Transesterification gives esters and glycerol, not fatty acids and water.",
          "write": "esters + glycerol"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Renewable is about rate of replacement versus rate of use.",
          "write": "rate"
        },
        {
          "say": "Biogas, bioethanol and biodiesel come from biomass.",
          "write": "three biofuels"
        },
        {
          "say": "Green hydrogen comes from electrolysis with renewable power.",
          "write": "green H₂"
        },
        {
          "say": "Biofuels are nearly, not exactly, carbon neutral.",
          "write": "nearly neutral"
        }
      ]
    }
  ]

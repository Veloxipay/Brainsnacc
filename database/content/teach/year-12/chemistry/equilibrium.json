    {
      "heading": "The equilibrium constant K",
      "lines": [
        {
          "say": "K is products over reactants, each raised to its coefficient.",
          "write": "K = [C]ᶜ[D]ᵈ ÷ [A]ᵃ[B]ᵇ"
        },
        {
          "say": "Use equilibrium concentrations. Leave out pure solids and liquids.",
          "write": "equilibrium conc. only"
        },
        {
          "say": "A large K means mostly products. A small K means mostly reactants.",
          "write": "large K → products",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Small and large K",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 200,
                "h": 80,
                "fill": "blue",
                "label": "K = 10⁻¹⁰"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 60,
                "w": 200,
                "h": 80,
                "fill": "green",
                "label": "K = 10¹⁰",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 190,
                "text": "mostly reactants",
                "size": 18,
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 190,
                "text": "mostly products",
                "size": 18,
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Only temperature changes K. K says nothing about speed.",
          "write": "only T changes K"
        },
        {
          "say": "For N two O four, K is NO two squared over N two O four.",
          "write": "K = [NO₂]² ÷ [N₂O₄]"
        },
        {
          "say": "0.0120 squared over 0.0400 gives 3.60 times ten to the minus three.",
          "write": "K = 3.60 × 10⁻³ M"
        }
      ]
    },

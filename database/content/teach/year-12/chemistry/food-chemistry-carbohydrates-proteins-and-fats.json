    {
      "heading": "Carbohydrates",
      "lines": [
        {
          "say": "Glucose, fructose and galactose are isomers: all C six H twelve O six.",
          "write": "C₆H₁₂O₆ isomers"
        },
        {
          "say": "Two monosaccharides join by a glycosidic bond, making a disaccharide.",
          "write": "glycosidic bond"
        },
        {
          "say": "Glucose plus fructose gives sucrose. Glucose plus galactose gives lactose.",
          "write": "sucrose, lactose, maltose"
        },
        {
          "say": "Starch stores energy in plants: amylose coils, amylopectin branches.",
          "write": "starch"
        },
        {
          "say": "Glycogen is even more branched. It is the animal store.",
          "write": "glycogen"
        },
        {
          "say": "Cellulose has straight chains. We cannot digest it, so it is fibre.",
          "write": "cellulose = fibre"
        }
      ]

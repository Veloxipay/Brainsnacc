    {
      "heading": "Two quick calculations",
      "lines": [
        {
          "say": "150 amino acids have 149 peptide bonds, so 149 waters to hydrolyse.",
          "write": "149 H₂O"
        },
        {
          "say": "For 1.00 millimole, that is 0.149 moles, or 2.68 grams of water.",
          "write": "0.149 × 18.0 = 2.68 g"
        },
        {
          "say": "Tristearin: 92.0 plus three times 284.0, minus three waters.",
          "write": "92.0 + 852.0 − 54.0"
        },
        {
          "say": "That gives 890.0 grams per mole.",
          "write": "M = 890.0 g mol⁻¹"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Denaturation does not break peptide bonds. Hydrolysis does.",
          "write": "✗ denature = hydrolyse"
        },
        {
          "say": "Fats have ester bonds. Proteins have peptide bonds. Sugars have glycosidic bonds.",
          "write": "ester, peptide, glycosidic"
        },
        {
          "say": "Count omega positions from the CH three end, not the COOH.",
          "write": "omega from CH₃"
        }
      ]

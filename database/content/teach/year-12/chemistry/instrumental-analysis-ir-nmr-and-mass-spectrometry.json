    {
      "heading": "NMR basics",
      "lines": [
        {
          "say": "Atoms in the same environment give one signal.",
          "write": "environments"
        },
        {
          "say": "Shift is measured in ppm from TMS, which is set at zero.",
          "write": "TMS = 0 ppm"
        },
        {
          "say": "Atoms near oxygen or C double bond O appear at higher shift.",
          "write": "deshielded → higher δ"
        },
        {
          "say": "Carbon-13 NMR: one peak per carbon environment, no splitting.",
          "write": "¹³C: count peaks"
        },
        {
          "say": "Propan-2-ol has only two carbon environments. The two CH three are equal.",
          "write": "propan-2-ol: 2 peaks"
        }
      ]
    },

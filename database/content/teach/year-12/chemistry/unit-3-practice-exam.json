        {
          "say": "q equals 200 times 4.18 times 15. That is 12.5 kilojoules.",
          "write": "q = 12.5 kJ"
        },
        {
          "say": "1.15 grams of ethanol is 0.0250 moles, releasing 34.0 kilojoules.",
          "write": "0.0250 × 1360 = 34.0 kJ"
        },
        {
          "say": "Efficiency is 12.54 over 34.0, so 36.9 percent.",
          "write": "36.9%"
        },
        {
          "say": "Heat is lost to the air and the can.",
          "write": "heat lost"
        }
      ]

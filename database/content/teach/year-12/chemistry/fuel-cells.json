      "heading": "Faraday calculations",
      "lines": [
        {
          "say": "A cell gives 2.50 amps for two hours. That is 7200 seconds.",
          "write": "t = 7200 s"
        },
        {
          "say": "Q equals I t, so 18 000 coulombs.",
          "write": "Q = 2.50 × 7200 = 18 000 C"
        },
        {
          "say": "Divide by 96 500. That is 0.1865 moles of electrons.",
          "write": "n(e⁻) = 0.1865 mol"
        },
        {
          "say": "Each hydrogen gives two electrons, so halve it: 0.09326 moles.",
          "write": "n(H₂) = 0.09326 mol"
        },
        {
          "say": "Times 24.8 gives 2.31 litres of hydrogen at SLC.",
          "write": "V(H₂) = 2.31 L"
        },
        {
          "say": "Efficiency: 12.6 kilojoules out, from 26.7 available. That is 47.2 percent.",
          "write": "12.6 ÷ 26.7 = 47.2%"
        }
      ]
    },

    {
      "heading": "The Haber process",
      "lines": [
        {
          "say": "Making ammonia is exothermic, with fewer gas moles on the right.",
          "write": "ΔH = −92 kJ mol⁻¹"
        },
        {
          "say": "High pressure gives more yield and a faster rate.",
          "write": "high pressure"
        },
        {
          "say": "Low temperature gives more yield, but the rate is too slow.",
          "write": "temperature conflict",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Temperature compromise",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 80,
                "w": 220,
                "h": 90,
                "fill": "green",
                "label": "low T: high yield"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 80,
                "w": 220,
                "h": 90,
                "fill": "red",
                "label": "low T: too slow"

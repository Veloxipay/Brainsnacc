                "y": 230,
                "text": "compromise: moderate T",
                "size": 22,
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So a moderate temperature is chosen, with an iron catalyst.",
          "write": "moderate T + Fe catalyst"
        },
        {
          "say": "Ammonia is liquefied and removed. Unreacted gases are recycled.",
          "write": "remove NH₃, recycle"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A catalyst does not increase yield. It just gets there faster.",
          "write": "✗ catalyst ↑ yield"
        },
        {
          "say": "Argon at constant volume causes no shift.",
          "write": "✗ inert gas shift"
        },
        {
          "say": "Raising temperature always favours the endothermic direction.",
          "write": "↑T → endothermic"
        },
        {
          "say": "The system only partly opposes the change.",
          "write": "partial"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Add reactant, shift right. Add product, shift left.",
          "write": "add → use it up"
        },
        {
          "say": "Smaller volume shifts to fewer gas moles.",
          "write": "fewer gas moles"
        },
        {
          "say": "Only temperature changes K.",
          "write": "only T changes K"

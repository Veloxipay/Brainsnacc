              {
                "kind": "rect",
                "x": 320,
                "y": 80,
                "w": 180,
                "h": 150,
                "fill": "red",
                "label": "darker red",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "The solution goes darker red. K does not change.",
          "write": "K unchanged"
        },
        {
          "say": "Removing a product also shifts right. That is why ammonia is removed.",
          "write": "remove NH₃ → right"
        }
      ]
    },
    {
      "heading": "Changing volume",
      "lines": [

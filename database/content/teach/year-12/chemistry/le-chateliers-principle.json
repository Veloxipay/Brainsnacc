            ]
          }
        },
        {
          "say": "Add iron three plus. The system uses some up, shifting right.",
          "write": "add Fe³⁺ → right",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Shift right, darker red",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 80,
                "w": 180,
                "h": 150,
                "fill": "yellow",
                "label": "Fe³⁺ + SCN⁻",
                "change": "highlight"
              },
              {
                "kind": "arrow",
                "x": 250,
                "y": 155,
                "x2": 310,
                "y2": 155,
                "color": "purple",
                "change": "add"

{
  "level": "Year 12",
  "subject": "chemistry",
  "title": "Le Chatelier’s principle",
  "frames": [
    {
      "heading": "The principle",
      "lines": [
        {
          "say": "If you change a system at equilibrium, it shifts to partially oppose the change.",
          "write": "partially oppose"
        },
        {
          "say": "Shift right means more products. Shift left means more reactants.",
          "write": "right = more products"
        },
        {
          "say": "It never fully cancels the change. Only partly.",
          "write": "partial, not full"
        },
        {
          "say": "Check any prediction with Q and K.",
          "write": "Q < K → right"
        }
      ]
    },
    {
      "heading": "Changing concentration",
      "lines": [
        {
          "say": "Iron three plus and thiocyanate make deep red FeSCN two plus.",
          "write": "Fe³⁺ + SCN⁻ ⇌ FeSCN²⁺",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Iron thiocyanate equilibrium",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 80,
                "w": 180,
                "h": 150,
                "fill": "yellow",
                "label": "Fe³⁺ + SCN⁻"
              },
              {
                "kind": "arrow",
                "x": 250,
                "y": 155,
                "x2": 310,
                "y2": 155,
                "color": "black"

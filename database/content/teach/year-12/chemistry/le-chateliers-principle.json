                "h": 180,
                "fill": "white",
                "label": "ice: pale",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "A catalyst speeds up both directions equally. No shift at all.",
          "write": "catalyst: faster, no shift"
        }
      ]
    },

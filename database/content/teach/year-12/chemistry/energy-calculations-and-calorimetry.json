                "bold": true
              },
              {
                "kind": "text",
                "x": 470,
                "y": 140,
                "text": "43.0 °C",
                "size": 20,
                "anchor": "start",
                "bold": true,
                "color": "red",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "n equals V over 24.8 at SLC. Otherwise P V equals n R T.",
          "write": "n = V ÷ 24.8"
        },
        {
          "say": "Calibrate with E equals V I t, then CF equals E over delta T.",
          "write": "CF = E ÷ ΔT"
        },
        {
          "say": "Efficiency is useful energy over total energy, times 100.",
          "write": "% eff = useful ÷ total × 100"
        }
      ]

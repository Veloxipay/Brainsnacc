{
  "level": "Year 12", "subject": "chemistry", "title": "Unit 4 summary and memory tips",
  "frames": [
    { "heading": "Naming and isomers",
      "lines": [
        { "say": "Monkeys eat peeled bananas. Meth, eth, prop, but, for one to four carbons.", "write": "meth eth prop but" },
        { "say": "Longest chain with the group, lowest number to the group, then the ending.", "write": "chain → number → ending" },
        { "say": "The alcohol says its name first. C H three C O O C H two C H three is ethyl ethanoate.", "write": "ethyl ethanoate",
          "draw": {"type": "shapes", "width": 560, "height": 180, "alt": "Ester name: alcohol part first, acid part second", "items": [
            {"kind": "rect", "x": 40, "y": 40, "w": 220, "h": 70, "fill": "teal", "label": "ethyl (alcohol)", "change": "highlight"},
            {"kind": "rect", "x": 280, "y": 40, "w": 240, "h": 70, "fill": "orange", "label": "ethanoate (acid)"},
            {"kind": "text", "x": 280, "y": 155, "text": "-yl first, -oate second", "size": 20, "anchor": "middle"}]}},
        { "say": "Four different friends make a chiral carbon. Any C H two or C H three is out.", "write": "chiral = 4 different groups",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "A carbon with four different groups", "items": [
            {"kind": "circle", "x": 280, "y": 120, "r": 30, "fill": "grey", "label": "C*", "change": "highlight"},
            {"kind": "circle", "x": 280, "y": 35, "r": 24, "fill": "white", "label": "H"},
            {"kind": "circle", "x": 280, "y": 205, "r": 26, "fill": "red", "label": "OH"},
            {"kind": "circle", "x": 170, "y": 120, "r": 30, "fill": "orange", "label": "CH₃"},
            {"kind": "rect", "x": 345, "y": 95, "w": 120, "h": 50, "fill": "teal", "label": "C₂H₅"},
            {"kind": "line", "x": 280, "y": 90, "x2": 280, "y2": 59},
            {"kind": "line", "x": 280, "y": 150, "x2": 280, "y2": 179},
            {"kind": "line", "x": 250, "y": 120, "x2": 200, "y2": 120},
            {"kind": "line", "x": 310, "y": 120, "x2": 345, "y2": 120}]}},
        { "say": "Cis means same side. You need two different groups on each carbon of the double bond.", "write": "cis = same side" }
      ] },
    { "heading": "Reactions and pathways",
      "lines": [
        { "say": "Add opens the double door. Addition needs C double bond C and wastes nothing.", "write": "addition = 100% atom economy" },
        { "say": "Primary goes all the way. Secondary stops at a ketone. Tertiary won't play.", "write": "1° acid, 2° ketone, 3° none",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Dichromate test tubes: green, green, orange", "items": [
            {"kind": "rect", "x": 80, "y": 30, "w": 80, "h": 130, "fill": "green"},
            {"kind": "rect", "x": 240, "y": 30, "w": 80, "h": 130, "fill": "green"},
            {"kind": "rect", "x": 400, "y": 30, "w": 80, "h": 130, "fill": "orange", "change": "highlight"},
            {"kind": "text", "x": 120, "y": 195, "text": "1°", "size": 22, "anchor": "middle", "bold": true},
            {"kind": "text", "x": 280, "y": 195, "text": "2°", "size": 22, "anchor": "middle", "bold": true},
            {"kind": "text", "x": 440, "y": 195, "text": "3° stays orange", "size": 18, "anchor": "middle", "bold": true}]}},
        { "say": "Condensation joins and loses water. Hydrolysis uses water to split.", "write": "condense − H₂O, hydrolyse + H₂O" },
        { "say": "Multiply step yields. Three steps at 80 percent give only 51.2 percent.", "write": "0.80³ = 51.2%" },
        { "say": "Can you draw ethene to ethyl ethanoate, with conditions on every arrow?", "write": "self-check pathway" }
      ] },
    { "heading": "Analysing compounds",
      "lines": [
        { "say": "I R for groups, N M R for skeleton, M S for mass.", "write": "IR groups, NMR skeleton, MS mass" },
        { "say": "A broad O H at 2500 to 3300 plus C double bond O means a carboxylic acid.", "write": "very broad O–H → acid" },
        { "say": "N plus 1 equals neighbours plus one. An ethyl gives a triplet of 3 and a quartet of 2.", "write": "ethyl: triplet 3H, quartet 2H",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "A triplet and a quartet", "items": [
            {"kind": "line", "x": 30, "y": 170, "x2": 530, "y2": 170},
            {"kind": "line", "x": 380, "y": 170, "x2": 380, "y2": 110, "color": "blue"},
            {"kind": "line", "x": 400, "y": 170, "x2": 400, "y2": 50, "color": "blue"},
            {"kind": "line", "x": 420, "y": 170, "x2": 420, "y2": 110, "color": "blue"},
            {"kind": "line", "x": 130, "y": 170, "x2": 130, "y2": 140, "color": "teal", "change": "add"},
            {"kind": "line", "x": 150, "y": 170, "x2": 150, "y2": 90, "color": "teal", "change": "add"},
            {"kind": "line", "x": 170, "y": 170, "x2": 170, "y2": 90, "color": "teal", "change": "add"},
            {"kind": "line", "x": 190, "y": 170, "x2": 190, "y2": 140, "color": "teal", "change": "add"},
            {"kind": "text", "x": 400, "y": 195, "text": "triplet (CH₃)", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 160, "y": 195, "text": "quartet (CH₂)", "size": 16, "anchor": "middle"}]}},
        { "say": "Stick and you're slow. Sticky components have a low R f and long retention time.", "write": "sticks → slow" },
        { "say": "Read the unknown off the calibration curve, then apply the dilution factor.", "write": "× dilution factor" }
      ] },
    { "heading": "Food chemistry",
      "lines": [
        { "say": "Proteins are amino acids joined by peptide bonds, C O N H.", "write": "–CO–NH–" },
        { "say": "Heat cooks the shape, not the chain. Denaturation leaves peptide bonds intact.", "write": "denature: shape lost, chain kept" },
        { "say": "Sixteen, seventeen, thirty-seven. Carbohydrate, protein, fat, in kilojoules per gram.", "write": "16 – 17 – 37 kJ/g",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Bars of 16, 17 and 37 kJ per gram", "items": [
            {"kind": "rect", "x": 160, "y": 20, "w": 130, "h": 45, "fill": "blue", "label": "16"},
            {"kind": "rect", "x": 160, "y": 85, "w": 138, "h": 45, "fill": "green", "label": "17"},
            {"kind": "rect", "x": 160, "y": 150, "w": 300, "h": 45, "fill": "orange", "label": "37", "change": "highlight"},
            {"kind": "text", "x": 30, "y": 50, "text": "carb", "size": 18},
            {"kind": "text", "x": 30, "y": 115, "text": "protein", "size": 18},
            {"kind": "text", "x": 30, "y": 180, "text": "fat", "size": 18}]}},
        { "say": "Fat is less burnt already. It has little oxygen, so it releases more energy.", "write": "fat: less oxidised" },
        { "say": "Sun D, citrus C. Vitamin D is fat-soluble. Vitamin C is water-soluble.", "write": "D fat-soluble, C water-soluble" }
      ] },
    { "heading": "Enzymes",
      "lines": [
        { "say": "Enzymes are protein catalysts with an active site that fits one substrate.", "write": "active site, induced fit" },
        { "say": "They lower activation energy, but do not change delta H.", "write": "lower Eₐ, same ΔH" },
        { "say": "Too hot, or the wrong pH, and the active site changes shape. Denatured.", "write": "wrong T or pH → denatured",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "An enzyme active site loses its shape", "items": [
            {"kind": "rect", "x": 60, "y": 110, "w": 180, "h": 70, "fill": "blue", "label": "enzyme"},
            {"kind": "polygon", "points": [[110, 110], [150, 60], [190, 110]], "fill": "green"},
            {"kind": "text", "x": 150, "y": 210, "text": "fits", "size": 18, "anchor": "middle"},
            {"kind": "rect", "x": 320, "y": 110, "w": 180, "h": 70, "fill": "blue", "label": "denatured"},
            {"kind": "polygon", "points": [[370, 110], [410, 60], [450, 110]], "fill": "green", "change": "remove"},
            {"kind": "text", "x": 410, "y": 210, "text": "no longer fits", "size": 18, "anchor": "middle"}]}}
      ] },
    { "heading": "The practical investigation",
      "lines": [
        { "say": "Change one independent variable. Measure the dependent. Control the rest.", "write": "IV, DV, controlled" },
        { "say": "Random errors hurt precision. Repeat and average.", "write": "random → repeat" },
        { "say": "Systematic errors hurt accuracy. Improve the method or equipment.", "write": "systematic → better method" },
        { "say": "Present it as a poster with the VCAA headings, backed by your logbook.", "write": "poster + logbook" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Read one section, close it, and write down everything you remember.", "write": "read, close, recall" },
        { "say": "Then check, and fix the gaps before you move on.", "write": "check the gaps" },
        { "say": "Use the memory tricks to lock in the key facts.", "write": "use the tricks" }
      ] }
  ]
}

                "y": 295,
                "text": "protein",
                "size": 16,
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 440,
                "y": 295,
                "text": "fat",
                "size": 16,
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Fibre, like cellulose, supplies little energy, because we cannot digest it.",
          "write": "fibre"
        }
      ]
    },
    {
      "heading": "Why fats hold more energy",
      "lines": [
        {
          "say": "Glucose has about one oxygen per carbon. It is already partly oxidised.",
          "write": "C₆H₁₂O₆"
        },
        {
          "say": "Fats are long hydrocarbon chains with very little oxygen.",
          "write": "C₁₈H₃₆O₂"
        },
        {
          "say": "So each gram of fat can react with more oxygen, releasing more energy.",
          "write": "less oxidised → more energy"
        },
        {
          "say": "Fat is stored without water, so it is a compact long-term store.",
          "write": "compact store"
        }
      ]
    },
    {
      "heading": "A muesli bar",
      "lines": [
        {
          "say": "A bar has 18 grams carbohydrate, 4.0 protein, and 6.0 fat.",
          "write": "18 g, 4.0 g, 6.0 g"
        },
        {
          "say": "Carbohydrate: 18 times 16 is 288 kilojoules.",
          "write": "18 × 16 = 288 kJ",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Carbohydrate energy bar",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 100,
                "w": 239,
                "h": 70,
                "fill": "orange",

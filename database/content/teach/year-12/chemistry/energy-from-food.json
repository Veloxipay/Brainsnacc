                "y": 190,
                "w": 120,
                "h": 80,
                "fill": "orange",
                "label": "16"
              },
              {
                "kind": "rect",
                "x": 220,
                "y": 180,
                "w": 120,
                "h": 90,
                "fill": "pink",
                "label": "17"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 80,
                "w": 120,
                "h": 190,
                "fill": "yellow",
                "label": "37",

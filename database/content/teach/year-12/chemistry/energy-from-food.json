  "title": "Energy from food",
  "frames": [
    {
      "heading": "Food as a fuel",
      "lines": [
        {
          "say": "Food molecules react with oxygen to make CO two and water.",
          "write": "food + O₂ → CO₂ + H₂O"
        },
        {
          "say": "This is exothermic, so energy is released.",
          "write": "ΔH < 0"
        },
        {
          "say": "Carbohydrate gives 16 kilojoules per gram, protein 17, fat 37.",
          "write": "16, 17, 37 kJ g⁻¹",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 307,
            "alt": "Energy per gram of nutrients",

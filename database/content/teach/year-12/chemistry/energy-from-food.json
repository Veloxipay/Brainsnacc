    {
      "heading": "Glycaemic index",
      "lines": [
        {
          "say": "GI ranks how fast a carbohydrate raises blood glucose. Glucose is 100.",
          "write": "glucose = 100"
        },
        {
          "say": "Low is 55 or less. High is 70 or more.",
          "write": "low ≤ 55, high ≥ 70"
        },
        {
          "say": "Branched amylopectin has many ends for amylase, so it digests fast.",
          "write": "amylopectin → high GI"
        },
        {
          "say": "Coiled amylose is harder to reach, so it gives a lower GI.",
          "write": "amylose → low GI"
        },
        {
          "say": "Fibre, fat and protein slow digestion and lower GI.",
          "write": "fibre lowers GI"
        }
      ]
    },
    {
      "heading": "Measuring food energy",
      "lines": [
        {
          "say": "Burn a 1.20 gram cashew under 100 grams of water.",
          "write": "m(water) = 100.0 g"
        },
        {
          "say": "The water warms 25.5 degrees. q is 10.7 kilojoules.",
          "write": "q = 100 × 4.18 × 25.5"
        },
        {
          "say": "That is only 8.88 kilojoules per gram. Heat escaped.",
          "write": "8.88 kJ g⁻¹ (too low)"
        },
        {
          "say": "A bomb calorimeter is calibrated with E equals V I t.",
          "write": "CF = VIt ÷ ΔT"
        },
        {
          "say": "1500 joules raised it 0.750 degrees. CF is 2.00 kilojoules per degree.",
          "write": "CF = 2.00 kJ °C⁻¹"
        },
        {
          "say": "Glucose raised it 3.90 degrees: 7.80 kilojoules, so 15.6 per gram.",
          "write": "15.6 kJ g⁻¹"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Use the mass of water, not food, in q equals m c delta T.",
          "write": "m = water"
        },
        {
          "say": "Divide joules by 1000 to get kilojoules.",
          "write": "J ÷ 1000"
        },
        {
          "say": "Respiration releases the same total energy, just in steps.",
          "write": "same ΔH"
        },
        {
          "say": "GI is about speed, not kilojoules.",
          "write": "GI ≠ energy"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "16, 17, 37: carbohydrate, protein, fat.",
          "write": "16 / 17 / 37"
        },
        {
          "say": "Fats are less oxidised, so they release more per gram.",
          "write": "less oxidised"
        },
        {
          "say": "Respiration is slow, stepwise and enzyme-catalysed.",
          "write": "stepwise"
        },
        {
          "say": "Calibrate, then q equals CF times delta T.",
          "write": "q = CF × ΔT",
          "draw": {

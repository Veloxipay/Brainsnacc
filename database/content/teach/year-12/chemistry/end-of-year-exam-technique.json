                "h": 90,
                "fill": "blue",
                "label": "Short answer + extended",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Spot easy wins, and questions to leave for later.",
          "write": "3. easy wins"
        },
        {
          "say": "Note which data book tables you will need.",
          "write": "4. data book tables"
        }
      ]
    },
    {
      "heading": "Multiple choice",
      "lines": [
        {
          "say": "Cover the options. Answer it yourself first.",
          "write": "answer first"
        },
        {
          "say": "Underline qualifiers like not, most, least and best.",
          "write": "underline NOT"
        },
        {
          "say": "Which change speeds up a solid reacting? Eliminate A, B and D.",
          "write": "eliminate",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Eliminating options",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 30,
                "w": 480,
                "h": 50,
                "fill": "white",
                "label": "A: larger lumps",
                "change": "remove"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 95,
                "w": 480,
                "h": 50,
                "fill": "white",
                "label": "B: lower temperature",
                "change": "remove"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 160,
                "w": 480,
                "h": 50,
                "fill": "green",
                "label": "C: more surface area",
                "change": "highlight"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 225,
                "w": 480,
                "h": 50,
                "fill": "white",
                "label": "D: dilute solution",
                "change": "remove"
              }
            ]
          }
        },
        {
          "say": "C wins. More surface area means more frequent collisions.",
          "write": "C ✓"
        },
        {
          "say": "Never leave one blank. Mark it and move on.",
          "write": "never blank"
        }
      ]
    },
    {
      "heading": "Showing working",
      "lines": [
        {
          "say": "Write the formula. Substitute with units. Then the answer.",
          "write": "formula → substitute → answer",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Three step working",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 110,
                "w": 153,
                "h": 70,
                "fill": "blue",
                "label": "Formula"
              },
              {
                "kind": "arrow",
                "x": 175,
                "y": 145,
                "x2": 201,
                "y2": 145,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 203,
                "y": 110,
                "w": 153,
                "h": 70,
                "fill": "orange",
                "label": "Substitute"
              },
              {
                "kind": "arrow",
                "x": 359,
                "y": 145,
                "x2": 385,
                "y2": 145,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 387,
                "y": 110,
                "w": 153,
                "h": 70,
                "fill": "green",
                "label": "Answer + unit",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Moles of sodium hydroxide: 0.1000 times 0.02140 litres.",
          "write": "n = 2.140 × 10⁻³ mol"
        },
        {
          "say": "One to one ratio, divided by 0.02500 litres.",
          "write": "c = n ÷ V"
        },
        {
          "say": "The acid is 0.08560 molar, to four significant figures.",
          "write": "c(HCl) = 0.08560 M"
        },
        {
          "say": "Clear working earns method marks, even if the answer slips.",
          "write": "method marks"
        }
      ]
    },
    {
      "heading": "Units and explanations",
      "lines": [
        {
          "say": "Give a unit on every final answer. Round only at the end.",
          "write": "units, round last"
        },
        {
          "say": "12 540 joules with no unit loses a mark. Write 12.5 kilojoules.",
          "write": "q = 12.5 kJ"
        },
        {
          "say": "Weak: particles move faster, so it’s quicker.",
          "write": "✗ vague",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Weak versus strong explanation",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 480,
                "h": 70,
                "fill": "red",
                "label": "\"it's quicker\"",
                "change": "remove"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 170,
                "w": 480,
                "h": 70,
                "fill": "green",
                "label": "more collisions ≥ Ea per second",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Strong: a greater proportion of collisions have energy at least Ea.",
          "write": "✓ use chemical terms"
        },
        {
          "say": "Answer the command word. Explain needs a reason. Compare needs both.",
          "write": "explain, compare, justify"
        }
      ]
    },

    {
      "heading": "Collision theory",
      "lines": [
        {
          "say": "Particles must collide to react.",
          "write": "1. collide"
        },
        {
          "say": "They must collide with at least the activation energy.",
          "write": "2. energy ≥ Ea"
        },
        {
          "say": "And they need the correct orientation.",
          "write": "3. right orientation"
        },
        {
          "say": "Collisions that meet all three are successful.",
          "write": "successful collisions"
        },
        {
          "say": "Rate depends on successful collisions per second. That is frequency.",
          "write": "frequency matters"
        }
      ]
    },

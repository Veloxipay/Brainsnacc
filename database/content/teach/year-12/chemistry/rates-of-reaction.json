  "frames": [
    {
      "heading": "What is rate?",
      "lines": [
        {
          "say": "Rate is how fast reactants are used up or products form.",
          "write": "rate = change ÷ time"
        },
        {
          "say": "It can be grams per second, mL per second, or molar per second.",
          "write": "g s⁻¹, mL s⁻¹, M s⁻¹"
        },

{
  "level": "Year 12", "subject": "chemistry", "title": "Vitamins and enzymes in food",
  "frames": [
    { "heading": "Vitamins are essential",
      "lines": [
        { "say": "Vitamins are organic compounds we need in small amounts. Many act as coenzymes.", "write": "vitamins: small amounts" },
        { "say": "Essential means your body can't make enough, so it must come from food.", "write": "essential → from the diet" },
        { "say": "Humans can't make vitamin C, so it's essential for us.", "write": "vitamin C: essential" },
        { "say": "Vitamin D can be made in your skin with U V light from the sun.", "write": "vitamin D: sunlight" }
      ] },
    { "heading": "Water-soluble or fat-soluble?",
      "lines": [
        { "say": "Like dissolves like. Look at the polar groups and the non-polar part.", "write": "like dissolves like" },
        { "say": "Vitamin C is small, with four O H groups. They hydrogen bond with water.", "write": "C₆H₈O₆: four –OH",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Small vitamin C with four OH groups hydrogen bonding to water", "items": [
            {"kind": "circle", "x": 280, "y": 120, "r": 50, "fill": "orange", "label": "vit C"},
            {"kind": "circle", "x": 200, "y": 60, "r": 20, "fill": "red", "label": "OH"},
            {"kind": "circle", "x": 360, "y": 60, "r": 20, "fill": "red", "label": "OH"},
            {"kind": "circle", "x": 200, "y": 180, "r": 20, "fill": "red", "label": "OH"},
            {"kind": "circle", "x": 360, "y": 180, "r": 20, "fill": "red", "label": "OH"},
            {"kind": "circle", "x": 110, "y": 40, "r": 22, "fill": "blue", "label": "H₂O", "change": "add"},
            {"kind": "circle", "x": 450, "y": 40, "r": 22, "fill": "blue", "label": "H₂O", "change": "add"},
            {"kind": "circle", "x": 110, "y": 200, "r": 22, "fill": "blue", "label": "H₂O", "change": "add"},
            {"kind": "circle", "x": 450, "y": 200, "r": 22, "fill": "blue", "label": "H₂O", "change": "add"},
            {"kind": "line", "x": 132, "y": 45, "x2": 180, "y2": 58, "dashed": true, "change": "add"},
            {"kind": "line", "x": 428, "y": 45, "x2": 380, "y2": 58, "dashed": true, "change": "add"},
            {"kind": "line", "x": 132, "y": 195, "x2": 180, "y2": 182, "dashed": true, "change": "add"},
            {"kind": "line", "x": 428, "y": 195, "x2": 380, "y2": 182, "dashed": true, "change": "add"}]}},
        { "say": "Vitamin D is big and mostly hydrocarbon, with just one O H.", "write": "C₂₇H₄₄O: one –OH",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Large non-polar vitamin D with a single OH", "items": [
            {"kind": "rect", "x": 60, "y": 60, "w": 400, "h": 80, "fill": "yellow", "label": "big non-polar part", "change": "highlight"},
            {"kind": "circle", "x": 490, "y": 100, "r": 24, "fill": "red", "label": "OH"},
            {"kind": "text", "x": 280, "y": 180, "text": "dispersion forces win → fat-soluble", "size": 18, "anchor": "middle"}]}},
        { "say": "The big non-polar part wins. Dispersion forces, so it dissolves in fat.", "write": "vitamin D: fat-soluble" },
        { "say": "Water-soluble vitamins wash out in urine. Eat them regularly.", "write": "C, B: not stored" },
        { "say": "Fat-soluble A, D, E and K are stored, and big doses can build up.", "write": "A, D, E, K: stored in fat" }
      ] },
    { "heading": "Enzymes: protein catalysts",
      "lines": [
        { "say": "Enzymes are proteins that speed up reactions without being used up.", "write": "enzyme = protein catalyst" },
        { "say": "They lower the activation energy, but delta H stays the same.", "write": "lower Eₐ, same ΔH" },
        { "say": "The substrate binds in a pocket called the active site.", "write": "active site",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Substrate moving into the enzyme's active site", "items": [
            {"kind": "rect", "x": 140, "y": 130, "w": 280, "h": 90, "fill": "blue", "label": "enzyme"},
            {"kind": "rect", "x": 240, "y": 110, "w": 80, "h": 22, "fill": "white"},
            {"kind": "rect", "x": 245, "y": 30, "w": 70, "h": 50, "fill": "green", "label": "substrate"},
            {"kind": "arrow", "x": 280, "y": 82, "x2": 280, "y2": 108, "color": "purple", "change": "add"}]}},
        { "say": "In induced fit, the site changes shape slightly and wraps around the substrate.", "write": "induced fit" },
        { "say": "Amylase breaks starch, protease breaks proteins, lipase breaks fats. All by hydrolysis.", "write": "amylase, protease, lipase" }
      ] },
    { "heading": "Temperature and pH",
      "lines": [
        { "say": "As it warms up, the rate rises. Faster particles, more collisions.", "write": "warmer → faster",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Bar chart of amylase rate against temperature, peaking at 37 degrees", "items": [
            {"kind": "line", "x": 40, "y": 240, "x2": 540, "y2": 240},
            {"kind": "rect", "x": 50, "y": 210, "w": 50, "h": 30, "fill": "blue"},
            {"kind": "rect", "x": 120, "y": 170, "w": 50, "h": 70, "fill": "blue"},
            {"kind": "rect", "x": 190, "y": 100, "w": 50, "h": 140, "fill": "blue"},
            {"kind": "rect", "x": 260, "y": 40, "w": 50, "h": 200, "fill": "green", "change": "highlight"},
            {"kind": "text", "x": 75, "y": 265, "text": "10", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 145, "y": 265, "text": "20", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 215, "y": 265, "text": "30", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 285, "y": 265, "text": "37 °C", "size": 16, "anchor": "middle"}]}},
        { "say": "Above the optimum, around 37 degrees, the shape breaks down. The rate drops fast.", "write": "above optimum → denatured",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Rate falls at 45, 55 and 65 degrees", "items": [
            {"kind": "line", "x": 40, "y": 240, "x2": 540, "y2": 240},
            {"kind": "rect", "x": 50, "y": 210, "w": 50, "h": 30, "fill": "blue"},
            {"kind": "rect", "x": 120, "y": 170, "w": 50, "h": 70, "fill": "blue"},
            {"kind": "rect", "x": 190, "y": 100, "w": 50, "h": 140, "fill": "blue"},
            {"kind": "rect", "x": 260, "y": 40, "w": 50, "h": 200, "fill": "green"},
            {"kind": "rect", "x": 330, "y": 120, "w": 50, "h": 120, "fill": "red", "change": "add"},
            {"kind": "rect", "x": 400, "y": 220, "w": 50, "h": 20, "fill": "red", "change": "add"},
            {"kind": "text", "x": 285, "y": 265, "text": "37 °C", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 355, "y": 265, "text": "45", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 425, "y": 265, "text": "55", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 495, "y": 265, "text": "65: 0", "size": 16, "anchor": "middle"}]}},
        { "say": "Heat denaturation is permanent. Cold only slows enzymes down.", "write": "cold = slow, not denatured" },
        { "say": "Each enzyme has an optimum pH. Pepsin about 2, amylase about 7, trypsin about 8.", "write": "pepsin 2, amylase 7, trypsin 8" },
        { "say": "Wrong pH changes side chain charges, so the active site loses its shape.", "write": "–COOH ⇌ –COO⁻ + H⁺" }
      ] },
    { "heading": "Chirality and taste",
      "lines": [
        { "say": "A carbon with four different groups is a chiral centre.", "write": "4 different groups → chiral" },
        { "say": "Alanine's central carbon has N H two, C O O H, H and C H three. Chiral.", "write": "alanine: chiral" },
        { "say": "Glycine has two H atoms on that carbon. Not chiral.", "write": "glycine: not chiral" },
        { "say": "Taste receptors are chiral. Only one form of aspartame tastes sweet.", "write": "aspartame: one isomer sweet" },
        { "say": "Aspartame is about 200 times sweeter than sucrose, but breaks down when baked.", "write": "~200 × sweeter than sucrose" }
      ] },
    { "heading": "Watch out for these",
      "lines": [
        { "say": "Enzymes aren't killed. They're denatured. They were never alive.", "write": "denatured, not dead" },
        { "say": "Denaturation doesn't break peptide bonds. The sequence stays the same.", "write": "peptide bonds stay" },
        { "say": "Vitamin D does have one O H. Its non-polar part just dominates.", "write": "vitamin D has one –OH" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Many O H groups, water-soluble. Big non-polar part, fat-soluble.", "write": "C water, D fat" },
        { "say": "Boiling broccoli leaches vitamin C into the water.", "write": "vitamin C lost in cooking" },
        { "say": "Conditions change, bonds break, active site changes shape, substrate can't bind, rate falls.", "write": "full chain of reasoning" },
        { "say": "Every 2-amino acid except glycine has a chiral centre.", "write": "all but glycine chiral" }
      ] }
  ]
}

{
  "level": "Year 12", "subject": "chemistry", "title": "Unit 4 practice exam",
  "frames": [
    { "heading": "How to sit this exam",
      "lines": [
        { "say": "This practice exam covers all of Unit 4. You have 90 minutes.", "write": "90 minutes",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Time split: 25 minutes multiple choice, 65 minutes short answer", "items": [
            {"kind": "rect", "x": 40, "y": 60, "w": 133, "h": 70, "fill": "orange", "label": "MC 25 min"},
            {"kind": "rect", "x": 173, "y": 60, "w": 347, "h": 70, "fill": "blue", "label": "short answer 65 min", "change": "highlight"},
            {"kind": "text", "x": 280, "y": 170, "text": "20 multiple choice + 6 short answer (45 marks)", "size": 18, "anchor": "middle"}]}},
        { "say": "Spend about 25 minutes on multiple choice and 65 on short answer.", "write": "25 min MC, 65 min short answer" },
        { "say": "Work alone, no notes. Just a calculator and the data book.", "write": "calculator + data book" },
        { "say": "Write your answers before reading the solutions. Then mark yourself strictly.", "write": "answer first, then mark" }
      ] },
    { "heading": "Recap: pathways and yield",
      "lines": [
        { "say": "Ethene to ethyl ethanoate. Hydrate to ethanol, oxidise some to ethanoic acid, then join them.", "write": "ethene → X → Y; X + Y → ester",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Pathway from ethene to ethanol, ethanoic acid, and ethyl ethanoate", "items": [
            {"kind": "rect", "x": 20, "y": 30, "w": 120, "h": 50, "fill": "orange", "label": "ethene"},
            {"kind": "arrow", "x": 140, "y": 55, "x2": 200, "y2": 55},
            {"kind": "rect", "x": 200, "y": 30, "w": 140, "h": 50, "fill": "blue", "label": "X ethanol"},
            {"kind": "arrow", "x": 340, "y": 55, "x2": 390, "y2": 55},
            {"kind": "rect", "x": 390, "y": 30, "w": 160, "h": 50, "fill": "green", "label": "Y ethanoic acid"},
            {"kind": "arrow", "x": 270, "y": 80, "x2": 270, "y2": 150},
            {"kind": "arrow", "x": 470, "y": 80, "x2": 340, "y2": 150},
            {"kind": "rect", "x": 190, "y": 150, "w": 200, "h": 50, "fill": "teal", "label": "ethyl ethanoate", "change": "add"}]}},
        { "say": "Atom economy of the last step: 88.0 over 106.0. That is 83.0 percent.", "write": "88.0 ÷ 106.0 = 83.0%" },
        { "say": "6.00 grams of acid gives at most 8.80 grams of ester.", "write": "0.100 mol × 88.0 = 8.80 g" },
        { "say": "6.16 over 8.80 gives a 70.0 percent yield. Esterification is reversible.", "write": "6.16 ÷ 8.80 = 70.0%" }
      ] },
    { "heading": "Recap: identifying a compound",
      "lines": [
        { "say": "A broad I R band from 2500 to 3300, plus a C double bond O at 1710. That's a carboxylic acid.", "write": "broad O–H + C=O → –COOH" },
        { "say": "Mass spectrum molecular ion at 74. A triplet and quartet mean an ethyl group.", "write": "M⁺ 74, triplet + quartet",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Proton NMR peaks: triplet, quartet and singlet", "items": [
            {"kind": "line", "x": 30, "y": 200, "x2": 530, "y2": 200},
            {"kind": "line", "x": 470, "y": 200, "x2": 470, "y2": 120, "color": "blue"},
            {"kind": "line", "x": 480, "y": 200, "x2": 480, "y2": 80, "color": "blue"},
            {"kind": "line", "x": 490, "y": 200, "x2": 490, "y2": 120, "color": "blue"},
            {"kind": "line", "x": 360, "y": 200, "x2": 360, "y2": 160, "color": "teal"},
            {"kind": "line", "x": 370, "y": 200, "x2": 370, "y2": 120, "color": "teal"},
            {"kind": "line", "x": 380, "y": 200, "x2": 380, "y2": 120, "color": "teal"},
            {"kind": "line", "x": 390, "y": 200, "x2": 390, "y2": 160, "color": "teal"},
            {"kind": "line", "x": 80, "y": 200, "x2": 80, "y2": 140, "color": "red", "change": "highlight"},
            {"kind": "text", "x": 480, "y": 228, "text": "1.1 CH₃", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 375, "y": 228, "text": "2.4 CH₂", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 80, "y": 228, "text": "11.5 COOH", "size": 16, "anchor": "middle"}]}},
        { "say": "Put it together. Z is propanoic acid, C H three C H two C O O H.", "write": "Z = CH₃CH₂COOH" },
        { "say": "Methyl ethanoate is an isomer with no O H, so no broad band.", "write": "isomer: CH₃COOCH₃" }
      ] },
    { "heading": "Recap: HPLC calibration",
      "lines": [
        { "say": "Same retention time as the standard identifies the caffeine peak.", "write": "same retention time" },
        { "say": "The calibration line has a gradient of 7.50 per milligram per litre.", "write": "150 ÷ 20.0 = 7.50",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Calibration line with the unknown read off at area 270", "items": [
            {"kind": "line", "x": 60, "y": 240, "x2": 520, "y2": 240},
            {"kind": "line", "x": 60, "y": 240, "x2": 60, "y2": 20},
            {"kind": "line", "x": 60, "y": 240, "x2": 500, "y2": 40, "color": "blue"},
            {"kind": "line", "x": 60, "y": 132, "x2": 298, "y2": 132, "color": "red", "dashed": true, "change": "add"},
            {"kind": "line", "x": 298, "y": 132, "x2": 298, "y2": 240, "color": "red", "dashed": true, "change": "add"},
            {"kind": "text", "x": 70, "y": 120, "text": "area 270", "size": 16, "color": "red"},
            {"kind": "text", "x": 298, "y": 268, "text": "36.0 mg/L", "size": 16, "anchor": "middle", "color": "red"}]}},
        { "say": "Area 270 reads off as 36.0. Times the dilution factor of 10 gives 360.", "write": "36.0 × 10.0 = 360 mg/L" },
        { "say": "A more polar compound leaves the non-polar column sooner. Shorter retention time.", "write": "more polar → shorter time" }
      ] },
    { "heading": "Recap: food energy and proteins",
      "lines": [
        { "say": "Calibration factor is V I t over the temperature rise. 3.30 kilojoules per degree.", "write": "CF = 1782 J ÷ 0.540 = 3.30 kJ/°C" },
        { "say": "The peanut: 3.30 times 5.85 is 19.3 kilojoules, over 0.800 grams.", "write": "19.3 ÷ 0.800 = 24.1 kJ/g" },
        { "say": "Glycine and alanine join by condensation. Water leaves, a peptide bond forms.", "write": "–CO–NH– peptide bond",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Two amino acids join and water is released", "items": [
            {"kind": "rect", "x": 30, "y": 60, "w": 180, "h": 60, "fill": "blue", "label": "glycine"},
            {"kind": "rect", "x": 240, "y": 60, "w": 180, "h": 60, "fill": "green", "label": "alanine"},
            {"kind": "rect", "x": 205, "y": 70, "w": 40, "h": 40, "fill": "yellow", "label": "–", "change": "highlight"},
            {"kind": "circle", "x": 490, "y": 90, "r": 34, "fill": "teal", "label": "H₂O", "change": "remove"},
            {"kind": "text", "x": 225, "y": 160, "text": "peptide bond", "size": 18, "anchor": "middle"}]}},
        { "say": "Alanine is chiral: four different groups. Glycine has two H atoms, so it isn't.", "write": "alanine chiral, glycine not" }
      ] },
    { "heading": "Recap: the practical",
      "lines": [
        { "say": "Fuel cell question. Independent is electrolyte temperature. Dependent is voltage.", "write": "IV: temperature, DV: voltage" },
        { "say": "A voltmeter reading 0.05 volts too high every time is a systematic error.", "write": "systematic → accuracy",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Every reading shifted up by the same amount", "items": [
            {"kind": "line", "x": 40, "y": 140, "x2": 520, "y2": 140, "color": "grey", "dashed": true},
            {"kind": "circle", "x": 120, "y": 100, "r": 10, "fill": "red", "change": "add"},
            {"kind": "circle", "x": 220, "y": 100, "r": 10, "fill": "red", "change": "add"},
            {"kind": "circle", "x": 320, "y": 100, "r": 10, "fill": "red", "change": "add"},
            {"kind": "circle", "x": 420, "y": 100, "r": 10, "fill": "red", "change": "add"},
            {"kind": "text", "x": 280, "y": 180, "text": "true value (dashed); every reading +0.05 V", "size": 16, "anchor": "middle"}]}},
        { "say": "It affects accuracy, not precision. Repeats won't fix it.", "write": "fix the equipment" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Show working, units and significant figures on every calculation.", "write": "working, units, sig figs" },
        { "say": "List every topic where you lost marks.", "write": "list weak topics" },
        { "say": "Then go back to that lesson before your next attempt.", "write": "revise, then retry" }
      ] }
  ]
}

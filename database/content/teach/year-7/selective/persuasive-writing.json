    {
      "heading": "Answer the other side",
      "lines": [
        {
          "say": "A rebuttal states the other side fairly, then answers it.",
          "write": "state it fairly, then answer",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Structure of a persuasive piece",
            "items": [
              {
                "kind": "rect",
                "x": 60,

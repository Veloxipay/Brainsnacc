  "title": "Persuasive writing",
  "frames": [
    {
      "heading": "Convince the reader",
      "lines": [
        {
          "say": "A persuasive task gives you a statement and asks you to convince the reader.",
          "write": "pick a side, convince"
        },
        {
          "say": "Markers want a clear position, strong reasons, good structure, and calm language."
        },
        {
          "say": "Here is a structure you can rely on.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Structure of a persuasive piece",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 20,
                "w": 440,
                "h": 46,
                "fill": "blue",
                "label": "Introduction"
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 76,
                "w": 440,
                "h": 46,
                "fill": "green",
                "label": "Body 1 (PEEL)"
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 132,
                "w": 440,
                "h": 46,
                "fill": "green",
                "label": "Body 2 (PEEL)"
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 188,
                "w": 440,
                "h": 46,
                "fill": "orange",
                "label": "Rebuttal"
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 244,
                "w": 440,
                "h": 46,
                "fill": "purple",
                "label": "Conclusion"
              }
            ]
          }
        },
        {
          "say": "Say it, prove it, answer the other side, say it again.",
          "write": "say · prove · answer · repeat"
        }
      ]
    },

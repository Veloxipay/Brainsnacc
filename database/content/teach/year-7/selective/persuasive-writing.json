    {
      "heading": "PEEL paragraphs",
      "lines": [
        {
          "say": "Each body paragraph is PEEL. Point, evidence, explain, link.",
          "write": "Point · Evidence · Explain · Link",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "PEEL paragraph parts",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 60,
                "w": 120,
                "h": 90,
                "fill": "blue",
                "label": "Point"
              },
              {
                "kind": "rect",
                "x": 155,
                "y": 60,
                "w": 120,
                "h": 90,
                "fill": "green",
                "label": "Evidence"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 60,
                "w": 120,
                "h": 90,
                "fill": "orange",
                "label": "Explain"
              },
              {
                "kind": "rect",
                "x": 425,
                "y": 60,
                "w": 120,
                "h": 90,
                "fill": "purple",
                "label": "Link"
              }
            ]
          }
        },
        {
          "say": "Uniforms save money. They are worn every day. So they should stay.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "PEEL paragraph parts",
            "items": [
              {
                "kind": "rect",
                "x": 20,

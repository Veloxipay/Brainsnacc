        },
        {
          "say": "Some people do not like dogs, but they are wrong. No reason given.",
          "write": "✗ \"they are wrong\""
        },
        {
          "say": "Some worry dogs make a mess. A short lead rule would solve most problems.",
          "write": "✓ concern + solution"
        },
        {
          "say": "That names a real concern, then offers a practical answer."
        }
      ]
    },
    {
      "heading": "Persuasive techniques",
      "lines": [
        {
          "say": "Rhetorical question. Who would not want a safer walk to school?",
          "write": "rhetorical question"
        },
        {
          "say": "Inclusive language. We, us and our put the reader on your side.",
          "write": "we · us · our"
        },
        {
          "say": "Rule of three. Cleaner, quieter and safer.",
          "write": "cleaner, quieter, safer",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Rule of three",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 70,
                "w": 160,
                "h": 80,
                "fill": "blue",
                "label": "cleaner",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 200,
                "y": 70,
                "w": 160,
                "h": 80,
                "fill": "green",
                "label": "quieter",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 70,
                "w": 160,
                "h": 80,
                "fill": "orange",
                "label": "safer",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Use two or three well. Ten at once sounds like an advertisement.",
          "write": "pick three, not ten"
        },
        {
          "say": "Do not invent exact statistics. Ninety seven point three percent sounds made up.",
          "write": "✗ 97.3% agree"
        }
      ]
    },
    {
      "heading": "Tone and conclusion",
      "lines": [
        {
          "say": "Be confident and reasonable. Insults and all capitals lose trust.",
          "write": "✗ insults · ✗ CAPITALS"
        },
        {
          "say": "The conclusion restates your position in new words.",

    {
      "heading": "Practise like the real test",
      "lines": [
        {
          "say": "The best way to get better at test writing is to write.",
          "write": "write, write, write"
        },
        {
          "say": "Use a timer, a prompt you haven't seen, and check honestly.",
          "write": "timed • new prompt • check"
        },
        {
          "say": "Set the timer for 25 minutes, or your year's time limit.",
          "write": "25 minutes",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A 25 minute practice",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 90,
                "w": 90,
                "h": 70,
                "fill": "blue",
                "label": "Plan"
              },
              {
                "kind": "rect",
                "x": 110,
                "y": 90,
                "w": 330,
                "h": 70,
                "fill": "orange",
                "label": "Write"
              },
              {
                "kind": "rect",
                "x": 440,
                "y": 90,
                "w": 100,
                "h": 70,
                "fill": "green",
                "change": "add",
                "label": "Check"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "25 minutes, no notes",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Two practices a week is plenty. All eight in a weekend is not.",
          "write": "2 a week"
        }
      ]
    },
    {
      "heading": "The eight prompts",
      "lines": [
        {
          "say": "There are four creative prompts and four persuasive ones.",
          "write": "4 creative + 4 persuasive"
        },
        {
          "say": "Creative: The Note Under the Door. Or Borrowed.",
          "write": "The Note Under the Door"
        },
        {
          "say": "Or continue: the lift stopped between floors, and the lights flickered twice.",
          "write": "The lift stopped…"
        },
        {
          "say": "Persuasive: every school should have a vegetable garden.",
          "write": "school vegetable garden"
        },
        {
          "say": "Or: school holidays should be shorter and spread across the year.",
          "write": "shorter holidays?"
        },
        {
          "say": "Alternate types. Practise your weaker type more.",
          "write": "creative ↔ persuasive"
        }
      ]
    },

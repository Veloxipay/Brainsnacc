    {
      "heading": "Why did the writer write it?",
      "lines": [
        {
          "say": "Writers inform, explain, persuade, entertain, instruct or describe.",
          "write": "PIE + Explain, Instruct, Describe",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Six purposes",
            "items": [
              {
                "kind": "rect",

                "kind": "rect",
                "x": 380,
                "y": 140,
                "w": 160,
                "h": 80,
                "fill": "teal",
                "label": "Describe"
              }
            ]
          }
        },
        {
          "say": "Ask, what does the writer want me to do, know or feel?"
        },
        {
          "say": "Fold the paper in half, then crease it. That is instructing.",
          "write": "commands → instruct"
        },
        {
          "say": "The paper crackled like autumn leaves. That is describing.",
          "write": "senses → describe"
        }
      ]
    },
    {
      "heading": "Look at the ending",
      "lines": [
        {
          "say": "A passage says teens find it hard to sleep early. School starts at eight thirty."
        },

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A detail dressed up as the main idea. Does it cover the whole text?"
        },
        {
          "say": "The first sentence might just be a hook. The real point can come later."
        },
        {
          "say": "An option that repeats a striking word but misses the point.",
          "write": "✗ mentioned-word trap"
        },
        {
          "say": "Too-big statements about all people or every town.",
          "write": "✗ all · every"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Main idea equals topic plus point.",
          "write": "topic + point"
        },
        {
          "say": "Goldilocks. Not too broad, not too narrow.",
          "write": "just right"
        },
        {
          "say": "Look at the ending for purpose.",
          "write": "should · must · join us"
        },
        {
          "say": "The removal test tells you a paragraph's job.",
          "write": "removal test"
        }
      ]
    }

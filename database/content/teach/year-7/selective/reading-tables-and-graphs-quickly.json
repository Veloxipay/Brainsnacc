        {
          "say": "Each circle stands for six pieces of fruit. Half a circle is three.",
          "write": "● = 6,  ◐ = 3",
          "diagram": "diagrams/y7/selective/reading-tables-and-graphs-quickly-ex3.svg",
          "alt": "Pictogram: apples 4 circles, bananas 2 and a half, pears 3. Each circle is 6."
        },
        {
          "say": "Apples four times six is twenty four. Bananas two and a half times six is fifteen.",
          "write": "24 + 15"
        },
        {
          "say": "Pears three times six is eighteen. Total fifty seven.",
          "write": "24 + 15 + 18 = 57"
        },
        {
          "say": "Nine and a half just counts circles. Always multiply by the key.",
          "write": "✗ 9.5"
        }
      ]
    },

    {
      "heading": "Don't flip all",
      "lines": [
        {
          "say": "All A are B is a one-way arrow, from A to B.",
          "write": "all A are B: A → B",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Circle A inside circle B",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 160,
                "r": 130,
                "fill": "blue",
                "label": ""
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 190,
                "r": 60,
                "fill": "orange",
                "label": "cats"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "animals",
                "size": 20,
                "color": "white",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "All cats are animals. But not all animals are cats.",
          "write": "✗ B → A"
        },
        {
          "say": "Some A are B means at least one. Not any particular one.",
          "write": "some = at least one"
        },
        {
          "say": "Some choir members play piano. That does not tell you whether Ella does."
        }
      ]

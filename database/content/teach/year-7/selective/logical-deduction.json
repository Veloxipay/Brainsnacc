{
  "level": "Year 7",
  "subject": "selective",
  "title": "Logical deduction",
  "frames": [
    {
      "heading": "Must, could, cannot",
      "lines": [
        {
          "say": "Deduction gives you a few facts and asks what must, could, or cannot be true.",
          "write": "must · could · cannot"
        },
        {
          "say": "Must means always. True in every possible situation.",
          "write": "must = always"
        },
        {
          "say": "Could means sometimes. Cannot means never.",
          "write": "could = sometimes, cannot = never"
        },
        {
          "say": "To test must, try to break it. If you find a case where it fails, reject it.",
          "write": "Try to break it"
        },
        {
          "say": "Use only the facts, and all the facts.",
          "write": "Only the facts, all the facts"
        }
      ]
    },

    {
      "heading": "Best value and close fractions",
      "lines": [
        {
          "say": "For best value, work out the unit price. That is the cost of one item.",
          "write": "unit price = price ÷ items"
        },
        {
          "say": "Do it for every option, then pick the smallest unit price.",
          "write": "smallest unit price wins"
        },
        {
          "say": "Fractions close together? Compare how far each one is from one.",
          "write": "12/13 vs 10/11",
          "draw": {

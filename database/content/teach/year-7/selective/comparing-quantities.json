    {
      "heading": "Work out each side first",
      "lines": [
        {
          "say": "Quantity A is twenty five percent of sixty. Quantity B is one third of forty five.",
          "write": "A: 25% of 60   B: 1/3 of 45"
        },
        {
          "say": "Twenty five percent is a quarter. Sixty divided by four is fifteen.",
          "write": "A = 60 ÷ 4 = 15",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Quantity A worked out as 15",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 220,
                "h": 120,
                "fill": "blue",
                "label": "A = 15",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 310,
                "y": 60,
                "w": 220,
                "h": 120,
                "fill": "white",
                "label": "B = ?"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "25% of 60 = 15",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Forty five divided by three is also fifteen.",
          "write": "B = 45 ÷ 3 = 15",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Both quantities worked out as 15",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 220,
                "h": 120,
                "fill": "blue",
                "label": "A = 15"
              },
              {
                "kind": "rect",
                "x": 310,
                "y": 60,
                "w": 220,
                "h": 120,
                "fill": "orange",
                "label": "B = 15",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "15 = 15",
                "size": 26,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "So the two quantities are equal. Only now read the options.",
          "write": "Equal"
        },
        {
          "say": "Sixty is bigger than forty five, but that does not make A bigger."
        }
      ]
    },
    {
      "heading": "Different units",
      "lines": [
        {
          "say": "Quantity A is one point five kilometres. Quantity B is fourteen hundred and fifty metres.",
          "write": "1.5 km   or   1,450 m"
        },
        {
          "say": "Change both into the same unit. Multiply kilometres by one thousand.",
          "write": "1.5 × 1,000 = 1,500 m",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Two bars comparing 1,500 m and 1,450 m",

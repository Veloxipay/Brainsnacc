    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Big number trap. Seventy two percent is not bigger than three quarters.",
          "write": "✗ biggest digits win"
        },
        {
          "say": "Mixed units. Convert before you compare.",
          "write": "same units first"
        },
        {
          "say": "Do not pick not enough information if both sides can be worked out."
        },
        {
          "say": "Up twenty five percent, then down twenty five percent, does not get back to the start.",
          "write": "+25% then −25% ≠ start",
          "draw": {
            "type": "shapes",

                "kind": "rect",
                "x": 50,
                "y": 130,
                "w": 435,
                "h": 44,
                "fill": "orange",
                "label": "1,450 m"
              }
            ]
          }
        },
        {
          "say": "Fifteen hundred metres beats fourteen hundred and fifty. So A is larger.",
          "write": "A is larger"
        },
        {
          "say": "Also watch time. Nought point three hours is eighteen minutes, not thirty.",
          "write": "0.3 h = 18 min"
        }
      ]
    },
    {
      "heading": "Is something unknown?",
      "lines": [
        {
          "say": "n is a whole number from one to five. Compare n squared with three n.",
          "write": "A: n²   B: 3n"
        },
        {
          "say": "Try a small value. When n is one, A is one and B is three.",
          "write": "n = 1: A = 1, B = 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,

    {
      "heading": "Pace yourself",
      "lines": [
        {
          "say": "Thirty questions in thirty minutes. About one minute each, including reading.",
          "write": "a minute a question"
        },
        {
          "say": "A passage with six questions gets about six minutes.",
          "write": "6 questions ≈ 6 min"
        },
        {
          "say": "Skim the question stems first, then read the passage once carefully.",
          "write": "stems first"
        },
        {
          "say": "Over ninety seconds on one question? Guess, flag it, move on.",
          "write": "guess · flag · move"
        },
        {
          "say": "No blanks. Every question gets a letter before time is up.",
          "write": "No blanks"
        }
      ]
    },

    {
      "heading": "Point to the evidence",
      "lines": [
        {
          "say": "Before you mark an answer, put your finger on the words that support it.",
          "write": "point to it"
        },
        {
          "say": "If you cannot point to anything, you are guessing."
        },
        {
          "say": "Your own knowledge does not count. Only the passage is evidence.",
          "write": "passage only"
        },
        {
          "say": "Be a detective, not a fortune teller.",
          "write": "detective, not fortune-teller"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Read, predict, eliminate, prove.",
          "write": "R · P · E · P"
        },
        {
          "say": "A minute a question.",
          "write": "1 min / question"
        },
        {
          "say": "Too big, too small, just right.",
          "write": "Goldilocks"
        },
        {
          "say": "No blanks.",
          "write": "No blanks"
        }
      ]

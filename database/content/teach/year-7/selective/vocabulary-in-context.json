    {
      "heading": "Cover, predict, swap",
      "lines": [
        {
          "say": "Step one. Cover the word, so it's a blank.",
          "write": "1. Cover",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Word covered",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "The path was ____ — slippery and crumbling.",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 150,
                "y": 100,
                "w": 260,
                "h": 60,
                "fill": "yellow",
                "change": "remove",
                "label": "treacherous"
              }
            ]
          }
        },
        {
          "say": "Step two. Predict a simple word that fits.",
          "write": "2. Predict: dangerous",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Prediction",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "The path was ____ — slippery and crumbling.",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 150,
                "y": 100,
                "w": 260,
                "h": 60,
                "fill": "white",
                "label": "?"
              },

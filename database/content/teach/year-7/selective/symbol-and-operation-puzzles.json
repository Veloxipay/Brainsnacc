{
  "level": "Year 7",
  "subject": "selective",
  "title": "Symbol and operation puzzles",
  "frames": [
    {
      "heading": "Shapes stand for numbers",
      "lines": [
        {
          "say": "In these puzzles, shapes stand for numbers.",
          "write": "● + ● = 12"
        },
        {
          "say": "Two circles make 12, so one circle is 6.",
          "write": "● = 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Two circles make 12",
            "items": [
              {
                "kind": "circle",
                "x": 120,
                "y": 110,
                "r": 45,
                "fill": "blue",
                "label": "●"
              },
              {
                "kind": "text",
                "x": 200,
                "y": 120,
                "text": "+",
                "size": 28,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 110,
                "r": 45,
                "fill": "blue",
                "label": "●"
              },
              {
                "kind": "text",
                "x": 380,
                "y": 120,
                "text": "= 12",
                "size": 28,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 120,
                "y": 230,
                "r": 35,
                "fill": "green",
                "change": "add",
                "label": "6"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 230,
                "r": 35,
                "fill": "green",
                "change": "add",
                "label": "6"
              }
            ]
          }
        },
        {
          "say": "The same shape always means the same number in one question."
        },
        {
          "say": "This is careful step-by-step thinking, just like algebra later.",
          "write": "shapes → letters"
        }
      ]
    },
    {
      "heading": "One shape first",
      "lines": [
        {
          "say": "Start with the clue that has only one kind of shape.",
          "write": "● + ● + ● = 18"
        },
        {
          "say": "Three circles make 18. So one circle is 6.",
          "write": "● = 18 ÷ 3 = 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Three circles share 18",
            "items": [
              {
                "kind": "circle",
                "x": 100,
                "y": 100,
                "r": 40,
                "fill": "blue",
                "label": "●"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 100,
                "r": 40,
                "fill": "blue",
                "label": "●"
              },
              {
                "kind": "circle",
                "x": 340,
                "y": 100,
                "r": 40,
                "fill": "blue",
                "label": "●"
              },
              {
                "kind": "text",
                "x": 460,
                "y": 110,
                "text": "= 18",
                "size": 28,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 100,
                "y": 220,
                "r": 32,
                "fill": "green",
                "change": "add",
                "label": "6"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 220,
                "r": 32,
                "fill": "green",
                "change": "add",
                "label": "6"
              },
              {
                "kind": "circle",
                "x": 340,
                "y": 220,
                "r": 32,
                "fill": "green",
                "change": "add",
                "label": "6"
              }
            ]
          }
        },
        {
          "say": "Now substitute 6 into the next clue.",
          "write": "● + ★ = 10  →  6 + ★ = 10"
        },
        {
          "say": "So the star is 10 take away 6, which is 4.",
          "write": "★ = 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Circle swapped for 6",
            "items": [
              {
                "kind": "circle",
                "x": 120,
                "y": 130,
                "r": 45,
                "fill": "blue",
                "change": "remove",
                "label": "●"
              },
              {
                "kind": "circle",
                "x": 120,
                "y": 130,
                "r": 45,
                "fill": "green",
                "change": "add",
                "label": "6"
              },
              {
                "kind": "text",
                "x": 200,
                "y": 140,
                "text": "+",
                "size": 28,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 130,
                "r": 45,
                "fill": "orange",
                "label": "★"
              },
              {
                "kind": "text",
                "x": 390,
                "y": 140,
                "text": "= 10",
                "size": 28,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "★ = 4",
                "size": 28,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Reread the question. It asked for the star, not the circle.",
          "write": "✗ 6   ✓ 4"
        }
      ]
    },
    {
      "heading": "Made-up operations",
      "lines": [
        {
          "say": "A new sign gets its own rule. a diamond b means 2a plus b.",
          "write": "a ◆ b = 2a + b"
        },
        {
          "say": "First number fills a. Second number fills b.",
          "write": "first → a, second → b",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "3 diamond 4: 3 goes into a, 4 into b",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 70,
                "text": "3 ◆ 4",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 400,
                "y": 70,
                "text": "2a + b",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 110,
                "y": 90,
                "x2": 370,
                "y2": 150,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 170,
                "y": 90,
                "x2": 440,
                "y2": 150,
                "color": "orange",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 200,
                "text": "2 × 3 + 4 = 10",
                "size": 28,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "So 3 diamond 4 is 2 times 3 plus 4, which is 10.",
          "write": "3 ◆ 4 = 10"
        },
        {
          "say": "Swap them and you get a different answer: 4 diamond 3 is 11.",
          "write": "4 ◆ 3 = 11"
        },
        {
          "say": "Try a times b minus a, with 4 and 5.",
          "write": "4 ◇ 5 = 4 × 5 − 4 = 16"
        },
        {
          "say": "Fifteen is the trap. It takes away b instead of a.",
          "write": "✗ 15"
        },
        {
          "say": "With brackets, do the bracket first, then use its answer.",
          "write": "(2 ◆ 3) ◆ 1"
        }
      ]
    },
    {
      "heading": "Missing signs",
      "lines": [
        {
          "say": "Each question mark is plus, minus, times or divide.",
          "write": "8 ? 2 ? 3 = 19"
        },
        {
          "say": "8 plus 2 plus 3 is only 13. We need a times.",
          "write": "8 + 2 + 3 = 13 → too small"
        },
        {
          "say": "Try times then plus. 16 plus 3 is 19. Yes!",
          "write": "8 × 2 + 3 = 19 ✓"
        },
        {
          "say": "Try plus then times. Times goes first, so 8 plus 6 is 14.",
          "write": "8 + 2 × 3 = 14 ✗",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Multiply first in 8 + 2 × 3",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "8 + 2 × 3",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 40,
                "w": 120,
                "h": 60,
                "fill": "none",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "8 + 6",
                "size": 32,
                "color": "black",
                "anchor": "middle",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "= 14, not 30",
                "size": 30,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Times and divide before plus and minus. That's BODMAS.",
          "write": "× ÷ before + −"
        }
      ]
    },
    {
      "heading": "Sum and difference shortcut",
      "lines": [
        {
          "say": "Star plus triangle is 17. Star minus triangle is 5.",
          "write": "★ + ▲ = 17,  ★ − ▲ = 5"
        },
        {
          "say": "Add them and halve for the big one.",
          "write": "★ = (17 + 5) ÷ 2 = 11",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Bars: big plus small is 17, big minus small is 5",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 330,
                "h": 50,
                "fill": "orange",
                "change": "add",
                "label": "★ = 11"
              },
              {
                "kind": "rect",
                "x": 370,
                "y": 60,
                "w": 180,
                "h": 50,
                "fill": "teal",
                "label": "▲ = 6"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 160,
                "w": 330,
                "h": 50,
                "fill": "orange",
                "label": "★"
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 160,
                "w": 180,
                "h": 50,
                "fill": "teal",
                "change": "remove",
                "label": "▲"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 260,
                "text": "★ − ▲ = 5",
                "size": 22,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Then the triangle is 17 take away 11, which is 6.",
          "write": "▲ = 6"
        },
        {
          "say": "Check both clues. 11 plus 6 is 17, 11 minus 6 is 5.",
          "write": "✓  ✓"
        },
        {
          "say": "17 minus 5 is 12. That's not either number. A trap.",
          "write": "✗ 12"
        }
      ]
    },
    {
      "heading": "Balance puzzles",
      "lines": [
        {
          "say": "Two apples weigh the same as three pears.",
          "write": "2 apples = 3 pears",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 0,
              "cubes": 2
            },
            "right": {
              "cubes": 3
            },
            "labels": [
              "2 apples",
              "3 pears"
            ]
          }
        },
        {
          "say": "Treat it like an exchange rate. Swap things for equal amounts.",
          "write": "swap like money"
        },
        {
          "say": "Change everything into the smallest item, one step at a time.",
          "write": "→ all pears"
        },
        {
          "say": "So four apples is worth six pears.",
          "write": "4 apples = 6 pears",
          "draw": {
            "type": "balance",
            "left": {
              "cubes": 2
            },
            "right": {
              "cubes": 3
            },
            "add": 2,
            "addTo": "left",
            "tip": "left",
            "labels": [
              "2 + 2 apples",
              "3 pears"
            ]
          }
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Answering with the wrong symbol. Underline what the question wants.",
          "write": "▲ or ▲ − ■ ?"
        },
        {
          "say": "Swapping a and b. a diamond b and b diamond a usually differ.",
          "write": "a ◆ b ≠ b ◆ a"
        },
        {
          "say": "Square times square is the number times itself, not double.",
          "write": "■ × ■ = 6 × 6 = 36",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Square times square versus two times square",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 60,
                "w": 180,
                "h": 90,
                "fill": "green",
                "change": "highlight",
                "label": "6 × 6 = 36"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 60,
                "w": 180,
                "h": 90,
                "fill": "red",
                "change": "remove",
                "label": "2 × 6 = 12"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "■ × ■ means times itself",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "And 6 plus 2 times 3 is 12, not 24.",
          "write": "6 + 2 × 3 = 12"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "One shape first, then substitute.",
          "write": "One shape first"
        },
        {
          "say": "First fills a, second fills b.",
          "write": "first → a, second → b"
        },
        {
          "say": "Times and divide before plus and minus.",
          "write": "BODMAS"
        },
        {
          "say": "Add and halve for the big one. Subtract and halve for the small one.",
          "write": "(S + D) ÷ 2,  (S − D) ÷ 2"
        },
        {
          "say": "Reread the question at the end.",
          "write": "Check ✓"
        }
      ]
    }
  ]
}
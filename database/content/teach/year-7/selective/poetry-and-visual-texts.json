    {
      "heading": "A lot of meaning, few words",
      "lines": [
        {
          "say": "Reading tests often include a poem, and a visual text like a poster.",
          "write": "poems · posters · cartoons"
        },
        {
          "say": "These pack a lot of meaning into very few words."
        },
        {
          "say": "The person talking in a poem is the speaker. It may not be the poet.",
          "write": "speaker ≠ poet"
        },
        {
          "say": "Read it twice. First for sense, then for tools.",
          "write": "read twice"
        },
        {
          "say": "Read in sentences, not lines. Follow the punctuation.",
          "write": "follow the punctuation"
        }
      ]
    },

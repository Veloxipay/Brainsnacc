      "heading": "Salience and irony",
      "lines": [
        {
          "say": "Salience means making the key thing stand out. Size, colour, position, contrast.",
          "write": "size · colour · position"
        },
        {
          "say": "Your eye goes there first, and so does the message."
        },
        {
          "say": "In cartoons, the picture may contradict the words. That is irony.",
          "write": "picture ≠ words → irony"
        },
        {
          "say": "In an infographic, read the title and labels. Do the sums on paper.",
          "write": "check the numbers"

    {
      "heading": "Mood and theme",
      "lines": [
        {
          "say": "Mood is the feeling the poem creates. Theme is its big idea about life.",
          "write": "mood · theme"
        },
        {
          "say": "Moving Day. Boxes stacked. My room an echo now.",
          "write": "an echo now"
        },
        {
          "say": "I write my name inside the cupboard, so the house remembers me."
        },
        {
          "say": "Last lines last longest. The speaker is sad to leave and wants to be remembered.",
          "write": "B  sad, wants to be remembered"
        },
        {
          "say": "Excited is tempting. But no clue in the poem points to excitement.",
          "write": "✗ excited"
        }
      ]
    },

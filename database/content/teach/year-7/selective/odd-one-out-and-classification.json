    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Do not decide after reading two words. See the whole list."
        },
        {
          "say": "Weak rules like length or first letter are usually traps.",
          "write": "✗ length · first letter"
        },
        {
          "say": "Look-alikes are traps. Lever looks like level, but looks are not the rule.",
          "write": "✗ look-alikes"
        },
        {
          "say": "If your rule needs sort of, it is too loose.",
          "write": "✗ \"sort of\""
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Three together, one alone.",
          "write": "Three together, one alone"
        },
        {
          "say": "Meaning, then type, then letters. My Turn Last.",
          "write": "M → T → L"
        },
        {
          "say": "Say the rule out loud.",
          "write": "say the rule"
        },
        {
          "say": "Cover your answer. Do the rest still clearly belong?",
          "write": "self-check"
        }
      ]

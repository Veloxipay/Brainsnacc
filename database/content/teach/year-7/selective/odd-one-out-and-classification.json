{
  "level": "Year 7",
  "subject": "selective",
  "title": "Odd one out and classification",
  "frames": [
    {
      "heading": "Find the exact rule",
      "lines": [
        {
          "say": "Odd one out gives a list and asks which word does not belong.",
          "write": "which does not belong?"
        },
        {
          "say": "Classification gives a group and asks which word belongs with it.",
          "write": "which belongs?"
        },
        {
          "say": "Both need the exact rule that ties the group together.",
          "write": "name the rule exactly"
        },
        {
          "say": "Groups can be categories, uses, meanings, word types or spellings.",
          "write": "meaning · type · letters"
        }
      ]
    },

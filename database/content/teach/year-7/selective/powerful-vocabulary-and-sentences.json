    {
      "heading": "Combine and vary",
      "lines": [
        {
          "say": "The bell rang. Students rushed out. They were noisy. They left their bags."
        },
        {
          "say": "When the bell rang, students rushed noisily out, leaving their bags behind.",
          "write": "When..., ...noisily..., leaving..."
        },
        {
          "say": "Joining everything with and makes a long, flat run-on.",
          "write": "✗ and... and... and"
        },
        {
          "say": "Vary your openers with ISTAS. ING word, subordinate clause, time, adverb, short.",
          "write": "I · S · T · A · S",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Five ways to open a sentence",
            "items": [
              {

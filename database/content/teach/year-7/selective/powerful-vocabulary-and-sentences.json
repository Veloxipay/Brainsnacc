    {
      "heading": "Figurative language",
      "lines": [
        {
          "say": "A simile compares with like or as. Fog clung like wet wool.",
          "write": "simile: like / as"
        },
        {
          "say": "A metaphor says one thing is another. The classroom was a beehive.",
          "write": "metaphor: is"
        },
        {
          "say": "Personification. The wind whispered through the gum trees.",
          "write": "personification"
        },
        {
          "say": "One fresh comparison per paragraph. Similes are seasoning, not the meal.",
          "write": "seasoning, not the meal"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Verbs do the heavy lifting.",
          "write": "strong verbs"
        },
        {
          "say": "Very is a warning light.",
          "write": "✗ very"
        },
        {
          "say": "Mix simple, compound and complex sentences.",
          "write": "mix types"
        },
        {
          "say": "If three sentences in a row start the same, change one.",
          "write": "vary openers"
        }
      ]
    }
  ]

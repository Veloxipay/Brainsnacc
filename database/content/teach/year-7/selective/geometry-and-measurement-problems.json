{
  "level": "Year 7",
  "subject": "selective",
  "title": "Geometry and measurement problems",
  "frames": [
    {
      "heading": "Facts, one after another",
      "lines": [
        {
          "say": "These questions give you a diagram and ask for a missing value."
        },
        {
          "say": "Diagrams may not be to scale. Trust the numbers, not the look.",
          "write": "trust the numbers"
        },
        {
          "say": "Line one eighty, point three sixty, triangle one eighty.",
          "write": "line 180 · point 360 · triangle 180"
        },
        {
          "say": "Where two lines cross, vertically opposite angles are equal.",
          "write": "vert. opp. angles equal"
        },
        {
          "say": "Mark every angle you find right on the diagram, and name the fact."
        }
      ]
    },
    {
      "heading": "Angles on a straight line",
      "lines": [
        {
          "say": "Fifty seven degrees, x and forty eight degrees sit on a straight line.",
          "write": "57° + x + 48° = 180°",
          "diagram": "diagrams/y7/selective/geometry-and-measurement-problems-line.svg",
          "alt": "Three angles on a straight line: 57 degrees, x and 48 degrees"
        },
        {
          "say": "The known angles add to one hundred and five.",
          "write": "57° + 48° = 105°"
        },
        {
          "say": "So x is one eighty minus one oh five. Seventy five degrees.",
          "write": "x = 75°"
        },
        {
          "say": "Not two hundred and fifty five. That uses the point fact, not the line fact.",
          "write": "✗ 360° − 105°"
        }
      ]
    },
    {
      "heading": "Triangles and parallel lines",
      "lines": [
        {
          "say": "An isosceles triangle has two equal sides and two equal base angles.",
          "write": "65° + 65° + 50° = 180°",
          "diagram": "diagrams/y7/selective/geometry-and-measurement-problems-iso.svg",
          "alt": "Isosceles triangle with base angles 65 degrees and top angle 50 degrees"
        },
        {
          "say": "Parallel lines. F angles are equal. Z angles are equal.",
          "write": "F equal · Z equal"
        },
        {
          "say": "C angles, co-interior, add to one eighty.",
          "write": "C: add to 180°"
        },
        {
          "say": "Polygon angles add to n take two, times one eighty. A pentagon is five forty.",
          "write": "(n − 2) × 180°"
        }
      ]
    },

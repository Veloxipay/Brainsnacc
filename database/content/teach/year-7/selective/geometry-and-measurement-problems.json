        }
      ]
    },
    {
      "heading": "Volume and litres",
      "lines": [
        {
          "say": "A tank is fifty by forty by thirty centimetres. Water fills it to eighteen.",
          "write": "50 × 40 × 18",
          "diagram": "diagrams/y7/selective/geometry-and-measurement-problems-tank.svg",
          "alt": "A rectangular prism 50 cm long, 40 cm wide and 30 cm high"
        },
        {
          "say": "Use the water depth, not the tank height.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Tank with water to 18 cm of 30 cm",
            "items": [
              {
                "kind": "rect",
                "x": 80,
                "y": 40,
                "w": 400,
                "h": 240,
                "fill": "white"
              },
              {
                "kind": "rect",
                "x": 80,
                "y": 136,
                "w": 400,
                "h": 144,
                "fill": "teal",
                "label": "water 18 cm",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 500,
                "y": 160,
                "text": "30 cm",
                "size": 18,
                "color": "black",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 30,
                "text": "50 cm × 40 cm",
                "size": 18,
                "color": "black",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Fifty times forty times eighteen is thirty six thousand cubic centimetres.",
          "write": "36 000 cm³"
        },
        {
          "say": "One thousand cubic centimetres is one litre. So thirty six litres.",
          "write": "÷ 1000 = 36 L"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Perimeter is a length in centimetres. Area is squared.",
          "write": "cm  vs  cm²"
        },
        {
          "say": "Do not forget the half for triangles.",
          "write": "½ × base × height"
        },
        {
          "say": "Make all lengths the same unit before you multiply."
        },
        {
          "say": "One square metre is ten thousand square centimetres, not one hundred.",
          "write": "1 m² = 10 000 cm²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "A square metre is 100 cm by 100 cm",
            "items": [
              {
                "kind": "rect",

      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Line one eighty, point three sixty, triangle one eighty.",
          "write": "180 · 360 · 180"
        },
        {
          "say": "F and Z are equal. C adds to one eighty.",
          "write": "F = Z,  C = 180°"
        },
        {
          "say": "Polygon rule. Take away two, times one eighty.",
          "write": "(n − 2) × 180°"
        },
        {
          "say": "A staircase shape has the same perimeter as the rectangle around it.",
          "write": "staircase shortcut"
        }
      ]
    }

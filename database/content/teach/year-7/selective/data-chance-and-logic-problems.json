    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Put the data in order before you find the median.",
          "write": "order first"
        },
        {
          "say": "Do not just add overlapping groups. You count the middle twice."
        },
        {
          "say": "Totals on two dice are not equally likely. Count each pair.",
          "write": "3 then 5 ≠ 5 then 3"
        },
        {
          "say": "A day with zero millimetres of rain still counts in the mean.",
          "write": "0 still counts"
        },
        {
          "say": "Re-read the last line. Answer for the right person or group."
        }
      ]
    },

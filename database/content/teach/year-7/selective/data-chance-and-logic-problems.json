      "heading": "Read, organise, calculate",
      "lines": [
        {
          "say": "These questions reward careful reading more than heavy calculation.",
          "write": "read → organise → calculate"
        },
        {
          "say": "Most mistakes come from the wrong bar, counting twice, or the wrong question."
        },
        {
          "say": "Mean is the total divided by how many values.",
          "write": "mean = total ÷ count"
        },
        {
          "say": "Median is the middle value, once the data is in order.",
          "write": "3, 4, 6, 8, 10 → median 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Ordered data with the middle value highlighted",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,

              }
            ]
          }
        },
        {
          "say": "Mode is the most common value. Range is largest minus smallest.",
          "write": "range = largest − smallest"
        }
      ]
    },
    {
      "heading": "Reading a column graph",
      "lines": [
        {
          "say": "Four students read books this term. Read each bar from the scale.",
          "write": "Amy 6, Raj 4, Tess 9, Leo 5",
          "diagram": "diagrams/y7/selective/data-chance-and-logic-problems-books.svg",
          "alt": "Column graph: Amy 6, Raj 4, Tess 9, Leo 5"
        },
        {
          "say": "Add them up. Six plus four plus nine plus five is twenty four.",
          "write": "6 + 4 + 9 + 5 = 24"
        },
        {
          "say": "Share twenty four between four students. The mean is six books.",
          "write": "24 ÷ 4 = 6"
        },
        {
          "say": "The range is the tallest minus the shortest. Nine minus four is five.",
          "write": "range = 9 − 4 = 5"
        },
        {
          "say": "Not nine. Nine is just the tallest bar."
        }

                "h": 75,
                "fill": "white",
                "label": "11"
              }
            ]
          }
        },
        {
          "say": "Row one: 3 plus 5 is 8. First plus second makes third.",
          "write": "3 + 5 = 8"
        },
        {
          "say": "Test it on row two. 2 plus 6 is 8. It works.",
          "write": "2 + 6 = 8 ✓"
        },
        {
          "say": "Row three: 4 plus what is 11? Subtract to undo. It's 7.",
          "write": "? = 11 − 4 = 7",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Missing number found",
            "items": [
              {
                "kind": "rect",
                "x": 140,
                "y": 30,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "3"
              },
              {
                "kind": "rect",
                "x": 235,
                "y": 30,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "5"
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 30,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "8"
              },
              {
                "kind": "rect",
                "x": 140,
                "y": 110,
                "w": 90,

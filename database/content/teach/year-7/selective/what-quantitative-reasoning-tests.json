              },
              {
                "kind": "rect",
                "x": 330,
                "y": 110,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "8"
              },
              {
                "kind": "rect",
                "x": 140,
                "y": 190,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "4"
              },
              {
                "kind": "rect",

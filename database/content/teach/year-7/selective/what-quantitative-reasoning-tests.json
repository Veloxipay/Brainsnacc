                "fill": "white",
                "label": "6"
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 110,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "8"
              },
              {
                "kind": "rect",
                "x": 140,
                "y": 190,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "4"
              },
              {
                "kind": "rect",
                "x": 235,
                "y": 190,
                "w": 90,
                "h": 75,
                "fill": "yellow",
                "change": "highlight",
                "label": "7"
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 190,
                "w": 90,
                "h": 75,
                "fill": "white",
                "label": "11"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 290,
                "text": "first + second = third",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Adding 4 and 11 to get 15 is the trap.",
          "write": "✗ 15"
        }
      ]
    },
    {
      "heading": "Plan your time",
      "lines": [
        {
          "say": "Say 35 questions in 30 minutes. That's 1800 seconds.",
          "write": "1800 ÷ 35 ≈ 51 s"
        },
        {
          "say": "So about 51 seconds each.",
          "write": "≈ 51 seconds a question",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Time bar: first pass then second pass",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 80,
                "w": 380,
                "h": 70,
                "fill": "green",
                "label": "First pass: quick ones"
              },
              {
                "kind": "rect",
                "x": 400,
                "y": 80,
                "w": 140,
                "h": 70,
                "fill": "orange",
                "change": "add",
                "label": "Second pass"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "30 minutes",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "First pass: answer everything you can in under a minute.",
          "write": "first pass"
        },
        {
          "say": "Past 90 seconds with no rule? Guess, mark it, move on.",
          "write": "90 s → guess, mark, move"
        },
        {
          "say": "One hard question is never worth two easy ones."
        }
      ]
    },
    {
      "heading": "Never leave a blank",
      "lines": [
        {
          "say": "In our practice tests a wrong answer costs nothing.",
          "write": "blank = zero"
        },
        {
          "say": "Cross out options that can't be right. Each one helps your guess.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Crossing out impossible options",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 90,
                "w": 110,
                "h": 70,
                "fill": "white",
                "change": "remove",
                "label": "A"
              },
              {
                "kind": "rect",
                "x": 160,
                "y": 90,
                "w": 110,
                "h": 70,
                "fill": "white",
                "label": "B"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 90,
                "w": 110,
                "h": 70,
                "fill": "white",
                "change": "remove",
                "label": "C"
              },
              {
                "kind": "rect",
                "x": 420,
                "y": 90,
                "w": 110,
                "h": 70,
                "fill": "white",
                "label": "D"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "Guess from B or D: 1 in 2",
                "size": 22,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Always read the instructions on the day."
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't check only the first pair. 2, 4, 8, 14, 22 isn't doubling.",
          "write": "+2, +4, +6, +8"
        },
        {
          "say": "Don't look at the options first. They match common mistakes."
        },
        {
          "say": "Don't rush the arithmetic. 63 divided by 3 is 21, not 18.",
          "write": "63 ÷ 3 = 21"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Spot, test, choose.",
          "write": "Spot, test, choose"
        },
        {
          "say": "Test your rule on every part, like a detective checking alibis.",
          "write": "test everything"
        },
        {
          "say": "About 50 seconds a question. Move on after 90.",
          "write": "50 s • 90 s rule"
        },
        {
          "say": "Blank equals zero. Always guess.",
          "write": "never blank"
        }
      ]
    }
  ]
}
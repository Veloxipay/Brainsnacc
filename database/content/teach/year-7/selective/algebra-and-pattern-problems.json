    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Put negatives in brackets. Negative 2 times negative 2 is plus 4.",
          "write": "(−2) × (−2) = 4"
        },
        {
          "say": "Multiply every part of a bracket. 5 bracket x minus 2 is 5x minus 10.",
          "write": "5(x − 2) = 5x − 10"
        },
        {
          "say": "In age problems, everyone gets older by the same amount.",
          "write": "+5 years for everyone"
        },
        {
          "say": "Answer the question asked. Sam's age, not his sister's.",
          "write": "answer the right unknown"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Difference first, then fix the start.",
          "write": "dn + fix"
        },
        {
          "say": "Fence posts. 10 posts have 9 gaps.",
          "write": "n − 1 jumps"
        },
        {
          "say": "Last on, first off when working backwards.",
          "write": "undo in reverse"
        },
        {
          "say": "Check in words, not just the equation.",
          "write": "check ✓"
        }
      ]
    }

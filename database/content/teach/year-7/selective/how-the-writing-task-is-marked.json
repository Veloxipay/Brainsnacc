        {
          "say": "Finished beats fancy. Three hundred good words beat six hundred unfinished.",
          "write": "Finished beats fancy"
        },
        {
          "say": "Plan the ending first, so you can actually reach it."
        }
      ]
    },
    {
      "heading": "Show your range",
      "lines": [
        {
          "say": "Markers can only reward what is on the page."
        },
        {
          "say": "Use at least one short punchy sentence.",
          "write": "short. punchy."
        },
        {
          "say": "And a longer sentence that starts with a different word.",
          "write": "vary your openers"
        },
        {
          "say": "A short word used precisely beats a long word used wrongly.",
          "write": "precise > big"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Cover all four areas. Ideas, structure, language, errors.",
          "write": "ISLE"
        },
        {
          "say": "Five, seventeen, three. Plan, write, check.",
          "write": "5 – 17 – 3"
        },
        {
          "say": "Could someone guess the prompt from your plan alone?",
          "write": "prompt test"
        },
        {
          "say": "Never skip the check.",
          "write": "check ✓"
        }
      ]
    }

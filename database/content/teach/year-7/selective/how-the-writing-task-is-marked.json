    {
      "heading": "Answer the prompt",
      "lines": [
        {
          "say": "Prompt: everyone should learn to cook before finishing primary school.",
          "write": "learn to cook"
        },
        {
          "say": "One essay argues canteens should sell healthier food. It is error-free.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "The essay topic misses the prompt",
            "items": [
              {
                "kind": "circle",
                "x": 170,
                "y": 150,
                "r": 110,
                "fill": "blue",
                "label": "learn to cook"
              },
              {
                "kind": "circle",
                "x": 420,
                "y": 150,
                "r": 110,
                "fill": "orange",
                "label": "canteen food",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 285,
                "text": "related, but not the prompt",
                "size": 20,
                "color": "red",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "But it never argues about learning to cook. It misses the prompt.",
          "write": "✗ relevance"
        },
        {
          "say": "Correct writing on the wrong topic cannot score well."
        },
        {
          "say": "Put the prompt in your first line and your last line.",
          "write": "prompt first & last"
        }
      ]
    },
    {
      "heading": "Budget your minutes",

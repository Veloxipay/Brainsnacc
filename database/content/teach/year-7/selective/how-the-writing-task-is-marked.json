        {
          "say": "Language. Precise words, varied sentences, the right tone.",
          "write": "Language"
        },
        {
          "say": "Accuracy. Spelling, punctuation and grammar that do not distract.",
          "write": "Accuracy"
        },
        {
          "say": "ISLE helps you remember. Ideas, structure, language, errors.",
          "write": "I · S · L · E"
        }
      ]
    },
    {
      "heading": "Which area loses marks?",
      "lines": [
        {
          "say": "A lively story, good words, but one block of four hundred words. No paragraphs.",
          "write": "400 words, no paragraphs"
        },
        {
          "say": "Ideas are fine. Language is fine. Nothing says the spelling is weak.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "The four marking areas",
            "items": [
              {
                "kind": "rect",

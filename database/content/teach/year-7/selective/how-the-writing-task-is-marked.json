                "w": 250,
                "h": 100,
                "fill": "purple",
                "label": "Accuracy",
                "change": "remove"
              }
            ]
          }
        },
        {
          "say": "No paragraphs means the reader cannot see where things change. That is structure.",
          "write": "Structure",
          "draw": {
            "type": "shapes",

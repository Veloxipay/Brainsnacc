{
  "level": "Year 7",
  "subject": "selective",
  "title": "How the writing task is marked",
  "frames": [
    {
      "heading": "A real person reads it",
      "lines": [
        {
          "say": "The writing task has no options. A prompt, a time limit, a blank page.",
          "write": "prompt → blank page"
        },
        {
          "say": "A real person reads it. So know what they are looking for."
        },
        {
          "say": "Usually a creative piece and a persuasive piece. Roughly twenty to thirty minutes each.",
          "write": "creative + persuasive"
        },
        {
          "say": "A prompt might be a title, a situation to continue, a statement, or a picture.",
          "write": "title · situation · argue · picture"
        },
        {
          "say": "Formats can change each year. Read the official information for your year."
        }
      ]
    },
    {
      "heading": "The four areas",
      "lines": [
        {

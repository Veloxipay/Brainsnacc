    {
      "heading": "Average speed and together",
      "lines": [
        {
          "say": "Average speed is total distance over total time. Never average the two speeds.",
          "write": "total ÷ total"
        },
        {
          "say": "Moving towards each other? Add the speeds. Time to meet is gap over that sum.",
          "write": "gap ÷ (sum of speeds)"
        },
        {
          "say": "Working together, add the fraction of the job each does in one hour.",
          "write": "1/6 + ... per hour"
        },
        {
          "say": "Together is faster. The time must be less than the faster one alone.",
          "write": "together is faster"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Ratio parts add. Rates divide.",
          "write": "parts add, rates divide"
        },
        {
          "say": "D S T. Cover what you want.",
          "write": "DST triangle"
        },
        {
          "say": "Minutes to hours, divide by sixty. Forty five minutes is nought point seven five.",
          "write": "45 min = 0.75 h"
        },
        {
          "say": "Total over total for average speed.",
          "write": "total over total"
        }
      ]
    }

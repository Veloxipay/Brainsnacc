      "lines": [
        {
          "say": "Ratio, rate and speed questions are about sharing, prices, recipes and journeys."
        },
        {
          "say": "They all compare two amounts by multiplying or dividing, not adding.",
          "write": "× and ÷, not + and −"
        },
        {
          "say": "The traps are mixed units, and averaging what should not be averaged.",
          "write": "watch units"
        }
      ]

    {
      "heading": "Order of operations",
      "lines": [
        {
          "say": "Brackets first. Then times and divide, left to right. Then plus and minus.",
          "write": "BIDMAS"
        },
        {
          "say": "Twenty take six divided by two. Divide first. Six divided by two is three.",
          "write": "20 − 6 ÷ 2 = 20 − 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Divide first, then subtract",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "20 − 6 ÷ 2",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 270,
                "y": 40,
                "w": 140,
                "h": 55,
                "fill": "none",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "= 20 − 3 = 17",
                "size": 30,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So the answer is seventeen, not seven.",
          "write": "= 17  (not 7)"
        },
        {
          "say": "With a bracket, do the bracket first, then divide and times left to right.",
          "write": "48 ÷ (2 + 6) × 3"
        }
      ]

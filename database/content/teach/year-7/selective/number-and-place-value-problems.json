      "heading": "Digit puzzles",
      "lines": [
        {
          "say": "Digits add to nine. Reversed, the number is twenty seven less.",
          "write": "a + b = 9"
        },
        {
          "say": "A two digit number is ten a plus b. Reversed, it is ten b plus a.",
          "write": "10a + b  →  10b + a"
        },
        {
          "say": "The difference is nine times a minus b. So a minus b is three.",
          "write": "9(a − b) = 27 → a − b = 3"
        },

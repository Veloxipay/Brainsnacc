    {
      "heading": "Magic squares",
      "lines": [
        {
          "say": "Every row, column and diagonal adds to the same magic total.",
          "write": "same total every line",
          "diagram": "diagrams/y7/selective/number-grids-and-matrices-ex3.svg",
          "alt": "Magic square. Row 1: 4, ?, 6. Row 2: 9, 7, blank. Row 3: 8, blank, 10."
        },
        {
          "say": "Find a full line. The left column is four plus nine plus eight. Twenty one.",
          "write": "4 + 9 + 8 = 21"

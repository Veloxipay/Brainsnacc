    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Do not open with waking up, the weather, or hi, my name is.",
          "write": "✗ Hi, my name is..."
        },
        {
          "say": "Watch tense slips. I walked, then suddenly I walk.",
          "write": "✗ I walked... I walk",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 140,
            "alt": "A tense slip fixed",
            "items": [
              {
                "kind": "text",
                "x": 30,
                "y": 80,
                "text": "I walked in and I",
                "size": 22,
                "color": "black",
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 220,
                "y": 52,
                "w": 110,
                "h": 40,
                "fill": "white",
                "label": "see",
                "change": "remove"
              },
              {
                "kind": "rect",
                "x": 350,
                "y": 52,
                "w": 110,
                "h": 40,
                "fill": "green",
                "label": "saw",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 80,
                "text": "her.",
                "size": 22,
                "color": "black",
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "Read only your verbs on the last check. Slips jump out.",
          "write": "read the verbs"
        },
        {
          "say": "Swap clichés like fast as lightning for your own comparison.",
          "write": "✗ as fast as lightning"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Start late, finish early.",
          "write": "Start late, finish early"
        },
        {
          "say": "Show feelings through actions, speech and senses.",
          "write": "Show, don't tell"
        },
        {
          "say": "One true detail beats ten general ones. A chipped blue mug, not a cup.",
          "write": "chipped blue mug"
        },
        {
          "say": "End by settling the problem. Never it was all a dream.",
          "write": "A real ending"
        }
      ]
    }

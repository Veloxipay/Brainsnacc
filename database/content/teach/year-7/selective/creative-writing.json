      "heading": "What the marker wants",
      "lines": [
        {
          "say": "A creative task asks for a short story or scene from a prompt.",
          "write": "Prompt → story"
        },
        {
          "say": "Markers read many stories on the same prompt."
        },
        {
          "say": "The ones that stand out hook early, make you feel, and really end.",
          "write": "Hook · Feel · End",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Three stages of a story that stands out",

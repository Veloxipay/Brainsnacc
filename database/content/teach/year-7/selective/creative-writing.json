    {
      "heading": "Show, don't tell",
      "lines": [
        {
          "say": "Ella was very excited. That tells you the feeling.",
          "write": "✗ Ella was very excited."
        },
        {
          "say": "Adding very to a told feeling still just tells."
        },
        {
          "say": "Now show it. She packed her bag three days early.",
          "write": "✓ packed three days early",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Telling crossed out, showing actions added",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 30,
                "w": 520,
                "h": 60,
                "fill": "white",
                "label": "Ella was very excited.",
                "change": "remove"
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 120,
                "w": 520,
                "h": 60,
                "fill": "green",
                "label": "Packed her bag 3 days early",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 200,
                "w": 520,
                "h": 60,
                "fill": "green",
                "label": "Kept checking the weather",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "And she kept checking the weather. You work out the excitement yourself."
        },
        {
          "say": "Use the SHOW checklist: senses, hints through actions, objects, words people say.",
          "write": "S · H · O · W"
        }
      ]

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't pick a word just because it's the same topic.",
          "write": "topic is a trap"
        },
        {
          "say": "Don't reverse the order. Cow to calf is not calf to cow.",
          "write": "calf : cow ≠ cow : calf"
        },
        {
          "say": "Check for a second meaning. A cricket bat, or a bat that flies?",
          "write": "bat? bat?"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Bridge, test, sharpen.",
          "write": "bridge · test · sharpen"
        },
        {
          "say": "Say it with an exact verb. Lives in, makes, is part of.",
          "write": "exact verbs"
        },
        {
          "say": "Topic is a trap. The link is the key.",
          "write": "link is the key"
        }
      ]
    }

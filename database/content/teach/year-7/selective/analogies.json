    {
      "heading": "The common links",
      "lines": [
        {
          "say": "Same meaning. Big and large.",
          "write": "big : large"
        },
        {
          "say": "Opposites. Wet and dry.",
          "write": "wet : dry"
        },
        {
          "say": "Part and whole. A wheel is part of a car.",
          "write": "wheel : car"
        },
        {
          "say": "Type of. A robin is a type of bird.",
          "write": "robin : bird"
        },
        {
          "say": "Tool and use. You use a knife to cut.",
          "write": "knife : cut"
        },
        {
          "say": "Home, group and degree. Bee and hive, fish and school, warm and hot.",
          "write": "bee : hive   warm : hot"
        }
      ]
    },

{
  "level": "Year 7",
  "subject": "selective",
  "title": "Analogies",
  "frames": [
    {
      "heading": "What is an analogy?",
      "lines": [
        {
          "say": "Puppy is to dog as kitten is to what?",
          "write": "puppy : dog :: kitten : ?"
        },
        {
          "say": "Two pairs of words, linked in exactly the same way.",
          "write": "same link, both pairs"
        },
        {
          "say": "The answer is cat. A kitten is a young cat.",
          "write": "kitten : cat"
        },
        {
          "say": "It tests two things. What words mean, and the hidden link.",
          "write": "meaning + link"
        }
      ]
    },
    {
      "heading": "Build a bridge sentence",

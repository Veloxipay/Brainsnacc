    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Could be true but no clue. Ask, where is my clue?",
          "write": "Where is my clue?"
        },
        {
          "say": "One clue is not enough if another clue clashes."
        },
        {
          "say": "An option that just repeats a fact may not answer the question."
        },
        {
          "say": "It is about how the character feels, not how you would feel."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Clue plus what I know equals inference.",
          "write": "clue + know = inference"
        },
        {
          "say": "Three clues, one direction.",
          "write": "3 clues → 1 direction"
        },
        {
          "say": "Must, not might.",
          "write": "Must, not might"

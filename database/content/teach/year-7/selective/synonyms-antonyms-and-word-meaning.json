{
  "level": "Year 7",
  "subject": "selective",
  "title": "Synonyms, antonyms and word meaning",
  "frames": [
    {
      "heading": "Four kinds of word question",
      "lines": [
        {
          "say": "Word meaning questions come in four shapes.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Four question shapes",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 40,
                "w": 250,
                "h": 90,
                "fill": "blue",
                "label": "Same: synonym"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 40,
                "w": 250,
                "h": 90,
                "fill": "orange",
                "label": "Opposite: antonym"
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 160,
                "w": 250,
                "h": 90,
                "fill": "green",
                "label": "Meaning in a sentence"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 160,
                "w": 250,
                "h": 90,
                "fill": "purple",
                "label": "One word, two meanings"
              }
            ]
          }
        },
        {
          "say": "A synonym means the same. Enormous and huge.",
          "write": "synonym: enormous = huge"
        },
        {
          "say": "An antonym means the opposite. Arrive and depart.",
          "write": "antonym: arrive ↔ depart"
        },
        {
          "say": "Some ask what a word means in one sentence. Please bear with me.",
          "write": "bear = be patient"
        },
        {
          "say": "Some want one word for two gaps. A deck of cards, the deck of a ship.",
          "write": "deck"
        }
      ]
    },
    {
      "heading": "Use a test sentence",
      "lines": [
        {
          "say": "Which word is closest to timid? Put it in a sentence first.",
          "write": "TIMID: closest?",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Test sentence and options",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 50,
                "text": "The timid puppy hid under the table.",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "brave"
              },
              {
                "kind": "rect",
                "x": 155,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "shy"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "timed"
              },
              {
                "kind": "rect",
                "x": 425,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "angry"
              }
            ]
          }
        },
        {
          "say": "Swap in each option. Does the sentence still mean the same?",
          "write": "swap and read"
        },
        {
          "say": "Brave is the opposite. Timed only looks similar. Angry doesn't fit.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Wrong options crossed out",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 50,
                "text": "The timid puppy hid under the table.",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "brave"
              },
              {
                "kind": "rect",
                "x": 155,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "shy"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "timed"
              },
              {
                "kind": "rect",
                "x": 425,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "angry"
              }
            ]
          }
        },
        {
          "say": "Shy keeps the meaning. That's the answer.",
          "write": "timid = shy",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Shy is the synonym",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 50,
                "text": "The timid puppy hid under the table.",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "brave"
              },
              {
                "kind": "rect",
                "x": 155,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "green",
                "change": "highlight",
                "label": "shy"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "timed"
              },
              {
                "kind": "rect",
                "x": 425,
                "y": 110,
                "w": 120,
                "h": 60,
                "fill": "white",
                "label": "angry"
              }
            ]
          }
        },
        {
          "say": "For an antonym, the sentence should mean the reverse.",
          "write": "The balloon expands → shrinks"
        }
      ]
    },
    {
      "heading": "Check the question word",
      "lines": [
        {
          "say": "Before the options, say to yourself: closest, or opposite?",
          "write": "closest?  opposite?"
        },
        {
          "say": "Expect a trap of the other kind in the options.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Opposite of EXPAND",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 50,
                "text": "Opposite of EXPAND?",
                "size": 24,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "grow"
              },
              {
                "kind": "rect",
                "x": 155,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "enlarge"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "green",
                "change": "highlight",
                "label": "shrink"
              },
              {
                "kind": "rect",
                "x": 425,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "explain"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "grow and enlarge are synonym traps",
                "size": 20,
                "color": "red",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Grow and enlarge mean the same as expand. Explain just looks alike.",
          "write": "expand ↔ shrink"
        },
        {
          "say": "S for Same, A for Against.",
          "write": "Synonym = Same, Antonym = Against"
        }
      ]
    },
    {
      "heading": "Break the word into parts",
      "lines": [
        {
          "say": "A prefix sits at the start. A suffix sits at the end.",
          "write": "prefix + root + suffix"
        },
        {
          "say": "Un, in, im and dis usually mean not.",
          "write": "un- in- im- dis- = not"
        },
        {
          "say": "Re means again. Pre means before. Mis means wrongly.",
          "write": "re- again  pre- before  mis- wrongly"
        },
        {
          "say": "Less means without. Ful means full of. Able means can be done.",
          "write": "-less  -ful  -able"
        },
        {
          "say": "Which word means not able to be believed? Build it.",
          "write": "un + believe + able",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Building unbelievable from parts",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 140,
                "h": 70,
                "fill": "orange",
                "change": "add",
                "label": "un = not"
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 80,
                "w": 180,
                "h": 70,
                "fill": "blue",
                "label": "believe"
              },
              {
                "kind": "rect",
                "x": 390,
                "y": 80,
                "w": 140,
                "h": 70,
                "fill": "green",
                "change": "add",
                "label": "able"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "unbelievable",
                "size": 34,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Find the root too. Vis in vision and visit is about seeing.",
          "write": "vis = see"
        }
      ]
    },
    {
      "heading": "Words with two meanings",
      "lines": [
        {
          "say": "Short words like light, fair, bear and bank have several meanings.",
          "write": "light  fair  bear  bank"
        },
        {
          "say": "The light suitcase was easy to carry. What does light mean?",
          "write": "The light suitcase…",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Meanings of light",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 40,
                "text": "The light suitcase was easy to carry.",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 90,
                "w": 240,
                "h": 60,
                "fill": "white",
                "label": "bright"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 90,
                "w": 240,
                "h": 60,
                "fill": "white",
                "label": "not heavy"
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 180,
                "w": 240,
                "h": 60,
                "fill": "white",
                "label": "pale in colour"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 180,
                "w": 240,
                "h": 60,
                "fill": "white",
                "label": "to set fire to"
              }
            ]
          }
        },
        {
          "say": "Easy to carry is about weight. So bright makes no sense here.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Not heavy chosen",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 40,
                "text": "The light suitcase was easy to carry.",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 90,
                "w": 240,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "bright"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 90,
                "w": 240,
                "h": 60,
                "fill": "green",
                "change": "highlight",
                "label": "not heavy"
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 180,
                "w": 240,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "pale in colour"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 180,
                "w": 240,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "to set fire to"
              }
            ]
          }
        },
        {
          "say": "The sentence is the boss. Never answer from the word alone.",
          "write": "light = not heavy"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Picking the opposite in a synonym question. Reread the question word.",
          "write": "closest ≠ opposite"
        },
        {
          "say": "Look-alike words. Timid is not timed. Frugal is not fragile.",
          "write": "timid ≠ timed",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Look-alike word pairs",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 200,
                "h": 60,
                "fill": "white",
                "label": "timid"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 60,
                "w": 200,
                "h": 60,
                "fill": "red",
                "change": "remove",
                "label": "timed"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 160,
                "w": 200,
                "h": 60,
                "fill": "white",
                "label": "frugal"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 160,
                "w": 200,
                "h": 60,
                "fill": "red",
                "change": "remove",
                "label": "fragile"
              }
            ]
          }
        },
        {
          "say": "Related isn't the same. Hungry is linked to food, but not a synonym.",
          "write": "hungry ≠ food"
        },
        {
          "say": "Keep the word type. A describing word needs a describing word."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Swap each option into a test sentence and read it.",
          "write": "swap and read"
        },
        {
          "say": "Synonym is Same. Antonym is Against.",
          "write": "S = Same, A = Against"
        },
        {
          "say": "Un, in, im and dis usually mean not.",
          "write": "prefix power"
        },
        {
          "say": "For two-meaning words, the sentence decides.",
          "write": "the sentence is the boss"
        },
        {
          "say": "Collect word pairs as you read. Ten a week adds up fast.",
          "write": "reluctant – unwilling"
        }
      ]
    }
  ]
}
{
  "level": "Year 7",
  "subject": "selective",
  "title": "Fraction, decimal and percentage problems",
  "frames": [
    {
      "heading": "Three ways to write one amount",
      "lines": [
        {
          "say": "Fractions, decimals and percentages are three ways to write the same thing.",
          "write": "3/4 = 0.75 = 75%"
        },
        {
          "say": "In the test they come wrapped in shopping, sharing and score stories."
        },
        {
          "say": "Know the key ones by heart.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 268,
            "alt": "Key equivalents",

                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "It does not go back to one hundred and twenty. The rise is of a smaller amount.",
          "write": "✗ $120"
        },
        {
          "say": "To go backwards, divide by the multiplier. Undo a ten percent rise by dividing by one point one.",
          "write": "÷ 1.1"
        }
      ]

              },
              {
                "kind": "text",
                "x": 36,
                "y": 190.0,
                "text": "1/8 = 0.125 = 12.5%",
                "size": 18,
                "color": "black",
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 20,

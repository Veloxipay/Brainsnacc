    {
      "heading": "Decimals: ignore the point",
      "lines": [
        {
          "say": "Nought point three times nought point nought four. First do three times four.",
          "write": "3 × 4 = 12"
        },
        {
          "say": "Count the decimal places. One plus two is three places.",
          "write": "1 + 2 = 3 places",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Counting decimal places",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "0.3 × 0.04",
                "size": 32,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 170,
                "y": 120,
                "text": "1 place",
                "size": 18,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 370,
                "y": 120,
                "text": "2 places",
                "size": 18,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "= 0.012",
                "size": 32,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So the answer is nought point nought one two, not nought point one two.",
          "write": "0.012 ✓   0.12 ✗"
        },
        {
          "say": "Dividing by a decimal? Times both numbers by ten until you divide by a whole number."
        }
      ]
    },
    {
      "heading": "Watch out and remember",
      "lines": [
        {
          "say": "Divide the change by the original, not the new value.",
          "write": "change ÷ original"
        },
        {
          "say": "Twenty five percent off then ten percent off is not thirty five percent off.",
          "write": "✗ 25% + 10% = 35%"
        },
        {
          "say": "Use the fraction left, not the fraction spent.",
          "write": "fraction LEFT"
        },
        {
          "say": "Divide by the bottom, times by the top.",
          "write": "÷ bottom, × top"
        }
      ]
    }
  ]
}
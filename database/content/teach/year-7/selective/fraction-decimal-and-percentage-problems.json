    {
      "heading": "Percentages and multipliers",
      "lines": [
        {
          "say": "Build percentages from blocks. Ten percent of sixty is six. Five percent is three.",
          "write": "10% = 6, 5% = 3"
        },
        {
          "say": "So fifteen percent of sixty is nine.",
          "write": "15% of 60 = 9"
        },
        {
          "say": "Percentage change is the change over the original. Forty to fifty is ten over forty.",
          "write": "10/40 = 25%"
        },
        {
          "say": "Up twenty percent means times one point two. Down twenty five means times nought point seven five.",
          "write": "+20% → ×1.2   −25% → ×0.75"
        }
      ]
    },
    {
      "heading": "Two changes in a row",
      "lines": [
        {
          "say": "A one hundred and twenty dollar bike is twenty five percent off. That is ninety dollars.",
          "write": "$120 × 0.75 = $90",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Bike price 120 down 25% to 90 then up 25% to 112.50",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 160,
                "h": 180,
                "fill": "blue",

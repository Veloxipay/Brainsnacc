                "size": 18,
                "color": "black",
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "To compare, change everything to decimals. Three eighths is nought point three seven five.",
          "write": "0.375, 0.4, 0.35 → 0.4"
        }
      ]
    },

{
  "level": "Year 7",
  "subject": "selective",
  "title": "What verbal reasoning tests",
  "frames": [
    {
      "heading": "Thinking with words",
      "lines": [
        {
          "say": "Verbal reasoning checks how well you think with words.",
          "write": "think WITH words"
        },
        {
          "say": "It's not just how many words you know.",
          "write": "patterns in language"
        },
        {
          "say": "Our practice tests have 40 questions in 30 minutes.",
          "write": "40 questions, 30 minutes"
        },
        {
          "say": "Each question has four options and one best answer.",
          "write": "4 options, 1 best"
        }
      ]
    },
    {
      "heading": "Six question types",
      "lines": [
        {
          "say": "You'll meet six types of question.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Six verbal question types",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 30,
                "w": 250,
                "h": 60,
                "fill": "blue",
                "label": "Analogies"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 30,
                "w": 250,
                "h": 60,
                "fill": "orange",
                "label": "Odd one out"
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 110,
                "w": 250,
                "h": 60,
                "fill": "green",
                "label": "Word meaning"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 110,
                "w": 250,
                "h": 60,
                "fill": "purple",
                "label": "Letter series, codes"
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 190,
                "w": 250,
                "h": 60,
                "fill": "teal",
                "label": "Hidden words"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 190,
                "w": 250,
                "h": 60,
                "fill": "pink",
                "label": "Logical deduction"
              }
            ]
          }
        },
        {
          "say": "Analogy: finger is to hand as toe is to foot.",
          "write": "finger : hand = toe : foot"
        },
        {
          "say": "Odd one out: apple, banana, carrot, mango. Carrot isn't a fruit.",
          "write": "carrot"
        },
        {
          "say": "Letter series: A, C, E, G. Skip one letter each time. Next is I.",
          "write": "A C E G → I"
        },
        {
          "say": "Hidden words: in the next, h e n runs across the gap.",
          "write": "t[he n]ext → hen",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Hen hidden across two words",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 120,
                "text": "Turn to the next page",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 228,
                "y": 80,
                "w": 72,
                "h": 56,
                "fill": "none",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "hen",
                "size": 32,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Deduction: Sam is taller than Jo, Jo than Ky. Ky is shortest.",
          "write": "Sam > Jo > Ky"
        }
      ]
    },
    {
      "heading": "Know your pace",
      "lines": [
        {
          "say": "30 minutes is 1800 seconds. Divided by 40, that's 45 seconds.",
          "write": "1800 ÷ 40 = 45 s"
        },
        {
          "say": "That's an average. Easy ones take 15 to 20 seconds.",
          "write": "average, not a limit"
        },
        {
          "say": "Check the clock at questions 10, 20 and 30.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Checkpoints",
            "items": [
              {
                "kind": "line",
                "x": 30,
                "y": 140,
                "x2": 530,
                "y2": 140,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 30,
                "y": 180,
                "text": "0",
                "size": 18,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 530,

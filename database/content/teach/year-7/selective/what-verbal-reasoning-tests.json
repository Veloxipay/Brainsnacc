                "color": "black",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "You should be near 7 and a half, 15 and 22 and a half minutes.",
          "write": "7½ • 15 • 22½"
        },
        {
          "say": "Ten minutes left, 16 questions? 600 divided by 16 is about 37 seconds.",
          "write": "600 ÷ 16 ≈ 37 s"
        }
      ]
    },
    {
      "heading": "The four-step routine",
      "lines": [
        {
          "say": "Read the question type. It tells you which tool to use.",
          "write": "1. Type"
        },
        {
          "say": "Find the rule before you look at the options.",
          "write": "2. Rule first"
        },
        {
          "say": "Bird is to nest. A nest is the home a bird lives in.",
          "write": "rule: home of"
        },
        {
          "say": "Test every option. Bark, kennel, puppy, bone. Only kennel is a home.",
          "write": "3. Test every option",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Testing options for dog",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "bark"
              },
              {
                "kind": "rect",
                "x": 155,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "green",
                "change": "highlight",
                "label": "kennel"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "puppy"
              },
              {
                "kind": "rect",
                "x": 425,
                "y": 100,
                "w": 120,
                "h": 60,
                "fill": "white",
                "change": "remove",
                "label": "bone"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "Bird : nest = dog : ?",
                "size": 24,
                "color": "black",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Pick the best fit and move on.",
          "write": "4. Pick, move on"
        },
        {
          "say": "Puppy is linked to dog, but not by the home rule.",
          "write": "✗ puppy"
        }
      ]
    },
    {
      "heading": "Read the small words",
      "lines": [
        {
          "say": "Every chess club student is in Year 7. Nina is in Year 7.",
          "write": "Which MUST be true?"
        },
        {
          "say": "The rule only goes one way. Chess club means Year 7.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Chess club circle inside Year 7 circle",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 130,
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 50,
                "text": "Year 7",
                "size": 20,
                "color": "white",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 250,
                "y": 170,
                "r": 60,
                "fill": "orange",
                "label": "Chess club"
              },
              {
                "kind": "circle",
                "x": 380,
                "y": 140,
                "r": 14,
                "fill": "red",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 250,
                "y": 200,
                "r": 14,
                "fill": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 240,
                "text": "Nina?",
                "size": 20,
                "color": "red",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "So Nina might be in the club. She might not.",
          "write": "Nina MIGHT be in it"
        },
        {
          "say": "Must, could, not, closest, opposite. They change the whole question.",
          "write": "must • not • opposite"
        }
      ]
    },
    {
      "heading": "When you're stuck",
      "lines": [
        {
          "say": "After about a minute with no rule, cross out wrong options.",
          "write": "cross out"
        },
        {
          "say": "Guess from what's left, flag it, and move on.",
          "write": "flag it, bag a guess, move on"
        },
        {
          "say": "A guess from two options has a 1 in 2 chance. A blank has none.",
          "write": "1 in 2  vs  0",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Guess beats blank",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 80,
                "w": 200,
                "h": 100,
                "fill": "green",
                "change": "highlight",
                "label": "guess: 1 in 2"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 80,
                "w": 200,
                "h": 100,
                "fill": "grey",
                "change": "remove",
                "label": "blank: 0"
              }
            ]
          }
        },
        {
          "say": "Only change an answer if you find a definite mistake."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Rule first, options second.",
          "write": "Rule first"
        },
        {
          "say": "About 45 seconds a question. Three quarters of a minute.",
          "write": "45 s"
        },
        {
          "say": "Say the rule as a sentence, then test every option.",
          "write": "say it, test it"
        },
        {
          "say": "Small words decide the answer.",
          "write": "must • not • opposite"
        }
      ]
    }
  ]
}
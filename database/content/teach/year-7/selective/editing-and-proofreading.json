    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Read what you wrote, not what you meant. Slow down.",
          "write": "read every word"
        },
        {
          "say": "Expand to test. It's means it is. You're means you are.",
          "write": "it's = it is"
        },
        {
          "say": "Two sentences can't hold hands with just a comma.",
          "write": "full stop or joining word"
        },
        {
          "say": "TiPToP for new paragraphs.",
          "write": "TiPToP"
        }
      ]

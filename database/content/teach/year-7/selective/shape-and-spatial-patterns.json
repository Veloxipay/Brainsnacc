    {
      "heading": "Two changes at once",
      "lines": [
        {
          "say": "Circle with one dot, square with two, circle with three.",
          "write": "○1  □2  ○3  ?",
          "diagram": "diagrams/y7/selective/shape-and-spatial-patterns-ex3.svg",
          "alt": "Circle with 1 dot, square with 2 dots, circle with 3 dots, then a question mark."
        },
        {
          "say": "Change one. The shapes alternate. Next is a square.",
          "write": "shape: square"
        },
        {
          "say": "Change two. One more dot each time. Next is four dots.",
          "write": "dots: 4",
          "draw": {

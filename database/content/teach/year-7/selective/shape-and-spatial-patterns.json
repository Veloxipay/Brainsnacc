    {
      "heading": "Matchstick patterns",
      "lines": [
        {
          "say": "One triangle uses three sticks. Two triangles, sharing a side, use five.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Matchstick triangles in a row",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    200
                  ],
                  [
                    110,
                    200
                  ],
                  [
                    75.0,
                    140
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    110,
                    200
                  ],
                  [
                    180,
                    200
                  ],
                  [
                    145.0,
                    140
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 260,
                "text": "2 triangles: 5 sticks",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Each new triangle adds two sticks. Three triangles use seven.",
          "write": "+2 each time",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Matchstick triangles in a row",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    200
                  ],
                  [
                    110,
                    200
                  ],
                  [
                    75.0,
                    140
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    110,
                    200
                  ],
                  [
                    180,
                    200
                  ],
                  [
                    145.0,
                    140
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    180,
                    200
                  ],
                  [
                    250,
                    200
                  ],
                  [
                    215.0,
                    140
                  ]
                ],
                "fill": "orange",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 260,
                "text": "3 triangles: 7 sticks",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Rule. Sticks equal two times triangles, plus one.",
          "write": "sticks = 2 × triangles + 1"
        },
        {
          "say": "Ten triangles need twenty one sticks. Thirty counts shared sides twice.",
          "write": "2 × 10 + 1 = 21"
        }
      ]
    },
    {
      "heading": "Reflections and nets",
      "lines": [
        {
          "say": "In a reflection, every point is the same distance from the mirror, on the other side.",
          "write": "same distance, other side",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "A shape reflected in a vertical mirror line",
            "items": [
              {
                "kind": "line",
                "x": 280,
                "y": 20,
                "x2": 280,
                "y2": 280,
                "color": "black",

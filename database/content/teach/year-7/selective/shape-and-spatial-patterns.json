                "size": 16,
                "color": "grey",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "A reflection flips. A rotation turns the whole thing.",
          "write": "flip ≠ turn"
        },
        {
          "say": "When a square grid turns ninety degrees, corners stay corners.",
          "write": "corners stay corners"
        },
        {
          "say": "In a straight row of a cube net, squares one apart are opposite faces.",
          "write": "net: skip one = opposite"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "What changed? Say it, check it, do it.",
          "write": "Say it, check it, do it"
        },
        {
          "say": "Use a clock for turns. Clockwise is the way the hands move.",
          "write": "clock face"
        },
        {
          "say": "Track two changes separately.",
          "write": "two changes"
        },
        {
          "say": "Count squares by size, and never count rectangles.",
          "write": "count by size"
        }

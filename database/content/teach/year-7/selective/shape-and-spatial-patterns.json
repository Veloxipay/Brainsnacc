{
  "level": "Year 7",
  "subject": "selective",
  "title": "Shape and spatial patterns",
  "frames": [
    {
      "heading": "What changes, what stays?",
      "lines": [
        {
          "say": "Shape patterns change step by step. What comes next, or what is missing?",
          "write": "what comes next?"
        },
        {
          "say": "Things turn, move, get added, or two things change at once.",
          "write": "turn · move · add"
        },
        {
          "say": "Name every change, say it as a sentence, and check it on the next pair.",
          "write": "Say it, check it, do it"
        }
      ]
    },
    {

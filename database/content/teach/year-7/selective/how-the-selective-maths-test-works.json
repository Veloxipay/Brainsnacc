    {
      "heading": "The one-minute rule",
      "lines": [
        {
          "say": "Read once carefully. Underline what is being asked, and in what units.",
          "write": "Read, Underline, Go"
        },
        {
          "say": "If you see a method in about thirty seconds, go."
        },
        {
          "say": "Stuck after a minute? Guess, mark the number, and move on.",
          "write": "Guess, Mark, Move"
        },
        {
          "say": "Skipping is not giving up. You trade one hard question for two or three easy ones."
        },
        {
          "say": "Nine minutes left? Do the unseen questions first, then guess the hard ones.",
          "write": "unseen first"
        }
      ]
    },
    {
      "heading": "Never leave a blank",
      "lines": [
        {
          "say": "A blank is a sure zero. A random guess has a one in four chance.",
          "write": "blank = 0",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,

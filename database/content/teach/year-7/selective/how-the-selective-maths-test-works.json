    {
      "heading": "Check fast",
      "lines": [
        {
          "say": "Estimate. Is the answer about the right size?",
          "write": "right size?"
        },
        {
          "say": "Last digit. Forty seven times thirty eight must end in six, because seven eights are fifty six.",
          "write": "47 × 38 → ends in 6"
        },
        {
          "say": "Reverse it. If you divided, multiply back.",
          "write": "÷ then ×"
        },
        {
          "say": "Watch small words like not, closest, at least, remaining.",
          "write": "NOT · closest · at least"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Read, underline, go. Or guess, mark, move.",
          "write": "Guess, Mark, Move"
        },
        {
          "say": "A blank is a zero.",
          "write": "A blank is a zero"
        },
        {
          "say": "Checkpoints beat clock watching.",
          "write": "2 checkpoints"
        },
        {
          "say": "Estimate first, calculate second.",

  "title": "How the selective maths test works",
  "frames": [
    {
      "heading": "What the paper looks like",
      "lines": [
        {
          "say": "The maths section is multiple choice. About thirty minutes. No calculator.",
          "write": "~30 min · no calculator"
        },
        {
          "say": "Every question has four options, and exactly one is right.",
          "write": "A  B  C  D"
        },
        {
          "say": "There are no marks for working. Only the letter you choose counts."
        },
        {
          "say": "Do not expect it to get harder steadily. A hard one can sit before an easy one."
        },
        {
          "say": "Watch units. Two point four metres cut into thirty centimetre pieces. Change to centimetres.",
          "write": "240 cm ÷ 30 cm = 8"
        }
      ]
    },

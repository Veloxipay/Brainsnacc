    {
      "heading": "Why plan?",
      "lines": [
        {
          "say": "Strong test writing starts with a plan. You have about five minutes.",
          "write": "5 minutes"
        },
        {
          "say": "A plan is dot points, not sentences. Abbreviations are fine.",
          "write": "dot points only"
        },
        {
          "say": "When you start writing, you already know your beginning, middle and ending."
        }
      ]

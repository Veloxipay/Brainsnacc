    {
      "heading": "Check in seconds",
      "lines": [
        {
          "say": "Last-digit check. A student says 7 times 286 is 1992.",
          "write": "7 × 286 = 1992 ?"
        },
        {
          "say": "7 times 6 is 42, so it must end in 2. It passes.",
          "write": "7 × 6 = 42 → ends in 2"
        },
        {
          "say": "Now estimate. 7 times 300 is 2100, then take away 7 times 14.",
          "write": "2100 − 98 = 2002",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Estimate shows 1992 is wrong",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 220,
                "h": 70,
                "fill": "white",
                "change": "remove",
                "label": "1992"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 60,
                "w": 220,
                "h": 70,
                "fill": "green",
                "change": "add",
                "label": "2002"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "Last digit can't prove it right",
                "size": 20,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "The last digit never lies, but it doesn't tell the whole truth."
        },
        {
          "say": "Reverse check: if you divided, multiply back. Then do a sense check.",
          "write": "reverse  •  sense check"
        }
      ]
    },
    {
      "heading": "Back-solve with the options",
      "lines": [
        {
          "say": "Which number stays the same if you add 12 and halve it?",
          "write": "A 6   B 12   C 24"
        },
        {
          "say": "Start with the middle option, 12.",
          "write": "middle option first"
        },
        {
          "say": "12 plus 12 is 24. Half of 24 is 12. It works!",
          "write": "12 + 12 = 24, 24 ÷ 2 = 12 ✓",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Testing option 12",
            "items": [
              {
                "kind": "circle",
                "x": 100,
                "y": 120,
                "r": 45,
                "fill": "blue",
                "label": "12"
              },
              {
                "kind": "arrow",
                "x": 150,
                "y": 120,
                "x2": 230,
                "y2": 120,
                "color": "purple"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 120,
                "r": 45,
                "fill": "orange",
                "label": "24"
              },
              {
                "kind": "arrow",
                "x": 330,
                "y": 120,
                "x2": 410,
                "y2": 120,
                "color": "purple"
              },
              {
                "kind": "circle",
                "x": 460,
                "y": 120,
                "r": 45,
                "fill": "green",
                "change": "highlight",
                "label": "12"
              },
              {
                "kind": "text",
                "x": 190,
                "y": 100,
                "text": "+ 12",
                "size": 18,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 370,
                "y": 100,
                "text": "÷ 2",
                "size": 18,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Stop there. You don't need to test the rest."
        },
        {
          "say": "24 is tempting, but 24 plus 12, halved, is 18.",
          "write": "✗ C: 36 ÷ 2 = 18"
        }
      ]
    },
    {
      "heading": "Read like a detective",
      "lines": [
        {
          "say": "Most silly errors are reading errors.",
          "write": "Underline what is asked"
        },
        {
          "say": "Circle small words that flip the meaning.",
          "write": "NOT • each • remaining",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Small words circled",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "Which is NOT a multiple of 3?",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "circle",
                "x": 186,
                "y": 74,
                "r": 34,
                "fill": "none",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 180,
                "text": "How many are remaining?",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "circle",
                "x": 340,
                "y": 174,
                "r": 52,
                "fill": "none",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Watch time units. One point five hours is 1 hour 30 minutes.",
          "write": "1.5 h = 1 h 30 min"
        },
        {
          "say": "Not 1 hour 50 minutes. Sixty is the magic number for time.",
          "write": "× 60"
        },
        {
          "say": "After you calculate, reread the question once."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Ten and halve for times 5. Quarter and hundred for times 25.",
          "write": "× 5: ×10 ÷2   × 25: ÷4 ×100"
        },
        {
          "say": "Round, rough, rule out.",
          "write": "Estimate first"
        },
        {
          "say": "Check last digits, reverse, and use common sense.",
          "write": "Check ✓"
        },
        {
          "say": "Middle option first when back-solving.",
          "write": "Back-solve"
        },
        {
          "say": "Only change an answer if you find a definite mistake."
        }
      ]
    }
  ]
}
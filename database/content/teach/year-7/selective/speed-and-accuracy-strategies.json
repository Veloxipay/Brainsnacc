{
  "level": "Year 7",
  "subject": "selective",
  "title": "Speed and accuracy strategies",
  "frames": [
    {
      "heading": "Fast and careful wins",
      "lines": [
        {
          "say": "In a 30 minute paper, the best scorers waste the least time.",
          "write": "Speed + accuracy"
        },
        {
          "say": "They also make the fewest careless errors.",
          "write": "fewest silly slips"
        },
        {
          "say": "Today you get a toolkit: shortcuts, estimates and quick checks.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Five tools in a toolkit",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 60,
                "w": 100,
                "h": 70,
                "fill": "blue",
                "label": "Shortcuts"
              },
              {
                "kind": "rect",
                "x": 130,
                "y": 60,
                "w": 100,
                "h": 70,
                "fill": "orange",
                "label": "Estimate"
              },
              {
                "kind": "rect",
                "x": 240,
                "y": 60,
                "w": 100,
                "h": 70,
                "fill": "green",
                "label": "Check"
              },
              {
                "kind": "rect",
                "x": 350,
                "y": 60,
                "w": 90,
                "h": 70,
                "fill": "purple",
                "label": "Back-solve"
              },
              {
                "kind": "rect",
                "x": 450,
                "y": 60,
                "w": 90,
                "h": 70,
                "fill": "teal",
                "label": "Read"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "Practise until automatic",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Practise them until you use them without thinking."
        }
      ]
    },
    {
      "heading": "Multiplication shortcuts",
      "lines": [
        {
          "say": "Times 5? Multiply by 10, then halve.",
          "write": "16 × 5 → 160 ÷ 2 = 80",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "16 times 5 as ten then halve",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 140,
                "h": 60,
                "fill": "blue",
                "label": "16"
              },
              {
                "kind": "arrow",
                "x": 190,
                "y": 90,
                "x2": 250,
                "y2": 90,
                "color": "purple"
              },
              {
                "kind": "rect",
                "x": 260,
                "y": 60,
                "w": 140,
                "h": 60,
                "fill": "orange",
                "change": "add",
                "label": "160"
              },
              {
                "kind": "arrow",
                "x": 410,
                "y": 90,
                "x2": 450,
                "y2": 90,
                "color": "purple"
              },
              {
                "kind": "rect",
                "x": 455,
                "y": 60,
                "w": 90,
                "h": 60,
                "fill": "green",
                "change": "add",
                "label": "80"
              },
              {
                "kind": "text",
                "x": 220,
                "y": 50,
                "text": "× 10",
                "size": 18,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 430,
                "y": 50,
                "text": "÷ 2",
                "size": 18,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Times 25? Divide by 4, then multiply by 100.",
          "write": "48 × 25 → 12 × 100 = 1200"
        },
        {
          "say": "Times 99? Times 100, then take away the extra one.",
          "write": "99 × 8 = 800 − 8 = 792"
        },
        {
          "say": "Times one and a half? Just add half on.",
          "write": "1.5 × 48 = 48 + 24 = 72"
        },
        {
          "say": "Times 11? Add the two digits and put the total in the middle.",
          "write": "52 × 11 → 5 (7) 2 = 572",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "52 times 11: digits pushed apart, sum in the middle",
            "items": [
              {
                "kind": "rect",
                "x": 120,
                "y": 60,
                "w": 80,
                "h": 80,
                "fill": "blue",
                "label": "5"
              },
              {
                "kind": "rect",
                "x": 360,
                "y": 60,
                "w": 80,
                "h": 80,
                "fill": "blue",
                "label": "2"
              },
              {
                "kind": "rect",
                "x": 240,
                "y": 60,
                "w": 80,
                "h": 80,
                "fill": "yellow",
                "change": "add",
                "label": "7"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "5 + 2 = 7",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "52 × 11 = 572",
                "size": 24,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Double and halve also works. Four point five times 20 is 9 times 10.",
          "write": "4.5 × 20 = 9 × 10 = 90"
        }
      ]
    },
    {
      "heading": "Shortcut traps",
      "lines": [
        {
          "say": "Here's 198 times 6. 198 is 2 less than 200.",
          "write": "198 × 6"
        },
        {
          "say": "So do 200 times 6, then take away 2 times 6.",
          "write": "1200 − 12 = 1188",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "200 times 6 minus 2 times 6",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 500,
                "h": 70,
                "fill": "blue",
                "label": "200 × 6 = 1200"
              },
              {
                "kind": "rect",
                "x": 430,
                "y": 80,
                "w": 100,
                "h": 70,
                "fill": "red",
                "change": "remove",
                "label": "2 × 6 = 12"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "1200 − 12 = 1188",
                "size": 26,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Taking away just 2 gives 1198. That's the trap.",
          "write": "✗ 1198"
        },
        {
          "say": "And with times 25, don't drop a zero. 1200, not 120.",
          "write": "✗ 120  ✓ 1200"
        }
      ]
    },
    {
      "heading": "Estimate first",
      "lines": [
        {
          "say": "Round each number, find a rough answer, then rule out options.",
          "write": "Round, rough, rule out"
        },

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Variables and algebraic expressions",
  "frames": [
    {
      "heading": "A letter for a number",
      "lines": [
        {
          "say": "Imagine a box labelled m. We don't know how many marbles are inside.",
          "write": "m = mystery number",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "A box labelled m with 3 more marbles",
            "items": [
              {
                "kind": "rect",
                "x": 160,
                "y": 80,
                "w": 140,
                "h": 120,
                "fill": "orange",
                "label": "m"
              },
              {
                "kind": "text",
                "x": 230,
                "y": 60,
                "text": "mystery box",
                "size": 18,
                "color": "black",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Add 3 more marbles. Now the box holds m plus 3.",
          "write": "m + 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "A box labelled m with 3 more marbles",
            "items": [
              {
                "kind": "rect",
                "x": 160,
                "y": 80,
                "w": 140,
                "h": 120,
                "fill": "orange",
                "label": "m"
              },
              {

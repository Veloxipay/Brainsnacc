{
  "level": "Year 7",
  "subject": "maths",
  "title": "Index notation, squares and square roots",
  "frames": [
    {
      "heading": "Index notation",
      "lines": [
        {
          "say": "Here is a short way to write repeated multiplying.",
          "write": "2⁴ = 2 × 2 × 2 × 2"
        },
        {
          "say": "The big number, 2, is the base. It gets multiplied.",
          "write": "base = 2"
        },
        {
          "say": "The small raised number, 4, is the index. It counts the twos.",
          "write": "index = 4"
        },
        {
          "say": "Two to the power of 4 is 16.",
          "write": "2⁴ = 16"
        },
        {
          "say": "It is not 2 times 4. That would be 8.",
          "write": "2⁴ ≠ 2 × 4"
        },
        {
          "say": "Powers of 10 are easy. The index tells you how many zeros.",
          "write": "10⁴ = 10 000"
        }
      ]
    },
    {
      "heading": "Squares and cubes",
      "lines": [
        {
          "say": "To the power of 2 is called squared.",
          "write": "5² = 25"
        },
        {
          "say": "To the power of 3 is called cubed.",
          "write": "5³ = 5 × 5 × 5 = 125"
        },
        {
          "say": "Indices make prime factors shorter too.",
          "write": "72 = 2³ × 3²"
        },
        {
          "say": "Two cubed is 8, 3 squared is 9. 8 times 9 is 72.",
          "write": "8 × 9 = 72"
        }
      ]
    },

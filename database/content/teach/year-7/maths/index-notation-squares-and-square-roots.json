    {
      "heading": "Square roots",
      "lines": [
        {
          "say": "The square root goes backwards. What times itself gives the number?",
          "write": "√ = square root"
        },
        {
          "say": "Forty-nine tiles make a square. Each side has 7.",
          "write": "√49 = 7",
          "diagram": "diagrams/y7/maths/index-notation-squares-and-square-roots-root.svg",
          "alt": "A square of 49 tiles with 7 on each side"
        },
        {
          "say": "Eight times 8 is 64. So the square root of 64 is 8.",
          "write": "√64 = 8"
        },
        {
          "say": "Squaring and square-rooting undo each other.",
          "write": "7² = 49  ↔  √49 = 7"
        },
        {
          "say": "Forty is between 36 and 49. So root 40 is between 6 and 7.",
          "write": "6 < √40 < 7",
          "draw": {
            "type": "numberline",
            "from": 30,
            "to": 50,
            "start": 36,
            "jump": 13
          }
        }
      ]
    },
    {
      "heading": "Powers come early in BIDMAS",
      "lines": [
        {
          "say": "The I in BIDMAS stands for indices. Do powers straight after brackets.",
          "write": "B I D M A S"
        },
        {
          "say": "Root of 3 squared plus 4 squared. Square first.",
          "write": "√(3² + 4²) = √(9 + 16)"
        },
        {
          "say": "Nine plus 16 is 25. The square root of 25 is 5.",
          "write": "√25 = 5"
        },
        {
          "say": "It is not 3 plus 4, which is 7.",
          "write": "≠ 7"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Two to the 4 is not 2 times 4. Write it out.",
          "write": "✗ 2⁴ = 8   ✓ 2⁴ = 16"
        },
        {
          "say": "Root 16 is not 8. Don't halve. Four times 4 is 16.",
          "write": "✗ √16 = 8   ✓ √16 = 4"
        },
        {
          "say": "Three squared plus 4 squared is 25, not 49.",
          "write": "3² + 4² = 25"
        },
        {
          "say": "Two cubed is 8, but 3 squared is 9. Don't swap them.",
          "write": "2³ = 8   3² = 9"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "The little number counts. The big number gets multiplied.",
          "write": "base^index"
        },
        {
          "say": "n squared is an n by n square of tiles.",
          "write": "n² = tile square"
        },
        {
          "say": "A square root takes you back to the side length.",
          "write": "√area = side"
        },
        {
          "say": "Powers before adding. That is the I in BIDMAS.",
          "write": "powers first"
        }
      ]
    }
  ]
}
    {
      "heading": "Which one do I need?",
      "lines": [
        {
          "say": "Split into equal groups, or share with nothing left? Use the HCF.",
          "write": "share / split → HCF"
        },
        {
          "say": "Together again, or smallest amount to match? Use the LCM.",
          "write": "together again → LCM"
        },
        {
          "say": "The HCF is never bigger than the smaller number.",
          "write": "HCF ≤ smaller"
        },
        {
          "say": "The LCM is never smaller than the bigger number.",
          "write": "LCM ≥ bigger"
        }
      ]
    },

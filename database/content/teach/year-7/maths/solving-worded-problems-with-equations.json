    {
      "heading": "Lengths and consecutive numbers",
      "lines": [
        {
          "say": "A garden bed is 3 times as long as it is wide.",
          "write": "width w, length 3w",
          "diagram": "diagrams/y7/maths/solving-worded-problems-with-equations-garden.svg",
          "alt": "Rectangle with width w and length 3w, perimeter 64 m"
        },
        {
          "say": "Perimeter is 64. So 3w plus 3w plus w plus w is 64.",
          "write": "8w = 64"
        },
        {
          "say": "Width is 8 metres. Length is 24 metres.",
          "write": "w = 8 m, length = 24 m"
        },
        {
          "say": "Three consecutive numbers follow each other. Call them n, n plus 1, n plus 2.",
          "write": "n, n + 1, n + 2"
        },
        {
          "say": "They add to 72. So 3n plus 3 is 72, and n is 23.",
          "write": "3n + 3 = 72 → n = 23"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Always say what your letter stands for. Start with \"Let\".",
          "write": "Let … = …"
        },
        {
          "say": "Six less than x is x minus 6. Not 6 minus x.",
          "write": "x − 6, not 6 − x"
        },
        {
          "say": "Don't use two letters for linked amounts. Build from one.",
          "write": "a and a + 7"
        },
        {
          "say": "Does it make sense? You can't have 4.5 people.",
          "write": "sense check"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Define, write, solve, answer. Every time.",
          "write": "D-W-S-A"
        },
        {
          "say": "Is means equals.",
          "write": "is → ="
        },
        {
          "say": "One letter, then build the other amounts from it.",
          "write": "one letter"
        },
        {
          "say": "Check your answer in the story, not just the equation.",
          "write": "check in the story ✓"
        }
      ]
    }
  ]
}

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Solving worded problems with equations",
  "frames": [
    {
      "heading": "Translate words into maths",
      "lines": [
        {
          "say": "Real problems come as sentences, not neat equations.",
          "write": "words → equation"
        },
        {
          "say": "It's like translating a text message into maths.",
          "write": "\"c u l8r\" → \"see you later\""
        },
        {
          "say": "Sum, total and more than mean add.",
          "write": "sum, more than → +"
        },
        {
          "say": "Difference and less than mean subtract. Twice and product mean multiply.",
          "write": "less than → −   twice → ×"
        },
        {
          "say": "Is, equals and costs all mean equals.",
          "write": "is, costs → ="
        },
        {
          "say": "Careful. Five less than n means n minus 5.",
          "write": "5 less than n = n − 5",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Words translated: 5 − n crossed out, n − 5 added",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "\"5 less than n\"",
                "size": 30,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 85,
                "x2": 280,
                "y2": 135,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "5 − n",
                "size": 40,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "n − 5",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "The four-step plan",
      "lines": [
        {
          "say": "Step one. Define. Choose a letter and say what it stands for.",
          "write": "1. Define"
        },
        {
          "say": "Step two. Write the equation.",
          "write": "2. Write"
        },
        {
          "say": "Step three. Solve it with the balance method.",
          "write": "3. Solve"
        },
        {
          "say": "Step four. Answer in a sentence, with units.",
          "write": "4. Answer"
        },
        {
          "say": "Do We Solve Anything? Define, write, solve, answer.",
          "write": "D-W-S-A"
        }
      ]
    },

    {
      "heading": "Splitting and the ×11 trick",
      "lines": [
        {
          "say": "Splitting numbers works because of the distributive law.",
          "write": "a(b + c) = ab + ac"
        },
        {
          "say": "53 times 11 is 53 times 10, plus 53. That's 583.",
          "write": "530 + 53 = 583"
        },
        {
          "say": "Shortcut: write 5 and 3 apart. Put 5 plus 3 in the middle.",
          "write": "5 _ 3 → 583",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "times 11 shortcut",
            "items": [
              {
                "kind": "rect",
                "x": 140,

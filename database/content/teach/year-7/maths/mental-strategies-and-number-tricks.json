    {
      "heading": "Square minus square",
      "lines": [
        {
          "say": "43 and 37 are both 3 away from 40.",
          "write": "43 × 37",
          "draw": {
            "type": "numberline",
            "from": 35,
            "to": 45,
            "start": 40,
            "jump": 3
          }
        },
        {
          "say": "Square the middle, then take away the square of the gap.",
          "write": "(a + b)(a − b) = a² − b²"
        },
        {
          "say": "40 squared is 1600. 3 squared is 9. Answer 1591.",
          "write": "1600 − 9 = 1591"
        },
        {
          "say": "Only use it when both are the same distance away.",
          "write": "✗ 52 × 47"
        },
        {
          "say": "To square a number ending in 5, like 35: 3 times 4, then write 25.",
          "write": "35² → 12|25 = 1225"
        }
      ]
    },

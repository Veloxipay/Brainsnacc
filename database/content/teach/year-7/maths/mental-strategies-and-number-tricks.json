        {
          "say": "Times 5 is times 10, then halve. 84 times 5 is 420.",
          "write": "840 ÷ 2 = 420"
        },
        {
          "say": "Times 25 is times 100, then divide by 4.",
          "write": "36 × 25 = 3600 ÷ 4"
        },
        {
          "say": "So 36 times 25 is 900. Four quarters make a dollar.",
          "write": "= 900"
        }
      ]
    },

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't work strictly left to right. Find times and divide first.",
          "write": "underline × ÷"
        },
        {
          "say": "Minus 3 squared is not the same as minus 3 in brackets, squared.",
          "write": "−3² ≠ (−3)²"
        },
        {
          "say": "Times doesn't beat divide. Go left to right.",
          "write": "÷ × left to right"
        },
        {
          "say": "Carry every sign. Minus 5 plus minus 12 is not minus 5 plus 12.",
          "write": "✗ −5 + 12"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Brackets, indices, divide and multiply, add and subtract.",
          "write": "BIDMAS"
        },
        {
          "say": "Do one step, then rewrite the line.",
          "write": "one step, rewrite"
        },
        {
          "say": "Bracket it to square it.",
          "write": "(−3)² = 9"
        },
        {
          "say": "Check: should the answer be positive or negative?",
          "write": "sign check"
        }

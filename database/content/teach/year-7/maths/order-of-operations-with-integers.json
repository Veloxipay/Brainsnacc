    {
      "heading": "Powers of negatives",
      "lines": [
        {
          "say": "Minus 3, in brackets, squared means minus 3 times minus 3.",
          "write": "(−3)² = (−3) × (−3) = 9"
        },
        {
          "say": "Without brackets, only the 3 is squared. Then the minus.",
          "write": "−3² = −(3 × 3) = −9"
        },
        {
          "say": "Bracket it to square it.",
          "write": "(−4)² = 16   −4² = −16",

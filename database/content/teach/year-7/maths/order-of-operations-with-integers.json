{
  "level": "Year 7",
  "subject": "maths",
  "title": "Order of operations with integers",
  "frames": [
    {
      "heading": "Same order, new numbers",
      "lines": [
        {
          "say": "BIDMAS works the same with negative numbers.",
          "write": "B  I  D M  A S"
        },
        {
          "say": "Brackets, then indices, then divide and multiply, then add and subtract.",
          "write": "B → I → D M → A S"
        },
        {
          "say": "Partners, D and M, go left to right. So do A and S.",
          "write": "partners: left to right"
        },
        {
          "say": "Brackets around minus 4 just show it is one number.",
          "write": "(−4) is one number"
        }
      ]
    },

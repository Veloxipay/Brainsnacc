        {
          "say": "47 plus 38. Split 38 into 30 and 8.",
          "write": "47 + 30 + 8",
          "diagram": "diagrams/y7/maths/adding-and-subtracting-whole-numbers-jump.svg",
          "alt": "Jumps of 30 then 8 from 47 to 85"
        },
        {
          "say": "47 plus 30 is 77. Then plus 8 is 85.",
          "write": "= 85"
        },
        {
          "say": "196 plus 57 plus 4. Make a hundred first: 196 plus 4 is 200.",
          "write": "(196 + 4) + 57 = 257"
        },
        {
          "say": "83 take 29. Take 30, giving 53. Add back the extra 1: 54.",
          "write": "83 − 30 + 1 = 54"
        },
        {
          "say": "1000 take 760. Count up: 40 to 800, then 200 to 1000.",

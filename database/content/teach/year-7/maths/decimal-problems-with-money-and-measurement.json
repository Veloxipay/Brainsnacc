{
  "level": "Year 7", "subject": "maths", "title": "Decimal problems with money and measurement",
  "frames": [
    { "heading": "Plan before you calculate",
      "lines": [
        { "say": "A word problem is like a recipe. List what you know, then the steps.", "write": "know → plan → do → check" },
        { "say": "Write every number with its unit.", "write": "write the unit" },
        { "say": "Estimate first, so you know roughly what the answer should be.", "write": "estimate first" }
      ] },
    { "heading": "Unit price and best buy",
      "lines": [
        { "say": "Juice: 1.5 litres for 3.45, or 2 litres for 4.40. Which is better value?", "write": "1.5 L $3.45  vs  2 L $4.40",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Two juice bottles with prices", "items": [
            {"kind": "rect", "x": 120, "y": 60, "w": 90, "h": 130, "fill": "orange", "label": "1.5 L"},
            {"kind": "rect", "x": 340, "y": 30, "w": 110, "h": 160, "fill": "orange", "label": "2 L"},
            {"kind": "text", "x": 165, "y": 225, "text": "$3.45", "size": 20, "anchor": "middle"},
            {"kind": "text", "x": 395, "y": 225, "text": "$4.40", "size": 20, "anchor": "middle"}]}},
        { "say": "Unit price is price divided by amount. 3.45 divided by 1.5 is 2.30 a litre.", "write": "3.45 ÷ 1.5 = $2.30/L" },
        { "say": "4.40 divided by 2 is 2.20 a litre.", "write": "4.40 ÷ 2 = $2.20/L",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Unit prices shown; the 2 litre bottle wins", "items": [
            {"kind": "rect", "x": 120, "y": 60, "w": 90, "h": 130, "fill": "orange", "label": "1.5 L"},
            {"kind": "rect", "x": 340, "y": 30, "w": 110, "h": 160, "fill": "orange", "label": "2 L", "change": "highlight"},
            {"kind": "text", "x": 165, "y": 225, "text": "$2.30 per L", "size": 20, "anchor": "middle"},
            {"kind": "text", "x": 395, "y": 225, "text": "$2.20 per L ✓", "size": 20, "anchor": "middle", "color": "green", "change": "add"}]}},
        { "say": "The smaller unit price wins. The 2 litre bottle is the best buy.", "write": "2 L is the best buy" }
      ] },
    { "heading": "Units must match",
      "lines": [
        { "say": "Convert to one unit before you add or compare.", "write": "same unit first" },
        { "say": "1000 grams is a kilogram. 780 grams is 0.78 kilograms.", "write": "780 g = 0.78 kg" },
        { "say": "Garden edges: 2.45, 1.8 and 3.075 metres. Line up the decimal points.", "write": "2.450 + 1.800 + 3.075",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Decimals lined up with zeros filled in", "items": [
            {"kind": "text", "x": 300, "y": 50, "text": "2.45", "size": 28, "anchor": "end"},
            {"kind": "text", "x": 300, "y": 50, "text": "0", "size": 28, "anchor": "start", "color": "green", "change": "add"},
            {"kind": "text", "x": 300, "y": 95, "text": "1.8", "size": 28, "anchor": "end"},
            {"kind": "text", "x": 300, "y": 95, "text": "00", "size": 28, "anchor": "start", "color": "green", "change": "add"},
            {"kind": "text", "x": 300, "y": 140, "text": "+ 3.075", "size": 28, "anchor": "end"},
            {"kind": "line", "x": 180, "y": 158, "x2": 360, "y2": 158},
            {"kind": "text", "x": 300, "y": 200, "text": "7.325", "size": 28, "bold": true, "anchor": "end"},
            {"kind": "text", "x": 440, "y": 200, "text": "m", "size": 24}]}},
        { "say": "That's 7.325 metres. At 12.90 a metre, estimate about 91 dollars.", "write": "≈ 7 × 13 = $91" },
        { "say": "7.325 times 12.90 is 94.4925. Round to the cent: 94.49 dollars.", "write": "$94.49" }
      ] },
    { "heading": "Rounding cash",
      "lines": [
        { "say": "We have no 1 or 2 cent coins, so cash rounds to the nearest 5 cents.", "write": "cash → nearest 5c" },
        { "say": "1 2 down, 3 4 up to 5, 6 7 down to 5, 8 9 up.", "write": "1 2 ↓  3 4 → 5  6 7 → 5  8 9 ↑" },
        { "say": "Ana's total is 27.83. The 3 rounds up, so she pays 27.85.", "write": "$27.83 → $27.85" },
        { "say": "From 50 dollars, her change is 22.15.", "write": "50.00 − 27.85 = $22.15" },
        { "say": "Card payments are not rounded.", "write": "card: no rounding" }
      ] },
    { "heading": "Working backwards",
      "lines": [
        { "say": "Leo bought 3 snacks at 4.65 each, and has 6.25 left. What did he start with?", "write": "3 × $4.65, $6.25 left" },
        { "say": "He spent 3 times 4.65, which is 13.95.", "write": "spent $13.95" },
        { "say": "Undo the spending. Add it back: 6.25 plus 13.95 is 20.20.", "write": "6.25 + 13.95 = $20.20" }
      ] },
    { "heading": "Remainders that make sense",
      "lines": [
        { "say": "A 6 metre rope is cut into 0.45 metre pieces.", "write": "6 ÷ 0.45" },
        { "say": "6 divided by 0.45 is 13.33. You can only cut whole pieces, so 13.", "write": "13 full pieces",
          "draw": {"type": "shapes", "width": 560, "height": 160, "alt": "Rope cut into 13 pieces with a small piece left over", "items": [
            {"kind": "rect", "x": 20, "y": 50, "w": 507, "h": 40, "fill": "blue", "label": "13 × 0.45 = 5.85 m"},
            {"kind": "rect", "x": 527, "y": 50, "w": 13, "h": 40, "fill": "red", "change": "highlight"},
            {"kind": "text", "x": 530, "y": 130, "text": "15 cm left", "size": 18, "anchor": "end", "color": "red"}]}},
        { "say": "13 pieces use 5.85 metres. 0.15 metres, or 15 centimetres, is left.", "write": "0.15 m = 15 cm" }
      ] },
    { "heading": "Watch out for these",
      "lines": [
        { "say": "Compare unit prices, not totals.", "write": "unit price, not total" },
        { "say": "Round once, at the end. Not in the middle.", "write": "round at the end" },
        { "say": "18.47 in cash is 18.45, not 18.50. Seven rounds down to five.", "write": "$18.47 → $18.45" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Write the unit, or it didn't happen.", "write": "units every time" },
        { "say": "Unit price is price divided by amount. Smaller wins.", "write": "price ÷ amount" },
        { "say": "Backwards means opposite operations in reverse order.", "write": "reverse + opposite" },
        { "say": "Estimate first, check last.", "write": "estimate, check" }
      ] }
  ]
}

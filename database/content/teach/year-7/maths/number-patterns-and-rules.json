    {
      "heading": "Finding a position rule",
      "lines": [
        {
          "say": "5, 8, 11, 14. The difference is 3.",
          "write": "+3 each time"
        },
        {
          "say": "Three times the position gives 3, 6, 9, 12.",
          "write": "3 × position: 3, 6, 9, 12",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "Pattern: 3, 6, 9, 12",
            "items": [
              {
                "kind": "circle",
                "x": 50.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "3"
              },
              {
                "kind": "circle",
                "x": 175.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "6"
              },
              {
                "kind": "circle",
                "x": 300.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "9"
              },
              {
                "kind": "circle",
                "x": 425.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "12"
              }
            ]
          }
        },
        {
          "say": "Every term is 2 more than that. Add 2.",
          "write": "+2",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "Pattern: 5, 8, 11, 14",
            "items": [
              {
                "kind": "circle",
                "x": 50.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "change": "add",
                "label": "5"
              },
              {
                "kind": "circle",
                "x": 175.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "change": "add",
                "label": "8"
              },
              {
                "kind": "circle",
                "x": 300.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "change": "add",
                "label": "11"
              },
              {
                "kind": "circle",
                "x": 425.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "change": "add",
                "label": "14"
              }
            ]
          }
        },
        {
          "say": "So the rule is term equals 3 times position plus 2.",
          "write": "term = 3 × position + 2"
        },
        {
          "say": "Term 20 is 3 times 20 plus 2, which is 62.",
          "write": "3 × 20 + 2 = 62"
        },
        {
          "say": "Find the jump, then the bump.",
          "write": "jump, then bump"
        }
      ]
    },
    {
      "heading": "Matchstick triangles",
      "lines": [
        {
          "say": "One triangle uses 3 matches. Two use 5. Three use 7.",
          "diagram": "diagrams/y7/maths/number-patterns-and-rules-triangles.svg",
          "alt": "Matchstick triangles: 3, 5, 7 matches"
        },
        {
          "say": "Each new triangle needs 2 more matches.",
          "write": "3, 5, 7: +2"
        },
        {
          "say": "Two times position, plus 1.",
          "write": "matches = 2 × position + 1"
        },
        {
          "say": "Ten triangles: 2 times 10 plus 1 is 21 matches.",
          "write": "2 × 10 + 1 = 21"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "1, 2, 4 could be add 1, add 2, or times 2. Check every term.",
          "write": "check every term"
        },
        {
          "say": "For 5, 9, 13, 17 the rule is not just 4 times position.",
          "write": "term = 4 × position + 1"
        },
        {
          "say": "Term 10 is 9 jumps after term 1, not 10.",
          "write": "9 jumps"
        },
        {
          "say": "Put position 1 in your rule. You must get the first term.",
          "write": "position 1 → first term"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Find the difference by subtracting.",
          "write": "difference"
        },
        {
          "say": "Rule: difference times position, then adjust.",
          "write": "jump × position + bump"
        },
        {
          "say": "Growing gaps? Try multiplying.",
          "write": "× pattern"
        },
        {
          "say": "Check your rule with position 1.",
          "write": "check ✓"
        }
      ]
    }
  ]

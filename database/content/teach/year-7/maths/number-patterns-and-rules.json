  "title": "Number patterns and rules",
  "frames": [
    {
      "heading": "Terms and rules",
      "lines": [
        {
          "say": "Each number in a pattern is a term.",
          "write": "3, 7, 11, 15, …",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "Pattern: 3, 7, 11, 15",
            "items": [
              {
                "kind": "circle",
                "x": 50.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "3"
              },
              {
                "kind": "circle",
                "x": 175.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "7"
              },
              {
                "kind": "circle",
                "x": 300.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "11"
              },
              {
                "kind": "circle",
                "x": 425.0,
                "y": 90,
                "r": 32,
                "fill": "blue",
                "label": "15"
              }
            ]
          }
        },
        {
          "say": "Its position is where it sits. 3 is term 1.",
          "write": "term 1, term 2, term 3"
        },
        {
          "say": "A next-term rule says how to get to the next one.",
          "write": "start at 3, add 4"
        },
        {
          "say": "A position rule gets a term straight from its position.",
          "write": "term = 4 × position − 1"
        }
      ]
    },

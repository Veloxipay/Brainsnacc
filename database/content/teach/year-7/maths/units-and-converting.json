{
  "level": "Year 7",
  "subject": "maths",
  "title": "Units and converting",
  "frames": [
    {
      "heading": "Metric units",
      "lines": [
        {
          "say": "Swap a 10 dollar note for coins. More pieces, each worth less.",
          "write": "$10 = ten $1 coins"
        },
        {
          "say": "Converting units works the same way. The amount never changes.",
          "write": "same amount"
        },
        {
          "say": "Milli means a thousandth. Centi means a hundredth. Kilo means a thousand.",
          "write": "milli · centi · kilo"
        },
        {
          "say": "On a ruler, each centimetre is split into 10 millimetres.",
          "write": "1 cm = 10 mm",
          "diagram": "diagrams/y7/maths/units-and-converting-ruler.svg",
          "alt": "Ruler showing 1 cm split into 10 mm"
        }
      ]
    },
    {
      "heading": "Length, mass and capacity",
      "lines": [
        {
          "say": "Length: 1 metre is 100 centimetres. 1 kilometre is 1000 metres.",
          "write": "1 m = 100 cm   1 km = 1000 m"
        },
        {
          "say": "Mass: 1 kilogram is 1000 grams. 1 tonne is 1000 kilograms.",
          "write": "1 kg = 1000 g   1 t = 1000 kg"
        },
        {
          "say": "Capacity: 1 litre is 1000 millilitres.",
          "write": "1 L = 1000 mL"
        },
        {
          "say": "Only centimetres use 100 and 10. Most others use 1000.",
          "write": "cm: 100 and 10"
        }
      ]
    },

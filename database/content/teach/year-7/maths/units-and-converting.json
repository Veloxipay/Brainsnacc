    {
      "heading": "Sensible units",
      "lines": [
        {
          "say": "Pick a unit that gives a number easy to picture.",
          "write": "easy to picture"
        },
        {
          "say": "A pencil is about 18 centimetres, not 0.00018 kilometres.",
          "write": "pencil ≈ 18 cm"
        },
        {
          "say": "Melbourne to Ballarat is kilometres. Medicine is millilitres.",
          "write": "km · kg · mL"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Multiplying when you should divide. Check: bigger unit, smaller number.",
          "write": "✗ wrong way"
        },
        {
          "say": "1 metre is 100 centimetres, not 1000.",
          "write": "1 m = 100 cm"
        },
        {
          "say": "2 metres plus 30 centimetres is not 32. Convert first.",
          "write": "2 m + 30 cm = 230 cm"
        },
        {
          "say": "Count the zeros. 100 has two, so move two places.",
          "write": "100 → 2 places"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Big to small, multiply. Small to big, divide.",
          "write": "big→small ×   small→big ÷"
        },
        {
          "say": "Milli is a thousandth. Centi is a hundredth. Kilo is a thousand.",
          "write": "m · c · k"
        },
        {
          "say": "Same units before you add.",
          "write": "same units first"
        }
      ]
    }

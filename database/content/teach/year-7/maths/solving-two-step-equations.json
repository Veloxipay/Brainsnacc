{
  "level": "Year 7",
  "subject": "maths",
  "title": "Solving two-step equations",
  "frames": [
    {
      "heading": "What is a two-step equation?",
      "lines": [
        {
          "say": "Here is an equation.",
          "write": "4x + 7 = 35",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 7
            },
            "right": {
              "cubes": 35
            }
          }
        },
        {
          "say": "Two things have been done to x.",
          "write": "x  →  × 4  →  + 7  →  35"
        },
        {
          "say": "First x was multiplied by 4.",
          "write": "× 4"
        },
        {
          "say": "Then 7 was added.",
          "write": "+ 7"
        },
        {
          "say": "Two things done to x. So we call it a two-step equation."
        },
        {
          "say": "Our job is to find x. We do it by undoing those two steps."
        }
      ]
    },
    {
      "heading": "The balance rule",
      "lines": [
        {
          "say": "Think of an equation as a balance scale. 4 bags and 7 cubes on the left. 35 cubes on the right.",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 7
            },
            "right": {
              "cubes": 35
            }
          }
        },
        {
          "say": "Both sides weigh the same. That's why we write an equals sign.",
          "write": "4x + 7 = 35"
        },
        {
          "say": "Watch. If we take 7 cubes off just one side, it tips.",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 7
            },
            "right": {
              "cubes": 35
            },
            "remove": 7,
            "removeFrom": "left",
            "tip": "right",
            "labels": [
              "4x + 7 − 7",
              "35"
            ]
          }
        },
        {
          "say": "So whatever you do to one side, do it to the other side too.",
          "write": "Same to BOTH sides"
        },
        {
          "say": "Now take 7 cubes off both sides. It stays level.",
          "write": "4x + 7 − 7 = 35 − 7",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 7
            },
            "right": {
              "cubes": 35
            },
            "remove": 7,
            "labels": [
              "4x + 7 − 7",
              "35 − 7"
            ]
          }
        },
        {
          "say": "Now 4 bags balance 28 cubes.",
          "write": "4x = 28",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4
            },
            "right": {
              "cubes": 28
            }
          }
        },
        {
          "say": "Share the 28 cubes between the 4 bags. Each bag gets 7.",
          "write": "x = 7",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4
            },
            "right": {
              "cubes": 28
            },
            "share": true
          }
        }
      ]
    },
    {
      "heading": "Which step first?",
      "lines": [
        {
          "say": "Undo the steps in reverse order. Last thing done, first thing undone."
        },
        {
          "say": "Step 1. Get rid of the number that is added or subtracted.",
          "write": "Step 1:  undo + or −"
        },
        {
          "say": "Step 2. Get rid of the number that multiplies or divides x.",
          "write": "Step 2:  undo × or ÷"
        },
        {
          "say": "Plus or minus first. Times or divide second.",
          "write": "± first, then × ÷"
        }
      ]
    },
    {
      "heading": "Setting it out",
      "lines": [
        {
          "say": "Here's a new one. 6 bags, and 11 taken away. That balances 13.",
          "write": "6x − 11 = 13",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 6,
              "cubes": -11
            },
            "right": {
              "cubes": 13
            }
          }
        },
        {
          "say": "The red cubes are minus 11. To undo minus 11, add 11 to both sides.",
          "write": "6x − 11 + 11 = 13 + 11",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 6,
              "cubes": -11
            },
            "right": {
              "cubes": 13
            },
            "remove": 11,
            "removeFrom": "left",
            "add": 11,
            "addTo": "right",
            "labels": [
              "6x − 11 + 11",
              "13 + 11"
            ]
          }
        },
        {
          "say": "Plus 11 cancels the minus 11. The right side grows to 24.",
          "write": "6x = 24",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 6
            },
            "right": {
              "cubes": 24
            }
          }
        },
        {
          "say": "6 bags balance 24. Share 24 between 6 bags.",
          "write": "6x ÷ 6 = 24 ÷ 6",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 6
            },
            "right": {
              "cubes": 24
            },
            "share": true
          }
        },
        {
          "say": "Each bag gets 4. So x equals 4.",
          "write": "x = 4"
        },
        {
          "say": "Now check. Put 4 back into the first equation.",
          "write": "6 × 4 − 11 = 24 − 11 = 13 ✓"
        },
        {
          "say": "One step per line. Keep the equals signs lined up."
        }
      ]
    },
    {
      "heading": "Answers can be negative",
      "lines": [
        {
          "say": "Same steps, even when the numbers look odd.",
          "write": "3x + 14 = 2",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 3,
              "cubes": 14
            },
            "right": {
              "cubes": 2
            }
          }
        },
        {
          "say": "Take 14 from both sides. On a number line, start at 2 and go back 14.",
          "write": "2 − 14 = −12",
          "draw": {
            "type": "numberline",
            "from": -14,
            "to": 4,
            "start": 2,
            "jump": -14
          }
        },
        {
          "say": "So 3 bags balance minus 12. The red cubes are minus.",
          "write": "3x = −12",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 3
            },
            "right": {
              "cubes": -12
            }
          }
        },
        {
          "say": "Share minus 12 between 3 bags. Each gets minus 4.",
          "write": "x = −4",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 3
            },
            "right": {
              "cubes": -12
            },
            "share": true
          }
        },
        {
          "say": "Check it.",
          "write": "3 × (−4) + 14 = −12 + 14 = 2 ✓"
        }
      ]
    },
    {
      "heading": "When x is divided",
      "lines": [
        {
          "say": "Here x is divided by 5, then 2 is added.",
          "write": "x/5 + 2 = 9"
        },
        {
          "say": "Plus 2 first. Take 2 from both sides.",
          "write": "x/5 = 7"
        },
        {
          "say": "Divided by 5. Undo it by multiplying both sides by 5.",
          "write": "x = 35"
        },
        {
          "say": "Watch the brackets. In this one, all of x plus 4 is divided by 3.",
          "write": "(x + 4)/3 = 6"
        },
        {
          "say": "So undo the divide first. Times both sides by 3.",
          "write": "x + 4 = 18"
        },
        {
          "say": "Then take 4 from both sides.",
          "write": "x = 14"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't divide first. Undo the plus or minus first.",
          "write": "✗  4x + 7 = 35  →  x + 7 = 8.75"
        },
        {
          "say": "Don't change just one side. Say both sides out loud.",
          "write": "✗  4x = 35",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 7
            },
            "right": {
              "cubes": 35
            },
            "remove": 7,
            "removeFrom": "left",
            "tip": "right",
            "labels": [
              "4x + 7 − 7",
              "35"
            ]
          }
        },
        {
          "say": "To undo minus 11, add 11. Not take away.",
          "write": "− 11  →  + 11"
        },
        {
          "say": "Careful with negatives. 2 take away 14 is minus 12, not 12.",
          "write": "2 − 14 = −12",
          "draw": {
            "type": "numberline",
            "from": -14,
            "to": 4,
            "start": 2,
            "jump": -14
          }
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Same to both sides.",
          "write": "Same to BOTH sides"
        },
        {
          "say": "Plus or minus first, times or divide second.",
          "write": "± first, then × ÷"
        },
        {
          "say": "One step per line, with the equals signs lined up.",
          "write": "one step per line"
        },
        {
          "say": "Always check your answer in the first equation.",
          "write": "Check ✓"
        }
      ]
    }
  ]
}
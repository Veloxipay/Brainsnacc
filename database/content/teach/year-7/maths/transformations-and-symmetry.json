{
  "level": "Year 7",
  "subject": "maths",
  "title": "Transformations and symmetry",
  "frames": [
    {
      "heading": "Slide, flip, spin",
      "lines": [
        {
          "say": "A transformation moves a shape to a new position.",
          "write": "transformation"
        },
        {
          "say": "Think of a sticker. You can slide it, flip it or spin it.",
          "write": "slide · flip · spin"
        },
        {
          "say": "The starting shape is the object. The new one is the image.",
          "write": "object → image"
        },
        {
          "say": "Image points get a dash. A becomes A dash.",
          "write": "A → A′"
        },
        {
          "say": "Size and angles stay the same. The image is congruent.",
          "write": "congruent = same size and shape"
        }
      ]
    },

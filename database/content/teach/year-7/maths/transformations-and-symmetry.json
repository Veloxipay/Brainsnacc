      "heading": "Rotational symmetry",
      "lines": [
        {
          "say": "Does the shape fit onto itself more than once in a full turn?",
          "write": "rotational symmetry"
        },
        {
          "say": "The order is how many times it fits in 360 degrees.",
          "write": "order = times it fits"
        },
        {
          "say": "A square has order 4. A rectangle has order 2.",
          "write": "square 4   rectangle 2"
        },
        {
          "say": "A hexagon has order 6. Smallest turn is 360 divided by 6, 60 degrees.",
          "write": "360° ÷ 6 = 60°"
        },
        {
          "say": "A shape that fits only once has order 1. Never order 0.",
          "write": "order 1 = none"
        }
      ]
    },

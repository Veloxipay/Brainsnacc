    {
      "heading": "Finding the overlap",
      "lines": [
        {
          "say": "40 students. 22 have a dog, 17 have a cat, 6 have neither.",
          "write": "ξ = 40",
          "diagram": "diagrams/y7/maths-advanced/venn-diagrams-and-two-way-tables-pets.svg",
          "alt": "Venn diagram: dog only 22 − x, both x, cat only 17 − x, neither 6"
        },
        {
          "say": "Call the overlap x. Then dog only is 22 minus x.",
          "write": "dog only = 22 − x"
        },
        {
          "say": "Cat only is 17 minus x. All four regions add to 40.",
          "write": "(22 − x) + x + (17 − x) + 6 = 40"
        },
        {
          "say": "That simplifies to 45 minus x equals 40. So x is 5.",
          "write": "45 − x = 40, x = 5"
        },
        {
          "say": "Check: 17, 5, 12 and 6 add to 40.",
          "write": "17 + 5 + 12 + 6 = 40 ✓"
        }
      ]

    {
      "heading": "Square numbers",
      "lines": [
        {
          "say": "How many factors does 36 have? List the pairs.",
          "write": "1×36  2×18  3×12  4×9  6×6"
        },
        {
          "say": "Six times 6 uses the same number twice. Count 6 only once.",
          "write": "6 × 6 → just 6"
        },
        {
          "say": "So 36 has 9 factors.",
          "write": "36 has 9 factors"
        }
      ]
    },
    {
      "heading": "Multiples",
      "lines": [
        {
          "say": "A multiple is the number times 1, 2, 3, and so on.",
          "write": "multiples of 7"
        },
        {
          "say": "Multiples of 7. Start at zero, jump 7.",
          "draw": {
            "type": "numberline",
            "from": 0,
            "to": 35,
            "start": 0,
            "jump": 7
          }
        },
        {
          "say": "Keep jumping. 7, 14, 21, 28, 35, and on forever.",
          "write": "7, 14, 21, 28, 35 …",
          "diagram": "diagrams/y7/maths/factors-and-multiples-sevens.svg",
          "alt": "Jumps of 7 on a number line"
        },
        {
          "say": "Linked: 4 is a factor of 20, so 20 is a multiple of 4.",
          "write": "4 fits 20 ↔ 20 is a multiple of 4"
        }
      ]
    },
    {
      "heading": "Divisibility tests",
      "lines": [
        {
          "say": "A divisibility test is a shortcut. No full division needed.",
          "write": "divisibility tests"
        },
        {
          "say": "By 2, the last digit is even. By 5, it ends in 0 or 5.",
          "write": "2: even end   5: ends 0 or 5"
        },
        {
          "say": "By 3, the digits add to a multiple of 3. Same idea for 9.",
          "write": "3 and 9: digit sum"
        },
        {
          "say": "Try 2145. The digit sum is 2 plus 1 plus 4 plus 5, which is 12.",
          "write": "2 + 1 + 4 + 5 = 12"
        },
        {
          "say": "Twelve is a multiple of 3. So 2145 is divisible by 3.",
          "write": "2145 ÷ 3 = 715 ✓"
        },
        {
          "say": "It ends in 5, so it divides by 5. Twelve is not a multiple of 9.",
          "write": "÷ 5 ✓   ÷ 9 ✗"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Factors are few and fit in. Multiples are many.",
          "write": "factors few, multiples many"
        },
        {
          "say": "Don't forget 1 and the number itself.",
          "write": "start with 1 × n"
        },
        {
          "say": "For square numbers, write the repeated factor once.",
          "write": "6 × 6 → 6 once"
        },
        {
          "say": "Ending in 3 doesn't mean divisible by 3. Try 13. Add the digits.",
          "write": "✗ 13 ÷ 3"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Factors fit, multiples multiply.",
          "write": "Factors Fit, Multiples Multiply"
        },
        {
          "say": "Find factors in pairs. Stop when they meet.",
          "write": "pairs until they meet"
        },
        {
          "say": "Use the digit sum to test for 3 and 9.",
          "write": "digit sum → 3, 9"

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Factors and multiples",
  "frames": [
    {
      "heading": "What is a factor?",
      "lines": [
        {
          "say": "A factor divides into a number exactly, with no remainder.",
          "write": "factor: divides exactly"
        },
        {
          "say": "Three is a factor of 18, because 18 divided by 3 is 6 exactly.",
          "write": "18 ÷ 3 = 6 ✓"
        },
        {
          "say": "Set out 12 chairs in equal rows. Each way gives a factor pair.",
          "diagram": "diagrams/y7/maths/factors-and-multiples-arrays.svg",
          "alt": "12 chairs as 1 by 12, 2 by 6 and 3 by 4"
        },
        {
          "say": "One times 12, 2 times 6, 3 times 4. All make 12.",
          "write": "1 × 12   2 × 6   3 × 4"
        },
        {
          "say": "Every number has 1 and itself as factors.",
          "write": "1 and itself"
        }
      ]
    },

    {
      "heading": "Statistics",
      "lines": [
        {
          "say": "Scores 4, 7, 7, 9 and 13. They add to 40.",
          "write": "4 + 7 + 7 + 9 + 13 = 40",
          "diagram": "diagrams/y7/maths/year-7-maths-challenge-scores.svg",
          "alt": "Dot plot of 4, 7, 7, 9 and 13"
        },
        {
          "say": "Mean is 40 divided by 5, which is 8. The median and mode are 7.",
          "write": "mean 8   median 7   mode 7"
        },
        {
          "say": "Range is 13 minus 4, which is 9.",
          "write": "range = 9"
        },
        {
          "say": "A sixth score makes the mean 9. Six scores must add to 54.",
          "write": "6 × 9 = 54"
        },
        {
          "say": "54 minus 40 is 14. The sixth score is 14.",
          "write": "54 − 40 = 14"
        }
      ]
    },
    {
      "heading": "Challenge tips",
      "lines": [
        {
          "say": "Units in, units out. Area is square units, volume is cubic units.",
          "write": "m², cm³"
        },
        {
          "say": "Check equations by substituting back in. It takes ten seconds.",
          "write": "substitute back ✓"
        },
        {
          "say": "Two signs together. Same signs make plus. So minus minus 3 is plus 3.",
          "write": "−(−3) = +3"
        },
        {
          "say": "If you remember one thing, BIDMAS.",
          "write": "B I D M A S"
        }
      ]
    }

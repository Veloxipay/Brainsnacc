      "heading": "How to use this challenge",
      "lines": [
        {
          "say": "This is a mixed test covering the whole year. Any topic can come up.",
          "write": "whole year, mixed"
        },
        {
          "say": "Give yourself 45 minutes. No calculator. Phone away.",
          "write": "45 min · no calculator"
        },
        {
          "say": "Short answers first, then 20 multiple choice, from Easy to Challenge.",
          "write": "short answer → 20 MC"
        },
        {
          "say": "80 per cent or more is excellent. Under 60, go back to those lessons.",
          "write": "80%+ excellent"
        }
      ]
    },

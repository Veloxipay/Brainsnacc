    {
      "heading": "Reflex angles",
      "lines": [
        {
          "say": "Two arms always make two angles. Together they make 360 degrees.",
          "write": "together = 360°"
        },
        {
          "say": "Here the obtuse angle is 130 degrees.",
          "diagram": "diagrams/y7/maths/measuring-and-classifying-angles-ex2.svg",
          "alt": "130 degree angle with reflex angle marked"
        },
        {
          "say": "The reflex angle on the other side is 360 minus 130.",
          "write": "360° − 130° = 230°"
        },
        {
          "say": "To measure a reflex angle, measure the small side, then subtract from 360."
        }
      ]
    },
    {
      "heading": "Angles on a clock",
      "lines": [
        {
          "say": "A clock is a full turn split into 12 gaps.",
          "write": "360° ÷ 12 = 30°"
        },
        {
          "say": "At 5 o'clock, there are 5 gaps between the hands.",
          "diagram": "diagrams/y7/maths/measuring-and-classifying-angles-ex3.svg",
          "alt": "Clock at 5 o’clock"
        },
        {
          "say": "Five times 30 is 150 degrees. That is obtuse.",
          "write": "5 × 30° = 150°"
        },
        {
          "say": "Three hours is a right angle. Six hours is a straight line.",
          "write": "3 h = 90°   6 h = 180°"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Every mark has two numbers. Use the scale that starts at zero.",
          "write": "60 or 120?",
          "diagram": "diagrams/y7/maths/measuring-and-classifying-angles-ex4.svg",
          "alt": "Protractor reading 120 on the inner scale"
        },
        {
          "say": "This arm starts on the inner zero. Read the inner number, 120.",
          "write": "120°"
        },
        {
          "say": "Obtuse stops before 180. Reflex goes past it.",
          "write": "obtuse < 180° < reflex"
        },
        {
          "say": "At 3:30 the hour hand is halfway between 3 and 4.",
          "write": "hour hand moves too"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "An angle is the turn between the arms.",
          "write": "turn, not arm length"
        },
        {
          "say": "The vertex letter goes in the middle.",
          "write": "∠ABC: vertex B"
        },
        {
          "say": "Acute, right, obtuse, straight, reflex, revolution.",
          "write": "A R O S R R"
        },
        {
          "say": "One hour gap on a clock is 30 degrees.",
          "write": "1 hour = 30°"
        }
      ]
    }
  ]

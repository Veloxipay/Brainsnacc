    {
      "heading": "Using a protractor",
      "lines": [
        {
          "say": "Put the centre of the protractor exactly on the vertex.",
          "write": "centre on vertex"
        },
        {
          "say": "Line up the zero line with one arm.",
          "write": "zero line on an arm"
        },
        {
          "say": "Find the scale that starts at zero on that arm.",
          "write": "inner or outer?"
        },
        {
          "say": "Follow that scale round to the other arm. Here it reads 70.",
          "write": "70°",
          "diagram": "diagrams/y7/maths/measuring-and-classifying-angles-protractor.svg",
          "alt": "Protractor reading 70 on the inner scale"
        },
        {
          "say": "Ask: smaller or bigger than a right angle? That tells you which number.",
          "write": "smaller or bigger than 90°?"
        }
      ]

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Terminating and recurring decimals",
  "frames": [
    {
      "heading": "Fraction to decimal",
      "lines": [
        {
          "say": "The fraction bar means divide. 3 over 8 is 3 divided by 8.",
          "write": "3/8 = 3 ÷ 8"
        },
        {
          "say": "Share 3 pizzas between 8 people. The sharing ends neatly.",
          "write": "3/8 = 0.375"
        },
        {
          "say": "Share 2 pizzas between 3. There's always a bit left over.",
          "write": "2/3 = 0.666…"
        },
        {
          "say": "Some decimals stop. Some go on forever.",
          "write": "stop  or  forever?"
        }
      ]
    },
    {
      "heading": "Terminating decimals",
      "lines": [
        {
          "say": "Divide 3 by 8. Write 3 as 3.000.",
          "write": "3 ÷ 8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Division steps",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 40,
                "w": 260,
                "h": 48,
                "fill": "white",
                "label": "30 ÷ 8 = 3 r 6"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 72,
                "text": "0.3",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "30 divided by 8 is 3, remainder 6. Then 60 divided by 8 is 7, remainder 4.",
          "write": "0.37",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Division steps",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 40,
                "w": 260,
                "h": 48,
                "fill": "white",
                "label": "30 ÷ 8 = 3 r 6"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 72,
                "text": "0.3",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 100,
                "w": 260,
                "h": 48,
                "fill": "yellow",
                "label": "60 ÷ 8 = 7 r 4",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 132,
                "text": "0.37",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "40 divided by 8 is 5, remainder 0. The remainder is 0, so stop.",
          "write": "3/8 = 0.375",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Division steps",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 40,
                "w": 260,
                "h": 48,
                "fill": "white",
                "label": "30 ÷ 8 = 3 r 6"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 72,
                "text": "0.3",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 100,
                "w": 260,
                "h": 48,
                "fill": "white",
                "label": "60 ÷ 8 = 7 r 4"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 132,
                "text": "0.37",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 160,
                "w": 260,
                "h": 48,
                "fill": "yellow",
                "label": "40 ÷ 8 = 5 r 0",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 192,
                "text": "0.375 stop",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "A decimal that stops is called terminating.",
          "write": "terminating = stops"
        }
      ]
    },
    {
      "heading": "Recurring decimals",
      "lines": [
        {
          "say": "Now 5 over 11. 50 divided by 11 is 4, remainder 6.",
          "write": "0.4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Division steps",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 40,
                "w": 260,
                "h": 48,
                "fill": "white",
                "label": "50 ÷ 11 = 4 r 6"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 72,
                "text": "0.4",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "60 divided by 11 is 5, remainder 5.",
          "write": "0.45",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Division steps",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 40,
                "w": 260,
                "h": 48,
                "fill": "white",
                "label": "50 ÷ 11 = 4 r 6"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 72,
                "text": "0.4",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 100,
                "w": 260,
                "h": 48,
                "fill": "yellow",
                "label": "60 ÷ 11 = 5 r 5",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 132,
                "text": "0.45",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "50 divided by 11 again. The same remainder came back.",
          "write": "0.454…",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Division steps",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 40,
                "w": 260,
                "h": 48,
                "fill": "yellow",
                "label": "50 ÷ 11 = 4 r 6",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 72,
                "text": "0.4",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 100,
                "w": 260,
                "h": 48,
                "fill": "white",
                "label": "60 ÷ 11 = 5 r 5"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 132,
                "text": "0.45",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 160,
                "w": 260,
                "h": 48,
                "fill": "yellow",
                "label": "50 ÷ 11 = 4 r 6",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 192,
                "text": "0.454…",
                "size": 22,
                "color": "purple",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "So the digits repeat forever. That's a recurring decimal.",
          "write": "5/11 = 0.4545…"
        },
        {
          "say": "When a remainder repeats, the digits repeat too.",
          "write": "remainder repeats → digits repeat"
        }
      ]
    },
    {
      "heading": "Dot notation",
      "lines": [
        {
          "say": "Put a dot over the repeating part instead of dots at the end.",
          "write": "0.666… = 0.6̇"
        },
        {
          "say": "For a repeating group, dot the first and last digit.",
          "write": "0.4545… = 0.4̇5̇"
        },
        {
          "say": "In 1 over 6, only the 6 repeats. So only the 6 gets a dot.",
          "write": "1/6 = 0.1666… = 0.16̇",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "0.16 with a dot over the 6",
            "items": [
              {
                "kind": "text",
                "x": 262,
                "y": 110,
                "text": "0.1",
                "size": 56,
                "color": "black",
                "anchor": "end",
                "bold": true
              },
              {
                "kind": "text",
                "x": 264,
                "y": 110,
                "text": "6",
                "size": 56,
                "color": "red",
                "anchor": "start",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 52,
                "r": 6,
                "fill": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "only the 6 repeats",
                "size": 22,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Some books use a bar instead of dots. Same meaning.",
          "write": "bar = dots"
        }
      ]
    },
    {
      "heading": "Which fractions terminate?",
      "lines": [
        {
          "say": "First simplify. Then find the prime factors of the denominator.",
          "write": "simplify, then factorise"
        },
        {
          "say": "Only 2s and 5s? It terminates, because 10 is 2 times 5.",
          "write": "only 2s and 5s → stops"
        },
        {
          "say": "7 over 20. 20 is 2 times 2 times 5. It terminates.",
          "write": "20 = 2 × 2 × 5 ✓"
        },
        {
          "say": "5 over 12. 12 is 2 times 2 times 3. The 3 makes it recur.",
          "write": "12 = 2 × 2 × 3 → recurs",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Prime factors of 12 with the 3 highlighted",
            "items": [
              {
                "kind": "circle",
                "x": 140,
                "y": 90,
                "r": 34,
                "fill": "white",
                "label": "2"
              },
              {
                "kind": "circle",
                "x": 240,
                "y": 90,
                "r": 34,
                "fill": "white",
                "label": "2"
              },
              {
                "kind": "circle",
                "x": 340,
                "y": 90,
                "r": 34,
                "fill": "red",
                "label": "3",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 180,
                "text": "a 3 → recurring",
                "size": 26,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "9 over 15 simplifies to 3 over 5. That terminates. 0.6.",
          "write": "9/15 = 3/5 = 0.6"
        }
      ]
    },
    {
      "heading": "Rounding recurring decimals",
      "lines": [
        {
          "say": "2 over 3 is 0.666 and so on. Round it to two places.",
          "write": "2/3 = 0.666…"
        },
        {
          "say": "It's past the halfway mark, 0.665. So it rounds up.",
          "write": "≈ 0.67",
          "diagram": "diagrams/y7/maths/terminating-and-recurring-decimals-round.svg",
          "alt": "Number line from 0.66 to 0.67 with 0.666 past halfway"
        },
        {
          "say": "0.33 is only close to one third. One third is a tiny bit bigger.",
          "write": "0.33 ≈ 1/3"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Dot only the digits that repeat.",
          "write": "✗ 0.1̇6̇   ✓ 0.16̇"
        },
        {
          "say": "Divide top by bottom. 3 over 5 is 3 divided by 5.",
          "write": "top ÷ bottom"
        },
        {
          "say": "Simplify first. 21 over 28 is 3 over 4, which is 0.75.",
          "write": "21/28 = 3/4 = 0.75"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Only 2s and 5s get to stop.",
          "write": "2s and 5s → terminate"
        },
        {
          "say": "Watch the remainders. When one repeats, the digits repeat.",
          "write": "watch remainders"
        },
        {
          "say": "One third is 0.3 recurring. One eighth is 0.125.",
          "write": "1/3 = 0.3̇   1/8 = 0.125"
        },
        {
          "say": "Ninths are easy. 2 ninths is 0.2 recurring.",
          "write": "2/9 = 0.2̇"
        }
      ]
    }
  ]
}

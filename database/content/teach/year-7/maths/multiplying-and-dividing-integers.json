    {
      "heading": "More than two numbers",
      "lines": [
        {
          "say": "Minus 2 times 5 times minus 3. The size is 30.",
          "write": "2 × 5 × 3 = 30"
        },
        {
          "say": "Count the negatives. There are two. That is even.",
          "write": "2 negatives → even"
        },
        {
          "say": "Even number of negatives, positive answer.",
          "write": "(−2) × 5 × (−3) = 30"
        },
        {
          "say": "Odd number of negatives gives a negative answer.",
          "write": "odd → −"
        },
        {
          "say": "Minus 5 squared is minus 5 times minus 5. That is 25.",
          "write": "(−5)² = 25"
        },
        {
          "say": "Minus 2 cubed has three negatives. That is minus 8.",
          "write": "(−2)³ = −8"
        }
      ]
    },
    {
      "heading": "A freezer",
      "lines": [
        {
          "say": "A freezer drops 3 degrees every hour. A drop is minus 3.",
          "write": "−3 each hour"
        },
        {
          "say": "Four hours of this is 4 times minus 3.",
          "write": "4 × (−3)",
          "draw": {
            "type": "numberline",
            "from": -14,
            "to": 2,
            "start": 0,
            "jump": -12
          }
        },
        {
          "say": "Different signs, so negative. The change is minus 12 degrees.",
          "write": "4 × (−3) = −12",
          "diagram": "diagrams/y7/maths/multiplying-and-dividing-integers-ex4.svg",
          "alt": "Four jumps of minus 3 from 0 to minus 12"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Adding two negatives goes further down. Multiplying them is positive.",
          "write": "−7 + (−6) = −13"
        },
        {
          "say": "Minus 7 times minus 6 is positive 42.",
          "write": "(−7) × (−6) = 42"
        },
        {
          "say": "Don't forget the sign. Minus 36 divided by 9 is minus 4.",
          "write": "(−36) ÷ 9 = −4"
        },
        {
          "say": "Minus 5 squared is 25, not minus 25.",
          "write": "(−5)² = 25"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Same signs smile. Different signs frown.",
          "write": "same +, different −"
        },
        {
          "say": "Size first, sign second.",
          "write": "size, then sign"
        },
        {
          "say": "Count the negatives. Even is positive, odd is negative.",
          "write": "even +, odd −"
        },
        {
          "say": "Check a division by multiplying back.",
          "write": "8 × (−6) = −48 ✓"
        }
      ]
    }
  ]

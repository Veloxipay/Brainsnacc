    {
      "heading": "The sign rules",
      "lines": [
        {
          "say": "Same signs give a positive answer.",
          "write": "same signs → +"
        },
        {
          "say": "Different signs give a negative answer.",
          "write": "different signs → −"
        },
        {
          "say": "The same rules work for dividing.",
          "write": "× and ÷"
        },
        {
          "say": "Two steps. Size first, then sign.",
          "write": "size first, sign second"
        }
      ]
    },

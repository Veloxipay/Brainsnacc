{
  "level": "Year 7", "subject": "maths", "title": "Comparing data sets",
  "frames": [
    { "heading": "Centre and spread",
      "lines": [
        { "say": "Bus A usually takes 20 minutes, but sometimes 10, sometimes 40.", "write": "Bus A: 10 to 40 min" },
        { "say": "Bus B takes about 22, never more than 2 minutes off. You can rely on it.", "write": "Bus B: about 22 min" },
        { "say": "So compare the typical value, the centre, and how much it varies, the spread.", "write": "centre AND spread" },
        { "say": "Centre is the mean, median or mode. Spread here is the range.", "write": "range = highest − lowest" }
      ] },
    { "heading": "Same centre, different spread",
      "lines": [
        { "say": "Mia and Zara each played 7 basketball games. Here are Mia's points.", "write": "Mia: 13 to 17",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Mia's dots bunched between 13 and 17", "items": [
            {"kind": "line", "x": 40, "y": 150, "x2": 520, "y2": 150},
            {"kind": "text", "x": 40, "y": 180, "text": "5", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 280, "y": 180, "text": "15", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 520, "y": 180, "text": "25", "size": 16, "anchor": "middle"},
            {"kind": "circle", "x": 232, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 256, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 280, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 280, "y": 115, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 280, "y": 95, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 304, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 328, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "text", "x": 60, "y": 60, "text": "Mia", "size": 20, "bold": true}]}},
        { "say": "Now add Zara on the same scale. Her dots are spread right out.", "write": "Zara: 6 to 24",
          "draw": {"type": "shapes", "width": 560, "height": 320, "alt": "Parallel dot plots: Mia bunched, Zara spread out", "items": [
            {"kind": "line", "x": 40, "y": 150, "x2": 520, "y2": 150},
            {"kind": "circle", "x": 232, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 256, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 280, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 280, "y": 115, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 280, "y": 95, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 304, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "circle", "x": 328, "y": 135, "r": 9, "fill": "blue"},
            {"kind": "text", "x": 60, "y": 60, "text": "Mia", "size": 20, "bold": true},
            {"kind": "line", "x": 40, "y": 290, "x2": 520, "y2": 290},
            {"kind": "text", "x": 60, "y": 210, "text": "Zara", "size": 20, "bold": true, "change": "add"},
            {"kind": "circle", "x": 64, "y": 275, "r": 9, "fill": "orange", "change": "add"},
            {"kind": "circle", "x": 112, "y": 275, "r": 9, "fill": "orange", "change": "add"},
            {"kind": "circle", "x": 136, "y": 275, "r": 9, "fill": "orange", "change": "add"},
            {"kind": "circle", "x": 280, "y": 275, "r": 9, "fill": "orange", "change": "add"},
            {"kind": "circle", "x": 424, "y": 275, "r": 9, "fill": "orange", "change": "add"},
            {"kind": "circle", "x": 448, "y": 275, "r": 9, "fill": "orange", "change": "add"},
            {"kind": "circle", "x": 496, "y": 275, "r": 9, "fill": "orange", "change": "add"},
            {"kind": "text", "x": 40, "y": 312, "text": "5", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 280, "y": 312, "text": "15", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 520, "y": 312, "text": "25", "size": 16, "anchor": "middle"}]}},
        { "say": "Both have a mean of 15 and a median of 15.", "write": "mean 15, median 15" },
        { "say": "But Mia's range is 4 and Zara's is 18. Mia is far more consistent.", "write": "range 4 vs 18" },
        { "say": "Same scale or no deal. You can only compare plots on a shared scale.", "write": "same scale" }
      ] },
    { "heading": "Back-to-back stem-and-leaf",
      "lines": [
        { "say": "A back-to-back plot shares one stem down the middle.", "write": "shared stem" },
        { "say": "Left leaves lean out. Read them from the stem outwards.", "write": "8 3 | 2 → 23, 28" },
        { "say": "Class 7A has median 36 and range 23.", "write": "7A: median 36, range 23" },
        { "say": "Class 7B has median 31.5 and range 31.", "write": "7B: median 31.5, range 31" },
        { "say": "So 7A did better and was more consistent.", "write": "7A higher and more consistent" }
      ] },
    { "heading": "Outliers",
      "lines": [
        { "say": "Café A waits: 3, 4, 4, 5, 6, and once, 26 minutes.", "write": "Café A: 3, 4, 4, 5, 6, 26",
          "diagram": "diagrams/y7/maths-advanced/comparing-data-sets-cafes.svg", "alt": "Dot plots of café waiting times with an outlier at 26" },
        { "say": "That 26 is an outlier. It drags Café A's mean up to 8.", "write": "mean A = 48 ÷ 6 = 8" },
        { "say": "Café A's median is only 4.5. Café B's median is 7.", "write": "median 4.5 vs 7" },
        { "say": "Outlier? Median! On a typical day, Café A is quicker.", "write": "outlier → use median" }
      ] },
    { "heading": "Working backwards from the mean",
      "lines": [
        { "say": "Mean times count gives the total.", "write": "total = mean × count" },
        { "say": "Liam's mean over 5 tests is 72. Total so far: 360.", "write": "72 × 5 = 360" },
        { "say": "To get a mean of 75 over 6 tests, he needs 450 in total.", "write": "75 × 6 = 450" },
        { "say": "So the sixth test must be 90.", "write": "450 − 360 = 90",
          "draw": {"type": "shapes", "width": 560, "height": 180, "alt": "Bar of 360 plus 90 makes 450", "items": [
            {"kind": "rect", "x": 40, "y": 50, "w": 384, "h": 60, "fill": "blue", "label": "360 so far"},
            {"kind": "rect", "x": 424, "y": 50, "w": 96, "h": 60, "fill": "green", "label": "90", "change": "add"},
            {"kind": "text", "x": 280, "y": 150, "text": "total needed 450", "size": 20, "anchor": "middle"}]}},
        { "say": "With groups of different sizes, compare means, not totals.", "write": "compare means, not totals" }
      ] },
    { "heading": "Watch out for these",
      "lines": [
        { "say": "Don't compare only the centre. Always give the spread too.", "write": "centre AND spread" },
        { "say": "Don't add means together. Rebuild each total first.", "write": "✗ average of means" },
        { "say": "Write it in context: name both groups, the measure and the numbers.", "write": "name, measure, numbers" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Centre and spread, every time.", "write": "centre + spread" },
        { "say": "Left leaves lean out.", "write": "read from the stem out" },
        { "say": "Mean times count equals total.", "write": "mean × count = total" },
        { "say": "Outlier? Median!", "write": "outlier → median" }
      ] }
  ]
}

    {
      "heading": "A quick one",
      "lines": [
        {
          "say": "Write 3 and two fifths as an improper fraction.",
          "write": "3⅖"
        },
        {
          "say": "Three times 5 is 15 fifths.",
          "write": "3 × 5 = 15"
        },
        {
          "say": "Add the 2 extra fifths. Seventeen fifths.",
          "write": "15 + 2 = 17   →  17/5"
        },
        {
          "say": "Check: 17 divided by 5 is 3, remainder 2.",
          "write": "17 ÷ 5 = 3 r 2 ✓"
        }
      ]
    },
    {
      "heading": "Improper to mixed",
      "lines": [
        {
          "say": "Go the other way. How many wholes fit, and what is left?",
          "write": "23/4 = ?"
        },
        {
          "say": "Twenty-three divided by 4 is 5, remainder 3.",
          "write": "23 ÷ 4 = 5 r 3"
        },
        {
          "say": "Five wholes, with 3 quarters left over.",
          "write": "23/4 = 5¾"
        },
        {
          "say": "Twenty-three sixths: 6 goes in 3 times, with 5 left.",
          "write": "23/6 = 3⅚"
        },
        {
          "say": "Thirty quarters is 7 and two quarters. Simplify to 7 and a half.",
          "write": "30/4 = 7 2/4 = 7½"
        }
      ]
    },
    {

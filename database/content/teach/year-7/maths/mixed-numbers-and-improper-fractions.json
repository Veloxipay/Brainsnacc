    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "For two and three quarters, multiply 2 by 4, not 2 by 3.",
          "write": "2 × 4, not 2 × 3"
        },
        {
          "say": "Don't forget to add the top. Eight quarters is only the wholes.",
          "write": "✗ 2¾ = 8/4"
        },
        {
          "say": "The pieces don't change size. Keep the same denominator.",
          "write": "✗ 23/4 = 5 3/5"
        },
        {
          "say": "The remainder goes on top, not the answer of the division.",
          "write": "remainder on top"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Mixed to improper: times, add, keep.",
          "write": "times, add, keep"
        },
        {
          "say": "Improper to mixed: divide, remainder on top.",
          "write": "divide, remainder on top"
        },
        {
          "say": "The denominator is the box size. Count full boxes, then leftovers.",
          "write": "full boxes + leftovers"
        },
        {
          "say": "Top bigger than bottom means more than 1.",
          "write": "7/4 > 1"
        }
      ]
    }
  ]

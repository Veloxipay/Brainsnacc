  "title": "Mixed numbers and improper fractions",
  "frames": [
    {
      "heading": "Proper and improper fractions",
      "lines": [
        {
          "say": "A proper fraction has a smaller top than bottom. It is less than 1.",
          "write": "proper: 3/5 < 1"
        },
        {
          "say": "An improper fraction has a top equal to or bigger than the bottom.",
          "write": "improper: 7/4, 5/5"
        },
        {
          "say": "Improper is just a name. Nothing is wrong with them."
        },
        {
          "say": "A mixed number is a whole number and a fraction together.",
          "write": "2¾ = 2 + 3/4"
        }
      ]

    {
      "heading": "When you know the difference",
      "lines": [
        {
          "say": "Boys to girls is 4 to 7. There are 18 more girls.",
          "write": "4 : 7, difference 18",
          "diagram": "diagrams/y7/maths-advanced/ratios-and-rates-in-problems-difference.svg",
          "alt": "Boys 4 parts, girls 7 parts; the 3 extra parts are 18 students"
        },
        {
          "say": "The gap is 7 minus 4. That's 3 parts, not 1.",
          "write": "3 parts = 18"
        },
        {
          "say": "So one part is 18 divided by 3, which is 6.",
          "write": "1 part = 6"
        },
        {
          "say": "11 parts in total. 11 times 6 is 66 students.",
          "write": "11 × 6 = 66"
        }
      ]
    },
    {
      "heading": "Linking two ratios",
      "lines": [
        {
          "say": "a to b is 2 to 3. b to c is 4 to 5.",
          "write": "a : b = 2 : 3, b : c = 4 : 5"
        },
        {
          "say": "The b's don't match. One is 3 parts, the other is 4.",
          "write": "3 ≠ 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "matching b",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 60,
                "text": "a : b = 2 : 3",
                "size": 28,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 420,
                "y": 60,
                "text": "b : c = 4 : 5",
                "size": 28,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 140,
                "y": 140,
                "text": "× 4 → 8 : 12",
                "size": 26,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 140,
                "text": "× 3 → 12 : 15",
                "size": 26,
                "color": "orange",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "a : b : c = 8 : 12 : 15",
                "size": 30,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Make both 12, the lowest common multiple of 3 and 4.",
          "write": "LCM = 12"
        },
        {
          "say": "Now they link. a to b to c is 8 to 12 to 15.",
          "write": "8 : 12 : 15"
        }
      ]
    },

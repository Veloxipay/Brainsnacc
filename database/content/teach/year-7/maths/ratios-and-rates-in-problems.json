      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A difference is a gap in parts. Subtract the ratio numbers.",
          "write": "7 − 4 = 3 parts"
        },
        {
          "say": "Same units first. 1.2 metres to 45 centimetres is 120 to 45.",
          "write": "120 : 45"
        },
        {
          "say": "2 hours 15 minutes is 2.25 hours, not 2.15. Divide minutes by 60.",
          "write": "15 ÷ 60 = 0.25"
        },
        {
          "say": "Don't average speeds. Use total distance over total time.",
          "write": "total D ÷ total T"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "One part first, from the total, a share or a difference.",
          "write": "one part first"
        },
        {
          "say": "Three parts? Add them all.",
          "write": "2 + 3 + 7"
        },
        {
          "say": "Link ratios by matching the shared term.",
          "write": "match b"
        },
        {
          "say": "Speed is distance over time. Minutes divided by 60 gives hours.",
          "write": "S = D ÷ T"
        }
      ]
    }
  ]

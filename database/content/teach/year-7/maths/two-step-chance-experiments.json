    {
      "heading": "Two dice in a table",
      "lines": [
        {
          "say": "For two dice, use a table. 6 times 6 is 36 cells.",
          "write": "36 outcomes",
          "diagram": "diagrams/y7/maths-advanced/two-step-chance-experiments-grid.svg",
          "alt": "6 by 6 table of dice totals with the six 7s shaded"
        },
        {
          "say": "A total of 7 shows up 6 times. 6 out of 36 is a sixth.",
          "write": "P(7) = 6/36 = 1/6"
        },
        {
          "say": "Totals of 10 or more: 3 tens, 2 elevens, 1 twelve. Also a sixth.",
          "write": "P(≥ 10) = 6/36"
        },
        {
          "say": "Doubles run down the diagonal. 6 cells, so a sixth again.",
          "write": "P(double) = 1/6"
        },
        {
          "say": "The totals aren't equally likely. Seven is the most common. Count cells.",
          "write": "seven is heaven"
        }
      ]
    },
    {
      "heading": "With or without replacement",
      "lines": [
        {

                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Both red: R1 R2 and R2 R1. That's 2 out of 6, a third.",
          "write": "P(both red) = 2/6 = 1/3"
        }
      ]

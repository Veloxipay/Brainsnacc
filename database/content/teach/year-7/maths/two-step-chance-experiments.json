            ]
          }
        },
        {
          "say": "With replacement, it goes back. 3 times 3 is 9 outcomes.",
          "write": "3 × 3 = 9"
        },
        {
          "say": "Both red: 4 of those 9.",
          "write": "P(both red) = 4/9"
        },
        {
          "say": "Without replacement, the first marble stays out. Only 2 are left.",
          "write": "3 × 2 = 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "marbles in a bag",

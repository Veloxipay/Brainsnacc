{
  "level": "Year 7",
  "subject": "maths",
  "title": "Rounding decimals",
  "frames": [
    {
      "heading": "Decimal places",
      "lines": [
        {
          "say": "Calculators often show more decimal places than you need.",
          "write": "23.4167 → 23.4"
        },
        {
          "say": "Decimal places are the digits after the point. 6.48 has two.",
          "write": "6.48 → 2 d.p."
        },
        {
          "say": "Round to one decimal place means keep just the tenths.",
          "write": "1 d.p. = tenths"
        }
      ]
    },

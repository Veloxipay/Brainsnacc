    {
      "heading": "When rounding up carries",
      "lines": [
        {
          "say": "Round 7.96 to one decimal place. The tenths digit is 9.",
          "write": "7.96",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 190,
            "alt": "Decimal digits with rounding digit underlined",
            "items": [
              {
                "kind": "rect",
                "x": 152,
                "y": 40,
                "w": 58,
                "h": 70,
                "fill": "white",
                "label": "7"
              },
              {
                "kind": "rect",
                "x": 216,
                "y": 40,
                "w": 58,
                "h": 70,
                "fill": "none",
                "label": "."
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 40,
                "w": 58,
                "h": 70,
                "fill": "yellow",
                "label": "9"

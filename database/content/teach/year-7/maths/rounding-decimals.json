                "kind": "rect",
                "x": 216,
                "y": 40,
                "w": 58,
                "h": 70,
                "fill": "none",
                "label": "."
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 40,
                "w": 58,
                "h": 70,
                "fill": "yellow",

    {
      "heading": "Money and estimates",
      "lines": [
        {
          "say": "Three friends share a 10 dollar bill. The calculator shows 3.3333.",
          "write": "$10 ÷ 3 = 3.3333…"
        },
        {
          "say": "Nearest cent means two decimal places. The decider is 3.",
          "write": "nearest cent = 2 d.p."
        },
        {
          "say": "So each pays about 3 dollars 33.",
          "write": "≈ $3.33"
        },
        {
          "say": "To estimate, round to whole numbers. 4.87 plus 3.12 plus 9.6.",
          "write": "5 + 3 + 10 = 18"
        },
        {
          "say": "The exact answer is 17.59. Close to 18.",
          "write": "exact 17.59 ≈ 18 ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't round in a chain. Round the original number once.",
          "write": "18.5462 → 18.5"
        },
        {
          "say": "Don't drop the zero. 2.996 to two places is 3.00.",
          "write": "2.996 ≈ 3.00"
        },
        {
          "say": "Don't just chop digits off. 6.48 rounds to 6.5, not 6.4.",
          "write": "✗ 6.4   ✓ 6.5",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Chopped answer crossed out, rounded answer added",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "6.4",
                "size": 40,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "6.5",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "decider 8 → round up",
                "size": 20,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Underline the digit you keep. Circle the next one.",
          "write": "underline and circle"
        },
        {
          "say": "5 or more, raise the score. 4 or less, let it rest.",
          "write": "5+ up   4- rest"
        },
        {
          "say": "Nearest cent is two places. Nearest dollar is zero places.",
          "write": "cent = 2 d.p."
        },
        {
          "say": "Count your places at the end. Your answer should stay close.",
          "write": "count the places ✓"
        }
      ]
    }
  ]

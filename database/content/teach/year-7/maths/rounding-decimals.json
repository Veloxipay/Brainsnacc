              {
                "kind": "arrow",
                "x": 320,
                "y": 140,
                "x2": 370,
                "y2": 140,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "The decider is 6, so round up. But 9 plus 1 is 10.",
          "write": "9 + 1 = 10"
        },
        {
          "say": "Ten tenths is one whole. So 7 becomes 8, tenths become 0.",
          "write": "7.96 ≈ 8.0",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 190,
            "alt": "Decimal digits with rounding digit underlined",
            "items": [

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Adding and subtracting integers",
  "frames": [
    {
      "heading": "Money in, money out",
      "lines": [
        {
          "say": "Adding a positive is putting money in.",
          "write": "+ (+) → in"
        },
        {
          "say": "Adding a negative is like getting a bill. Your money goes down.",
          "write": "+ (−) → bill"
        },
        {
          "say": "Subtracting a negative cancels a bill. Your money goes up!",
          "write": "− (−) → richer"
        },
        {
          "say": "Taking away a debt is the same as giving you money.",
          "write": "− debt = + money"
        }
      ]
    },
    {
      "heading": "Moving on the number line",
      "lines": [
        {
          "say": "Start at the first number. Plus a positive means move right.",
          "write": "−6 + 4",
          "draw": {
            "type": "numberline",
            "from": -7,
            "to": 2,
            "start": -6,
            "jump": 0
          }
        },
        {
          "say": "From minus 6, move 4 right. You land on minus 2.",
          "write": "−6 + 4 = −2",
          "draw": {
            "type": "numberline",
            "from": -7,
            "to": 2,
            "start": -6,
            "jump": 4
          }
        },
        {
          "say": "Minus a positive means move left. 3 take 8.",
          "write": "3 − 8",
          "draw": {
            "type": "numberline",
            "from": -6,
            "to": 4,
            "start": 3,
            "jump": 0
          }
        },
        {
          "say": "From 3, move 8 left. You land on minus 5.",
          "write": "3 − 8 = −5",
          "draw": {
            "type": "numberline",
            "from": -6,
            "to": 4,
            "start": 3,
            "jump": -8
          }
        },
        {
          "say": "Add, go right. Take, go left.",
          "write": "add → right, take → left"
        }
      ]
    },
    {
      "heading": "Adding a negative",
      "lines": [
        {
          "say": "7 plus minus 3. The plus minus pair becomes one minus.",
          "write": "7 + (−3) = 7 − 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "sign pair",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "7 + (−3)",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 160,
                "text": "7 − 3 = 4",
                "size": 36,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So 7 plus minus 3 is 4.",
          "write": "= 4",
          "draw": {
            "type": "numberline",
            "from": 0,
            "to": 8,
            "start": 7,
            "jump": -3
          }
        },
        {
          "say": "Two negatives go further below zero. Minus 7 plus minus 5 is minus 12.",
          "write": "−7 + (−5) = −12",
          "draw": {
            "type": "numberline",
            "from": -13,
            "to": 1,
            "start": -7,
            "jump": -5
          }
        }
      ]
    },
    {
      "heading": "Subtracting a negative",
      "lines": [
        {
          "say": "5 take minus 4. Two minus signs next to each other.",
          "write": "5 − (−4)"
        },
        {
          "say": "Change two signs. Take becomes add, minus 4 becomes 4.",
          "write": "5 + 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "change two signs",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "5 − (−4)",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 115,
                "text": "− − becomes +",
                "size": 20,
                "color": "grey",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "5 + 4 = 9",
                "size": 36,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "5 plus 4 is 9.",
          "write": "= 9",
          "draw": {
            "type": "numberline",
            "from": 0,
            "to": 10,
            "start": 5,
            "jump": 4
          }
        },
        {
          "say": "Minus 2 take minus 9 becomes minus 2 plus 9. That's 7.",
          "write": "−2 − (−9) = −2 + 9 = 7",
          "draw": {
            "type": "numberline",
            "from": -3,
            "to": 8,
            "start": -2,
            "jump": 9
          }
        }
      ]
    },
    {
      "heading": "Sign rules",
      "lines": [
        {
          "say": "Same signs next to each other make plus.",
          "write": "+ (+) → +,  − (−) → +"
        },
        {
          "say": "Different signs next to each other make minus.",
          "write": "+ (−) → −,  − (+) → −"
        },
        {
          "say": "Different sizes? Find the difference. Use the sign of the bigger one.",
          "write": "−6 + 4: 6 − 4 = 2 → −2"
        }
      ]
    },
    {
      "heading": "A bank balance",
      "lines": [
        {
          "say": "Mia has 40 dollars. She spends 65, then gets 30 from her nan.",
          "write": "40 − 65 + 30"
        },
        {
          "say": "40 take 65 is minus 25. She's 25 dollars below zero.",
          "write": "40 − 65 = −25",
          "draw": {
            "type": "numberline",
            "from": -30,
            "to": 45,
            "start": 40,
            "jump": -65
          }
        },
        {
          "say": "Minus 25 plus 30 crosses zero and lands on 5.",
          "write": "−25 + 30 = 5",
          "draw": {
            "type": "numberline",
            "from": -30,
            "to": 10,
            "start": -25,
            "jump": 30
          }
        },
        {
          "say": "Check: 70 in, 65 out. That leaves 5 dollars.",
          "write": "70 − 65 = 5 ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "5 take minus 4 is not 1. Circle the two signs in the middle.",
          "write": "✗ 5 − (−4) = 1"
        },
        {
          "say": "Minus 8 take 6 goes further down. It's minus 14, not minus 2.",
          "write": "−8 − 6 = −14",
          "draw": {
            "type": "numberline",
            "from": -15,
            "to": 0,
            "start": -8,
            "jump": -6
          }
        },
        {
          "say": "Change both signs, not just one.",
          "write": "✗ 3 − (−2) = 3 − 2"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Add, go right. Take, go left.",
          "write": "add → right"
        },
        {
          "say": "Same signs make plus. Different signs make minus.",
          "write": "same +, different −"
        },
        {
          "say": "Taking away a debt makes you richer.",
          "write": "− (−) = +"
        },
        {
          "say": "Check subtraction by adding back.",
          "write": "−5 + 8 = 3 ✓"
        }
      ]
    }
  ]
}
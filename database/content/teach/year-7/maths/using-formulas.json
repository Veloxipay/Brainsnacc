{
  "level": "Year 7",
  "subject": "maths",
  "title": "Using formulas",
  "frames": [
    {
      "heading": "What is a formula?",
      "lines": [
        {
          "say": "A formula is a rule, written with letters, for working something out.",
          "write": "formula = rule with letters"
        },
        {
          "say": "Like a recipe. 2 eggs per person. Know the people, find the eggs.",
          "write": "eggs = 2 × people"
        },
        {
          "say": "The perimeter of a rectangle is P equals 2l plus 2w.",
          "write": "P = 2l + 2w",
          "diagram": "diagrams/y7/maths/using-formulas-rectangle.svg",
          "alt": "Rectangle with length l and width w, P = 2l + 2w"
        },
        {
          "say": "P is the subject. It's the letter on its own.",
          "write": "P = subject"
        },
        {
          "say": "l and w are variables. The 2 is a constant.",
          "write": "l, w variables   2 constant"
        }
      ]
    },
    {
      "heading": "Substitute and evaluate",
      "lines": [
        {
          "say": "Find P when l is 9 and w is 4. Write the times signs back in.",
          "write": "P = 2 × l + 2 × w"
        },
        {
          "say": "Swap each letter for its number.",
          "write": "P = 2 × 9 + 2 × 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Substituting into the perimeter formula",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "P = 2 × l + 2 × w",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "P = 2 × 9 + 2 × 4",
                "size": 34,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "= 18 + 8 = 26 cm",
                "size": 34,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Multiply before adding. 18 plus 8 is 26 centimetres.",
          "write": "P = 26 cm"
        },
        {
          "say": "A bike club charges C equals 12 plus 5h. Try 3 hours.",
          "write": "C = 12 + 5 × 3"
        },
        {
          "say": "5 times 3 is 15. Plus 12 is 27 dollars.",
          "write": "C = $27"
        }
      ]
    },
    {
      "heading": "Substitute, then solve",
      "lines": [
        {
          "say": "Sometimes you know the subject but not another letter.",
          "write": "know A, find w"
        },
        {
          "say": "A rectangle has area 54 and length 9. Find the width.",
          "write": "A = l × w",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Rectangle with area 54 cm², length 9 cm, width w",
            "items": [
              {
                "kind": "rect",
                "x": 110,
                "y": 60,
                "w": 340,
                "h": 150,
                "fill": "blue",
                "label": "54 cm²"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "9 cm",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 140,
                "text": "w",
                "size": 26,
                "color": "red",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Substitute. 54 equals 9 times w.",
          "write": "54 = 9w",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Rectangle with area 54 cm², length 9 cm, width w",
            "items": [
              {
                "kind": "rect",
                "x": 110,
                "y": 60,
                "w": 340,
                "h": 150,
                "fill": "blue",
                "label": "54 cm²"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "9 cm",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 140,
                "text": "w",
                "size": 26,
                "color": "red",
                "anchor": "start",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 40,
                "text": "54 = 9 × w",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Divide both sides by 9. The width is 6 centimetres.",
          "write": "w = 6 cm",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Rectangle with area 54 cm², length 9 cm, width w",
            "items": [
              {
                "kind": "rect",
                "x": 110,
                "y": 60,
                "w": 340,
                "h": 150,
                "fill": "blue",
                "label": "54 cm²"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "9 cm",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 140,
                "text": "w = 6 cm",
                "size": 24,
                "color": "green",
                "anchor": "start",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 40,
                "text": "54 ÷ 9 = 6",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Check. 9 times 6 is 54.",
          "write": "9 × 6 = 54 ✓"
        }
      ]
    },

    },
    {
      "heading": "Speed, distance, time",
      "lines": [
        {
          "say": "Distance equals speed times time.",
          "write": "d = s × t"
        },
        {
          "say": "80 kilometres per hour for 2.5 hours is 200 kilometres.",
          "write": "d = 80 × 2.5 = 200 km"
        },
        {
          "say": "How long for 240 kilometres at 80? 240 equals 80 times t.",
          "write": "240 = 80t"
        },
        {
          "say": "Divide by 80. It takes 3 hours.",
          "write": "t = 3 hours"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "5h with h equals 3 is 15. Not 53, not 8.",
          "write": "5h = 5 × 3 = 15"
        },
        {
          "say": "Multiply before adding. 12 plus 5 times 3 is not 51.",
          "write": "✗ 51   ✓ 27"
        },
        {
          "say": "Area needs square units. Centimetres squared, not centimetres.",
          "write": "cm² for area"
        },
        {
          "say": "54 equals 9w is not the answer yet. Keep solving.",
          "write": "get the letter alone"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "List what each letter equals before you start.",
          "write": "C = …, h = …"
        },
        {
          "say": "Know the right side? Substitute and evaluate.",
          "write": "substitute, evaluate"
        },
        {
          "say": "Know the subject? Substitute, then solve.",
          "write": "substitute, solve"
        },
        {
          "say": "Always finish with the right units.",
          "write": "units ✓"
        }
      ]
    }
  ]
}

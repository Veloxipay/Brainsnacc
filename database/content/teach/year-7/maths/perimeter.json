{
  "level": "Year 7",
  "subject": "maths",
  "title": "Perimeter",
  "frames": [
    {
      "heading": "What is perimeter?",
      "lines": [
        {
          "say": "Perimeter is the total distance around the outside of a shape.",
          "write": "Perimeter = distance around"
        },
        {
          "say": "Picture an ant walking along every edge, back to where it started.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "An ant walking around a rectangle",
            "items": [
              {
                "kind": "rect",
                "x": 120,
                "y": 70,
                "w": 320,
                "h": 160,
                "fill": "white"
              },
              {
                "kind": "circle",
                "x": 120,
                "y": 230,
                "r": 10,
                "fill": "black",
                "label": ""
              },
              {
                "kind": "arrow",
                "x": 130,
                "y": 240,
                "x2": 420,
                "y2": 240,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 450,
                "y": 220,
                "x2": 450,
                "y2": 80,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 430,
                "y": 60,
                "x2": 140,
                "y2": 60,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 110,
                "y": 80,
                "x2": 110,
                "y2": 220,
                "color": "red",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "It walks the outside only. It never cuts across the middle.",
          "write": "outside only"
        },
        {
          "say": "Perimeter is a length, so it uses millimetres, centimetres, metres or kilometres.",
          "write": "units: mm, cm, m, km"
        },
        {
          "say": "Before you add, make sure every side is in the same unit.",
          "write": "same unit first"
        }
      ]
    },
    {
      "heading": "Rectangles and squares",
      "lines": [
        {
          "say": "Here is a rectangle, 9 centimetres long and 4 centimetres wide.",
          "write": "9 cm by 4 cm",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "A 9 cm by 4 cm rectangle traced around",
            "items": [
              {
                "kind": "rect",
                "x": 100,
                "y": 60,
                "w": 360,
                "h": 160,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "9 cm",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 480,
                "y": 145,
                "text": "4 cm",
                "size": 22,
                "color": "black",
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "Add the length and the width. That gets you half-way round.",
          "write": "9 + 4 = 13",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "A 9 cm by 4 cm rectangle traced around",
            "items": [
              {
                "kind": "rect",
                "x": 100,
                "y": 60,
                "w": 360,
                "h": 160,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "9 cm",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 480,
                "y": 145,
                "text": "4 cm",
                "size": 22,
                "color": "black",
                "anchor": "start"
              },
              {
                "kind": "line",
                "x": 100,
                "y": 220,
                "x2": 460,
                "y2": 220,
                "color": "red",
                "change": "highlight"
              },
              {
                "kind": "line",
                "x": 460,
                "y": 220,
                "x2": 460,
                "y2": 60,
                "color": "red",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 40,
                "text": "9 + 4 = 13 (half-way round)",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "There are two lengths and two widths, so double it.",
          "write": "2 × 13 = 26 cm",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "A 9 cm by 4 cm rectangle traced around",
            "items": [
              {
                "kind": "rect",
                "x": 100,
                "y": 60,
                "w": 360,
                "h": 160,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "9 cm",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 480,
                "y": 145,
                "text": "4 cm",
                "size": 22,
                "color": "black",
                "anchor": "start"
              },
              {
                "kind": "line",
                "x": 100,
                "y": 220,
                "x2": 460,
                "y2": 220,
                "color": "red"
              },
              {
                "kind": "line",
                "x": 460,
                "y": 220,
                "x2": 460,
                "y2": 60,
                "color": "red"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 40,
                "text": "9 + 4 = 13 (half-way round)",
                "size": 20,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "line",
                "x": 460,
                "y": 60,
                "x2": 100,
                "y2": 60,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "line",
                "x": 100,
                "y": 60,
                "x2": 100,
                "y2": 220,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 80,
                "y": 145,
                "text": "4",
                "size": 22,
                "color": "black",
                "anchor": "end",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 290,
                "text": "2 × 13 = 26 cm",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "So the rule is two times, length plus width.",
          "write": "P = 2 × (l + w)"
        },
        {
          "say": "A square has four equal sides. Perimeter is four times the side.",
          "write": "P = 4 × side"
        }
      ]
    },
    {
      "heading": "Triangles and other polygons",
      "lines": [
        {
          "say": "For any shape with straight sides, just add every side.",
          "write": "add every side"
        },
        {
          "say": "This triangle has sides 7, 10 and 12 metres.",
          "write": "7 + 10 + 12",
          "diagram": "diagrams/y7/maths/perimeter-ex2.svg",
          "alt": "A triangle with sides of 12 m, 10 m and 7 m"
        },
        {
          "say": "7 plus 10 plus 12 is 29 metres.",
          "write": "P = 29 m"
        },
        {
          "say": "A regular polygon has all sides equal. Multiply side by the number of sides.",
          "write": "regular: side × sides",
          "diagram": "diagrams/y7/maths/perimeter-hexagon.svg",
          "alt": "A regular hexagon with sides of 5 cm"
        },
        {
          "say": "A regular hexagon with 5 centimetre sides. 6 times 5 is 30 centimetres.",
          "write": "6 × 5 = 30 cm"
        }
      ]
    },

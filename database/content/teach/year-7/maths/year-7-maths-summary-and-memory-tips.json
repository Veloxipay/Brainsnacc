                "y": 60,
                "text": "4 + 5 × 3²",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 130,
                "text": "= 4 + 5 × 9",
                "size": 36,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 195,
                "text": "= 4 + 45",
                "size": 36,
                "color": "purple",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Then add. The answer is 49.",
          "write": "= 49",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "BIDMAS working for 4 + 5 × 3²",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "4 + 5 × 3²",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 130,
                "text": "= 4 + 5 × 9",
                "size": 36,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 195,
                "text": "= 4 + 45",
                "size": 36,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 260,
                "text": "= 49",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "1 is not prime. 2 is the only even prime.",
          "write": "72 = 2³ × 3²"
        }
      ]
    },
    {
      "heading": "Fractions, decimals, percentages",
      "lines": [
        {
          "say": "To add fractions, make the denominators the same first.",
          "write": "1/3 + 1/4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "One third and one quarter as twelfths",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 60,
                "w": 144,
                "h": 60,
                "fill": "blue",
                "label": "1/3"
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 140,
                "w": 108,
                "h": 60,
                "fill": "orange",
                "label": "1/4"
              }
            ]
          }
        },
        {
          "say": "Change both to twelfths. 4 twelfths plus 3 twelfths is 7 twelfths.",
          "write": "= 7/12",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "One third and one quarter as twelfths",
            "items": [

              },
              {
                "kind": "text",
                "x": 420,
                "y": 140,
                "text": "4/12 + 3/12 = 7/12",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Divide with keep, change, flip. Of means times.",
          "write": "Keep, Change, Flip"
        },
        {
          "say": "Build percentages from 10, 5 and 1 per cent.",
          "write": "10% · 5% · 1%"
        },
        {
          "say": "Only 2s and 5s in the denominator? The decimal stops.",
          "write": "2/3 = 0.6̇"
        }
      ]
    },
    {
      "heading": "Algebra and equations",
      "lines": [
        {
          "say": "Substitute with brackets. If x is 5, 3x squared is 75.",
          "write": "3(5)² = 75"
        },
        {
          "say": "Only like terms add. Apples with apples.",
          "write": "5a + 3b − 2a = 3a + 3b"
        },
        {
          "say": "Rainbow arrows. The outside term multiplies every term inside.",
          "write": "3(2x + 4) = 6x + 12"
        },
        {
          "say": "Solve 4x plus 7 equals 35. Take 7 off both sides.",
          "write": "4x = 28",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 7
            },
            "right": {
              "cubes": 35
            },
            "remove": 7,
            "labels": [
              "4x + 7 − 7",
              "35 − 7"
            ]
          }
        },
        {
          "say": "Share 28 between 4. x equals 7.",
          "write": "x = 7",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4
            },
            "right": {
              "cubes": 28
            },
            "share": true
          }
        }
      ]
    },
    {
      "heading": "Negative numbers and the plane",
      "lines": [
        {
          "say": "Right is bright, left is less. Negative 1 beats negative 6.",
          "write": "−1 > −6"
        },
        {
          "say": "Negative 6 plus 4. Start at negative 6, move 4 right.",
          "write": "−6 + 4 = −2",
          "draw": {
            "type": "numberline",
            "from": -8,
            "to": 2,
            "start": -6,
            "jump": 4
          }
        },
        {
          "say": "Same signs make plus. Different signs make minus.",
          "write": "(−3) × (−4) = 12"
        },
        {
          "say": "Bracket it to square it. Bracket negative 4, squared, is 16.",
          "write": "(−4)² = 16   −4² = −16"
        },
        {
          "say": "Along the corridor, then up the stairs. Quadrants go anticlockwise.",
          "write": "(x, y)",
          "diagram": "diagrams/y7/maths/year-7-maths-summary-and-memory-tips-quadrants.svg",
          "alt": "Cartesian plane with the four quadrants labelled"
        }
      ]
    },
    {
      "heading": "Geometry",
      "lines": [
        {
          "say": "Half a pizza is 180 degrees. A whole pizza is 360.",
          "write": "line 180°   point 360°"
        },
        {
          "say": "F, Z, C. Corresponding equal, alternate equal, co-interior add to 180.",
          "write": "F =   Z =   C → 180°"
        },
        {
          "say": "Triangle 180, quadrilateral 360.",
          "write": "△ 180°   ◻ 360°"
        },
        {
          "say": "A triangle has 50 and 75. 180 minus 125 leaves 55.",
          "write": "third angle = 55°",
          "diagram": "diagrams/y7/maths/year-7-maths-summary-and-memory-tips-triangle.svg",
          "alt": "Triangle with angles 50 and 75 degrees"
        },
        {
          "say": "Faces plus vertices minus edges is 2. A cube: 6 plus 8 minus 12.",
          "write": "F + V − E = 2"
        }
      ]
    },
    {
      "heading": "Measurement",
      "lines": [
        {
          "say": "Down the unit ladder, multiply. Up the ladder, divide.",
          "write": "km → m → cm → mm"
        },
        {
          "say": "Perimeter is the fence. Area is the grass inside.",
          "write": "cm   cm²   cm³"
        },
        {
          "say": "A box 30 by 20 by 10 has volume 6000 cubic centimetres.",
          "write": "30 × 20 × 10 = 6000 cm³",
          "diagram": "diagrams/y7/maths/year-7-maths-summary-and-memory-tips-box.svg",
          "alt": "Box 30 cm by 20 cm by 10 cm"
        },
        {
          "say": "1 cubic centimetre holds 1 millilitre. So that's 6 litres.",
          "write": "6000 mL = 6 L"
        }
      ]
    },
    {
      "heading": "Statistics, chance, algorithms",
      "lines": [
        {
          "say": "The median's the middle. Add and divide for the mean.",
          "write": "mean · median · mode · range"
        },
        {
          "say": "For 4, 7, 8, 9 and 12, the mean is 8 and the range is 8.",
          "write": "40 ÷ 5 = 8",
          "diagram": "diagrams/y7/maths/year-7-maths-summary-and-memory-tips-dotplot.svg",
          "alt": "Dot plot of 4, 7, 8, 9 and 12"
        },
        {
          "say": "Probability is favourable over total. Not a 6 on a die is 5 sixths.",
          "write": "1 − 1/6 = 5/6"
        },
        {
          "say": "Diamonds decide. It's the only flowchart shape that asks a question.",
          "write": "◇ = decision"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Socks and shoes. Undo the last step first.",
          "write": "last on, first off"
        },
        {
          "say": "Whatever you do to one side, do to the other.",
          "write": "same to both sides"
        },
        {
          "say": "Estimate first, then check your answer makes sense.",
          "write": "check ✓"
        }
      ]
    }
  ]
}

  "title": "Year 7 Maths summary and memory tips",
  "frames": [
    {
      "heading": "Number",
      "lines": [
        {
          "say": "Each place is worth ten times the place to its right.",
          "write": "each place × 10"
        },
        {
          "say": "Rounding: five or more, raise the score. Four or less, let it rest.",
          "write": "5+ up   4- rest"
        },
        {
          "say": "BIDMAS. Here's 4 plus 5 times 3 squared. Indices first.",
          "write": "4 + 5 × 3²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "BIDMAS working for 4 + 5 × 3²",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "4 + 5 × 3²",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 130,
                "text": "= 4 + 5 × 9",
                "size": 36,
                "color": "purple",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Then multiply. 5 times 9 is 45.",
          "write": "4 + 45",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "BIDMAS working for 4 + 5 × 3²",
            "items": [
              {
                "kind": "text",

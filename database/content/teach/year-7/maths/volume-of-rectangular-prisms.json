              },
              {
                "kind": "text",
                "x": 445,
                "y": 115,
                "text": "one layer (top view)",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 445,
                "y": 270,
                "text": "15 × 2 = 30",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Two layers of 15 is 30 cubic centimetres.",
          "write": "V = 30 cm³"
        },
        {
          "say": "So volume is length times width times height.",
          "write": "V = l × w × h"
        },
        {
          "say": "Or base area times height. Cubes per layer, times layers.",
          "write": "V = base area × height",
          "diagram": "diagrams/y7/maths/volume-of-rectangular-prisms-layers.svg",
          "alt": "5 by 3 by 2 prism as 2 layers of 15 cubes"
        }
      ]
    },
    {
      "heading": "Cubes",
      "lines": [
        {
          "say": "A cube has all edges equal. Volume is s times s times s.",
          "write": "V = s³"
        },
        {
          "say": "A cube with 6 metre edges. 6 times 6 times 6.",
          "write": "6 × 6 × 6",
          "diagram": "diagrams/y7/maths/volume-of-rectangular-prisms-ex2.svg",
          "alt": "A cube with 6 m edges"
        },
        {
          "say": "That's 216 cubic metres.",
          "write": "V = 216 m³"
        },
        {
          "say": "6 cubed is not 6 times 3. That would be 18.",
          "write": "6³ ≠ 18"
        }
      ]
    },
    {
      "heading": "Units must match",
      "lines": [
        {
          "say": "A garden bed is 1.2 metres, 50 centimetres and 40 centimetres.",
          "write": "1.2 m × 50 cm × 40 cm"
        },
        {
          "say": "Change everything to metres first. 0.5 and 0.4.",
          "write": "1.2 × 0.5 × 0.4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "50 cm and 40 cm converted to metres",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 90,
                "w": 150,
                "h": 60,
                "fill": "blue",
                "label": "1.2 m"
              },
              {
                "kind": "rect",
                "x": 205,
                "y": 90,
                "w": 150,
                "h": 60,
                "fill": "orange",
                "label": "50 cm"
              },
              {
                "kind": "rect",
                "x": 370,
                "y": 90,
                "w": 150,
                "h": 60,
                "fill": "orange",
                "label": "40 cm"
              },
              {
                "kind": "rect",
                "x": 205,
                "y": 170,
                "w": 150,
                "h": 60,
                "fill": "green",
                "label": "0.5 m",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 370,
                "y": 170,
                "w": 150,
                "h": 60,
                "fill": "green",
                "label": "0.4 m",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "1.2 times 0.5 is 0.6. Times 0.4 is 0.24.",
          "write": "V = 0.24 m³"
        }
      ]
    },
    {
      "heading": "How many cubes fit?",
      "lines": [
        {
          "say": "A box 30 by 20 by 15. How many 5 centimetre cubes fit?",
          "write": "30 × 20 × 15 box",
          "diagram": "diagrams/y7/maths/volume-of-rectangular-prisms-ex4.svg",
          "alt": "Box with a 5 cm grid: 6 along, 4 deep, 3 high"
        },
        {
          "say": "Divide each edge by 5. That's 6 along, 4 deep, 3 high.",
          "write": "6, 4, 3"
        },
        {
          "say": "6 times 4 times 3 is 72 cubes.",
          "write": "6 × 4 × 3 = 72"
        },
        {
          "say": "Check. 9000 divided by 125 is also 72.",
          "write": "9000 ÷ 125 = 72 ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't add the three lengths. Multiply them.",
          "write": "✗ 5 + 3 + 2"
        },
        {
          "say": "Volume has cubic units, not square units.",
          "write": "cm³, not cm²"
        },
        {
          "say": "Convert every length to the same unit before multiplying.",
          "write": "same units"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Volume counts cubes. Layers times rows times columns.",
          "write": "V = l × w × h"
        },
        {
          "say": "Base area times height works too.",
          "write": "V = A × h"
        },
        {
          "say": "s cubed means s times s times s.",
          "write": "s³ = s × s × s"
        },
        {
          "say": "Always use cubic units.",
          "write": "cm³ ✓"
        }
      ]
    }
  ]
}

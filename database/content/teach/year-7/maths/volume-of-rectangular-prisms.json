                "change": "add"
              },
              {
                "kind": "rect",
                "x": 110,
                "y": 180,
                "w": 50,
                "h": 50,
                "fill": "orange",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 160,
                "y": 180,
                "w": 50,
                "h": 50,
                "fill": "orange",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 210,
                "y": 180,
                "w": 50,
                "h": 50,
                "fill": "orange",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 260,
                "y": 180,
                "w": 50,
                "h": 50,
                "fill": "orange",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 185,
                "y": 300,
                "text": "5 cm",
                "size": 20,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "rect",
                "x": 370,
                "y": 130,
                "w": 150,
                "h": 90,
                "fill": "blue",

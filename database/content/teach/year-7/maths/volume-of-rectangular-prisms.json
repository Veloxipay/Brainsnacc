{
  "level": "Year 7",
  "subject": "maths",
  "title": "Volume of rectangular prisms",
  "frames": [
    {
      "heading": "What is volume?",
      "lines": [
        {
          "say": "Volume is the amount of space a solid takes up.",
          "write": "volume = space taken up"
        },
        {
          "say": "We measure it in cubic units. One cubic centimetre is a sugar cube.",
          "write": "1 cm³",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "A 1 cm cube",
            "items": [
              {
                "kind": "rect",
                "x": 230,
                "y": 90,
                "w": 100,
                "h": 100,
                "fill": "orange",
                "label": "1 cm³"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "1 cm",
                "size": 20,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 145,
                "text": "1 cm",
                "size": 20,
                "color": "black",
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "The little 3 shows three lengths were multiplied.",
          "write": "cm³, mm³, m³"
        },
        {
          "say": "A rectangular prism is a box. 6 faces, 12 edges, 8 corners.",
          "write": "length × width × height"
        }
      ]
    },
    {
      "heading": "Stacking layers",
      "lines": [
        {
          "say": "Fill a box 5 by 3 by 2 with centimetre cubes. First, the bottom layer.",
          "write": "one layer = 5 × 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Layers of centimetre cubes in a 5 by 3 by 2 prism",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 230,
                "w": 50,
                "h": 50,
                "fill": "blue"
              },
              {
                "kind": "rect",
                "x": 110,
                "y": 230,
                "w": 50,
                "h": 50,
                "fill": "blue"
              },
              {
                "kind": "rect",
                "x": 160,
                "y": 230,
                "w": 50,
                "h": 50,
                "fill": "blue"
              },
              {
                "kind": "rect",
                "x": 210,
                "y": 230,
                "w": 50,
                "h": 50,
                "fill": "blue"
              },
              {
                "kind": "rect",
                "x": 260,
                "y": 230,
                "w": 50,
                "h": 50,
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 185,
                "y": 300,
                "text": "5 cm",
                "size": 20,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "rect",
                "x": 370,
                "y": 130,
                "w": 150,
                "h": 90,
                "fill": "blue",
                "label": "5 × 3 = 15"
              },
              {
                "kind": "text",
                "x": 445,
                "y": 115,
                "text": "one layer (top view)",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 445,
                "y": 270,
                "text": "15 cubes",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "The bottom layer holds 5 times 3, which is 15 cubes.",
          "write": "5 × 3 = 15"
        },
        {
          "say": "Add a second layer on top. Another 15 cubes.",
          "write": "2 layers",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Layers of centimetre cubes in a 5 by 3 by 2 prism",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 230,
                "w": 50,
                "h": 50,
                "fill": "blue"
              },
              {
                "kind": "rect",
                "x": 110,
                "y": 230,
                "w": 50,
                "h": 50,

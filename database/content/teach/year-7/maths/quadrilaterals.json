    {
      "heading": "The special quadrilaterals",
      "lines": [
        {
          "say": "Here is the family of special quadrilaterals.",
          "write": "the family",
          "diagram": "diagrams/y7/maths/quadrilaterals-family.svg",
          "alt": "Square, rectangle, rhombus, parallelogram, trapezium and kite"
        },
        {
          "say": "A parallelogram has two pairs of parallel sides.",
          "write": "parallelogram: 2 pairs ∥"
        },
        {
          "say": "A rectangle is a parallelogram with four right angles.",
          "write": "rectangle: all 90°"
        },
        {
          "say": "A rhombus is a parallelogram with all four sides equal.",
          "write": "rhombus: 4 equal sides"
        },
        {
          "say": "A trapezium has exactly one pair of parallel sides.",
          "write": "trapezium: 1 pair ∥"
        },
        {
          "say": "A kite has two pairs of equal sides next to each other.",
          "write": "kite: 2 pairs, side by side"
        }
      ]
    },
    {
      "heading": "Pushing shapes over",
      "lines": [
        {
          "say": "Start with a square. Four equal sides, four right angles.",
          "write": "square",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "A square",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    180,
                    70
                  ],
                  [
                    380,
                    70
                  ],
                  [
                    380,
                    270
                  ],
                  [
                    180,
                    270
                  ]
                ],
                "fill": "orange"
              }
            ]
          }
        },
        {
          "say": "Push the top sideways. Sides stay equal, but the angles change.",
          "write": "square → rhombus",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "A square pushed over into a rhombus",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    180,
                    70
                  ],
                  [
                    380,
                    70
                  ],
                  [
                    380,
                    270
                  ],
                  [
                    180,
                    270
                  ]
                ],
                "fill": "orange",
                "change": "remove"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    150,
                    270
                  ],
                  [
                    350,
                    270
                  ],
                  [
                    430,
                    90
                  ],
                  [
                    230,
                    90
                  ]
                ],
                "fill": "pink",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "That's a rhombus. A pushed-over rectangle is a parallelogram.",
          "write": "rectangle → parallelogram"
        },
        {
          "say": "A square is both a rectangle and a rhombus.",
          "write": "square = rectangle + rhombus"
        },
        {
          "say": "Every square is a rectangle. Not every rectangle is a square.",
          "write": "check the rules, not the look"
        }
      ]
    },
    {
      "heading": "Diagonals",
      "lines": [
        {
          "say": "Bisect means cut into two equal halves.",
          "write": "bisect = cut in half"
        },
        {
          "say": "In a parallelogram, the diagonals bisect each other.",
          "write": "diagonals bisect"
        },
        {
          "say": "In a rhombus and a kite, the diagonals cross at right angles.",
          "write": "cross at 90°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Rhombus with diagonals crossing at right angles",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    280,
                    40
                  ],
                  [
                    420,
                    170
                  ],
                  [
                    280,
                    300
                  ],
                  [
                    140,
                    170
                  ]
                ],
                "fill": "pink"
              },
              {
                "kind": "line",
                "x": 280,
                "y": 40,
                "x2": 280,
                "y2": 300,
                "color": "red",
                "dashed": true,
                "change": "add"
              },
              {
                "kind": "line",
                "x": 140,
                "y": 170,
                "x2": 420,
                "y2": 170,
                "color": "red",
                "dashed": true,
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 150,
                "w": 20,
                "h": 20,
                "fill": "none",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Rectangles and squares have equal diagonals.",
          "write": "equal diagonals"
        }
      ]
    },
    {
      "heading": "Angles in a parallelogram",
      "lines": [
        {
          "say": "One angle of this parallelogram is 65 degrees.",
          "write": "A = 65°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Parallelogram with its four angles",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    240
                  ],
                  [
                    380,
                    240
                  ],
                  [
                    500,
                    80
                  ],
                  [
                    180,
                    80
                  ]
                ],
                "fill": "teal"
              },
              {
                "kind": "text",
                "x": 95,
                "y": 225,
                "text": "65°",
                "size": 20,
                "color": "black",
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "Opposite angles are equal. So the opposite one is 65 too.",
          "write": "opposite angles equal",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Parallelogram with its four angles",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    240
                  ],
                  [
                    380,
                    240
                  ],
                  [
                    500,
                    80
                  ],
                  [
                    180,
                    80
                  ]
                ],
                "fill": "teal"
              },
              {
                "kind": "text",
                "x": 95,
                "y": 225,
                "text": "65°",
                "size": 20,
                "color": "black",
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 465,
                "y": 105,
                "text": "65°",
                "size": 20,
                "color": "purple",
                "anchor": "end",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Angles next to each other add to 180. So 180 minus 65 is 115.",
          "write": "180 − 65 = 115°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Parallelogram with its four angles",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    240
                  ],
                  [
                    380,
                    240
                  ],
                  [
                    500,
                    80
                  ],
                  [
                    180,
                    80
                  ]
                ],
                "fill": "teal"
              },
              {
                "kind": "text",
                "x": 95,
                "y": 225,
                "text": "65°",
                "size": 20,
                "color": "black",
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 465,
                "y": 105,
                "text": "65°",
                "size": 20,
                "color": "purple",
                "anchor": "end",
                "bold": true
              },
              {
                "kind": "text",
                "x": 355,
                "y": 225,
                "text": "115°",
                "size": 20,
                "color": "purple",
                "anchor": "end",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 200,
                "y": 105,
                "text": "115°",
                "size": 20,
                "color": "purple",
                "anchor": "start",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 290,
                "text": "65 + 115 = 180",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Check. 65 plus 115 plus 65 plus 115 is 360.",
          "write": "65+115+65+115 = 360 ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't use 180. Four sides make two triangles, so 360.",
          "write": "✗ 180°   ✓ 360°"
        },
        {
          "say": "A square IS a rectangle. It has four right angles.",
          "write": "square ⊂ rectangle"
        },
        {
          "say": "Rhombus has four equal sides. A kite has two equal pairs side by side.",
          "write": "rhombus ≠ kite"
        },
        {
          "say": "A trapezium has exactly one pair of parallel sides, not two.",
          "write": "trapezium: 1 pair only"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Four sides, two triangles, 360 degrees.",
          "write": "4 sides → 360°"
        },
        {
          "say": "Square equals rectangle plus rhombus.",
          "write": "square = rect + rhombus"
        },
        {
          "say": "Rhombus is a pushed-over square. Kite is the shape you fly.",
          "write": "rhombus · kite"
        },
        {
          "say": "Trapezium is like a table. One pair of parallel sides.",
          "write": "trapezium = table"
        }
      ]
    }
  ]
}

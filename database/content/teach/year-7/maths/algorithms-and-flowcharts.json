{
  "level": "Year 7",
  "subject": "maths",
  "title": "Algorithms and flowcharts",
  "frames": [
    {
      "heading": "What is an algorithm?",
      "lines": [
        {
          "say": "An algorithm is a list of clear steps, done in order.",
          "write": "algorithm"
        },
        {
          "say": "A recipe is one. Ingredients in, steps, pancakes out.",
          "write": "input → process → output"
        },
        {
          "say": "Swap two steps, and you get a very different result.",
          "write": "order matters"
        },
        {
          "say": "Each step has one meaning. It always finishes. Same input, same output.",
          "write": "clear · ordered · finishes"
        }
      ]
    },
    {
      "heading": "Running an algorithm",
      "lines": [

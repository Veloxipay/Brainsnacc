    {
      "heading": "Flowchart shapes",
      "lines": [
        {
          "say": "A flowchart draws an algorithm. Each shape has a job.",
          "diagram": "diagrams/y7/maths/algorithms-and-flowcharts-shapes.svg",
          "alt": "Oval, parallelogram, rectangle and diamond flowchart shapes"
        },
        {
          "say": "Ovals open and close: Start and End.",
          "write": "oval = Start / End"
        },
        {
          "say": "A parallelogram brings a number in or out.",
          "write": "parallelogram = input / output"
        },
        {
          "say": "A rectangle is an action, like add 7.",
          "write": "rectangle = process"
        },
        {
          "say": "Diamonds decide. They ask a yes or no question.",
          "write": "diamond = decision"
        }
      ]
    },
    {
      "heading": "A trace table",
      "lines": [
        {
          "say": "Input x, add 7, multiply by 2. Try x equals 12.",
          "write": "x = 12",
          "diagram": "diagrams/y7/maths/algorithms-and-flowcharts-ex2.svg",
          "alt": "Flowchart: Input x, Add 7, Multiply by 2, Output"
        },
        {
          "say": "Write the value after each step, so you never lose your place.",
          "write": "trace table",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "trace table",
            "items": [
              {
                "kind": "rect",
                "x": 100,
                "y": 30,
                "w": 180,
                "h": 50,
                "fill": "grey",
                "label": "Step"
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 30,
                "w": 180,
                "h": 50,
                "fill": "grey",
                "label": "Value"
              },
              {
                "kind": "rect",
                "x": 100,
                "y": 80,
                "w": 180,
                "h": 50,
                "fill": "white",
                "label": "Input"
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 80,
                "w": 180,
                "h": 50,
                "fill": "white",
                "label": "12"
              },
              {
                "kind": "rect",
                "x": 100,
                "y": 130,
                "w": 180,
                "h": 50,
                "fill": "white",
                "label": "Add 7"
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 130,
                "w": 180,
                "h": 50,
                "fill": "yellow",
                "label": "19",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 100,
                "y": 180,
                "w": 180,
                "h": 50,
                "fill": "white",
                "label": "× 2"
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 180,
                "w": 180,
                "h": 50,
                "fill": "yellow",
                "label": "38",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "12 plus 7 is 19. 19 times 2 is 38.",
          "write": "output 38"
        },
        {
          "say": "Not 12 plus 7 times 2. The flowchart makes you add first.",
          "write": "✗ 12 + 7 × 2 = 26"
        }
      ]
    },
    {
      "heading": "Decisions",
      "lines": [
        {
          "say": "Is n even? Yes, divide by 2. No, times 3 and add 1.",
          "write": "Is n even?",
          "diagram": "diagrams/y7/maths/algorithms-and-flowcharts-ex4.svg",
          "alt": "Flowchart with a decision: is n even?"
        },
        {
          "say": "n equals 10. It's even, so follow Yes. 10 divided by 2 is 5.",
          "write": "10 → 5"
        },
        {
          "say": "n equals 7. It's odd, so follow No. 7 times 3, plus 1, is 22.",
          "write": "7 → 22"
        },
        {
          "say": "Each input goes down only one branch.",
          "write": "one branch only"
        }
      ]
    },

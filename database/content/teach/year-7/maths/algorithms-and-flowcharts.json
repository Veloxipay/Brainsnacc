    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "The algorithm's order beats BIDMAS. Follow the steps one by one.",
          "write": "steps beat BIDMAS"
        },
        {
          "say": "Answer the question, then follow only that arrow.",
          "write": "not both branches"
        },
        {
          "say": "Reversing? Undo the last step first. Shoes before socks.",
          "write": "last step first"
        },
        {
          "say": "Tick off each step in a trace table so you don't stop early.",
          "write": "tick each step"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Input, process, output.",
          "write": "IPO"
        },
        {
          "say": "Diamonds decide. Ovals open and close.",
          "write": "◇ decide, ⬭ start/end"
        },
        {
          "say": "To reverse, do the opposite steps in reverse order.",
          "write": "reverse + opposite"
        },
        {
          "say": "Then run your answer forwards to check.",
          "write": "check forwards ✓"
        }
      ]
    }
  ]

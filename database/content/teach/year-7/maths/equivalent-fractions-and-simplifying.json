    {
      "heading": "Comparing fractions",
      "lines": [
        {
          "say": "Which is bigger, three fifths or four sevenths?",
          "write": "3/5 or 4/7?",
          "diagram": "diagrams/y7/maths/equivalent-fractions-and-simplifying-compare.svg",
          "alt": "Bars showing 3/5 and 4/7"
        },
        {
          "say": "Use a common denominator. The LCM of 5 and 7 is 35.",
          "write": "LCM(5, 7) = 35"
        },
        {
          "say": "Three fifths, times 7 on top and bottom, is 21 over 35.",
          "write": "3/5 = 21/35"
        },
        {
          "say": "Four sevenths, times 5 on top and bottom, is 20 over 35.",
          "write": "4/7 = 20/35"
        },
        {
          "say": "21 beats 20. So three fifths is bigger.",
          "write": "3/5 > 4/7"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't add. Adding 1 to the top and bottom changes the amount.",
          "write": "✗ 2/3 → 3/4"
        },
        {
          "say": "Don't change just the bottom. Three fifths is not three twentieths.",
          "write": "✗ 3/5 = 3/20"
        },
        {
          "say": "Don't stop too early. Six eighths still shares a 2.",
          "write": "12/16 → 6/8 → 3/4"
        },
        {
          "say": "Bigger numbers don't mean a bigger fraction. Two thirds beats five eighths.",
          "write": "2/3 > 5/8"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "What you do to the top, you do to the bottom.",
          "write": "same to top and bottom"
        },
        {
          "say": "Multiply to make equivalent fractions. Divide to simplify.",
          "write": "× to build, ÷ to simplify"
        },
        {
          "say": "Simplest form: only 1 divides into both.",
          "write": "simplest form"
        },
        {
          "say": "More slices, smaller slices, same pizza.",
          "write": "2/3 = 8/12"
        }
      ]
    }

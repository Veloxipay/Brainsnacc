              }
            ]
          }
        },
        {
          "say": "The bottom number is the denominator. It says how many equal parts.",
          "write": "denominator = parts in whole"
        },
        {
          "say": "The top number is the numerator. It says how many parts you have.",
          "write": "numerator = parts you have"
        },
        {
          "say": "Equivalent fractions look different, but they are equal in value.",
          "write": "equivalent = same value"
        }
      ]

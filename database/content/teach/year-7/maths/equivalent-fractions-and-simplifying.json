    {
      "heading": "A quick demonstration",
      "lines": [
        {
          "say": "Write two fifths with a denominator of 15.",
          "write": "2/5 = ?/15"
        },
        {
          "say": "What turns 5 into 15? Fifteen divided by 5 is 3.",
          "write": "15 ÷ 5 = 3"
        },
        {
          "say": "Do the same to the top. 2 times 3 is 6.",
          "write": "2 × 3 = 6"
        },
        {
          "say": "So two fifths equals six fifteenths.",
          "write": "2/5 = 6/15"
        }
      ]
    },

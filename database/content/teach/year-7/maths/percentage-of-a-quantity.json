          "say": "Multiply. 0.12 times 45 is 5.4 kilograms.",
          "write": "0.12 × 45 = 5.4 kg"
        },
        {
          "say": "Check by building. Ten per cent is 4.5. One per cent is 0.45.",
          "write": "10% = 4.5   1% = 0.45"
        },
        {
          "say": "Ten plus one plus one is twelve per cent. 4.5 plus 0.45 plus 0.45.",
          "write": "4.5 + 0.45 + 0.45 = 5.4 ✓"
        }
      ]

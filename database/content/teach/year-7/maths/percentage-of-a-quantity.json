    {
      "heading": "Method 1 and 2: fraction or decimal",
      "lines": [
        {
          "say": "Thirty per cent of 250 means thirty per cent times 250.",
          "write": "30% of 250 = 30% × 250"
        },
        {
          "say": "Method one. Write the percentage as a fraction over 100.",
          "write": "30/100 × 250"
        },
        {
          "say": "That gives 7500 over 100, which is 75.",
          "write": "= 7500/100 = 75"
        },
        {
          "say": "Method two. Write the percentage as a decimal, then multiply.",
          "write": "0.3 × 250 = 75"
        },
        {
          "say": "Both methods give the same answer. A calculator likes decimals.",
          "write": "Answer: 75"
        }
      ]
    },

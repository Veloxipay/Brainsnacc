        {
          "say": "As a decimal, 35 hundredths is 0.35.",
          "write": "35% = 35/100 = 0.35"
        },
        {
          "say": "One hundred per cent means the whole thing.",
          "write": "100% = the whole"
        }
      ]
    },
    {
      "heading": "Percentages and fractions",
      "lines": [
        {
          "say": "Percentage to fraction: write it over 100, then simplify.",
          "write": "45% = 45/100"
        },
        {
          "say": "The HCF of 45 and 100 is 5. Divide both by 5.",
          "write": "45/100 = 9/20"
        },
        {
          "say": "Fraction to percentage: try to make the denominator 100.",
          "write": "7/20 = 35/100 = 35%"
        },
        {
          "say": "Or just multiply by 100 per cent.",
          "write": "4/5 × 100% = 80%"
        }
      ]
    },
    {
      "heading": "Percentages and decimals",
      "lines": [
        {
          "say": "Percentage to decimal: divide by 100. Move the point two places left.",
          "write": "35% → 0.35"
        },
        {
          "say": "Eight per cent is 0.08. Don't forget the zero.",
          "write": "8% = 0.08"
        },
        {
          "say": "Decimal to percentage: multiply by 100. Two places right.",
          "write": "0.6 → 60%"
        },
        {
          "say": "Percent to decimal, two steps left. Decimal to percent, two steps right.",
          "write": "% → dec: left   dec → %: right"
        }
      ]
    },
    {
      "heading": "Fractions and decimals",
      "lines": [
        {
          "say": "Every fraction is a division. Top divided by bottom.",
          "write": "top ÷ bottom"
        },
        {
          "say": "Three eighths is 3 divided by 8, which is 0.375.",
          "write": "3/8 = 3 ÷ 8 = 0.375"
        },
        {
          "say": "Times 100 for the percentage. That is 37.5 per cent.",
          "write": "0.375 = 37.5%"
        },
        {
          "say": "One third never ends. It is 0.333 recurring.",
          "write": "1/3 = 0.333…"
        }
      ]
    },
    {
      "heading": "Facts worth knowing",
      "lines": [
        {
          "say": "Here are the quarters, in all three forms.",
          "diagram": "diagrams/y7/maths/fractions-decimals-and-percentages-number-line.svg",
          "alt": "Number line 0 to 1 in quarters as fractions, decimals and percentages"
        },
        {
          "say": "One half is 0.5, which is 50 per cent.",
          "write": "1/2 = 0.5 = 50%"
        },
        {
          "say": "One quarter is 0.25. Three quarters is 0.75.",
          "write": "1/4 = 25%   3/4 = 75%"
        },
        {
          "say": "One fifth is 0.2. One tenth is 0.1. One eighth is 12.5 per cent.",
          "write": "1/5 = 20%  1/10 = 10%  1/8 = 12.5%"
        }
      ]
    },
    {
      "heading": "Comparing scores",
      "lines": [
        {
          "say": "Mia scored 16 out of 25. Jack scored 65 per cent. Lea scored 0.6.",
          "write": "16/25   65%   0.6"
        },
        {
          "say": "Change them all to percentages first.",
          "write": "same form first"
        },
        {
          "say": "Mia: times top and bottom by 4. That is 64 per cent.",
          "write": "16/25 = 64/100 = 64%"
        },
        {
          "say": "Lea: 0.6 times 100 is 60 per cent.",
          "write": "0.6 = 60%"
        },
        {
          "say": "Sixty-five is the biggest. Jack did best.",
          "write": "65% > 64% > 60%",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bars for 65, 64 and 60 per cent, Jack highlighted",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 40,
                "w": 455,
                "h": 50,
                "fill": "blue",
                "change": "highlight",
                "label": "Jack 65%"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 110,
                "w": 448,
                "h": 50,
                "fill": "orange",
                "label": "Mia 64%"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 180,
                "w": 420,
                "h": 50,
                "fill": "green",
                "label": "Lea 60%"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Thirty-five per cent is 0.35, not 3.5.",
          "write": "✗ 35% = 3.5"
        },
        {
          "say": "Eight per cent is 0.08. 0.8 is 80 per cent.",
          "write": "✗ 8% = 0.8"
        },
        {
          "say": "Three eighths is not 0.38. Divide: 0.375.",
          "write": "✗ 3/8 = 0.38"
        },
        {
          "say": "Is 0.7 less than 65 per cent? No. 0.7 is 70 per cent.",
          "write": "0.7 = 70% > 65%"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Per cent means per hundred.",
          "write": "% = per 100"
        },
        {
          "say": "Percent to decimal, divide by 100.",
          "write": "÷ 100"
        },
        {
          "say": "Fraction to decimal, top divided by bottom.",
          "write": "top ÷ bottom"
        },
        {
          "say": "To compare, change everything to the same form.",
          "write": "same form, then compare"
        }
      ]
    }
  ]
}
{
  "level": "Year 7",
  "subject": "maths",
  "title": "Volume and surface area of prisms",
  "frames": [
    {
      "heading": "Slice it, then stack it",
      "lines": [
        {
          "say": "A prism has the same shape all the way along, like sliced bread.",
          "write": "cross-section",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "stacking triangle slices",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    260
                  ],
                  [
                    200,
                    260
                  ],
                  [
                    60,
                    140
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 440,
                "y": 280,
                "text": "1 slice stacked",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "That shape is the cross-section. Stack the slices along the length.",
          "write": "stack along the length",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "stacking triangle slices",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    150,
                    215
                  ],
                  [
                    290,
                    215
                  ],
                  [
                    150,
                    95
                  ]
                ],
                "fill": "yellow",
                "change": "add"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    120,
                    230
                  ],
                  [
                    260,
                    230
                  ],
                  [
                    120,
                    110
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    90,
                    245
                  ],
                  [
                    230,
                    245
                  ],
                  [
                    90,
                    125
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    260
                  ],
                  [
                    200,
                    260
                  ],
                  [
                    60,
                    140
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 440,
                "y": 280,
                "text": "4 slices stacked",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "So the volume is the cross-section area times the length.",
          "write": "V = A × l",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "stacking triangle slices",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    270,
                    155
                  ],
                  [
                    410,
                    155
                  ],
                  [
                    270,
                    35
                  ]
                ],
                "fill": "yellow",
                "change": "add"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    240,
                    170
                  ],
                  [
                    380,
                    170
                  ],
                  [
                    240,
                    50
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    210,
                    185
                  ],
                  [
                    350,
                    185
                  ],
                  [
                    210,
                    65
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    180,
                    200
                  ],
                  [
                    320,
                    200
                  ],
                  [
                    180,
                    80
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    150,
                    215
                  ],
                  [
                    290,
                    215
                  ],
                  [
                    150,
                    95
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    120,
                    230
                  ],
                  [
                    260,
                    230
                  ],
                  [
                    120,
                    110
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    90,
                    245
                  ],
                  [
                    230,
                    245
                  ],
                  [
                    90,
                    125
                  ]
                ],
                "fill": "yellow"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    260
                  ],
                  [
                    200,
                    260
                  ],
                  [
                    60,
                    140
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 440,
                "y": 280,
                "text": "8 slices stacked",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "For a box, the cross-section is a rectangle. That's why it's l times w times h.",
          "write": "V = l × w × h"
        }
      ]
    },
    {
      "heading": "Volume of a triangular prism",
      "lines": [
        {
          "say": "This prism's cross-section is a right-angled triangle. It's 10 centimetres long.",
          "write": "15 cm, 8 cm, 17 cm; l = 10",
          "diagram": "diagrams/y7/maths-advanced/volume-and-surface-area-of-prisms-cross.svg",
          "alt": "Triangular prism 10 cm long with cross-section sides 15, 8 and 17 cm"
        },
        {
          "say": "The two shorter sides meet at the right angle. Half of 15 times 8 is 60.",
          "write": "A = ½ × 15 × 8 = 60 cm²"
        },
        {
          "say": "Times the length. 60 times 10 is 600 cubic centimetres.",
          "write": "V = 60 × 10 = 600 cm³"
        },
        {
          "say": "Don't just multiply three lengths. You'd forget the half.",
          "write": "✗ 15 × 8 × 10"
        }
      ]
    },
    {
      "heading": "Surface area of a box",
      "lines": [
        {
          "say": "Surface area is the total area of the outside. Unfold it into a net.",
          "write": "SA = all the faces",
          "diagram": "diagrams/y7/maths-advanced/volume-and-surface-area-of-prisms-net.svg",
          "alt": "Net of a 5 by 4 by 3 box with faces 20, 15 and 12 cm²"
        },
        {
          "say": "A box has three pairs of matching faces.",
          "write": "20, 15, 12 — each twice",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "three pairs of faces",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 150,
                "h": 120,
                "fill": "blue",
                "label": "5 × 4 = 20"
              },
              {
                "kind": "rect",
                "x": 205,
                "y": 75,
                "w": 150,
                "h": 90,
                "fill": "orange",
                "label": "5 × 3 = 15"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 75,
                "w": 120,
                "h": 90,
                "fill": "green",
                "label": "4 × 3 = 12"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "2 × (20 + 15 + 12)",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Add one of each, then double. 2 times 47 is 94.",
          "write": "SA = 2 × 47 = 94 cm²"
        },
        {
          "say": "The rule is 2 bracket lw plus lh plus wh.",
          "write": "SA = 2(lw + lh + wh)"
        }
      ]
    },
    {
      "heading": "Surface area of a triangular prism",
      "lines": [
        {
          "say": "A triangular prism has 2 triangles and 3 rectangles.",
          "write": "2 triangles + 3 rectangles"
        },
        {
          "say": "The two triangle ends are 60 each. That's 120.",
          "write": "2 × 60 = 120 cm²"
        },
        {
          "say": "Unwrap the rectangles. Together they're the perimeter times the length.",
          "write": "(15 + 8 + 17) × 10 = 400",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "rectangles unwrapped",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 150,
                "h": 100,
                "fill": "blue",
                "label": "15 × 10"
              },
              {
                "kind": "rect",
                "x": 180,
                "y": 60,
                "w": 80,
                "h": 100,
                "fill": "orange",
                "label": "8 × 10"
              },
              {
                "kind": "rect",
                "x": 260,
                "y": 60,
                "w": 170,
                "h": 100,
                "fill": "green",
                "label": "17 × 10"
              },
              {
                "kind": "text",
                "x": 230,
                "y": 210,
                "text": "40 × 10 = 400 cm²",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So the surface area is 120 plus 400. That's 520 square centimetres.",
          "write": "SA = 520 cm²"
        }
      ]
    },
    {
      "heading": "Capacity in litres",
      "lines": [
        {
          "say": "A trough has a trapezium cross-section. 80 across the top, 50 across the bottom, 30 deep.",
          "write": "trapezium, l = 200 cm",
          "diagram": "diagrams/y7/maths-advanced/volume-and-surface-area-of-prisms-trough.svg",
          "alt": "Trapezium prism trough 80 by 50 by 30 deep, 200 cm long"
        },
        {
          "say": "Area: half of 80 plus 50, times 30. That's 1950.",
          "write": "½ × (80 + 50) × 30 = 1950 cm²"
        },
        {
          "say": "Times the length of 200. That's 390 thousand cubic centimetres.",
          "write": "V = 390 000 cm³"
        },
        {
          "say": "1000 cubic centimetres is 1 litre. So it holds 390 litres.",
          "write": "390 000 ÷ 1000 = 390 L"
        },
        {
          "say": "A 1 centimetre cube holds 1 millilitre. 1 cubic metre is 1000 litres.",
          "write": "1 cm³ = 1 mL, 1 m³ = 1000 L"
        }
      ]
    },
    {
      "heading": "Working backwards",
      "lines": [
        {
          "say": "Know the volume? Divide by the cross-section to get the length.",
          "write": "l = V ÷ A"
        },
        {
          "say": "A 600 cubic centimetre prism with a 60 square centimetre end is 10 long.",
          "write": "600 ÷ 60 = 10 cm"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Volume fills. Surface area covers. Cubed for volume, squared for area.",
          "write": "cm³ fills, cm² covers"
        },
        {
          "say": "Don't miss the hidden faces: the bottom, back and ends.",
          "write": "tick each face"
        },
        {
          "say": "An open box has one face fewer. Read the question.",
          "write": "open box: no lid",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "open box",
            "items": [
              {
                "kind": "rect",
                "x": 140,
                "y": 120,
                "w": 280,
                "h": 140,
                "fill": "blue"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    140,
                    120
                  ],
                  [
                    200,
                    60
                  ],
                  [
                    480,
                    60
                  ],
                  [
                    420,
                    120
                  ]
                ],
                "fill": "teal",
                "change": "remove"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    420,
                    120
                  ],
                  [
                    480,
                    60
                  ],
                  [
                    480,
                    200
                  ],
                  [
                    420,
                    260
                  ]
                ],
                "fill": "blue"
              }
            ]
          }
        },
        {
          "say": "1 cubic metre is 1000 litres, not 100.",
          "write": "✗ 1 m³ = 100 L"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Volume of any prism: cross-section area times length.",
          "write": "V = A × l"
        },
        {
          "say": "Surface area: add every face. Use a net.",
          "write": "SA = sum of faces"
        },
        {
          "say": "Triangular prism: 2 triangles plus perimeter times length.",
          "write": "2 triangles + P × l"
        },
        {
          "say": "1000 cubic centimetres is 1 litre.",
          "write": "1000 cm³ = 1 L"
        }
      ]
    }
  ]
}
{
  "level": "Year 7",
  "subject": "maths",
  "title": "Collecting and classifying data",
  "frames": [
    {
      "heading": "What is data?",
      "lines": [
        {
          "say": "Data is a collection of facts, like answers, counts or measurements.",
          "write": "data = facts, counts, measures"
        },
        {
          "say": "A variable is the thing you collect data about, like favourite sport.",
          "write": "variable: favourite sport"
        },
        {
          "say": "It is called a variable because the answer varies from person to person."
        },
        {
          "say": "How tall am I has one answer. That is not a statistical question.",
          "write": "✗ How tall am I?"
        },
        {
          "say": "How tall are the students in my class? That one is statistical.",
          "write": "✓ How tall is my class?"
        }
      ]
    },

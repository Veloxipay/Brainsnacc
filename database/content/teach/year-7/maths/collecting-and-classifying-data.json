                "size": 20,
                "anchor": "middle",
                "bold": true,
                "color": "white"
              }
            ]
          }
        },
        {
          "say": "A sample is the smaller part you actually ask.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A sample of 24 inside the population of 600",
            "items": [
              {
                "kind": "circle",

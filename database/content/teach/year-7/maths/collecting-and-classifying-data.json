                "size": 20,
                "anchor": "middle",
                "change": "add",
                "bold": true,
                "color": "white"
              }
            ]
          }
        },
        {
          "say": "A good sample is representative, like a mini version of the population.",
          "write": "representative"
        },
        {
          "say": "Asking only the basketball team about sport gives a biased sample.",
          "write": "biased = leans one way"
        },
        {
          "say": "Use fair questions. Ask how many minutes of homework you did.",
          "write": "✓ How many minutes…?"
        }
      ]
    },
    {
      "heading": "Tally and frequency tables",
      "lines": [
        {
          "say": "Frequency means how many times something happens.",
          "write": "frequency = how many times"
        },
        {
          "say": "Fifteen students said how many pets they have. List every value first.",
          "write": "0, 1, 2, 3, 4"
        },
        {
          "say": "Tally each answer once. Four sticks and a gate across make five.",
          "diagram": "diagrams/y7/maths/collecting-and-classifying-data-ex2.svg",
          "alt": "Tally and frequency table for number of pets"
        },
        {
          "say": "Check the total matches. 4 plus 6 plus 3 plus 1 plus 1 is 15.",
          "write": "4 + 6 + 3 + 1 + 1 = 15 ✓"
        },
        {
          "say": "Two or more pets means 2, 3 or 4. That is 5 students.",
          "write": "3 + 1 + 1 = 5"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Postcodes and jersey numbers are labels. They are categorical.",
          "write": "postcode → categorical"
        },
        {
          "say": "Would an average make sense? If not, it is categorical.",
          "write": "average test"
        },
        {
          "say": "Age is measured time, so it is continuous.",
          "write": "age → continuous"
        },
        {
          "say": "If nobody had 3 pets, still write 3 with frequency zero.",
          "write": "3 pets | 0"
        },
        {
          "say": "Leading questions and one-sided samples give unfair results.",
          "write": "avoid bias"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Categorical is labels. Numerical is numbers.",
          "write": "labels vs numbers"
        },
        {
          "say": "Count it, discrete. Measure it, continuous.",
          "write": "count: discrete  measure: continuous"
        },
        {
          "say": "A sample should look like the whole population.",
          "write": "sample ≈ population"
        },
        {
          "say": "List every value and check the frequency total.",
          "write": "check the total ✓"
        }
      ]
    }
  ]
}
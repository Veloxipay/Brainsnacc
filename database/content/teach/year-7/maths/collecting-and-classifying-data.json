    {
      "heading": "Collecting data",
      "lines": [
        {
          "say": "A survey asks people questions.",
          "write": "survey"
        },
        {
          "say": "An observation means watching and recording, like counting cars.",
          "write": "observation"
        },
        {
          "say": "An experiment means doing something and recording what happens.",
          "write": "experiment"
        },
        {
          "say": "A simulation uses dice, coins or a computer to act it out.",
          "write": "simulation"
        },
        {
          "say": "Data you collect yourself is primary. Someone else's is secondary.",
          "write": "primary = mine  secondary = theirs"
        }
      ]
    },
    {
      "heading": "Population and sample",
      "lines": [
        {
          "say": "The population is the whole group you want to know about.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Population of 600 students",
            "items": [
              {
                "kind": "circle",

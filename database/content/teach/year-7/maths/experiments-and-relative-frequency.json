{
  "level": "Year 7",
  "subject": "maths",
  "title": "Experiments and relative frequency",
  "frames": [
    {
      "heading": "Theory and experiment",
      "lines": [
        {
          "say": "Theoretical probability is what you expect by thinking.",
          "write": "theory = think"
        },
        {
          "say": "For a fair coin, the chance of a head is one half.",
          "write": "P(head) = 1/2"
        },
        {
          "say": "An experiment is something you repeat, like tossing a coin.",
          "write": "experiment = count"
        },
        {
          "say": "Each go is a trial. You record the results in a table.",
          "write": "trial = one go"
        }
      ]
    },
    {
      "heading": "Relative frequency",
      "lines": [
        {
          "say": "Relative frequency is the number of times it happened, over the number of trials.",
          "write": "RF = happened ÷ trials"
        },

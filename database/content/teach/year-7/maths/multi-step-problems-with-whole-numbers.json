    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't drop the remainder. Five buses leaves 35 people behind.",
          "write": "✗ 5 buses"
        },
        {
          "say": "Use brackets so the steps happen in the right order.",
          "write": "50 − (18 + 12) = 20",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "brackets matter",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "50 − 18 + 12 = 44",
                "size": 30,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 160,
                "text": "50 − (18 + 12) = 20",
                "size": 30,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "A bigger pack costs more, but may be cheaper per item.",
          "write": "compare unit rates"
        },
        {
          "say": "Re-read the question. Did it ask for Sam's cards or Tia's?",
          "write": "answer the question"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Read, plan, solve, check. Every time.",
          "write": "R · P · S · C"
        },
        {
          "say": "Remainders: round up, round down, or use what's left.",
          "write": "remainder rule"
        },
        {
          "say": "Bars for more than problems. Undo steps to work backwards.",
          "write": "bars · backwards"
        },
        {
          "say": "Estimate first, so a silly answer stands out.",
          "write": "estimate ✓"
        }
      ]
    }

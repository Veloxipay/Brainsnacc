{
  "level": "Year 7",
  "subject": "maths",
  "title": "Multi-step problems with whole numbers",
  "frames": [
    {
      "heading": "Read, plan, solve, check",
      "lines": [
        {
          "say": "Real problems take several steps. Use a four-stage plan.",
          "write": "Read · Plan · Solve · Check"
        },
        {
          "say": "Read. What's being asked? Cross out extra information.",
          "write": "1. Read"
        },
        {
          "say": "Plan. Which operations, in which order? Use brackets.",
          "write": "2. Plan"
        },
        {
          "say": "Solve it carefully. Then check: does the answer make sense?",
          "write": "3. Solve  4. Check"
        }
      ]
    },

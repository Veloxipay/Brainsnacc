                "text": "gears line up",
                "size": 17,
                "color": "white",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Biggest equal groups or largest tile means HCF.",
          "write": "largest → HCF"
        },
        {
          "say": "Happening together again, or matching packs, means LCM.",
          "write": "together again → LCM"
        },
        {
          "say": "Size check. The HCF is at most the smallest number.",
          "write": "HCF ≤ smallest"
        },
        {
          "say": "The LCM is at least the biggest number.",
          "write": "LCM ≥ biggest"
        }
      ]
    },

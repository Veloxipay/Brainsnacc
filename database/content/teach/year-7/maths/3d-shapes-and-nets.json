    {
      "heading": "Prisms",
      "lines": [
        {
          "say": "A prism has two identical ends, joined by rectangles.",
          "write": "prism"
        },
        {
          "say": "Slice it anywhere, and the slice is the same shape. Like a loaf.",
          "write": "same cross-section"
        },
        {
          "say": "Name it after its ends. This one has hexagon ends.",
          "write": "hexagonal prism",
          "diagram": "diagrams/y7/maths/3d-shapes-and-nets-ex1.svg",
          "alt": "Hexagonal prism with hidden edges dashed"
        },
        {
          "say": "If the base has n sides: n plus 2 faces, 2n vertices, 3n edges.",
          "write": "F = n + 2, V = 2n, E = 3n"
        },
        {
          "say": "A hexagon has 6 sides. 8 faces, 12 vertices, 18 edges.",
          "write": "8, 12, 18"
        }
      ]
    },
    {
      "heading": "Pyramids",
      "lines": [
        {
          "say": "A pyramid has one base. Triangles meet at a point, the apex.",
          "write": "apex",
          "diagram": "diagrams/y7/maths/3d-shapes-and-nets-ex2.svg",
          "alt": "Square-based pyramid"
        },
        {
          "say": "Faces and vertices are both n plus 1. Edges are 2n.",
          "write": "F = V = n + 1, E = 2n"
        },
        {
          "say": "A square base has 4 sides. 5 faces, 5 vertices, 8 edges.",
          "write": "5, 5, 8"
        },
        {
          "say": "Cylinders, cones and spheres have curved surfaces. They're not polyhedra.",
          "write": "curved → not a polyhedron"
        }
      ]
    },
    {
      "heading": "Euler's rule",
      "lines": [
        {
          "say": "For any polyhedron, faces plus vertices minus edges equals 2.",
          "write": "F + V − E = 2"
        },
        {
          "say": "Cube: 6 plus 8 minus 12 is 2. Tick.",
          "write": "6 + 8 − 12 = 2 ✓"
        },
        {
          "say": "A solid has 7 faces and 15 edges. How many vertices?",
          "write": "7 + V − 15 = 2",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 1,
              "cubes": -8
            },
            "right": {
              "cubes": 2
            }
          }
        },
        {
          "say": "Add 8 to both sides. V equals 10.",
          "write": "V = 10",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 1,
              "cubes": -8
            },
            "right": {
              "cubes": 2
            },
            "remove": 8,
            "removeFrom": "left",
            "add": 8,
            "addTo": "right",
            "labels": [
              "V − 8 + 8",
              "2 + 8"
            ]
          }
        },
        {
          "say": "It doesn't work for curved solids, like a cylinder.",
          "write": "polyhedra only"
        }
      ]
    },
    {
      "heading": "Nets",
      "lines": [
        {
          "say": "Cut a cereal box along some edges. It lies flat. That's the net.",
          "write": "net"
        },

        {
          "say": "A triangular prism net has 2 triangles and 3 rectangles.",
          "write": "2 △ + 3 ▭"
        },
        {
          "say": "A square-based pyramid net has 1 square and 4 triangles.",
          "write": "1 □ + 4 △"
        }
      ]
    },
    {
      "heading": "Which solid is it?",
      "lines": [
        {
          "say": "This net has 2 identical pentagons and 5 rectangles.",
          "write": "2 pentagons, 5 rectangles",
          "diagram": "diagrams/y7/maths/3d-shapes-and-nets-ex4.svg",
          "alt": "Net of a pentagonal prism"
        },
        {
          "say": "Two identical ends plus rectangles means a prism.",
          "write": "prism"
        },
        {
          "say": "The ends are pentagons. So it's a pentagonal prism.",
          "write": "pentagonal prism"
        },
        {
          "say": "Check: 5 plus 2 is 7 faces. The net has 7 shapes.",
          "write": "7 faces ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Edges are the lines. Vertices are the pointy corners.",
          "write": "edge ≠ vertex"
        },
        {
          "say": "Don't name a prism by its sides. They're all rectangles.",
          "write": "name it by its ends"
        },
        {
          "say": "Not every 6 squares make a cube. Imagine folding it.",
          "write": "fold it in your head"
        },
        {
          "say": "Count with the rules, then check with Euler.",
          "write": "F + V − E = 2"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Prism: n plus 2 faces, 2n vertices, 3n edges.",
          "write": "n + 2, 2n, 3n"
        },
        {
          "say": "Pyramid: n plus 1 faces and vertices, 2n edges.",
          "write": "n + 1, n + 1, 2n"
        },
        {
          "say": "Faces visit edges, and 2 is the answer.",
          "write": "F + V − E = 2"
        },
        {
          "say": "A net shows every face exactly once.",
          "write": "net: each face once"
        }
      ]
    }
  ]

    {
      "heading": "Roots from prime factors",
      "lines": [
        {
          "say": "Find root 1764. First, write it as primes.",
          "write": "1764 = 2² × 3² × 7²"
        },
        {
          "say": "Every index is even, so it's a perfect square.",
          "write": "even indices → square"
        },
        {
          "say": "To square root, halve every index.",
          "write": "2¹ × 3¹ × 7¹",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "halving indices",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "2² × 3² × 7²",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 85,
                "x2": 280,
                "y2": 135,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 180,
                "text": "2 × 3 × 7 = 42",
                "size": 36,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "2 times 3 times 7 is 42. Check: 42 squared is 1764.",
          "write": "√1764 = 42"
        },
        {
          "say": "72 is 2 cubed times 3 squared. Times by 2 to make a square: 144.",
          "write": "72 × 2 = 144 = 12²"
        }
      ]
    },

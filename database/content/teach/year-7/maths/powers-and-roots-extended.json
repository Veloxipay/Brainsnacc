    {
      "heading": "Patterns and order",
      "lines": [
        {
          "say": "Powers of 7 end in 7, 9, 3, 1, then repeat.",
          "write": "7, 9, 3, 1, 7, 9, 3, 1",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "last digit cycle",
            "items": [
              {
                "kind": "circle",

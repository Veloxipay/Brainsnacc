    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Multiplying powers? Add the indices. Don't multiply them.",
          "write": "5³ × 5⁴ = 5⁷",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "wrong vs right",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "5³ × 5⁴ = 5¹²",
                "size": 30,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 120,
                "text": "5³ × 5⁴ = 25⁷",
                "size": 30,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "5³ × 5⁴ = 5⁷",
                "size": 30,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "The base stays the same. Never multiply the bases.",
          "write": "base stays"
        },
        {
          "say": "2 cubed is 8, not 6. Say it out loud: 2 times 2 times 2.",
          "write": "2³ = 8"
        },
        {
          "say": "Anything except zero, to the power zero, is 1, not 0.",
          "write": "7⁰ = 1"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Multiply, add. Divide, subtract. Power of a power, multiply.",
          "write": "× add · ÷ subtract · ( )ⁿ ×"
        },
        {
          "say": "Even indices mean a perfect square. Halve them to find the root.",
          "write": "√ → halve indices"
        },
        {
          "say": "Cube roots undo cubes. Cube root of 125 is 5.",
          "write": "∛125 = 5"
        },
        {
          "say": "Estimate a root with the squares either side.",
          "write": "√90 between 9 and 10"
        }
      ]
    }
  ]

    {
      "heading": "Algebra",
      "lines": [
        {
          "say": "Expand 3 bracket 2x plus 5. That's 6x plus 15.",
          "write": "3(2x + 5) = 6x + 15"
        },
        {
          "say": "Take away 4x. Collect like terms to get 2x plus 15.",
          "write": "6x + 15 − 4x = 2x + 15",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Like terms 6x and −4x combine to 2x",
            "items": [
              {
                "kind": "rect",
                "x": 80,
                "y": 70,
                "w": 110,
                "h": 60,
                "fill": "blue",
                "label": "6x"
              },
              {
                "kind": "rect",
                "x": 200,
                "y": 70,
                "w": 110,
                "h": 60,
                "fill": "orange",
                "label": "+ 15"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 70,
                "w": 110,
                "h": 60,
                "fill": "blue",
                "label": "− 4x",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "2x + 15",
                "size": 40,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Substitute x equals 7. 14 plus 15 is 29.",
          "write": "2(7) + 15 = 29"
        }
      ]

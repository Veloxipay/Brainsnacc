    {
      "heading": "How to use this review",
      "lines": [
        {
          "say": "This review mixes chapters 1 to 5, just like a real test.",
          "write": "Chapters 1 to 5"
        },
        {
          "say": "About 45 minutes. 5 short answers, then 20 multiple choice.",
          "write": "45 min, no calculator"
        },
        {
          "say": "Give yourself a mark for each correct step, not just the answer.",
          "write": "marks for steps"
        },
        {
          "say": "80 per cent or more, you're ready for Semester 2.",
          "write": "80%+ ready"
        }
      ]
    },
    {
      "heading": "Whole numbers: estimate first",
      "lines": [
        {
          "say": "28 boxes of 144 pencils. Estimate with leading digits. 30 times 100.",
          "write": "30 × 100 = 3000"
        },
        {
          "say": "Exact: 144 times 8 is 1152. 144 times 20 is 2880.",
          "write": "1152 + 2880 = 4032"
        },
        {
          "say": "4032 is close to 3000, so it makes sense.",
          "write": "estimate ✓",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Estimate bar compared with exact bar",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 300,
                "h": 60,
                "fill": "grey",
                "label": "estimate 3000"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 140,
                "w": 403,
                "h": 60,
                "fill": "blue",
                "label": "exact 4032",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "same size? ✓",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Share between 9 classes. 4032 divided by 9 is 448.",
          "write": "4032 ÷ 9 = 448"
        }
      ]
    },

    {
      "heading": "Before Semester 2",
      "lines": [
        {
          "say": "BIDMAS. Brackets first, then times and divide, then plus and minus.",
          "write": "BIDMAS"
        },
        {
          "say": "What you do to the top, you do to the bottom.",
          "write": "top and bottom"
        },
        {
          "say": "Only like terms add, but any terms multiply.",
          "write": "like terms add"
        },
        {
          "say": "Line up points to add. Count decimal places to multiply.",
          "write": "line up · count places"
        }
      ]
    }

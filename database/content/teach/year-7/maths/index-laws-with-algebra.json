{
  "level": "Year 7",
  "subject": "maths",
  "title": "Index laws with algebra",
  "frames": [
    {
      "heading": "The index is a counter",
      "lines": [
        {
          "say": "a cubed means three a's multiplied together.",
          "write": "a³ = a × a × a",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "three a tiles",
            "items": [
              {
                "kind": "circle",
                "x": 40,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 100,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 160,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "a³ → 3 copies",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "The small number is the index. The a is the base.",
          "write": "base a, index 3"
        },
        {
          "say": "Now times a cubed by a to the four. Join the two lines.",
          "write": "a³ × a⁴",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "joining 3 and 4 tiles",
            "items": [
              {
                "kind": "circle",
                "x": 40,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 100,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 160,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 60,
                "r": 24,
                "fill": "orange",
                "label": "a",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 60,
                "r": 24,
                "fill": "orange",
                "label": "a",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 340,
                "y": 60,
                "r": 24,
                "fill": "orange",
                "label": "a",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 400,
                "y": 60,
                "r": 24,
                "fill": "orange",
                "label": "a",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "3 + 4 = 7 copies",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "That's seven a's in a row. So a to the seven.",
          "write": "a³ × a⁴ = a⁷"
        },
        {
          "say": "The laws only work when the bases are the same.",
          "write": "same base only"
        }
      ]
    },
    {
      "heading": "Multiplying: add the indices",
      "lines": [
        {
          "say": "When you multiply powers of the same base, add the indices.",
          "write": "aᵐ × aⁿ = aᵐ⁺ⁿ"
        },
        {
          "say": "x to the four times x squared is x to the six.",
          "write": "x⁴ × x² = x⁶"
        },
        {
          "say": "With numbers in front, multiply the numbers, then add the indices.",
          "write": "3x⁴ × 5x²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "coefficients and indices",
            "items": [
              {
                "kind": "text",
                "x": 150,
                "y": 60,
                "text": "3 × 5 = 15",
                "size": 28,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 410,
                "y": 60,
                "text": "4 + 2 = 6",
                "size": 28,
                "color": "orange",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "arrow",
                "x": 150,
                "y": 85,
                "x2": 240,
                "y2": 150,
                "color": "purple"
              },
              {
                "kind": "arrow",
                "x": 410,
                "y": 85,
                "x2": 320,
                "y2": 150,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "15x⁶",
                "size": 40,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Three times five is 15. Four plus two is 6.",
          "write": "= 15x⁶"
        },
        {
          "say": "Don't add the numbers in front. 4x squared times 3x is 12x cubed.",
          "write": "4x² × 3x = 12x³"
        }
      ]
    },
    {
      "heading": "Dividing: subtract the indices",
      "lines": [
        {
          "say": "Dividing cancels copies. So subtract the indices.",
          "write": "aᵐ ÷ aⁿ = aᵐ⁻ⁿ"
        },
        {
          "say": "a to the seven divided by a squared. Cancel two a's.",
          "write": "a⁷ ÷ a²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "cancelling two a tiles",
            "items": [
              {
                "kind": "circle",
                "x": 40,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "circle",
                "x": 100,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "circle",
                "x": 160,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 340,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 400,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "7 − 2 = 5 copies",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Five a's are left. So a to the five.",
          "write": "a⁷ ÷ a² = a⁵",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "five a tiles left",
            "items": [
              {
                "kind": "circle",
                "x": 160,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 340,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "circle",
                "x": 400,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "a⁵",
                "size": 30,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "With numbers, divide them. 24 divided by 8 is 3.",
          "write": "24a⁷ ÷ 8a² = 3a⁵"
        },
        {
          "say": "A letter on its own has an invisible index of 1.",
          "write": "b = b¹"
        },
        {
          "say": "So 24 a to the seven b cubed over 8 a squared b is 3 a to the five b squared.",
          "write": "24a⁷b³ ÷ 8a²b = 3a⁵b²"
        }
      ]
    },
    {
      "heading": "Powers of powers and brackets",
      "lines": [
        {
          "say": "x cubed, all to the power 4. That's four lots of x cubed.",
          "write": "(x³)⁴ = x³ × x³ × x³ × x³",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "four groups of three",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 30,
                "w": 110,
                "h": 60,
                "fill": "blue",
                "label": "x³"
              },
              {
                "kind": "rect",
                "x": 160,
                "y": 30,
                "w": 110,
                "h": 60,
                "fill": "orange",
                "label": "x³"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 30,
                "w": 110,
                "h": 60,
                "fill": "green",
                "label": "x³"
              },
              {
                "kind": "rect",
                "x": 420,
                "y": 30,
                "w": 110,
                "h": 60,
                "fill": "pink",
                "label": "x³"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "3 + 3 + 3 + 3 = 12",
                "size": 26,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Power of a power: multiply the indices. Three times four is 12.",
          "write": "(aᵐ)ⁿ = aᵐⁿ"
        },
        {
          "say": "With a bracket, every factor inside gets the power.",
          "write": "(ab)ⁿ = aⁿbⁿ"
        },
        {
          "say": "2 x cubed, squared. Square the 2 as well. You get 4x to the six.",
          "write": "(2x³)² = 4x⁶",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "raising every factor",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "(2x³)²",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 240,
                "y": 85,
                "x2": 170,
                "y2": 140,
                "color": "purple"
              },
              {
                "kind": "arrow",
                "x": 320,
                "y": 85,
                "x2": 390,
                "y2": 140,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 170,
                "y": 180,
                "text": "2² = 4",
                "size": 28,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 390,
                "y": 180,
                "text": "(x³)² = x⁶",
                "size": 28,
                "color": "orange",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "2 x cubed y, to the four, is 16 x to the twelve y to the four.",
          "write": "(2x³y)⁴ = 16x¹²y⁴"
        }
      ]
    },
    {
      "heading": "The zero index",
      "lines": [
        {
          "say": "a cubed divided by a cubed. Anything divided by itself is 1.",
          "write": "a³ ÷ a³ = 1",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "all tiles cancel",
            "items": [
              {
                "kind": "circle",
                "x": 100,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "circle",
                "x": 160,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 60,
                "r": 24,
                "fill": "blue",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 340,
                "y": 60,
                "text": "÷",
                "size": 30,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "circle",
                "x": 400,
                "y": 60,
                "r": 24,
                "fill": "orange",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "circle",
                "x": 460,
                "y": 60,
                "r": 24,
                "fill": "orange",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "circle",
                "x": 520,
                "y": 60,
                "r": 24,
                "fill": "orange",
                "label": "a",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 160,
                "text": "= 1",
                "size": 36,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "But the subtract rule says a to the three minus three. That's a to the zero.",
          "write": "a³⁻³ = a⁰"
        },
        {
          "say": "So a to the zero is 1, not 0.",
          "write": "a⁰ = 1"
        },
        {
          "say": "Careful. 3x to the zero is 3 times 1, which is 3.",
          "write": "3x⁰ = 3"
        },
        {
          "say": "But bracket 3x, to the zero, is just 1.",
          "write": "(3x)⁰ = 1"
        }
      ]
    },
    {
      "heading": "Finding a missing index",
      "lines": [
        {
          "say": "2 to the n times 2 cubed equals 2 to the ten. Find n.",
          "write": "2ⁿ × 2³ = 2¹⁰"
        },
        {
          "say": "Multiplying means add the indices. So n plus 3 equals 10.",
          "write": "n + 3 = 10",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 1,
              "cubes": 3
            },
            "right": {
              "cubes": 10
            }
          }
        },
        {
          "say": "Take 3 from both sides. n equals 7.",
          "write": "n = 7",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 1,
              "cubes": 3
            },
            "right": {
              "cubes": 10
            },
            "remove": 3,
            "labels": [
              "n + 3 − 3",
              "10 − 3"
            ]
          }
        },
        {
          "say": "Check: 128 times 8 is 1024. That's 2 to the ten.",
          "write": "2⁷ × 2³ = 1024 = 2¹⁰ ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Multiplying powers? Add the indices, don't multiply them.",
          "write": "x⁵ × x³ = x⁸",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "wrong vs right",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "x⁵ × x³ = x¹⁵",
                "size": 32,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 160,
                "text": "x⁵ × x³ = x⁸",
                "size": 32,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Raise the number in the bracket too. Bracket 2a cubed, to the four, is 16a to the twelve.",
          "write": "(2a³)⁴ = 16a¹²"
        },
        {
          "say": "Different bases never combine. x cubed times y squared stays as it is.",
          "write": "x³ × y² = x³y²"
        },
        {
          "say": "Remember the invisible 1 on a letter with no index.",
          "write": "x = x¹"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Times means add the indices.",
          "write": "× → add indices"
        },
        {
          "say": "Divide means subtract the indices.",
          "write": "÷ → subtract indices"
        },
        {
          "say": "Bracket power means multiply the indices. Everything inside gets the power.",
          "write": "( )ⁿ → multiply"
        },
        {
          "say": "Anything except zero, to the power zero, is 1.",
          "write": "a⁰ = 1"
        },
        {
          "say": "Numbers first, then each letter in turn.",
          "write": "numbers, then letters"
        }
      ]
    }
  ]
}
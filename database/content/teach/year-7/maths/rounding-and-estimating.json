        {
          "say": "4 or less? Leave the rounding digit alone.",
          "write": "4 or less → leave it"
        },
        {
          "say": "Watch the nines. 2950 to the nearest hundred carries to 3000.",
          "write": "2950 → 3000"
        }
      ]
    },
    {
      "heading": "Halfway rounds up",
      "lines": [
        {
          "say": "Round 73 500 to the nearest thousand. The thousands digit is 3.",
          "write": "73 500"
        },
        {
          "say": "The decider is 5. That means round up.",
          "write": "decider 5 → up",
          "diagram": "diagrams/y7/maths/rounding-and-estimating-halfway.svg",
          "alt": "73 500 halfway between 73 000 and 74 000"
        },
        {
          "say": "3 becomes 4, and the rest become zeros.",
          "write": "74 000"
        }
      ]
    },
    {
      "heading": "Rounding to the leading digit",
      "lines": [
        {
          "say": "The leading digit is the first non-zero digit.",
          "write": "leading digit"
        },
        {
          "say": "Keep one non-zero digit. 587 becomes 600.",
          "write": "587 → 600"
        },
        {
          "say": "42 becomes 40. 8213 becomes 8000.",
          "write": "42 → 40   8213 → 8000"
        },
        {
          "say": "This is how we round before estimating.",
          "write": "round, then estimate"
        }
      ]
    },
    {
      "heading": "Estimating",
      "lines": [
        {
          "say": "Estimate 587 times 42. Round each to its leading digit.",
          "write": "587 × 42 ≈ 600 × 40"
        },
        {
          "say": "6 times 4 is 24. Put back three zeros. 24 000.",
          "write": "≈ 24 000"
        },
        {
          "say": "The exact answer is 24 654. Very close.",
          "write": "exact: 24 654"
        },
        {
          "say": "This wavy equals sign means approximately equal.",
          "write": "≈ means \"about\""
        },
        {
          "say": "Estimate 8213 divided by 394. That's about 8000 divided by 400.",
          "write": "8000 ÷ 400 = 20"
        }
      ]
    },
    {
      "heading": "Estimates catch mistakes",
      "lines": [
        {
          "say": "A calculator says 7 times 412 is 28 840.",
          "write": "7 × 412 = 28 840 ?"
        },
        {
          "say": "Estimate. 7 times 400 is 2800.",
          "write": "7 × 400 = 2800"
        },
        {
          "say": "That's ten times smaller. There's an extra zero.",
          "write": "28 840 ✗   2884 ✓",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Wrong answer crossed out, correct answer added",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "28 840",
                "size": 40,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 160,
                "text": "2884",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "estimate ≈ 2800",
                "size": 22,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Round up before multiplying, and your estimate is usually too big.",
          "write": "round up → too big"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Fill with zeros. 4682 rounds to 4700, not 47.",
          "write": "✗ 47   ✓ 4700"
        },
        {
          "say": "The decider is right next to the rounding digit. Nowhere else.",
          "write": "next digit only"
        },
        {
          "say": "Don't round twice. 1449 to the nearest hundred is 1400.",
          "write": "1449 → 1400"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Five or more, raise the score. Four or less, let it rest.",
          "write": "5+ up   4- rest"
        },
        {
          "say": "Underline the rounding digit. Arrow to the decider.",
          "write": "underline and arrow"
        },
        {
          "say": "Halfway goes up.",
          "write": "halfway → up"
        },
        {
          "say": "Estimate before you press equals.",
          "write": "estimate first"
        }
      ]
    }
  ]
}

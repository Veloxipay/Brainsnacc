    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't use 360. That's for quadrilaterals. A triangle is 180.",
          "write": "triangle = 180°"
        },
        {
          "say": "Isosceles base angles sit at the ends of the odd side.",
          "write": "find the odd side"
        },
        {
          "say": "For the exterior angle, add the two angles not next to it.",
          "write": "not the neighbour"
        },
        {
          "say": "A triangle can have only one right or obtuse angle.",
          "write": "at most one ≥ 90°"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Three angles, half a turn, 180 degrees.",
          "write": "angle sum = 180°"
        },
        {
          "say": "Equilateral, isosceles, scalene. All, two, none equal.",
          "write": "all · two · none"
        },
        {
          "say": "Exterior angle equals the two opposite interior angles.",
          "write": "ext = sum of opposite"
        },
        {
          "say": "Tear off the corners if you ever forget.",
          "write": "straight line ✓"
        }
      ]
    }

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Triangles",
  "frames": [
    {
      "heading": "Naming triangles by sides",
      "lines": [
        {
          "say": "A triangle has three straight sides. Bridges use them because they can't squash.",
          "write": "3 sides"
        },
        {
          "say": "Equilateral means all three sides equal. Each angle is 60 degrees.",
          "write": "equilateral: all equal",
          "diagram": "diagrams/y7/maths/triangles-equilateral.svg",
          "alt": "Equilateral triangle with a dash on each side"
        },
        {
          "say": "Isosceles means two sides equal. The base angles are equal too.",
          "write": "isosceles: 2 equal"
        },
        {
          "say": "Scalene means no sides equal, and no angles equal.",
          "write": "scalene: none equal"
        },
        {
          "say": "Matching dash marks show which sides are equal.",
          "write": "dashes = equal sides"
        }
      ]
    },
    {
      "heading": "Naming triangles by angles",
      "lines": [
        {
          "say": "Acute angled means all three angles are acute.",
          "write": "acute-angled"
        },
        {
          "say": "Right angled means one angle is 90 degrees.",
          "write": "right-angled: one 90°"
        },
        {
          "say": "Obtuse angled means one angle is obtuse.",
          "write": "obtuse-angled"
        },
        {
          "say": "A triangle can have both names. A right angled isosceles triangle.",
          "write": "right-angled isosceles"
        }
      ]
    },

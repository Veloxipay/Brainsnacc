    {
      "heading": "Routes on a grid",
      "lines": [
        {
          "say": "You may only go right or up. How many shortest routes from A to B?",
          "diagram": "diagrams/y7/maths-advanced/logic-puzzles-and-systematic-counting-paths.svg",
          "alt": "2 by 2 grid with route counts 1, 1, 1, 2, 3 and 6 at B"
        },
        {
          "say": "Each corner gets the number on its left plus the number below.",
          "write": "left + below"
        },
        {
          "say": "Edges have 1 route each. The middle gets 1 plus 1, which is 2.",
          "write": "1 + 1 = 2"
        },
        {
          "say": "Keep adding. B gets 3 plus 3, which is 6 routes.",
          "write": "B: 3 + 3 = 6"
        }
      ]
    },

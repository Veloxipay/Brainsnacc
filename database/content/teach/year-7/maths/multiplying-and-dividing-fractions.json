{
  "level": "Year 7",
  "subject": "maths",
  "title": "Multiplying and dividing fractions",
  "frames": [
    {
      "heading": "Multiplying fractions",
      "lines": [
        {
          "say": "To multiply, do tops times tops and bottoms times bottoms.",
          "write": "tops × tops, bottoms × bottoms"
        },
        {
          "say": "Two thirds times four fifths.",
          "write": "2/3 × 4/5"
        },
        {
          "say": "Two times 4 is 8. Three times 5 is 15.",
          "write": "= 8/15"
        },
        {
          "say": "In a picture, the shadings overlap in 8 of 15 parts.",
          "diagram": "diagrams/y7/maths/multiplying-and-dividing-fractions-area-model.svg",
          "alt": "Area model showing 2/3 × 4/5 = 8/15"
        },
        {
          "say": "No common denominator needed."
        }
      ]
    },
    {
      "heading": "A fraction of an amount",
      "lines": [

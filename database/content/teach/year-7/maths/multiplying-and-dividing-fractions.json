    {
      "heading": "Cancel first",
      "lines": [
        {
          "say": "Four ninths times three eighths. Look for common factors.",
          "write": "4/9 × 3/8"
        },
        {
          "say": "4 and 8 share 4. They become 1 and 2.",
          "write": "4 → 1,  8 → 2"
        },
        {
          "say": "3 and 9 share 3. They become 1 and 3.",
          "write": "3 → 1,  9 → 3"
        },
        {
          "say": "Now multiply. One over 3 times 2, which is one sixth.",
          "write": "= 1/6"
        },
        {
          "say": "Mixed numbers? Change them to improper fractions first.",
          "write": "1½ × 2⅔ = 3/2 × 8/3 = 4"
        }
      ]
    },
    {
      "heading": "Dividing fractions",
      "lines": [
        {
          "say": "How many quarters fit in 3? Four in each whole.",
          "write": "3 ÷ 1/4",

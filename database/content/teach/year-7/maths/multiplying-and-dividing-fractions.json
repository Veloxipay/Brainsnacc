        {
          "say": "So dividing by a quarter is the same as times 4.",
          "write": "÷ 1/4 = × 4"
        },
        {
          "say": "The reciprocal is the fraction flipped. Three fifths becomes five thirds.",
          "write": "3/5 → 5/3"
        },
        {
          "say": "Keep, change, flip. Keep the first, change to times, flip the second.",
          "write": "2/3 ÷ 4/5 = 2/3 × 5/4"
        },
        {
          "say": "That gives ten twelfths, which simplifies to five sixths.",
          "write": "= 10/12 = 5/6"
        }
      ]
    },
    {
      "heading": "Scoops of flour",
      "lines": [
        {
          "say": "How many three-quarter cup scoops are in 2 and a quarter cups?",
          "write": "2¼ ÷ ¾"
        },
        {
          "say": "Change to an improper fraction: nine quarters.",
          "write": "9/4 ÷ 3/4"
        },
        {
          "say": "Keep, change, flip.",
          "write": "9/4 × 4/3"
        },
        {
          "say": "Cancel the 4s. Nine and 3 become 3 and 1. Three scoops.",
          "write": "= 3 scoops"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't find a common denominator when multiplying.",
          "write": "just multiply"
        },
        {
          "say": "Flip only the second fraction, the one you divide by.",
          "write": "flip the second"
        },
        {
          "say": "Don't multiply mixed numbers in parts.",
          "write": "✗ 1½ × 2⅔ = 2⅓"
        },
        {
          "say": "Four times two thirds is eight thirds, not eight twelfths.",
          "write": "4/1 × 2/3 = 8/3"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Of means times.",
          "write": "of = ×"
        },
        {
          "say": "Tops times tops, bottoms times bottoms.",
          "write": "a/b × c/d = ac/bd"
        },
        {
          "say": "To divide: keep, change, flip.",
          "write": "keep, change, flip"
        },
        {
          "say": "Cancel before you calculate.",
          "write": "cancel first"
        }
      ]
    }
  ]

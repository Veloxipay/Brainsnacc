{
  "level": "Year 7",
  "subject": "maths",
  "title": "Integers on the number line",
  "frames": [
    {
      "heading": "What are integers?",
      "lines": [
        {
          "say": "Integers are whole numbers, their negatives, and zero.",
          "write": "… −3, −2, −1, 0, 1, 2, 3 …"
        },
        {
          "say": "Positive integers are greater than zero. We usually leave off the plus sign.",
          "write": "4 means +4"
        },
        {
          "say": "Negative integers are less than zero. They always have a minus sign.",
          "write": "−1, −2, −3"
        },
        {
          "say": "Zero is neither positive nor negative.",
          "write": "0: neither"
        },
        {
          "say": "Two and a half is not an integer. It is not whole.",
          "write": "2.5 ✗"
        }
      ]
    },
    {
      "heading": "The number line",
      "lines": [
        {
          "say": "Zero sits in the middle. Positives go right, negatives go left.",

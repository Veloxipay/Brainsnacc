    {
      "heading": "Distance between integers",
      "lines": [
        {
          "say": "Canberra was minus 5 degrees at dawn, and 4 degrees by lunch.",
          "write": "−5 °C → 4 °C"
        },
        {
          "say": "Count from minus 5 up to zero. That is 5 degrees.",
          "write": "−5 → 0: 5",
          "draw": {
            "type": "numberline",
            "from": -6,
            "to": 5,
            "start": -5,
            "jump": 5
          }
        },
        {
          "say": "Then from zero up to 4. That is 4 more.",
          "write": "0 → 4: 4",
          "draw": {
            "type": "numberline",
            "from": -6,
            "to": 5,
            "start": 0,
            "jump": 4
          }
        },
        {
          "say": "Crossing zero? Add the parts. It rose 9 degrees.",
          "write": "5 + 4 = 9",
          "diagram": "diagrams/y7/maths/integers-on-the-number-line-ex2.svg",
          "alt": "Brackets showing 5 and 4 degrees"
        },
        {
          "say": "Same side of zero? Subtract. Minus 9 to minus 2 is 7 steps.",
          "write": "9 − 2 = 7"
        }
      ]
    },
    {
      "heading": "A diver",
      "lines": [
        {
          "say": "A diver is at minus 14 metres. She swims up 4.",
          "write": "−14 + 4",
          "draw": {
            "type": "numberline",
            "from": -15,
            "to": 0,
            "start": -14,
            "jump": 4
          }
        },
        {
          "say": "Up means right. She is now at minus 10.",
          "write": "−10 m"
        },
        {
          "say": "Her friend is 7 metres above her. Count 7 more to the right.",
          "draw": {
            "type": "numberline",
            "from": -15,
            "to": 0,
            "start": -10,
            "jump": 7
          }
        },
        {
          "say": "Her friend is at minus 3 metres.",
          "write": "−3 m"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Minus 8 is not bigger than minus 3. It is further left.",
          "write": "−8 < −3"
        },
        {
          "say": "Count zero as a step. 1 down to minus 2 is 3 steps.",
          "write": "1 → 0 → −1 → −2"
        },
        {
          "say": "Minus 3 to 9 is not 6. Crossing zero, add: 3 plus 9.",
          "write": "3 + 9 = 12"
        },
        {
          "say": "Zero is not positive. It is the middle.",
          "write": "0: neither"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Right is bright, left is less.",
          "write": "right = greater"
        },
        {
          "say": "Minus 10 degrees is colder than minus 2. So it is smaller.",
          "write": "−10 < −2"
        },
        {
          "say": "Opposites are mirror images across zero.",
          "write": "6 ↔ −6"
        },
        {
          "say": "Cross zero? Add the two distances.",
          "write": "cross 0 → add"
        }
      ]
    }
  ]
}
{
  "level": "Year 7",
  "subject": "maths",
  "title": "Solving equations by backtracking",
  "frames": [
    {
      "heading": "Socks and shoes",
      "lines": [
        {
          "say": "Backtracking solves an equation by working backwards.",
          "write": "backtracking = work backwards"
        },
        {
          "say": "In the morning, socks go on first, then shoes.",
          "write": "socks → shoes"
        },
        {
          "say": "At night you undo it in reverse. Shoes off first.",
          "write": "shoes off → socks off"
        },
        {
          "say": "Last on, first off. That's the whole idea.",
          "write": "last on, first off"
        }
      ]
    },
    {
      "heading": "Inverse operations",
      "lines": [
        {
          "say": "An inverse operation undoes another one.",
          "write": "inverse = undo"
        },
        {
          "say": "Plus 5 is undone by minus 5. Minus 5 is undone by plus 5.",
          "write": "+ 5 ↔ − 5"
        },
        {
          "say": "Times 3 is undone by divide by 3.",
          "write": "× 3 ↔ ÷ 3"
        },
        {
          "say": "Add 5, then take 5. You're back where you started.",
          "write": "+ 5 − 5 = back to start",
          "draw": {
            "type": "numberline",
            "from": 0,
            "to": 12,
            "start": 4,
            "jump": 5
          }
        },
        {
          "say": "Then jump back 5 to where you began.",
          "draw": {
            "type": "numberline",
            "from": 0,
            "to": 12,
            "start": 9,
            "jump": -5
          }
        }
      ]
    },

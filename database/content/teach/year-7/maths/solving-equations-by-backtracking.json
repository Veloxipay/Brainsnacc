    {
      "heading": "Fractions and brackets",
      "lines": [
        {
          "say": "x over 4 means x divided by 4. Undo it with times 4.",
          "write": "x/4 → ÷ 4, undo × 4"
        },
        {
          "say": "Solve x over 4 minus 3 equals 5. Undo minus 3 first.",
          "write": "5 + 3 = 8"
        },
        {
          "say": "Then undo divide by 4. 8 times 4 is 32.",
          "write": "8 × 4 = 32 → x = 32"
        },
        {
          "say": "With brackets, the bracket goes first. 2 times, x plus 6.",
          "write": "2(x + 6) = 30",
          "diagram": "diagrams/y7/maths/solving-equations-by-backtracking-brackets.svg",
          "alt": "Flowchart for 2(x + 6) = 30 and its undo row"
        },
        {
          "say": "Plus 6 happened first, times 2 last. So divide by 2 first.",
          "write": "30 ÷ 2 = 15"
        },
        {
          "say": "Then take 6. 15 minus 6 is 9.",
          "write": "15 − 6 = 9 → x = 9"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't undo in the wrong order. Undo the last operation first.",
          "write": "undo right to left"
        },
        {
          "say": "Use the inverse, not the same operation again.",
          "write": "+ 5 undone by − 5"
        },
        {
          "say": "In 3x plus 5, times comes before plus, even though plus is written last.",
          "write": "× before +"
        },
        {
          "say": "Always check by putting your answer back in.",
          "write": "check ✓"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Socks and shoes. Last on, first off.",
          "write": "last on, first off"
        },
        {
          "say": "Plus and minus are partners. Times and divide are partners.",
          "write": "+ ↔ −   × ↔ ÷"
        },
        {
          "say": "Build left to right. Solve right to left.",
          "write": "build →   ← solve"
        },
        {
          "say": "Write the undo operation on every backward arrow.",
          "write": "write the inverses"
        }
      ]
    }
  ]

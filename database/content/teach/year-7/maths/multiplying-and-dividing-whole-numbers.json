        {
          "say": "The remainder must always be smaller than the divisor.",
          "write": "remainder < divisor"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "In the tens row, write the zero first. Not 692, but 6920.",
          "write": "✗ 692   ✓ 6920"
        },
        {
          "say": "Can't go? Write a zero. 4832 divided by 8 is 604, not 64.",
          "write": "4832 ÷ 8 = 604"
        },
        {
          "say": "Multiply every part. Seven times 48 is not 7 times 40 plus 8.",
          "write": "✗ 7 × 40 + 8"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Zero first for the tens row.",
          "write": "zero first"
        },
        {
          "say": "Can't go? Write a zero.",
          "write": "write a 0"
        },
        {
          "say": "Hunt for 100s. Four times 25, 2 times 50.",
          "write": "4 × 25 = 100"
        },
        {
          "say": "Check: quotient times divisor, plus remainder.",
          "write": "q × d + r = dividend"
        }
      ]
    }
  ]

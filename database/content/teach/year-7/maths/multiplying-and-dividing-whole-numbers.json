{
  "level": "Year 7",
  "subject": "maths",
  "title": "Multiplying and dividing whole numbers",
  "frames": [
    {
      "heading": "The words",
      "lines": [
        {
          "say": "In 6 times 12 equals 72, the answer 72 is the product.",
          "write": "6 × 12 = 72  (product)"
        },
        {
          "say": "In 72 divided by 12 equals 6, the answer 6 is the quotient.",
          "write": "72 ÷ 12 = 6  (quotient)"
        },
        {
          "say": "72 is the dividend. 12 is the divisor.",
          "write": "dividend ÷ divisor"
        },
        {
          "say": "Multiplying and dividing undo each other.",
          "write": "× and ÷ are inverses"
        }
      ]
    },
    {
      "heading": "Laws that help",
      "lines": [
        {
          "say": "Order doesn't matter when multiplying. That is the commutative law.",
          "write": "7 × 48 = 48 × 7"
        },
        {
          "say": "Pair any two first. Hunt for 4 times 25, which is 100.",
          "write": "(4 × 25) × 9 = 900"
        },
        {
          "say": "Distributive law: split a number into parts. Here is 7 times 48.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Area model for 7 times 48",
            "items": [

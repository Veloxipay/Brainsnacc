        },
        {
          "say": "Division is not commutative. And never divide by zero.",
          "write": "72 ÷ 9 ≠ 9 ÷ 72"
        }
      ]
    },
    {
      "heading": "Mental tricks",
      "lines": [
        {
          "say": "Twenty-five times 36. Split 36 into 4 times 9.",
          "write": "25 × 4 × 9"
        },
        {
          "say": "Twenty-five times 4 is 100. A hundred times 9 is 900.",
          "write": "25 × 36 = 900"
        },
        {
          "say": "Times 10 moves every digit one place left.",
          "write": "× 100 → 2 places"
        },
        {
          "say": "Six times 700 is 6 times 7, times 100. That is 4200.",
          "write": "6 × 700 = 4200"
        }
      ]
    },
    {
      "heading": "Long multiplication",
      "lines": [
        {
          "say": "346 times 27. Do the 7 first. That is 2422.",
          "write": "346 × 7 = 2422"
        },
        {
          "say": "The 2 in 27 is really 20. Write a zero first, then times 2.",
          "write": "346 × 20 = 6920"
        },
        {
          "say": "Add the two rows. 9342.",
          "write": "2422 + 6920 = 9342",
          "diagram": "diagrams/y7/maths/multiplying-and-dividing-whole-numbers-long.svg",
          "alt": "Area model for 346 × 27"
        },
        {
          "say": "Estimate: 350 times 30 is 10 500. A bit more, which makes sense.",
          "write": "≈ 10 500"
        }
      ]
    },
    {
      "heading": "Short division",
      "lines": [
        {
          "say": "1739 divided by 6. Work from the left.",
          "write": "1739 ÷ 6"
        },
        {
          "say": "Six into 17 goes 2, remainder 5. Carry the 5 to make 53.",
          "write": "17 ÷ 6 = 2 r 5"
        },
        {
          "say": "Six into 53 goes 8, remainder 5. Carry it to make 59.",
          "write": "53 ÷ 6 = 8 r 5"
        },
        {
          "say": "Six into 59 goes 9, remainder 5. Answer: 289 remainder 5.",
          "write": "289 r 5"
        },
        {
          "say": "Check: 289 times 6, plus 5, gives back 1739.",
          "write": "289 × 6 + 5 = 1739 ✓"
        }
      ]
    },
    {

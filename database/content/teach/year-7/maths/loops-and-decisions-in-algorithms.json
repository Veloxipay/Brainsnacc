    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't stop one too early or too late. Use a trace table.",
          "write": "trace table"
        },
        {
          "say": "Greater than 30 leaves out 30. At least 30 includes it.",
          "write": "> 30   ≥ 30"
        },
        {
          "say": "The starting value is not an iteration.",
          "write": "start ≠ iteration"
        },
        {
          "say": "Each new row starts from the row above.",
          "write": "use the new value"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Sequence, selection, repetition.",
          "write": "SSR"
        },
        {
          "say": "At least includes the line.",
          "write": "at least 50 includes 50"
        },
        {
          "say": "A counter goes up by 1 each time, like laps in a pool.",
          "write": "count + 1"
        },
        {
          "say": "Can the condition ever be true? If not, it never stops."
        }
      ]
    }

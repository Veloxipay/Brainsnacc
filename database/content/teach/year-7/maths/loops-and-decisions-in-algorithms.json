    {
      "heading": "A decision inside a loop",
      "lines": [
        {
          "say": "Repeat until 1. If even, halve it. If odd, times 3 plus 1.",
          "write": "even: ÷ 2   odd: × 3 + 1"
        },
        {
          "say": "Start at 10. Ten is even, so halve it to 5.",
          "write": "10 → 5"
        },
        {
          "say": "Five is odd. Five times 3 plus 1 is 16.",
          "write": "5 → 16"
        },
        {
          "say": "Then halve: 8, 4, 2, 1. Stop at 1.",
          "write": "16 → 8 → 4 → 2 → 1"
        },
        {
          "say": "Seven numbers, but only 6 moves. So 6 iterations.",
          "write": "6 iterations"
        }
      ]
    },
    {
      "heading": "Loops that never stop",
      "lines": [

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Loops and decisions in algorithms",
  "frames": [
    {
      "heading": "Three building blocks",
      "lines": [
        {
          "say": "Every algorithm is built from three things.",
          "write": "sequence, selection, repetition"
        },
        {
          "say": "Sequence: steps done one after another, in order.",
          "write": "sequence"
        },
        {
          "say": "Decision: a yes or no question that chooses what happens next.",
          "write": "if … then … otherwise"
        },
        {
          "say": "Loop: a group of steps done again and again.",
          "write": "repeat"
        }
      ]
    },
    {
      "heading": "Decisions",
      "lines": [
        {
          "say": "A decision checks a condition. It is either true or false.",
          "write": "condition: true / false"
        },

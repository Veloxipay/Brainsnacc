    {
      "heading": "Counted loops",
      "lines": [
        {
          "say": "A counted loop repeats a fixed number of times.",
          "write": "repeat 3 times"
        },
        {
          "say": "Start with x equals 4. Repeat 3 times: add 5, then double.",
          "write": "x = 4"
        },
        {
          "say": "First time: 4 plus 5 is 9. Doubled is 18.",
          "write": "9 → 18"
        },
        {
          "say": "Second time: start from 18. Add 5 is 23. Double is 46.",
          "write": "23 → 46"
        },
        {
          "say": "Third time: 46 plus 5 is 51. Double is 102. Output 102.",
          "write": "51 → 102"
        }
      ]
    },

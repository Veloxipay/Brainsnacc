    {
      "heading": "Finding a missing value",
      "lines": [
        {
          "say": "Jess has a mean of 85 on 4 tests.",
          "write": "mean 85, 4 tests"
        },
        {
          "say": "Mean times count gives the total. 85 times 4 is 340.",
          "write": "85 × 4 = 340"
        },
        {
          "say": "Her first three marks add to 250.",
          "write": "82 + 90 + 78 = 250"
        },
        {
          "say": "Three hundred and forty minus 250 is 90.",
          "write": "4th mark = 90"
        }
      ]
    },

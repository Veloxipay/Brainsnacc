{
  "level": "Year 7",
  "subject": "maths",
  "title": "Mean, median, mode and range",
  "frames": [
    {
      "heading": "Measures of centre",
      "lines": [
        {
          "say": "A measure of centre is one number that describes the typical value.",
          "write": "centre = typical value"
        },
        {
          "say": "There are three: mean, median and mode.",
          "write": "mean, median, mode"
        },
        {
          "say": "The range is different. It measures spread.",
          "write": "range = spread"
        }
      ]
    },
    {
      "heading": "The mean",
      "lines": [
        {
          "say": "The mean is the sum of the values, divided by how many there are.",
          "write": "mean = sum ÷ count"
        },
        {
          "say": "Four friends have 12, 15, 9 and 4 lollies.",
          "diagram": "diagrams/y7/maths/mean-median-mode-and-range-mean.svg",
          "alt": "Column graph of 12, 15, 9, 4 with mean line at 10"
        },
        {
          "say": "Share them equally. Forty lollies between 4 is 10 each.",
          "write": "40 ÷ 4 = 10"
        },
        {
          "say": "Data: 7, 3, 9, 3, 8. The sum is 30. There are 5 values.",
          "write": "30 ÷ 5 = 6"
        }
      ]
    },

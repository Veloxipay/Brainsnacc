    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Order the data before finding the median.",
          "write": "order first"
        },
        {
          "say": "Divide by how many values there are, zeros included.",
          "write": "÷ count"
        },
        {
          "say": "The range is 6, not 3 to 9.",
          "write": "✗ 3 to 9   ✓ 6"
        },
        {
          "say": "If 3 appears twice, the mode is 3, not 2.",
          "write": "mode is a data value"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "The median is the middle. Add and divide for the mean.",
          "write": "median middle, mean share"
        },
        {
          "say": "The mode appears the most.",
          "write": "mode = most"
        },
        {
          "say": "Range is top minus bottom.",
          "write": "range = max − min"
        },
        {
          "say": "One giant value can't push the median around.",
          "write": "outlier → median"
        }
      ]
    }
  ]

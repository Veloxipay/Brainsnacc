        }
      ]
    },
    {
      "heading": "More practice",
      "lines": [
        {
          "say": "3mn plus 4 minus nm plus 6. mn and nm are like terms.",
          "write": "3mn + 4 − nm + 6"
        },
        {
          "say": "Three mn minus 1mn is 2mn. Four plus 6 is 10.",
          "write": "2mn + 10"
        },
        {
          "say": "Two x squared plus 5x minus x squared plus 3x.",
          "write": "2x² + 5x − x² + 3x"
        },
        {
          "say": "X squared terms give x squared. X terms give 8x.",
          "write": "x² + 8x"
        },
        {
          "say": "Add the three sides of this triangle for its perimeter.",
          "diagram": "diagrams/y7/maths/like-terms-and-simplifying-triangle.svg",
          "alt": "Triangle with sides 2x + 3, x + 1 and 3x − 2"
        },
        {
          "say": "X terms make 6x. Numbers make 2. So 6x plus 2 centimetres.",
          "write": "P = 6x + 2 cm"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "3a plus 4b is not 7ab. Different letters can't combine.",
          "write": "✗ 3a + 4b = 7ab"
        },
        {
          "say": "5m plus 2 is not 7m.",
          "write": "✗ 5m + 2 = 7m"
        },
        {
          "say": "In 6y plus 2 minus 4y, it is minus 4y. So 2y plus 2.",
          "write": "6y + 2 − 4y = 2y + 2"
        },
        {
          "say": "X plus x is 2x. Not x squared.",
          "write": "x + x = 2x"
        },
        {
          "say": "3x plus 2x squared is not 5x cubed. They stay separate.",
          "write": "✗ 3x + 2x² = 5x³"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Apples with apples. Only identical letters and powers add.",
          "write": "same letters, same powers"
        },
        {
          "say": "Circle each term with its sign, colour, then combine.",
          "write": "circle, colour, combine"
        },
        {
          "say": "Only the numbers change. The letters ride along.",
          "write": "4x + 6x = 10x"
        },
        {
          "say": "Check by putting a small number in.",
          "write": "substitute to check"
        }
      ]
    }
  ]
}
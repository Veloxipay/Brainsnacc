{
  "level": "Year 7",
  "subject": "maths",
  "title": "Like terms and simplifying",
  "frames": [
    {
      "heading": "What are like terms?",
      "lines": [
        {
          "say": "Like terms have exactly the same letters, with the same powers.",
          "write": "like terms"
        },
        {
          "say": "4x and 9x are like terms. Both have just x.",
          "write": "4x and 9x ✓"
        },
        {
          "say": "3ab and minus ab are like terms. Both have ab.",
          "write": "3ab and −ab ✓"
        },
        {
          "say": "pq and qp are like terms too, because p times q equals q times p.",
          "write": "2pq and 5qp ✓"
        },
        {
          "say": "Numbers on their own are constants. They are like each other.",
          "write": "7 and −2 ✓"
        }
      ]
    },
    {
      "heading": "Not like terms",
      "lines": [
        {
          "say": "4x and 4y have different letters. Not alike.",
          "write": "4x and 4y ✗"
        },
        {
          "say": "3a and 3ab are different. The second also has b.",
          "write": "3a and 3ab ✗"
        },
        {
          "say": "x and x squared are different. X squared is x times x.",
          "write": "x and x² ✗"
        },
        {
          "say": "5m and 5 are different. One has a letter.",
          "write": "5m and 5 ✗"
        }
      ]
    },
    {
      "heading": "Collecting like terms",
      "lines": [
        {
          "say": "Four lots of x plus 6 lots of x.",
          "write": "4x + 6x",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "Terms as coloured tiles",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 50,
                "w": 52,
                "h": 60,
                "fill": "blue",
                "label": "4x"
              },
              {
                "kind": "rect",
                "x": 86,
                "y": 50,
                "w": 84,
                "h": 60,
                "fill": "blue",
                "label": "+ 6x"
              }
            ]
          }
        },
        {
          "say": "Add the numbers. The letter rides along. Ten x.",
          "write": "4x + 6x = 10x",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "Terms as coloured tiles",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 50,
                "w": 52,
                "h": 60,
                "fill": "blue",
                "change": "remove",
                "label": "4x"
              },
              {
                "kind": "rect",
                "x": 86,
                "y": 50,
                "w": 84,
                "h": 60,
                "fill": "blue",
                "change": "remove",
                "label": "+ 6x"
              },
              {
                "kind": "rect",
                "x": 184,
                "y": 50,
                "w": 68,
                "h": 60,
                "fill": "blue",
                "change": "add",
                "label": "10x"
              }
            ]
          }
        },
        {
          "say": "Five k minus k is 4k. Remember k means 1k.",
          "write": "5k − k = 4k"
        },
        {
          "say": "3a plus 4b can't be simplified. Different letters stay apart.",
          "write": "3a + 4b"
        }
      ]
    },
    {
      "heading": "Keep the sign with the term",

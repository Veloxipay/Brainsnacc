{
  "level": "Year 7",
  "subject": "maths",
  "title": "Multiplying and dividing terms",
  "frames": [
    {
      "heading": "Multiplying terms",
      "lines": [
        {
          "say": "Multiply 3a by 4b. Multiplying can be done in any order.",
          "write": "3a × 4b"
        },
        {
          "say": "Regroup: numbers together, letters together.",
          "write": "3 × 4 × a × b"
        },
        {
          "say": "Three times 4 is 12. Then write the letters, a b.",
          "write": "3a × 4b = 12ab"
        },
        {
          "say": "You don't need like terms to multiply.",
          "write": "5x × 2y = 10xy"
        },
        {
          "say": "Check with a equals 2, b equals 3. Both sides give 72.",
          "write": "72 = 72 ✓"
        }
      ]
    },
    {
      "heading": "Same letter twice",
      "lines": [
        {
          "say": "A times a is written a squared.",
          "write": "a × a = a²",
          "diagram": "diagrams/y7/maths/multiplying-and-dividing-terms-square.svg",
          "alt": "A square with sides a and area a squared"
        },
        {
          "say": "Two x times 5x. Ten, then x times x.",
          "write": "2x × 5x = 10x²"
        },
        {
          "say": "Don't write 2a. That means a plus a.",
          "write": "a × a ≠ 2a"
        },
        {
          "say": "Minus 3m times 2n times n. Different signs give minus 6.",
          "write": "−3m × 2n × n = −6mn²"
        }
      ]
    },
    {
      "heading": "Dividing terms",
      "lines": [
        {
          "say": "Write a division as a fraction. Twelve x y over 4x.",
          "write": "12xy ÷ 4x = 12xy/4x",

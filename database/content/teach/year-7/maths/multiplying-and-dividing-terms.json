    },
    {
      "heading": "Area of a rectangle",
      "lines": [
        {
          "say": "A rectangle is 3x long and 2y wide.",
          "diagram": "diagrams/y7/maths/multiplying-and-dividing-terms-rectangle.svg",
          "alt": "Rectangle 3x by 2y"
        },
        {
          "say": "Area is length times width. Three x times 2y is 6xy.",
          "write": "A = 3x × 2y = 6xy"
        },
        {
          "say": "If x is 2 and y is 5, the area is 60 square centimetres.",
          "write": "6 × 2 × 5 = 60 cm²"
        },
        {
          "say": "Check: the sides are 6 and 10. Six times 10 is 60.",
          "write": "6 × 10 = 60 ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Three a times 4b is not 7ab. Multiply the numbers.",
          "write": "✗ 7ab   ✓ 12ab"
        },
        {
          "say": "Twelve x y divided by 4x is not 3xy. Cancel the letters too.",
          "write": "✗ 3xy   ✓ 3y"
        },
        {
          "say": "Four x divided by 12 is x over 3, not 3x.",
          "write": "4x ÷ 12 = x/3"
        },
        {
          "say": "Only adding and subtracting need like terms.",
          "write": "× needs no twins"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Numbers with numbers, letters with letters.",
          "write": "12ab"
        },
        {
          "say": "Same letter twice is squared.",
          "write": "a × a = a²"
        },
        {
          "say": "To divide, write a fraction, then cancel.",
          "write": "fraction, then cancel"
        },
        {
          "say": "Check by multiplying back.",
          "write": "check ✓"
        }
      ]
    }

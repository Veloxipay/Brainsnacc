{
  "level": "Year 7",
  "subject": "maths",
  "title": "Substitution",
  "frames": [
    {
      "heading": "What is substitution?",
      "lines": [
        {
          "say": "An expression is like a recipe card with a blank to fill in.",
          "write": "recipe with blanks"
        },
        {
          "say": "Substitute means replace each letter with a number.",
          "write": "substitute = swap in",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "n swapped for 3 in 12n + 5",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "12n + 5",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 244,
                "y": 32,
                "w": 30,
                "h": 52,
                "fill": "none",
                "change": "remove"
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 95,
                "x2": 280,
                "y2": 140,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 195,
                "text": "12(3) + 5 = 41",
                "size": 40,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "when n = 3",
                "size": 20,
                "color": "grey",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Evaluate means work out the value.",
          "write": "evaluate = work it out"
        },
        {
          "say": "Spreadsheets and taxi meters do this all day long.",
          "write": "formula → price"
        }
      ]
    },
    {
      "heading": "Brackets around the swap",
      "lines": [
        {
          "say": "Evaluate 4x minus 3 when x is 5.",
          "write": "4x − 3,  x = 5",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Substituting x = 5 into 4x − 3",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "4x − 3",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Take out the x and put in 5, in brackets.",
          "write": "4(5) − 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Substituting x = 5 into 4x − 3",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "4x − 3",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 240,
                "y": 22,
                "w": 32,
                "h": 52,
                "fill": "none",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "4(5) − 3",
                "size": 40,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "The bracket next to 4 means multiply. 4 times 5 is 20.",
          "write": "4 × 5 = 20",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Substituting x = 5 into 4x − 3",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "4x − 3",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 240,
                "y": 22,
                "w": 32,
                "h": 52,
                "fill": "none"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "4(5) − 3",
                "size": 40,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "= 20 − 3",
                "size": 36,
                "color": "purple",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Then subtract 3. The answer is 17.",
          "write": "= 17",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Substituting x = 5 into 4x − 3",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "4x − 3",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 240,
                "y": 22,
                "w": 32,
                "h": 52,
                "fill": "none"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "4(5) − 3",
                "size": 40,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "= 20 − 3",
                "size": 36,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 285,
                "text": "= 17",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Without brackets you might write 45. That's wrong.",
          "write": "✗ 45"
        }
      ]
    },
    {
      "heading": "Keep BIDMAS",
      "lines": [
        {
          "say": "After you substitute, follow the order of operations.",
          "write": "B I D M A S"
        },
        {
          "say": "Brackets, indices, divide and multiply, then add and subtract.",
          "write": "B → I → D M → A S"
        },
        {
          "say": "2a plus ab, with a equals 3 and b equals 6.",
          "write": "2(3) + (3)(6)"
        },
        {
          "say": "Multiply first. 6 plus 18 gives 24.",
          "write": "6 + 18 = 24"
        },
        {
          "say": "2 plus 3x, when x is 4. Multiply first. 2 plus 12 is 14.",
          "write": "2 + 3(4) = 14"
        }
      ]
    },
    {
      "heading": "Squares need care",
      "lines": [
        {
          "say": "In 3a squared, only the a is squared.",
          "write": "3a²"
        },
        {
          "say": "If a is 4, that's 3 times 16, which is 48.",
          "write": "3 × 4² = 3 × 16 = 48",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 150,
            "alt": "The power touches only the a",
            "items": [
              {
                "kind": "text",
                "x": 150,
                "y": 90,
                "text": "3",
                "size": 56,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 215,
                "y": 90,
                "text": "a",
                "size": 56,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 245,
                "y": 55,
                "text": "2",
                "size": 30,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 380,
                "y": 90,
                "text": "= 48",
                "size": 44,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "In bracket 3a squared, the whole bracket is squared.",
          "write": "(3a)²"
        },
        {
          "say": "3 times 4 is 12. 12 squared is 144.",
          "write": "(3 × 4)² = 12² = 144",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 150,
            "alt": "The power covers the whole bracket",
            "items": [
              {
                "kind": "text",
                "x": 120,
                "y": 90,
                "text": "(3a)",
                "size": 56,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 195,
                "y": 55,
                "text": "2",
                "size": 30,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "rect",
                "x": 50,
                "y": 40,
                "w": 135,
                "h": 70,
                "fill": "none",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 380,
                "y": 90,
                "text": "= 144",
                "size": 44,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "x squared is x times x. Not 2x. If x is 6, that's 36.",
          "write": "x² = x × x"
        }
      ]
    },
    {
      "heading": "Formulas",
      "lines": [
        {
          "say": "A formula connects variables. The perimeter of a square is 4s.",
          "write": "P = 4s",
          "diagram": "diagrams/y7/maths/substitution-square.svg",
          "alt": "A square with sides s and the formula P = 4s"
        },
        {
          "say": "A plumber charges 15h plus 40 dollars. h is the hours.",
          "write": "C = 15h + 40"
        },
        {
          "say": "For a 3 hour job, put 3 in brackets for h.",
          "write": "C = 15(3) + 40"
        },
        {
          "say": "15 times 3 is 45. Plus 40 is 85 dollars.",
          "write": "C = 45 + 40 = $85"
        },
        {
          "say": "A fraction bar acts like brackets. Add the top first, then divide.",
          "write": "(p + q)/4"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't join digits. 4x with x equals 5 is 20, not 45.",
          "write": "4(5) = 20"
        },
        {
          "say": "Don't square the 3 in 3a squared.",
          "write": "3a² ≠ (3a)²"
        },
        {
          "say": "Don't just go left to right. Multiply before you add.",
          "write": "BIDMAS"
        },
        {
          "say": "Sense check. A 3 hour job costing 1585 dollars is wrong.",
          "write": "does it make sense?"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Brackets around the swap.",
          "write": "( ) around the number"
        },
        {
          "say": "BIDMAS still rules after you substitute.",
          "write": "BIDMAS"
        },
        {
          "say": "The power hugs only its neighbour.",
          "write": "3a²: only a squared"
        },
        {
          "say": "Fill in the blanks, then follow the steps in order.",
          "write": "recipe card"
        }
      ]
    }
  ]
}

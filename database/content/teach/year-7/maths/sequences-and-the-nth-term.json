    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "The constant is not the first term. 4n plus 7 is wrong.",
          "write": "✗ 4n + 7",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "wrong constant",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "Tₙ = 4n + 7",
                "size": 32,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 160,
                "text": "Tₙ = 4n + 3",
                "size": 32,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "The difference multiplies n. Don't write n plus 4.",
          "write": "✗ n + 4"
        },
        {
          "say": "Going down? Subtract the n part, and the constant is bigger.",
          "write": "66 − 6n"
        },
        {
          "say": "n is where a term is. Tn is what it is.",
          "write": "n = where, Tₙ = what"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Difference times n, then step back to zero.",
          "write": "Tₙ = dn + (T₁ − d)"
        },
        {
          "say": "Always test T1 and T2 in your rule.",
          "write": "check T₁, T₂"
        },
        {
          "say": "Is it a term? Solve it, then ask: is n whole?",
          "write": "n whole? → yes"
        },
        {
          "say": "Adding is steady. Multiplying explodes.",
          "write": "arithmetic vs geometric"
        }
      ]
    }

          "say": "T10 is 3 times 2 to the nine. That's 1536.",
          "write": "Tₙ = 3 × 2ⁿ⁻¹"
        },
        {
          "say": "Square numbers: 1, 4, 9, 16. The gaps go 3, 5, 7.",
          "write": "Tₙ = n²"
        },
        {
          "say": "Same difference, arithmetic. Same ratio, geometric. Gaps up by 2, think n squared.",
          "write": "+ steady · × explodes"
        }

    {
      "heading": "Going down",
      "lines": [
        {
          "say": "60, 54, 48. Now the difference is minus 6.",
          "write": "d = −6",
          "draw": {
            "type": "numberline",
            "from": -10,
            "to": 70,
            "start": 60,
            "jump": -6
          }
        },
        {
          "say": "Step back one: 60 plus 6 is 66. So Tn is 66 minus 6n.",
          "write": "Tₙ = 66 − 6n"
        },
        {
          "say": "T11 is 66 take 66, which is zero. Zero isn't negative.",
          "write": "T₁₁ = 0"
        },
        {
          "say": "T12 is minus 6. That's the first negative term.",
          "write": "T₁₂ = −6",
          "draw": {
            "type": "numberline",
            "from": -10,
            "to": 10,
            "start": 0,
            "jump": -6
          }
        }
      ]

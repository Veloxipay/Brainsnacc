    {
      "heading": "Is it a term?",
      "lines": [
        {
          "say": "The rule is 7n minus 2. Is 166 a term?",
          "write": "7n − 2 = 166"
        },
        {
          "say": "Add 2 to both sides. 7n is 168. n is 24. Yes, it's T24.",
          "write": "n = 24 ✓"
        },
        {
          "say": "Is 150 a term? 7n would be 152.",
          "write": "7n = 152"
        },
        {
          "say": "152 over 7 is about 21.7. Not a whole number, so no.",
          "write": "n = 21.7… ✗"
        },
        {
          "say": "A position must be a positive whole number.",
          "write": "n = 1, 2, 3, …"
        }
      ]
    },

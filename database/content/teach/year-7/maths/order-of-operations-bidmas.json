    {
      "heading": "Brackets and indices",
      "lines": [
        {
          "say": "4 times, 15 minus 3 times 3, plus 2 cubed.",
          "write": "4 × (15 − 3 × 3) + 2³"
        },
        {
          "say": "Inside the brackets, multiply first. 15 minus 9 is 6.",
          "write": "(15 − 9) = 6"
        },
        {
          "say": "Indices next. 2 cubed is 2 times 2 times 2, which is 8.",
          "write": "2³ = 8"
        },
        {
          "say": "Four times 6 is 24. Plus 8 is 32.",
          "write": "24 + 8 = 32"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't just work left to right. 5 plus 3 times 4 is not 32.",
          "write": "✗ 32   ✓ 17"
        },
        {
          "say": "Don't always divide before multiplying. Go left to right.",
          "write": "÷ × left to right"
        },
        {
          "say": "BIDMAS still works inside brackets.",
          "write": "(15 − 3 × 3) = 6"
        },
        {
          "say": "Two cubed is not 2 times 3.",
          "write": "2³ = 8, not 6"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Brackets first, then indices.",
          "write": "B, I"
        },
        {
          "say": "Then times and divide, left to right.",
          "write": "D M →"
        },
        {
          "say": "Then add and subtract, left to right.",
          "write": "A S →"
        },
        {
          "say": "Underline the next step, and rewrite the line.",
          "write": "one step per line"
        }
      ]
    }

{
  "level": "Year 7",
  "subject": "maths",
  "title": "Integers with powers and brackets",
  "frames": [
    {
      "heading": "Flipping a pancake",
      "lines": [
        {
          "say": "Each time you multiply by a negative, the sign flips over.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "multiplying negatives",
            "items": [
              {
                "kind": "circle",
                "x": 60,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "1 negatives → negative",
                "size": 24,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Two negatives make a positive. Flipped twice, right way up.",
          "write": "(−2) × (−2) = 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "multiplying negatives",
            "items": [
              {
                "kind": "circle",
                "x": 60,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2"
              },
              {
                "kind": "circle",
                "x": 150,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "2 negatives → positive",
                "size": 24,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "A third negative flips it again. Now it's negative.",
          "write": "(−2)³ = −8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "multiplying negatives",
            "items": [
              {
                "kind": "circle",
                "x": 60,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2"
              },
              {
                "kind": "circle",
                "x": 150,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2"
              },
              {
                "kind": "circle",
                "x": 240,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "3 negatives → negative",
                "size": 24,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "A fourth one flips it back. Positive again.",
          "write": "(−2)⁴ = 16",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "multiplying negatives",
            "items": [
              {
                "kind": "circle",
                "x": 60,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2"
              },
              {
                "kind": "circle",
                "x": 150,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2"
              },
              {
                "kind": "circle",
                "x": 240,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2"
              },
              {
                "kind": "circle",
                "x": 330,
                "y": 70,
                "r": 32,
                "fill": "red",
                "label": "−2",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 170,
                "text": "4 negatives → positive",
                "size": 24,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Pair up the negatives. Any one left over makes it negative.",
          "write": "even → +   odd → −"
        }
      ]
    },
    {
      "heading": "The bracket matters",
      "lines": [
        {
          "say": "Bracket minus 3, squared, means minus 3 times minus 3.",
          "write": "(−3)² = (−3) × (−3) = 9"
        },
        {
          "say": "Minus 3 squared, no bracket, is different.",
          "write": "−3² = −(3 × 3) = −9",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "what gets squared",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 60,
                "text": "(−3)²",
                "size": 40,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 60,
                "text": "−3²",
                "size": 40,
                "color": "orange",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 105,
                "text": "square all of −3",
                "size": 17,
                "color": "grey",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 105,
                "text": "square just the 3",
                "size": 17,
                "color": "grey",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 150,
                "text": "= 9",
                "size": 34,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 150,
                "text": "= −9",
                "size": 34,
                "color": "orange",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Powers come before the minus sign, so only the 3 is squared.",
          "write": "power before minus"
        },
        {
          "say": "So minus 2 to the four is minus 16. Bracket minus 2, to the four, is 16.",
          "write": "−2⁴ = −16, (−2)⁴ = 16"
        }
      ]
    },
    {
      "heading": "Nested brackets",
      "lines": [
        {
          "say": "Brackets inside brackets. Work from the inside out, like an onion.",
          "write": "5 − [4 − (−3)²] × 2",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 150,
            "alt": "onion layers",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "5 − [4 − (−3)²] × 2",
                "size": 32,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 305,
                "y": 135,
                "text": "(−3)² first",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "arrow",
                "x": 305,
                "y": 108,
                "x2": 305,
                "y2": 82,
                "color": "purple",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Innermost first. Minus 3 squared is 9.",
          "write": "5 − [4 − 9] × 2"
        },
        {
          "say": "Then the square bracket. 4 take 9 is minus 5.",
          "write": "5 − (−5) × 2"
        },
        {
          "say": "Multiply before subtracting. Minus 5 times 2 is minus 10.",
          "write": "5 − (−10)"
        },
        {
          "say": "Subtracting a negative means adding. 5 plus 10 is 15.",
          "write": "= 15",
          "draw": {
            "type": "numberline",
            "from": 0,
            "to": 16,
            "start": 5,
            "jump": 10
          }
        },
        {
          "say": "Don't do 5 minus 4 first. Times comes before take away.",
          "write": "× before −"
        }
      ]
    },
    {
      "heading": "Roots and negatives",
      "lines": [
        {
          "say": "The square root sign always gives the positive root.",
          "write": "√49 = 7"
        },
        {
          "say": "Any number squared is 0 or positive. So minus 9 has no square root here.",
          "write": "√(−9): no answer"
        },
        {
          "say": "Cube roots are fine. Minus 4, cubed, is minus 64.",
          "write": "∛(−64) = −4"
        },
        {
          "say": "So cube root of minus 64, plus root of 6 squared minus 20.",
          "write": "∛(−64) + √(6² − 20)"
        },
        {
          "say": "That's minus 4 plus root 16. Minus 4 plus 4 is zero.",
          "write": "−4 + 4 = 0"
        }
      ]
    },
    {
      "heading": "Substituting a negative",
      "lines": [
        {
          "say": "Find 2x squared minus x cubed when x is minus 3.",
          "write": "2x² − x³, x = −3"
        },
        {
          "say": "Put the minus 3 in brackets first. Bracket it before you substitute.",
          "write": "2 × (−3)² − (−3)³",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 210,
            "alt": "brackets around the negative",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "2 × x² − x³",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 160,
                "text": "2 × (−3)² − (−3)³",
                "size": 34,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Even power, positive. Bracket minus 3 squared is 9. Odd power: minus 27.",
          "write": "2 × 9 − (−27)"
        },
        {
          "say": "18 take minus 27 is 18 plus 27.",
          "write": "18 + 27 = 45"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Without a bracket, only the 3 is squared. Minus 3 squared is minus 9.",
          "write": "✗ −3² = 9"
        },
        {
          "say": "A power is not times. Bracket minus 2, cubed, is minus 8, not minus 6.",
          "write": "(−2)³ = −8, not −6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "power is repeated multiplication",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "(−2)³ = −6",
                "size": 32,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "(−2) × (−2) × (−2) = −8",
                "size": 30,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Don't go left to right through brackets. Peel from the inside.",
          "write": "inside out"
        },
        {
          "say": "A square root of a negative is not a negative. There isn't one.",
          "write": "✗ √(−9) = −3"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Even hides the minus. Odd keeps the minus.",
          "write": "even +, odd −"
        },
        {
          "say": "The bracket decides what gets squared.",
          "write": "(−3)² = 9, −3² = −9"
        },
        {
          "say": "Inside out, then powers, then times and divide, then plus and minus.",
          "write": "inside out, then BIDMAS"
        },
        {
          "say": "Bracket it before you substitute it.",
          "write": "x = −3 → (−3)"
        },
        {
          "say": "A square is never negative. A cube keeps the sign of its base.",
          "write": "square ≥ 0"
        }
      ]
    }
  ]
}
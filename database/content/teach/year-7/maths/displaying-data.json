    {
      "heading": "Dot plots",
      "lines": [
        {
          "say": "A dot plot is a number line with a dot for each result.",
          "diagram": "diagrams/y7/maths/displaying-data-dotplot.svg",
          "alt": "Dot plot of goals scored in 12 games"
        },
        {
          "say": "Here are goals scored in 12 games. Two goals happened most often.",
          "write": "2 goals: 5 games"
        },
        {
          "say": "Count the dots. 2 plus 3 plus 5 plus 1 plus 1 is 12.",
          "write": "2 + 3 + 5 + 1 + 1 = 12"
        },
        {
          "say": "Look for clusters, gaps, and outliers far from the rest.",
          "write": "cluster, gap, outlier"
        }
      ]
    },
    {
      "heading": "Stem-and-leaf plots",
      "lines": [
        {
          "say": "A stem-and-leaf plot splits each number. Stem is tens, leaf is ones.",
          "write": "stem = tens   leaf = ones"
        },
        {
          "say": "Ages at a barbecue. First put them in order.",
          "write": "12 15 17 21 23 23 28 30 34 36 41"
        },
        {
          "say": "Write each ones digit as a leaf next to its stem.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Stem-and-leaf plot of 11 ages",
            "items": [
              {
                "kind": "line",
                "x": 110,
                "y": 20,
                "x2": 110,
                "y2": 240,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 80,
                "y": 50,
                "text": "1",
                "size": 24,
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 80,
                "y": 100,
                "text": "2",
                "size": 24,
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 80,
                "y": 150,
                "text": "3",
                "size": 24,
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 80,
                "y": 200,
                "text": "4",
                "size": 24,
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 140,
                "y": 50,
                "text": "2  5  7",
                "size": 24,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 100,
                "text": "1  3  3  8",
                "size": 24,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 150,
                "text": "0  4  6",
                "size": 24,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 200,
                "text": "1",
                "size": 24,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 260,
                "text": "Key: 2 | 3 means 23",
                "size": 18,
                "anchor": "middle",
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "Thirty or older means stems 3 and 4. That is 4 people.",
          "write": "3 + 1 = 4 people",

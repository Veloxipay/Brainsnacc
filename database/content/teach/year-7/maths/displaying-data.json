    {
      "heading": "Line graphs and pie charts",
      "lines": [
        {
          "say": "Line graphs show change over time. Time goes along the bottom.",
          "write": "line graph → time"
        },
        {
          "say": "A steeper line means a faster change.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "A line graph with a steep section highlighted",
            "items": [
              {
                "kind": "line",
                "x": 60,
                "y": 250,
                "x2": 520,
                "y2": 250,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 60,
                "y": 250,
                "x2": 60,
                "y2": 30,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 60,
                "y": 230,
                "x2": 200,
                "y2": 200,
                "color": "blue"
              },
              {
                "kind": "line",
                "x": 200,
                "y": 200,
                "x2": 340,
                "y2": 190,
                "color": "blue"
              },
              {
                "kind": "line",
                "x": 340,
                "y": 190,
                "x2": 480,
                "y2": 60,
                "color": "red",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 410,
                "y": 100,
                "text": "steep = fast",
                "size": 18,
                "anchor": "middle",
                "color": "red"
              }
            ]
          }
        },
        {
          "say": "Pie charts show parts of a whole. A full circle is 360 degrees.",
          "write": "angle = freq ÷ total × 360°"
        },
        {
          "say": "Thirty students chose a sport. Each student is worth 360 over 30, which is 12 degrees.",
          "write": "360° ÷ 30 = 12° each"
        },
        {
          "say": "Multiply each frequency by 12 degrees.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Sector angles: football 144, netball 108, basketball 72, cricket 36 degrees",
            "items": [
              {
                "kind": "text",
                "x": 20,
                "y": 55,
                "text": "football",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 170,
                "y": 55,
                "text": "12 × 12° =",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 30,
                "w": 201.6,
                "h": 40,
                "fill": "blue",
                "change": "add",
                "label": "144°"
              },
              {
                "kind": "text",
                "x": 20,
                "y": 110,
                "text": "netball",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 170,
                "y": 110,
                "text": "9 × 12° =",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 85,
                "w": 151.2,
                "h": 40,
                "fill": "orange",
                "label": "108°"
              },
              {
                "kind": "text",
                "x": 20,
                "y": 165,
                "text": "basketball",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 170,
                "y": 165,
                "text": "6 × 12° =",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 140,
                "w": 100.8,
                "h": 40,
                "fill": "green",
                "label": "72°"
              },
              {
                "kind": "text",
                "x": 20,
                "y": 220,
                "text": "cricket",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 170,
                "y": 220,
                "text": "3 × 12° =",
                "size": 18,
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 195,
                "w": 50.4,
                "h": 40,
                "fill": "purple",
                "label": "36°"
              }
            ]
          }
        },
        {
          "say": "Do them all. They must add to 360 degrees.",
          "write": "144 + 108 + 72 + 36 = 360 ✓",
          "diagram": "diagrams/y7/maths/displaying-data-ex3.svg",
          "alt": "Pie chart of favourite sport"
        }
      ]
    },
    {
      "heading": "Misleading graphs",
      "lines": [
        {
          "say": "Same sales, two graphs. January 50, February 52.",
          "diagram": "diagrams/y7/maths/displaying-data-misleading.svg",
          "alt": "Two column graphs of the same sales with different axis starts"
        },
        {
          "say": "On the left, the axis starts at 48. February looks twice as tall.",
          "write": "axis starts at 48 ✗"
        },
        {
          "say": "On the right, it starts at zero. The bars look almost the same.",
          "write": "axis starts at 0 ✓"
        },
        {
          "say": "Always read the numbers, not just the bar heights.",
          "write": "read the axis first"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't join categories with a line. Use a column graph.",
          "write": "✗ line graph for fruit"
        },
        {
          "say": "Twelve students is not 12 degrees. Use the formula.",
          "write": "12 students ≠ 12°"
        },
        {
          "say": "Leaves go smallest to largest, and always add a key.",
          "write": "leaves in order + key"
        },
        {
          "say": "Check the title, both axis labels and units before you finish.",
          "write": "title, labels, units"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Columns compare, lines show time, pies show parts.",
          "write": "columns, lines, pies"
        },
        {
          "say": "Stem is tens, leaf is ones.",
          "write": "stem | leaf"
        },
        {
          "say": "Pie angles must make 360 degrees.",
          "write": "total = 360°"
        },
        {
          "say": "Read the axis before you trust the bars.",
          "write": "start at 0?"
        }
      ]
    }
  ]
}
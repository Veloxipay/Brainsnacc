{
  "level": "Year 7",
  "subject": "maths",
  "title": "Displaying data",
  "frames": [
    {
      "heading": "Every graph needs the basics",
      "lines": [
        {
          "say": "A graph turns a list of numbers into a picture."
        },
        {
          "say": "Every graph needs a title.",
          "write": "title"
        },
        {
          "say": "It needs labelled axes, with units if needed.",
          "write": "axes + labels + units"
        },
        {
          "say": "The scale goes up in even steps, usually starting at zero.",
          "write": "even scale from 0"
        },
        {
          "say": "If colours stand for something, add a key.",
          "write": "key"
        }
      ]
    },
    {
      "heading": "Column graphs",

                "bold": true
              },
              {
                "kind": "text",
                "x": 140,
                "y": 50,
                "text": "2  5  7",
                "size": 24,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 100,
                "text": "1  3  3  8",
                "size": 24,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 150,
                "text": "0  4  6",
                "size": 24,
                "anchor": "start",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 140,

    {
      "heading": "Cordial and water",
      "lines": [
        {
          "say": "Cordial and water are mixed 1 to 4.",
          "write": "cordial : water = 1 : 4",
          "diagram": "diagrams/y7/maths/introduction-to-ratios-cordial.svg",
          "alt": "Bar model of cordial 1 box and water 4 boxes"
        },
        {
          "say": "One part is the cordial. It is 250 millilitres.",
          "write": "1 part = 250 mL"
        },
        {
          "say": "Water is 4 parts. Four times 250 is 1000 millilitres.",
          "write": "4 × 250 = 1000 mL"
        },
        {
          "say": "That is 1 litre of water.",
          "write": "1000 mL = 1 L"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Write the ratio in the same order as the words.",
          "write": "boys to girls → boys : girls"
        },
        {
          "say": "Don't divide 60 by 3 and by 2. Add the parts first.",
          "write": "add parts first"
        },
        {
          "say": "40 centimetres to 2 metres is not 40 to 2.",
          "write": "✗ 40 : 2"
        },
        {
          "say": "Girls to boys 2 to 3 means girls are two fifths, not two thirds.",
          "write": "2 : 3 → 2/5 and 3/5"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Order matters. A to B means A colon B.",
          "write": "A to B = A : B"
        },
        {
          "say": "Simplify by dividing every term by the HCF.",
          "write": "÷ HCF"
        },
        {
          "say": "Sharing: add, divide, multiply.",
          "write": "add, divide, multiply"
        },
        {
          "say": "Always check the shares add back to the total.",
          "write": "check the total ✓"
        }
      ]
    }
  ]
}
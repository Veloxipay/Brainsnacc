{
  "level": "Year 7",
  "subject": "maths",
  "title": "Introduction to ratios",
  "frames": [
    {
      "heading": "What is a ratio?",
      "lines": [
        {
          "say": "A ratio compares quantities of the same kind, using a colon.",
          "write": "3 cats : 5 dogs"
        },
        {
          "say": "We say it three to five.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "3 cats and 5 dogs",
            "items": [
              {
                "kind": "circle",
                "x": 50,
                "y": 80,
                "r": 24,
                "fill": "orange",
                "label": "cat"
              },
              {
                "kind": "circle",
                "x": 110,
                "y": 80,
                "r": 24,
                "fill": "orange",
                "label": "cat"
              },
              {
                "kind": "circle",
                "x": 170,
                "y": 80,
                "r": 24,
                "fill": "orange",
                "label": "cat"
              },
              {
                "kind": "circle",
                "x": 50,
                "y": 180,
                "r": 24,
                "fill": "blue",
                "label": "dog"
              },
              {
                "kind": "circle",
                "x": 110,
                "y": 180,
                "r": 24,
                "fill": "blue",
                "label": "dog"
              },
              {
                "kind": "circle",
                "x": 170,
                "y": 180,
                "r": 24,
                "fill": "blue",
                "label": "dog"
              },
              {
                "kind": "circle",
                "x": 230,
                "y": 180,
                "r": 24,
                "fill": "blue",
                "label": "dog"
              },
              {
                "kind": "circle",
                "x": 290,
                "y": 180,
                "r": 24,
                "fill": "blue",
                "label": "dog"
              },
              {
                "kind": "text",
                "x": 450,
                "y": 130,
                "text": "3 : 5",
                "size": 36,
                "anchor": "middle",
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "Order matters. Dogs to cats is 5 to 3.",
          "write": "dogs : cats = 5 : 3"
        },
        {
          "say": "Each number is a term. Terms have no units.",
          "write": "term"
        },
        {
          "say": "Different units? Change to the same unit first.",
          "write": "50 cm : 2 m = 50 : 200"
        }
      ]
    },
    {
      "heading": "Ratios and fractions",
      "lines": [
        {
          "say": "A class has 12 girls and 18 boys.",
          "write": "girls : boys = 12 : 18",
          "diagram": "diagrams/y7/maths/introduction-to-ratios-girls-boys.svg",
          "alt": "Bar model of 12 girls and 18 boys"
        },
        {
          "say": "A ratio compares part with part.",
          "write": "part : part"
        },
        {
          "say": "The total is 30. So girls are 12 thirtieths of the class.",
          "write": "girls = 12/30 of the class"
        },
        {
          "say": "Careful. 12 to 18 does not mean 12 eighteenths.",
          "write": "12 : 18 ≠ 12/18"
        }
      ]
    },
    {
      "heading": "Simplifying ratios",
      "lines": [
        {
          "say": "Equivalent ratios: multiply or divide every term by the same number.",
          "write": "2 : 3 = 4 : 6 = 10 : 15"
        },
        {
          "say": "To simplify, divide by the highest common factor.",
          "write": "÷ HCF"
        },
        {
          "say": "30 to 45. The HCF is 15.",
          "write": "30 : 45",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Bars of 30 and 45",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 50,
                "w": 300,
                "h": 50,
                "fill": "blue",
                "label": "30"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 130,
                "w": 450,
                "h": 50,
                "fill": "orange",
                "label": "45"
              }
            ]
          }
        },
        {
          "say": "Divide both by 15. We get 2 to 3.",
          "write": "30 : 45 = 2 : 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "30 is 2 blocks of 15, 45 is 3 blocks of 15",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 50,
                "w": 150,
                "h": 50,
                "fill": "blue",
                "change": "highlight",
                "label": "15"
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 50,
                "w": 150,
                "h": 50,
                "fill": "blue",
                "change": "highlight",
                "label": "15"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 130,
                "w": 150,
                "h": 50,
                "fill": "orange",
                "change": "highlight",
                "label": "15"
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 130,
                "w": 150,
                "h": 50,
                "fill": "orange",
                "change": "highlight",
                "label": "15"
              },
              {
                "kind": "rect",
                "x": 340,
                "y": 130,
                "w": 150,
                "h": 50,
                "fill": "orange",
                "change": "highlight",
                "label": "15"
              }
            ]
          }
        },
        {
          "say": "40 centimetres to 2 metres. Make it 40 to 200, then divide by 40.",
          "write": "40 : 200 = 1 : 5"
        }
      ]
    },

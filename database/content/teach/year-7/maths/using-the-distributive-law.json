{
  "level": "Year 7",
  "subject": "maths",
  "title": "Using the distributive law",
  "frames": [
    {
      "heading": "A mental maths trick",
      "lines": [
        {
          "say": "How would you do 4 times 23 in your head?",
          "write": "4 × 23"
        },
        {
          "say": "4 times 20 is 80. 4 times 3 is 12. So 92.",
          "write": "80 + 12 = 92"
        },
        {
          "say": "That trick is called the distributive law.",
          "write": "distributive law"
        },
        {
          "say": "Three party bags, each with 2 lollies and 5 stickers. You need 3 lots of everything.",
          "write": "3 × 2 = 6   3 × 5 = 15",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Three party bags each holding 2 lollies and 5 stickers",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 50,
                "w": 150,
                "h": 80,
                "fill": "pink",
                "label": "2L + 5S"
              },
              {
                "kind": "rect",
                "x": 205,
                "y": 50,
                "w": 150,
                "h": 80,
                "fill": "pink",
                "label": "2L + 5S"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 50,
                "w": 150,
                "h": 80,
                "fill": "pink",
                "label": "2L + 5S"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "3(2L + 5S) = 6L + 15S",
                "size": 30,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        }
      ]
    },
    {

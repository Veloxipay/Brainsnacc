                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 185,
                "y": 150,
                "x2": 370,
                "y2": 210,
                "color": "orange",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 385,
                "y": 150,
                "x2": 390,
                "y2": 210,
                "color": "orange",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 390,
                "y": 240,
                "text": "+ 4",
                "size": 30,
                "color": "orange",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }

    },
    {
      "heading": "Watch the signs",
      "lines": [
        {
          "say": "Each term inside keeps its sign. 5 bracket 2a minus 3.",
          "write": "5(2a − 3)"
        },
        {
          "say": "5 times 2a is 10a. 5 times minus 3 is minus 15.",
          "write": "10a − 15"
        },
        {
          "say": "A negative outside changes every sign. Negative 2 bracket 3m minus 4.",
          "write": "−2(3m − 4)"
        },
        {
          "say": "Negative 2 times 3m is negative 6m. Negative times negative is positive.",
          "write": "−6m + 8"
        }
      ]
    },
    {
      "heading": "Expand, then simplify",
      "lines": [
        {
          "say": "3 bracket a plus 2, plus 2 bracket a minus 1.",
          "write": "3(a + 2) + 2(a − 1)"
        },
        {
          "say": "Expand each bracket.",
          "write": "3a + 6 + 2a − 2"
        },
        {
          "say": "Collect like terms. 3a plus 2a is 5a. 6 minus 2 is 4.",
          "write": "5a + 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Like terms collected into 5a + 4",
            "items": [

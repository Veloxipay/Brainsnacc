          }
        },
        {
          "say": "It helps with numbers too. 7 times 98 is 700 minus 14.",
          "write": "7(100 − 2) = 686"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Multiply every term, not just the first. 3 bracket x plus 4 is not 3x plus 4.",
          "write": "✗ 3x + 4"
        },
        {
          "say": "Keep the sign. 5 bracket 2a minus 3 is not 10a plus 15.",
          "write": "✗ 10a + 15"
        },
        {
          "say": "x times x is x squared, not 2x.",
          "write": "x × x = x²"
        },
        {
          "say": "3x plus 12 is not 15x. Only collect like terms.",
          "write": "✗ 15x"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "The outside term multiplies everything inside.",
          "write": "outside × every inside"
        },
        {
          "say": "Draw an arrow to every term.",
          "write": "arrow to each term"
        },
        {
          "say": "A negative outside flips the signs.",
          "write": "−( ) flips signs"
        },
        {
          "say": "Expand first, then collect like terms.",
          "write": "expand, then simplify"
        }
      ]
    }
  ]
}

    {
      "heading": "Rectangles and squares",
      "lines": [
        {
          "say": "A rectangle is rows of unit squares. Length times width.",
          "write": "A = l × w",
          "diagram": "diagrams/y7/maths/area-of-rectangles-triangles-and-parallelograms-grid.svg",
          "alt": "7 by 4 rectangle split into unit squares"
        },
        {
          "say": "7 metres by 4 metres. 7 times 4 is 28.",
          "write": "A = 7 × 4 = 28 m²"
        },
        {
          "say": "A square has equal sides. Side times side.",
          "write": "A = s × s"
        },
        {
          "say": "Multiply, don't add. Adding gives you half the perimeter.",
          "write": "✗ 7 + 4"
        }
      ]
    },
    {
      "heading": "Triangles",
      "lines": [
        {
          "say": "Draw a rectangle round a triangle. The triangle is exactly half.",
          "write": "half a rectangle",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "triangle in rectangle",
            "items": [
              {
                "kind": "rect",
                "x": 130,
                "y": 40,
                "w": 300,
                "h": 180,
                "fill": "white"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    130,
                    220
                  ],
                  [
                    250,
                    40
                  ],
                  [
                    130,
                    40
                  ]
                ],
                "fill": "yellow",
                "change": "add"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    430,
                    220
                  ],
                  [
                    250,
                    40
                  ],
                  [

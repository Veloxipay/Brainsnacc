          "say": "The roof is half of 12 times 4. That's 24.",
          "write": "½ × 12 × 4 = 24 m²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "barn split roof",
            "items": [
              {
                "kind": "rect",
                "x": 130,
                "y": 130,
                "w": 300,
                "h": 125,
                "fill": "blue",
                "label": "60 m²"

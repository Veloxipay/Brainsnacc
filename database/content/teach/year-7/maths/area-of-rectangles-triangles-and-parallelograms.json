                "kind": "text",
                "x": 280,
                "y": 110,
                "text": "24 m²",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Add the parts. 60 plus 24 is 84 square metres.",
          "write": "60 + 24 = 84 m²"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't forget the half for triangles.",
          "write": "½ × b × h"
        },
        {
          "say": "Use the perpendicular height, not the sloping side.",
          "write": "look for the right-angle box"
        },
        {
          "say": "Area always has square units. Centimetres squared, not centimetres.",
          "write": "cm² not cm"
        },
        {
          "say": "Mixed units? Convert first, then multiply.",
          "write": "same units first"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Rectangle: length times width.",
          "write": "A = l × w"
        },
        {
          "say": "Triangle: half of base times height.",
          "write": "A = ½ × b × h"
        },
        {
          "say": "Parallelogram: base times height.",
          "write": "A = b × h"
        },
        {
          "say": "Composite shapes: split, find each area, then add.",
          "write": "split and add"
        }
      ]
    }

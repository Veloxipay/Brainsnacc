                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "triangle = ½ of the rectangle",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So the area is a half times base times height.",
          "write": "A = ½ × b × h"
        },
        {
          "say": "Base 10, height 6. 10 times 6 is 60. Half of that is 30.",
          "write": "½ × 10 × 6 = 30 cm²",
          "diagram": "diagrams/y7/maths/area-of-rectangles-triangles-and-parallelograms-ex2.svg",
          "alt": "Triangle with base 10 cm and height 6 cm"
        },
        {
          "say": "The height stands up straight, at right angles to the base.",
          "write": "perpendicular height"
        }
      ]
    },

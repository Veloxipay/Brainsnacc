    {
      "heading": "Is it prime? Test it",
      "lines": [
        {
          "say": "Try dividing by 2, 3, 5, 7 in order.",
          "write": "test 2, 3, 5, 7 …"
        },
        {
          "say": "Is 57 prime? It's odd, so 2 doesn't work.",
          "write": "57 ÷ 2 ✗"
        },
        {
          "say": "Digit sum: 5 plus 7 is 12. That's a multiple of 3.",
          "write": "5 + 7 = 12"
        },
        {
          "say": "So 57 is 3 times 19. It's composite, not prime.",
          "write": "57 = 3 × 19"
        },
        {
          "say": "For 53, nothing works up to 7. And 8 times 8 is past 53. Prime.",
          "write": "53 is prime"
        },
        {
          "say": "Watch for sneaky ones. 51 is 3 times 17. 91 is 7 times 13.",
          "write": "51 = 3×17   91 = 7×13"
        }
      ]
    },

    {
      "heading": "Another tree: 72",
      "lines": [
        {
          "say": "Start 72 with 8 times 9. Any pair works.",
          "write": "72 = 8 × 9",
          "diagram": "diagrams/y7/maths/primes-and-prime-factorisation-tree72.svg",
          "alt": "Factor tree for 72 ending in 2, 2, 2, 3, 3"
        },
        {
          "say": "8 splits to 2 times 4, then 4 to 2 times 2. 9 is 3 times 3.",
          "write": "8 = 2×2×2   9 = 3×3"
        },
        {
          "say": "So 72 is 2 times 2 times 2 times 3 times 3.",
          "write": "72 = 2³ × 3²"
        },
        {
          "say": "Check by multiplying back. 8 times 9 is 72.",
          "write": "8 × 9 = 72 ✓"
        }
      ]
    },
    {
      "heading": "Using primes for the HCF",

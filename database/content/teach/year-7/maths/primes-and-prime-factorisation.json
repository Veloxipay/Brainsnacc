  "title": "Primes and prime factorisation",
  "frames": [
    {
      "heading": "What is a prime number?",
      "lines": [
        {
          "say": "A prime number has exactly two factors. One and itself.",
          "write": "prime: exactly 2 factors"
        },
        {
          "say": "7 is prime. Its only factors are 1 and 7.",
          "write": "7: 1, 7"
        },
        {
          "say": "9 is composite. It splits into 3 times 3.",
          "write": "9 = 3 × 3 → composite"
        },
        {
          "say": "1 is neither prime nor composite. It has only one factor.",
          "write": "1 is neither"
        },
        {
          "say": "2 is the only even prime. Every other even number has factor 2.",
          "write": "2: the only even prime"
        }
      ]
    },

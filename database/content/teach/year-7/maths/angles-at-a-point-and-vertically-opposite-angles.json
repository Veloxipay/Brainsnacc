    {
      "heading": "Why opposite angles are equal",
      "lines": [
        {
          "say": "Go round the X: a, b, c and d.",
          "write": "a, b, c, d",
          "diagram": "diagrams/y7/maths/angles-at-a-point-and-vertically-opposite-angles-abcd.svg",
          "alt": "Crossing lines with angles a, b, c, d"
        },
        {
          "say": "a plus b is 180. b plus c is also 180.",
          "write": "a + b = 180, b + c = 180"
        },
        {
          "say": "Both a and c are 180 take b. So a equals c.",
          "write": "a = c"
        }
      ]

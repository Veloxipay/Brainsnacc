    {
      "heading": "Is it aromatic?",
      "lines": [
        {
          "say": "Use the CPFC checklist. Cyclic, planar, fully conjugated, count.",
          "write": "C · P · F · C"
        },
        {
          "say": "The count must be four n plus two pi electrons. That's 2, 6, 10.",
          "write": "4n + 2 = 2, 6, 10"
        },
        {
          "say": "Six is sweet, four is foul. Cyclobutadiene, with four, is antiaromatic.",
          "write": "4n → antiaromatic"
        },
        {
          "say": "Cyclooctatetraene has eight. It puckers into a tub, so it's non-aromatic.",
          "write": "COT: tub, non-aromatic"
        },
        {
          "say": "Pyridine's nitrogen lone pair sits in the ring plane. Don't count it.",
          "write": "pyridine: 6 π, aromatic",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Pyridine lone pair points outward and is not counted; pyrrole lone pair is in the ring and is counted",

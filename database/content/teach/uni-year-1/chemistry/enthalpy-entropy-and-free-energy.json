{
  "level": "Uni Year 1",
  "subject": "chemistry",
  "title": "Enthalpy, entropy and free energy",
  "frames": [
    {
      "heading": "System, surroundings, first law",
      "lines": [
        {"say": "The system is the chemicals we study. Everything else is the surroundings.", "write": "system + surroundings",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "A system box inside the surroundings, with heat q and work w going in", "items": [
           {"kind": "rect", "x": 20, "y": 20, "w": 520, "h": 220, "fill": "none"},
           {"kind": "text", "x": 40, "y": 50, "text": "surroundings", "size": 18, "anchor": "start"},
           {"kind": "rect", "x": 200, "y": 80, "w": 160, "h": 110, "fill": "blue", "label": "system"},
           {"kind": "arrow", "x": 80, "y": 135, "x2": 195, "y2": 135, "color": "red", "change": "add"},
           {"kind": "text", "x": 110, "y": 120, "text": "q in", "size": 20, "color": "red", "change": "add"},
           {"kind": "arrow", "x": 480, "y": 135, "x2": 365, "y2": 135, "color": "purple", "change": "add"},
           {"kind": "text", "x": 450, "y": 120, "text": "w on", "size": 20, "color": "purple", "change": "add"}
         ]}},
        {"say": "Energy is conserved. Delta U equals q plus w.", "write": "ΔU = q + w"},
        {"say": "q is heat into the system. w is work done on the system.", "write": "expansion: w = −PΔV"},
        {"say": "U is a state function. Only the start and finish matter, like altitude on a hike.", "write": "state function"}
      ]
    },
    {
      "heading": "Enthalpy and Hess's law",
      "lines": [
        {"say": "At constant pressure, the heat exchanged is the enthalpy change.", "write": "ΔH = q_p"},
        {"say": "Negative delta H is exothermic. Positive is endothermic.", "write": "ΔH − exo,  ΔH + endo"},
        {"say": "Reverse an equation and delta H changes sign. Double it and delta H doubles.", "write": "reverse: −ΔH   ×2: 2ΔH"},
        {"say": "Hess's law: delta H is the same by any route.", "write": "C + 2H₂ → CH₄",
         "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Two routes from elements to methane: direct, or via carbon dioxide and water", "items": [
           {"kind": "rect", "x": 20, "y": 30, "w": 150, "h": 60, "fill": "blue", "label": "C + 2H₂"},
           {"kind": "rect", "x": 390, "y": 30, "w": 150, "h": 60, "fill": "green", "label": "CH₄"},
           {"kind": "rect", "x": 200, "y": 200, "w": 170, "h": 60, "fill": "grey", "label": "CO₂ + 2H₂O"},
           {"kind": "arrow", "x": 170, "y": 60, "x2": 388, "y2": 60, "color": "black"},
           {"kind": "text", "x": 280, "y": 45, "text": "ΔfH = ?", "size": 20, "bold": true},
           {"kind": "arrow", "x": 100, "y": 92, "x2": 230, "y2": 198, "color": "orange", "change": "add"},
           {"kind": "text", "x": 120, "y": 170, "text": "−965.1", "size": 18, "color": "orange", "change": "add"},
           {"kind": "arrow", "x": 340, "y": 198, "x2": 460, "y2": 92, "color": "orange", "change": "add"},
           {"kind": "text", "x": 450, "y": 170, "text": "+890.3", "size": 18, "color": "orange", "change": "add"}
         ]}},
        {"say": "Keep carbon, double hydrogen, reverse methane. Add them up: minus 74.8.", "write": "ΔfH°(CH₄) = −74.8 kJ mol⁻¹"}
      ]
    },
    {
      "heading": "Products minus reactants",
      "lines": [
        {"say": "Formation enthalpy is for one mole of compound from its elements.", "write": "ΔfH°(element) = 0"},
        {"say": "Then delta H equals products minus reactants, times the coefficients.", "write": "ΔrH° = ΣνΔfH°(P) − ΣνΔfH°(R)"},
        {"say": "Limestone: calcium oxide plus carbon dioxide, minus calcium carbonate.", "write": "CaCO₃ → CaO + CO₂"},
        {"say": "Minus 635.1 plus minus 393.5, minus minus 1206.9.", "write": "(−635.1 − 393.5) − (−1206.9)"},
        {"say": "That gives plus 178.3 kilojoules. It's endothermic.", "write": "ΔH° = +178.3 kJ mol⁻¹",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Energy level diagram: products CaO + CO2 sit 178.3 kJ above CaCO3", "items": [
           {"kind": "line", "x": 60, "y": 190, "x2": 220, "y2": 190, "color": "blue"},
           {"kind": "text", "x": 140, "y": 220, "text": "CaCO₃", "size": 20},
           {"kind": "line", "x": 320, "y": 60, "x2": 500, "y2": 60, "color": "orange", "change": "add"},
           {"kind": "text", "x": 410, "y": 45, "text": "CaO + CO₂", "size": 20, "change": "add"},
           {"kind": "arrow", "x": 270, "y": 188, "x2": 270, "y2": 62, "color": "red", "change": "add"},
           {"kind": "text", "x": 285, "y": 130, "text": "+178.3", "size": 20, "bold": true, "color": "red", "anchor": "start", "change": "add"}
         ]}}
      ]
    },
    {
      "heading": "Entropy and the second law",
      "lines": [
        {"say": "Ice melts on a warm day, even though it's endothermic. Enthalpy alone can't predict that.", "write": "ΔH alone isn't enough"},
        {"say": "Entropy measures how spread out the energy is. Think of a messy bedroom.", "write": "S = k ln W"},
        {"say": "Gases have far more entropy than liquids, and liquids more than solids.", "write": "S_gas ≫ S_liquid > S_solid",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Particles in a solid, liquid and gas, spreading out more each time", "items": [
           {"kind": "rect", "x": 20, "y": 40, "w": 160, "h": 150, "fill": "none"},
           {"kind": "rect", "x": 200, "y": 40, "w": 160, "h": 150, "fill": "none"},
           {"kind": "rect", "x": 380, "y": 40, "w": 160, "h": 150, "fill": "none"},
           {"kind": "circle", "x": 80, "y": 150, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 110, "y": 150, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 80, "y": 120, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 110, "y": 120, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 240, "y": 165, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 280, "y": 155, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 315, "y": 168, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 260, "y": 125, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 410, "y": 70, "r": 14, "fill": "blue", "change": "add"},
           {"kind": "circle", "x": 510, "y": 90, "r": 14, "fill": "blue", "change": "add"},
           {"kind": "circle", "x": 440, "y": 165, "r": 14, "fill": "blue", "change": "add"},
           {"kind": "circle", "x": 500, "y": 160, "r": 14, "fill": "blue", "change": "add"},
           {"kind": "text", "x": 100, "y": 220, "text": "solid", "size": 18},
           {"kind": "text", "x": 280, "y": 220, "text": "liquid", "size": 18},
           {"kind": "text", "x": 460, "y": 220, "text": "gas", "size": 18, "bold": true}
         ]}},
        {"say": "Quick check: more moles of gas means delta S is positive.", "write": "Δn_gas > 0 → ΔS > 0"},
        {"say": "Second law: in any spontaneous change, the entropy of the universe goes up.", "write": "ΔS_univ > 0"},
        {"say": "Unlike formation enthalpy, the S nought of an element is not zero.", "write": "S°(element) ≠ 0"}
      ]
    },
    {
      "heading": "Gibbs free energy",
      "lines": [
        {"say": "Gibbs has to subtract. Delta G equals delta H minus T delta S.", "write": "ΔG = ΔH − TΔS"},
        {"say": "Negative delta G is spontaneous. Zero means equilibrium.", "write": "ΔG < 0 spontaneous"},
        {"say": "Limestone: delta S is plus 160.6 joules. Divide by 1000 first.", "write": "ΔS° = 0.1606 kJ K⁻¹ mol⁻¹"},
        {"say": "At 298 kelvin, delta G is plus 130.4. Not spontaneous.", "write": "ΔG° = +130.4 kJ mol⁻¹",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Delta G falling with temperature and crossing zero at 1110 K", "items": [
           {"kind": "arrow", "x": 60, "y": 240, "x2": 60, "y2": 20, "color": "black"},
           {"kind": "line", "x": 60, "y": 170, "x2": 530, "y2": 170, "color": "black"},
           {"kind": "text", "x": 70, "y": 30, "text": "ΔG", "size": 20, "anchor": "start"},
           {"kind": "text", "x": 525, "y": 195, "text": "T", "size": 20},
           {"kind": "line", "x": 90, "y": 60, "x2": 500, "y2": 225, "color": "blue"},
           {"kind": "text", "x": 110, "y": 50, "text": "+130.4 at 298 K", "size": 18, "anchor": "start"},
           {"kind": "circle", "x": 363, "y": 170, "r": 8, "fill": "red", "change": "highlight"},
           {"kind": "text", "x": 363, "y": 145, "text": "1110 K", "size": 22, "bold": true, "color": "red", "change": "highlight"}
         ]}},
        {"say": "Crossover is delta H over delta S, about 1110 kelvin. Above it, spontaneous.", "write": "T = ΔH/ΔS = 1110 K"}
      ]
    },
    {
      "heading": "The sign table",
      "lines": [
        {"say": "Minus delta H and plus delta S always wins.", "write": "− / +  always",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Four-box table of the signs of delta H and delta S", "items": [
           {"kind": "rect", "x": 40, "y": 30, "w": 240, "h": 100, "fill": "green", "label": "ΔH −, ΔS +: always"},
           {"kind": "rect", "x": 280, "y": 30, "w": 240, "h": 100, "fill": "red", "label": "ΔH +, ΔS −: never"},
           {"kind": "rect", "x": 40, "y": 130, "w": 240, "h": 100, "fill": "teal", "label": "both −: low T", "change": "highlight"},
           {"kind": "rect", "x": 280, "y": 130, "w": 240, "h": 100, "fill": "orange", "label": "both +: high T", "change": "highlight"}
         ]}},
        {"say": "Plus delta H and minus delta S never wins, like forming ozone.", "write": "+ / −  never"},
        {"say": "Both negative, like freezing water, works at low temperature.", "write": "− / −  low T"},
        {"say": "Both positive, like melting ice, works at high temperature.", "write": "+ / +  high T"},
        {"say": "Spontaneous does not mean fast. Diamond turns to graphite incredibly slowly.", "write": "spontaneous ≠ speedy"}
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {"say": "Don't mix kilojoules and joules. Divide delta S by 1000.", "write": "ΔS ÷ 1000 → kJ"},
        {"say": "Multiply every value by its coefficient. Check liquid or gas water.", "write": "× ν,  H₂O(l) ≠ H₂O(g)"},
        {"say": "Work done by an expanding gas is negative.", "write": "expansion: w < 0"},
        {"say": "Always say the temperature when you call something spontaneous.", "write": "ΔG sign + temperature"}
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {"say": "State functions only care about start and finish. That's Hess's law.", "write": "Hess: any route"},
        {"say": "Products minus reactants, times the coefficients.", "write": "Σ products − Σ reactants"},
        {"say": "Delta G equals delta H minus T delta S. Negative goes.", "write": "ΔG = ΔH − TΔS"},
        {"say": "Delta G says whether a reaction can go, not how fast.", "write": "whether, not how fast"}
      ]
    }
  ]
}

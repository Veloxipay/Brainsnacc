{
  "level": "Uni Year 1",
  "subject": "chemistry",
  "title": "Molecular shape",
  "frames": [
    {
      "heading": "The VSEPR idea",
      "lines": [
        {
          "say": "Electron domains around a central atom push as far apart as they can.",
          "write": "VSEPR"
        },
        {
          "say": "A domain is a bond or a lone pair. A double bond counts as one.",
          "write": "double bond = 1 domain"
        },
        {
          "say": "Like balloons tied together. Two, three, four, five, six make the basic shapes.",
          "write": "2 3 4 5 6 domains",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Domain counts with their electron domain geometries",
            "items": [
              {
                "kind": "rect",
                "x": 10,
                "y": 50,
                "w": 100,
                "h": 80,
                "fill": "blue",
                "label": "2: linear"
              },
              {
                "kind": "rect",
                "x": 120,
                "y": 50,
                "w": 100,
                "h": 80,
                "fill": "teal",
                "label": "3: trig planar"
              },
              {
                "kind": "rect",
                "x": 230,
                "y": 50,
                "w": 100,
                "h": 80,
                "fill": "green",
                "label": "4: tetrahedral"
              },
              {
                "kind": "rect",
                "x": 340,
                "y": 50,
                "w": 100,
                "h": 80,
                "fill": "orange",
                "label": "5: trig bipyr"

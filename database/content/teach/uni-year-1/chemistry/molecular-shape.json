    {
      "heading": "Shape decides polarity",
      "lines": [
        {
          "say": "A polar bond has a dipole pointing towards the more electronegative atom.",
          "write": "δ+ → δ−"
        },
        {
          "say": "The molecule's dipole is the vector sum of the bond dipoles.",
          "write": "μ = vector sum"
        },
        {
          "say": "Symmetric shapes with identical outer atoms cancel. Methane is non-polar.",
          "write": "CH₄: μ = 0",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Carbon with four hydrogen atoms, dipoles cancelling",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 130,

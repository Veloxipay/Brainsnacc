{
  "level": "Uni Year 1",
  "subject": "chemistry",
  "title": "Stoichiometry",
  "frames": [
    {
      "heading": "The mole",
      "lines": [
        {"say": "One mole is 6.022 times ten to the 23 particles. That's Avogadro's constant.", "write": "N_A = 6.022 × 10²³ mol⁻¹"},
        {"say": "Three formulas do most of the work.", "write": "n = m/M   N = nN_A   c = n/V"},
        {"say": "All roads lead through the mole. Convert in, use the ratio, convert out.", "write": "given → mol → ratio → mol → answer",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Grams, litres of solution, litres of gas and particles all lead into moles", "items": [
           {"kind": "circle", "x": 280, "y": 130, "r": 55, "fill": "orange", "label": "moles"},
           {"kind": "rect", "x": 20, "y": 30, "w": 130, "h": 50, "fill": "blue", "label": "grams"},
           {"kind": "rect", "x": 410, "y": 30, "w": 130, "h": 50, "fill": "blue", "label": "solution"},
           {"kind": "rect", "x": 20, "y": 180, "w": 130, "h": 50, "fill": "blue", "label": "gas"},
           {"kind": "rect", "x": 410, "y": 180, "w": 130, "h": 50, "fill": "blue", "label": "particles"},
           {"kind": "arrow", "x": 150, "y": 60, "x2": 232, "y2": 105, "color": "black", "change": "add"},
           {"kind": "arrow", "x": 410, "y": 60, "x2": 328, "y2": 105, "color": "black", "change": "add"},
           {"kind": "arrow", "x": 150, "y": 200, "x2": 232, "y2": 155, "color": "black", "change": "add"},
           {"kind": "arrow", "x": 410, "y": 200, "x2": 328, "y2": 155, "color": "black", "change": "add"}
         ]}},
        {"say": "Keep units attached. If they cancel to what you want, the set-up is right.", "write": "units check the set-up"}
      ]
    },
    {
      "heading": "Mole ratios and limiting reagents",
      "lines": [
        {"say": "Coefficients give mole ratios, not mass ratios.", "write": "2Al + 3Cl₂ → 2AlCl₃"},
        {"say": "Here's the sandwich test. Each sandwich needs two bread and one cheese.", "write": "2 bread + 1 cheese",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Ten slices of bread and three slices of cheese", "items": [
           {"kind": "rect", "x": 20, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 70, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 120, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 170, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 220, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 270, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 320, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 370, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 420, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 470, "y": 40, "w": 40, "h": 40, "fill": "yellow"},
           {"kind": "rect", "x": 20, "y": 130, "w": 40, "h": 40, "fill": "orange"},
           {"kind": "rect", "x": 70, "y": 130, "w": 40, "h": 40, "fill": "orange"},
           {"kind": "rect", "x": 120, "y": 130, "w": 40, "h": 40, "fill": "orange"},
           {"kind": "text", "x": 280, "y": 115, "text": "10 bread ÷ 2 = 5", "size": 20},
           {"kind": "text", "x": 350, "y": 160, "text": "3 cheese ÷ 1 = 3", "size": 20, "bold": true, "color": "red", "change": "highlight"},
           {"kind": "text", "x": 280, "y": 220, "text": "only 3 sandwiches: cheese limits", "size": 20, "color": "purple", "change": "add"}
         ]}},
        {"say": "Divide each reactant's moles by its coefficient. The smallest one limits.", "write": "smallest n ÷ coeff limits"},
        {"say": "Ten grams of aluminium is 0.3706 moles. Over two is 0.1853.", "write": "Al: 0.3706 ÷ 2 = 0.1853"},
        {"say": "Thirty-five grams of chlorine is 0.4937 moles. Over three is 0.1646.", "write": "Cl₂: 0.4937 ÷ 3 = 0.1646"},
        {"say": "Chlorine is smaller, so chlorine is limiting.", "write": "Cl₂ is limiting"}
      ]
    },
    {
      "heading": "Yield",
      "lines": [
        {"say": "Use the limiting reagent to find the theoretical yield.", "write": "n(AlCl₃) = 0.4937 × 2/3"},
        {"say": "That's 0.3291 moles, or 43.9 grams of aluminium chloride.", "write": "theoretical = 43.9 g"},
        {"say": "We got 38.2 grams. Actual over theoretical, times 100.", "write": "38.2/43.9 × 100 = 87.1%",
         "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Bar for theoretical 43.9 g with the actual 38.2 g bar filling 87 percent of it", "items": [
           {"kind": "rect", "x": 40, "y": 50, "w": 480, "h": 50, "fill": "none", "label": ""},
           {"kind": "rect", "x": 40, "y": 50, "w": 418, "h": 50, "fill": "green", "label": "actual 38.2 g", "change": "add"},
           {"kind": "text", "x": 520, "y": 130, "text": "theoretical 43.9 g", "size": 18, "anchor": "end"},
           {"kind": "text", "x": 280, "y": 175, "text": "87.1% yield", "size": 24, "bold": true, "color": "purple", "change": "highlight"}
         ]}},
        {"say": "Yields multiply. Five steps at 80 percent gives only about 33 percent.", "write": "0.80⁵ ≈ 33%"},
        {"say": "A yield over 100 percent means you made a mistake.", "write": "> 100% = error"}
      ]
    },
    {
      "heading": "Titrations",
      "lines": [
        {"say": "For solutions, moles equal concentration times volume in litres.", "write": "n = cV"},
        {"say": "Sulfuric acid needs two sodium hydroxide. Watch that one to two ratio.", "write": "H₂SO₄ + 2NaOH →"},
        {"say": "Sodium hydroxide: 0.1050 molar times 0.01845 litres.", "write": "n(NaOH) = 1.937 × 10⁻³ mol"},
        {"say": "Halve it for the acid, then divide by 0.02500 litres.", "write": "c(H₂SO₄) = 0.03874 M",
         "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Two NaOH units for every one H2SO4, so the acid moles are halved", "items": [
           {"kind": "circle", "x": 90, "y": 90, "r": 34, "fill": "red", "label": "H₂SO₄"},
           {"kind": "circle", "x": 260, "y": 90, "r": 30, "fill": "blue", "label": "NaOH"},
           {"kind": "circle", "x": 340, "y": 90, "r": 30, "fill": "blue", "label": "NaOH"},
           {"kind": "text", "x": 175, "y": 98, "text": "+", "size": 28},
           {"kind": "text", "x": 300, "y": 170, "text": "n(acid) = ½ × n(NaOH)", "size": 22, "bold": true, "color": "purple", "change": "highlight"}
         ]}},
        {"say": "Dilution keeps moles the same. Scale an aliquot back up to the whole flask.", "write": "c₁V₁ = c₂V₂"}
      ]
    },
    {
      "heading": "Gases",
      "lines": [
        {"say": "The ideal gas equation: P V equals n R T.", "write": "PV = nRT"},
        {"say": "Use R equals 8.314 with pressure in kilopascals and volume in litres.", "write": "R = 8.314, kPa and L"},
        {"say": "Kelvin or bust. Add 273.15 to the Celsius temperature.", "write": "T = θ + 273.15"},
        {"say": "Only use 24.8 litres per mole when it really is SLC.", "write": "24.8 L mol⁻¹ at SLC only"},
        {"say": "Dalton's law: each gas acts alone. The partial pressures add up.", "write": "P_total = p₁ + p₂ + …",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Two gases in one container; their partial pressures add to give the total", "items": [
           {"kind": "rect", "x": 40, "y": 30, "w": 220, "h": 170, "fill": "none"},
           {"kind": "circle", "x": 80, "y": 70, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 160, "y": 160, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 210, "y": 80, "r": 14, "fill": "blue"},
           {"kind": "circle", "x": 120, "y": 120, "r": 14, "fill": "orange", "change": "add"},
           {"kind": "circle", "x": 220, "y": 160, "r": 14, "fill": "orange", "change": "add"},
           {"kind": "rect", "x": 330, "y": 120, "w": 60, "h": 80, "fill": "blue", "label": "p₁"},
           {"kind": "rect", "x": 330, "y": 65, "w": 60, "h": 55, "fill": "orange", "label": "p₂", "change": "add"},
           {"kind": "text", "x": 470, "y": 100, "text": "P_total", "size": 20, "bold": true},
           {"kind": "text", "x": 470, "y": 130, "text": "pᵢ = xᵢ P_total", "size": 18}
         ]}},
        {"say": "Gas collected over water is wet. Subtract water's vapour pressure.", "write": "dry gas = P − p(H₂O)"}
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {"say": "Never use degrees Celsius in P V equals n R T.", "write": "✗ °C in PV = nRT"},
        {"say": "Match R to units. Pascals with litres is out by a thousand.", "write": "kPa with L, Pa with m³"},
        {"say": "Don't pick the limiting reagent by comparing masses.", "write": "✗ compare grams"},
        {"say": "Don't forget the mole ratio in a titration.", "write": "✗ H₂SO₄ : NaOH = 1 : 1"}
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {"say": "Every road passes through the mole.", "write": "→ mol → ratio → mol →"},
        {"say": "Smallest moles over coefficient is the limiting reagent.", "write": "n ÷ coeff"},
        {"say": "Yields multiply, they don't add.", "write": "overall = product of yields"},
        {"say": "Kelvin, kilopascals and litres with 8.314.", "write": "PV = nRT,  T in K"}
      ]
    }
  ]
}

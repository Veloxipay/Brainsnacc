          "say": "Flip and change the sign. Perpendicular to 5 is minus one fifth.",
          "write": "5 → −⅕"
        },
        {
          "say": "In 3x minus 2y equals 4, the gradient is not 3. Rearrange first.",
          "write": "get y alone first"
        },
        {
          "say": "Write down the new gradient before you substitute the point.",
          "write": "new m first"
        },
        {
          "say": "1 equals minus 6 plus c gives c equals 7, not minus 5.",
          "write": "c = 7"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Parallel: same gradient.",
          "write": "∥ : m₁ = m₂"
        },
        {
          "say": "Perpendicular: gradients multiply to minus 1.",
          "write": "⊥ : m₁ × m₂ = −1"
        },
        {
          "say": "Always rearrange to y equals m x plus c before comparing.",
          "write": "y = mx + c first"
        }
      ]
    }

{
  "level": "Year 9",
  "subject": "maths",
  "title": "Parallel and perpendicular lines",
  "frames": [
    {
      "heading": "Railway tracks and crossroads",
      "lines": [
        {
          "say": "Railway tracks run side by side and never meet. They're parallel.",
          "write": "parallel ∥"
        },
        {
          "say": "At a neat crossroads, roads meet at a square corner. That's perpendicular.",
          "write": "perpendicular ⊥"
        },
        {
          "say": "We can tell which is which from the gradients.",
          "write": "compare m"
        }
      ]
    },
    {
      "heading": "Parallel: same gradient",
      "lines": [
        {
          "say": "Parallel lines have the same gradient, but different y-intercepts.",
          "write": "same m, different c",
          "diagram": "diagrams/y9/maths/parallel-and-perpendicular-lines-par.svg",
          "alt": "Parallel lines y = ½x + 2 and y = ½x − 1"
        },
        {
          "say": "They rise at the same rate, so the gap never closes.",
          "write": "y = ½x + 2  ∥  y = ½x − 1"
        },
        {
          "say": "Same m and same c is the same line, not parallel lines.",
          "write": "same line ≠ parallel"
        }
      ]
    },
    {
      "heading": "Rearrange first",
      "lines": [
        {
          "say": "Are y equals 3x plus 1 and 6x minus 2y equals 5 parallel?",
          "write": "6x − 2y = 5"
        },
        {
          "say": "Get y on its own. Minus 2y equals minus 6x plus 5.",
          "write": "−2y = −6x + 5"
        },
        {
          "say": "Divide every term by minus 2. y equals 3x minus 2.5.",
          "write": "y = 3x − 2.5",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "y = 3x + 1 and y = 3x − 2.5 are parallel",

  "title": "Algorithms for solving equations",
  "frames": [
    {
      "heading": "Solving by undoing",
      "lines": [
        {
          "say": "3x plus 5 equals 26 tells a story. Times 3, then add 5.",
          "write": "x → × 3 → + 5 → 26"
        },
        {
          "say": "Run the story backwards with inverse operations.",
          "write": "26 → − 5 → ÷ 3 → 7",
          "diagram": "diagrams/y9/maths/algorithms-for-solving-equations-undo.svg",
          "alt": "Building 3x + 5 from x and undoing from 26 to 7"
        },
        {
          "say": "Last done, first undone. Take 5, then divide by 3.",
          "write": "x = 7"
        },
        {
          "say": "Try 2x take 3, all over 5, equals 7. Undo the divide first.",
          "write": "7 × 5 = 35 → 38 → 19"
        },
        {
          "say": "Undoing works only when x appears once.",
          "write": "x appears once"
        }
      ]
    },
    {
      "heading": "When undoing is not enough",
      "lines": [
        {
          "say": "In x cubed plus x equals 50, x appears twice.",
          "write": "x³ + x = 50"
        },
        {
          "say": "There's no single chain to reverse. So we search instead.",
          "write": "search"
        },
        {
          "say": "A search needs a stopping rule, like correct to one decimal place.",
          "write": "stopping rule: 1 dp"
        }
      ]
    },

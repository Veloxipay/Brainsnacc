    {
      "heading": "The halving method",
      "lines": [
        {
          "say": "First rearrange so one side is zero. x cubed equals 20 becomes this.",
          "write": "f(x) = x³ − 20"
        },
        {
          "say": "f of 2 is minus 12. f of 3 is 7. Opposite signs!",
          "write": "f(2) = −12, f(3) = 7",
          "diagram": "diagrams/y9/maths/algorithms-for-solving-equations-signchange.svg",
          "alt": "Graph of y = x³ − 20 crossing the x-axis between 2 and 3"
        },
        {
          "say": "A sign change means the graph crosses the axis between 2 and 3.",
          "write": "sign change → root between"
        },
        {
          "say": "Find the midpoint, and work out f there.",
          "write": "m = (a + b) ÷ 2"
        },
        {
          "say": "Keep the two ends whose f-values have opposite signs.",
          "write": "keep opposite signs"
        }
      ]
    },

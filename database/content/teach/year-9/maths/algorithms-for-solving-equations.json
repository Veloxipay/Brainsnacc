    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Undo the last operation first, not the first one.",
          "write": "last done, first undone"
        },
        {
          "say": "Keep the half with opposite signs at its ends.",
          "write": "opposite signs"
        },
        {
          "say": "Don't stop too early. Both ends must round to the same answer.",
          "write": "both ends round the same"
        },
        {
          "say": "Rearrange to equals zero before testing signs.",
          "write": "x³ = 20 → x³ − 20 = 0"
        }
      ]
    },

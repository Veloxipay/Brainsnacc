    {
      "heading": "Three new curves",
      "lines": [
        {
          "say": "Not every graph is a line or a parabola. Today we meet three more.",
          "write": "exponential, hyperbola, circle"
        },
        {
          "say": "Savings that double each week make an exponential.",
          "write": "y = aˣ"
        },
        {
          "say": "Sharing 12 lollies between more friends makes a hyperbola.",
          "write": "y = k/x"
        },
        {
          "say": "A dog on a 3 metre lead around a post traces a circle.",
          "write": "x² + y² = r²"
        }
      ]
    },

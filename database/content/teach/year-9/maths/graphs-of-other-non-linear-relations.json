    {
      "heading": "Growth and decay",
      "lines": [
        {
          "say": "y equals 2 to the minus x is the mirror image in the y-axis.",
          "write": "y = 2⁻ˣ",
          "diagram": "diagrams/y9/maths/graphs-of-other-non-linear-relations-exp.svg",
          "alt": "y = 2ˣ rising and y = 2⁻ˣ falling, both through (0, 1)"
        },
        {
          "say": "2 to the x rises: growth. 2 to the minus x falls: decay.",
          "write": "growth ↗   decay ↘"
        },
        {
          "say": "An asymptote is a line a graph approaches but never touches.",
          "write": "asymptote"
        }
      ]
    },
    {
      "heading": "Hyperbolas: y = k/x",
      "lines": [
        {
          "say": "Here x is on the bottom. You can't divide by 0, so x can't be 0.",
          "write": "y = k/x",
          "diagram": "diagrams/y9/maths/graphs-of-other-non-linear-relations-hyp.svg",
          "alt": "y = 4/x and y = −4/x"
        },
        {
          "say": "The graph has two separate branches. Both axes are asymptotes.",
          "write": "2 branches"
        },
        {
          "say": "For y equals 6 over x: x equals 1, 2, 3, 6 give 6, 3, 2, 1.",
          "write": "(1, 6) (2, 3) (3, 2) (6, 1)"
        },
        {
          "say": "For every point, x times y equals k. 2 times 3 is 6.",
          "write": "x × y = k"
        },
        {
          "say": "k positive: top right and bottom left. k negative: top left and bottom right.",
          "write": "k > 0: 1st & 3rd quadrants"
        }
      ]
    },

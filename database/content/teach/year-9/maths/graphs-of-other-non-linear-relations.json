    {
      "heading": "Telling them apart",
      "lines": [
        {
          "say": "x is the power? Exponential.",
          "write": "y = 3ˣ → exponential"
        },
        {
          "say": "x on the bottom of a fraction? Hyperbola.",
          "write": "y = 5/x → hyperbola"
        },
        {
          "say": "x squared plus y squared equals a number? Circle.",
          "write": "x² + y² = 16 → circle, r = 4"
        },
        {
          "say": "x squared with y on its own? Parabola.",
          "write": "y = x² − 1 → parabola"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "2 to the x never crosses the x-axis. It's always positive.",
          "write": "2ˣ > 0"
        },
        {
          "say": "Don't mix up 2 to the x and x squared. At 3, they give 8 and 9.",
          "write": "2³ = 8,  3² = 9"
        },
        {
          "say": "x squared plus y squared equals 49 has radius 7, not 49.",
          "write": "r = √49 = 7"
        },
        {
          "say": "Never join the two branches of a hyperbola.",
          "write": "✗ crossing x = 0"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "y equals a to the x passes through (0, 1), with asymptote y equals 0.",
          "write": "y = aˣ through (0, 1)"
        },
        {
          "say": "y equals k over x has two branches, and x times y equals k.",
          "write": "xy = k"
        },
        {
          "say": "x squared plus y squared equals r squared is a circle with radius r.",
          "write": "centre (0, 0), radius r"
        }
      ]
    }
  ]

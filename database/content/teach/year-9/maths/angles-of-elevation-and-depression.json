{
  "level": "Year 9",
  "subject": "maths",
  "title": "Angles of elevation and depression",
  "frames": [
    {
      "heading": "Angle of elevation",
      "lines": [
        {
          "say": "The angle of elevation is the angle you look up through.",
          "write": "looking UP",
          "diagram": "diagrams/y9/maths/angles-of-elevation-and-depression-elev.svg",
          "alt": "Looking up at a bird with angle of elevation from the horizontal"
        },
        {
          "say": "Measure it from the horizontal up to your line of sight.",
          "write": "horizontal → line of sight"
        },
        {
          "say": "The line of sight goes straight from your eye to the object.",
          "write": "line of sight"
        }
      ]
    },
    {
      "heading": "Angle of depression",
      "lines": [
        {
          "say": "The angle of depression is the angle you look down through.",
          "write": "looking DOWN",
          "diagram": "diagrams/y9/maths/angles-of-elevation-and-depression-dep.svg",
          "alt": "Looking down at a boat with angle of depression from the horizontal"
        },
        {
          "say": "Measure it from the horizontal down. Never from the cliff.",
          "write": "from the horizontal, not the wall"
        },
        {
          "say": "The horizontal at the top is parallel to the ground.",
          "write": "horizontal ∥ ground"
        },
        {
          "say": "So depression from the top equals elevation from the bottom.",
          "write": "alternate angles are equal",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Angle of depression at the top equals angle of elevation at the boat",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 60,
                "h": 220,
                "fill": "grey"
              },
              {
                "kind": "line",
                "x": 100,
                "y": 60,
                "x2": 520,
                "y2": 60,
                "color": "black",
                "dashed": true
              },
              {
                "kind": "line",
                "x": 20,
                "y": 280,
                "x2": 540,
                "y2": 280,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 100,
                "y": 60,
                "x2": 480,
                "y2": 280,
                "color": "blue",
                "stroke": 3
              },
              {
                "kind": "text",
                "x": 190,
                "y": 85,
                "text": "30°",
                "size": 20,
                "color": "purple",
                "bold": true
              },
              {
                "kind": "text",
                "x": 400,
                "y": 268,
                "text": "30°",
                "size": 20,
                "color": "green",
                "change": "add",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 480,
                "y": 272,
                "r": 10,
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 40,
                "text": "horizontal",
                "size": 16,
                "color": "grey"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "The method",
      "lines": [
        {
          "say": "Sketch it. Horizontal, vertical and line of sight make a right triangle.",
          "write": "1. sketch the triangle"
        },
        {
          "say": "Put the angle inside the triangle. Use alternate angles if needed.",
          "write": "2. angle inside"
        },
        {
          "say": "Label O, A and H from that angle. Use SOH CAH TOA.",
          "write": "3. O, A, H → SOH CAH TOA"
        },
        {
          "say": "Add any eye height, and answer the actual question.",
          "write": "4. eye height + answer"
        }
      ]
    },
    {
      "heading": "Finding a height",
      "lines": [
        {
          "say": "You stand 30 metres from a tree. The elevation to the top is 38.",
          "write": "30 m, 38°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Tree 30 m away with angle of elevation 38 degrees",
            "items": [
              {
                "kind": "rect",
                "x": 440,
                "y": 60,
                "w": 30,
                "h": 220,
                "fill": "grey"
              },
              {
                "kind": "line",
                "x": 40,
                "y": 280,
                "x2": 540,
                "y2": 280,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 80,
                "y": 280,
                "x2": 455,
                "y2": 60,
                "color": "blue",
                "stroke": 3
              },
              {
                "kind": "text",
                "x": 150,
                "y": 272,
                "text": "38°",
                "size": 20,
                "color": "purple",
                "bold": true
              },
              {
                "kind": "text",
                "x": 260,
                "y": 305,
                "text": "30 m (A)",
                "size": 18,
                "color": "black"
              }
            ]
          }
        },
        {
          "say": "The height is opposite. The 30 metres is adjacent.",
          "write": "O = h, A = 30",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Tree 30 m away with angle of elevation 38 degrees",
            "items": [
              {
                "kind": "rect",
                "x": 440,
                "y": 60,
                "w": 30,
                "h": 220,
                "fill": "grey"
              },
              {
                "kind": "line",
                "x": 40,
                "y": 280,
                "x2": 540,
                "y2": 280,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 80,
                "y": 280,
                "x2": 455,
                "y2": 60,
                "color": "blue",
                "stroke": 3
              },
              {
                "kind": "text",
                "x": 150,
                "y": 272,
                "text": "38°",
                "size": 20,
                "color": "purple",
                "bold": true
              },
              {
                "kind": "text",
                "x": 260,
                "y": 305,
                "text": "30 m (A)",
                "size": 18,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 500,
                "y": 180,
                "text": "h (O)",
                "size": 20,
                "color": "red",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Opposite and adjacent means tan.",
          "write": "tan 38° = h/30",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Tree 30 m away with angle of elevation 38 degrees",
            "items": [
              {
                "kind": "rect",
                "x": 440,
                "y": 60,
                "w": 30,
                "h": 220,
                "fill": "grey"
              },
              {
                "kind": "line",
                "x": 40,
                "y": 280,
                "x2": 540,
                "y2": 280,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 80,
                "y": 280,
                "x2": 455,
                "y2": 60,
                "color": "blue",
                "stroke": 3
              },
              {
                "kind": "text",
                "x": 150,
                "y": 272,
                "text": "38°",
                "size": 20,
                "color": "purple",
                "bold": true
              },
              {
                "kind": "text",
                "x": 260,
                "y": 305,
                "text": "30 m (A)",
                "size": 18,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 500,
                "y": 180,
                "text": "h (O)",
                "size": 20,
                "color": "red",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 180,
                "y": 60,
                "text": "tan 38° = h/30",
                "size": 24,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "h equals 30 times tan 38. About 23.4 metres.",
          "write": "h ≈ 23.4 m"
        }
      ]
    },
    {
      "heading": "From the top of a cliff",
      "lines": [
        {
          "say": "An 80 metre cliff. The depression to a boat is 24 degrees.",
          "write": "80 m, depression 24°",
          "diagram": "diagrams/y9/maths/angles-of-elevation-and-depression-ex2.svg",
          "alt": "80 m cliff with angle of depression 24 degrees to a boat"
        },
        {
          "say": "By alternate angles, the elevation from the boat is also 24.",
          "write": "elevation at boat = 24°"
        },
        {
          "say": "The cliff is opposite. The distance x is adjacent.",
          "write": "tan 24° = 80/x"
        },
        {
          "say": "x is on the bottom, so divide. About 179.7 metres.",
          "write": "x = 80 ÷ tan 24° ≈ 179.7 m"
        }
      ]
    },
    {
      "heading": "Finding the angle and eye height",
      "lines": [
        {
          "say": "A 45 metre tower, 120 metres away. Find the angle.",
          "write": "tan θ = 45/120 = 0.375"
        },
        {
          "say": "Use inverse tan. About 20.6 degrees.",
          "write": "θ = tan⁻¹(0.375) ≈ 20.6°"
        },
        {
          "say": "Eyes 1.6 metres up, 25 metres from a building, at 52 degrees.",
          "write": "tan 52° = x/25",
          "diagram": "diagrams/y9/maths/angles-of-elevation-and-depression-ex4.svg",
          "alt": "Eye level 1.6 m above ground, 25 m from building, angle 52 degrees"
        },
        {
          "say": "The triangle starts at eye level. x is about 32 metres.",
          "write": "x ≈ 32.00 m"
        },
        {
          "say": "Add the eye height back on. About 33.6 metres.",
          "write": "32.00 + 1.6 ≈ 33.6 m",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Building height is 32 metres plus 1.6 metres eye height",
            "items": [
              {
                "kind": "rect",
                "x": 380,
                "y": 30,
                "w": 80,
                "h": 260,
                "fill": "grey"
              },
              {
                "kind": "line",
                "x": 20,
                "y": 290,
                "x2": 540,
                "y2": 290,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 80,
                "y": 230,
                "x2": 380,
                "y2": 230,
                "color": "black",
                "dashed": true
              },
              {
                "kind": "rect",
                "x": 60,
                "y": 230,
                "w": 30,
                "h": 60,
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 140,
                "text": "32.00 m",
                "size": 20,
                "color": "blue",
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 265,
                "text": "1.6 m",
                "size": 20,
                "color": "red",
                "change": "add",
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "line",
                "x": 80,
                "y": 230,
                "x2": 380,
                "y2": 30,
                "color": "blue"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Watch out and remember",
      "lines": [
        {
          "say": "Always measure from the horizontal, never the vertical.",
          "write": "from the horizontal"
        },
        {
          "say": "The depression angle moves to the boat by alternate angles.",
          "write": "alternate angles"
        },
        {
          "say": "Don't forget eye height. Add it at the end.",
          "write": "+ eye height"
        },
        {
          "say": "How far from the base means the horizontal distance.",
          "write": "base distance = horizontal"
        },
        {
          "say": "Label O, A, H from the angle inside your triangle.",
          "write": "SOH CAH TOA"
        }
      ]
    }
  ]
}

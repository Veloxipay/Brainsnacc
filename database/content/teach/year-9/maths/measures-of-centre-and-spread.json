    {
      "heading": "Measures of centre",
      "lines": [
        {
          "say": "The mean is the sum of the values divided by how many there are.",
          "write": "mean = sum ÷ count"
        },
        {
          "say": "The median is the middle value, once the data is in order.",
          "write": "position (n + 1) ÷ 2"
        },
        {
          "say": "The mode is the most common value. There can be more than one, or none.",
          "write": "mode = most common"
        },
        {
          "say": "The mean uses every value, so an outlier drags it.",
          "write": "outliers drag the mean"
        }
      ]
    },

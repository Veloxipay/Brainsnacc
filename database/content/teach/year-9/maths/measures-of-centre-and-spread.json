    {
      "heading": "Mean from a frequency table",
      "lines": [
        {
          "say": "25 students say how many siblings they have.",
          "diagram": "diagrams/y9/maths/measures-of-centre-and-spread-ex3.svg",
          "alt": "Column graph of siblings for 25 students: 5, 9, 7, 3, 1"
        },
        {
          "say": "Multiply each value by its frequency. The total is 36.",
          "write": "0 + 9 + 14 + 9 + 4 = 36"
        },
        {
          "say": "Divide by 25 students, not 5 rows. The mean is 1.44.",
          "write": "36 ÷ 25 = 1.44"
        },
        {
          "say": "The 13th student has 1 sibling, so the median is 1.",
          "write": "median = mode = 1"
        }
      ]
    },
    {
      "heading": "Choosing and mistakes",
      "lines": [
        {
          "say": "Symmetric with no outliers? Use the mean.",
          "write": "symmetric → mean"
        },
        {
          "say": "Skewed or has outliers? Use the median and IQR.",
          "write": "outliers → median, IQR"
        },
        {
          "say": "Always order the data before finding the median.",
          "write": "order first!"
        },
        {
          "say": "For an odd number of values, leave the median out of both halves.",
          "write": "median not in halves"
        },
        {
          "say": "The IQR is a difference, Q3 minus Q1. Not just Q3.",
          "write": "IQR = Q3 − Q1"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Mean, median and mode measure the centre.",
          "write": "centre: mean, median, mode"
        },
        {
          "say": "Range and IQR measure the spread.",
          "write": "spread: range, IQR"
        },
        {
          "say": "The median and IQR resist outliers.",
          "write": "resist outliers"
        }
      ]
    }
  ]
}
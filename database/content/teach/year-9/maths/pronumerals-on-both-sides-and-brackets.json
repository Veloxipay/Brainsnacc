    {
      "heading": "Solving it on the balance",
      "lines": [
        {
          "say": "4 bags and minus 4 balance 16.",
          "write": "4x − 4 = 16",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": -4
            },
            "right": {
              "cubes": 16
            }
          }
        },
        {
          "say": "Add 4 to both sides. The minus 4 is cancelled. The right grows to 20.",
          "write": "4x = 20",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": -4
            },
            "right": {
              "cubes": 16
            },
            "remove": 4,
            "removeFrom": "left",
            "add": 4,
            "addTo": "right",
            "labels": [
              "4x − 4 + 4",
              "16 + 4"
            ]
          }
        },
        {
          "say": "Share 20 between 4 bags. Each gets 5.",
          "write": "x = 5",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4
            },
            "right": {
              "cubes": 20
            },
            "share": true
          }
        },
        {
          "say": "Check: 35 minus 4 is 31, and 15 plus 16 is 31.",
          "write": "31 = 31 ✓"
        }
      ]
    },
    {
      "heading": "Remove the smaller x-term",
      "lines": [
        {
          "say": "Solve 2x plus 9 equals 5x minus 3.",
          "write": "2x + 9 = 5x − 3",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 2,
              "cubes": 9
            },
            "right": {
              "bags": 5,
              "cubes": -3
            }
          }
        },
        {
          "say": "Subtract 2x, the smaller one. Then the x-term left is positive.",
          "write": "9 = 3x − 3",
          "draw": {
            "type": "balance",
            "left": {
              "cubes": 9
            },
            "right": {
              "bags": 3,
              "cubes": -3
            },
            "labels": [
              "9",
              "3x − 3"
            ]
          }
        },
        {
          "say": "Add 3 to both sides. 12 equals 3x.",
          "write": "12 = 3x",
          "draw": {
            "type": "balance",
            "left": {
              "cubes": 9
            },
            "right": {
              "bags": 3,
              "cubes": -3
            },
            "add": 3,
            "addTo": "left",
            "remove": 3,
            "removeFrom": "right",
            "labels": [
              "9 + 3",
              "3x − 3 + 3"
            ]
          }
        },
        {
          "say": "Divide by 3. x equals 4. It's fine for x to end up on the right.",
          "write": "x = 4"
        }
      ]
    },
    {
      "heading": "Brackets first",
      "lines": [
        {
          "say": "Solve 3 lots of 2x minus 1 equals 2 lots of x plus 7, plus 1.",
          "write": "3(2x − 1) = 2(x + 7) + 1"
        },
        {
          "say": "Three lots of 2x minus 1 is 6x minus 3.",
          "write": "3(2x − 1) = 6x − 3",
          "draw": {

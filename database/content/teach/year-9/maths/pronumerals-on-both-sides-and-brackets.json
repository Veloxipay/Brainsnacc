                "y": 40,
                "w": 40,
                "h": 50,
                "fill": "red",
                "label": "−1"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "3 × 2x = 6x,   3 × (−1) = −3",
                "size": 22,
                "change": "add",
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "Expand the other bracket too.",
          "write": "6x − 3 = 2x + 14 + 1"
        },
        {
          "say": "Collect like terms, then subtract 2x from both sides.",
          "write": "4x − 3 = 15"
        },
        {
          "say": "Add 3, then divide by 4. x equals 4.5.",
          "write": "x = 4.5"
        },
        {
          "say": "Careful with a negative outside. Minus 2 times minus 4 is plus 8.",
          "write": "−2(x − 4) = −2x + 8"
        }
      ]
    },
    {
      "heading": "Fractions on both sides",
      "lines": [
        {
          "say": "x plus 3 over 2 equals 2x minus 1 over 3.",
          "write": "(x + 3)/2 = (2x − 1)/3"
        },
        {
          "say": "The lowest common denominator is 6. Multiply every term by 6.",
          "write": "3(x + 3) = 2(2x − 1)"
        },
        {
          "say": "Expand: 3x plus 9 equals 4x minus 2.",
          "write": "3x + 9 = 4x − 2"
        },
        {
          "say": "Subtract 3x, then add 2. x equals 11.",
          "write": "x = 11"
        }
      ]
    },
    {
      "heading": "No solution, or every number",
      "lines": [
        {
          "say": "Sometimes the x-terms cancel completely.",
          "write": "2(x + 3) = 2x + 6"
        },
        {
          "say": "2x plus 6 equals 2x plus 6 is true for every value of x.",
          "write": "true for all x"
        },
        {
          "say": "But 2x plus 6 equals 2x plus 5 can never balance. The left is always heavier.",
          "write": "2x + 6 = 2x + 5",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 2,
              "cubes": 6
            },
            "right": {
              "bags": 2,
              "cubes": 5
            },
            "tip": "left",
            "labels": [
              "2x + 6",
              "2x + 5"
            ]
          }
        },
        {
          "say": "Take 2x from both sides and you get 6 equals 5. No solution.",
          "write": "6 = 5 → no solution"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Terms don't jump across. Subtract 2x from both sides.",
          "write": "✗ 7x + 3 = 18"
        },
        {
          "say": "Multiply the outside number by every term inside.",
          "write": "4(x − 2) = 4x − 8"
        },
        {
          "say": "With fractions, every term on both sides gets multiplied.",
          "write": "every term × LCD"
        },
        {
          "say": "12 equals 3x isn't the answer yet. Divide to get x equals 4.",
          "write": "x = 4"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Do the same to both sides to get x on one side.",
          "write": "same to BOTH sides"
        },
        {
          "say": "Brackets first: expand, then collect like terms.",
          "write": "expand → collect → solve"
        },
        {
          "say": "Clear fractions by multiplying every term by the LCD.",
          "write": "× LCD"
        },
        {
          "say": "Always check by substituting your answer.",
          "write": "check ✓"
        }
      ]
    }
  ]
}
{
  "level": "Year 9",
  "subject": "maths",
  "title": "Rounding and significant figures",
  "frames": [
    {
      "heading": "The nearest bus stop",
      "lines": [
        {
          "say": "Bus stops every 100 metres. You get off at the nearest one.",
          "write": "round to the nearest"
        },
        {
          "say": "3.47 is closer to 3.5 than to 3.4.",
          "write": "3.47 → 3.5",
          "diagram": "diagrams/y9/maths/rounding-and-significant-figures-nl.svg",
          "alt": "Number line from 3.4 to 3.5 with 3.47 marked"
        },
        {
          "say": "Exactly halfway, like 15 between 10 and 20, rounds up.",
          "write": "15 → 20",
          "diagram": "diagrams/y9/maths/rounding-and-significant-figures-half.svg",
          "alt": "Number line from 10 to 20 with 15 at the halfway point"
        }
      ]
    },
    {
      "heading": "The rounding rule",
      "lines": [
        {
          "say": "Find the last digit you keep. Look at the next digit only.",
          "write": "rounding digit + next digit"
        },
        {
          "say": "0 to 4: leave it. 5 to 9: add 1.",
          "write": "0–4 keep,  5–9 add 1"
        },

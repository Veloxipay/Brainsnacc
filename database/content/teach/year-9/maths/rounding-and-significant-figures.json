    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't round in two stages. 2.449 to 1 decimal place is 2.4.",
          "write": "✗ 2.449 → 2.45 → 2.5"
        },
        {
          "say": "0.0307 has 3 significant figures, not 5.",
          "write": "0.0307 → 3 s.f."
        },
        {
          "say": "Don't just chop digits off. Use the rounding rule.",
          "write": "✗ 6.4851 → 6.4"
        },
        {
          "say": "Round only the final answer.",
          "write": "round at the end"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Look at the next digit only. 5 or more rounds up.",
          "write": "5+ → up"
        },
        {
          "say": "Significant figures start at the first non-zero digit.",
          "write": "skip leading zeros"
        },
        {
          "say": "Estimate with 1 significant figure to check your calculator.",
          "write": "estimate to check"
        }
      ]
    }

    {
      "heading": "Surds from Pythagoras",
      "lines": [
        {
          "say": "Shorter sides 1 and 1 give a hypotenuse of root 2.",
          "write": "c = √(1² + 1²) = √2",
          "diagram": "diagrams/y9/maths/introduction-to-surds-triangle.svg",
          "alt": "Right triangle with sides 1, 1 and hypotenuse √2"
        },
        {
          "say": "Root 2 is the exact value. 1.41 is only an approximation.",
          "write": "exact: √2"
        },
        {
          "say": "Sides 2 and 3: c squared is 4 plus 9, which is 13.",
          "write": "c = √13 cm ≈ 3.61 cm"
        }
      ]
    },
    {
      "heading": "Multiplying and dividing",
      "lines": [
        {
          "say": "Root a times root b is the root of a b.",
          "write": "√a × √b = √(ab)"
        },
        {
          "say": "Root 2 times root 8 is root 16, which is 4.",
          "write": "√2 × √8 = √16 = 4"
        },
        {
          "say": "Root a divided by root b is the root of a over b.",
          "write": "√48 ÷ √3 = √16 = 4"
        },
        {
          "say": "Squaring undoes the root. Root 7, squared, is 7.",
          "write": "(√7)² = 7"
        },
        {
          "say": "3 root 2, squared, is 9 times 2, which is 18.",
          "write": "(3√2)² = 9 × 2 = 18"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "You can't add under the root. Root 9 plus root 16 is 7, not 5.",
          "write": "√9 + √16 = 3 + 4 = 7 ≠ √25"
        },
        {
          "say": "Root 7, squared, is 7, not 49.",
          "write": "(√7)² = 7"
        },
        {
          "say": "Keep surds exact until the end. Don't round too early.",
          "write": "keep √2, not 1.41"
        },
        {
          "say": "Root 64 is 8, so it is not a surd. Check for perfect squares.",
          "write": "√64 = 8"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "A surd is an irrational root, like root 2.",
          "write": "surd = irrational root"
        },
        {
          "say": "Estimate a surd using the perfect squares on either side.",
          "write": "√4 < √5 < √9"
        },
        {
          "say": "Multiply and divide under one root. Never add under one root.",
          "write": "√a × √b = √(ab)"
        }
      ]
    }
  ]

{
  "level": "Year 9",
  "subject": "maths",
  "title": "Area of composite shapes and sectors",
  "frames": [
    {
      "heading": "Area formulas you know",
      "lines": [
        {
          "say": "Rectangle is length times width. Triangle is half base times height.",
          "write": "A = l × w   A = ½bh"
        },
        {
          "say": "Parallelogram is base times perpendicular height.",
          "write": "A = bh"
        },
        {
          "say": "Trapezium is half the sum of the parallel sides, times height.",
          "write": "A = ½(a + b)h"
        },
        {
          "say": "Heights must be at right angles to the base. Never a sloping side.",
          "write": "height ⟂ base",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Perpendicular height versus sloping side",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    250
                  ],
                  [
                    400,
                    250
                  ],
                  [
                    300,
                    70

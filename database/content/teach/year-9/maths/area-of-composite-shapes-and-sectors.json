                "text": "not h",
                "size": 18,
                "color": "red",
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "A circle is pi r squared.",
          "write": "A = πr²"
        }
      ]
    },
    {
      "heading": "Sectors",

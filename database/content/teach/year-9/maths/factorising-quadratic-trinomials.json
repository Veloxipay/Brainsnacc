{
  "level": "Year 9",
  "subject": "maths",
  "title": "Factorising quadratic trinomials",
  "frames": [
    {
      "heading": "Where the pattern comes from",
      "lines": [
        {
          "say": "Expand x plus p, times x plus q.",
          "write": "(x + p)(x + q)"
        },
        {
          "say": "You get x squared, plus p plus q lots of x, plus p q.",
          "write": "x² + (p + q)x + pq"
        },
        {
          "say": "So to factorise, find two numbers that multiply to c and add to b.",
          "write": "× to c, + to b"
        },
        {
          "say": "In the area model, 3 times 4 makes the 12 in the corner.",
          "write": "3 × 4 = 12",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Area model for x² + 7x + 12",

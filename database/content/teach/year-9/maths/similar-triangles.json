              },
              {
                "kind": "text",
                "x": 188.0,
                "y": 134.0,
                "text": "D",
                "size": 18,
                "bold": true,
                "anchor": "end"
              },
              {
                "kind": "text",
                "x": 372.0,
                "y": 134.0,
                "text": "E",
                "size": 18,
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 122.0,
                "text": "5",
                "size": 18,
                "color": "blue",
                "bold": true
              },
              {
                "kind": "text",
                "x": 160.0,
                "y": 80.0,
                "text": "4",
                "size": 18,
                "color": "green",
                "bold": true
              },
              {
                "kind": "text",
                "x": 110.0,
                "y": 205.0,
                "text": "6",
                "size": 18,
                "color": "orange",
                "bold": true
              },
              {
                "kind": "line",
                "x": 268,
                "y": 36,
                "x2": 68,
                "y2": 286,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 90,
                "y": 60,
                "text": "AB = 10",
                "size": 20,
                "color": "purple",
                "bold": true
              },
              {
                "kind": "text",
                "x": 430,
                "y": 60,
                "text": "k = 10 ÷ 4 = 2.5",
                "size": 20,
                "change": "add",
                "bold": true,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 275,
                "text": "BC = 5 × 2.5 = 12.5",
                "size": 18,
                "change": "highlight",
                "color": "red",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "The hourglass",
      "lines": [
        {
          "say": "AB is parallel to DE, and the lines cross at C.",
          "diagram": "diagrams/y9/maths/similar-triangles-ex3.svg",
          "alt": "Hourglass shape with AB parallel to DE crossing at C"
        },
        {
          "say": "Vertically opposite angles at C, and alternate angles. So AAA.",
          "write": "△ABC ||| △EDC"
        },
        {
          "say": "AC matches EC. The scale factor is 9 over 6, which is 1.5.",
          "write": "k = 9 ÷ 6 = 1.5"
        },
        {
          "say": "AB matches ED. So DE is 8 times 1.5, which is 12.",
          "write": "DE = 12 cm"
        }
      ]
    },
    {
      "heading": "Checking SSS",
      "lines": [
        {
          "say": "Sides 6, 8, 10 and 9, 12, 15. Match smallest with smallest.",
          "write": "9/6, 12/8, 15/10"
        },
        {
          "say": "Every ratio is 1.5, so they're similar.",
          "write": "all 1.5 → similar ✓"
        },
        {
          "say": "What about 9, 12 and 16? 16 over 10 is 1.6, not 1.5.",
          "write": "16 ÷ 10 = 1.6 ✗",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Ratios of matching sides: 1.5, 1.5 and 1.6",
            "items": [
              {
                "kind": "text",
                "x": 200,
                "y": 60,
                "text": "9 ÷ 6",
                "size": 24,
                "bold": true
              },
              {
                "kind": "text",
                "x": 360,
                "y": 60,
                "text": "= 1.5",
                "size": 24,
                "bold": true,
                "color": "green"
              },
              {
                "kind": "text",
                "x": 200,
                "y": 115,
                "text": "12 ÷ 8",
                "size": 24,
                "bold": true
              },
              {
                "kind": "text",
                "x": 360,
                "y": 115,
                "text": "= 1.5",
                "size": 24,
                "bold": true,
                "color": "green"
              },
              {
                "kind": "text",
                "x": 200,
                "y": 170,
                "text": "16 ÷ 10",
                "size": 24,
                "bold": true
              },
              {
                "kind": "text",
                "x": 360,
                "y": 170,
                "text": "= 1.6",
                "size": 24,
                "change": "highlight",
                "bold": true,
                "color": "red"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "not all equal → not similar",
                "size": 22,
                "change": "add",
                "bold": true,
                "color": "red"
              }
            ]
          }
        },
        {
          "say": "So not similar. All three ratios must be equal.",
          "write": "not similar"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "With a parallel line, AD matches AB, not DB. Use the whole side.",
          "write": "whole side!"
        },
        {
          "say": "Match sides by their opposite angles, not by position on the page.",
          "write": "match by angles"
        },
        {
          "say": "For SSS, check all three ratios.",
          "write": "all three"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Similar: equal angles, sides in the same ratio.",
          "write": "same shape"
        },
        {
          "say": "Tests: AAA, SSS, SAS and RHS.",
          "write": "AAA  SSS  SAS  RHS"
        },
        {
          "say": "Scale factor: large divided by small, from a matching pair.",
          "write": "k = large ÷ small"
        }
      ]
    }
  ]
}
{
  "level": "Year 9",
  "subject": "maths",
  "title": "Similar triangles",
  "frames": [
    {
      "heading": "A photo and its thumbnail",
      "lines": [
        {
          "say": "A thumbnail is the same picture as the full photo, just smaller.",
          "write": "same shape, different size",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "A triangle and a smaller similar triangle",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    270
                  ],
                  [
                    300,
                    270
                  ],
                  [
                    120,
                    60
                  ]
                ],
                "fill": "blue"
              }
            ]
          }
        },
        {
          "say": "Every angle is the same. Every length shrinks by the same amount.",
          "write": "scale factor k",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "A triangle and a smaller similar triangle",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    270
                  ],
                  [
                    300,
                    270
                  ],
                  [
                    120,
                    60
                  ]
                ],
                "fill": "blue"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    360,
                    270
                  ],
                  [
                    490,
                    270
                  ],
                  [
                    400,
                    165
                  ]
                ],
                "fill": "orange",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 430,
                "y": 140,
                "text": "× ½",
                "size": 22,
                "change": "add",
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "Similar triangles are a triangle and its thumbnail.",
          "write": "△ABC ||| △PQR"
        }
      ]
    },
    {
      "heading": "What similar means",
      "lines": [
        {
          "say": "Matching angles are equal: A with P, B with Q, C with R.",
          "write": "∠A = ∠P, ∠B = ∠Q, ∠C = ∠R"
        },
        {
          "say": "Matching sides are all in the same ratio, the scale factor.",
          "write": "PQ/AB = QR/BC = PR/AC = k"
        },
        {
          "say": "Similar means same shape. Congruent means same shape and same size.",
          "write": "similar ≠ congruent"
        }
      ]
    },
    {
      "heading": "The four tests",
      "lines": [
        {
          "say": "AAA: two pairs of equal angles. The third pair must match too.",
          "write": "AAA",
          "diagram": "diagrams/y9/maths/similar-triangles-aa.svg",
          "alt": "Triangles ABC and PQR with angles 40° and 75° equal"
        },
        {
          "say": "SSS: all three pairs of sides in the same ratio.",
          "write": "SSS",
          "diagram": "diagrams/y9/maths/similar-triangles-sss.svg",
          "alt": "Triangles with sides 8, 6, 4 and 12, 9, 6, every ratio 1.5"
        },
        {
          "say": "SAS: two sides in the same ratio, and the included angle equal.",
          "write": "SAS"
        },
        {
          "say": "RHS: right angles, with the hypotenuses and one other side in ratio.",
          "write": "RHS"
        }
      ]
    },
    {
      "heading": "A line parallel to one side",
      "lines": [
        {
          "say": "DE is parallel to BC. AD is 4, DB is 6 and DE is 5.",
          "write": "DE ∥ BC",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Triangle ABC with DE parallel to BC, AD = 4, DB = 6, DE = 5",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    280,
                    30
                  ],
                  [
                    80,
                    280
                  ],
                  [
                    480,
                    280
                  ]
                ],
                "fill": "none"
              },
              {
                "kind": "line",
                "x": 200.0,
                "y": 130.0,
                "x2": 360.0,
                "y2": 130.0,
                "color": "blue"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 22,
                "text": "A",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 68,
                "y": 290,
                "text": "B",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 492,
                "y": 290,
                "text": "C",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 188.0,
                "y": 134.0,
                "text": "D",
                "size": 18,
                "bold": true,
                "anchor": "end"
              },
              {
                "kind": "text",
                "x": 372.0,
                "y": 134.0,
                "text": "E",
                "size": 18,
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 122.0,
                "text": "5",
                "size": 18,
                "color": "blue",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 275,
                "text": "BC = ?",
                "size": 18,
                "color": "red",
                "bold": true
              },
              {
                "kind": "text",
                "x": 160.0,
                "y": 80.0,
                "text": "4",
                "size": 18,
                "color": "green",
                "bold": true
              },
              {
                "kind": "text",
                "x": 110.0,
                "y": 205.0,
                "text": "6",
                "size": 18,
                "color": "orange",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "The triangles share angle A, and corresponding angles are equal. AAA.",
          "write": "△ADE ||| △ABC"
        },
        {
          "say": "AD matches the whole side AB. That's 4 plus 6, which is 10.",
          "write": "AB = 4 + 6 = 10",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Triangle ABC with DE parallel to BC, AD = 4, DB = 6, DE = 5",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    280,
                    30
                  ],
                  [
                    80,
                    280
                  ],
                  [
                    480,
                    280
                  ]
                ],
                "fill": "none"
              },
              {
                "kind": "line",
                "x": 200.0,
                "y": 130.0,
                "x2": 360.0,
                "y2": 130.0,
                "color": "blue"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 22,
                "text": "A",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 68,
                "y": 290,
                "text": "B",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 492,
                "y": 290,
                "text": "C",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 188.0,
                "y": 134.0,
                "text": "D",
                "size": 18,
                "bold": true,
                "anchor": "end"
              },
              {
                "kind": "text",
                "x": 372.0,
                "y": 134.0,
                "text": "E",
                "size": 18,
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 122.0,
                "text": "5",
                "size": 18,
                "color": "blue",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 275,
                "text": "BC = ?",
                "size": 18,
                "color": "red",
                "bold": true
              },
              {
                "kind": "text",
                "x": 160.0,
                "y": 80.0,
                "text": "4",
                "size": 18,
                "color": "green",
                "bold": true
              },
              {
                "kind": "text",
                "x": 110.0,
                "y": 205.0,
                "text": "6",
                "size": 18,
                "change": "remove",
                "color": "orange",
                "bold": true
              },
              {
                "kind": "line",
                "x": 268,
                "y": 36,
                "x2": 68,
                "y2": 286,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 90,
                "y": 60,
                "text": "AB = 10",
                "size": 20,
                "change": "add",
                "color": "purple",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Scale factor 10 over 4 is 2.5. So BC is 5 times 2.5, which is 12.5.",
          "write": "BC = 12.5 cm",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Triangle ABC with DE parallel to BC, AD = 4, DB = 6, DE = 5",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    280,
                    30
                  ],
                  [
                    80,
                    280
                  ],
                  [
                    480,
                    280
                  ]
                ],
                "fill": "none"
              },
              {
                "kind": "line",
                "x": 200.0,
                "y": 130.0,
                "x2": 360.0,
                "y2": 130.0,
                "color": "blue"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 22,
                "text": "A",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 68,
                "y": 290,
                "text": "B",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 492,
                "y": 290,
                "text": "C",
                "size": 18,

        {
          "say": "18 dollars out of 240, as a percentage: divide, then times 100.",
          "write": "18 ÷ 240 × 100% = 7.5%"
        }
      ]
    },
    {
      "heading": "Multipliers",
      "lines": [
        {
          "say": "A multiplier does a percentage change in one step.",
          "write": "one-step multiplier"
        },
        {
          "say": "Increase by r percent: multiply by 100 plus r, percent.",
          "write": "45% mark-up → × 1.45"
        },
        {
          "say": "Decrease by r percent: multiply by 100 minus r, percent.",
          "write": "25% discount → × 0.75"
        }
      ]
    },
    {
      "heading": "Discounts",
      "lines": [
        {
          "say": "A pair of shoes costs 84 dollars.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bar model of a 25% discount on $84",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 500,
                "h": 70,
                "fill": "blue",
                "label": "100% = $84"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "$84 × 0.75",
                "size": 24,
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "Take 25 percent off. That leaves 75 percent.",
          "write": "× 0.75",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bar model of a 25% discount on $84",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 375,
                "h": 70,
                "fill": "blue",
                "label": "$84"
              },
              {
                "kind": "rect",
                "x": 405,
                "y": 80,
                "w": 125,
                "h": 70,
                "fill": "red",
                "label": "25% off",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "25% off leaves 75%",
                "size": 24,
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "84 times 0.75 is 63 dollars.",
          "write": "84 × 0.75 = $63",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bar model of a 25% discount on $84",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 375,
                "h": 70,
                "fill": "blue",
                "label": "pay 75% of $84 = $63",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "84 × 0.75 = $63",
                "size": 24,
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "Check: 25 percent of 84 is 21, and 84 minus 21 is 63.",
          "write": "84 − 21 = 63 ✓"
        }
      ]
    },
    {
      "heading": "Adding GST",
      "lines": [
        {
          "say": "GST is a 10 percent tax on most goods and services in Australia.",
          "write": "GST = 10%",
          "diagram": "diagrams/y9/maths/percentages-and-money-gst.svg",
          "alt": "Bar model: $200 plus a 10% GST piece of $20 makes $220"
        },
        {
          "say": "To add GST, multiply by 1.1. A 200 dollar heater becomes 220.",
          "write": "200 × 1.1 = $220"
        },
        {
          "say": "The GST was 20 dollars.",
          "write": "GST = $20"
        }
      ]
    },
    {
      "heading": "Taking GST out",
      "lines": [
        {
          "say": "A helmet costs 154 dollars including GST.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bar model: price before GST plus a 10% GST piece",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 400,
                "h": 70,
                "fill": "blue",
                "label": "price before GST"
              },
              {
                "kind": "text",
                "x": 250,
                "y": 40,
                "text": "110% = price × 1.1",
                "size": 20,
                "bold": true
              }
            ]
          }
        },
        {
          "say": "154 dollars is 110 percent. That's 11 lots of 10 percent.",
          "write": "154 = 110%",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bar model: price before GST plus a 10% GST piece",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 400,
                "h": 70,
                "fill": "blue",
                "label": "price before GST"
              },
              {
                "kind": "rect",
                "x": 430,
                "y": 80,
                "w": 40,
                "h": 70,
                "fill": "orange",
                "label": "GST",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 250,
                "y": 40,
                "text": "$154 = 110% = 11 lots of 10%",
                "size": 20,
                "bold": true
              }
            ]
          }
        },
        {
          "say": "The GST is one lot. 154 divided by 11 is 14 dollars.",
          "write": "GST = 154 ÷ 11 = $14",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bar model: price before GST plus a 10% GST piece",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 400,
                "h": 70,
                "fill": "blue",
                "label": "$140"
              },
              {
                "kind": "rect",
                "x": 430,
                "y": 80,
                "w": 40,
                "h": 70,
                "fill": "orange",
                "label": "GST"
              },
              {
                "kind": "text",
                "x": 250,
                "y": 40,
                "text": "$154 = 110% = 11 lots of 10%",
                "size": 20,
                "bold": true
              },
              {
                "kind": "text",
                "x": 250,
                "y": 210,
                "text": "GST = 154 ÷ 11 = $14",
                "size": 24,
                "change": "add",
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "The price before GST is 140 dollars. Check: 140 times 1.1 is 154.",
          "write": "154 ÷ 1.1 = $140 ✓"
        }
      ]
    },
    {
      "heading": "Mark-ups and profit",
      "lines": [
        {
          "say": "A shop buys a kettle for 60 dollars and marks it up 45 percent.",
          "write": "60 × 1.45 = $87",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Cost price, marked price and sale price of a kettle",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 30,
                "w": 300,
                "h": 50,
                "fill": "blue",
                "label": "cost $60"
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 100,
                "w": 435,
                "h": 50,
                "fill": "orange",
                "label": "marked $87",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Then it takes 20 percent off in a sale.",
          "write": "87 × 0.8 = $69.60",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Cost price, marked price and sale price of a kettle",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 30,
                "w": 300,
                "h": 50,
                "fill": "blue",
                "label": "cost $60"
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 100,
                "w": 435,
                "h": 50,
                "fill": "orange",
                "label": "marked $87"
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 170,
                "w": 348.0,
                "h": 50,
                "fill": "green",
                "label": "sale $69.60",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 500,
                "y": 240,
                "text": "profit $9.60 = 16%",
                "size": 20,
                "change": "add",
                "bold": true,
                "color": "purple",
                "anchor": "end"
              }
            ]
          }
        },
        {
          "say": "Profit is selling price minus cost price: 9 dollars 60.",
          "write": "69.60 − 60 = $9.60"
        },
        {
          "say": "Percentage profit: divide by the cost price, 60. That's 16 percent.",
          "write": "9.60 ÷ 60 × 100% = 16%"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't take 10 percent of a price that already includes GST.",
          "write": "✗ $15.40   ✓ $14"
        },
        {
          "say": "For 25 percent off, multiply by 0.75, not 0.25.",
          "write": "× 0.75"
        },
        {
          "say": "Divide by the cost price for percentage profit.",
          "write": "÷ cost price"
        },
        {
          "say": "45 percent up then 20 percent off is not 25 percent. Multiply the multipliers.",
          "write": "1.45 × 0.8 = 1.16"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Increase: times 1 plus r. Decrease: times 1 minus r.",
          "write": "× (1 + r),  × (1 − r)"
        },
        {
          "say": "Add GST: times 1.1. GST in an inclusive price: divide by 11.",
          "write": "× 1.1,   ÷ 11"
        },
        {
          "say": "Profit percent is profit over cost price, times 100.",
          "write": "profit ÷ cost × 100%"
        }
      ]
    }
  ]
}
{
  "level": "Year 9",
  "subject": "maths",
  "title": "Finding angles with trigonometry",
  "frames": [
    {
      "heading": "Inverse trig functions",
      "lines": [
        {
          "say": "Last time we found sides. Now we find angles.",
          "write": "find the angle θ"
        },
        {
          "say": "Inverse sine answers: which angle has this sine?",
          "write": "sin⁻¹(0.5) = 30°"
        },
        {
          "say": "Because sine of 30 degrees is 0.5.",
          "write": "sin 30° = 0.5",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Sine and inverse sine undo each other",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 90,
                "w": 160,
                "h": 80,
                "fill": "blue",
                "label": "30°",
                "labelSize": 28
              },
              {
                "kind": "arrow",
                "x": 210,
                "y": 110,
                "x2": 350,
                "y2": 110,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 95,
                "text": "sin",
                "size": 20,
                "color": "purple"
              },
              {
                "kind": "rect",
                "x": 360,
                "y": 90,
                "w": 160,
                "h": 80,
                "fill": "orange",
                "label": "0.5",
                "labelSize": 28
              },
              {
                "kind": "arrow",
                "x": 350,
                "y": 160,
                "x2": 210,
                "y2": 160,
                "color": "green",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 195,
                "text": "sin⁻¹",
                "size": 22,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Press shift, then sin. The minus 1 is not a power.",
          "write": "SHIFT sin = sin⁻¹"
        },
        {
          "say": "Cos inverse and tan inverse work the same way.",
          "write": "cos⁻¹   tan⁻¹"
        }
      ]
    },

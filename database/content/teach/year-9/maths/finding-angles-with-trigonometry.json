    {
      "heading": "Tan and cos",
      "lines": [
        {
          "say": "Opposite 9, adjacent 4. That's TOA.",
          "write": "tan θ = 9/4 = 2.25",
          "diagram": "diagrams/y9/maths/finding-angles-with-trigonometry-ex2.svg",
          "alt": "Right triangle with opposite 9 m and adjacent 4 m"
        },
        {
          "say": "Tan inverse of 2.25 is about 66 degrees.",
          "write": "θ ≈ 66.0°"
        },
        {
          "say": "Opposite is longer than adjacent, so more than 45 makes sense.",
          "write": "O > A → θ > 45°"
        },
        {
          "say": "Adjacent 11, hypotenuse 14. That's CAH.",
          "write": "cos θ = 11/14",
          "diagram": "diagrams/y9/maths/finding-angles-with-trigonometry-ex3.svg",
          "alt": "Right triangle with adjacent 11 cm and hypotenuse 14 cm"
        },
        {
          "say": "Cos inverse of 11 over 14 is about 38.2 degrees.",
          "write": "θ ≈ 38.2°"
        }
      ]
    },
    {
      "heading": "The other angle",
      "lines": [
        {
          "say": "A ramp rises 1.2 metres over 9 metres.",
          "write": "tan θ = 1.2/9",
          "diagram": "diagrams/y9/maths/finding-angles-with-trigonometry-ex4.svg",
          "alt": "Ramp with rise 1.2 m over 9 m"
        },
        {
          "say": "Tan inverse gives about 7.6 degrees with the ground.",
          "write": "θ ≈ 7.6°"
        },
        {
          "say": "The two acute angles add to 90. So the top angle is about 82.4.",
          "write": "90° − 7.6° ≈ 82.4°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "The two acute angles add to 90 degrees",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    250
                  ],
                  [
                    520,
                    250
                  ],
                  [
                    520,
                    190
                  ]
                ],
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 110,
                "y": 240,
                "text": "7.6°",
                "size": 20,
                "color": "red",
                "bold": true
              },
              {
                "kind": "text",
                "x": 500,
                "y": 215,
                "text": "82.4°",
                "size": 20,
                "color": "green",
                "change": "add",
                "bold": true,
                "anchor": "end"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "7.6° + 82.4° = 90°",
                "size": 26,
                "color": "purple",
                "change": "highlight",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "A quick check",
      "lines": [
        {
          "say": "Sine and cos values must be between 0 and 1.",
          "write": "0 ≤ sin, cos ≤ 1"
        },
        {
          "say": "A fraction bigger than 1? The hypotenuse is on top, or you picked the wrong side.",
          "write": "sin θ = 8/5 ✗"
        },
        {
          "say": "The calculator will show an error.",
          "write": "Math ERROR"
        },
        {
          "say": "Tan can be bigger than 1. That's fine.",
          "write": "tan can be > 1"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Use sin inverse, not sin, when you want an angle.",
          "write": "SHIFT for angles"
        },
        {
          "say": "Label O, A and H from theta before you pick a ratio.",
          "write": "label first"
        },
        {
          "say": "SOH CAH TOA. The first letter goes on top.",
          "write": "tan θ = O/A, not A/O"
        },
        {
          "say": "Check your calculator is in degrees. Look for D or DEG.",
          "write": "DEG mode"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Label, choose, write, inverse.",
          "write": "label → choose → write → inverse",

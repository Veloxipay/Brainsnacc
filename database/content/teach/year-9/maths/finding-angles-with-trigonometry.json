          "say": "Inverse trig turns a ratio back into an angle.",
          "write": "sin⁻¹ cos⁻¹ tan⁻¹"
        },
        {
          "say": "The two acute angles add to 90 degrees.",
          "write": "acute angles sum to 90°"
        },
        {
          "say": "Round as asked, usually one decimal place.",
          "write": "1 dp"

{
  "level": "Year 9",
  "subject": "maths",
  "title": "Two-step chance experiments",
  "frames": [
    {
      "heading": "Two things, one after another",
      "lines": [
        { "say": "Roll two dice, spin twice, or pick two names. That's a two-step experiment.", "write": "two-step experiment" },
        { "say": "The sample space is the list of all possible outcomes.", "write": "sample space" },
        { "say": "Write each outcome as an ordered pair. 2, 5 is not the same as 5, 2.", "write": "(2, 5) ≠ (5, 2)" }
      ]
    },
    {
      "heading": "Multiply the menus",
      "lines": [
        {
          "say": "2 hats and 3 T-shirts. Each hat goes with each shirt.",
          "write": "2 × 3 = 6 outfits",
          "draw": {
            "type": "shapes", "width": 560, "height": 280, "alt": "2 hats each joined to 3 shirts making 6 outfits",
            "items": [
              { "kind": "rect", "x": 60, "y": 60, "w": 90, "h": 50, "fill": "blue", "label": "Hat 1" },
              { "kind": "rect", "x": 60, "y": 170, "w": 90, "h": 50, "fill": "blue", "label": "Hat 2" },
              { "kind": "rect", "x": 400, "y": 20, "w": 110, "h": 50, "fill": "orange", "label": "Shirt A" },
              { "kind": "rect", "x": 400, "y": 115, "w": 110, "h": 50, "fill": "orange", "label": "Shirt B" },
              { "kind": "rect", "x": 400, "y": 210, "w": 110, "h": 50, "fill": "orange", "label": "Shirt C" },
              { "kind": "line", "x": 150, "y": 85, "x2": 400, "y2": 45, "color": "purple", "change": "add" },
              { "kind": "line", "x": 150, "y": 85, "x2": 400, "y2": 140, "color": "purple", "change": "add" },
              { "kind": "line", "x": 150, "y": 85, "x2": 400, "y2": 235, "color": "purple", "change": "add" },
              { "kind": "line", "x": 150, "y": 195, "x2": 400, "y2": 45, "color": "green", "change": "add" },
              { "kind": "line", "x": 150, "y": 195, "x2": 400, "y2": 140, "color": "green", "change": "add" },
              { "kind": "line", "x": 150, "y": 195, "x2": 400, "y2": 235, "color": "green", "change": "add" }
            ]
          }
        },
        { "say": "m outcomes then n outcomes gives m times n outcomes.", "write": "m × n" },
        { "say": "A coin and a die give 2 times 6, which is 12. Not 8.", "write": "2 × 6 = 12" }
      ]
    },
    {
      "heading": "Coin and spinner",
      "lines": [
        { "say": "Toss a coin and spin a spinner from 1 to 4.", "write": "2 × 4 = 8 outcomes" },
        {
          "say": "Put the coin down the side and the spinner across the top.",
          "diagram": "diagrams/y9/maths/two-step-chance-experiments-ex1.svg",
          "alt": "Table of outcomes H1 to H4 and T1 to T4 with H2 and H4 highlighted"
        },
        { "say": "Head and an even number is H2 or H4. That's 2 cells.", "write": "(H, 2), (H, 4)" },
        { "say": "Probability is favourable over total. 2 over 8 is a quarter.", "write": "P = 2/8 = 1/4" }
      ]
    },
    {
      "heading": "Two dice",
      "lines": [
        { "say": "Two dice make a 6 by 6 table. That's 36 equally likely cells.", "write": "6 × 6 = 36" },
        {
          "say": "A sum of 7 appears in 6 cells, along the diagonal.",
          "write": "P(7) = 6/36 = 1/6",
          "diagram": "diagrams/y9/maths/two-step-chance-experiments-ex2.svg",
          "alt": "6 by 6 table of dice sums with the six cells summing to 7 highlighted"
        },
        { "say": "10 or more is 3 cells, plus 2, plus 1. That's 6 cells.", "write": "P(≥ 10) = 6/36 = 1/6" },
        { "say": "Seven is heaven. It has the most cells of any sum." }
      ]
    },
    {
      "heading": "Without replacement",
      "lines": [
        { "say": "Cards 1, 2, 3 and 4 in a bag. Draw two, without putting the first back.", "write": "cards 1–4" },
        {
          "say": "You can't pick the same card twice. So cross out the diagonal.",
          "write": "4 × 4 − 4 = 12",
          "draw": {
            "type": "shapes", "width": 560, "height": 300, "alt": "4 by 4 grid with the diagonal cells crossed out",
            "items": [
              { "kind": "rect", "x": 140, "y": 30, "w": 60, "h": 60, "fill": "grey", "label": "1,1", "change": "remove" },
              { "kind": "rect", "x": 200, "y": 30, "w": 60, "h": 60, "fill": "white", "label": "1,2" },
              { "kind": "rect", "x": 260, "y": 30, "w": 60, "h": 60, "fill": "white", "label": "1,3" },
              { "kind": "rect", "x": 320, "y": 30, "w": 60, "h": 60, "fill": "yellow", "label": "1,4" },
              { "kind": "rect", "x": 140, "y": 90, "w": 60, "h": 60, "fill": "white", "label": "2,1" },
              { "kind": "rect", "x": 200, "y": 90, "w": 60, "h": 60, "fill": "grey", "label": "2,2", "change": "remove" },
              { "kind": "rect", "x": 260, "y": 90, "w": 60, "h": 60, "fill": "yellow", "label": "2,3" },
              { "kind": "rect", "x": 320, "y": 90, "w": 60, "h": 60, "fill": "white", "label": "2,4" },
              { "kind": "rect", "x": 140, "y": 150, "w": 60, "h": 60, "fill": "white", "label": "3,1" },
              { "kind": "rect", "x": 200, "y": 150, "w": 60, "h": 60, "fill": "yellow", "label": "3,2" },
              { "kind": "rect", "x": 260, "y": 150, "w": 60, "h": 60, "fill": "grey", "label": "3,3", "change": "remove" },
              { "kind": "rect", "x": 320, "y": 150, "w": 60, "h": 60, "fill": "white", "label": "3,4" },
              { "kind": "rect", "x": 140, "y": 210, "w": 60, "h": 60, "fill": "yellow", "label": "4,1" },
              { "kind": "rect", "x": 200, "y": 210, "w": 60, "h": 60, "fill": "white", "label": "4,2" },
              { "kind": "rect", "x": 260, "y": 210, "w": 60, "h": 60, "fill": "white", "label": "4,3" },
              { "kind": "rect", "x": 320, "y": 210, "w": 60, "h": 60, "fill": "grey", "label": "4,4", "change": "remove" }
            ]
          }
        },
        { "say": "Sums of 5 are the yellow cells. 4 out of 12 is a third.", "write": "P(5) = 4/12 = 1/3" },
        { "say": "With replacement, all 16 cells count. Still 4 sums of 5. That's a quarter.", "write": "P(5) = 4/16 = 1/4" }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        { "say": "Multiply the number of outcomes. Don't add them.", "write": "✗ 2 + 6 = 8" },
        { "say": "The sums 2 to 12 are not equally likely. Count the 36 cells.", "write": "count cells, not sums" },
        { "say": "2, 5 and 5, 2 are separate cells.", "write": "(2, 5) and (5, 2)" },
        { "say": "Without replacement, cross out the diagonal.", "write": "no repeats" }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        { "say": "Multiply the menus. m times n outcomes.", "write": "m × n" },
        { "say": "Probability is favourable cells over total cells.", "write": "P = favourable ÷ total" },
        { "say": "No replacement, no repeats.", "write": "cross out diagonal" },
        { "say": "Seven is heaven on two dice.", "write": "P(7) = 1/6" }
      ]
    }
  ]
}

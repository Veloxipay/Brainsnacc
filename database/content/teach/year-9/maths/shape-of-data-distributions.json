    {
      "heading": "Bimodal, clusters, gaps and outliers",
      "lines": [
        {
          "say": "Two clear peaks is bimodal. Often two groups are mixed together.",
          "write": "bimodal",
          "diagram": "diagrams/y9/maths/shape-of-data-distributions-ex2.svg",
          "alt": "Dot plot with clusters at 4 to 8 and 13 to 16 and a dot at 28"
        },
        {
          "say": "A cluster is a group of values bunched together, like 4 to 8.",
          "write": "clusters: 4–8, 13–16"
        },
        {
          "say": "A gap is an interval with no values. Here, between 8 and 13.",
          "write": "gap: 8 to 13"
        },
        {
          "say": "28 is far from the rest. That's an outlier.",
          "write": "outlier: 28"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A peak on the left with a tail to the right is positively skewed.",
          "write": "follow the tail"
        },
        {
          "say": "Two peaks is bimodal, not skewed. Count the peaks first.",
          "write": "count the peaks"
        },
        {
          "say": "The biggest value isn't automatically an outlier. It must be far away.",
          "write": "far from the rest"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Describe the shape first, then outliers, clusters and gaps.",
          "write": "shape → outliers, clusters, gaps"
        },
        {
          "say": "Name the skew after the direction of the tail.",
          "write": "tail right +,  tail left −"
        },
        {
          "say": "The tail drags the mean. The median stays put.",
          "write": "mean follows the tail"
        }
      ]
    }
  ]

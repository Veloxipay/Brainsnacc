{
  "level": "Year 9",
  "subject": "maths",
  "title": "Shape of data distributions",
  "frames": [
    {
      "heading": "Shapes of data",
      "lines": [
        {
          "say": "Picture a playground slide from the side: a tall ladder and a long slope.",
          "write": "pile + tail"
        },
        {
          "say": "Data often has a big pile in one place and a long thin tail.",
          "write": "tail"
        },
        {
          "say": "We name the shape after where the tail points.",
          "write": "follow the tail"
        }
      ]
    },
    {
      "heading": "Symmetric",
      "lines": [
        {
          "say": "Symmetric means the left half mirrors the right half.",
          "write": "symmetric",
          "diagram": "diagrams/y9/maths/shape-of-data-distributions-sym.svg",
          "alt": "Symmetric histogram of adult heights"
        },
        {
          "say": "Most values are in the middle, thinning out evenly on both sides.",
          "write": "like adult heights"
        },
        {
          "say": "In a symmetric distribution, the mean and median are about equal.",
          "write": "mean ≈ median"
        }
      ]
    },

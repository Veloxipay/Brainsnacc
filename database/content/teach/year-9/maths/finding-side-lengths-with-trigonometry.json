          "write": "H = hypotenuse",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A right-angled triangle with the angle 35° marked",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    80,

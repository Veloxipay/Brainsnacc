              },
              {
                "kind": "text",
                "x": 455,
                "y": 160,
                "text": "O",
                "size": 20,
                "change": "add",
                "color": "blue",
                "bold": true,
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "The side next to the angle is the adjacent.",
          "write": "A = adjacent",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A right-angled triangle with the angle 35° marked",
            "items": [
              {

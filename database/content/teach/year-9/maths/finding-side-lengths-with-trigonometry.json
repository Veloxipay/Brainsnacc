{
  "level": "Year 9",
  "subject": "maths",
  "title": "Finding side lengths with trigonometry",
  "frames": [
    {
      "heading": "One angle and one side",
      "lines": [
        {
          "say": "Know one angle and one side of a right triangle? Trig finds any other side.",
          "diagram": "diagrams/y9/maths/finding-side-lengths-with-trigonometry-key.svg",
          "alt": "Right triangle with a 35° angle, adjacent 8 cm and opposite x"
        },
        {
          "say": "Builders use it for roof rafters. Councils use it to check ramps.",
          "write": "angle + side → any side"
        },
        {
          "say": "We do it in four steps: label, choose, write, solve.",
          "write": "Label → Choose → Write → Solve"
        }
      ]
    },
    {
      "heading": "Step 1: label the sides",
      "lines": [
        {
          "say": "Start from the angle you are given. Here it is 35 degrees.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A right-angled triangle with the angle 35° marked",

              },
              {
                "kind": "text",
                "x": 150,
                "y": 240,
                "text": "35°",
                "size": 18,
                "color": "purple",
                "bold": true
              },
              {
                "kind": "text",
                "x": 225,
                "y": 140,
                "text": "H",
                "size": 20,

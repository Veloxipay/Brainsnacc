    {
      "heading": "Polygons",
      "lines": [
        {
          "say": "A polygon with n sides splits into n take 2 triangles.",
          "write": "(n − 2) × 180°"
        },
        {
          "say": "A pentagon's angles add to 3 times 180, which is 540.",
          "write": "(5 − 2) × 180° = 540°",
          "diagram": "diagrams/y9/maths/angle-properties-review-ex4.svg",
          "alt": "Pentagon with angles 100, 110, 95, 120 and x"
        },
        {
          "say": "The known angles add to 425. So x is 540 take 425.",
          "write": "x = 115°"
        },
        {
          "say": "Exterior angles of any convex polygon add to 360.",
          "write": "exterior sum = 360°"
        },
        {
          "say": "Regular polygon? Each exterior angle is 360 over n.",
          "write": "ext = 360° ÷ n"
        }
      ]
    },
    {
      "heading": "Give a reason every time",
      "lines": [
        {
          "say": "In Year 9 every step needs a short reason.",
          "write": "every step + reason"
        },
        {
          "say": "Say angles on a straight line, or vertically opposite angles.",
          "write": "\"angles on a straight line\""
        },
        {
          "say": "Name the parallel lines too. Alternate angles, AB parallel to CD.",
          "write": "\"alternate angles, AB ∥ CD\""
        },
        {
          "say": "Don't mix up Z and C. Z is equal, C adds to 180.",
          "write": "Z equal, C 180°"
        },
        {
          "say": "And never use n times 180 for a polygon.",
          "write": "✗ n × 180°"
        }
      ]
    },

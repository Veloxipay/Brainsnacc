    {
      "heading": "Triangles",
      "lines": [
        {
          "say": "Angles in a triangle add to 180.",
          "write": "angle sum = 180°"
        },
        {
          "say": "An exterior angle equals the two interior opposite angles added.",
          "write": "ext = 50° + 60° = 110°",
          "diagram": "diagrams/y9/maths/angle-properties-review-exterior.svg",
          "alt": "Triangle with angles 50 and 60 and exterior angle 110"
        },
        {
          "say": "Isosceles triangles have equal base angles.",
          "write": "base angles equal"
        },
        {
          "say": "AB equals AC, and angle A is 40. Base angles are 70 each.",
          "write": "(180° − 40°) ÷ 2 = 70°",
          "diagram": "diagrams/y9/maths/angle-properties-review-ex2.svg",
          "alt": "Isosceles triangle with apex 40 degrees and exterior angle ACD"
        },
        {
          "say": "So angle ACD is 180 take 70, which is 110.",
          "write": "∠ACD = 110°"
        }
      ]
    },

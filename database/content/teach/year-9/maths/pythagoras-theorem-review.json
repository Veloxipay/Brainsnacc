{
  "level": "Year 9",
  "subject": "maths",
  "title": "Pythagoras’ theorem review",
  "frames": [
    {
      "heading": "A shortcut across a park",
      "lines": [
        {
          "say": "Walking two edges of a park is like the two shorter sides of a triangle.",
          "write": "a and b"
        },
        {
          "say": "Cutting straight across is the hypotenuse.",
          "write": "c"
        },
        {
          "say": "It's shorter than going around, but longer than either edge alone.",
          "write": "c is the longest side"
        }
      ]
    },
    {
      "heading": "The hypotenuse",
      "lines": [
        {
          "say": "The hypotenuse is the longest side, opposite the right angle.",
          "write": "hypotenuse = c",
          "diagram": "diagrams/y9/maths/pythagoras-theorem-review-hyp.svg",
          "alt": "Right triangle with shorter sides a and b and hypotenuse c"
        },
        {
          "say": "It doesn't touch the little square.",
          "write": "opposite the right angle"
        },
        {
          "say": "In every right-angled triangle, c squared equals a squared plus b squared.",
          "write": "c² = a² + b²"
        }
      ]
    },
    {
      "heading": "Squares on the sides",
      "lines": [
        {
          "say": "Take a triangle with shorter sides 3 and 4. Draw a square on side a.",
          "write": "a² = 9",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "A 3-4-5 right triangle with squares on the two shorter sides",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    200,
                    150
                  ],
                  [
                    360,
                    150
                  ],
                  [
                    200,
                    30
                  ]
                ],
                "fill": "none"
              },
              {
                "kind": "line",
                "x": 200,
                "y": 132,
                "x2": 218,
                "y2": 132,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 218,
                "y": 132,
                "x2": 218,
                "y2": 150,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 80,
                "y": 30,
                "w": 120,
                "h": 120,
                "fill": "blue",
                "label": "a² = 9"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "b = 4",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 210,
                "y": 80,
                "text": "a = 3",
                "size": 18,
                "bold": true,
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "Now a square on side b. Its area is 16.",
          "write": "b² = 16",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "A 3-4-5 right triangle with squares on the two shorter sides",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    200,
                    150
                  ],
                  [
                    360,
                    150
                  ],
                  [
                    200,
                    30
                  ]
                ],
                "fill": "none"
              },
              {
                "kind": "line",
                "x": 200,
                "y": 132,
                "x2": 218,
                "y2": 132,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 218,
                "y": 132,
                "x2": 218,
                "y2": 150,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 80,
                "y": 30,
                "w": 120,
                "h": 120,
                "fill": "blue",
                "label": "a² = 9"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "b = 4",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 210,
                "y": 80,
                "text": "a = 3",
                "size": 18,
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 200,
                "y": 150,
                "w": 160,
                "h": 160,
                "fill": "orange",
                "label": "b² = 16",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Add them: 25. The square root gives c equals 5.",
          "write": "c = √25 = 5",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "A 3-4-5 right triangle with squares on the two shorter sides",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    200,
                    150
                  ],
                  [
                    360,
                    150
                  ],
                  [
                    200,
                    30
                  ]
                ],
                "fill": "none"
              },
              {
                "kind": "line",
                "x": 200,
                "y": 132,
                "x2": 218,
                "y2": 132,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 218,
                "y": 132,
                "x2": 218,
                "y2": 150,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 80,
                "y": 30,
                "w": 120,
                "h": 120,
                "fill": "blue",
                "label": "a² = 9"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "b = 4",
                "size": 18,
                "bold": true
              },
              {
                "kind": "text",
                "x": 210,
                "y": 80,
                "text": "a = 3",
                "size": 18,
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "rect",
                "x": 200,
                "y": 150,
                "w": 160,
                "h": 160,
                "fill": "orange",
                "label": "b² = 16"
              },
              {
                "kind": "text",
                "x": 460,
                "y": 250,
                "text": "c² = 9 + 16 = 25",
                "size": 22,
                "change": "add",
                "bold": true,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 290,
                "y": 80,
                "text": "c = 5",
                "size": 20,
                "change": "add",
                "bold": true,
                "color": "red",
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "We add the squares, not the lengths.",
          "write": "✗ 3 + 4 = 7"
        }
      ]
    },
    {
      "heading": "Finding the hypotenuse",
      "lines": [
        {
          "say": "Shorter sides 12 and 16 centimetres.",
          "diagram": "diagrams/y9/maths/pythagoras-theorem-review-ex1.svg",
          "alt": "Right triangle with sides 12 cm and 16 cm and hypotenuse c"
        },
        {
          "say": "144 plus 256 is 400.",
          "write": "c² = 12² + 16² = 400"
        },
        {
          "say": "The square root of 400 is 20 centimetres. Longer than 16. Good.",
          "write": "c = 20 cm ✓"
        }
      ]
    },
    {
      "heading": "Finding a shorter side",
      "lines": [
        {
          "say": "Hypotenuse 11, one side 6. Find the other side, x.",
          "diagram": "diagrams/y9/maths/pythagoras-theorem-review-ex2.svg",
          "alt": "Right triangle with hypotenuse 11 m, side 6 m and side x"
        },
        {
          "say": "x is a shorter side, so subtract. 121 minus 36 is 85.",
          "write": "x² = 11² − 6² = 85"
        },
        {
          "say": "x is root 85. That's the exact answer.",
          "write": "x = √85"
        },
        {
          "say": "Rounded at the end, that's about 9.2 metres.",
          "write": "x ≈ 9.2 m"
        },
        {
          "say": "Long side: add. Short side: subtract.",
          "write": "long +,  short −"
        }
      ]
    },
    {
      "heading": "A ladder against a wall",
      "lines": [
        {
          "say": "A 4.5 metre ladder, with its foot 1.2 metres from the wall.",
          "diagram": "diagrams/y9/maths/pythagoras-theorem-review-ex3.svg",
          "alt": "Ladder 4.5 m long, foot 1.2 m from the wall, height h"
        },
        {
          "say": "The ladder is the hypotenuse. So subtract.",
          "write": "h² = 4.5² − 1.2² = 18.81"
        },
        {
          "say": "The square root is about 4.34 metres.",
          "write": "h ≈ 4.34 m"
        }
      ]
    },
    {
      "heading": "Is it right-angled?",
      "lines": [
        {
          "say": "Sides 20, 21 and 29. The longest, 29, would be the hypotenuse.",
          "write": "20² + 21² = 29² ?"
        },
        {
          "say": "400 plus 441 is 841. And 29 squared is 841.",
          "write": "841 = 841 ✓"
        },
        {
          "say": "They're equal, so the triangle is right-angled. That's the converse.",
          "write": "converse → right angle"
        }
      ]
    },
    {
      "heading": "Watch out and remember",
      "lines": [
        {
          "say": "Ask first: am I finding the longest side?",
          "write": "add or subtract?"
        },
        {
          "say": "Don't forget the square root at the end.",
          "write": "√ at the end"
        },
        {
          "say": "Keep full values and round once, at the end.",
          "write": "round once"
        },
        {
          "say": "The hypotenuse must always be the longest side.",
          "write": "check: c is longest"
        }
      ]
    }
  ]
}
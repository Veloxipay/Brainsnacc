              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Compounding monthly",
      "lines": [
        {
          "say": "2000 dollars at 6 percent per year, compounded monthly, for 2 years.",
          "write": "6% p.a. monthly, 2 years"
        },
        {
          "say": "Divide the rate by 12. 0.06 over 12 is 0.005.",
          "write": "r = 0.06 ÷ 12 = 0.005"
        },
        {
          "say": "Multiply the years by 12. That's 24 months.",
          "write": "n = 2 × 12 = 24"
        },
        {
          "say": "A equals 2000 times 1.005 to the 24. About 2254 dollars 32.",
          "write": "A ≈ $2254.32"
        }
      ]
    },
    {
      "heading": "Compound versus simple",
      "lines": [
        {
          "say": "Simple interest adds the same amount every year.",
          "write": "simple: equal steps",
          "diagram": "diagrams/y9/maths/introduction-to-compound-interest-compare.svg",
          "alt": "Simple versus compound balances of $1000 at 10% over 5 years"
        },
        {
          "say": "After 5 years, simple interest gives 1500 dollars.",
          "write": "simple: $1500"
        },
        {
          "say": "Compound gives 1000 times 1.1 to the 5. That's 1610 dollars 51.",
          "write": "compound: $1610.51"
        },
        {
          "say": "That's 110 dollars 51 more, from interest on interest.",
          "write": "difference $110.51"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Compound interest is not P times r times n.",
          "write": "✗ P × r × n"
        },
        {
          "say": "Don't forget the 1 plus. The multiplier for 10 percent is 1.1.",
          "write": "✓ × 1.1   ✗ × 0.1"
        },
        {
          "say": "For monthly compounding, use the monthly rate and the number of months.",
          "write": "r ÷ 12,  n × 12"
        },
        {
          "say": "If the question asks for interest, subtract the principal.",
          "write": "I = A − P"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Each period, the balance is multiplied by 1 plus r.",
          "write": "× (1 + r) each period"
        },
        {
          "say": "A equals P times 1 plus r, to the n.",
          "write": "A = P(1 + r)ⁿ"
        },
        {
          "say": "Keep the full value and round money to the cent at the end.",
          "write": "round at the end"
        }
      ]
    }
  ]
}
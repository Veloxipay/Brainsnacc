    {
      "heading": "The formula",
      "lines": [
        {
          "say": "Each year we multiply by 1 plus r. After n years:",
          "write": "A = P(1 + r)ⁿ"
        },
        {
          "say": "P is the principal, A is the final amount.",
          "write": "P = principal, A = amount"
        },
        {
          "say": "r is the rate per period as a decimal. n is the number of periods.",
          "write": "r per period, n periods"
        },
        {
          "say": "Check: 1000 times 1.1 cubed is 1331. It matches.",
          "write": "1000 × 1.1³ = $1331 ✓"
        },
        {
          "say": "The interest earned is the final amount minus the principal.",
          "write": "I = A − P"
        }
      ]
    },
    {
      "heading": "Using the formula",
      "lines": [
        {
          "say": "5000 dollars at 4 percent per year for 6 years.",
          "write": "P = 5000, r = 0.04, n = 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Principal $5000 grows to $6326.60",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 380,
                "h": 60,
                "fill": "blue",
                "label": "P = $5000"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "P = 5000, r = 0.04, n = 6",
                "size": 22,
                "bold": true
              }
            ]
          }
        },
        {
          "say": "A equals 5000 times 1.04 to the 6.",
          "write": "A = 5000 × 1.04⁶"
        },
        {
          "say": "That's about 6326 dollars 60. Round to the cent at the end.",
          "write": "A ≈ $6326.60"
        },
        {
          "say": "The interest is 6326.60 minus 5000, which is 1326 dollars 60.",
          "write": "I = $1326.60",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Principal $5000 grows to $6326.60",
            "items": [
              {
                "kind": "rect",

{
  "level": "Year 9",
  "subject": "maths",
  "title": "Integers, fractions and decimals review",
  "frames": [
    {
      "heading": "Integers: adding and subtracting",
      "lines": [
        {
          "say": "Think of a bank balance that can go below zero.",
          "write": "−$30 means you owe $30"
        },
        {
          "say": "Adding a negative is subtracting. 5 plus minus 8 is minus 3.",
          "write": "5 + (−8) = −3",
          "draw": {
            "type": "numberline",
            "from": -4,
            "to": 6,
            "start": 5,
            "jump": -8
          }
        },
        {
          "say": "Subtracting a negative is adding. 4 minus minus 6 is 10.",
          "write": "4 − (−6) = 10",
          "draw": {
            "type": "numberline",
            "from": 0,
            "to": 11,
            "start": 4,
            "jump": 6
          }
        },
        {
          "say": "Like the bank cancelling a charge: your balance goes up.",
          "write": "− (−20) = + 20"
        }
      ]
    },
    {
      "heading": "Multiplying and dividing signs",
      "lines": [
        {
          "say": "Same signs give a positive. Different signs give a negative.",
          "write": "same +,  different −"
        },
        {
          "say": "Minus 4 times minus 5 is 20. 18 divided by minus 3 is minus 6.",
          "write": "(−4) × (−5) = 20"
        },
        {
          "say": "Minus 3, in brackets, squared is 9. Without brackets it's minus 9.",
          "write": "(−3)² = 9,  −3² = −9"
        },
        {
          "say": "Order: brackets, powers, times and divide, then plus and minus.",
          "write": "B  P  × ÷  + −"
        },
        {
          "say": "Minus 6 minus minus 9, plus 4 times minus 2. Multiply first.",
          "write": "−6 + 9 − 8 = −5"
        }
      ]
    },

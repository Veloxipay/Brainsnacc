        {
          "say": "Add the tops: 17 twelfths, which is 1 and 5 twelfths.",
          "write": "= 17/12 = 1 5/12"
        },
        {
          "say": "Never add the tops and the bottoms. It's not five sevenths.",
          "write": "✗ 5/7"
        }
      ]
    },
    {
      "heading": "Multiplying and dividing fractions",
      "lines": [
        {
          "say": "Change mixed numbers to improper fractions first.",
          "write": "2⅓ × 1⅘ = 7/3 × 9/5"
        },
        {
          "say": "Multiply tops and bottoms: 63 over 15, which simplifies to 4 and a fifth.",
          "write": "= 63/15 = 4⅕"
        },
        {
          "say": "To divide, multiply by the reciprocal of the second fraction.",
          "write": "÷ ⅝ = × 8/5"
        },
        {
          "say": "1 and three quarters divided by five eighths is 2 and four fifths.",
          "write": "7/4 × 8/5 = 56/20 = 2⅘"
        }
      ]
    },

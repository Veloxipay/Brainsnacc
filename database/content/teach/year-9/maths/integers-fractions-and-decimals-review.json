    {
      "heading": "Decimals",
      "lines": [
        {
          "say": "0.3 times 0.4: 3 times 4 is 12, with 2 decimal places.",
          "write": "0.3 × 0.4 = 0.12"
        },
        {
          "say": "To divide by a decimal, move both points the same number of places.",
          "write": "4.2 ÷ 0.06 = 420 ÷ 6"
        },
        {
          "say": "420 divided by 6 is 70. Check: 70 times 0.06 is 4.2.",
          "write": "= 70 ✓"
        },
        {
          "say": "Fraction to decimal: divide the top by the bottom.",
          "write": "⅜ = 3 ÷ 8 = 0.375"
        }
      ]
    },
    {
      "heading": "Ordering numbers",
      "lines": [
        {
          "say": "Change everything to decimals, then use a number line.",
          "diagram": "diagrams/y9/maths/integers-fractions-and-decimals-review-order.svg",
          "alt": "Number line from −4 to 3 with −3.5, −¾, 1¼ and 2 marked"
        },
        {
          "say": "Further left is smaller. Minus 3.5 is smaller than minus three quarters.",
          "write": "−3.5 < −¾"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Subtracting a negative means adding.",
          "write": "− (−) = +"
        },
        {
          "say": "Common denominators before adding fractions.",
          "write": "same bottom first"
        },
        {
          "say": "Dividing fractions: flip the second one and multiply.",
          "write": "÷ → × reciprocal"
        },
        {
          "say": "Count decimal places when you multiply decimals.",
          "write": "0.3 × 0.4 = 0.12"
        }
      ]
    }

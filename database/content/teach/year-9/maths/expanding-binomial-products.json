  "title": "Expanding binomial products",
  "frames": [
    {
      "heading": "What is a binomial?",
      "lines": [
        {
          "say": "A binomial has exactly two terms, like x plus 5.",
          "write": "x + 5   2x − 3"
        },
        {
          "say": "A binomial product is two binomials multiplied together.",
          "write": "(x + 5)(x + 3)"
        },
        {
          "say": "To expand it, every term multiplies every term.",
          "write": "every term × every term"
        },
        {
          "say": "That's four products. a c, a d, b c and b d.",
          "write": "(a + b)(c + d) = ac + ad + bc + bd"
        }
      ]
    },

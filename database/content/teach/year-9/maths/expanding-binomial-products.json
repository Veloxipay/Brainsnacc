    {
      "heading": "FOIL",
      "lines": [
        {
          "say": "FOIL is a checklist. First, outer, inner, last.",
          "write": "F O I L"
        },
        {
          "say": "Firsts, x times x. Outers, x times 3.",
          "write": "F: x²   O: 3x"
        },
        {
          "say": "Inners, 5 times x. Lasts, 5 times 3.",
          "write": "I: 5x   L: 15"
        },
        {
          "say": "Check with x equals 1. 6 times 4 is 24, and 1 plus 8 plus 15 is 24.",
          "write": "24 = 24 ✓"
        }
      ]
    },

  "title": "Congruent triangles",
  "frames": [
    {
      "heading": "Congruence notation",
      "lines": [
        {
          "say": "Congruent means exactly the same shape and size.",
          "write": "≅ means congruent"
        },
        {
          "say": "Triangle ABC is congruent to triangle PQR. Order matters.",
          "write": "△ABC ≅ △PQR",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Matching vertices in order",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "△ABC ≅ △PQR",
                "size": 44,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 130,
                "w": 150,
                "h": 70,
                "fill": "blue",
                "change": "add",
                "label": "A ↔ P"
              },
              {
                "kind": "rect",
                "x": 205,
                "y": 130,
                "w": 150,
                "h": 70,
                "fill": "green",
                "change": "add",
                "label": "B ↔ Q"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 130,
                "w": 150,
                "h": 70,
                "fill": "orange",
                "change": "add",
                "label": "C ↔ R"
              }
            ]
          }
        },
        {
          "say": "A matches P, B matches Q, C matches R. So AB equals PQ.",
          "write": "AB = PQ, ∠B = ∠Q"
        },
        {
          "say": "These matching sides and angles are corresponding parts.",
          "write": "corresponding parts"
        },
        {
          "say": "Tick marks show equal sides. Arcs show equal angles.",
          "write": "ticks = sides, arcs = angles"
        }
      ]
    },

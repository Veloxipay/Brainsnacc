    {
      "heading": "What is NOT enough",
      "lines": [
        {
          "say": "AAA isn't a test. Same angles can give a bigger copy.",
          "write": "✗ AAA",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Two similar triangles of different sizes",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    250
                  ],
                  [
                    160,
                    250
                  ],
                  [
                    70,
                    170
                  ]
                ],
                "fill": "blue"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    240,
                    250
                  ],
                  [
                    520,
                    250
                  ],
                  [
                    310,
                    63
                  ]
                ],
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 295,
                "text": "same angles, different size",
                "size": 20,
                "color": "red",
                "change": "highlight",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "That's similarity. You always need at least one pair of sides.",
          "write": "need a side"
        },
        {
          "say": "SSA isn't a test either. The third side can swing two ways.",
          "write": "✗ SSA"
        }
      ]
    },
    {
      "heading": "Writing a proof",
      "lines": [
        {
          "say": "AB and CD cross at M, the midpoint of both.",
          "write": "M midpoint of AB and CD",
          "diagram": "diagrams/y9/maths/congruent-triangles-ex4.svg",
          "alt": "Segments AB and CD crossing at their midpoint M"
        },
        {
          "say": "AM equals BM, because M is the midpoint of AB.",
          "write": "AM = BM (midpoint)"
        },
        {
          "say": "Angle AMC equals angle BMD. Vertically opposite.",
          "write": "∠AMC = ∠BMD (vert. opp.)"
        },
        {
          "say": "CM equals DM, because M is the midpoint of CD.",
          "write": "CM = DM (midpoint)"
        },
        {
          "say": "The angle is between the sides. Name the test.",
          "write": "△AMC ≅ △BMD (SAS)"
        }
      ]
    },
    {
      "heading": "Using congruence",
      "lines": [
        {
          "say": "Triangle ABC is congruent to PQR. Find x and y.",
          "write": "△ABC ≅ △PQR",
          "diagram": "diagrams/y9/maths/congruent-triangles-ex3.svg",
          "alt": "Triangle ABC and turned triangle PQR with x and y"
        },
        {
          "say": "PQ matches AB, so x is 10 centimetres.",
          "write": "x = 10 cm"
        },
        {
          "say": "Angle Q matches angle B. 180 take 70 take 46 is 64.",
          "write": "y = 64°"
        },
        {
          "say": "Look for free facts. Common sides, vertically opposite and alternate angles.",
          "write": "free facts"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Write the vertices in matching order.",
          "write": "match the order"
        },
        {
          "say": "SSS, SAS, AAS, RHS. Never AAA or SSA.",
          "write": "SSS SAS AAS RHS"
        },
        {
          "say": "For SAS, the angle must sit between the two sides.",
          "write": "included angle"
        },
        {
          "say": "Three facts, each with a reason, then name the test.",
          "write": "3 facts + reasons + test"
        }
      ]
    }
  ]

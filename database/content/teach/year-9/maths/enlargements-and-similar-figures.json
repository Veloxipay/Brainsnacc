    {
      "heading": "Centre not at the origin",
      "lines": [
        {
          "say": "Enlarge P, at 2, 3, from C, at 1, 1, by scale factor 3.",
          "write": "P(2, 3), C(1, 1), k = 3"
        },
        {
          "say": "Count steps from the centre. 1 right and 2 up.",
          "write": "C → P: 1 right, 2 up",
          "diagram": "diagrams/y9/maths/enlargements-and-similar-figures-ex2.svg",
          "alt": "Triangle PQR enlarged from C(1, 1) by scale factor 3"
        },
        {
          "say": "Multiply the steps by 3. 3 right and 6 up.",
          "write": "× 3: 3 right, 6 up"
        },
        {
          "say": "Add back on to the centre. P dash is 4, 7.",
          "write": "P′(4, 7)"
        },
        {
          "say": "Count from the centre, not the origin.",
          "write": "count from the centre"
        }
      ]
    },
    {
      "heading": "Similar figures",
      "lines": [
        {
          "say": "Similar figures are enlargements of each other, maybe turned or flipped.",
          "write": "||| means similar"
        },
        {
          "say": "Matching angles are equal.",
          "write": "angles equal"
        },
        {
          "say": "Matching sides are all in the same ratio, the scale factor.",
          "write": "sides in the same ratio",
          "diagram": "diagrams/y9/maths/enlargements-and-similar-figures-similar.svg",
          "alt": "Two similar trapezia with scale factor 1.5"
        },
        {
          "say": "Scale factor is image length over original length.",
          "write": "k = new ÷ old"
        }
      ]
    },
    {
      "heading": "Finding missing sides",
      "lines": [
        {
          "say": "The small hypotenuse is 5. The big one is 7.5.",
          "write": "k = 7.5 ÷ 5 = 1.5",
          "diagram": "diagrams/y9/maths/enlargements-and-similar-figures-ex1.svg",
          "alt": "Right triangles 3-4-5 and a larger similar one with hypotenuse 7.5"
        },
        {
          "say": "x matches 4. 4 times 1.5 is 6 centimetres.",
          "write": "x = 4 × 1.5 = 6 cm"
        },
        {
          "say": "y matches 3. 3 times 1.5 is 4.5 centimetres.",
          "write": "y = 3 × 1.5 = 4.5 cm"
        },
        {
          "say": "Bigger image? k must be bigger than 1.",
          "write": "bigger → k > 1"
        }
      ]
    },
    {
      "heading": "Is it similar?",
      "lines": [
        {
          "say": "8 by 12 and 10 by 15. 10 over 8 is 1.25. 15 over 12 is 1.25.",
          "write": "same k = 1.25 ✓",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Comparing rectangle side ratios",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 100,
                "w": 80,
                "h": 120,
                "fill": "blue",
                "label": "8×12"
              },
              {
                "kind": "rect",
                "x": 150,
                "y": 70,
                "w": 100,
                "h": 150,
                "fill": "green",
                "change": "add",
                "label": "10×15"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 260,
                "text": "k = 1.25 both",
                "size": 18,
                "color": "green",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 100,
                "w": 80,
                "h": 120,
                "fill": "blue",
                "label": "8×12"
              },
              {
                "kind": "rect",
                "x": 450,
                "y": 80,
                "w": 100,
                "h": 140,
                "fill": "red",
                "change": "highlight",
                "label": "10×14"
              },
              {
                "kind": "text",
                "x": 440,
                "y": 260,
                "text": "1.25 vs 1.17 ✗",
                "size": 18,
                "color": "red",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "8 by 12 and 10 by 14. 1.25 and about 1.17. Not similar.",
          "write": "different k ✗"
        },
        {
          "say": "All rectangles have right angles, but they're not all similar.",
          "write": "check the side ratios"
        },
        {
          "say": "Adding 3 centimetres to every side doesn't make a similar shape.",
          "write": "multiply, don't add"
        }
      ]
    },
    {
      "heading": "Perimeter and area",
      "lines": [
        {
          "say": "Perimeter is a length, so multiply it by k.",
          "write": "perimeter × k"
        },
        {
          "say": "Area is length times length, so it's multiplied by k squared.",
          "write": "area × k²"
        },
        {
          "say": "Scale factor 2 makes a square 4 times the area.",
          "write": "k = 2 → area × 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,

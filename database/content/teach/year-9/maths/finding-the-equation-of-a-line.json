        },
        {
          "say": "So the gradient is 2, and the equation is y equals 2x minus 3.",
          "write": "y = 2x − 3"
        },
        {
          "say": "Check: x equals 2 gives 4 minus 3, which is 1. It matches.",
          "write": "2(2) − 3 = 1 ✓"
        }
      ]
    },
    {
      "heading": "From a gradient and a point",
      "lines": [
        {
          "say": "Gradient 3, through the point (2, 5). Start with what we know.",
          "write": "y = 3x + c",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "The point (2, 5)",
            "items": [
              {
                "kind": "arrow",
                "x": 40,
                "y": 232.7,
                "x2": 520,
                "y2": 232.7,
                "color": "grey"
              },
              {
                "kind": "arrow",
                "x": 160.0,
                "y": 280,
                "x2": 160.0,
                "y2": 20,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 524,
                "y": 238.7,
                "text": "x",
                "size": 16,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 168.0,
                "y": 32,
                "text": "y",
                "size": 16,
                "anchor": "start"
              },
              {
                "kind": "circle",
                "x": 400.0,
                "y": 114.5,
                "r": 6,
                "fill": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 408.0,
                "y": 106.5,
                "text": "(2, 5)",
                "size": 16,
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "The point is on the line, so it must make the rule true.",
          "write": "5 = 3(2) + c"
        },
        {
          "say": "3 times 2 is 6. So 5 equals 6 plus c.",
          "write": "5 = 6 + c"
        },
        {
          "say": "Take 6 from both sides. c is minus 1.",
          "write": "c = −1"
        },
        {
          "say": "The equation is y equals 3x minus 1.",
          "write": "y = 3x − 1",
          "draw": {
            "type": "shapes",
            "width": 560,

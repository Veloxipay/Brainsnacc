    },
    {
      "heading": "From two points",
      "lines": [
        {
          "say": "Two points: (−2, 7) and (4, −2). Find the gradient first.",
          "diagram": "diagrams/y9/maths/finding-the-equation-of-a-line-two.svg",
          "alt": "A line through (−2, 7) and (4, −2)"
        },
        {
          "say": "Rise is minus 9, run is 6. So m is minus three over two.",
          "write": "m = −9 ÷ 6 = −3/2"
        },
        {
          "say": "Substitute (−2, 7). Minus three halves times minus 2 is plus 3.",
          "write": "7 = (−3/2)(−2) + c = 3 + c"
        },
        {
          "say": "Take 3 from both sides, so c equals 4.",
          "write": "y = −3/2 x + 4"
        },
        {
          "say": "Check with the other point. Minus 6 plus 4 is minus 2. It works.",
          "write": "(−3/2)(4) + 4 = −2 ✓"
        }
      ]
    },
    {
      "heading": "From the intercepts",
      "lines": [
        {
          "say": "x-intercept 6 and y-intercept minus 2. These are two points.",
          "write": "(6, 0) and (0, −2)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Line through the intercepts (6, 0) and (0, −2)",
            "items": [
              {
                "kind": "arrow",
                "x": 40,
                "y": 150.0,
                "x2": 520,
                "y2": 150.0,
                "color": "grey"
              },
              {
                "kind": "arrow",
                "x": 184.0,
                "y": 280,
                "x2": 184.0,
                "y2": 20,
                "color": "grey"
              },

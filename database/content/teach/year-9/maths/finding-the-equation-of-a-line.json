                "text": "x",
                "size": 16,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 192.0,
                "y": 32,
                "text": "y",
                "size": 16,
                "anchor": "start"
              },
              {
                "kind": "line",
                "x": 40.0,
                "y": 280.0,
                "x2": 520.0,
                "y2": 135.6,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 472.0,
                "y": 150.0,
                "r": 6,
                "fill": "green",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 452.0,
                "y": 174.0,
                "text": "(6, 0)",
                "size": 16,
                "anchor": "start"
              },
              {
                "kind": "circle",
                "x": 184.0,
                "y": 236.7,
                "r": 6,
                "fill": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 192.0,
                "y": 228.7,
                "text": "(0, −2)",
                "size": 16,
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "The gradient is 2 over 6, which is one third.",
          "write": "m = 2 ÷ 6 = ⅓"
        },
        {
          "say": "c is the y-intercept, minus 2. So y equals one third x minus 2.",
          "write": "y = ⅓x − 2"
        },
        {
          "say": "A horizontal line is y equals a number. A vertical line is x equals a number.",
          "write": "y = b      x = a"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't use the x-intercept as c. c is where it crosses the y-axis.",
          "write": "c = y when x = 0"
        },
        {
          "say": "Don't forget to multiply by m. It's 3 times 2, not just 2.",
          "write": "✗ 5 = 2 + c"
        },
        {
          "say": "Put negatives in brackets and multiply signs carefully.",
          "write": "(−3/2)(−2) = +3"
        },
        {
          "say": "Don't stop at m. Find c too, then check with a point.",
          "write": "m, c, check"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Find m, then find c, then check.",
          "write": "m → c → check"
        },
        {
          "say": "A point on the line makes the rule true. Substitute it to find c.",
          "write": "substitute the point"
        },
        {
          "say": "From two points, the gradient comes first.",
          "write": "m = (y₂ − y₁) ÷ (x₂ − x₁)"
        },
        {
          "say": "Vertical lines are x equals a number. They have no y equals m x plus c form.",
          "write": "vertical: x = a"
        }
      ]
    }
  ]
}
{
  "level": "Year 9",
  "subject": "maths",
  "title": "Finding the equation of a line",
  "frames": [
    {
      "heading": "Working backwards",
      "lines": [
        {
          "say": "Now we're given a line, and we have to write its rule.",
          "write": "line → rule"
        },
        {
          "say": "Every non-vertical line can be written as y equals m x plus c.",
          "write": "y = mx + c"
        },
        {
          "say": "m is the gradient. c is the y-intercept.",
          "write": "m = gradient,  c = y-intercept"
        },
        {
          "say": "So our job is to find two numbers: m and c.",
          "write": "Find m, then c"
        }
      ]
    },
    {
      "heading": "From a graph",
      "lines": [

    {
      "heading": "The shortcut",
      "lines": [
        {
          "say": "Both steps together give one formula.",
          "write": "d² = l² + w² + h²"
        },
        {
          "say": "Check: 144 plus 16 plus 9 is 169. Same answer.",
          "write": "12² + 4² + 3² = 169 ✓"
        },
        {
          "say": "Keep b squared as 160. Don't round b before step 2.",
          "write": "use b², not rounded b"
        }
      ]
    },
    {
      "heading": "Cones",
      "lines": [
        {
          "say": "In a cone, the height, radius and slant height make a right triangle.",
          "write": "s² = r² + h²",
          "diagram": "diagrams/y9/maths/pythagoras-in-3d-cone.svg",
          "alt": "A cone with radius r, height h and slant height s"
        },
        {
          "say": "Radius 6 and height 9: s squared is 36 plus 81, which is 117.",
          "write": "s² = 117"
        },
        {
          "say": "The slant height is root 117, about 10.8 centimetres.",
          "write": "s ≈ 10.8 cm"
        }
      ]
    },
    {
      "heading": "Pyramids",
      "lines": [
        {
          "say": "A square pyramid has base side 10 and sloping edges of 13 metres.",
          "diagram": "diagrams/y9/maths/pythagoras-in-3d-ex3.svg",
          "alt": "Square pyramid with base 10 m, edge 13 m and height h"
        },
        {
          "say": "The height meets the centre. Half the base diagonal, squared, is 50.",
          "write": "half-diagonal² = 200 ÷ 4 = 50"
        },
        {
          "say": "The edge is the hypotenuse, so subtract: 169 minus 50 is 119.",
          "write": "h² = 13² − 50 = 119"
        },
        {
          "say": "The height is root 119, about 10.9 metres.",
          "write": "h ≈ 10.9 m"
        }
      ]
    },
    {
      "heading": "Cylinders",
      "lines": [
        {
          "say": "The longest straw in a can goes across the full diameter and up.",
          "diagram": "diagrams/y9/maths/pythagoras-in-3d-ex4.svg",
          "alt": "A cylinder 7 cm wide and 12 cm tall with the longest rod x"
        },
        {
          "say": "Diameter 7 and height 12: 49 plus 144 is 193.",
          "write": "x² = 7² + 12² = 193"
        },
        {
          "say": "The straw is root 193, about 13.9 centimetres.",
          "write": "x ≈ 13.9 cm"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't stop at the floor. Have you gone up as well as across?",
          "write": "base diagonal ≠ space diagonal"
        },
        {
          "say": "In a cylinder, use the diameter, not the radius.",
          "write": "diameter!"
        },
        {
          "say": "In a pyramid, use half the side or half the diagonal.",
          "write": "the height meets the centre"
        },
        {
          "say": "Never just add the lengths. Square, add, then square root.",
          "write": "✗ 12 + 4 + 3"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Find the hidden right triangle and sketch it flat.",
          "write": "sketch it flat"
        },
        {
          "say": "For a box: floor first, then up.",
          "write": "d² = l² + w² + h²"
        },
        {
          "say": "For a cone: s squared equals r squared plus h squared.",
          "write": "s² = r² + h²"
        }
      ]
    }
  ]
}
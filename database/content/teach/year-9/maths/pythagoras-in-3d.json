    {
      "heading": "A sheet of glass in a box",
      "lines": [
        {
          "say": "Slide a sheet of glass diagonally into a shoebox.",
          "write": "3D → 2D"
        },
        {
          "say": "On that flat sheet you can draw a right-angled triangle.",
          "write": "find the hidden triangle"
        },
        {
          "say": "Every 3D Pythagoras problem is really a 2D problem.",
          "write": "c² = a² + b²"
        }
      ]

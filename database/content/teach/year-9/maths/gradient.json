  "subject": "maths",
  "title": "Gradient",
  "frames": [
    {
      "heading": "What is gradient?",
      "lines": [
        {
          "say": "Gradient is a number that measures how steep a line is.",
          "write": "Gradient = steepness"
        },
        {
          "say": "It also tells you which way the line slopes.",
          "write": "m"
        },
        {
          "say": "Think of a staircase. Steepness is the height of a step over its depth.",
          "write": "height ÷ depth"
        }
      ]
    },

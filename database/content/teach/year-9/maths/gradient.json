    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't put the run on top. Rise over run: y goes on top.",
          "write": "✗ run ÷ rise"
        },
        {
          "say": "Start both subtractions with the same point.",
          "write": "same order top and bottom"
        },
        {
          "say": "Bracket negatives. 3 minus minus 1 is 4, not 2.",
          "write": "3 − (−1) = 4"
        },
        {
          "say": "Negative doesn't mean gentle. Minus 3 is steeper than 2.",
          "write": "−3 steeper than 2"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Gradient is rise over run.",
          "write": "m = rise ÷ run"
        },
        {
          "say": "Rise before you run. You stand up before you start running.",
          "write": "y on top"
        },
        {
          "say": "Uphill plus, downhill minus, flat zero, wall undefined.",
          "write": "+  −  0  undefined"
        },
        {
          "say": "On a real graph, the gradient is a rate with units.",
          "write": "e.g. L per minute"
        }
      ]
    }

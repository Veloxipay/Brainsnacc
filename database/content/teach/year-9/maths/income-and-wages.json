{
  "level": "Year 9",
  "subject": "maths",
  "title": "Income and wages",
  "frames": [
    {
      "heading": "Ways to be paid",
      "lines": [
        {
          "say": "People get paid in different ways. Let's learn to check a payslip.",
          "write": "wage, salary, commission"
        },
        {
          "say": "A wage works like a taxi meter. Every hour adds to your pay.",
          "write": "Wage = rate × hours"
        },
        {
          "say": "A salary is a fixed amount for the year, paid in equal parts.",
          "write": "salary p.a."
        }
      ]
    },
    {
      "heading": "Wages",
      "lines": [
        {
          "say": "Mia earns 26 dollars 50 an hour. Here are her hours.",
          "diagram": "diagrams/y9/maths/income-and-wages-hours.svg",
          "alt": "Mia's hours: 6, 8, 7.5, 4, 8"
        },
        {
          "say": "Add the hours: 6 plus 8 plus 7.5 plus 4 plus 8 is 33.5.",
          "write": "33.5 hours"
        },
        {
          "say": "Rate times hours: 26.50 times 33.5.",
          "write": "26.50 × 33.5 = $887.75"
        }
      ]
    },
    {
      "heading": "Salary",
      "lines": [
        {
          "say": "Sophie's salary is 78 thousand dollars per annum. That means per year.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "A salary split into weekly, fortnightly and monthly pay",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 40,
                "w": 500,
                "h": 60,
                "fill": "green",
                "label": "$78 000 per year"
              }
            ]
          }
        },
        {
          "say": "A year has 52 weeks. Divide by 52 to get 1500 a week.",
          "write": "78 000 ÷ 52 = $1500",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "A salary split into weekly, fortnightly and monthly pay",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 40,
                "w": 500,
                "h": 60,
                "fill": "green",
                "label": "$78 000 per year"
              },
              {
                "kind": "text",
                "x": 40,
                "y": 140,
                "text": "÷ 52 weeks",
                "size": 20,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 140,
                "text": "$1500 a week",
                "size": 20,
                "change": "add",
                "anchor": "start",
                "bold": true,
                "color": "blue"
              }
            ]
          }
        },
        {
          "say": "There are 26 fortnights. That gives 3000 a fortnight.",
          "write": "78 000 ÷ 26 = $3000",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "A salary split into weekly, fortnightly and monthly pay",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 40,
                "w": 500,
                "h": 60,
                "fill": "green",
                "label": "$78 000 per year"
              },
              {
                "kind": "text",
                "x": 40,
                "y": 140,
                "text": "÷ 52 weeks",
                "size": 20,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 140,
                "text": "$1500 a week",
                "size": 20,
                "anchor": "start",
                "bold": true,
                "color": "blue"
              },
              {
                "kind": "text",
                "x": 40,
                "y": 185,
                "text": "÷ 26 fortnights",
                "size": 20,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 185,
                "text": "$3000 a fortnight",
                "size": 20,
                "change": "add",
                "anchor": "start",
                "bold": true,
                "color": "blue"
              }
            ]
          }
        },
        {
          "say": "And 12 months gives 6500 a month.",
          "write": "78 000 ÷ 12 = $6500",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "A salary split into weekly, fortnightly and monthly pay",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 40,
                "w": 500,
                "h": 60,
                "fill": "green",
                "label": "$78 000 per year"
              },
              {
                "kind": "text",
                "x": 40,
                "y": 140,
                "text": "÷ 52 weeks",
                "size": 20,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 140,
                "text": "$1500 a week",
                "size": 20,
                "anchor": "start",
                "bold": true,
                "color": "blue"
              },
              {
                "kind": "text",
                "x": 40,
                "y": 185,
                "text": "÷ 26 fortnights",
                "size": 20,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 185,
                "text": "$3000 a fortnight",
                "size": 20,
                "anchor": "start",
                "bold": true,
                "color": "blue"
              },
              {
                "kind": "text",
                "x": 40,
                "y": 230,
                "text": "÷ 12 months",
                "size": 20,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 230,
                "text": "$6500 a month",
                "size": 20,
                "change": "add",
                "anchor": "start",
                "bold": true,
                "color": "blue"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Overtime",
      "lines": [
        {
          "say": "Dan earns 30 dollars an hour for a 38 hour week.",
          "write": "38 × 30 = $1140",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Bar model of normal pay plus overtime",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 400,
                "h": 70,
                "fill": "blue",
                "label": "38 h × $30 = $1140"
              },
              {
                "kind": "text",
                "x": 230,
                "y": 60,
                "text": "normal hours",
                "size": 16,
                "color": "grey"
              }
            ]
          }
        },
        {
          "say": "Overtime is time-and-a-half: 1.5 times 30 is 45 dollars an hour.",
          "write": "1.5 × $30 = $45"
        },
        {
          "say": "He works 42 hours, so 4 hours are overtime. That adds 180 dollars.",
          "write": "4 × $45 = $180",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Bar model of normal pay plus overtime",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 400,
                "h": 70,
                "fill": "blue",
                "label": "38 h × $30 = $1140"
              },
              {
                "kind": "rect",
                "x": 430,
                "y": 80,
                "w": 100,
                "h": 70,
                "fill": "orange",
                "label": "4 × $45",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 230,
                "y": 60,
                "text": "normal hours",
                "size": 16,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 480,
                "y": 60,
                "text": "overtime",
                "size": 16,
                "color": "grey"
              }
            ]
          }
        },
        {
          "say": "Add them: his gross pay is 1320 dollars.",
          "write": "gross = $1320",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Bar model of normal pay plus overtime",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 400,
                "h": 70,
                "fill": "blue",
                "label": "38 h × $30 = $1140"
              },
              {
                "kind": "rect",
                "x": 430,
                "y": 80,
                "w": 100,
                "h": 70,
                "fill": "orange",
                "label": "4 × $45"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "gross = $1140 + $180 = $1320",
                "size": 22,
                "change": "highlight",
                "bold": true,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 230,
                "y": 60,
                "text": "normal hours",
                "size": 16,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 480,
                "y": 60,
                "text": "overtime",
                "size": 16,
                "color": "grey"
              }
            ]
          }
        },
        {
          "say": "Double time means 2 times the normal rate.",
          "write": "double time = 2 × rate"
        }
      ]
    },
    {
      "heading": "Commission and piecework",
      "lines": [
        {
          "say": "Commission is a percentage of your sales.",
          "write": "commission = % of sales"
        },
        {
          "say": "A retainer of 450 dollars, plus 4 percent of 12 500 dollars in sales.",
          "write": "0.04 × 12 500 = $500",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Retainer plus commission",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 250,
                "h": 70,
                "fill": "blue",
                "label": "retainer $450"
              }
            ]
          }
        },
        {
          "say": "Add the retainer: 450 plus 500 is 950 dollars.",
          "write": "$450 + $500 = $950",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Retainer plus commission",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 250,
                "h": 70,
                "fill": "blue",
                "label": "retainer $450"
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 80,
                "w": 250,
                "h": 70,
                "fill": "orange",
                "label": "4% of $12 500 = $500",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "pay = $950",
                "size": 24,
                "change": "add",
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "Piecework pays a fixed amount for each item made.",
          "write": "piecework = $ per item"
        }
      ]
    },
    {
      "heading": "Gross and net pay",
      "lines": [
        {
          "say": "Gross pay is the total you earn.",
          "write": "gross",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Gross pay with deductions taken out leaves net pay",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 500,
                "h": 60,
                "fill": "green",
                "label": "gross pay"
              }
            ]
          }
        },
        {
          "say": "Deductions, like income tax, are taken out.",
          "write": "− deductions",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Gross pay with deductions taken out leaves net pay",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 500,
                "h": 60,
                "fill": "green",
                "label": "gross pay"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 80,
                "w": 150,
                "h": 60,
                "fill": "red",
                "label": "deductions",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 200,
                "y": 200,
                "text": "net pay = gross − deductions",
                "size": 22,
                "change": "add",
                "bold": true,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "What's left is net pay. It reaches your bank account.",
          "write": "net = gross − deductions"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A month isn't 4 weeks. Divide a salary by 12 for monthly pay.",
          "write": "÷ 12, not ÷ 4 weeks"
        },
        {
          "say": "Only the extra hours get the overtime rate.",
          "write": "only hours beyond normal"
        },
        {
          "say": "Multiply by 1.5, don't add it. Time-and-a-half on 28 dollars is 42.",
          "write": "1.5 × $28 = $42"
        },
        {
          "say": "Net pay is smaller than gross pay.",
          "write": "net < gross"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Wage equals rate times hours.",
          "write": "rate × hours"
        },
        {
          "say": "Salary: divide by 52, 26 or 12.",
          "write": "÷ 52, ÷ 26, ÷ 12"
        },
        {
          "say": "Time-and-a-half is 1.5 times the rate. Double time is 2 times.",
          "write": "× 1.5,  × 2"
        }
      ]
    }
  ]
}
    {
      "heading": "Horizontal and vertical lines",
      "lines": [
        {
          "say": "y equals 3 means every point has height 3. That's flat.",
          "write": "y = 3  → horizontal",
          "diagram": "diagrams/y9/maths/graphing-straight-lines-hv.svg",
          "alt": "The horizontal line y = 3 and the vertical line x = −2 crossing at (−2, 3)"
        },
        {
          "say": "x equals minus 2 means every point is at minus 2 across. That's upright.",
          "write": "x = −2  → vertical"
        },
        {
          "say": "It feels backwards at first. y equals 3 runs across the page.",
          "write": "y = flat sky"
        }
      ]
    },

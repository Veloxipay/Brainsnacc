    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "For the x-intercept, set y to 0, not x.",
          "write": "x-intercept → y = 0"
        },
        {
          "say": "Don't draw y equals 3 up the page. It's horizontal.",
          "write": "✗ y = 3 vertical"
        },
        {
          "say": "Bracket negatives. Minus 2 times minus 1 is plus 2.",
          "write": "−2 × (−1) = +2"
        },
        {
          "say": "Don't stop the line at the dots. Extend it to the edges.",
          "write": "extend both ways"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Table: choose x, work out y, plot, then rule a line.",
          "write": "x → y → plot → rule"
        },
        {
          "say": "Zero the other one to find an intercept.",
          "write": "x = 0 → y-int;  y = 0 → x-int"
        },
        {
          "say": "y equals a number is horizontal. x equals a number is vertical.",
          "write": "y = a flat,  x = a upright"
        },
        {
          "say": "To test a point, substitute it into the rule.",
          "write": "substitute to check"
        }
      ]
    }
  ]

{
  "level": "Year 9",
  "subject": "maths",
  "title": "Graphing straight lines",
  "frames": [
    {
      "heading": "A rule makes a line",
      "lines": [
        {
          "say": "A rule like y equals 2x minus 1 gives a straight line.",
          "write": "y = 2x − 1"
        },
        {
          "say": "Every point that makes the rule true sits on the line.",
          "write": "points ↔ rule"
        },
        {
          "say": "It's like dot-to-dot. Find the dots, then join them with a ruler.",
          "write": "plot, then rule a line"
        }
      ]
    },
    {

    {
      "heading": "Composite shapes",
      "lines": [
        {
          "say": "A running track: two 80 metre straights and a semicircle at each end.",
          "diagram": "diagrams/y9/maths/perimeter-and-circles-ex4.svg",
          "alt": "A running track with 80 m straights and semicircles of diameter 50 m"
        },
        {
          "say": "Two semicircles make one circle: pi times 50 is about 157.08.",
          "write": "π × 50 ≈ 157.08 m"
        },
        {
          "say": "Add the straights: 160 plus 157.08 is about 317.1 metres.",
          "write": "≈ 317.1 m"
        },
        {
          "say": "The dashed diameters are inside, so leave them out.",
          "write": "skip dashed lines"
        }
      ]
    },
    {
      "heading": "Working backwards",
      "lines": [
        {
          "say": "A circle has circumference 50 centimetres. Find the radius.",
          "write": "50 = 2πr"
        },
        {
          "say": "Divide both sides by 2 pi. Use brackets on the calculator.",
          "write": "r = 50 ÷ (2π)"
        },
        {
          "say": "The radius is about 7.96 centimetres.",
          "write": "r ≈ 7.96 cm"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A sector's perimeter needs the two radii, not just the arc.",
          "write": "l + 2r"
        },
        {
          "say": "Don't add the dashed lines inside a shape.",
          "write": "outside edges only"
        },
        {
          "say": "Radius or diameter? Say it before you substitute.",
          "write": "✗ 2πd"
        },
        {
          "say": "A full turn is 360 degrees, so use theta over 360.",
          "write": "θ/360"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Perimeter is the distance around the outside.",
          "write": "trace the outside"
        },
        {
          "say": "C equals pi d, or 2 pi r.",
          "write": "C = πd = 2πr"
        },
        {
          "say": "Arc length is theta over 360 of the circumference.",
          "write": "l = θ/360 × 2πr"
        }
      ]
    }
  ]
}
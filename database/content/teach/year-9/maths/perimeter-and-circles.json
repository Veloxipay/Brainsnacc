          "say": "Walk right around a playground, one hand on the fence.",
          "write": "perimeter"
        },
        {
          "say": "The perimeter is how far you walk. You never cross the middle.",
          "write": "distance around the outside"
        },
        {
          "say": "Curved parts of the fence need pi.",
          "write": "π"
        }
      ]

    {
      "heading": "Circumference",
      "lines": [
        {
          "say": "The perimeter of a circle is its circumference.",
          "write": "C = πd = 2πr",
          "diagram": "diagrams/y9/maths/perimeter-and-circles-parts.svg",
          "alt": "A circle with radius r and circumference C"
        },
        {
          "say": "The diameter is twice the radius.",
          "write": "d = 2r"
        },
        {
          "say": "Radius 4.5: C equals 2 times pi times 4.5, which is 9 pi.",
          "write": "C = 9π"
        },
        {
          "say": "That's about 28.3 centimetres. Use the pi button.",
          "write": "C ≈ 28.3 cm"
        }
      ]
    },

{
  "level": "Year 9",
  "subject": "maths",
  "title": "Midpoint and distance",
  "frames": [
    {
      "heading": "Meeting halfway",
      "lines": [
        {
          "say": "You and a friend meet exactly halfway along a straight street.",
          "write": "midpoint"
        },
        {
          "say": "Halfway is the average of your two positions.",
          "write": "average"
        },
        {
          "say": "A bird flies straight between your houses. That's the distance.",
          "write": "distance = straight line"
        }
      ]
    },
    {

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "For the midpoint, add then halve. Don't subtract.",
          "write": "add, ÷ 2"
        },
        {
          "say": "Don't forget the square root. 100 is d squared, not d.",
          "write": "✗ d = 100"
        },
        {
          "say": "Don't just add the sides. 6 plus 8 is the street route, not the straight line.",
          "write": "✗ 6 + 8 = 14"
        },
        {
          "say": "Bracket negatives. 4 minus minus 2 is 6, not 2.",
          "write": "4 − (−2) = 6"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "The midpoint is the average of the coordinates.",
          "write": "M = (avg x, avg y)"
        },
        {
          "say": "Distance: square, add, square root. It's Pythagoras.",
          "write": "√(Δx² + Δy²)"
        },
        {
          "say": "For a missing endpoint, repeat the step from the end to the midpoint.",
          "write": "repeat the step"
        }
      ]
    }
  ]
}
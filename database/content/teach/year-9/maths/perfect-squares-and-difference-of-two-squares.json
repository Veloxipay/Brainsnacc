    },
    {
      "heading": "Perfect squares",
      "lines": [
        {
          "say": "A perfect square is a binomial multiplied by itself.",
          "write": "(a + b)(a + b)"
        },
        {
          "say": "Square the first, double the product, square the last.",
          "write": "first², 2 × product, last²"
        },
        {
          "say": "With a minus, the middle term is minus. The last term stays positive.",
          "write": "(a − b)² = a² − 2ab + b²"
        }
      ]
    },
    {
      "heading": "Expanding perfect squares",
      "lines": [
        {
          "say": "Expand x plus 6, all squared. Square the first: x squared.",
          "write": "x²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Area model of (x + 6) squared",
            "items": [
              {
                "kind": "rect",

      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't join the points with a ruler. Use one smooth curve.",
          "write": "✗ straight segments"
        },
        {
          "say": "The axis of symmetry is a line, x equals a number, not a point.",
          "write": "✗ (1, −4)   ✓ x = 1"
        },
        {
          "say": "Minus 2 squared is 4, not minus 4. Use brackets.",
          "write": "(−2)² = 4"
        },
        {
          "say": "For intercepts minus 7 and 3, the axis is x equals minus 2, not 5.",
          "write": "(−7 + 3) ÷ 2 = −2"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Quadratic rules make U-shaped parabolas.",
          "write": "y = ax² + bx + c"
        },
        {
          "say": "a positive: minimum. a negative: maximum.",
          "write": "+ U min,  − ∩ max"
        },
        {
          "say": "The axis of symmetry passes through the turning point.",
          "write": "x = (p + q) ÷ 2"
        },
        {
          "say": "The y-intercept is always (0, c).",
          "write": "(0, c)"
        }

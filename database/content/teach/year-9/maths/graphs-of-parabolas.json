  "title": "Graphs of parabolas",
  "frames": [
    {
      "heading": "What is a parabola?",
      "lines": [
        {
          "say": "Throw a ball and its path is a smooth curve called a parabola.",
          "write": "parabola"
        },
        {
          "say": "A rule like y equals a x squared plus b x plus c makes one.",
          "write": "y = ax² + bx + c"
        },
        {
          "say": "Picture a half-pipe. One lowest point, and two matching sides.",
          "write": "one turning point, two mirror sides"
        }
      ]
    },
    {
      "heading": "Plotting from a table",
      "lines": [
        {
          "say": "Plot y equals x squared minus 2x minus 3.",
          "write": "y = x² − 2x − 3"
        },
        {
          "say": "x equals minus 2: 4 plus 4 minus 3 is 5. Bracket the negative.",
          "write": "(−2)² − 2(−2) − 3 = 5",

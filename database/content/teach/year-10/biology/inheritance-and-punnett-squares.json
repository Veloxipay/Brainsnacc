{
  "level": "Year 10",
  "subject": "biology",
  "title": "Inheritance and Punnett squares",
  "frames": [
    {
      "heading": "Genotype and phenotype",
      "lines": [
        {
          "say": "For each gene, you carry two alleles, one from each parent.",
          "write": "2 alleles: one from each"
        },
        {
          "say": "The pair of letters is your genotype, like big T little t.",
          "write": "genotype = letters, e.g. Tt"
        },
        {
          "say": "What actually shows, like tall, is your phenotype.",
          "write": "phenotype = what shows"
        },
        {
          "say": "The environment can also have an effect, like diet on height.",
          "write": "environment matters too"
        }
      ]
    },
    {
      "heading": "Dominant and recessive",
      "lines": [
        {
          "say": "A dominant allele shows with just one copy. Write it as a capital.",
          "write": "dominant: T"
        },
        {
          "say": "A recessive allele only shows with two copies. Write it lower case.",
          "write": "recessive: t"
        },
        {
          "say": "Use the same letter for both. T and little t, not T and s.",
          "write": "same letter"
        },
        {
          "say": "Homozygous means the same: big T big T, or little t little t.",
          "write": "homozygous: TT or tt",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "genotypes and phenotypes",
            "items": [
              {
                "kind": "rect",

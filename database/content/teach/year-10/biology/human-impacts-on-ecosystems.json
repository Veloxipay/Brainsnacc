{
  "level": "Year 10",
  "subject": "biology",
  "title": "Human impacts on ecosystems",
  "frames": [
    {
      "heading": "Biodiversity",
      "lines": [
        {
          "say": "Humans change ecosystems more than any other species.",
          "write": "human impacts"
        },
        {
          "say": "Biodiversity is the variety of life in an area.",
          "write": "biodiversity = variety of life"
        },
        {
          "say": "It covers species, the genetic variety within them, and ecosystems.",
          "write": "species, genes, ecosystems"
        },
        {
          "say": "High biodiversity is more stable. If one species declines, others fill its role.",
          "write": "more variety = more stable"
        },
        {
          "say": "Australia has many endemic species, found naturally only here.",
          "write": "endemic"
        },
        {
          "say": "Four big threats. Remember H I P C.",
          "write": "HIP-C"
        }
      ]
    },
    {
      "heading": "Habitat loss and fragmentation",
      "lines": [
        {
          "say": "Habitat loss is land cleared for farms, houses, mines or roads.",
          "write": "habitat loss",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "habitat split into patches",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 40,
                "w": 480,
                "h": 200,
                "fill": "green",
                "label": "bushland"
              }
            ]
          }
        },
        {
          "say": "Often the bush left is cut into small, separate patches.",
          "write": "fragmentation",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "habitat split into patches",
            "items": [

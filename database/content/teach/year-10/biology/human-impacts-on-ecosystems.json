                "y": 50,
                "w": 120,
                "h": 80,
                "fill": "green",
                "label": "patch"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 60,
                "w": 120,
                "h": 90,
                "fill": "green",
                "label": "patch"
              },
              {
                "kind": "rect",
                "x": 200,
                "y": 160,
                "w": 110,
                "h": 70,
                "fill": "green",
                "label": "patch"

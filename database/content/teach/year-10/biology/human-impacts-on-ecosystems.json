    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Fish in eutrophication are not poisoned. They run out of oxygen.",
          "write": "✗ algae poison fish"
        },
        {
          "say": "Loss is habitat gone. Fragmentation is habitat split into patches.",
          "write": "loss ≠ fragmentation"
        },
        {
          "say": "Biological control is not risk-free. It can hit other species.",
          "write": "control has risks"
        },
        {
          "say": "Climate change and the ozone hole are different problems.",
          "write": "✗ ozone hole"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "H I P C. Habitat loss, Introduced species, Pollution, Climate change.",
          "write": "HIP-C"
        },
        {
          "say": "Introduced species win because they came without their enemies.",
          "write": "no enemies"
        },
        {
          "say": "Biomagnification grows at each step up the food chain.",
          "write": "builds up the chain"
        },
        {
          "say": "Corridors are bridges between islands of bush.",
          "write": "corridors = bridges"
        }
      ]

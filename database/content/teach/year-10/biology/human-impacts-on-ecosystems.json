                "x": 280,
                "y": 30,
                "text": "farms and roads",
                "size": 16,
                "color": "grey",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Small patches may lack food or nest sites. Animals get isolated.",
          "write": "isolated populations"
        },
        {
          "say": "Isolated groups inbreed, so they lose genetic diversity.",
          "write": "less genetic diversity"
        },
        {
          "say": "Leadbeater's possum needs hollows in old trees, which take ages to form.",
          "write": "old trees, hollows"
        }
      ]
    },
    {
      "heading": "Introduced species",
      "lines": [
        {
          "say": "An introduced species is brought by humans to a new area.",
          "write": "introduced species"
        },
        {
          "say": "If it spreads and causes harm, it is invasive.",
          "write": "invasive = spreads + harms"
        },
        {
          "say": "They thrive because they left their predators and diseases behind.",
          "write": "no enemies here"
        },
        {
          "say": "Cane toads came in the 1930s. Their poison kills quolls and goannas.",

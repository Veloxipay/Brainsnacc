    {
      "heading": "Climate change",
      "lines": [
        {
          "say": "Burning fossil fuels and clearing forests add C O 2 to the air.",
          "write": "more CO₂ → more heat"
        },
        {
          "say": "Too warm for too long, and corals expel the algae that feed them.",
          "write": "coral bleaching",

  "frames": [
    {
      "heading": "What is homeostasis?",
      "lines": [
        {
          "say": "Your cells only work well when conditions stay in a narrow range.",
          "write": "narrow range"
        },
        {
          "say": "Homeostasis keeps the internal environment steady, even when outside changes.",
          "write": "homeostasis = stable inside"
        },
        {
          "say": "Body temperature stays around 37 degrees. Blood glucose and water stay steady too.",
          "write": "≈ 37 °C",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "temperature moving around set point",
            "items": [
              {
                "kind": "line",
                "x": 20,
                "y": 150,
                "x2": 540,
                "y2": 150,
                "color": "green",
                "dashed": true
              },
              {
                "kind": "text",
                "x": 30,
                "y": 140,
                "text": "set point 37 °C",
                "size": 16,
                "color": "green",
                "anchor": "start"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    20,
                    150
                  ],
                  [
                    90,
                    150
                  ],
                  [
                    140,
                    70
                  ],
                  [
                    190,
                    150
                  ],
                  [
                    260,
                    150

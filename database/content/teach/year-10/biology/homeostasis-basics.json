                "y": 55,
                "text": "too hot → cool down",
                "size": 16,
                "color": "red",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 310,
                "y": 250,
                "text": "too cold → warm up",
                "size": 16,
                "color": "blue",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Conditions wobble around a set point, inside a tolerance range.",
          "write": "set point, tolerance range"
        },
        {
          "say": "Why? Enzymes work best in a narrow range. Too hot, and they change shape.",
          "write": "enzymes need it"
        }
      ]
    },

{
  "level": "Year 10",
  "subject": "biology",
  "title": "Pathogens and disease",
  "frames": [
    {
      "heading": "What is a disease?",
      "lines": [
        {
          "say": "A disease is any condition that stops part of the body working normally.",
          "write": "disease"
        },
        {
          "say": "An infectious disease is caused by a pathogen. It can be caught.",
          "write": "infectious: pathogen"
        },
        {
          "say": "The organism the pathogen lives in is called the host.",
          "write": "host"
        },
        {
          "say": "A non-infectious disease cannot be caught.",
          "write": "non-infectious: can't catch",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "causes of non-infectious disease",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 40,
                "w": 250,
                "h": 70,
                "fill": "purple",
                "label": "genetic: cystic fibrosis"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 40,
                "w": 250,
                "h": 70,
                "fill": "orange",
                "label": "lifestyle: heart disease"
              },
              {
                "kind": "rect",
                "x": 20,
                "y": 140,
                "w": 250,
                "h": 70,
                "fill": "yellow",
                "label": "environment: skin cancer"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 140,
                "w": 250,
                "h": 70,
                "fill": "teal",
                "label": "nutrition: scurvy"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 260,
                "text": "not caused by a pathogen",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Causes include genes, lifestyle, environment, and poor nutrition.",
          "write": "genes, lifestyle, environment"
        }
      ]
    },

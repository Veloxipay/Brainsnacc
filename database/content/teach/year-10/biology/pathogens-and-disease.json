        {
          "say": "Cover coughs, and stay home when sick.",
          "write": "cover coughs"
        },
        {
          "say": "Cook food well and keep it cold. Treat water and sewage.",
          "write": "cook, chill, clean water"
        },
        {
          "say": "Remove standing water so mosquitoes cannot breed.",
          "write": "no standing water"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Viruses are not cells, and cannot reproduce on their own.",
          "write": "✗ virus = cell"
        },
        {
          "say": "Non-infectious does not always mean lifestyle. Genes and environment count.",
          "write": "not only lifestyle"
        },
        {
          "say": "For prevention, link the method to the route it breaks.",
          "write": "method ↔ route"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Infectious can be caught. Non-infectious cannot.",
          "write": "infectious = can be caught"
        },
        {
          "say": "Bacteria, viruses, fungi, protozoa, parasites.",
          "write": "B V F P P"
        },
        {
          "say": "A virus is a hijacker. A vector is a delivery driver.",
          "write": "hijacker, delivery driver"
        },
        {

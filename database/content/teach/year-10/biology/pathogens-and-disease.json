                "text": "Bad Viruses Find People Pleasant",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Bacteria are single cells with no nucleus. Some release toxins.",
          "write": "bacteria: no nucleus"
        },
        {
          "say": "Most bacteria are harmless, and many are helpful, like gut bacteria.",
          "write": "most bacteria are friends"
        },
        {
          "say": "Fungi have a nucleus. They cause tinea and thrush.",
          "write": "fungi: tinea, thrush"
        },
        {
          "say": "Protozoa are single cells. One causes malaria in red blood cells.",
          "write": "protozoa: malaria"
        },
        {
          "say": "Parasites like tapeworms and lice live on or in a host.",
          "write": "parasites: tapeworm, lice"
        }
      ]
    },
    {

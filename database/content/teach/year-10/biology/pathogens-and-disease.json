                "r": 50,
                "fill": "green",
                "label": "person 2",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "carries malaria, does not get sick",
                "size": 18,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Mosquitoes carrying malaria are the classic example.",
          "write": "mosquito → malaria"
        },
        {
          "say": "A vector is a delivery driver, not the customer. It usually is not sick.",
          "write": "vector not ill"
        },
        {
          "say": "So malaria is infectious, but not caught directly from a person.",
          "write": "infectious ≠ contagious"
        }
      ]
    },

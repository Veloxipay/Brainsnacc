    {
      "heading": "How diseases spread",
      "lines": [
        {
          "say": "Passing a pathogen from host to host is called transmission.",
          "write": "transmission"
        },
        {
          "say": "Direct contact, like touching or kissing.",
          "write": "direct contact"
        },
        {
          "say": "Indirect contact, through a fomite, like a door handle or phone.",
          "write": "fomite = object"
        },
        {
          "say": "Coughs and sneezes spread droplets carrying flu viruses.",
          "write": "droplets"
        },
        {
          "say": "Contaminated food and water spread Salmonella and cholera.",
          "write": "food and water"
        },
        {
          "say": "Body fluids, like shared needles, spread hepatitis B.",
          "write": "body fluids"
        }
      ]
    },
    {
      "heading": "Vectors",
      "lines": [
        {
          "say": "A vector carries a pathogen from one host to another.",
          "write": "vector = carrier",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "mosquito vector carrying malaria",
            "items": [
              {
                "kind": "circle",
                "x": 90,
                "y": 150,
                "r": 50,
                "fill": "red",
                "label": "person 1"

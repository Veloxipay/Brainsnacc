    {
      "heading": "Inflammation",
      "lines": [
        {
          "say": "Damaged cells release chemicals like histamine.",
          "write": "histamine"
        },
        {
          "say": "Blood vessels widen, bringing more blood. That causes redness and heat.",
          "write": "redness, heat"
        },
        {
          "say": "Leaky vessels let fluid and white cells out. That causes swelling.",
          "write": "swelling"
        },
        {
          "say": "Swelling presses on nerves, causing pain.",
          "write": "pain"
        },
        {
          "say": "Inflammation helps. It brings phagocytes quickly. A fever can help too.",
          "write": "inflammation helps"
        }
      ]
    },

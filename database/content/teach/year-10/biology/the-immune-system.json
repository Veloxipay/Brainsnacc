    {
      "heading": "First line: barriers",
      "lines": [
        {
          "say": "Skin is a tough, waterproof layer. Pathogens cannot get through unless it is cut.",
          "write": "skin"
        },
        {
          "say": "Mucus in the nose and airways traps pathogens.",
          "write": "mucus traps"
        },
        {

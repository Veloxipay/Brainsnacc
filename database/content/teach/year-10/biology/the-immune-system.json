    {
      "heading": "Memory cells",
      "lines": [
        {
          "say": "A matching B cell divides many times.",
          "write": "B cell divides"
        },
        {
          "say": "Most become plasma cells, which release lots of antibodies.",
          "write": "plasma cells"
        },
        {
          "say": "Some become memory cells, which stay for a long time.",
          "write": "memory cells"
        },

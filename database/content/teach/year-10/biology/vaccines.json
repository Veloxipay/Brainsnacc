  "title": "Vaccines",
  "frames": [
    {
      "heading": "What is a vaccine?",
      "lines": [
        {
          "say": "A vaccine trains your immune system without you getting the disease.",
          "write": "vaccine = training"
        },
        {
          "say": "It contains antigens, or instructions to make them. Not antibodies.",
          "write": "antigens, not antibodies"
        },
        {
          "say": "Types include killed, weakened, subunit, toxoid and m R N A vaccines.",
          "write": "killed, weakened, subunit…"
        },
        {
          "say": "B cells respond, make antibodies, and form memory cells.",
          "write": "→ memory cells"
        },
        {
          "say": "That is artificial active immunity. Your own body does the work.",
          "write": "artificial active immunity"
        }
      ]
    },

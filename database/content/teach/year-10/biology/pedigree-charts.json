      "heading": "Autosomal or X-linked?",
      "lines": [
        {
          "say": "X-linked recessive traits affect many more males than females.",
          "write": "X-linked: mostly males"
        },
        {
          "say": "An affected mother passes her X to every son. So all her sons are affected.",
          "write": "affected mum → all sons"
        },
        {
          "say": "An affected daughter must have an affected father.",
          "write": "affected daughter → dad"
        },

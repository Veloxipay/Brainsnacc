{
  "level": "Year 10",
  "subject": "biology",
  "title": "Variation and natural selection",
  "frames": [
    {
      "heading": "What is variation?",
      "lines": [
        {
          "say": "Variation means differences between individuals of the same species.",
          "write": "variation"
        },
        {
          "say": "Continuous variation can take any value, like height. It is a ramp.",
          "write": "continuous = ramp",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "ramp versus staircase",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    30,
                    240
                  ],
                  [
                    250,
                    240
                  ],
                  [
                    250,
                    80
                  ]
                ],
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 280,
                "text": "continuous: height",
                "size": 18,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 180,
                "w": 70,
                "h": 60,
                "fill": "orange",
                "label": "A",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 390,
                "y": 130,
                "w": 70,
                "h": 110,
                "fill": "orange",
                "label": "B",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 460,
                "y": 80,
                "w": 70,
                "h": 160,
                "fill": "orange",
                "label": "O",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 425,
                "y": 280,
                "text": "discontinuous: blood group",
                "size": 18,
                "color": "orange",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Discontinuous variation falls in clear groups, like blood group. A staircase.",
          "write": "discontinuous = staircase"
        },
        {
          "say": "The environment causes variation too, like a plant grown in shade.",
          "write": "environment"
        },
        {
          "say": "Only genetic variation can be passed on, so only it matters for evolution.",
          "write": "only genetic is inherited"
        }
      ]
    },
    {
      "heading": "Where new variation comes from",
      "lines": [
        {
          "say": "Mutation is a permanent change in DNA. It happens randomly.",
          "write": "mutation: random"
        },
        {
          "say": "Mutation is the only way brand new alleles appear.",
          "write": "only source of new alleles"
        },
        {
          "say": "To be passed on, it must be in cells that make gametes.",
          "write": "must be in gamete cells"
        },
        {
          "say": "Sexual reproduction shuffles existing alleles into new combinations.",
          "write": "sex shuffles alleles"
        },
        {
          "say": "Independent assortment, crossing over and random fertilisation do the shuffling.",
          "write": "meiosis + fertilisation"
        }
      ]
    },
    {
      "heading": "Darwin and Wallace",
      "lines": [
        {
          "say": "Darwin and Wallace reached the same idea. It was presented in 1858.",
          "write": "1858"
        },
        {
          "say": "Organisms produce far more offspring than can survive.",
          "write": "overproduction"
        },
        {
          "say": "Individuals vary, and some of that variation is inherited.",
          "write": "variation, inherited"
        },
        {
          "say": "Resources are limited, so there is a struggle for existence.",
          "write": "struggle for existence"
        },
        {
          "say": "Helpful inherited traits get more common. Darwin called it natural selection.",
          "write": "natural selection"
        }
      ]
    },

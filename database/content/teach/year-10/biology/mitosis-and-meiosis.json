  "frames": [
    {
      "heading": "Two ways to divide",
      "lines": [
        {
          "say": "All your trillions of cells came from one fertilised egg.",
          "write": "1 egg → trillions of cells"
        },
        {
          "say": "Mitosis makes identical cells, for growth and repair.",
          "write": "mitosis: identical"
        },
        {
          "say": "Meiosis makes sex cells, and they are all different.",
          "write": "meiosis: gametes, all different"
        },
        {
          "say": "Remember: mitosis sounds like my toes. Meiosis sounds like meet.",
          "write": "my toes / meet"
        }
      ]
    },

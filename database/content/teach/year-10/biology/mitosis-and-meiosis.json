    {
      "heading": "Why halve the number?",
      "lines": [
        {
          "say": "A sperm with 23 meets an egg with 23.",
          "write": "23 + 23 = 46",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "fertilisation restores 46",
            "items": [

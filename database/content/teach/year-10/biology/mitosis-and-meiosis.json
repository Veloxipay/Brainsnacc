          "write": "keeps it at 46"
        },
        {
          "say": "Mitosis, one division, two identical diploid cells.",
          "write": "mitosis: 1 → 2, 2n"
        },
        {
          "say": "Meiosis, two divisions, four different haploid cells.",
          "write": "meiosis: 2 → 4, n"
        }
      ]

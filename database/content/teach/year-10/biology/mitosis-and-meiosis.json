    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Mitosis does not make gametes. Meiosis does.",
          "write": "✗ mitosis → gametes"
        },
        {
          "say": "Gametes have half the chromosome number, not half the size.",
          "write": "half the number"
        },
        {
          "say": "Crossing over only happens in meiosis one.",
          "write": "crossing over: meiosis I"
        }
      ]

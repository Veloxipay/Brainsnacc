{
  "level": "Year 10",
  "subject": "biology",
  "title": "Evidence for evolution",
  "frames": [
    {
      "heading": "Five lines of evidence",
      "lines": [
        {"say": "Evolution is backed by five kinds of evidence.", "write": "fossils, body parts, embryos",
         "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Five boxes: fossils, body parts, embryos, DNA, distribution", "items": [
           {"kind": "rect", "x": 10, "y": 60, "w": 100, "h": 70, "fill": "orange", "label": "Fossils"},
           {"kind": "rect", "x": 120, "y": 60, "w": 100, "h": 70, "fill": "blue", "label": "Body parts"},
           {"kind": "rect", "x": 230, "y": 60, "w": 100, "h": 70, "fill": "pink", "label": "Embryos"},
           {"kind": "rect", "x": 340, "y": 60, "w": 100, "h": 70, "fill": "purple", "label": "DNA"},
           {"kind": "rect", "x": 450, "y": 60, "w": 100, "h": 70, "fill": "green", "label": "Distribution"},
           {"kind": "text", "x": 280, "y": 175, "text": "all point to common ancestors", "size": 20, "bold": true}
         ]}},
        {"say": "Fossils, body parts, embryos, DNA and distribution.", "write": "DNA, distribution"},
        {"say": "Each one points back to common ancestors.", "write": "→ common ancestry"}
      ]
    },
    {
      "heading": "Fossils",
      "lines": [
        {"say": "A fossil is the preserved remains or traces of an ancient organism.", "write": "fossil = remains or traces"},
        {"say": "It forms when something is buried fast, away from oxygen and scavengers.", "write": "quick burial, no O₂"},
        {"say": "Rock layers are like a pile of washing. The bottom went in first.", "write": "lower = older",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Rock layers with a simple fossil in the bottom layer and a more complex one near the top", "items": [
           {"kind": "rect", "x": 80, "y": 30, "w": 400, "h": 50, "fill": "yellow", "label": "youngest"},
           {"kind": "rect", "x": 80, "y": 80, "w": 400, "h": 50, "fill": "orange"},
           {"kind": "rect", "x": 80, "y": 130, "w": 400, "h": 50, "fill": "pink"},
           {"kind": "rect", "x": 80, "y": 180, "w": 400, "h": 50, "fill": "grey", "label": "oldest"},
           {"kind": "circle", "x": 400, "y": 205, "r": 12, "fill": "white", "change": "add"},
           {"kind": "text", "x": 470, "y": 210, "text": "simple", "size": 16, "anchor": "end"},
           {"kind": "polygon", "points": [[380,45],[420,55],[400,70]], "fill": "white", "change": "add"},
           {"kind": "text", "x": 280, "y": 255, "text": "relative dating", "size": 18, "bold": true}
         ]}},
        {"say": "Radioactive isotopes decay at a steady rate. That gives the age in years.", "write": "absolute dating: years"},
        {"say": "Archaeopteryx had feathers like a bird, but teeth and a tail like a reptile.", "write": "transitional fossils"},
        {"say": "The record has gaps, because fossils rarely form.", "write": "record is incomplete"}
      ]
    },
    {
      "heading": "Homologous structures",
      "lines": [
        {"say": "Homologous means the same bone plan, used for different jobs.", "write": "same structure, different job"},
        {"say": "Human arm, bat wing, whale flipper. One upper bone, two lower, five digits.", "write": "pentadactyl limb",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Three limbs with matching colour-coded bones: one upper bone, two lower bones, five digits", "items": [
           {"kind": "rect", "x": 60, "y": 20, "w": 30, "h": 70, "fill": "red"},
           {"kind": "rect", "x": 50, "y": 95, "w": 20, "h": 60, "fill": "blue"},
           {"kind": "rect", "x": 80, "y": 95, "w": 20, "h": 60, "fill": "blue"},
           {"kind": "rect", "x": 40, "y": 160, "w": 70, "h": 40, "fill": "yellow", "label": "5"},
           {"kind": "text", "x": 75, "y": 235, "text": "human", "size": 18},
           {"kind": "rect", "x": 250, "y": 20, "w": 30, "h": 60, "fill": "red", "change": "highlight"},
           {"kind": "rect", "x": 240, "y": 85, "w": 20, "h": 50, "fill": "blue", "change": "highlight"},
           {"kind": "rect", "x": 270, "y": 85, "w": 20, "h": 50, "fill": "blue", "change": "highlight"},
           {"kind": "rect", "x": 200, "y": 140, "w": 140, "h": 70, "fill": "yellow", "label": "5", "change": "highlight"},
           {"kind": "text", "x": 270, "y": 235, "text": "bat", "size": 18},
           {"kind": "rect", "x": 450, "y": 20, "w": 30, "h": 40, "fill": "red", "change": "highlight"},
           {"kind": "rect", "x": 440, "y": 65, "w": 20, "h": 35, "fill": "blue", "change": "highlight"},
           {"kind": "rect", "x": 470, "y": 65, "w": 20, "h": 35, "fill": "blue", "change": "highlight"},
           {"kind": "rect", "x": 430, "y": 105, "w": 70, "h": 100, "fill": "yellow", "label": "5", "change": "highlight"},
           {"kind": "text", "x": 465, "y": 235, "text": "whale", "size": 18}
         ]}},
        {"say": "Same plan for flying, swimming and grabbing only makes sense with a common ancestor.", "write": "→ common ancestor"},
        {"say": "Changing it for different environments is divergent evolution.", "write": "divergent evolution"}
      ]
    },
    {
      "heading": "Analogous and vestigial",
      "lines": [
        {"say": "Analogous structures do the same job, but are built differently.", "write": "same job, different build"},
        {"say": "Bird wings are bone and feathers. Insect wings are thin exoskeleton sheets.", "write": "bird wing vs insect wing",
         "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Bird wing with bones and feathers beside an insect wing made of a thin sheet", "items": [
           {"kind": "polygon", "points": [[40,120],[240,60],[240,170]], "fill": "orange"},
           {"kind": "line", "x": 40, "y": 120, "x2": 200, "y2": 90, "color": "black"},
           {"kind": "text", "x": 140, "y": 205, "text": "bone + feathers", "size": 18},
           {"kind": "polygon", "points": [[320,120],[520,70],[520,160]], "fill": "teal", "change": "add"},
           {"kind": "text", "x": 420, "y": 205, "text": "thin sheet", "size": 18, "change": "add"},
           {"kind": "text", "x": 280, "y": 30, "text": "same job: flight", "size": 20, "bold": true, "color": "purple"}
         ]}},
        {"say": "That's convergent evolution. It doesn't show a close relationship.", "write": "convergent evolution"},
        {"say": "The thylacine looked like a wolf, but it was a marsupial.", "write": "look-alikes can fool you"},
        {"say": "Vestigial structures are leftovers, like your tailbone and whale pelvic bones.", "write": "coccyx, whale pelvis, emu wings"}
      ]
    },
    {
      "heading": "Embryos and DNA",
      "lines": [
        {"say": "Early fish, bird and human embryos look surprisingly alike.", "write": "similar early embryos"},
        {"say": "All have a tail and pharyngeal arches in the neck.", "write": "pharyngeal arches"},
        {"say": "In fish these become gills. In humans, parts of the jaw, ear and throat.", "write": "fish: gills, human: jaw, ear"},
        {"say": "Compare a gene between species. Fewer differences means closer cousins.", "write": "fewer differences = closer",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Bar chart of DNA differences from species W: X 3, Y 12, Z 27", "items": [
           {"kind": "line", "x": 60, "y": 200, "x2": 520, "y2": 200, "color": "black"},
           {"kind": "rect", "x": 100, "y": 182, "w": 80, "h": 18, "fill": "green", "change": "highlight"},
           {"kind": "rect", "x": 240, "y": 128, "w": 80, "h": 72, "fill": "orange"},
           {"kind": "rect", "x": 380, "y": 38, "w": 80, "h": 162, "fill": "red"},
           {"kind": "text", "x": 140, "y": 170, "text": "3", "size": 20, "bold": true},
           {"kind": "text", "x": 280, "y": 118, "text": "12", "size": 20},
           {"kind": "text", "x": 420, "y": 28, "text": "27", "size": 20},
           {"kind": "text", "x": 140, "y": 225, "text": "X: closest", "size": 18, "bold": true, "color": "green"},
           {"kind": "text", "x": 280, "y": 225, "text": "Y", "size": 18},
           {"kind": "text", "x": 420, "y": 225, "text": "Z: furthest", "size": 18}
         ]}},
        {"say": "Mutations pile up after species split. So X is closest to W.", "write": "X closest, Z furthest"}
      ]
    },
    {
      "heading": "Biogeography",
      "lines": [
        {"say": "Biogeography asks where species live, and why.", "write": "where and why"},
        {"say": "Galápagos finches look like a mainland finch, but each beak suits local food.", "write": "Galápagos finches"},
        {"say": "Australia was once part of Gondwana, joined to Antarctica and South America.", "write": "Gondwana",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Gondwana as one landmass, then Australia drifting away on its own", "items": [
           {"kind": "rect", "x": 60, "y": 60, "w": 120, "h": 80, "fill": "green", "label": "S. America"},
           {"kind": "rect", "x": 180, "y": 60, "w": 120, "h": 80, "fill": "grey", "label": "Antarctica"},
           {"kind": "rect", "x": 300, "y": 60, "w": 110, "h": 80, "fill": "orange", "label": "Australia", "change": "remove"},
           {"kind": "rect", "x": 420, "y": 150, "w": 120, "h": 70, "fill": "orange", "label": "Australia", "change": "add"},
           {"kind": "arrow", "x": 360, "y": 145, "x2": 430, "y2": 175, "color": "purple", "change": "add"},
           {"kind": "text", "x": 180, "y": 190, "text": "Glossopteris fossils on all", "size": 18}
         ]}},
        {"say": "After it split off, marsupials evolved in isolation. Many live nowhere else.", "write": "marsupials evolved in isolation"}
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {"say": "Homologous shows common ancestry. Analogous does not.", "write": "homo ≠ analog"},
        {"say": "Similar-looking animals aren't always close relatives.", "write": "✗ looks = related"},
        {"say": "More DNA differences means less closely related, not more.", "write": "more differences = further"},
        {"say": "Vestigial means reduced, not always completely useless.", "write": "vestigial = reduced"}
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {"say": "Fossils, body parts, embryos, DNA, distribution.", "write": "5 lines of evidence"},
        {"say": "Homologous: same bone plan, different jobs.", "write": "HOMO = same plan"},
        {"say": "Fewer differences, closer cousins.", "write": "fewer = closer"},
        {"say": "Name the evidence, give an example, link it to common ancestry.", "write": "name, example, link"}
      ]
    }
  ]
}

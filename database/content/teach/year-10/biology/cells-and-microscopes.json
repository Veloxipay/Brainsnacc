{
  "level": "Year 10",
  "subject": "biology",
  "title": "Cells and microscopes",
  "frames": [
    {
      "heading": "Cell theory",
      "lines": [
        {"say": "All living things are made of one or more cells.", "write": "1. all life is cells"},
        {"say": "The cell is the smallest unit of life.", "write": "2. smallest unit of life"},
        {"say": "Every cell comes from a cell that already existed.", "write": "3. cells come from cells"},
        {"say": "Bacteria are prokaryotes. They have no nucleus.", "write": "prokaryote: no nucleus",
         "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Small bacterium with loose DNA next to a larger eukaryotic cell with a nucleus", "items": [
           {"kind": "rect", "x": 40, "y": 80, "w": 140, "h": 60, "fill": "teal"},
           {"kind": "line", "x": 70, "y": 105, "x2": 150, "y2": 115, "color": "purple"},
           {"kind": "text", "x": 110, "y": 180, "text": "prokaryote", "size": 18},
           {"kind": "circle", "x": 400, "y": 110, "r": 90, "fill": "pink", "change": "add"},
           {"kind": "circle", "x": 400, "y": 110, "r": 30, "fill": "purple", "label": "nucleus", "change": "add"},
           {"kind": "text", "x": 400, "y": 215, "text": "eukaryote", "size": 18, "bold": true}
         ]}},
        {"say": "Plants, animals and fungi are eukaryotes. They have a nucleus and organelles.", "write": "eukaryote: nucleus + organelles"}
      ]
    },
    {
      "heading": "Organelles in every cell",
      "lines": [
        {"say": "The cell membrane controls what goes in and out.", "write": "membrane: controls entry",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Animal cell with membrane, cytoplasm, nucleus, mitochondria and ribosomes", "items": [
           {"kind": "circle", "x": 280, "y": 130, "r": 115, "fill": "pink"},
           {"kind": "circle", "x": 280, "y": 130, "r": 34, "fill": "purple", "label": "nucleus"},
           {"kind": "rect", "x": 190, "y": 70, "w": 50, "h": 24, "fill": "orange", "label": "mito"},
           {"kind": "rect", "x": 320, "y": 180, "w": 50, "h": 24, "fill": "orange", "label": "mito"},
           {"kind": "circle", "x": 350, "y": 80, "r": 5, "fill": "black"},
           {"kind": "circle", "x": 365, "y": 92, "r": 5, "fill": "black"},
           {"kind": "circle", "x": 210, "y": 175, "r": 5, "fill": "black"},
           {"kind": "text", "x": 470, "y": 40, "text": "membrane", "size": 18},
           {"kind": "text", "x": 470, "y": 230, "text": "animal cell", "size": 20, "bold": true}
         ]}},
        {"say": "Cytoplasm is the jelly where many reactions happen.", "write": "cytoplasm: reactions"},
        {"say": "The nucleus holds the DNA and controls the cell.", "write": "nucleus: DNA, control"},
        {"say": "Mitochondria release energy from glucose in cellular respiration.", "write": "mitochondria: respiration"},
        {"say": "Ribosomes make proteins. They're too small to see with a light microscope.", "write": "ribosomes: proteins"}
      ]
    },
    {
      "heading": "What plant cells add",
      "lines": [
        {"say": "Picture a plant cell as a house with a wall, solar panels and a water tank.", "write": "wall, panels, tank"},
        {"say": "The cell wall is made of cellulose. It gives support and shape.", "write": "cell wall: cellulose",
         "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Plant cell: cell wall, large vacuole and chloroplasts added to the basic cell", "items": [
           {"kind": "rect", "x": 140, "y": 20, "w": 280, "h": 240, "fill": "green", "change": "add"},
           {"kind": "rect", "x": 152, "y": 32, "w": 256, "h": 216, "fill": "white"},
           {"kind": "rect", "x": 200, "y": 70, "w": 160, "h": 140, "fill": "teal", "label": "vacuole", "change": "add"},
           {"kind": "circle", "x": 175, "y": 60, "r": 14, "fill": "green", "change": "add"},
           {"kind": "circle", "x": 385, "y": 225, "r": 14, "fill": "green", "change": "add"},
           {"kind": "circle", "x": 175, "y": 225, "r": 14, "fill": "green", "change": "add"},
           {"kind": "circle", "x": 380, "y": 60, "r": 18, "fill": "purple"},
           {"kind": "text", "x": 490, "y": 40, "text": "cell wall", "size": 18, "color": "green"},
           {"kind": "text", "x": 70, "y": 140, "text": "chloroplasts", "size": 16, "color": "green"}
         ]}},
        {"say": "Chloroplasts carry out photosynthesis. They contain green chlorophyll.", "write": "chloroplasts: photosynthesis"},
        {"say": "A large central vacuole stores water and keeps the cell firm.", "write": "vacuole: keeps cell firm"},
        {"say": "Root cells have no chloroplasts. So look for a wall or big vacuole instead.", "write": "no chloroplasts ≠ animal"}
      ]
    },
    {
      "heading": "Using a light microscope",
      "lines": [
        {"say": "Light passes through a thin specimen. Lenses make the image bigger.", "write": "eyepiece + objective"},
        {"say": "Stains help. Iodine for plant cells, methylene blue for cheek cells.", "write": "iodine, methylene blue"},
        {"say": "Start low, go slow. Focus on low power with the coarse knob.", "write": "low power: coarse focus"},
        {"say": "On high power, use only the fine focus knob.", "write": "high power: fine focus only"}
      ]
    },
    {
      "heading": "Magnification",
      "lines": [
        {"say": "Total magnification is eyepiece times objective.", "write": "total = eyepiece × objective"},
        {"say": "Ten times eyepiece with a 40 times objective gives 400 times.", "write": "10 × 40 = 400×"},
        {"say": "Multiply, don't add. It's not 50 times.", "write": "✗ 10 + 40 = 50"},
        {"say": "Zoom in, see less. The field of view shrinks by the same factor.", "write": "zoom in, see less",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Large field of view circle at 40 times shrinks to a circle ten times smaller at 400 times", "items": [
           {"kind": "circle", "x": 160, "y": 130, "r": 110, "fill": "none"},
           {"kind": "text", "x": 160, "y": 135, "text": "4.5 mm", "size": 22, "bold": true},
           {"kind": "text", "x": 160, "y": 258, "text": "40×", "size": 18},
           {"kind": "arrow", "x": 290, "y": 130, "x2": 370, "y2": 130, "color": "black"},
           {"kind": "circle", "x": 440, "y": 130, "r": 22, "fill": "yellow", "change": "add"},
           {"kind": "text", "x": 440, "y": 190, "text": "0.45 mm", "size": 22, "bold": true, "color": "purple", "change": "add"},
           {"kind": "text", "x": 440, "y": 258, "text": "400×", "size": 18}
         ]}},
        {"say": "Going from 40 times to 400 times, 4.5 millimetres becomes 0.45.", "write": "4.5 × 40/400 = 0.45 mm"}
      ]
    },
    {
      "heading": "Estimating cell size",
      "lines": [
        {"say": "Convert first. One millimetre is 1000 micrometres.", "write": "1 mm = 1000 µm"},
        {"say": "So 0.45 millimetres is 450 micrometres.", "write": "0.45 mm = 450 µm"},
        {"say": "Count how many cells fit across. Here, about six onion cells.", "write": "6 cells across",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Six onion cells fitting end to end across a 450 micrometre field of view", "items": [
           {"kind": "rect", "x": 40, "y": 80, "w": 80, "h": 60, "fill": "yellow"},
           {"kind": "rect", "x": 120, "y": 80, "w": 80, "h": 60, "fill": "yellow"},
           {"kind": "rect", "x": 200, "y": 80, "w": 80, "h": 60, "fill": "yellow"},
           {"kind": "rect", "x": 280, "y": 80, "w": 80, "h": 60, "fill": "yellow"},
           {"kind": "rect", "x": 360, "y": 80, "w": 80, "h": 60, "fill": "yellow"},
           {"kind": "rect", "x": 440, "y": 80, "w": 80, "h": 60, "fill": "yellow"},
           {"kind": "arrow", "x": 40, "y": 50, "x2": 520, "y2": 50, "color": "black"},
           {"kind": "text", "x": 280, "y": 35, "text": "450 µm", "size": 20},
           {"kind": "rect", "x": 40, "y": 80, "w": 80, "h": 60, "fill": "orange", "change": "highlight"},
           {"kind": "text", "x": 280, "y": 200, "text": "one cell = 450 ÷ 6 = 75 µm", "size": 22, "bold": true, "color": "purple", "change": "add"}
         ]}},
        {"say": "Divide: 450 over six is 75 micrometres per cell.", "write": "450 ÷ 6 = 75 µm"},
        {"say": "Check it makes sense. Plant cells are often tens of micrometres long.", "write": "sensible? ✓"}
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {"say": "Don't add lens powers. Multiply them.", "write": "✗ add powers"},
        {"say": "Higher magnification means a smaller field of view, not bigger.", "write": "✗ field gets bigger"},
        {"say": "Plant cells have a wall and a membrane. Animal cells have no wall.", "write": "wall ≠ membrane"},
        {"say": "Never use the coarse knob on high power. It can crack the slide.", "write": "✗ coarse on high power"}
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {"say": "Plant cells add a wall, chloroplasts and a large vacuole.", "write": "wall, panels, tank"},
        {"say": "Eyepiece times objective gives total magnification.", "write": "multiply, don't add"},
        {"say": "Zoom in, see less. One millimetre is 1000 micrometres.", "write": "1 mm = 1000 µm"},
        {"say": "Cell size is field of view divided by cells across.", "write": "size = FOV ÷ cells"}
      ]
    }
  ]
}

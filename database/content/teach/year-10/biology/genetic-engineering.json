    {
      "heading": "Benefits and risks",
      "lines": [
        {
          "say": "Benefits: lots of safe medicine, and crops needing fewer sprays.",
          "write": "+ insulin, fewer sprays",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "benefits and risks balanced",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 50,

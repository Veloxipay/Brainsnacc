                "change": "add"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 50,
                "w": 240,
                "h": 180,
                "fill": "red"
              },
              {
                "kind": "text",
                "x": 410,
                "y": 90,
                "text": "Risks",
                "size": 22,
                "color": "red",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 410,
                "y": 140,
                "text": "gene spread",
                "size": 18,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 410,
                "y": 180,
                "text": "resistance",
                "size": 18,
                "color": "black",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Risks: genes spreading to wild relatives, and pests evolving resistance.",
          "write": "− gene spread, resistance"
        },
        {
          "say": "Some people have ethical worries, or object to seed patents.",
          "write": "ethics and patents"
        },
        {
          "say": "In Australia, F SANZ checks GM foods for safety, and they must be labelled.",
          "write": "FSANZ: assess + label"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Restriction enzymes do not cut at random. Only at their site.",
          "write": "✗ cut at random"
        },
        {
          "say": "Different enzymes give sticky ends that do not match.",
          "write": "✗ two different enzymes"
        },
        {
          "say": "Don't forget ligase. Sticky ends only stick weakly on their own.",
          "write": "✗ forgetting ligase"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Cut, paste, deliver.",
          "write": "cut, paste, deliver"
        },
        {
          "say": "Restriction enzyme cuts. Ligase seals. Plasmid delivers.",
          "write": "scissors, glue, van"
        },
        {
          "say": "Same enzyme on both pieces, so the ends fit.",
          "write": "same enzyme, matching ends"
        },
        {
          "say": "One code for all life, so bacteria make real human insulin.",
          "write": "one DNA code for all life"
        }
      ]
    }
  ]
}
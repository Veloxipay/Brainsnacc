                "label": "cactus"
              }
            ]
          }
        },
        {
          "say": "Thick beaks crack seeds. Thin, pointed beaks catch insects.",
          "write": "thick: seeds, thin: insects"
        },
        {
          "say": "One ancestor becoming many species is adaptive radiation.",
          "write": "adaptive radiation"
        },
        {
          "say": "Australian marsupials are another example: kangaroos, wombats, koalas.",
          "write": "marsupials"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Isolation alone does not make a new species. It only stops gene flow.",
          "write": "isolation ≠ new species"
        },
        {
          "say": "Speciation usually takes a very long time, except polyploidy in plants.",
          "write": "many generations"
        },
        {
          "say": "Being able to mate is not enough. The offspring must be fertile.",
          "write": "must be fertile"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Split, shift, separate.",
          "write": "split, shift, separate"
        },
        {
          "say": "The species test is fertile offspring.",
          "write": "fertile offspring"
        },
        {
          "say": "Allo means other place. Sym means same place.",
          "write": "allo other, sym same"
        },
        {
          "say": "Adaptive radiation is like spokes on a wheel.",
          "write": "spokes on a wheel"
        }
      ]
    }
  ]

    {
      "heading": "Ways to be isolated",
      "lines": [
        {
          "say": "Behavioural. Different frog calls, so females ignore the wrong call.",
          "write": "behavioural"
        },
        {
          "say": "Temporal. Plants flowering in different months.",
          "write": "temporal"
        },
        {
          "say": "Habitat. One group in the trees, one on the ground.",
          "write": "habitat"
        },
        {
          "say": "Mechanical. Flowers shaped for different pollinators.",
          "write": "mechanical"
        },
        {
          "say": "Hybrid infertility. Offspring form, but cannot breed, like the mule.",
          "write": "hybrid infertility"
        }
      ]
    },
    {
      "heading": "Other place or same place",
      "lines": [
        {
          "say": "Allopatric means other place. A barrier splits the population.",
          "write": "allopatric = other place"
        },
        {
          "say": "Sympatric means same place. No physical barrier.",
          "write": "sympatric = same place"
        },
        {
          "say": "Two palm species split on Lord Howe Island. Different soils, different flowering times.",
          "write": "Lord Howe Island palms",
          "draw": {
            "type": "shapes",
            "width": 560,

{
  "level": "Year 10",
  "subject": "biology",
  "title": "Speciation",
  "frames": [
    {
      "heading": "What is a species?",
      "lines": [
        {
          "say": "Speciation is when one species splits into two or more.",
          "write": "speciation"
        },
        {
          "say": "A species can interbreed in nature and produce fertile offspring.",
          "write": "fertile offspring"
        },
        {
          "say": "A horse and a donkey make a mule. But mules are almost always infertile.",
          "write": "horse × donkey → mule",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "horse plus donkey makes infertile mule",
            "items": [
              {
                "kind": "circle",
                "x": 90,
                "y": 110,
                "r": 55,
                "fill": "orange",
                "label": "horse"
              },
              {
                "kind": "text",
                "x": 180,
                "y": 118,
                "text": "×",
                "size": 30,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 270,
                "y": 110,
                "r": 55,
                "fill": "grey",
                "label": "donkey"
              },
              {
                "kind": "arrow",
                "x": 335,
                "y": 110,
                "x2": 395,
                "y2": 110,
                "color": "black"
              },
              {
                "kind": "circle",
                "x": 465,
                "y": 110,
                "r": 55,
                "fill": "teal",
                "label": "mule",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 465,
                "y": 210,
                "text": "infertile",
                "size": 20,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So horses and donkeys are separate species.",
          "write": "separate species"
        },
        {
          "say": "This test fails for bacteria, which reproduce asexually, and for fossils.",
          "write": "limits: asexual, fossils"
        }
      ]
    },
    {
      "heading": "Populations and gene pools",
      "lines": [
        {
          "say": "A population is one species, in one area, at one time.",
          "write": "population"
        },
        {
          "say": "All the alleles in a population make up its gene pool.",
          "write": "gene pool"
        },
        {
          "say": "Breeding moves alleles around. That is gene flow.",

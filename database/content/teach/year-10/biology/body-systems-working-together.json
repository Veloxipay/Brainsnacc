{
  "level": "Year 10",
  "subject": "biology",
  "title": "Body systems working together",
  "frames": [
    {
      "heading": "Levels of organisation",
      "lines": [
        {"say": "Your body is trillions of cells, but they don't work alone.", "write": "cell → tissue → organ"},
        {"say": "Similar cells working together make a tissue, like muscle tissue.", "write": "tissue = similar cells",
         "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Ladder from cell to tissue to organ to system to organism", "items": [
           {"kind": "circle", "x": 50, "y": 110, "r": 20, "fill": "pink", "label": "cell"},
           {"kind": "arrow", "x": 75, "y": 110, "x2": 105, "y2": 110, "color": "black"},
           {"kind": "rect", "x": 110, "y": 80, "w": 80, "h": 60, "fill": "pink", "label": "tissue", "change": "add"},
           {"kind": "arrow", "x": 195, "y": 110, "x2": 225, "y2": 110, "color": "black"},
           {"kind": "rect", "x": 230, "y": 70, "w": 90, "h": 80, "fill": "orange", "label": "organ", "change": "add"},
           {"kind": "arrow", "x": 325, "y": 110, "x2": 355, "y2": 110, "color": "black"},
           {"kind": "rect", "x": 360, "y": 60, "w": 90, "h": 100, "fill": "teal", "label": "system", "change": "add"},
           {"kind": "arrow", "x": 455, "y": 110, "x2": 475, "y2": 110, "color": "black"},
           {"kind": "rect", "x": 480, "y": 45, "w": 75, "h": 130, "fill": "blue", "label": "body", "change": "add"},
           {"kind": "text", "x": 280, "y": 205, "text": "Cool Teens Often Sing Out", "size": 20, "bold": true, "color": "purple"}
         ]}},
        {"say": "Different tissues together make an organ, like the stomach.", "write": "organ = different tissues"},
        {"say": "Organs work together in a body system. All the systems make the organism.", "write": "system → organism"},
        {"say": "Cool Teens Often Sing Out. Cell, tissue, organ, system, organism.", "write": "C T O S O"}
      ]
    },
    {
      "heading": "The digestive system",
      "lines": [
        {"say": "Digestion breaks big food molecules into small ones the blood can absorb.", "write": "big → small molecules"},
        {"say": "Mechanical digestion is chopping: chewing and stomach churning.", "write": "mechanical: more surface area"},
        {"say": "Chemical digestion uses enzymes. Amylase turns starch into glucose.", "write": "starch → glucose (amylase)",
         "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "A starch chain of linked glucose units being cut into single glucose molecules by amylase", "items": [
           {"kind": "circle", "x": 80, "y": 70, "r": 22, "fill": "yellow"},
           {"kind": "circle", "x": 125, "y": 70, "r": 22, "fill": "yellow"},
           {"kind": "circle", "x": 170, "y": 70, "r": 22, "fill": "yellow"},
           {"kind": "circle", "x": 215, "y": 70, "r": 22, "fill": "yellow"},
           {"kind": "text", "x": 150, "y": 120, "text": "starch", "size": 20},
           {"kind": "arrow", "x": 260, "y": 70, "x2": 320, "y2": 70, "color": "purple", "change": "add"},
           {"kind": "text", "x": 290, "y": 55, "text": "amylase", "size": 16, "color": "purple", "change": "add"},
           {"kind": "circle", "x": 360, "y": 70, "r": 22, "fill": "yellow", "change": "add"},
           {"kind": "circle", "x": 420, "y": 70, "r": 22, "fill": "yellow", "change": "add"},
           {"kind": "circle", "x": 480, "y": 70, "r": 22, "fill": "yellow", "change": "add"},
           {"kind": "circle", "x": 540, "y": 70, "r": 18, "fill": "yellow", "change": "add"},
           {"kind": "text", "x": 450, "y": 120, "text": "glucose", "size": 20, "bold": true},
           {"kind": "text", "x": 280, "y": 185, "text": "protease: protein → amino acids", "size": 18},
           {"kind": "text", "x": 280, "y": 210, "text": "lipase: fats → fatty acids + glycerol", "size": 18}
         ]}},
        {"say": "Protease makes amino acids. Lipase makes fatty acids and glycerol.", "write": "protein → amino acids"},
        {"say": "The small intestine is lined with villi, giving a huge surface area.", "write": "villi: absorb into blood"},
        {"say": "The large intestine mainly absorbs water.", "write": "large intestine: water"}
      ]
    },
    {
      "heading": "The circulatory system",
      "lines": [
        {"say": "The heart is the depot. Blood vessels are the roads.", "write": "heart + vessels + blood"},
        {"say": "Arteries go away from the heart. They have thick, stretchy walls.", "write": "Arteries: Away",
         "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Cross-sections: artery with thick wall, vein with thin wall and valve, capillary one cell thick", "items": [
           {"kind": "circle", "x": 100, "y": 100, "r": 60, "fill": "red"},
           {"kind": "circle", "x": 100, "y": 100, "r": 25, "fill": "white"},
           {"kind": "circle", "x": 280, "y": 100, "r": 60, "fill": "blue", "change": "add"},
           {"kind": "circle", "x": 280, "y": 100, "r": 48, "fill": "white", "change": "add"},
           {"kind": "circle", "x": 450, "y": 100, "r": 16, "fill": "pink", "change": "add"},
           {"kind": "circle", "x": 450, "y": 100, "r": 12, "fill": "white", "change": "add"},
           {"kind": "text", "x": 100, "y": 195, "text": "artery: thick", "size": 18},
           {"kind": "text", "x": 280, "y": 195, "text": "vein: thin, valves", "size": 18},
           {"kind": "text", "x": 450, "y": 195, "text": "capillary: 1 cell", "size": 18, "bold": true}
         ]}},
        {"say": "Veins bring blood back. They have thinner walls and valves.", "write": "veins: valves stop backflow"},
        {"say": "Capillaries have walls one cell thick, so things diffuse in and out.", "write": "capillaries: 1 cell thick"},
        {"say": "Double circulation: blood passes the heart twice per trip.", "write": "right → lungs, left → body"},
        {"say": "The left side has thicker muscle, because it pumps blood further.", "write": "left wall thicker"}
      ]
    },
    {
      "heading": "The respiratory system",
      "lines": [
        {"say": "Air goes down the trachea, bronchi and bronchioles to the alveoli.", "write": "trachea → bronchi → alveoli"},
        {"say": "In the alveoli, oxygen diffuses into the blood. Carbon dioxide diffuses out.", "write": "O₂ in, CO₂ out",
         "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Alveolus next to a capillary: oxygen moves into the blood, carbon dioxide moves into the air sac", "items": [
           {"kind": "circle", "x": 180, "y": 120, "r": 90, "fill": "pink", "label": "alveolus"},
           {"kind": "rect", "x": 300, "y": 30, "w": 60, "h": 180, "fill": "red", "label": "blood"},
           {"kind": "arrow", "x": 240, "y": 80, "x2": 320, "y2": 80, "color": "blue", "change": "add"},
           {"kind": "text", "x": 420, "y": 85, "text": "O₂ → blood", "size": 20, "bold": true, "color": "blue", "change": "add"},
           {"kind": "arrow", "x": 320, "y": 160, "x2": 240, "y2": 160, "color": "purple", "change": "add"},
           {"kind": "text", "x": 420, "y": 165, "text": "CO₂ → air", "size": 20, "bold": true, "color": "purple", "change": "add"}
         ]}},
        {"say": "Alveoli have a huge surface area and walls one cell thick.", "write": "big area, thin, moist"},
        {"say": "Lots of capillaries keep a steep concentration gradient.", "write": "good blood supply"},
        {"say": "Breathing moves air. Cellular respiration is a reaction in mitochondria.", "write": "breathing ≠ respiration"}
      ]
    },
    {
      "heading": "The excretory system",
      "lines": [
        {"say": "Excretion removes wastes made by the body's own reactions.", "write": "excretion: urea, CO₂"},
        {"say": "The liver makes urea from spare amino acids. The kidneys remove it.", "write": "urea: liver → kidneys"},
        {"say": "Kidneys filter blood, and keep useful things like glucose.", "write": "kidneys → ureters → bladder"},
        {"say": "Getting rid of faeces is egestion, not excretion.", "write": "faeces = egestion"}
      ]
    },
    {
      "heading": "All together on a run",
      "lines": [
        {"say": "Follow one leg muscle cell while you run.", "write": "muscle cell needs energy"},
        {"say": "Digestion supplies glucose. The lungs supply oxygen.", "write": "glucose + oxygen",
         "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Digestive system and lungs feed the blood, which delivers to a muscle cell and takes wastes to lungs and kidneys", "items": [
           {"kind": "rect", "x": 20, "y": 20, "w": 150, "h": 55, "fill": "orange", "label": "digestive"},
           {"kind": "rect", "x": 20, "y": 180, "w": 150, "h": 55, "fill": "pink", "label": "lungs"},
           {"kind": "rect", "x": 220, "y": 100, "w": 120, "h": 60, "fill": "red", "label": "blood"},
           {"kind": "rect", "x": 400, "y": 100, "w": 140, "h": 60, "fill": "blue", "label": "muscle cell"},
           {"kind": "arrow", "x": 170, "y": 50, "x2": 240, "y2": 98, "color": "black"},
           {"kind": "arrow", "x": 170, "y": 205, "x2": 240, "y2": 162, "color": "black"},
           {"kind": "arrow", "x": 340, "y": 130, "x2": 398, "y2": 130, "color": "green", "change": "add"},
           {"kind": "rect", "x": 400, "y": 200, "w": 140, "h": 50, "fill": "teal", "label": "kidneys", "change": "add"},
           {"kind": "arrow", "x": 300, "y": 162, "x2": 398, "y2": 220, "color": "purple", "change": "add"}
         ]}},
        {"say": "The blood carries both to the muscle cell for respiration.", "write": "glucose + O₂ → CO₂ + H₂O"},
        {"say": "Breathing rate rose from 14 to 32. Heart rate from 70 to 150.", "write": "14 → 32,  70 → 150"},
        {"say": "More breathing brings in oxygen. A faster heart delivers it quicker.", "write": "systems work together"}
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {"say": "Breathing is not the same as cellular respiration.", "write": "✗ breathing = respiration"},
        {"say": "Arteries don't always carry oxygen-rich blood. The lung artery doesn't.", "write": "artery = away, not O₂-rich"},
        {"say": "A tissue is a group of similar cells, not a group of organs.", "write": "✗ tissue = organs"},
        {"say": "Link each feature to its effect, like thin walls give short distance.", "write": "feature → effect"}
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {"say": "Cell, tissue, organ, system, organism.", "write": "Cool Teens Often Sing Out"},
        {"say": "Villi, alveoli and capillaries: big area, thin walls, good blood supply.", "write": "exchange surface trio"},
        {"say": "Excretion is the body's own waste. Egestion is undigested food.", "write": "excretion ≠ egestion"},
        {"say": "Every system depends on the others to keep cells alive.", "write": "systems depend on each other"}
      ]
    }
  ]
}

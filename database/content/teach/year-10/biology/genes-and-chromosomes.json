    {
      "heading": "Homologous pairs",
      "lines": [
        {
          "say": "Human body cells have 46 chromosomes, in 23 pairs.",
          "write": "46 = 23 pairs"
        },
        {
          "say": "Each pair is homologous: same genes, same places, maybe different alleles.",
          "write": "homologous = same genes"
        },
        {
          "say": "Pairs 1 to 22 are autosomes. Pair 23 is the sex chromosomes.",
          "write": "1–22 autosomes, 23 = sex"
        },
        {
          "say": "Females are usually X X. Males are usually X Y.",

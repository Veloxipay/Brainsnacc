                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Work alone, with no notes. A calculator is allowed.",
          "write": "no notes, calculator OK"
        },
        {
          "say": "For explain questions, link a cause and effect with because or so.",
          "write": "cause → because → effect"
        },
        {
          "say": "Mark your work, then revise any topic where you lost marks.",
          "write": "mark, then revise"
        }
      ]

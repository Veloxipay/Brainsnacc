      "heading": "How to use this practice test",
      "lines": [
        {
          "say": "This test covers the whole Year 10 Biology course.",
          "write": "whole course"
        },
        {
          "say": "You get 60 minutes. About 20 on multiple choice, 40 on short answer.",
          "write": "60 min: 20 + 40",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "time split",
            "items": [
              {
                "kind": "rect",

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A lower metal cannot displace a higher one. Copper cannot displace zinc."
        },
        {
          "say": "Incomplete combustion is not just carbon dioxide and water."
        },
        {
          "say": "Exothermic means negative delta H.",
          "write": "exo: ΔH negative"
        },
        {
          "say": "Needing a spark to start does not make it endothermic."
        },
        {
          "say": "Write the precipitate as a solid, s. The rest stay aqueous.",
          "write": "AgCl(s)"
        }
      ]
    },

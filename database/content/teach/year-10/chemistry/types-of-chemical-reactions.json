        },
        {
          "say": "Heat limestone and it breaks into lime and carbon dioxide.",
          "write": "CaCO₃ → CaO + CO₂"
        },
        {
          "say": "Electricity splits water. That is called electrolysis.",
          "write": "2H₂O → 2H₂ + O₂"
        }
      ]
    },
    {
      "heading": "Combustion",
      "lines": [
        {
          "say": "Combustion is a fuel reacting fast with oxygen, giving heat and light."
        },
        {
          "say": "With plenty of oxygen, a hydrocarbon gives carbon dioxide and water.",
          "write": "C₃H₈ + 5O₂ → 3CO₂ + 4H₂O"
        },
        {
          "say": "That is complete combustion.",
          "write": "complete: CO₂ + H₂O"
        },
        {
          "say": "With limited oxygen, you also get carbon monoxide or soot.",
          "write": "incomplete: CO or C"
        },
        {
          "say": "That is why gas heaters need good ventilation."
        }
      ]
    },
    {
      "heading": "Displacement",
      "lines": [
        {
          "say": "A more reactive metal pushes a less reactive one out of its compound.",
          "write": "A + BC → AC + B"
        },
        {
          "say": "Check the reactivity series. Most reactive first.",
          "write": "K Na Ca Mg Al Zn Fe Pb Cu Ag Au"
        },
        {
          "say": "Zinc is above copper. So zinc kicks copper out of copper sulfate.",
          "write": "Zn + CuSO₄ → ZnSO₄ + Cu",
          "draw": {

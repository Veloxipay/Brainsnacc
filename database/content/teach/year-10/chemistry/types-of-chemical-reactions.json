              {
                "kind": "circle",
                "x": 480,
                "y": 150,
                "r": 30,
                "fill": "blue",
                "change": "add",
                "label": "B"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "AB → A + B",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }

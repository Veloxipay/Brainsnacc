                "x": 200,
                "y": 150,
                "x2": 300,
                "y2": 150,
                "color": "black"
              },
              {
                "kind": "circle",
                "x": 360,
                "y": 150,
                "r": 30,
                "fill": "orange",
                "change": "add",
                "label": "A"

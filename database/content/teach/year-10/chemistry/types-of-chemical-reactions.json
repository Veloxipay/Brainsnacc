{
  "level": "Year 10",
  "subject": "chemistry",
  "title": "Types of chemical reactions",
  "frames": [
    {
      "heading": "Spotting a reaction",
      "lines": [
        {
          "say": "A chemical reaction makes a new substance.",
          "write": "new substance"
        },
        {
          "say": "Clues: colour change, bubbles, a solid forming, a smell, light or heat."
        },
        {
          "say": "Melting ice makes nothing new. That is a physical change.",
          "write": "melting = physical"
        },
        {
          "say": "Most reactions fit a few patterns. Learn the pattern, predict the products."
        }
      ]
    },
    {
      "heading": "Synthesis and decomposition",
      "lines": [

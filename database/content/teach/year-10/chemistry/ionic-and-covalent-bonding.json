      "heading": "Why atoms bond",
      "lines": [
        {
          "say": "Atoms bond to get a full outer shell, like a noble gas.",
          "write": "goal: full outer shell"
        },
        {
          "say": "Metal plus non-metal: electrons are transferred. That is ionic.",
          "write": "metal + non-metal = ionic"
        },
        {
          "say": "Non-metal plus non-metal: electrons are shared. That is covalent.",
          "write": "non-metal + non-metal = covalent"
        },
        {
          "say": "Cations are paws-itive. An anion is a negative ion.",
          "write": "cation +,  anion −"
        }
      ]
    },

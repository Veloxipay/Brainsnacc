    {
      "heading": "Comparing properties",
      "lines": [
        {
          "say": "Ionic compounds have high melting points. Many strong bonds must break.",
          "write": "ionic: high m.p."
        },
        {
          "say": "They conduct when molten or dissolved, because ions are free to move.",
          "write": "ions free → conducts"
        },
        {
          "say": "Covalent molecules have low melting points. Only weak forces between molecules break.",
          "write": "molecular: low m.p."
        },
        {
          "say": "Boiling water does not break the water molecules. They just move apart.",
          "write": "molecules stay whole",
          "draw": {

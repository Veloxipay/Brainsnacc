      "heading": "The reactivity series",
      "lines": [
        {
          "say": "Most reactive first: potassium, sodium, lithium, calcium, magnesium, aluminium.",
          "write": "K Na Li Ca Mg Al"
        },
        {
          "say": "Then zinc, iron, tin, lead, then copper, silver and gold.",
          "write": "Zn Fe Sn Pb … Cu Ag Au",

      "heading": "Properties of metals",
      "lines": [
        {
          "say": "Metals are shiny, or lustrous, when freshly cut.",
          "write": "lustrous"
        },
        {
          "say": "They conduct electricity and heat well.",
          "write": "good conductors"
        },
        {
          "say": "Malleable means they can be hammered into shape.",
          "write": "malleable"
        },
        {
          "say": "Ductile means they can be drawn into wires.",
          "write": "ductile"
        },
        {
          "say": "Most have high melting points. Mercury and sodium are exceptions.",
          "write": "high m.p. (mostly)"
        }
      ]
    },

    {
      "heading": "Extracting metals",
      "lines": [
        {
          "say": "An ore is rock with enough metal compound to extract.",
          "write": "ore"
        },
        {
          "say": "Removing the oxygen to get the metal is called reduction.",
          "write": "reduction"
        },
        {
          "say": "Above carbon, use electrolysis. Aluminium is made this way, from bauxite.",
          "write": "above C → electrolysis"
        },
        {
          "say": "Below carbon, heat with carbon. Iron is made in a blast furnace.",
          "write": "below C → heat with C"
        },
        {
          "say": "Gold is so unreactive it is found native, as the pure metal.",
          "write": "gold: native"
        }
      ]
    },

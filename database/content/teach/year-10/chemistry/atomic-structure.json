    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Mass number is protons plus neutrons, not just neutrons.",
          "write": "A = p + n"
        },
        {
          "say": "A positive ion has lost electrons, not gained them.",
          "write": "+ ion: lost e⁻"
        },
        {
          "say": "For aluminium three plus, 13 minus 3 gives 10 electrons.",
          "write": "Al³⁺: 13 − 3 = 10"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Protons decide the element.",
          "write": "protons = ID card"
        },
        {
          "say": "Neutrons equals A minus Z.",
          "write": "n = A − Z"
        },
        {
          "say": "Isotopes differ in neutrons, but react the same.",
          "write": "isotopes: same reactions"
        },
        {
          "say": "Lose a negative, become positive.",
          "write": "lose e⁻ → +"
        }
      ]
    }

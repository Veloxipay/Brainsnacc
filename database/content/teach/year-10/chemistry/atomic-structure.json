    {
      "heading": "Why atoms are neutral",
      "lines": [
        {
          "say": "Opposite charges attract, so electrons are held near the nucleus.",
          "write": "electrostatic attraction"
        },
        {
          "say": "In a neutral atom, electrons equal protons. The charges cancel.",
          "write": "electrons = protons"
        },

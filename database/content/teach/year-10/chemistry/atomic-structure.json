    {
      "heading": "Atomic number and mass number",
      "lines": [
        {
          "say": "The atomic number, Z, is the number of protons. It is the element's ID card.",
          "write": "Z = protons"
        },
        {
          "say": "Every carbon atom has 6 protons.",
          "write": "carbon: Z = 6"
        },
        {
          "say": "The mass number, A, is protons plus neutrons.",
          "write": "A = protons + neutrons"
        },
        {
          "say": "So neutrons equals the big number minus the small number.",
          "write": "neutrons = A − Z",
          "draw": {
            "type": "shapes",
            "width": 560,

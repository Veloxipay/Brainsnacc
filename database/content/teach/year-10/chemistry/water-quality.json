  "title": "Water quality",
  "frames": [
    {
      "heading": "What is in natural water?",
      "lines": [
        {
          "say": "Clean looking water is never just H two O."
        },
        {
          "say": "Water is a great solvent. It picks things up as it flows.",
          "write": "water = solvent"
        },
        {
          "say": "Dissolved gases, like oxygen and carbon dioxide.",
          "write": "O₂, CO₂"
        },
        {
          "say": "Dissolved ions, like calcium, sodium, chloride and nitrate.",
          "write": "Ca²⁺, Na⁺, Cl⁻, NO₃⁻"
        },
        {
          "say": "Suspended solids make it cloudy. Microorganisms can cause disease.",
          "write": "turbid, microbes"
        },
        {
          "say": "We measure concentration in milligrams per litre.",
          "write": "mg L⁻¹ ≈ ppm"
        }
      ]
    },
    {
      "heading": "pH and dissolved oxygen",
      "lines": [
        {
          "say": "pH tells us how acidic or basic the water is. Pure water is 7.",
          "write": "pure water: pH 7"
        },
        {
          "say": "Drinking water aims for roughly 6.5 to 8.5.",
          "write": "pH ≈ 6.5–8.5"
        },
        {
          "say": "Fish need dissolved oxygen to respire.",
          "write": "dissolved oxygen (DO)"
        },

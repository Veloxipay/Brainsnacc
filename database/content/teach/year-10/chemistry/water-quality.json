    {
      "heading": "Testing water",
      "lines": [
        {
          "say": "Universal indicator or a meter for pH. A probe for dissolved oxygen."
        },
        {
          "say": "A conductivity meter measures dissolved ions.",
          "write": "conductivity"
        },
        {
          "say": "Add silver nitrate. A white precipitate means chloride ions.",
          "write": "Ag⁺ + Cl⁻ → AgCl(s)"
        },
        {
          "say": "Three milligrams of nitrate in 250 millilitres. Change to litres first.",
          "write": "250 mL = 0.250 L"
        },
        {
          "say": "Three divided by 0.25 is 12 milligrams per litre.",
          "write": "3.0 ÷ 0.250 = 12 mg L⁻¹"
        }
      ]
    },

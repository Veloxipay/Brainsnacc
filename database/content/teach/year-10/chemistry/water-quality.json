    {
      "heading": "Hard water",
      "lines": [
        {
          "say": "Hard water has lots of calcium and magnesium ions.",
          "write": "Ca²⁺ and Mg²⁺"
        },
        {
          "say": "With soap it makes scum, so it does not lather well.",
          "write": "scum"
        },
        {
          "say": "When heated, it leaves scale inside kettles.",
          "write": "scale = CaCO₃"
        },
        {
          "say": "Scum and scale. But hard water is safe to drink."
        }
      ]
    },

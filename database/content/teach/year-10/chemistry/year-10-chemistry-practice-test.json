    {
      "heading": "Mole calculations",
      "lines": [
        {
          "say": "Start with the molar mass of calcium carbonate.",
          "write": "40.1 + 12.0 + 48.0 = 100.1",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "From grams to moles to grams",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 110,
                "w": 150,
                "h": 70,
                "fill": "orange",
                "label": "mass 25.0 g"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "M(CaCO₃) = 100.1 g mol⁻¹",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Mass divided by molar mass gives the moles.",
          "write": "n = m ÷ M = 0.250 mol",
          "draw": {

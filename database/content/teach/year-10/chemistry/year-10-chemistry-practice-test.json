{
  "level": "Year 10",
  "subject": "chemistry",
  "title": "Year 10 Chemistry practice test",
  "frames": [
    {
      "heading": "Before the practice test",
      "lines": [
        {
          "say": "This test covers the whole Year 10 Chemistry course."
        },
        {
          "say": "You get 60 minutes. About 20 for multiple choice, 40 for short answer.",
          "write": "60 minutes, 56 marks"
        },
        {
          "say": "No notes. Use a calculator and the periodic table."
        },
        {
          "say": "Show working, include units and states, and watch significant figures.",
          "write": "working, units, states"
        },
        {
          "say": "Let’s recap the big ideas you will need."
        }
      ]
    },
    {
      "heading": "Atoms and ions",
      "lines": [
        {
          "say": "Magnesium has 12 protons. Mass number 24 means 12 neutrons.",
          "write": "24 − 12 = 12 neutrons",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Magnesium atom shells",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 30,
                "fill": "orange",
                "label": "12p 12n"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 60,
                "fill": "none"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 95,
                "fill": "none"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 125,
                "fill": "none"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 290,
                "text": "Mg: 2, 8, 2",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Its electrons go 2, 8, 2.",
          "write": "Mg: 2, 8, 2"
        },
        {
          "say": "It loses its two outer electrons to become Mg two plus.",
          "write": "Mg²⁺: 2, 8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Magnesium atom shells, outer shell lost",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 30,
                "fill": "orange",
                "label": "12p 12n"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 60,
                "fill": "none"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 95,
                "fill": "none"
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 125,
                "fill": "none",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 290,
                "text": "Mg²⁺: 2, 8",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Balance the charges. Three Mg two plus and two N three minus.",
          "write": "Mg₃N₂"
        },
        {
          "say": "Ionic lattices have strong attractions, so high melting points."
        }
      ]
    },

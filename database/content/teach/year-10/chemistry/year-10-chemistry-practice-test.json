    {
      "heading": "Fuels, water and the environment",
      "lines": [
        {
          "say": "C four H eight fits C n H two n. So it is an alkene.",
          "write": "C₄H₈ = alkene"
        },
        {
          "say": "Limited oxygen makes toxic carbon monoxide or soot.",
          "write": "CO, soot"
        },
        {
          "say": "Change millilitres to litres before you divide.",
          "write": "4.0 mg ÷ 0.500 L = 8.0 mg L⁻¹"
        },
        {
          "say": "Nitrates cause algal blooms. Decay uses up oxygen. Fish suffocate."
        },
        {
          "say": "Carbon dioxide makes the ocean more acidic. Less carbonate for shells.",
          "write": "CO₂ + H₂O ⇌ H₂CO₃"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Time yourself and work alone.",
          "write": "60 minutes"
        },
        {
          "say": "Show every step. Method marks count.",
          "write": "show working"
        },
        {
          "say": "Check units, states and significant figures.",
          "write": "units, states, sig figs"
        },
        {
          "say": "Then mark it and reread any topic where you lost marks."
        }
      ]
    }

    {
      "heading": "Metals, non-metals, metalloids",
      "lines": [
        {
          "say": "A staircase line runs from boron down to astatine.",
          "write": "staircase: B to At"
        },
        {
          "say": "Metals are on the left. Shiny, conduct, malleable and ductile.",
          "write": "metals: left"
        },
        {
          "say": "Non-metals are on the right. Dull, poor conductors, many are gases.",
          "write": "non-metals: right"
        },
        {
          "say": "Metalloids sit on the staircase. Silicon is a semiconductor.",
          "write": "metalloids: Si, Ge"
        },
        {
          "say": "Mercury is the only liquid metal. Bromine is the only liquid non-metal."
        }
      ]
    },
    {
      "heading": "Three special groups",
      "lines": [
        {
          "say": "Group 1 is the alkali metals. One valence electron, lost easily.",
          "write": "group 1: 1+ ions"
        },
        {
          "say": "They react with water to make a hydroxide and hydrogen.",
          "write": "2Na + 2H₂O → 2NaOH + H₂"
        },
        {
          "say": "Group 17 is the halogens. Seven valence electrons, they gain one.",
          "write": "group 17: 1− ions"
        },
        {
          "say": "Halogens are diatomic, like Cl two. They react with metals to form salts.",
          "write": "2Na + Cl₂ → 2NaCl"
        },
        {
          "say": "Group 18 is the noble gases. Full outer shells, so very unreactive.",
          "write": "group 18: unreactive"
        },
        {
          "say": "Argon fills light globes. Helium fills balloons."
        }
      ]
    },

    {
      "heading": "Adding up masses",
      "lines": [
        {
          "say": "For a molecule, add up the relative atomic masses of all its atoms.",
          "write": "Mr = sum of Ar"
        },
        {
          "say": "Water has two hydrogens and one oxygen.",
          "write": "H₂O",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A water molecule: one oxygen and two hydrogens",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 120,
                "r": 50,
                "fill": "red",
                "label": "O"
              },
              {
                "kind": "circle",
                "x": 190,
                "y": 190,
                "r": 30,
                "fill": "white",
                "label": "H"
              },

    {
      "heading": "Molar mass: the bridge",
      "lines": [
        {
          "say": "One mole of carbon twelve weighs exactly 12 grams.",
          "write": "1 mol C-12 = 12 g"
        },
        {
          "say": "So one mole of anything weighs its relative mass in grams.",
          "write": "molar mass M",
          "draw": {

                "y": 270,
                "text": "2 × 1.0 + 16.0 = 18.0",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Two times one, plus sixteen, gives eighteen.",
          "write": "Mr(H₂O) = 18.0",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A water molecule: one oxygen and two hydrogens",
            "items": [
              {

{
  "level": "Year 10",
  "subject": "chemistry",
  "title": "Relative atomic mass and the mole",
  "frames": [
    {
      "heading": "A relative scale",
      "lines": [
        {
          "say": "Atoms are far too small to weigh or count one at a time."
        },
        {
          "say": "One carbon atom is about two times ten to the minus twenty three grams.",
          "write": "2 × 10⁻²³ g"
        },
        {
          "say": "So we compare atoms to a standard instead. Carbon twelve is exactly 12.",
          "write": "carbon-12 = 12 exactly"
        },
        {
          "say": "On this scale, hydrogen one is about 1 and magnesium twenty four about 24."
        },
        {
          "say": "It is a comparison, so relative masses have no units.",
          "write": "no units"
        }
      ]
    },

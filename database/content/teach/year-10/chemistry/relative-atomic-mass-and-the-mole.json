        },
        {
          "say": "Oxygen gas is 32. Carbon dioxide is 44 grams per mole.",
          "write": "O₂ = 32.0, CO₂ = 44.0"
        },
        {
          "say": "On the periodic table, use the number with the decimal, not the atomic number.",
          "write": "Na = 23.0, Cl = 35.5"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "No chlorine atom weighs 35.5. Real atoms are 35 or 37.",
          "write": "Cl: 35 or 37, average 35.5"
        },
        {
          "say": "Do not forget the brackets. The number outside multiplies everything inside.",
          "write": "Mg(NO₃)₂"
        },
        {
          "say": "Use relative atomic mass, not the atomic number.",
          "write": "✗ atomic number"
        },
        {
          "say": "Relative masses have no units. Molar mass has grams per mole."
        }
      ]

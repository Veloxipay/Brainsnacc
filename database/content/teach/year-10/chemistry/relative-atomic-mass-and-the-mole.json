                "text": "2 × 1.0 + 16.0 = 18.0",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "For ionic compounds like sodium chloride, it is called formula mass.",
          "write": "NaCl: 23.0 + 35.5 = 58.5"
        },
        {
          "say": "Brackets multiply everything inside. Calcium hydroxide has two O and two H.",
          "write": "Ca(OH)₂ = 40.1 + 32.0 + 2.0"
        },
        {
          "say": "So its molar mass is 74.1 grams per mole.",
          "write": "74.1 g mol⁻¹"
        }
      ]

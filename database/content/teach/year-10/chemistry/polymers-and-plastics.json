    {
      "heading": "The repeating unit and names",
      "lines": [
        {
          "say": "We write it like this. n is a very large number.",
          "write": "n CH₂=CH₂ → –(CH₂–CH₂)ₙ–"
        },
        {
          "say": "The part in brackets is the repeating unit.",
          "write": "repeating unit",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Repeating unit in brackets",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "–( CH₂–CH₂ )ₙ–",
                "size": 40,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 150,
                "y": 105,

              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "repeats over and over",
                "size": 20,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Bonds stick out through the brackets on both sides."
        },
        {
          "say": "To name it, write poly plus the monomer name.",
          "write": "poly + monomer"
        },
        {
          "say": "Ethene gives poly ethene. Propene gives poly propene.",
          "write": "ethene → poly(ethene)"
        },
        {
          "say": "Chloroethene gives poly chloroethene. That is PVC, used for water pipes.",
          "write": "chloroethene → PVC"
        }
      ]
    },

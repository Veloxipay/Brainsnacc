{
  "level": "Year 10",
  "subject": "chemistry",
  "title": "Writing and balancing equations",
  "frames": [
    {
      "heading": "Reactants and products",
      "lines": [
        {
          "say": "In a reaction, atoms are rearranged to make new substances."
        },
        {
          "say": "We start with reactants. We end with products.",
          "write": "reactants → products"
        },
        {
          "say": "The arrow means react to form. Plus separates substances."
        },
        {
          "say": "A word equation uses names.",
          "write": "magnesium + oxygen → magnesium oxide"
        },
        {
          "say": "But it does not tell us how many particles."
        }
      ]
    },
    {
      "heading": "Reading formulas",
      "lines": [
        {
          "say": "The small number is a subscript. It counts the atom just before it.",
          "write": "H₂O: 2 H, 1 O"
        },
        {
          "say": "Carbon dioxide has one carbon and two oxygens.",
          "write": "CO₂: 1 C, 2 O"
        },
        {
          "say": "Brackets multiply the whole group. Calcium hydroxide has two O and two H.",
          "write": "Ca(OH)₂: 1 Ca, 2 O, 2 H"
        },
        {
          "say": "Seven elements come in pairs. Remember HOFBrINCl.",
          "write": "H₂ O₂ F₂ Br₂ I₂ N₂ Cl₂"
        },
        {
          "say": "Ionic formulas balance the charges. Mg two plus needs two Cl minus.",
          "write": "Mg²⁺ + 2Cl⁻ → MgCl₂"
        }
      ]
    },
    {
      "heading": "Conservation of mass",
      "lines": [
        {
          "say": "Atoms are like Lego bricks. Rebuilt, but none appear or vanish.",
          "write": "atoms are conserved"
        },
        {
          "say": "So total mass of products equals total mass of reactants.",
          "write": "mass in = mass out"
        },
        {
          "say": "Every element needs the same count on both sides. That is balanced."
        },
        {
          "say": "Balance with coefficients, the big numbers in front.",
          "write": "2H₂O = 4 H, 2 O"
        },
        {
          "say": "Never change a subscript. H two O two is hydrogen peroxide, not water.",
          "write": "✗ H₂O → H₂O₂"
        }
      ]
    },

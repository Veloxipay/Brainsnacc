    {
      "heading": "Useful tricks",
      "lines": [
        {
          "say": "Treat polyatomic ions like nitrate as one block.",
          "write": "count NO₃ as one unit"
        },
        {
          "say": "Two KI fixes iodine. Then two KNO three fixes the rest.",
          "write": "Pb(NO₃)₂ + 2KI → PbI₂ + 2KNO₃"
        },
        {
          "say": "Stuck between 2 and 3 oxygens? Use 6.",
          "write": "LCM of 2 and 3 = 6"
        },
        {
          "say": "Three O two and two Fe two O three. Then four iron.",
          "write": "4Fe + 3O₂ → 2Fe₂O₃"
        },
        {
          "say": "States go in brackets: s, l, g, and aq for dissolved.",
          "write": "(s) (l) (g) (aq)"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Never change subscripts. Only coefficients.",
          "write": "change the big number only"
        },
        {
          "say": "Write oxygen as O two, not O.",
          "write": "O₂ not O"
        },
        {
          "say": "In 2 Ca O H two, there are four oxygens and four hydrogens.",
          "write": "2Ca(OH)₂: 4 O, 4 H"
        },
        {
          "say": "Simplify. Four, two, four becomes two, one, two.",
          "write": "2H₂ + O₂ → 2H₂O"
        },
        {
          "say": "Dissolved in water is aq, not l.",
          "write": "NaCl(aq)"
        }
      ]
    },

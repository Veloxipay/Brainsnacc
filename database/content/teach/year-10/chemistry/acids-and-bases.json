  "title": "Acids and bases",
  "frames": [
    {
      "heading": "What are acids and bases?",
      "lines": [
        {
          "say": "An acid makes hydrogen ions, H plus, when it dissolves in water.",
          "write": "acid → H⁺"
        },
        {
          "say": "Hydrochloric acid splits into H plus and chloride ions.",
          "write": "HCl → H⁺ + Cl⁻"
        },
        {
          "say": "A base reacts with an acid and neutralises it.",
          "write": "base neutralises acid"
        },
        {
          "say": "A base that dissolves in water is an alkali. It makes O H minus ions.",
          "write": "alkali → OH⁻"
        },
        {
          "say": "Acids taste sour and bases taste bitter. Never taste lab chemicals!",
          "write": "never taste"
        },
        {
          "say": "Concentrated acids and alkalis are both corrosive.",
          "write": "both corrosive"
        }
      ]
    },

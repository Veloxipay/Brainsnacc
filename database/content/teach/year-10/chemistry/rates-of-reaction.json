    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A catalyst does not give particles more energy. It lowers the activation energy.",
          "write": "✗ more energy"
        },
        {
          "say": "Hotter is not just more collisions. More collisions have enough energy."
        },
        {
          "say": "Catalysts and powder make product faster, not more product.",
          "write": "✗ more product"
        },
        {
          "say": "A flat graph means stopped, not slowest.",
          "write": "flat = stopped"
        },
        {
          "say": "Always say per second. Rate is about time.",
          "write": "collisions per second"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Hit, hard enough, right way round.",
          "write": "collide, Eₐ, orientation"
        },
        {
          "say": "Try Catching Some Cats. Temperature, concentration, surface area, catalyst.",
          "write": "T, C, S, C"
        },

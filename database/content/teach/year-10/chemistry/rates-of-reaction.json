{
  "level": "Year 10",
  "subject": "chemistry",
  "title": "Rates of reaction",
  "frames": [
    {
      "heading": "What is rate of reaction?",
      "lines": [
        {
          "say": "Fireworks react in a flash. An iron gate takes years to rust."
        },
        {
          "say": "Rate is how quickly reactants are used up or products are made.",
          "write": "rate of reaction"
        },
        {
          "say": "We slow food spoiling in the fridge. Factories speed reactions with catalysts."
        }
      ]
    },
    {

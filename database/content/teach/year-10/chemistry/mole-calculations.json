    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Divide m by M, not M by m. A small mass of a heavy thing gives few moles.",
          "write": "n = m ÷ M"
        },
        {
          "say": "Oxygen gas, O 2, has a molar mass of 32.0, not 16.0.",
          "write": "M(O₂) = 32.0"
        },
        {
          "say": "Keep extra digits while working. Round only at the end.",
          "write": "round at the end"
        },
        {
          "say": "Match the fewest significant figures in the data.",
          "write": "sig. figs"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Cover what you want in the triangle.",
          "write": "m-n-M triangle"
        },
        {
          "say": "You always pass through moles.",
          "write": "moles = the hub"
        },
        {
          "say": "Moles, ratio, mass.",
          "write": "moles, ratio, mass"
        },
        {
          "say": "Coefficients count moles, never grams.",
          "write": "moles, not grams"
        }
      ]
    }

      "heading": "Amount means moles",
      "lines": [
        {
          "say": "In chemistry, amount means the number of moles, n. It is measured in mol.",
          "write": "amount n, in mol"
        },
        {
          "say": "Mass, in grams, and amount, in moles, are different things.",
          "write": "mass ≠ amount"
        },
        {
          "say": "Nearly every mole question uses just two formulas.",
          "write": "two formulas"
        }
      ]
    },

                "y": 200,
                "text": "divide everything by 6",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Ionic compounds like M g O are always written as empirical formulas.",
          "write": "ionic: empirical"
        }
      ]

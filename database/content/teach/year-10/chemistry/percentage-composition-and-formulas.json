    {
      "heading": "From empirical to molecular",
      "lines": [
        {
          "say": "You need the molar mass of the compound too.",
          "write": "need molar mass"
        },
        {
          "say": "C H 2 O has a mass of 30.0. The compound is 180.",
          "write": "CH₂O = 30.0"
        },
        {
          "say": "180 divided by 30.0 is 6.",
          "write": "180 ÷ 30.0 = 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "six CH2O units make glucose",
            "items": [
              {
                "kind": "rect",

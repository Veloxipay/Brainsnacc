    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Never divide the masses by each other. Convert to moles first.",
          "write": "moles first"
        },
        {
          "say": "Don't round 1.5 to 2. Multiply to clear it.",
          "write": "✗ 1.5 → 2"
        },
        {
          "say": "Divide by relative atomic mass, not atomic number.",
          "write": "use Aᵣ, not Z"
        },
        {
          "say": "Read whether they want empirical or molecular.",
          "write": "which formula?"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Part over whole, times 100. Check it adds to 100.",
          "write": "part ÷ whole × 100"
        },
        {
          "say": "Percent to mass, mass to mole, divide by small, times till whole.",
          "write": "% → g → mol → ÷ small → ×"
        },
        {
          "say": "Point 5, times 2. Point 33 or point 67, times 3.",
          "write": ".5 × 2,  .33/.67 × 3"
        },
        {
          "say": "Empirical is simplest. Molecular is the actual count.",
          "write": "simplest vs actual"
        }
      ]
    }
  ]

    {
      "heading": "Empirical and molecular formulas",
      "lines": [
        {
          "say": "The empirical formula is the simplest whole number ratio of atoms.",
          "write": "empirical = simplest ratio"
        },
        {
          "say": "The molecular formula is the actual count in one molecule.",
          "write": "molecular = actual count"
        },
        {
          "say": "Glucose is C 6 H 12 O 6. Its empirical formula is C H 2 O.",
          "write": "C₆H₁₂O₆ → CH₂O",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "glucose simplifies to CH2O",
            "items": [

{
  "level": "Year 10",
  "subject": "chemistry",
  "title": "Percentage composition and formulas",
  "frames": [
    {
      "heading": "What is it made of?",
      "lines": [
        {
          "say": "Chemists ask what a substance is made of, and in what proportions.",
          "write": "what proportions?"
        },
        {
          "say": "Percentage composition tells you what percent of the mass is each element.",
          "write": "% composition"
        },
        {
          "say": "Percent equals the element's mass in one mole, over the molar mass, times 100.",
          "write": "% = part ÷ whole × 100"
        },
        {
          "say": "Count every atom. N H 4 N O 3 has two nitrogens.",
          "write": "NH₄NO₃: 2 N atoms"
        }
      ]
    },
    {

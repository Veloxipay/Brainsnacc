    {
      "heading": "The formula",
      "lines": [
        {
          "say": "A equals P times one plus r, to the power n.",
          "write": "A = P(1 + r)ⁿ"
        },
        {
          "say": "P is the principal, the starting amount.",
          "write": "P = principal"
        },
        {
          "say": "r is the rate per period, as a decimal.",
          "write": "r: 4.5% → 0.045"
        },
        {
          "say": "n is the number of periods. Interest is A take P.",
          "write": "I = A − P"
        },
        {
          "say": "Eight thousand at 4.5 percent for 5 years.",
          "write": "8000 × 1.045⁵"
        },
        {
          "say": "That gives 9969 dollars and 46 cents.",
          "write": "A ≈ $9969.46"
        }
      ]
    },
    {
      "heading": "Compounding more often",
      "lines": [
        {
          "say": "Rates are quoted per year. Per annum.",
          "write": "p.a. = per year"
        },
        {
          "say": "Monthly? Divide the rate by 12. Multiply the years by 12.",
          "write": "r = 0.045 ÷ 12,  n = 60"
        },
        {
          "say": "The same 8000 grows to 10 014 dollars and 37 cents.",
          "write": "8000 × 1.00375⁶⁰ ≈ $10 014.37"
        },
        {
          "say": "That is 44 dollars 91 more. Interest starts earning sooner.",
          "write": "+$44.91"
        },
        {
          "say": "Quarterly for 3 years means n is 12, not 3.",
          "write": "quarterly: n = 3 × 4 = 12"
        },
        {
          "say": "Divide the rate, multiply the time."
        }
      ]
    },
    {
      "heading": "How long to double?",
      "lines": [
        {
          "say": "Ten thousand at 7 percent. When does it first pass 20 000?",
          "write": "10 000 × 1.07ⁿ ≥ 20 000"
        },
        {
          "say": "After 10 years, 19 671 dollars. Not quite.",
          "write": "n = 10: $19 671.51"
        },
        {
          "say": "After 11 years, 21 048 dollars. So 11 years.",
          "write": "n = 11: $21 048.52",
          "diagram": "diagrams/y10/maths/compound-interest-doubling.svg",
          "alt": "Graph of 10000 times 1.07 to the n crossing 20000 between years 10 and 11"
        },
        {
          "say": "Try whole numbers until you first pass the target."
        }
      ]
    },
    {
      "heading": "Depreciation",
      "lines": [
        {
          "say": "Depreciation is losing value, like a laptop or a car.",
          "write": "depreciation"
        },
        {
          "say": "Lose 25 percent and 75 percent is left. Multiply by 0.75.",
          "write": "1 − 0.25 = 0.75"
        },
        {
          "say": "The formula uses one take r.",
          "write": "V = V₀(1 − r)ⁿ"
        },
        {
          "say": "A 2400 dollar laptop after 3 years is worth 1012 dollars 50.",
          "write": "2400 × 0.75³ = $1012.50",
          "diagram": "diagrams/y10/maths/compound-interest-depreciation.svg",
          "alt": "Value 2400 times 0.75 to the n falling over 6 years"
        },
        {
          "say": "It loses a percentage each year, not the same dollars."
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Monthly periods need the monthly rate.",
          "write": "r ÷ 12 for monthly"
        },
        {
          "say": "Count periods, not years.",
          "write": "n = periods"
        },
        {
          "say": "Do not forget the one plus. Five percent growth is 1.05.",
          "write": "✗ 0.05ⁿ  ✓ 1.05ⁿ"
        },
        {
          "say": "If they ask for interest, take away the principal.",
          "write": "I = A − P"
        }
      ]
    },

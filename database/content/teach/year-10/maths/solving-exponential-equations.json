      "heading": "Watch out for these",
      "lines": [
        {
          "say": "In 3 to the x equals 243, x is not 243 divided by 3. It is 5.",
          "write": "3⁵ = 243"
        },
        {
          "say": "In 4 to the x equals 32, rewrite the left too. 2x equals 5.",
          "write": "2²ˣ = 2⁵"
        },
        {
          "say": "Divide the logs the right way: log 50 over log 7.",
          "write": "7ˣ = 50 → log 50 ÷ log 7"
        },
        {
          "say": "Multiply the whole bracket in the index by 2.",
          "write": "9^(x + 1) = 3^(2x + 2)"
        },
        {
          "say": "Don't round a how long answer down.",
          "write": "11.9 → 12"
        }

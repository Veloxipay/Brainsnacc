{
  "level": "Year 10",
  "subject": "maths",
  "title": "Solving exponential equations",
  "frames": [
    {
      "heading": "Unknown in the index",
      "lines": [
        {
          "say": "An exponential equation has the unknown in the index.",
          "write": "2ˣ = 32"
        },
        {
          "say": "They answer how long questions, like how long until money doubles.",
          "write": "1.06ⁿ = 2"
        },
        {
          "say": "There are three methods: same base, logarithms, or a graph.",
          "write": "base, log, graph"
        }
      ]
    },
    {
      "heading": "Method 1: same base",
      "lines": [
        {
          "say": "If a to the m equals a to the n, then m equals n.",
          "write": "aᵐ = aⁿ → m = n"
        },
        {
          "say": "Solve 3 to the power 2x minus 1, equals 27.",
          "write": "3^(2x − 1) = 27"
        },
        {
          "say": "Write 27 as 3 cubed. Now both sides have base 3.",
          "write": "3^(2x − 1) = 3³"
        },
        {
          "say": "Set the indices equal. 2x minus 1 equals 3, so x is 2.",
          "write": "2x − 1 = 3,  x = 2"
        },
        {
          "say": "Check: 3 to the power 3 is 27.",
          "write": "3³ = 27 ✓"
        }
      ]
    },
    {
      "heading": "Changing both sides",
      "lines": [
        {
          "say": "Solve 4 to the x equals 8. Like comparing prices in two currencies.",
          "write": "4ˣ = 8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Rewriting 4 to the x equals 8 with base 2",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 90,
                "text": "4ˣ = 8",
                "size": 34,
                "color": "black",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Change both into powers of 2. 4 is 2 squared, 8 is 2 cubed.",
          "write": "4 = 2², 8 = 2³",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Rewriting 4 to the x equals 8 with base 2",
            "items": [
              {
                "kind": "text",

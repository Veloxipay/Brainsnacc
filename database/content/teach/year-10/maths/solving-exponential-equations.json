              },
              {
                "kind": "rect",
                "x": 190,
                "y": 130,
                "w": 90,
                "h": 50,
                "fill": "yellow",
                "label": "8 = 2³"
              },
              {
                "kind": "text",
                "x": 410,
                "y": 90,
                "text": "2²ˣ = 2³",
                "size": 34,
                "color": "purple",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Same base, so 2x equals 3. x is three halves.",
          "write": "x = 3/2",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Rewriting 4 to the x equals 8 with base 2",
            "items": [
              {
                "kind": "text",

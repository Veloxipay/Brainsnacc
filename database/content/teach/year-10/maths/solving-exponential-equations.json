      "lines": [
        {
          "say": "5000 dollars grows at 6 percent a year. When does it double?",
          "write": "5000 × 1.06ⁿ = 10 000"
        },
        {
          "say": "Divide both sides by 5000 first.",
          "write": "1.06ⁿ = 2"
        },
        {
          "say": "n is log 2 over log 1.06, which is 11.89.",
          "write": "n = log 2 ÷ log 1.06 ≈ 11.89"
        },
        {

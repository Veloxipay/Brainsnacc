                "x": 40,
                "y": 130,
                "w": 90,
                "h": 50,
                "fill": "yellow",
                "change": "add",
                "label": "4 = 2²"
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 130,
                "w": 90,
                "h": 50,
                "fill": "yellow",
                "change": "add",
                "label": "8 = 2³"
              }
            ]
          }
        },
        {
          "say": "Power of a power: multiply the indices. 2 to the 2x equals 2 cubed.",
          "write": "(2²)ˣ = 2²ˣ",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Rewriting 4 to the x equals 8 with base 2",
            "items": [
              {
                "kind": "text",

    {
      "heading": "Hamiltonian paths and cycles",
      "lines": [
        {
          "say": "A Hamiltonian path visits every vertex exactly once.",
          "write": "Hamilton: every Home once"
        },
        {
          "say": "A Hamiltonian cycle does that and returns to the start."
        },
        {
          "say": "There's no counting rule. You have to search."
        },
        {
          "say": "A vertex of degree 2 is a signpost. Both its edges must be used.",
          "write": "degree 2 → use both edges",
          "diagram": "diagrams/y10/maths/paths-trails-and-circuits-hamilton.svg",
          "alt": "Rectangle ABCD with middle vertex E and the Hamiltonian path B–A–E–C–D"
        },
        {
          "say": "Here, B and D aren't joined, so there's no cycle. But B A E C D is a path.",
          "write": "path: B–A–E–C–D"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Euler is every edge. Hamilton is every vertex.",
          "write": "Euler: Edge,  Hamilton: Home"
        },
        {
          "say": "With two odd vertices, start at one and finish at the other."
        },
        {
          "say": "A loop adds 2 to the degree, not 1.",
          "write": "loop → +2"
        },
        {
          "say": "The network must be connected.",
          "write": "connected!"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Trail: no repeated edges. Path: no repeated vertices.",
          "write": "trail ≠ path"
        },
        {
          "say": "Zero odd, circuit. Two odd, trail. More, fail.",
          "write": "0 / 2 / more"
        },
        {
          "say": "In one door, out another.",
          "write": "middle vertices even"
        },
        {
          "say": "Degree-2 vertices are signposts for Hamiltonian cycles.",
          "write": "degree 2 = signpost"
        }
      ]
    }
  ]
}
{
  "level": "Year 10",
  "subject": "maths",
  "title": "Paths, trails and circuits",
  "frames": [
    {
      "heading": "Walks, trails and paths",
      "lines": [
        {
          "say": "A walk is any route along edges, written as a list of vertices.",
          "write": "walk: A–B–D–C"
        },
        {
          "say": "A trail never repeats an edge. Vertices may repeat.",
          "write": "trail: no repeated edges"
        },
        {
          "say": "A path never repeats a vertex.",
          "write": "path: no repeated vertices",
          "diagram": "diagrams/y10/maths/paths-trails-and-circuits-path.svg",
          "alt": "Network with the path A–B–D–C highlighted"
        },
        {
          "say": "A circuit is a trail that ends where it started.",
          "write": "circuit: trail, back to start"
        },
        {
          "say": "A cycle is a circuit with no repeated vertices, except the start.",
          "write": "cycle"
        },
        {
          "say": "A B C D B E repeats B, but no edge. So it's a trail, not a path.",
          "write": "A–B–C–D–B–E: trail"
        }
      ]
    },
    {
      "heading": "Eulerian trails and circuits",
      "lines": [
        {
          "say": "An Eulerian trail uses every edge exactly once.",
          "write": "Euler: every Edge once"
        },
        {
          "say": "An Eulerian circuit does the same and finishes where it started."
        },
        {
          "say": "Each time you pass through a vertex, you use two edges. One in, one out.",
          "write": "in one door, out another",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "One edge in, one edge out",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 22,
                "fill": "orange",
                "label": "V"
              },
              {
                "kind": "arrow",
                "x": 80,
                "y": 60,
                "x2": 258,
                "y2": 140,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 302,
                "y": 160,
                "x2": 480,
                "y2": 240,
                "color": "green",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 150,
                "y": 70,
                "text": "in",
                "size": 20,
                "color": "blue",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 420,
                "y": 200,
                "text": "out",
                "size": 20,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "So middle vertices need even degree. Only the start and finish can be odd.",
          "write": "middle vertices: even"
        },
        {
          "say": "Zero odd vertices, a circuit. Two odd, a trail. More, fail.",
          "write": "0 → circuit, 2 → trail, more → fail"
        }
      ]
    },
    {
      "heading": "The bridges of Königsberg",
      "lines": [
        {
          "say": "Can you cross each of these seven bridges exactly once?",
          "diagram": "diagrams/y10/maths/paths-trails-and-circuits-bridges.svg",
          "alt": "Königsberg bridges as a network with degrees 5, 3, 3, 3"
        },
        {
          "say": "The island has degree 5. The other three land areas have degree 3.",
          "write": "5, 3, 3, 3"
        },
        {
          "say": "That's four odd vertices. So no such route exists.",
          "write": "4 odd → no trail"
        }
      ]
    },

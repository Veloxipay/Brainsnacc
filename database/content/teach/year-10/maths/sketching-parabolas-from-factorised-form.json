{
  "level": "Year 10",
  "subject": "maths",
  "title": "Sketching parabolas from factorised form",
  "frames": [
    {
      "heading": "Factorised form",
      "lines": [
        {
          "say": "A quadratic written as a product is in factorised form.",
          "write": "y = a(x − p)(x − q)"
        },
        {
          "say": "Think of a tent. Two pegs in the ground, a pole in the middle.",
          "write": "pegs, then pole"
        },
        {
          "say": "The pegs are the x-intercepts. The pole is the turning point.",
          "write": "x-intercepts, turning point"
        }
      ]
    },
    {
      "heading": "Reading the x-intercepts",
      "lines": [
        {
          "say": "On the x-axis, y is 0. So the product equals 0.",
          "write": "(x − 1)(x − 5) = 0",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Building the sketch of y = (x − 1)(x − 5)",
            "items": [
              {
                "kind": "arrow",
                "x": 20.0,
                "y": 190.0,
                "x2": 545.0,
                "y2": 190.0,
                "color": "black"
              },
              {
                "kind": "arrow",
                "x": 118.2,
                "y": 300.0,
                "x2": 118.2,
                "y2": 15.0,
                "color": "black"
              }
            ]
          }
        },
        {
          "say": "Null factor law: one bracket must be 0. So x is 1 or 5.",
          "write": "x = 1 or x = 5",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Building the sketch of y = (x − 1)(x − 5)",

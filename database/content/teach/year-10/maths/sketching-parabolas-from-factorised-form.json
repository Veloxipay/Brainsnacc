                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "The sign flips. x plus 3 as a bracket gives x equals minus 3.",
          "write": "(x + 3) → x = −3"
        },
        {
          "say": "With a number in front, solve it. 2x minus 1 equals 0 gives a half.",
          "write": "2x − 1 = 0 → x = ½"
        }
      ]
    },

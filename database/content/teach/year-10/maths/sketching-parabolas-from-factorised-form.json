      "lines": [
        {
          "say": "For y equals x squared minus 2x minus 8, factorise first.",
          "write": "y = x² − 2x − 8"
        },
        {
          "say": "Two numbers that multiply to minus 8 and add to minus 2: minus 4 and 2.",
          "write": "y = (x − 4)(x + 2)"
        },
        {
          "say": "Intercepts at 4 and minus 2. The axis is at x equals 1.",
          "write": "x = 4, x = −2;  axis x = 1"
        },
        {
          "say": "Turning point: 1 minus 2 minus 8 is minus 9.",
          "write": "(1, −9), minimum"
        },
        {
          "say": "If both brackets are the same, the graph just touches the axis.",
          "write": "y = a(x − p)² touches at p"
        }
      ]

      "heading": "Remember",
      "lines": [
        {
          "say": "k is where you start, a is what you multiply by.",
          "write": "y = k × aˣ"
        },
        {
          "say": "Growth factor is 1 plus r. Decay factor is 1 minus r.",
          "write": "1 + r  grows,  1 − r  shrinks"
        },
        {
          "say": "Every y equals a to the x goes through 0, 1.",
          "write": "(0, 1)"
        },
        {
          "say": "Add gives a line. Multiply gives a curve.",
          "write": "add → line, multiply → curve"
        }

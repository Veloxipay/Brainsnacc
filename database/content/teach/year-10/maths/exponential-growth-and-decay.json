      "heading": "Watch out for these",
      "lines": [
        {
          "say": "The index belongs only to the base. Don't multiply k and a first.",
          "write": "✗ 5 × 2³ = 10³"
        },
        {
          "say": "A 15 percent loss is times 0.85, not times 0.15.",
          "write": "× (1 − 0.15) = × 0.85"
        },
        {
          "say": "Count periods carefully. Divide the total time by one period.",
          "write": "periods = total ÷ one period"
        },
        {
          "say": "For k bigger than 0, the graph never touches the x-axis.",
          "write": "y > 0 always"
        }
      ]

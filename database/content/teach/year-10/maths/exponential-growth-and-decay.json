{
  "level": "Year 10",
  "subject": "maths",
  "title": "Exponential growth and decay",
  "frames": [
    {
      "heading": "What is an exponential function?",
      "lines": [
        {
          "say": "In an exponential function, x is in the index, the power.",
          "write": "y = aˣ"
        },
        {
          "say": "The base a is positive and not 1.",
          "write": "a > 0,  a ≠ 1"
        },
        {
          "say": "If a is bigger than 1, the graph rises. That's exponential growth.",
          "write": "a > 1: growth"
        },
        {
          "say": "If a is between 0 and 1, the graph falls. That's exponential decay.",
          "write": "0 < a < 1: decay"
        },
        {
          "say": "Both curves pass through 0, 1, because a to the power 0 is 1.",
          "write": "a⁰ = 1",
          "diagram": "diagrams/y10/maths/exponential-growth-and-decay-graphs.svg",
          "alt": "y = 2ˣ rising and y = (½)ˣ falling, both through (0, 1)"
        },
        {
          "say": "The curve gets close to the x-axis but never touches it. That's an asymptote.",
          "write": "asymptote: y = 0"
        }
      ]
    },
    {
      "heading": "Multiply, don't add",
      "lines": [
        {
          "say": "Here is y equals 3 to the x, for x from minus 2 to 2.",
          "write": "y = 3ˣ"
        },
        {
          "say": "Three to the minus 2 is one ninth. A negative index means one over.",
          "write": "3⁻² = 1/9"
        },
        {
          "say": "Each step, y is multiplied by 3. Watch the bars grow.",
          "write": "1 → 3 → 9 → 27  (× 3)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Bars growing or shrinking by the same factor each step",

      "heading": "Euler's formula",
      "lines": [
        {
          "say": "A planar network can be drawn with no edges crossing.",
          "write": "planar"
        },
        {
          "say": "Its edges split the page into faces. The outside counts too.",
          "diagram": "diagrams/y10/maths/networks-vertices-edges-and-degree-faces.svg",
          "alt": "Planar network with 6 vertices, 9 edges and 5 faces"
        },
        {
          "say": "For a connected planar network, v minus e plus f equals 2.",
          "write": "v − e + f = 2"
        },
        {
          "say": "Here, 6 minus 9 plus 5 is 2.",
          "write": "6 − 9 + 5 = 2 ✓"
        },
        {
          "say": "8 vertices and 12 edges? Then f is 6, including the outside.",
          "write": "8 − 12 + f = 2 → f = 6"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A loop counts 2, not 1.",
          "write": "loop → +2"
        },
        {
          "say": "Count every multiple edge separately."
        },
        {
          "say": "Edges equal the sum of degrees divided by 2.",
          "write": "edges = sum ÷ 2"
        },
        {
          "say": "Don't forget the outside face."
        },
        {
          "say": "Position doesn't matter. Only the connections do."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Every edge has two ends.",
          "write": "sum of degrees = 2e"
        },
        {
          "say": "Odd vertices come in pairs.",
          "write": "odd vertices: even count"
        },
        {
          "say": "Very Easy Fun equals 2.",
          "write": "v − e + f = 2"
        },
        {
          "say": "Tick each edge as you count it.",

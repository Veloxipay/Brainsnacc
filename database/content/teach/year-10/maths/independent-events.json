    {
      "heading": "Testing with a table",
      "lines": [
        {
          "say": "100 students. Is being left-handed independent of learning music?",
          "diagram": "diagrams/y10/maths/independent-events-ex3.svg",
          "alt": "Two-way table of handedness and music"
        },
        {
          "say": "Overall, 20 out of 100 are left-handed. That's 0.2.",
          "write": "P(left) = 20/100 = 0.2"
        },
        {
          "say": "In the music row, 6 out of 30 are left-handed. Also 0.2.",
          "write": "P(left | music) = 6/30 = 0.2"
        },
        {
          "say": "They're equal, so in this survey they are independent.",
          "write": "equal → independent"
        }
      ]
    },
    {
      "heading": "At least one",
      "lines": [
        {
          "say": "Three alarm clocks each fail with probability 0.1, independently.",
          "write": "P(fail) = 0.1 each"
        },
        {
          "say": "All three fail? Multiply. That's 0.001.",
          "write": "0.1 × 0.1 × 0.1 = 0.001",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Three alarms all failing",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 130,
                "h": 90,
                "fill": "red",
                "change": "add",
                "label": "fail 0.1"
              },
              {
                "kind": "rect",
                "x": 210,
                "y": 60,
                "w": 130,
                "h": 90,
                "fill": "red",
                "change": "add",
                "label": "fail 0.1"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 60,
                "w": 130,
                "h": 90,
                "fill": "red",
                "change": "add",
                "label": "fail 0.1"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "P(all fail) = 0.001",
                "size": 24,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "At least one goes off is 1 minus 0.001, which is 0.999.",
          "write": "1 − 0.001 = 0.999"
        },
        {
          "say": "At least one equals 1 minus none.",
          "write": "P(at least one) = 1 − P(none)"
        }
      ]
    },
    {
      "heading": "Not the same as mutually exclusive",
      "lines": [
        {
          "say": "Mutually exclusive events can't happen together.",
          "write": "P(A ∩ B) = 0"
        },
        {
          "say": "If one happens, you know the other didn't. So they affect each other.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Two circles that do not overlap",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 20,
                "w": 520,
                "h": 240,
                "fill": "none",
                "color": "grey"
              },
              {
                "kind": "circle",
                "x": 170,
                "y": 140,
                "r": 90,
                "fill": "blue",
                "label": "A"
              },
              {
                "kind": "circle",
                "x": 390,
                "y": 140,
                "r": 90,
                "fill": "orange",
                "label": "B"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "no overlap",
                "size": 18,
                "color": "red",
                "change": "highlight",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "So mutually exclusive events with real chances are never independent.",
          "write": "mutually exclusive ≠ independent"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't assume independence. Test it with numbers.",
          "write": "test: P(A) × P(B)"
        },
        {
          "say": "In a Venn diagram, P of A includes the overlap.",
          "write": "A only + both"
        },
        {
          "say": "For and, multiply. Don't add.",
          "write": "and → ×"
        },
        {
          "say": "For at least one, use 1 minus none.",
          "write": "1 − P(none)"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "No memory, multiply.",
          "write": "independent → multiply"
        },
        {
          "say": "The test is P of A times P of B equals P of A and B.",
          "write": "P(A) × P(B) = P(A ∩ B)?"
        },
        {
          "say": "With replacement is independent. Without replacement is usually dependent.",
          "write": "with replacement → independent"
        }
      ]
    }

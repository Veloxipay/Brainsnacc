  "title": "Independent events",
  "frames": [
    {
      "heading": "What independent means",
      "lines": [
        {
          "say": "Two events are independent if one doesn't change the chance of the other.",
          "write": "P(A | B) = P(A)"
        },
        {
          "say": "Like the bus being late, and separately, the train being late."
        },
        {
          "say": "Here's the test. Is the chance of both equal to the two chances multiplied?",
          "write": "P(A ∩ B) = P(A) × P(B)"
        },
        {
          "say": "If yes, they're independent. If not, they're dependent.",
          "write": "yes → independent"
        }
      ]
    },

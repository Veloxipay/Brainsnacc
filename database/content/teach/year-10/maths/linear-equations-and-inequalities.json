  "title": "Linear equations and inequalities",
  "frames": [
    {
      "heading": "Solving linear equations",
      "lines": [
        {
          "say": "A linear equation has x to the power 1 only.",
          "write": "3(2x − 5) = 4x + 7"
        },
        {
          "say": "Step 1. Expand the brackets.",
          "write": "6x − 15 = 4x + 7"
        },
        {
          "say": "Step 2. Take the smaller x term off both sides.",
          "write": "2x − 15 = 7"
        },
        {
          "say": "Add 15 to both sides.",
          "write": "2x = 22"
        },
        {
          "say": "Step 3. Divide by the coefficient. x is 11.",
          "write": "x = 11"
        },
        {
          "say": "Check. Both sides come to 51.",
          "write": "3 × 17 = 51,  44 + 7 = 51 ✓"
        }
      ]
    },
    {
      "heading": "Equations with fractions",
      "lines": [
        {
          "say": "Clear the fractions. Multiply every term by the lowest common denominator.",
          "write": "(x + 5)/4 − (x − 2)/3 = 1"
        },
        {
          "say": "The LCD of 4 and 3 is 12. Put each numerator in brackets.",
          "write": "3(x + 5) − 4(x − 2) = 12",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Every term multiplied by 12",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "(x + 5)/4 − (x − 2)/3 = 1",
                "size": 28,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 140,
                "y": 110,
                "text": "× 12",
                "size": 20,
                "color": "green",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 300,
                "y": 110,
                "text": "× 12",
                "size": 20,
                "color": "green",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 430,
                "y": 110,
                "text": "× 12",
                "size": 20,
                "color": "green",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 180,
                "text": "3(x + 5) − 4(x − 2) = 12",
                "size": 28,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Minus 4 times minus 2 is plus 8. Watch that sign.",
          "write": "3x + 15 − 4x + 8 = 12"
        },
        {
          "say": "Simplify. Minus x plus 23 equals 12, so x is 11.",
          "write": "x = 11"
        },
        {
          "say": "If x is on the bottom, multiply both sides by that denominator.",
          "write": "5/(x + 1) = 2 → 5 = 2(x + 1)"
        }
      ]
    },

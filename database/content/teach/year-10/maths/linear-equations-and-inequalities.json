    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Multiply every term by the LCD, including the plain numbers.",
          "write": "every term × LCD"
        },
        {
          "say": "Minus a fraction times 12 is minus 4 times the bracket. That gives plus 8.",
          "write": "−4(x − 2) = −4x + 8"
        },
        {
          "say": "Don't forget to flip when dividing by a negative.",
          "write": "−3x ≤ 15 → x ≥ −5"
        },
        {
          "say": "Don't flip when you subtract, or divide by a positive.",
          "write": "÷ positive: no flip"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Expand, collect, divide, then check.",
          "write": "expand → collect → divide → check"
        },
        {
          "say": "Clear fractions first, with numerators in brackets.",
          "write": "× LCD"
        },
        {
          "say": "Negative? Flip it!",
          "write": "× or ÷ negative → flip"
        },
        {
          "say": "Filled circle means included.",
          "write": "●  ≤ ≥     ○  < >"
        }
      ]

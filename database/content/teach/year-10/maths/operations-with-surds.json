    },
    {
      "heading": "Multiplying surds",
      "lines": [
        {
          "say": "Root a times root b is root of a b.",
          "write": "√a × √b = √(ab)"
        },
        {
          "say": "A rectangle is root 12 by root 3. Its area is root 36, which is 6.",
          "write": "√12 × √3 = √36 = 6",
          "diagram": "diagrams/y10/maths/operations-with-surds-rect.svg",
          "alt": "Rectangle √12 cm by √3 cm"
        },
        {
          "say": "With numbers in front, multiply those together too.",
          "write": "2√6 × 5√10"
        },
        {
          "say": "2 times 5 is 10. Root 6 times root 10 is root 60.",
          "write": "10√60"
        },
        {
          "say": "Root 60 is 2 root 15. So the answer is 20 root 15.",
          "write": "= 20√15"
        },
        {
          "say": "A surd times itself loses its root.",
          "write": "√7 × √7 = 7"
        }
      ]
    },
    {
      "heading": "Dividing surds",
      "lines": [
        {
          "say": "Root a over root b is root of a over b.",
          "write": "√a ÷ √b = √(a ÷ b)"
        },
        {
          "say": "Divide the numbers in front, and divide the roots.",
          "write": "12√15 ÷ 4√5"
        },
        {
          "say": "12 over 4 is 3. Root 15 over root 5 is root 3.",
          "write": "= 3√3"
        },
        {
          "say": "Check. 4 root 5 times 3 root 3 is 12 root 15.",
          "write": "4√5 × 3√3 = 12√15 ✓"
        }
      ]
    },

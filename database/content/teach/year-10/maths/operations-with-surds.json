  "title": "Operations with surds",
  "frames": [
    {
      "heading": "Adding and subtracting surds",
      "lines": [
        {
          "say": "Only like surds can be added or subtracted. Same number under the root.",
          "write": "5√7 − 2√7 = 3√7"
        },
        {
          "say": "Add or subtract the numbers in front. Keep the surd.",
          "write": "same root, same unit"
        },
        {
          "say": "Root 2 plus root 3 is not root 5. They're not like surds.",
          "write": "√2 + √3 ≠ √5"
        },
        {
          "say": "Simplify first. Root 12, root 75, root 27 don't look alike.",
          "write": "√12 + √75 − √27",

    {
      "heading": "Perfect squares and conjugates",
      "lines": [
        {
          "say": "A perfect square has three terms. Don't forget the middle one.",
          "write": "(√a + √b)² = a + 2√(ab) + b"
        },
        {
          "say": "Root 5 plus root 2, all squared, is not 5 plus 2.",
          "write": "✗ (√5 + √2)² = 7"
        },
        {
          "say": "a plus root b and a minus root b are a conjugate pair.",
          "write": "(a + √b)(a − √b)"
        },
        {
          "say": "Their product has no surd. It's a squared minus b.",
          "write": "= a² − b"
        },
        {
          "say": "This rectangle is root 5 plus 1 by root 5 minus 1.",
          "diagram": "diagrams/y10/maths/operations-with-surds-ex5.svg",
          "alt": "Rectangle (√5 + 1) by (√5 − 1)"
        },
        {
          "say": "Its area is 5 minus 1, which is 4. The surds cancel out.",
          "write": "(√5)² − 1² = 4 cm²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "The surd terms cancel",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "5 − √5 + √5 − 1",
                "size": 34,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 200,
                "y": 45,
                "w": 170,
                "h": 50,
                "fill": "none",
                "change": "remove",
                "color": "red"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "= 4",
                "size": 40,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Only add surds with the same number under the root.",
          "write": "√2 + √3 ≠ √5"
        },
        {
          "say": "When multiplying, multiply under the roots. Don't add.",
          "write": "√6 × √10 = √60, not √16"
        },
        {
          "say": "Root 3 times root 3 is 3. Not 9.",
          "write": "√3 × √3 = 3"
        },
        {
          "say": "A negative times a negative is positive. Expand one pair at a time."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Same root, same unit. Only like surds add.",
          "write": "like surds only"
        },
        {
          "say": "Times inside, plus outside.",
          "write": "√a × √b = √(ab)"
        },
        {
          "say": "A surd times itself loses its root.",
          "write": "√a × √a = a"
        },
        {
          "say": "Conjugates kill the surd.",
          "write": "(a + √b)(a − √b) = a² − b"
        }
      ]
    }
  ]

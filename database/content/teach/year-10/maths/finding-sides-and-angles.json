{
  "level": "Year 10",
  "subject": "maths",
  "title": "Finding sides and angles",
  "frames": [
    {
      "heading": "The four-step method",
      "lines": [
        {
          "say": "Step 1. Label the sides from the given angle: H, O, A.",
          "write": "1. Label H, O, A"
        },
        {
          "say": "Step 2. Choose the ratio with the side you know and the side you want.",
          "write": "2. SOH CAH TOA"
        },
        {
          "say": "Step 3. Write the equation.",
          "write": "3. sin 40° = x/15"
        },
        {
          "say": "Step 4. Solve it. Round only at the end.",
          "write": "4. Solve, round last"
        }
      ]
    },
    {
      "heading": "Unknown on the top: multiply",
      "lines": [
        {
          "say": "Here the hypotenuse is 15, and x is opposite the 40 degree angle.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Right-angled triangle with angle 40°",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    80,
                    250
                  ],
                  [
                    400,
                    250
                  ],
                  [
                    400,
                    20
                  ]
                ],
                "fill": "none",
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 230,
                "w": 20,
                "h": 20,
                "fill": "none",
                "color": "black"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 240,
                "text": "40°",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 450,
                "y": 140,
                "text": "x",
                "size": 20,
                "color": "orange",
                "bold": true
              },
              {
                "kind": "text",
                "x": 200,
                "y": 120,
                "text": "15 = H",
                "size": 20,
                "color": "blue",
                "bold": true
              },
              {
                "kind": "text",
                "x": 240,
                "y": 280,
                "text": "",
                "size": 20,
                "color": "green",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Label from 40 degrees. x is opposite, 15 is the hypotenuse.",
          "write": "O and H",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Right-angled triangle with angle 40°",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    80,
                    250
                  ],
                  [
                    400,
                    250
                  ],
                  [
                    400,
                    20
                  ]
                ],
                "fill": "none",
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 230,
                "w": 20,
                "h": 20,
                "fill": "none",
                "color": "black"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 240,
                "text": "40°",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 450,
                "y": 140,
                "text": "O = x",
                "size": 20,
                "color": "orange",
                "change": "highlight",
                "bold": true
              },
              {
                "kind": "text",
                "x": 200,
                "y": 120,
                "text": "H = 15",
                "size": 20,
                "color": "blue",
                "change": "highlight",
                "bold": true
              },
              {
                "kind": "text",
                "x": 240,
                "y": 280,
                "text": "",
                "size": 20,
                "color": "green",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "O and H means sine. Sin 40 degrees equals x over 15.",
          "write": "sin 40° = x/15"
        },
        {
          "say": "x is on top, so multiply both sides by 15.",
          "write": "x = 15 × sin 40°"
        },
        {
          "say": "x is about 9.6 centimetres. That's shorter than 15, which makes sense.",
          "write": "x ≈ 9.6 cm ✓"
        }
      ]
    },
    {
      "heading": "Unknown on the bottom: divide",
      "lines": [
        {
          "say": "Now the opposite side is 6 metres and the hypotenuse is x.",
          "write": "sin 28° = 6/x",
          "diagram": "diagrams/y10/maths/finding-sides-and-angles-ex2.svg",
          "alt": "Right triangle with 28°, opposite 6 m, hypotenuse x"
        },
        {
          "say": "x is in the denominator. Multiply by x, then divide by sin 28.",
          "write": "x = 6 ÷ sin 28°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "x on the bottom means divide",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "sin 28° = 6 / x",
                "size": 32,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 45,
                "w": 60,
                "h": 50,
                "fill": "none",
                "change": "highlight",
                "color": "red"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "x = 6 ÷ sin 28°",
                "size": 32,
                "color": "purple",
                "change": "add",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 105,
                "x2": 280,
                "y2": 155,
                "color": "green",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "So x is about 12.8 metres.",
          "write": "x ≈ 12.8 m"
        },
        {
          "say": "Check. The hypotenuse must be the longest side. 12.8 is longer than 6.",
          "write": "12.8 > 6 ✓"
        }
      ]
    },
    {
      "heading": "Finding an angle",
      "lines": [
        {
          "say": "If you know two sides, you can find the angle.",
          "diagram": "diagrams/y10/maths/finding-sides-and-angles-ex3.svg",
          "alt": "Right triangle with θ, adjacent 7 cm, hypotenuse 11 cm"
        },
        {
          "say": "From theta, 7 is adjacent and 11 is the hypotenuse. That's cosine.",
          "write": "cos θ = 7/11"
        },
        {
          "say": "Use the inverse key. It undoes cos and gives an angle.",
          "write": "θ = cos⁻¹(7/11)"
        },
        {
          "say": "Theta is about 50.5 degrees.",
          "write": "θ ≈ 50.5°"
        },
        {
          "say": "Don't stop at 0.64. That's the ratio, not the angle.",
          "write": "✗ θ = 0.64°"
        }
      ]
    },
    {
      "heading": "Two right-angled triangles",
      "lines": [
        {
          "say": "Some shapes hide two right triangles that share a side.",
          "diagram": "diagrams/y10/maths/finding-sides-and-angles-ex4.svg",
          "alt": "Triangle ABC split by height AD"
        },
        {
          "say": "Find the shared side first. Here that's A D.",
          "write": "AD = 12 sin 50° ≈ 9.1925",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "The shared side AD",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    260
                  ],
                  [
                    220,
                    260
                  ],
                  [
                    220,
                    40
                  ]
                ],
                "fill": "blue"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    220,
                    260
                  ],
                  [
                    500,
                    260
                  ],
                  [
                    220,
                    40
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "line",
                "x": 220,
                "y": 40,
                "x2": 220,
                "y2": 260,
                "color": "red",
                "change": "highlight",
                "stroke": 6
              },
              {
                "kind": "text",
                "x": 115,
                "y": 140,
                "text": "12",
                "size": 20,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 85,
                "y": 250,
                "text": "50°",
                "size": 16,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 450,
                "y": 250,
                "text": "35°",
                "size": 16,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 370,
                "y": 140,
                "text": "x",
                "size": 22,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 240,
                "y": 160,
                "text": "AD",
                "size": 18,
                "color": "red",
                "change": "highlight",
                "bold": true,
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "Keep the full calculator value. Use the ANS key.",
          "write": "store AD in memory"
        },
        {
          "say": "Now use triangle A D C. A C equals A D over sin 35.",
          "write": "AC = AD ÷ sin 35°"
        },
        {
          "say": "A C is about 16.0 centimetres.",
          "write": "AC ≈ 16.0 cm"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "If x is on the bottom, the answer is a division, not a multiply.",
          "write": "✗ x = 6 sin 28°"
        },
        {
          "say": "For an angle, press shift, then sin, cos or tan.",
          "write": "SHIFT → sin⁻¹ cos⁻¹ tan⁻¹"
        },
        {
          "say": "Check your calculator is in degree mode.",
          "write": "DEG"
        },
        {
          "say": "A side longer than the hypotenuse means a mistake.",
          "write": "H is the longest side"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Top, times. Bottom, divide.",
          "write": "x on top: ×   x on bottom: ÷"
        },
        {
          "say": "Angle wanted? Use the inverse key.",
          "write": "sides in → angle out"
        },
        {
          "say": "In two-triangle problems, find the shared side first.",
          "write": "shared side first"
        },
        {
          "say": "Round only at the end.",
          "write": "round last"
        }
      ]
    }
  ]
}
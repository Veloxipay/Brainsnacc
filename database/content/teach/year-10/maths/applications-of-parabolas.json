    {
      "heading": "Sensible answers only",
      "lines": [
        {
          "say": "A stone thrown from a cliff. At t equals zero, h is 15.",
          "write": "h = −5t² + 10t + 15",
          "diagram": "diagrams/y10/maths/applications-of-parabolas-cliff.svg",
          "alt": "Stone from a 15 m cliff rising to 20 m and hitting the water at 3 s"
        },
        {
          "say": "The cliff is 15 metres high. The top is 20 metres at 1 second.",
          "write": "max 20 m at 1 s"
        },
        {
          "say": "Setting h to zero gives t equals 3 or minus 1.",
          "write": "−5(t − 3)(t + 1) = 0"
        },
        {
          "say": "Time cannot be negative. Reject minus 1. It hits the water at 3 seconds.",
          "write": "t = 3 s"
        }
      ]
    },
    {
      "heading": "The biggest pen",
      "lines": [
        {
          "say": "Forty metres of fence, against a wall. Each side by the wall is x.",
          "diagram": "diagrams/y10/maths/applications-of-parabolas-pen.svg",
          "alt": "Rectangular pen against a wall with sides x and 40 minus 2x"
        },
        {
          "say": "The side opposite the wall is forty take two x.",
          "write": "40 − 2x"
        },
        {
          "say": "Area is x times forty take two x.",
          "write": "A = 40x − 2x²"
        },
        {
          "say": "Minus b over two a gives x equals 10.",
          "write": "x = −40 ÷ (−4) = 10"
        },
        {
          "say": "So the biggest area is 10 by 20. That is 200 square metres.",
          "write": "A = 200 m²"
        },
        {
          "say": "Notice it is not a square."
        }
      ]
    },
    {
      "heading": "Profit and break-even",
      "lines": [
        {
          "say": "Profit is minus two x squared plus 120 x take 1000.",
          "write": "P = −2x² + 120x − 1000"
        },
        {
          "say": "The best price is 30 dollars. The profit is 800 dollars.",
          "write": "x = 30, P = $800"
        },
        {
          "say": "Break even means profit is zero. Factorise.",
          "write": "(x − 10)(x − 50) = 0"
        },
        {
          "say": "It breaks even at 10 and 50 dollars. Thirty is halfway.",
          "write": "$10 and $50"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Maximum height is the y value of the turning point, not the time."
        },
        {
          "say": "Reject negative times and lengths, and say why."
        },
        {
          "say": "The best rectangle against a wall is not a square."
        },
        {
          "say": "Always give units. Metres, square metres, seconds."
        }
      ]
    },

{
  "level": "Year 10",
  "subject": "maths",
  "title": "Applications of parabolas",
  "frames": [
    {
      "heading": "What the features mean",
      "lines": [
        {
          "say": "Throw a ball, fence a garden, set a price. A quadratic can model each."
        },
        {
          "say": "The turning point is the greatest or least value.",
          "write": "turning point = max or min"
        },
        {
          "say": "If a is negative, it is a maximum. If positive, a minimum.",
          "write": "a < 0: max,  a > 0: min"
        },
        {
          "say": "The x intercepts show when it is zero. Like landing, or breaking even.",
          "write": "x-intercepts: when it’s 0"
        },
        {
          "say": "The y intercept is the starting value.",
          "write": "y-intercept: start value"
        }
      ]
    },
    {
      "heading": "Finding the turning point fast",
      "lines": [
        {
          "say": "The axis of symmetry is halfway between the two solutions."
        },
        {
          "say": "Its x value is minus b over two a.",
          "write": "x = −b ÷ (2a)"
        },
        {
          "say": "Then substitute that x back in to get the max or min."
        },
        {
          "say": "Watch the signs. Write the brackets.",
          "write": "−20 ÷ (2 × −5) = 2"
        }
      ]
    },

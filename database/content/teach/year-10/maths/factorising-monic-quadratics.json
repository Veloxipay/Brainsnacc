    {
      "heading": "Sign clues",
      "lines": [
        {
          "say": "If c is positive, both numbers have the same sign as b.",
          "write": "c > 0: same signs"
        },
        {
          "say": "If c is negative, the numbers have different signs.",
          "write": "c < 0: different signs"
        },
        {
          "say": "Try x squared minus four x minus 21. c is negative, so different signs.",
          "write": "x² − 4x − 21"
        },
        {
          "say": "Three times minus 7 is minus 21. Three plus minus 7 is minus 4.",
          "write": "3 × (−7) = −21,  3 + (−7) = −4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "The bigger number takes the sign of b",
            "items": [
              {
                "kind": "circle",
                "x": 180,
                "y": 120,
                "r": 60,
                "fill": "blue",
                "label": "+3"
              },
              {
                "kind": "circle",
                "x": 380,
                "y": 120,
                "r": 60,
                "fill": "red",
                "change": "highlight",
                "label": "−7"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "bigger one takes the sign of b",
                "size": 20,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "So the answer is x plus 3, times x minus 7.",
          "write": "(x + 3)(x − 7)"
        }
      ]
    },
    {
      "heading": "Common factors first",
      "lines": [
        {
          "say": "Always look for a highest common factor first.",
          "write": "2x² − 16x + 30"
        },
        {
          "say": "Take out 2. Now the bracket is monic.",
          "write": "2(x² − 8x + 15)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Take out the common factor 2",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 90,
                "text": "2x² − 16x + 30",
                "size": 32,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "2(x² − 8x + 15)",
                "size": 32,
                "color": "purple",
                "change": "add",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 110,
                "x2": 280,
                "y2": 155,
                "color": "green",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Multiply to 15, add to minus 8. Minus 3 and minus 5.",
          "write": "2(x − 3)(x − 5)"
        },
        {
          "say": "If x squared is negative, take out minus 1. Every sign inside changes.",
          "write": "−x² + 2x + 15 = −(x² − 2x − 15)"
        },
        {
          "say": "Then factorise as usual.",
          "write": "−(x − 5)(x + 3)"
        }
      ]
    },
    {
      "heading": "Special cases to spot",
      "lines": [
        {
          "say": "Difference of two squares. x squared minus 49.",
          "write": "x² − 49 = (x + 7)(x − 7)"
        },
        {
          "say": "A perfect square. Minus 6 and minus 6 multiply to 36 and add to minus 12.",
          "write": "x² − 12x + 36 = (x − 6)²"
        },
        {
          "say": "With two letters, y rides along with each number.",
          "write": "x² + 5xy + 6y² = (x + 2y)(x + 3y)"
        },
        {
          "say": "Some don't factorise neatly, like x squared plus four x plus 1.",
          "write": "x² + 4x + 1: no whole numbers"
        },
        {
          "say": "You will learn other methods for those later."
        }
      ]
    },
    {
      "heading": "Hidden quadratics",
      "lines": [
        {
          "say": "This one is a quadratic in disguise.",
          "write": "x⁴ − 13x² + 36"
        },
        {
          "say": "Let u equal x squared. It becomes a normal quadratic.",
          "write": "u² − 13u + 36"
        },
        {
          "say": "Multiply to 36, add to minus 13. Minus 4 and minus 9.",
          "write": "(u − 4)(u − 9)"
        },
        {
          "say": "Put x squared back. Both are differences of two squares.",
          "write": "(x² − 4)(x² − 9)"
        },
        {
          "say": "So keep going. Don't stop too early.",
          "write": "(x−2)(x+2)(x−3)(x+3)"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Times to the end, add to the middle. Check both.",
          "write": "× to c,  + to b"
        },
        {
          "say": "Take out the common factor first, including minus 1.",
          "write": "HCF first"
        },
        {
          "say": "Use the sign clues to choose your numbers.",
          "write": "c > 0 same,  c < 0 different"
        },
        {
          "say": "Expand your answer to check. It catches sign errors.",
          "write": "Expand to check ✓"
        }
      ]
    }
  ]
}
    {
      "heading": "Finding the two numbers",
      "lines": [
        {
          "say": "Factorise x squared plus eleven x plus 24.",
          "write": "x² + 11x + 24"
        },
        {
          "say": "List the factor pairs of 24.",
          "write": "1×24, 2×12, 3×8, 4×6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "Factor pairs of 24 with their sums",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 110,
                "h": 60,
                "fill": "white",
                "label": "1 × 24"
              },
              {
                "kind": "rect",
                "x": 160,
                "y": 60,
                "w": 110,
                "h": 60,
                "fill": "white",
                "label": "2 × 12"
              },
              {
                "kind": "rect",
                "x": 290,
                "y": 60,
                "w": 110,
                "h": 60,
                "fill": "white",
                "label": "3 × 8"
              },
              {
                "kind": "rect",
                "x": 420,
                "y": 60,
                "w": 110,
                "h": 60,
                "fill": "white",
                "label": "4 × 6"
              },
              {
                "kind": "text",
                "x": 85,
                "y": 160,
                "text": "sum 25",
                "size": 20,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 215,
                "y": 160,
                "text": "sum 14",
                "size": 20,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 345,
                "y": 160,
                "text": "sum 11",
                "size": 20,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 475,
                "y": 160,
                "text": "sum 10",
                "size": 20,
                "color": "grey"
              }
            ]
          }
        },
        {
          "say": "Which pair adds to 11? Three and eight.",
          "write": "3 + 8 = 11",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "Only 3 and 8 add to 11",
            "items": [

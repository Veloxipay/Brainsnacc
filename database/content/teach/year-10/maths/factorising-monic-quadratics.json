{
  "level": "Year 10",
  "subject": "maths",
  "title": "Factorising monic quadratics",
  "frames": [
    {
      "heading": "What is a monic quadratic?",
      "lines": [
        {
          "say": "A quadratic is monic when the number in front of x squared is 1.",
          "write": "x² − 4x − 21"
        },
        {
          "say": "Factorising is expanding in reverse. We turn it back into two brackets.",
          "write": "x² + bx + c = (x + p)(x + q)"
        },
        {
          "say": "Expand x plus p times x plus q and look at the pattern.",
          "write": "(x + p)(x + q) = x² + (p + q)x + pq"
        },
        {
          "say": "So we need two numbers that multiply to c and add to b.",
          "write": "× to c,  + to b"
        }
      ]
    },

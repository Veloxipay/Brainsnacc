    {
      "heading": "Forecasting with a trend line",
      "lines": [
        {
          "say": "A town grows from 12.0 thousand in 2015 to 15.6 thousand in 2023.",
          "write": "(2015, 12.0) to (2023, 15.6)",
          "diagram": "diagrams/y10/maths/time-series-data-ex2.svg",
          "alt": "Town population 2015 to 2024 with dashed trend line to 2028"
        },
        {
          "say": "Gradient: 3.6 over 8 years is 0.45 thousand per year.",
          "write": "3.6 ÷ 8 = 0.45 per year"
        },
        {
          "say": "2028 is 5 years after 2023. So add 5 times 0.45.",
          "write": "15.6 + 5 × 0.45"
        },
        {
          "say": "The forecast is 17.85 thousand, about 17 900 people.",
          "write": "≈ 17.85 thousand"
        },
        {
          "say": "Near forecasts are more reliable than far ones.",
          "write": "near > far"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Time goes across, never up the side.",
          "write": "time across"
        },
        {
          "say": "A summer peak is seasonality, not a rising trend.",
          "write": "season ≠ trend"
        },
        {
          "say": "For moving averages, slide one value at a time. Groups overlap.",
          "write": "overlap, don't block"
        },
        {
          "say": "Watch the vertical axis. If it starts at 11, rises look steeper.",
          "write": "check the axis start"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Describe trend, seasonality, fluctuations and outliers.",
          "write": "trend, season, irregular, outlier"
        },
        {
          "say": "Moving averages smooth the data so the trend shows.",
          "write": "smooth it"
        },
        {
          "say": "Use the trend line's gradient to forecast.",
          "write": "forecast = last + years × gradient"
        }
      ]
    }

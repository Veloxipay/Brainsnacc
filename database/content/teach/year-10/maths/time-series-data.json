    {
      "heading": "Trend and seasonality",
      "lines": [
        {
          "say": "The trend is the long-term direction: up, down or flat.",
          "write": "trend"
        },
        {
          "say": "Seasonality is a pattern that repeats at the same time each year.",
          "write": "seasonality"
        },
        {
          "say": "Ice-cream sales peak in summer and drop in July, every year.",
          "write": "peaks Dec–Jan, low in July",
          "diagram": "diagrams/y10/maths/time-series-data-ex1.svg",
          "alt": "Monthly ice-cream sales 2023 to 2024"
        },
        {
          "say": "July 2023 was 9 thousand. July 2024 was 11 thousand. A slight upward trend.",
          "write": "July: 9 → 11 thousand"
        },
        {
          "say": "Compare the same season in different years to see the trend.",
          "write": "same season, different years"
        }
      ]
    },
    {
      "heading": "Fluctuations and outliers",
      "lines": [
        {
          "say": "Irregular fluctuations are random ups and downs with no pattern.",
          "write": "irregular fluctuations"
        },
        {
          "say": "An outlier is a single spike far from the pattern.",
          "write": "outlier = spike"
        },
        {
          "say": "Look for a reason, like a one-off event. One spike is not a trend.",
          "write": "spike ≠ trend"
        }
      ]
    },

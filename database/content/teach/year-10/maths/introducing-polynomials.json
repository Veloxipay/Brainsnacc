{
  "level": "Year 10",
  "subject": "maths",
  "title": "Introducing polynomials",
  "frames": [
    {
      "heading": "What is a polynomial?",
      "lines": [
        {
          "say": "A polynomial is a sum of terms, each a number times a power of x.",
          "write": "a × xⁿ"
        },
        {
          "say": "The powers must be whole numbers: 0, 1, 2, 3 and so on.",
          "write": "n = 0, 1, 2, 3, …"
        },
        {
          "say": "Four x cubed minus x squared plus seven x minus 2 is a polynomial.",
          "write": "4x³ − x² + 7x − 2 ✓"
        },
        {
          "say": "Two over x, root x, and 2 to the x are not polynomials.",
          "write": "2/x,  √x,  2ˣ  ✗",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Three expressions that are not polynomials",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 150,
                "h": 80,
                "fill": "white",
                "change": "remove",
                "label": "2/x"
              },
              {
                "kind": "rect",
                "x": 205,
                "y": 60,
                "w": 150,
                "h": 80,
                "fill": "white",
                "change": "remove",
                "label": "√x"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 60,
                "w": 150,
                "h": 80,

{
  "level": "Year 10",
  "subject": "maths",
  "title": "Problem solving with simultaneous equations",
  "frames": [
    {
      "heading": "The five-step plan",
      "lines": [
        {
          "say": "Word problems with two unknowns need two equations."
        },
        {
          "say": "Step 1. Define two pronumerals, with units.",
          "write": "1. Let …"
        },
        {
          "say": "Step 2. Write two equations, from two different facts.",
          "write": "2. Write two equations"
        },
        {
          "say": "Step 3. Solve by substitution, elimination or graphing.",
          "write": "3. Solve"
        },
        {
          "say": "Step 4. Answer the question in words, with units.",
          "write": "4. Answer"
        },
        {
          "say": "Step 5. Check against the story, not just the equations.",
          "write": "5. Check"
        }
      ]
    },
    {
      "heading": "Count and value",
      "lines": [
        {
          "say": "250 tickets were sold. Students pay 8 dollars, adults 15. Takings were 2560 dollars.",
          "write": "250 tickets,  $2560"
        },
        {
          "say": "Let s be student tickets, and a be adult tickets.",
          "write": "s = students,  a = adults"
        },
        {
          "say": "One equation counts the tickets. One adds up the money.",
          "write": "s + a = 250,  8s + 15a = 2560",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "A count equation and a value equation",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 220,
                "h": 80,
                "fill": "blue",
                "label": "s + a = 250"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 60,
                "w": 220,
                "h": 80,
                "fill": "orange",
                "label": "8s + 15a = 2560"
              },
              {
                "kind": "text",
                "x": 150,
                "y": 180,
                "text": "how many",
                "size": 20,
                "color": "blue",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 410,
                "y": 180,
                "text": "how much",
                "size": 20,
                "color": "orange",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Substitute s equals 250 minus a. Then 2000 plus seven a is 2560.",
          "write": "2000 + 7a = 2560"
        },
        {
          "say": "So a is 80 and s is 170.",
          "write": "a = 80,  s = 170"
        },
        {
          "say": "Check with the money. 1360 plus 1200 is 2560.",
          "write": "1360 + 1200 = 2560 ✓"
        }
      ]
    },

          "write": "(3x)² = 9x²"
        },
        {
          "say": "When you subtract a product, expand it in brackets first.",
          "write": "−(x² + 3x − 10)"
        },
        {
          "say": "Then change every sign inside.",
          "write": "= −x² − 3x + 10"
        },
        {
          "say": "Check any answer by putting x equals 1 into both. They should match.",
          "write": "x = 1: both give −15 ✓"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Every term times every term, then collect like terms.",
          "write": "every term × every term"
        },
        {
          "say": "Square the first, double the product, square the last.",
          "write": "(a ± b)² = a² ± 2ab + b²"
        },
        {
          "say": "Same terms, opposite signs. The middle terms cancel.",
          "write": "(a + b)(a − b) = a² − b²"
        },
        {
          "say": "Check by substituting a simple value like x equals 1.",
          "write": "Check: x = 1 ✓"
        }
      ]
    }

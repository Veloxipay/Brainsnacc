                "bold": true
              },
              {
                "kind": "text",
                "x": 440,
                "y": 140,
                "text": "a² + 2ab + b²",
                "size": 24,
                "color": "purple",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "There is a squared, b squared, and two rectangles, each a b.",
          "write": "a² + ab + ab + b²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A square of side a + b split into a², two ab rectangles and b²",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 40,
                "w": 180,
                "h": 180,
                "fill": "blue",
                "label": "a²"

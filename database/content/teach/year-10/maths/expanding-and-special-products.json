      "heading": "Expanding brackets",
      "lines": [
        {
          "say": "Expanding means multiplying out brackets to write a sum of terms.",
          "write": "Expand = multiply out brackets"
        },
        {
          "say": "Start with one bracket. The number outside multiplies both terms inside.",
          "write": "a(b + c) = ab + ac",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "3 multiplies both terms in the bracket",
            "items": [
              {
                "kind": "text",
                "x": 150,
                "y": 120,
                "text": "3(2x − 5)",
                "size": 34,
                "color": "black",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 105,
                "y": 80,
                "x2": 175,
                "y2": 80,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 105,
                "y": 80,
                "x2": 255,
                "y2": 80,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 120,
                "text": "= 6x − 15",
                "size": 34,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Two brackets? Think of two pairs of friends shaking hands."
        },
        {
          "say": "Every term in the first bracket shakes hands with every term in the second.",
          "write": "(a + b)(c + d)"
        },
        {
          "say": "That gives four products: a c, a d, b c and b d.",
          "write": "= ac + ad + bc + bd"
        }
      ]
    },

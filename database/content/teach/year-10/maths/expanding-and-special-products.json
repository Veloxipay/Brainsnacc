            ]
          }
        },
        {
          "say": "Those two rectangles make the middle term, two a b.",
          "write": "(a + b)² = a² + 2ab + b²"
        },
        {
          "say": "With a minus inside, the middle term is minus.",
          "write": "(a − b)² = a² − 2ab + b²"
        },
        {
          "say": "So x plus 5, all squared, is x squared plus ten x plus 25.",
          "write": "(x + 5)² = x² + 10x + 25"
        }
      ]
    },
    {
      "heading": "Difference of two squares",
      "lines": [
        {
          "say": "Now the brackets are the same except for the sign in the middle.",
          "write": "(a + b)(a − b)"
        },
        {
          "say": "Multiply out. Plus a b and minus a b cancel each other.",
          "write": "a² − ab + ab − b²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "The middle terms cancel",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 110,
                "text": "a² − ab + ab − b²",
                "size": 34,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 72,
                "w": 170,
                "h": 52,
                "fill": "none",
                "change": "remove",
                "color": "red"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "= a² − b²",
                "size": 34,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "What is left is a squared minus b squared.",
          "write": "(a + b)(a − b) = a² − b²"
        },
        {
          "say": "Example. Three x plus 4, times three x minus 4.",
          "write": "(3x + 4)(3x − 4)"
        },
        {
          "say": "Square the whole first term and the whole last term.",
          "write": "= 9x² − 16"
        },
        {
          "say": "It works for numbers too. 49 times 51 is 2500 minus 1.",
          "write": "49 × 51 = 50² − 1² = 2499"
        }
      ]
    },
    {
      "heading": "Longer products",
      "lines": [

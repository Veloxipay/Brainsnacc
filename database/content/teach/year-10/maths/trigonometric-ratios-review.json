    {
      "heading": "SOH CAH TOA",
      "lines": [
        {
          "say": "Sine is opposite over hypotenuse.",
          "write": "sin θ = O/H"
        },
        {
          "say": "Cosine is adjacent over hypotenuse.",
          "write": "cos θ = A/H"
        },
        {
          "say": "Tangent is opposite over adjacent.",
          "write": "tan θ = O/A"
        },
        {
          "say": "The ratios depend only on the angle. Same angle means similar triangles.",
          "write": "same θ → same ratio"
        },
        {
          "say": "Tan theta is also sin theta divided by cos theta.",
          "write": "tan θ = sin θ ÷ cos θ"
        }
      ]
    },

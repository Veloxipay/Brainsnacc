    {
      "heading": "From one ratio to the others",
      "lines": [
        {
          "say": "Sin theta is 8 over 17. So opposite is 8 and hypotenuse is 17.",
          "write": "sin θ = 8/17",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Right-angled triangle with angle theta",
            "items": [
              {
                "kind": "polygon",

        },
        {
          "say": "Pythagoras: root of 289 minus 64 is root 225, which is 15.",
          "write": "x = √(289 − 64) = 15",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Right-angled triangle with angle theta",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    80,
                    260
                  ],
                  [
                    440,
                    260
                  ],
                  [
                    440,
                    60
                  ]
                ],
                "fill": "blue"
              },
              {
                "kind": "rect",
                "x": 420,
                "y": 240,
                "w": 20,
                "h": 20,
                "fill": "none"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 250,
                "text": "θ",
                "size": 22,
                "color": "purple",
                "bold": true
              },
              {
                "kind": "text",
                "x": 455,
                "y": 165,
                "text": "8",
                "size": 22,
                "color": "black",
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 260,
                "y": 290,
                "text": "15",
                "size": 22,
                "color": "red",
                "bold": true,
                "change": "add",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 240,
                "y": 145,
                "text": "17",
                "size": 22,
                "color": "black",
                "bold": true,
                "anchor": "end"
              }
            ]
          }
        },
        {
          "say": "So cos theta is 15 over 17, and tan theta is 8 over 15.",
          "write": "cos θ = 15/17, tan θ = 8/15"
        },
        {
          "say": "The two acute angles add to 90. So sin 35 equals cos 55.",
          "write": "sin θ = cos(90° − θ)"
        },
        {
          "say": "Use degree mode. Sin 40 degrees is about 0.6428.",
          "write": "DEG: sin 40° ≈ 0.6428"
        }
      ]
    },
    {
      "heading": "Exact values: 45 degrees",
      "lines": [
        {
          "say": "Cut a square of side 1 along its diagonal.",
          "write": "1, 1, √2",
          "diagram": "diagrams/y10/maths/trigonometric-ratios-review-exact45.svg",
          "alt": "Right isosceles triangle with sides 1, 1 and root 2"
        },
        {
          "say": "Both legs are 1. The hypotenuse is root 2.",
          "write": "H = √2"
        },
        {
          "say": "So sin 45 and cos 45 are both 1 over root 2.",
          "write": "sin 45° = cos 45° = 1/√2"
        },
        {
          "say": "And tan 45 is 1 over 1, which is 1.",
          "write": "tan 45° = 1"
        }
      ]
    },
    {
      "heading": "Exact values: 30 and 60",
      "lines": [
        {
          "say": "Cut an equilateral triangle of side 2 in half.",
          "write": "1, √3, 2",
          "diagram": "diagrams/y10/maths/trigonometric-ratios-review-exact30.svg",
          "alt": "Half-equilateral triangle with sides 1, root 3 and 2"
        },
        {
          "say": "The short side, 1, is opposite the smallest angle, 30.",
          "write": "sin 30° = 1/2"
        },
        {
          "say": "Sin 60 is root 3 over 2. Cos 60 is a half.",
          "write": "sin 60° = √3/2, cos 60° = 1/2"
        },
        {
          "say": "Tan 60 is root 3. Tan 30 is 1 over root 3.",
          "write": "tan 60° = √3, tan 30° = 1/√3"
        },
        {
          "say": "So tan 60 times cos 30 is root 3 times root 3 over 2: three halves.",
          "write": "√3 × √3/2 = 3/2"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Opposite and adjacent swap at the other angle. Start from theta.",
          "write": "label from θ"
        },
        {
          "say": "The hypotenuse is across from the right angle, always.",
          "write": "H opposite the box"
        },
        {
          "say": "Sine and cosine are always something over H.",
          "write": "✗ H/O"
        },
        {
          "say": "Check for D or DEG. Radian mode gives wrong answers.",
          "write": "degree mode"
        },
        {
          "say": "Sin 30 is a half, but sin 60 is root 3 over 2.",
          "write": "sin 30° ≠ sin 60°"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "SOH CAH TOA.",
          "write": "SOH CAH TOA"
        },
        {
          "say": "Same angle, same ratio, whatever the size.",
          "write": "ratios depend on θ only"
        },
        {
          "say": "Draw the 1, 1, root 2 and the 1, root 3, 2 triangles for exact values.",
          "write": "1-1-√2  and  1-√3-2"
        }
      ]
    }

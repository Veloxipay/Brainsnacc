    {
      "heading": "The log laws",
      "lines": [
        {
          "say": "Logs are indices, so index laws become log laws. Same base each time.",
          "write": "same base"
        },
        {
          "say": "Adding logs means multiplying the numbers.",
          "write": "logₐ x + logₐ y = logₐ (xy)"
        },
        {
          "say": "Subtracting logs means dividing the numbers.",
          "write": "logₐ x − logₐ y = logₐ (x/y)"
        },
        {
          "say": "A power comes out the front.",
          "write": "logₐ (xⁿ) = n logₐ x"
        },
        {
          "say": "Log 6 of 4 plus log 6 of 9 is log 6 of 36. That's 2.",
          "write": "log₆ 4 + log₆ 9 = log₆ 36 = 2",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Adding logs multiplies the numbers",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 60,
                "w": 140,
                "h": 70,
                "fill": "blue",
                "label": "log₆ 4"
              },
              {
                "kind": "text",
                "x": 210,
                "y": 103,
                "text": "+",
                "size": 30,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 240,
                "y": 60,
                "w": 140,
                "h": 70,
                "fill": "blue",
                "label": "log₆ 9"
              },
              {
                "kind": "arrow",
                "x": 310,
                "y": 140,
                "x2": 310,
                "y2": 180,
                "color": "green",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 230,
                "y": 190,
                "w": 160,
                "h": 70,
                "fill": "green",
                "change": "add",
                "label": "log₆ 36 = 2"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 103,
                "text": "4 × 9 = 36",
                "size": 20,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Using two laws",
      "lines": [
        {
          "say": "Simplify two log 5 of 10, minus log 5 of 4.",
          "write": "2 log₅ 10 − log₅ 4"
        },
        {
          "say": "Move the 2 inside as a power. Ten squared is 100.",
          "write": "= log₅ 100 − log₅ 4"
        },
        {
          "say": "Subtracting means dividing. 100 over 4 is 25.",
          "write": "= log₅ 25"
        },
        {
          "say": "Five squared is 25, so the answer is 2.",
          "write": "= 2"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't swap the base and the answer. Log 2 of 8 equals 3 means 2 cubed is 8.",
          "write": "2³ = 8, not 3² = 8"
        },
        {
          "say": "Don't divide. Log 3 of 81 is not 27. It's 4.",
          "write": "log₃ 81 = 4"
        },
        {
          "say": "Don't add the numbers inside. Adding logs multiplies them.",
          "write": "✗ log₆ 13"
        },
        {
          "say": "Logs can be negative or fractions.",
          "write": "log₂ (1/8) = −3,  log₁₆ 4 = ½"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "A log is an index.",
          "write": "logₐ x = y ⇔ aʸ = x"
        },
        {
          "say": "Log of 1 is 0. Log of the base is 1.",
          "write": "logₐ 1 = 0,  logₐ a = 1"
        },
        {
          "say": "Multiply becomes add, divide becomes subtract, power becomes multiply.",
          "write": "×→+,  ÷→−,  power→×"
        },
        {
          "say": "Write numbers as powers of the same base.",
          "write": "8 = 2³,  4 = 2²"
        }
      ]
    }
  ]
}
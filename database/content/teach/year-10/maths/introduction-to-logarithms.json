  "frames": [
    {
      "heading": "A logarithm is an index",
      "lines": [
        {
          "say": "A log answers one question. The base to what power gives this number?",
          "write": "logₐ x = y  means  aʸ = x"
        },
        {
          "say": "Two cubed is 8. So log base 2 of 8 is 3.",
          "write": "log₂ 8 = 3",

    {
      "heading": "Outliers",
      "lines": [
        {
          "say": "An outlier is far away from the rest.",
          "write": "outlier"
        },
        {
          "say": "Lower fence is Q1 take 1.5 IQRs. Upper fence is Q3 plus 1.5 IQRs.",
          "write": "Q3 + 1.5 × IQR"
        },
        {
          "say": "These scores have Q1 26 and Q3 35. So IQR is 9.",
          "write": "IQR = 35 − 26 = 9"
        },
        {
          "say": "Upper fence is 35 plus 13.5, which is 48.5. So 58 is an outlier.",
          "write": "fence 48.5 → 58 is an outlier"
        },
        {
          "say": "Draw 58 as a dot. The whisker stops at 38.",
          "diagram": "diagrams/y10/maths/box-plots-and-the-five-number-summary-ex2.svg",
          "alt": "Box plot with whisker ending at 38 and outlier dot at 58"
        }

    {
      "heading": "The five-number summary",
      "lines": [
        {
          "say": "A box plot squeezes a whole data set into five numbers."
        },
        {
          "say": "Minimum, lower quartile, median, upper quartile, maximum.",
          "write": "min, Q1, med, Q3, max"
        },
        {
          "say": "Five numbers, one for each finger, smallest to biggest."
        },
        {
          "say": "The interquartile range is Q3 take Q1. The middle half of the data.",
          "write": "IQR = Q3 − Q1"
        }
      ]
    },

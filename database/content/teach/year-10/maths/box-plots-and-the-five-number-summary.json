    {
      "heading": "Comparing two classes",
      "lines": [
        {
          "say": "Parallel box plots share one scale.",
          "write": "same scale or no deal",
          "diagram": "diagrams/y10/maths/box-plots-and-the-five-number-summary-ex3.svg",
          "alt": "Parallel box plots of Class A and Class B test scores"
        },
        {
          "say": "Class A’s median is 23. Class B’s is 22. Similar typical scores.",
          "write": "median 23 vs 22"
        },
        {
          "say": "Class A has IQR 11. Class B has IQR 5.",
          "write": "IQR 11 vs 5"
        },
        {
          "say": "So Class B is much more consistent."
        },
        {
          "say": "A long right tail means positive skew.",
          "write": "long right tail = positive skew"
        }

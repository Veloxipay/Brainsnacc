    {
      "heading": "Stopping rules",
      "lines": [
        {
          "say": "Iteration never gets the exact answer. So you need a stopping rule.",
          "write": "stopping rule"
        },
        {
          "say": "Stop when two iterates in a row round to the same value.",
          "write": "two in a row agree → stop",
          "diagram": "diagrams/y10/maths/iteration-and-approximation-with-algorithms-flowchart.svg",
          "alt": "Flowchart for a stopping rule"
        },
        {
          "say": "The halving method is slow. Each step halves the interval.",
          "write": "width = 1 ÷ 2ⁿ"
        },
        {
          "say": "To get below 0.01, you need 7 halvings. Two to the 7 is 128.",

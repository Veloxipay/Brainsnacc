    {
      "heading": "Converge or diverge?",
      "lines": [
        {
          "say": "When the values settle down, the iteration converges.",
          "write": "converges ✓"
        },
        {
          "say": "Try x equals x squared minus 3, starting at 2.",
          "write": "xₙ₊₁ = xₙ² − 3"
        },
        {
          "say": "You get 1, then minus 2, then 1, then minus 2, forever.",
          "write": "2 → 1 → −2 → 1 → −2",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "The values bounce between 1 and −2",
            "items": [
              {
                "kind": "circle",
                "x": 100,
                "y": 120,
                "r": 40,
                "fill": "blue",
                "label": "2"
              },
              {
                "kind": "circle",
                "x": 240,
                "y": 120,
                "r": 40,
                "fill": "orange",
                "change": "add",
                "label": "1"
              },
              {
                "kind": "circle",
                "x": 380,
                "y": 120,
                "r": 40,
                "fill": "red",
                "change": "add",
                "label": "−2"
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 90,
                "x2": 340,
                "y2": 90,
                "color": "purple",
                "change": "add"

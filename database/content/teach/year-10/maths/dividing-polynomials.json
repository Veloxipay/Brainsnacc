                "bold": true
              },
              {
                "kind": "rect",
                "x": 80,
                "y": 60,
                "w": 180,
                "h": 130,
                "fill": "blue",
                "label": "?"
              }
            ]
          }
        },
        {
          "say": "x times what gives x squared? x. That makes three x below it.",
          "write": "x × x = x²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Area model: x squared + 7x + 12 divided by x + 3",
            "items": [
              {
                "kind": "text",

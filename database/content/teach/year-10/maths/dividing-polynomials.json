{
  "level": "Year 10",
  "subject": "maths",
  "title": "Dividing polynomials",
  "frames": [
    {
      "heading": "The words",
      "lines": [
        {
          "say": "Polynomials divide just like numbers. 437 divided by 12 is 36, remainder 5.",
          "write": "437 ÷ 12 = 36 r 5"
        },
        {
          "say": "The polynomial being divided is the dividend.",
          "write": "dividend P(x)"
        },
        {
          "say": "We divide by the divisor. The answer is the quotient.",
          "write": "divisor, quotient Q(x)"
        },
        {
          "say": "What is left over is the remainder.",
          "write": "remainder R"
        },
        {
          "say": "They fit together in the division statement.",
          "write": "P(x) = (x − a)Q(x) + R"
        }
      ]
    },
    {
      "heading": "Division undoes multiplication",
      "lines": [
        {
          "say": "This rectangle has area x squared plus seven x plus twelve. One side is x plus 3.",
          "write": "(x² + 7x + 12) ÷ (x + 3)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Area model: x squared + 7x + 12 divided by x + 3",
            "items": [
              {
                "kind": "text",
                "x": 55,
                "y": 125,
                "text": "x",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 55,
                "y": 225,
                "text": "+3",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true

        {
          "say": "Only look at the front term each time."
        },
        {
          "say": "Zero holds the seat.",
          "write": "0x"
        },
        {
          "say": "Check. Divisor times quotient plus remainder gives the dividend.",
          "write": "(x − a)Q(x) + R = P(x)"
        }
      ]
    }
  ]

        },
        {
          "say": "Twice.",
          "write": "2",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Pyramid poured into a prism with the same base and height",
            "items": [
              {
                "kind": "rect",
                "x": 300,
                "y": 60,
                "w": 180,
                "h": 220,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 390,
                "y": 305,
                "text": "prism",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    280
                  ],
                  [
                    220,
                    280
                  ],
                  [
                    130,
                    60
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 305,
                "text": "pyramid",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 207,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "label": "1"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 134,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "change": "add",
                "label": "2"
              }
            ]
          }
        },
        {
          "say": "Three times, and the prism is full. The pyramid holds one third.",
          "write": "V = ⅓ × A × h",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Pyramid poured into a prism with the same base and height",
            "items": [
              {
                "kind": "rect",
                "x": 300,
                "y": 60,
                "w": 180,
                "h": 220,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 390,
                "y": 305,
                "text": "prism",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    280
                  ],
                  [
                    220,
                    280
                  ],
                  [
                    130,
                    60
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 305,
                "text": "pyramid",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 207,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "label": "1"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 134,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "label": "2"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 61,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "change": "add",
                "label": "3"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 30,
                "text": "3 pyramids fill 1 prism",
                "size": 20,
                "color": "purple",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "A is the base area. h is the perpendicular height.",
          "write": "A = base area, h ⟂ height"
        }
      ]
    },
    {
      "heading": "A square pyramid",
      "lines": [
        {
          "say": "Base edges 9 centimetres, height 10 centimetres.",
          "write": "9 × 9 base, h = 10",
          "diagram": "diagrams/y10/maths/volume-of-pyramids-and-cones-ex1.svg",
          "alt": "Square pyramid with base 9 and height 10"
        },
        {
          "say": "Base area first: 9 times 9 is 81.",
          "write": "A = 81 cm²"
        },
        {
          "say": "One third times 81 times 10.",
          "write": "V = ⅓ × 81 × 10"
        },
        {
          "say": "810 divided by 3 is 270 cubic centimetres.",
          "write": "V = 270 cm³"
        }
      ]
    },
    {
      "heading": "Cones",
      "lines": [
        {
          "say": "A cone is a pyramid with a circular base. So A is pi r squared.",
          "write": "V = ⅓πr²h"
        },
        {
          "say": "A cone has radius 6 and slant height 10. That slant is not h.",
          "write": "l = 10, not h",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Cone with radius 6, slant height 10 and height h",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    100,
                    270
                  ],
                  [
                    340,
                    270
                  ],
                  [
                    220,
                    60
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "line",
                "x": 220,
                "y": 60,
                "x2": 220,
                "y2": 270,
                "color": "black",
                "dashed": true
              },
              {
                "kind": "line",
                "x": 220,
                "y": 270,
                "x2": 340,
                "y2": 270,
                "color": "red",
                "stroke": 3
              },
              {
                "kind": "text",
                "x": 280,
                "y": 295,
                "text": "r = 6",
                "size": 18,
                "color": "red",
                "bold": true
              },
              {
                "kind": "text",
                "x": 300,
                "y": 155,
                "text": "l = 10",
                "size": 18,
                "color": "black",
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 205,
                "y": 170,
                "text": "h ?",
                "size": 18,
                "color": "black",
                "bold": true,
                "anchor": "end"
              }
            ]
          }
        },
        {
          "say": "Pythagoras: 100 minus 36 is 64. So h is 8.",
          "write": "h² = l² − r²,  h = 8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Cone with radius 6, slant height 10 and height h",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    100,
                    270
                  ],
                  [
                    340,
                    270
                  ],
                  [
                    220,
                    60
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "line",
                "x": 220,
                "y": 60,
                "x2": 220,
                "y2": 270,
                "color": "black",
                "dashed": true
              },
              {
                "kind": "line",
                "x": 220,
                "y": 270,
                "x2": 340,
                "y2": 270,
                "color": "red",
                "stroke": 3
              },
              {
                "kind": "text",
                "x": 280,
                "y": 295,
                "text": "r = 6",
                "size": 18,
                "color": "red",
                "bold": true
              },
              {
                "kind": "text",
                "x": 300,
                "y": 155,
                "text": "l = 10",
                "size": 18,
                "color": "black",
                "bold": true,
                "anchor": "start"
              },
              {
                "kind": "text",
                "x": 205,
                "y": 170,
                "text": "h = 8",
                "size": 20,
                "color": "green",
                "bold": true,
                "change": "add",
                "anchor": "end"
              },
              {
                "kind": "text",
                "x": 440,
                "y": 120,
                "text": "10² − 6² = 64",
                "size": 18,
                "color": "purple",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "One third times pi times 36 times 8 is 96 pi.",
          "write": "V = ⅓ × π × 36 × 8 = 96π"
        },
        {
          "say": "That is about 301.6 cubic centimetres.",
          "write": "V ≈ 301.6 cm³"
        }
      ]
    },
    {
      "heading": "Composite solids",
      "lines": [
        {
          "say": "A tower is a 6 metre cube with a pyramid of height 4 on top.",
          "write": "cube + pyramid",
          "diagram": "diagrams/y10/maths/volume-of-pyramids-and-cones-ex3.svg",
          "alt": "Cube with a square pyramid on top"
        },
        {
          "say": "Cube: 6 times 6 times 6 is 216.",
          "write": "216 m³"
        },
        {
          "say": "Pyramid: one third times 36 times 4 is 48.",
          "write": "⅓ × 36 × 4 = 48 m³"
        },
        {
          "say": "Add the parts: 264 cubic metres. Subtract for hollow parts.",
          "write": "216 + 48 = 264 m³"
        }
      ]
    },
    {
      "heading": "Working backwards",
      "lines": [
        {
          "say": "A cone has volume 100 pi and radius 5. Find the height.",
          "write": "⅓ × π × 25 × h = 100π"
        },
        {
          "say": "Divide by pi, multiply by 3. 25h is 300.",
          "write": "25h = 300"
        },
        {
          "say": "So h is 12 centimetres.",
          "write": "h = 12 cm"
        },
        {
          "say": "For liquids, 1 cubic centimetre is 1 millilitre. 1000 is 1 litre.",
          "write": "1 cm³ = 1 mL, 1000 cm³ = 1 L"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't forget the third. Without it you get the prism, three times too big.",
          "write": "✗ A × h   ✓ ⅓ × A × h",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Pyramid poured into a prism with the same base and height",
            "items": [
              {
                "kind": "rect",
                "x": 300,
                "y": 60,
                "w": 180,
                "h": 220,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 390,
                "y": 305,
                "text": "prism",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    40,
                    280
                  ],
                  [
                    220,
                    280
                  ],
                  [
                    130,
                    60
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 305,
                "text": "pyramid",
                "size": 18,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 207,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "label": "1"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 134,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "label": "2"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 61,
                "w": 180,
                "h": 73,
                "fill": "blue",
                "change": "add",
                "label": "3"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 30,
                "text": "3 pyramids fill 1 prism",
                "size": 20,
                "color": "purple",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Use the perpendicular height, not the slant height.",
          "write": "h, not l"
        },
        {
          "say": "Use the base area, not just a side length.",
          "write": "A = area"
        },
        {
          "say": "Halve the diameter before using pi r squared.",
          "write": "r = d ÷ 2"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Pyramid: one third, base area, height.",
          "write": "V = ⅓Ah"
        },
        {
          "say": "Cone: one third pi r squared h.",
          "write": "V = ⅓πr²h"
        },
        {
          "say": "Find h with Pythagoras if you're given the slant.",
          "write": "h² = l² − r²"
        }
      ]
    }
  ]
}
{
  "level": "Year 10",
  "subject": "maths",
  "title": "Volume of pyramids and cones",
  "frames": [
    {
      "heading": "The one-third rule",
      "lines": [
        {
          "say": "Take a pyramid and a prism with the same base and height.",
          "write": "same base, same height",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Pyramid poured into a prism with the same base and height",
            "items": [
              {
                "kind": "rect",
                "x": 300,
                "y": 60,
                "w": 180,
                "h": 220,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 390,
                "y": 305,
                "text": "prism",
                "size": 18,
                "color": "black",
                "bold": true

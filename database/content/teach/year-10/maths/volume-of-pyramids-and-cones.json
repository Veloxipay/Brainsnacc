                "y": 305,
                "text": "pyramid",
                "size": 18,
                "color": "black",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Fill the pyramid with sand and pour it in. Once.",
          "write": "1",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 320,
            "alt": "Pyramid poured into a prism with the same base and height",
            "items": [
              {
                "kind": "rect",

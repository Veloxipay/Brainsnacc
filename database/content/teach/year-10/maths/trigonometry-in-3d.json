      "heading": "Find the hidden triangle",
      "lines": [
        {
          "say": "3D problems hide a right triangle inside the shape.",
          "write": "find the triangle"
        },
        {
          "say": "Trace it, then draw it flat with the right angle marked.",
          "write": "draw it flat"
        },
        {
          "say": "If a side is missing, use Pythagoras first, often on the base.",
          "write": "Pythagoras on the base"
        },
        {
          "say": "Then use SOH CAH TOA, just like before.",
          "write": "SOH CAH TOA"
        }
      ]
    },

    {
      "heading": "The formula",
      "lines": [
        {
          "say": "Square each deviation: 16, 4, 1, 1 and 36. They add to 58.",
          "write": "16 + 4 + 1 + 1 + 36 = 58"
        },
        {
          "say": "Divide by n, which is 5. That gives the variance, 11.6.",
          "write": "variance = 58 ÷ 5 = 11.6"
        },
        {
          "say": "Take the square root. Sigma is about 3.41 goals.",
          "write": "σ = √11.6 ≈ 3.41"
        },
        {
          "say": "The band shows one standard deviation either side of the mean.",
          "write": "10 − 3.41 to 10 + 3.41",

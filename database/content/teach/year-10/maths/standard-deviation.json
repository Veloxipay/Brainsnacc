    {
      "heading": "The five steps",
      "lines": [
        {
          "say": "Find the mean.",
          "write": "1. mean"
        },
        {
          "say": "Subtract the mean from each value.",
          "write": "2. deviations"
        },
        {
          "say": "Square each deviation.",
          "write": "3. square"
        },
        {
          "say": "Add them and divide by n.",
          "write": "4. add, ÷ n"
        },
        {
          "say": "Take the square root.",
          "write": "5. √"
        }
      ]
    },
    {
      "heading": "Which is more consistent?",
      "lines": [
        {
          "say": "Set A and Set B both have mean 6.",
          "write": "mean = 6",
          "diagram": "diagrams/y10/maths/standard-deviation-ex2.svg",
          "alt": "Dot plots of Set A and Set B"
        },
        {
          "say": "Set A: squares add to 4. Sigma is root 0.5, about 0.71.",
          "write": "σA = √(4 ÷ 8) ≈ 0.71"
        },
        {
          "say": "Set B: squares add to 52. Sigma is root 6.5, about 2.55.",
          "write": "σB = √(52 ÷ 8) ≈ 2.55"
        },
        {
          "say": "Set A has the smaller sigma, so it is more consistent.",
          "write": "Set A more consistent",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Bars comparing standard deviations 0.71 and 2.55",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 70,
                "w": 106,
                "h": 50,
                "fill": "green",
                "change": "highlight",

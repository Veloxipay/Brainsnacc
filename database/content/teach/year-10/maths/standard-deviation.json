              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Calculators and changes",
      "lines": [
        {
          "say": "Calculators show two values. Sigma x divides by n. Use that one here.",
          "write": "σx (÷ n), not sx (÷ n − 1)"
        },
        {
          "say": "With a frequency table, multiply each squared deviation by its frequency.",
          "write": "f × (x − x̄)²"
        },
        {
          "say": "Add 5 to every value. The mean moves, but the spread does not.",
          "write": "+ 5: σ unchanged"
        },
        {
          "say": "Multiply every value by k, and sigma is multiplied by k.",
          "write": "× k: σ × k"
        },
        {
          "say": "For bell-shaped data: 68, 95 and 99.7 percent within 1, 2, 3 sigma.",
          "write": "68–95–99.7"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't forget the square root. 11.6 is the variance, not sigma.",
          "write": "✗ 11.6   ✓ 3.41"
        },
        {
          "say": "Don't divide by n minus 1 when you want sigma.",
          "write": "÷ n"
        },
        {
          "say": "Square the deviations. Plain deviations always add to 0.",
          "write": "square first"
        },
        {
          "say": "Don't ignore frequencies. n is the total frequency.",
          "write": "n = Σf"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Mean, deviations, square, average, square root.",
          "write": "mean, dev, square, avg, √"
        },
        {
          "say": "Smaller standard deviation means more consistent data.",
          "write": "small σ = consistent"
        },
        {
          "say": "Adding a constant leaves sigma unchanged.",
          "write": "+ c: same σ"
        }
      ]
    }
  ]

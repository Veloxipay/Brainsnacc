{
  "level": "Year 10",
  "subject": "maths",
  "title": "Standard deviation",
  "frames": [
    {
      "heading": "Measuring spread",
      "lines": [
        {
          "say": "Two players both average 15 points. One is steady, one swings wildly.",
          "write": "same mean, different spread"
        },
        {
          "say": "The standard deviation measures how spread out data is around the mean.",
          "write": "σ, sigma"
        },
        {
          "say": "Like darts: how far they typically land from the bullseye.",
          "write": "small σ = bunched"
        },
        {
          "say": "Small means consistent. Large means spread out. All the same means 0.",
          "write": "σ = 0 if all equal"
        }
      ]
    },

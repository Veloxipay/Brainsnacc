      "heading": "The addition rule",
      "lines": [
        {
          "say": "Adding P of A and P of B counts the overlap twice.",
          "write": "P(A) + P(B) double counts"
        },
        {
          "say": "So take the overlap away once.",
          "write": "P(A ∪ B) = P(A) + P(B) − P(A ∩ B)"
        },
        {
          "say": "P of A is 0.5, P of B is 0.4, both is 0.15. Union is 0.75.",
          "write": "0.5 + 0.4 − 0.15 = 0.75"

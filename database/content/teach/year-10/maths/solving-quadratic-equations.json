        {
          "say": "If A times B is 0, then A is 0 or B is 0.",
          "write": "A × B = 0 → A = 0 or B = 0"
        },
        {
          "say": "Factorise x squared plus 2x minus 15. 5 and minus 3 multiply to minus 15, add to 2.",
          "write": "(x + 5)(x − 3) = 0"
        },
        {

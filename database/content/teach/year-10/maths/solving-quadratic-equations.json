    {
      "heading": "The null factor law",
      "lines": [
        {
          "say": "Think of a lamp with two switches in a row. If it is off, one switch is off.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Two factors multiplying to zero",
            "items": [
              {
                "kind": "rect",

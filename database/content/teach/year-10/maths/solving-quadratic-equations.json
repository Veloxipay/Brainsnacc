    {
      "heading": "Never divide by x",
      "lines": [
        {
          "say": "Solve 3x squared equals 12x.",
          "write": "3x² = 12x"
        },
        {
          "say": "If you divide by x, you lose the answer x equals 0.",
          "write": "✗ ÷ x"
        },
        {
          "say": "Instead, bring everything to one side.",
          "write": "3x² − 12x = 0"
        },
        {
          "say": "Take out the common factor 3x.",
          "write": "3x(x − 4) = 0"
        },
        {
          "say": "So x is 0 or x is 4.",
          "write": "x = 0 or x = 4"
        }
      ]
    },
    {
      "heading": "Rearrange first",
      "lines": [
        {
          "say": "Solve 2x squared minus 5x equals 3. Make one side zero first.",
          "write": "2x² − 5x − 3 = 0"
        },
        {
          "say": "ac is minus 6. Minus 6 and 1 add to minus 5. Split the middle.",
          "write": "2x² − 6x + x − 3 = 0"
        },
        {
          "say": "Group and factorise.",
          "write": "(x − 3)(2x + 1) = 0"
        },
        {
          "say": "So x is 3, or x is minus a half.",
          "write": "x = 3 or x = −1/2"
        }
      ]
    },
    {
      "heading": "Square roots and plus or minus",
      "lines": [
        {
          "say": "x squared equals 49. Take the square root, and write plus or minus.",
          "write": "x² = 49 → x = ±7"
        },
        {
          "say": "x squared plus 6x plus 2 does not factorise with whole numbers.",
          "write": "x² + 6x + 2 = 0"
        },
        {
          "say": "Complete the square. It becomes x plus 3, all squared, equals 7.",
          "write": "(x + 3)² = 7"
        },
        {
          "say": "Square root both sides, with plus or minus.",
          "write": "x + 3 = ±√7"
        },
        {
          "say": "Exact answer: x is minus 3, plus or minus root 7.",
          "write": "x = −3 ± √7"
        }
      ]
    },
    {
      "heading": "A worded problem",
      "lines": [
        {
          "say": "A garden is 4 metres longer than it is wide. Its area is 60.",
          "write": "x(x + 4) = 60",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Rectangle x by x + 4 with area 60",
            "items": [
              {
                "kind": "rect",
                "x": 80,
                "y": 60,
                "w": 320,
                "h": 192,
                "fill": "green",
                "label": "60 m²"
              },
              {
                "kind": "text",
                "x": 240,
                "y": 45,
                "text": "x + 4",
                "size": 20,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 420,
                "y": 165,
                "text": "x",
                "size": 22,
                "color": "black",
                "bold": true,
                "anchor": "start"
              }
            ]
          }
        },
        {
          "say": "Make it zero and factorise.",
          "write": "(x + 10)(x − 6) = 0"
        },
        {
          "say": "x is minus 10 or 6. A width cannot be negative, so reject minus 10.",
          "write": "✗ x = −10   ✓ x = 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Reject the negative width",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 140,
                "text": "x = −10",
                "size": 34,
                "color": "red",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 140,
                "text": "x = 6",
                "size": 34,
                "color": "green",
                "bold": true,
                "change": "highlight"
              }
            ]

        },
        {
          "say": "So the gradient is 3 over 2, which is 1.5.",
          "write": "m = 3/2 = 1.5"
        },
        {
          "say": "The equation is y equals 1.5 x plus 3.",
          "write": "y = 1.5x + 3"
        }
      ]
    },
    {
      "heading": "Parallel and perpendicular",
      "lines": [
        {
          "say": "Parallel lines have equal gradients.",
          "write": "m₁ = m₂"
        },
        {
          "say": "Perpendicular lines meet at 90 degrees. Their gradients multiply to minus 1.",
          "write": "m₁ × m₂ = −1"
        },
        {
          "say": "Flip the fraction and switch the sign. Two thirds becomes minus three halves.",
          "write": "⅔ → −3/2",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A line and its perpendicular through (4, −1)",
            "items": [
              {

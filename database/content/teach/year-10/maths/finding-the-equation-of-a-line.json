{
  "level": "Year 10",
  "subject": "maths",
  "title": "Finding the equation of a line",
  "frames": [
    {
      "heading": "Two facts fix a line",
      "lines": [
        {
          "say": "To write a line's equation, you need two facts."
        },
        {
          "say": "Either a gradient and a point, or two points.",
          "write": "m + point,  or  2 points"
        },
        {
          "say": "With two points, always find the gradient first.",
          "write": "gradient first"
        }
      ]
    },
    {
      "heading": "The point–gradient formula",
      "lines": [
        {
          "say": "Gradient m, through the point x one, y one.",
          "write": "y − y₁ = m(x − x₁)"
        },
        {
          "say": "Example. Gradient 3, through 2, 5.",
          "write": "m = 3,  (2, 5)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "The point (2, 5)",
            "items": [
              {
                "kind": "arrow",
                "x": 60.0,
                "y": 200.0,
                "x2": 500.0,
                "y2": 200.0,
                "color": "grey"
              },
              {
                "kind": "arrow",
                "x": 148.0,
                "y": 260.0,
                "x2": 148.0,
                "y2": 20.0,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 494.0,
                "y": 222.0,
                "text": "x",
                "size": 16,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 162.0,
                "y": 34.0,
                "text": "y",
                "size": 16,
                "color": "grey"
              },
              {
                "kind": "circle",
                "x": 324.0,
                "y": 50.0,
                "r": 6,
                "fill": "red"
              },
              {
                "kind": "text",
                "x": 288.0,
                "y": 50.0,
                "text": "(2, 5)",
                "size": 16,
                "color": "red"
              }
            ]
          }
        },
        {
          "say": "Substitute. y minus 5 equals 3 times x minus 2.",
          "write": "y − 5 = 3(x − 2)"
        },
        {
          "say": "Expand the bracket.",
          "write": "y − 5 = 3x − 6"
        },
        {
          "say": "Add 5 to both sides. Now y is the subject.",
          "write": "y = 3x − 1",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "The line y = 3x − 1 through (2, 5)",
            "items": [
              {
                "kind": "arrow",
                "x": 60.0,
                "y": 200.0,
                "x2": 500.0,
                "y2": 200.0,
                "color": "grey"
              },
              {
                "kind": "arrow",
                "x": 148.0,
                "y": 260.0,
                "x2": 148.0,
                "y2": 20.0,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 494.0,
                "y": 222.0,
                "text": "x",
                "size": 16,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 162.0,
                "y": 34.0,
                "text": "y",
                "size": 16,
                "color": "grey"
              },
              {
                "kind": "line",
                "x": 119.0,
                "y": 260.0,
                "x2": 353.0,
                "y2": 20.0,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 324.0,
                "y": 50.0,
                "r": 6,
                "fill": "red"
              },
              {
                "kind": "text",
                "x": 288.0,
                "y": 50.0,
                "text": "(2, 5)",
                "size": 16,
                "color": "red"
              },
              {
                "kind": "text",
                "x": 403.0,
                "y": 30.0,
                "text": "y = 3x − 1",
                "size": 16,
                "color": "blue",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Check. When x is 2, three times 2 minus 1 is 5.",
          "write": "3(2) − 1 = 5 ✓"
        }
      ]
    },
    {
      "heading": "From two points",
      "lines": [
        {
          "say": "Find the line through minus 1, 4 and 3, minus 4.",
          "write": "(−1, 4) and (3, −4)"
        },
        {
          "say": "Gradient first. Rise over run is minus 8 over 4, which is minus 2.",
          "write": "m = −8 ÷ 4 = −2"
        },
        {
          "say": "Use the point minus 1, 4. Watch the double negative.",
          "write": "y − 4 = −2(x − (−1))"
        },
        {
          "say": "x minus minus 1 becomes x plus 1.",
          "write": "y − 4 = −2(x + 1)"
        },
        {
          "say": "Expand and tidy up.",
          "write": "y = −2x + 2"
        },
        {
          "say": "Check with the other point. Minus 2 times 3 plus 2 is minus 4.",
          "write": "−2(3) + 2 = −4 ✓"
        }
      ]
    },

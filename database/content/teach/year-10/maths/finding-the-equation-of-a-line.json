          }
        },
        {
          "say": "The perpendicular through 4, minus 1 is y equals minus 1.5 x plus 5.",
          "write": "y = −1.5x + 5"
        },
        {
          "say": "Check. Two thirds times minus three halves is minus 1.",
          "write": "⅔ × (−3/2) = −1 ✓"
        }
      ]
    },
    {
      "heading": "General form",
      "lines": [
        {
          "say": "Sometimes you must give general form, with whole numbers and zero on one side.",
          "write": "ax + by + d = 0"
        },
        {
          "say": "Start with y equals minus 1.5 x plus 5. Multiply by 2 to clear the decimal.",
          "write": "2y = −3x + 10"
        },
        {
          "say": "Move everything to one side.",
          "write": "3x + 2y − 10 = 0"
        },
        {
          "say": "Check with 4, minus 1. Twelve minus 2 minus 10 is 0.",
          "write": "3(4) + 2(−1) − 10 = 0 ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "With a negative coordinate, put the brackets in before simplifying.",
          "write": "x − (−1) = x + 1"
        },
        {
          "say": "y-values go on top of the gradient formula.",
          "write": "m = (y₂ − y₁) ÷ (x₂ − x₁)"
        },
        {
          "say": "The perpendicular to 4 is minus a quarter. Flip and switch.",
          "write": "4 → −¼"
        },
        {
          "say": "Finish the job. Expand and make y the subject.",
          "write": "y = mx + c"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Point, slope, go! Substitute, then tidy up.",
          "write": "y − y₁ = m(x − x₁)"
        },
        {
          "say": "Two points? Gradient first.",
          "write": "m first"
        },
        {
          "say": "Parallel means same gradient. Perpendicular means flip and switch.",
          "write": "m₁ × m₂ = −1"
        },
        {
          "say": "Check with the second point.",
          "write": "check ✓"
        }
      ]
    }
  ]
}
      "heading": "Relations and functions",
      "lines": [
        {
          "say": "A relation is any set of x, y pairs.",
          "write": "relation: (x, y) pairs"
        },
        {
          "say": "A function is special. Every x has exactly one y.",
          "write": "function: one in, one out"
        },

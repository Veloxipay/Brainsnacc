    {
      "heading": "Remember",
      "lines": [
        {
          "say": "One in, one out.",
          "write": "function: one output each"
        },
        {
          "say": "Use the vertical line test on graphs.",
          "write": "cut twice → not a function"
        },
        {
          "say": "f of 3 is an output. f of x equals 3 asks for an input.",
          "write": "f(3)  vs  f(x) = 3"
        },
        {
          "say": "Domain is x, range is y. D before R, x before y.",
          "write": "D → x,  R → y"

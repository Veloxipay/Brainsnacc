        {
          "say": "Lines are often written in general form.",
          "write": "3x + 2y = 6"
        },
        {
          "say": "The gradient is not 3. Make y the subject first.",
          "write": "2y = −3x + 6"
        },
        {
          "say": "Divide every term by 2.",
          "write": "y = −1.5x + 3"
        },
        {
          "say": "Now the gradient is minus 1.5 and the y-intercept is 3.",
          "write": "m = −1.5,  c = 3"
        },
        {
          "say": "Dividing by a negative? Every sign changes.",
          "write": "5x − 2y = 10 → y = 2.5x − 5"
        }

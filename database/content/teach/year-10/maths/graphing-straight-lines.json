  "title": "Graphing straight lines",
  "frames": [
    {
      "heading": "Gradient–intercept form",
      "lines": [
        {
          "say": "A line written as y equals m x plus c is in gradient–intercept form.",
          "write": "y = mx + c"
        },
        {
          "say": "m is the gradient. It's rise over run.",
          "write": "m = rise ÷ run"
        },
        {
          "say": "Positive m slopes up to the right. Negative m slopes down.",
          "write": "m > 0 ↗   m < 0 ↘"
        },
        {
          "say": "c is the y-intercept, where the line crosses the y-axis.",
          "write": "c → (0, c)"
        },
        {
          "say": "m for move, c for cross.",
          "write": "m: move,  c: cross"
        }
      ]
    },

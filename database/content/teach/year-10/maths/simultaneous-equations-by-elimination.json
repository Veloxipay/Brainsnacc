{
  "level": "Year 10",
  "subject": "maths",
  "title": "Simultaneous equations by elimination",
  "frames": [
    {
      "heading": "Comparing two receipts",
      "lines": [
        {
          "say": "2 coffees and a muffin cost 13 dollars. 1 coffee and a muffin, 8.50.",
          "write": "2c + m = 13;  c + m = 8.50"
        },
        {
          "say": "The only difference is one coffee, and 4.50 dollars.",
          "write": "c = 4.50"
        },
        {
          "say": "Subtracting one receipt from the other eliminated the muffin.",
          "write": "eliminate = make it vanish"
        },
        {
          "say": "We do the same with equations. Make one pronumeral disappear.",
          "write": "add or subtract equations"
        }
      ]
    },
    {
      "heading": "Add or subtract?",
      "lines": [
        {
          "say": "Look at the coefficients of one pronumeral in both equations.",
          "write": "compare coefficients"
        },
        {
          "say": "Opposite signs, like plus 2y and minus 2y? Add the equations.",
          "write": "opposite signs → add"
        },
        {
          "say": "Same sign, like 3x and 3x? Subtract one from the other.",
          "write": "same sign → subtract"
        },
        {
          "say": "Memory trick: Same Sign Subtract.",
          "write": "SSS: Same Sign Subtract"
        }
      ]
    },

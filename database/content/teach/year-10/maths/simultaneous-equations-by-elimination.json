    {
      "heading": "The method",
      "lines": [
        {
          "say": "Line up the equations: x under x, y under y, numbers on the right.",
          "write": "1. line up"
        },
        {
          "say": "Multiply so one pronumeral has matching coefficients.",
          "write": "2. match coefficients"
        },
        {
          "say": "Add or subtract to eliminate it, then solve.",
          "write": "3. eliminate, solve"
        },
        {
          "say": "Substitute back to find the other value, then check both.",
          "write": "4. sub back   5. check both"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Multiply every term. 5x minus y equals 9, times 3, gives 27 on the right.",
          "write": "✗ 15x − 3y = 9"
        },
        {
          "say": "Use brackets when you subtract. 8y minus negative 9y is 17y.",
          "write": "8y − (−9y) = 17y"
        },
        {
          "say": "Adding 3x and 3x doesn't eliminate anything. Same sign, subtract.",
          "write": "✗ 3x + 3x = 6x"
        },
        {
          "say": "Don't stop halfway. Find both values.",
          "write": "x and y"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Same Sign Subtract. Opposite signs add.",
          "write": "SSS"
        },
        {
          "say": "Eliminate the pronumeral that is easiest to match.",
          "write": "kill the easy one"
        },
        {
          "say": "Two equations, two checks.",
          "write": "check both"
        },
        {
          "say": "The answer is where the two lines cross.",
          "write": "point of intersection"
        }
      ]
    }
  ]

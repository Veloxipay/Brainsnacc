{
  "level": "Year 10",
  "subject": "maths",
  "title": "Spheres: surface area and volume",
  "frames": [
    {
      "heading": "The sphere formulas",
      "lines": [
        {
          "say": "A sphere is all points the same distance r from a centre.",
          "write": "radius r, diameter 2r",
          "diagram": "diagrams/y10/maths/spheres-surface-area-and-volume-ex1.svg",
          "alt": "Sphere with radius 9 cm"
        },
        {
          "say": "Peel an orange and lay it flat.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Orange peel covering four circles",
            "items": [
              {
                "kind": "circle",
                "x": 90,
                "y": 150,
                "r": 60,
                "fill": "orange",
                "label": "r"
              },
              {
                "kind": "text",
                "x": 90,
                "y": 240,
                "text": "orange",
                "size": 18,
                "color": "black"
              }
            ]
          }
        },
        {
          "say": "The peel covers about four circles the size of its middle.",
          "write": "SA = 4πr²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Orange peel covering four circles",
            "items": [
              {
                "kind": "circle",
                "x": 90,
                "y": 150,
                "r": 60,
                "fill": "orange",
                "label": "r"
              },
              {
                "kind": "text",
                "x": 90,
                "y": 240,
                "text": "orange",
                "size": 18,
                "color": "black"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 150,
                "r": 38,
                "fill": "yellow",
                "label": "πr²"
              },
              {
                "kind": "circle",
                "x": 305,
                "y": 150,
                "r": 38,
                "fill": "yellow",
                "label": "πr²"
              },
              {
                "kind": "circle",
                "x": 390,
                "y": 150,
                "r": 38,
                "fill": "yellow",
                "label": "πr²"
              },
              {
                "kind": "circle",
                "x": 475,
                "y": 150,
                "r": 38,
                "fill": "yellow",
                "change": "add",
                "label": "πr²"
              },
              {
                "kind": "text",
                "x": 370,
                "y": 240,
                "text": "4 circles = 4πr²",
                "size": 22,
                "color": "purple",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "The volume is four thirds pi r cubed.",
          "write": "V = ⁴⁄₃πr³"
        },
        {
          "say": "Area uses r squared, square units. Volume uses r cubed, cubic units.",
          "write": "cm²  vs  cm³"
        }
      ]
    },
    {
      "heading": "Radius 9 centimetres",
      "lines": [
        {
          "say": "Surface area is 4 times pi times 81, which is 324 pi.",
          "write": "SA = 4π × 9² = 324π"
        },
        {
          "say": "That is about 1017.9 square centimetres.",
          "write": "SA ≈ 1017.9 cm²"
        },
        {
          "say": "Volume: cube the radius first. 9 cubed is 729.",
          "write": "V = ⁴⁄₃ × π × 729"
        },
        {
          "say": "That is 972 pi, about 3053.6 cubic centimetres.",
          "write": "V = 972π ≈ 3053.6 cm³"
        }
      ]
    },
    {
      "heading": "Hemispheres",
      "lines": [
        {
          "say": "A hemisphere is half a sphere: a curved surface and a flat circle.",
          "write": "hemisphere = ½ sphere",
          "diagram": "diagrams/y10/maths/spheres-surface-area-and-volume-hemi.svg",
          "alt": "Hemisphere on its flat face"
        },
        {
          "say": "The curved surface is half of 4 pi r squared, so 2 pi r squared.",
          "write": "curved = 2πr²"
        },
        {
          "say": "Add the flat circle for a solid hemisphere: 3 pi r squared.",
          "write": "total = 2πr² + πr² = 3πr²"
        },
        {
          "say": "The volume is half of four thirds, so two thirds pi r cubed.",
          "write": "V = ⅔πr³"
        }
      ]
    },
    {
      "heading": "A hemispherical bowl",
      "lines": [
        {
          "say": "A bowl has diameter 20 centimetres. Halve it first. r is 10.",
          "write": "r = 20 ÷ 2 = 10",
          "diagram": "diagrams/y10/maths/spheres-surface-area-and-volume-ex2.svg",
          "alt": "Hemispherical bowl with diameter 20 cm"
        },
        {
          "say": "Volume is two thirds times pi times 1000. About 2094.4.",
          "write": "V ≈ 2094.4 cm³"
        },
        {
          "say": "1000 cubic centimetres is 1 litre. So it holds about 2.09 litres.",
          "write": "≈ 2.09 L"
        }
      ]
    },
    {

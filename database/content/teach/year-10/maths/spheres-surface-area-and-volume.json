        {
          "say": "Add them. About 636.7 cubic metres.",
          "write": "V ≈ 636.7 m³"
        },
        {
          "say": "For surface area, count only the outside. The joined circle is hidden.",
          "write": "outside surfaces only"
        }
      ]
    },
    {
      "heading": "Working backwards",
      "lines": [
        {
          "say": "A sphere has volume 36 pi. Find the radius.",
          "write": "⁴⁄₃πr³ = 36π"
        },
        {
          "say": "Divide by pi and multiply by three quarters. r cubed is 27.",
          "write": "r³ = 36 × ¾ = 27"
        },
        {
          "say": "Take the cube root. r is 3 centimetres.",
          "write": "r = ∛27 = 3 cm"
        },
        {
          "say": "From a surface area, you take a square root instead.",
          "write": "SA → √,  V → ∛"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Use the radius, not the diameter. The error is huge when you cube.",
          "write": "halve the diameter"
        },
        {
          "say": "Surface is squared. Volume is cubed.",
          "write": "SA: r²   V: r³"
        },
        {
          "say": "A solid hemisphere includes its flat face. An open bowl does not.",
          "write": "3πr² or 2πr²"
        },
        {
          "say": "Don't count hidden faces in composite solids.",
          "write": "no hidden faces"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Four circles of peel: 4 pi r squared.",
          "write": "SA = 4πr²"
        },
        {
          "say": "Volume is four thirds pi r cubed.",
          "write": "V = ⁴⁄₃πr³"
        },
        {
          "say": "Hemisphere: halve it, then think about the flat face.",
          "write": "½ sphere + flat face?"
        },
        {
          "say": "Check the units: squared for area, cubed for volume.",
          "write": "cm² area, cm³ volume"
        }
      ]
    }
  ]

                "x": 80,
                "y": 60,
                "x2": 80,
                "y2": 260,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 80,
                "y": 260,
                "x2": 500,
                "y2": 260,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 80,
                "y": 60,
                "x2": 500,
                "y2": 60,
                "color": "grey",
                "dashed": true
              },
              {
                "kind": "line",
                "x": 80,
                "y": 60,
                "x2": 480,
                "y2": 260,
                "color": "purple",
                "dashed": true
              },
              {
                "kind": "text",
                "x": 170,
                "y": 85,
                "text": "24°",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 60,
                "y": 160,
                "text": "45",
                "size": 20,
                "color": "black",
                "anchor": "end",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 480,
                "y": 250,
                "r": 10,
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 300,
                "y": 290,
                "text": "d",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 420,
                "y": 245,
                "text": "24°",
                "size": 20,
                "color": "red",
                "anchor": "middle",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 450,
                "y": 40,
                "text": "Z shape: alternate angles",
                "size": 18,
                "color": "red",
                "anchor": "end",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Draw a Z for depression. The angles inside are equal.",
          "write": "Z: equal angles"
        },
        {
          "say": "Use SOH CAH TOA in the right triangle.",
          "write": "SOH CAH TOA"
        },
        {
          "say": "Add any extra height at the end.",
          "write": "+ eye height"
        }
      ]
    }
  ]

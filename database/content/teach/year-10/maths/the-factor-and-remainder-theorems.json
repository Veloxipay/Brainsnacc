    {
      "heading": "Finding an unknown",
      "lines": [
        {
          "say": "x minus 2 is a factor of 2x cubed plus k x squared minus 7x minus 6.",
          "write": "P(x) = 2x³ + kx² − 7x − 6"
        },
        {
          "say": "Factor theorem: P of 2 must be 0.",
          "write": "P(2) = 0"
        },
        {
          "say": "16 plus 4k minus 14 minus 6 equals 0. So 4k is 4, and k is 1.",
          "write": "4k − 4 = 0,  k = 1"
        },
        {
          "say": "Divide by x minus 2, then factorise the quadratic.",
          "write": "(x − 2)(2x + 3)(x + 1)"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "For x plus 2, substitute minus 2, not 2.",
          "write": "x + 2 → −2"
        },
        {
          "say": "P of a equals 0 means x minus a is the factor, not a.",
          "write": "factor is x − a"
        },
        {
          "say": "Fully factorise means keep going until every bracket is linear.",
          "write": "keep going"
        },
        {
          "say": "Use brackets. Minus 2 squared is 4, minus 2 cubed is minus 8.",
          "write": "(−2)² = 4, (−2)³ = −8"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Remainder on dividing by x minus a is P of a.",
          "write": "R = P(a)"
        },
        {
          "say": "Zero remainder means a factor.",
          "write": "P(a) = 0 ⇔ (x − a) factor"
        },
        {
          "say": "Test, divide, factorise.",
          "write": "test, divide, factorise"
        }
      ]

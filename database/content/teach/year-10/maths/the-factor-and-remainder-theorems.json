{
  "level": "Year 10",
  "subject": "maths",
  "title": "The factor and remainder theorems",
  "frames": [
    {
      "heading": "The remainder theorem",
      "lines": [
        {
          "say": "Divide P of x by x minus a. The remainder is just P of a.",
          "write": "remainder = P(a)"
        },
        {
          "say": "Why? P of x is x minus a, times Q, plus R.",
          "write": "P(x) = (x − a)Q(x) + R"
        },
        {
          "say": "Put x equals a. The bracket becomes 0, so P of a equals R.",
          "write": "P(a) = 0 × Q(a) + R = R"
        },
        {
          "say": "Dividing by x minus 3? Substitute x equals 3.",
          "write": "x − 3 → x = 3"
        },
        {
          "say": "Dividing by x plus 2? That is x minus negative 2, so use minus 2.",
          "write": "x + 2 → x = −2"
        }
      ]
    },

        {
          "say": "So x squared plus six x plus nine is x plus 3, all squared.",
          "write": "x² + 6x + 9 = (x + 3)²"
        },
        {
          "say": "Halve the x coefficient, then square it.",
          "write": "(b/2)²"
        }
      ]
    },
    {
      "heading": "Completing the square",
      "lines": [
        {
          "say": "What completes x squared plus ten x? Half of 10 is 5.",
          "write": "10 ÷ 2 = 5"
        },
        {
          "say": "Five squared is 25.",
          "write": "x² + 10x + 25 = (x + 5)²"
        },
        {
          "say": "Now x squared plus six x plus five. Halve 6, square it. Nine.",
          "write": "x² + 6x + 5"
        },
        {
          "say": "Add nine and take nine away. That keeps it equal.",
          "write": "x² + 6x + 9 − 9 + 5"
        },
        {
          "say": "The first three make a square. Minus nine plus five is minus 4.",
          "write": "(x + 3)² − 4"
        },
        {
          "say": "Halve it, square it, add it, take it away."
        }
      ]
    },
    {
      "heading": "Minimum value",
      "lines": [
        {
          "say": "A square is never negative.",
          "write": "(x + 3)² ≥ 0"
        },
        {
          "say": "So x plus 3 squared, take 4, is smallest when the square is zero.",
          "write": "x = −3"
        },
        {
          "say": "The minimum value is minus 4.",
          "write": "minimum = −4"
        },
        {
          "say": "A minus sign in front of the square gives a maximum instead."
        }
      ]
    },
    {
      "heading": "Factorising with surds",
      "lines": [
        {
          "say": "x plus 3 squared take 4 is a difference of two squares.",
          "write": "(x + 3)² − 2²"
        },
        {
          "say": "So it factorises to x plus 1, times x plus 5.",
          "write": "(x + 1)(x + 5)"
        },
        {
          "say": "Try x squared take eight x plus 3. Halve minus 8, square it. Sixteen.",
          "write": "x² − 8x + 16 − 16 + 3"
        },
        {
          "say": "That gives x take 4 squared, take 13.",
          "write": "(x − 4)² − 13"
        },
        {
          "say": "Thirteen is not a perfect square, so use root 13.",
          "write": "(x − 4 − √13)(x − 4 + √13)"
        },
        {
          "say": "Plus a positive number instead? It cannot factorise.",
          "write": "(x + h)² + k: no factors"
        }
      ]
    },
    {
      "heading": "Fractions and a not 1",
      "lines": [
        {
          "say": "x squared plus five x plus 1. Half of 5 is five halves.",
          "write": "(5/2)² = 25/4"
        },
        {
          "say": "Minus 25 quarters plus 1 is minus 21 quarters.",
          "write": "(x + 5/2)² − 21/4"
        },
        {
          "say": "If a is not 1, take it out of the first two terms.",
          "write": "2(x² + 6x) + 7"
        },
        {
          "say": "Complete inside, then multiply back out. Two times minus 9 is minus 18.",
          "write": "2(x + 3)² − 11"
        },
        {
          "say": "So the minimum value is minus 11.",
          "write": "min = −11"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Always take away what you added.",
          "write": "✗ (x + 3)² + 5"
        },
        {
          "say": "Halve first, then square. The corner is 9, not 36.",
          "write": "3² not 6²"
        },
        {
          "say": "The sign in the bracket copies the sign of the x term.",
          "write": "x² − 8x → (x − 4)²"
        },
        {
          "say": "With a not 1, multiply the subtracted number by a too."
        }
      ]
    },

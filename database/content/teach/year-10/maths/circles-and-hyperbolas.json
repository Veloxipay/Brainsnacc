    {
      "heading": "Shifted hyperbolas",
      "lines": [
        {
          "say": "y equals a over x has two branches. The axes are asymptotes.",
          "write": "y = a/x"
        },
        {
          "say": "Shift it. Now the asymptotes move too.",
          "write": "y = a/(x − h) + k"
        },
        {
          "say": "Bottom equals zero gives the wall. That is x equals h.",
          "write": "vertical: x = h"
        },
        {
          "say": "The number added on gives the floor. That is y equals k.",
          "write": "horizontal: y = k"
        },
        {
          "say": "Positive a, branches top right and bottom left. Negative a, the other two."
        }
      ]
    },
    {
      "heading": "Sketching a hyperbola",
      "lines": [
        {
          "say": "Sketch y equals 2 over x take 1, plus 3.",
          "write": "y = 2/(x − 1) + 3"
        },
        {
          "say": "The wall is x equals 1. The floor is y equals 3.",
          "write": "x = 1,  y = 3"
        },
        {
          "say": "Put x equals 0. y equals minus 2 plus 3, which is 1.",
          "write": "(0, 1)"
        },
        {
          "say": "Put y equals 0. Solve to get x equals one third.",
          "write": "(⅓, 0)"
        },
        {
          "say": "a is positive, so branches go top right and bottom left.",
          "diagram": "diagrams/y10/maths/circles-and-hyperbolas-hyperbola.svg",
          "alt": "Hyperbola y = 2/(x - 1) + 3 with asymptotes x = 1 and y = 3"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Flip the signs. x plus 2 means h is minus 2.",
          "write": "(x + 2) → h = −2"
        },
        {
          "say": "Radius is the square root. Twenty five gives radius 5.",
          "write": "r² = 25 → r = 5"
        },
        {
          "say": "When completing the square, balance what you add."
        },
        {
          "say": "Hyperbola branches never touch their asymptotes."
        }
      ]
    },

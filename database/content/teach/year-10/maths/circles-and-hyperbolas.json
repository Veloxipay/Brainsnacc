    {
      "heading": "Writing and testing circles",
      "lines": [
        {
          "say": "x plus 2 means h is minus 2. So the centre is minus 2, 1.",
          "write": "(x + 2)² + (y − 1)² = 9"
        },
        {
          "say": "Root the right. The radius is 3, not 9.",
          "write": "r = 3"
        },
        {
          "say": "Centre 1, minus 4, radius 5. Write the equation.",
          "write": "(x − 1)² + (y + 4)² = 25"
        },
        {
          "say": "Test the point 4, 0. Nine plus sixteen is 25. It is on the circle.",
          "write": "9 + 16 = 25 ✓"
        },
        {
          "say": "Less than r squared is inside. More is outside.",
          "write": "< r² inside, > r² outside"
        }
      ]
    },
    {
      "heading": "Circles in expanded form",
      "lines": [
        {
          "say": "Sometimes the circle comes expanded.",
          "write": "x² + y² − 6x + 4y − 3 = 0"
        },
        {
          "say": "Group the x terms and the y terms.",
          "write": "(x² − 6x) + (y² + 4y) = 3"
        },
        {
          "say": "Complete each square.",
          "write": "(x − 3)² − 9 + (y + 2)² − 4 = 3"
        },
        {
          "say": "Move the 9 and the 4 across. Three plus 13 is 16.",
          "write": "(x − 3)² + (y + 2)² = 16"
        },
        {
          "say": "Centre 3, minus 2. Radius 4. Same circle as before.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,

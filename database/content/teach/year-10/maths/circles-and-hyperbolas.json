  "title": "Circles and hyperbolas",
  "frames": [
    {
      "heading": "The circle equation",
      "lines": [
        {
          "say": "Every point on a circle is the same distance r from the centre.",
          "write": "radius r"
        },
        {
          "say": "By Pythagoras, the gaps across and up give r squared.",
          "write": "(x − h)² + (y − k)² = r²"
        },
        {
          "say": "Here is a circle of radius 4 at the origin.",
          "write": "x² + y² = 16",
          "draw": {
            "type": "shapes",
            "width": 560,

{
  "level": "Year 10", "subject": "maths", "title": "Year 10 Semester 1 review",
  "frames": [
    { "heading": "How to use this review",
      "lines": [
        { "say": "This review is a practice test on Chapters 1 to 5.", "write": "Semester 1 · Chapters 1–5" },
        { "say": "Give yourself about 60 minutes, in a quiet place, with no notes.", "write": "60 minutes, no notes" },
        { "say": "Do the 5 short-answer questions first, then the 20 multiple-choice.", "write": "5 short answer → 20 MC" },
        { "say": "Mark every correct step, not only the final answer.", "write": "a mark for every step" },
        { "say": "Every question you miss points to a chapter to go back to.", "write": "miss it → redo that lesson" }
      ] },
    { "heading": "Chapter 1: equations",
      "lines": [
        { "say": "Start with a linear equation. Expand the brackets first.", "write": "4(x − 3) − 2x = 10" },
        { "say": "Four x take twelve, take two x. That leaves two x minus twelve.", "write": "2x − 12 = 10",
          "draw": { "type": "balance", "left": { "bags": 2, "cubes": -12 }, "right": { "cubes": 10 } } },
        { "say": "Add 12 to both sides. The red minus cubes cancel out.", "write": "2x = 22",
          "draw": { "type": "balance", "left": { "bags": 2, "cubes": -12 }, "right": { "cubes": 10 }, "remove": 12, "removeFrom": "left", "add": 12, "addTo": "right", "labels": ["2x − 12 + 12", "10 + 12"] } },
        { "say": "Share 22 between 2 bags. Each bag gets 11.", "write": "x = 11",
          "draw": { "type": "balance", "left": { "bags": 2 }, "right": { "cubes": 22 }, "share": true } },
        { "say": "For simultaneous equations, add them so plus 3y and minus 3y cancel.", "write": "7x = 14, x = 2, y = 3" }
      ] },
    { "heading": "Chapter 2: networks",
      "lines": [
        { "say": "Here are five huts joined by walking tracks.", "diagram": "diagrams/y10/maths/year-10-semester-1-review-tracks.svg", "alt": "Network of five huts P, Q, R, S, T with track lengths in kilometres" },
        { "say": "The degree of a vertex is how many tracks meet there.", "write": "P2 Q3 R4 S3 T2" },
        { "say": "The degrees add to 14, which is twice the 7 edges.", "write": "14 = 2 × 7 ✓" },
        { "say": "Exactly two odd vertices, Q and S. So an Euler trail exists.", "write": "2 odd vertices → Euler trail" },
        { "say": "The shortest path from P to T goes the long way round: 14 kilometres.",
          "write": "P–R–Q–S–T = 14 km",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Shortest path P to T highlighted through R, Q and S", "items": [
            { "kind": "line", "x": 60, "y": 130, "x2": 200, "y2": 50, "color": "grey" },
            { "kind": "line", "x": 60, "y": 130, "x2": 200, "y2": 210, "color": "purple", "change": "highlight" },
            { "kind": "line", "x": 200, "y": 50, "x2": 200, "y2": 210, "color": "purple", "change": "highlight" },
            { "kind": "line", "x": 200, "y": 50, "x2": 360, "y2": 50, "color": "purple", "change": "highlight" },
            { "kind": "line", "x": 200, "y": 210, "x2": 360, "y2": 50, "color": "grey" },
            { "kind": "line", "x": 200, "y": 210, "x2": 500, "y2": 130, "color": "grey" },
            { "kind": "line", "x": 360, "y": 50, "x2": 500, "y2": 130, "color": "purple", "change": "highlight" },
            { "kind": "circle", "x": 60, "y": 130, "r": 20, "fill": "blue", "label": "P" },
            { "kind": "circle", "x": 200, "y": 50, "r": 20, "fill": "blue", "label": "Q" },
            { "kind": "circle", "x": 200, "y": 210, "r": 20, "fill": "blue", "label": "R" },
            { "kind": "circle", "x": 360, "y": 50, "r": 20, "fill": "blue", "label": "S" },
            { "kind": "circle", "x": 500, "y": 130, "r": 20, "fill": "blue", "label": "T" },
            { "kind": "text", "x": 110, "y": 190, "text": "3", "size": 18 },
            { "kind": "text", "x": 212, "y": 135, "text": "2", "size": 18 },
            { "kind": "text", "x": 280, "y": 40, "text": "5", "size": 18 },
            { "kind": "text", "x": 440, "y": 80, "text": "4", "size": 18 },
            { "kind": "text", "x": 280, "y": 250, "text": "3 + 2 + 5 + 4 = 14 km", "size": 20, "bold": true, "color": "purple", "anchor": "middle" }
          ] } }
      ] },
    { "heading": "Chapter 3: indices and growth",
      "lines": [
        { "say": "A one-third power means a cube root. The cube root of 8 is 2.", "write": "(8x⁶)^(1/3) = 2x²" },
        { "say": "Growth of 4 percent a year means multiply by 1.04 each year.", "write": "P = 2500 × 1.04⁵ ≈ 3042",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Bars growing each year from 2500 to about 3042", "items": [
            { "kind": "line", "x": 30, "y": 230, "x2": 540, "y2": 230, "color": "black" },
            { "kind": "rect", "x": 50, "y": 80, "w": 60, "h": 150, "fill": "blue", "label": "2500" },
            { "kind": "rect", "x": 130, "y": 74, "w": 60, "h": 156, "fill": "blue" },
            { "kind": "rect", "x": 210, "y": 68, "w": 60, "h": 162, "fill": "blue" },
            { "kind": "rect", "x": 290, "y": 62, "w": 60, "h": 168, "fill": "blue" },
            { "kind": "rect", "x": 370, "y": 55, "w": 60, "h": 175, "fill": "blue" },
            { "kind": "rect", "x": 450, "y": 48, "w": 60, "h": 182, "fill": "orange", "label": "3042", "change": "add" },
            { "kind": "text", "x": 280, "y": 30, "text": "× 1.04 every year", "size": 20, "bold": true, "color": "purple", "anchor": "middle" },
            { "kind": "text", "x": 80, "y": 252, "text": "year 0", "size": 16, "anchor": "middle" },
            { "kind": "text", "x": 480, "y": 252, "text": "year 5", "size": 16, "anchor": "middle" }
          ] } },
        { "say": "Write 64 as 2 to the power 6. Then match the powers.", "write": "2^(x+1) = 2⁶ → x = 5" },
        { "say": "Log base 3 of 81 asks: 3 to what power gives 81? The answer is 4.", "write": "log₃ 81 = 4" }
      ] },
    { "heading": "Chapter 4: pyramids",
      "lines": [
        { "say": "A square pyramid with base 10 centimetres and height 12 centimetres.", "diagram": "diagrams/y10/maths/year-10-semester-1-review-pyramid.svg", "alt": "Square-based pyramid with base edge 10 cm and perpendicular height 12 cm" },
        { "say": "The slant height is a hypotenuse, using the height and half the base.", "write": "s = √(12² + 5²) = 13 cm",
          "draw": { "type": "shapes", "width": 560, "height": 280, "alt": "Right triangle with height 12, half base 5 and slant height 13", "items": [
            { "kind": "polygon", "points": [[200, 240], [360, 240], [200, 40]], "fill": "teal" },
            { "kind": "text", "x": 180, "y": 145, "text": "12", "size": 22, "anchor": "end" },
            { "kind": "text", "x": 280, "y": 270, "text": "5", "size": 22, "anchor": "middle" },
            { "kind": "line", "x": 200, "y": 40, "x2": 360, "y2": 240, "color": "red", "change": "highlight" },
            { "kind": "text", "x": 300, "y": 130, "text": "s = 13", "size": 24, "bold": true, "color": "red", "change": "add" }
          ] } },
        { "say": "Surface area is the base plus four triangles. 100 plus 260 is 360.", "write": "SA = 100 + 4 × 65 = 360 cm²" },
        { "say": "Volume is one third times base area times height.", "write": "V = ⅓ × 100 × 12 = 400 cm³" }
      ] },
    { "heading": "Chapter 5: quadratics",
      "lines": [
        { "say": "Solve x squared plus 4x minus 7 equals zero by completing the square.", "write": "x² + 4x − 7 = 0" },
        { "say": "Move the 7 across, then add half of 4, squared, to both sides.", "write": "x² + 4x + 4 = 11",
          "draw": { "type": "shapes", "width": 560, "height": 280, "alt": "Completing the square: x squared plus two 2x strips plus a missing 2 by 2 corner", "items": [
            { "kind": "rect", "x": 160, "y": 40, "w": 160, "h": 160, "fill": "blue", "label": "x²" },
            { "kind": "rect", "x": 320, "y": 40, "w": 40, "h": 160, "fill": "orange", "label": "2x" },
            { "kind": "rect", "x": 160, "y": 200, "w": 160, "h": 40, "fill": "orange", "label": "2x" },
            { "kind": "rect", "x": 320, "y": 200, "w": 40, "h": 40, "fill": "green", "label": "4", "change": "add" },
            { "kind": "text", "x": 460, "y": 140, "text": "(x + 2)²", "size": 26, "bold": true, "color": "purple", "anchor": "middle" }
          ] } },
        { "say": "So x plus 2, all squared, equals 11.", "write": "(x + 2)² = 11" },
        { "say": "Take plus or minus the square root. x is about 1.32 or minus 5.32.", "write": "x = −2 ± √11" },
        { "say": "The discriminant is 44. Positive, so there are two solutions.", "write": "Δ = 16 + 28 = 44 > 0" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Show every step. Marks come from the working, not only the answer.", "write": "show all working" },
        { "say": "Check answers by substituting back into the question.", "write": "check ✓" },
        { "say": "Networks: count odd vertices to decide on Euler trails.", "write": "0 or 2 odd → Euler trail" },
        { "say": "Missed a question? Note its chapter and redo that lesson.", "write": "miss → redo lesson" }
      ] }
  ]
}

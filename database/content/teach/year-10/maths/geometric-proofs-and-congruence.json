        },
        {
          "say": "The order of the letters matters. A matches D, B matches E, C matches F.",
          "write": "△ABC ≅ △DEF"
        },
        {
          "say": "So A B equals D E, and B C equals E F.",
          "write": "AB = DE,  BC = EF,  AC = DF"
        }
      ]
    },
    {
      "heading": "The four congruence tests",
      "lines": [
        {
          "say": "You don't need all six measurements. One of four tests is enough.",
          "diagram": "diagrams/y10/maths/geometric-proofs-and-congruence-tests.svg",
          "alt": "The four tests SSS, SAS, AAS and RHS"
        },
        {
          "say": "S S S. All three pairs of sides are equal.",
          "write": "SSS"
        },
        {
          "say": "S A S. Two sides, and the angle between them, are equal.",
          "write": "SAS: angle sandwiched"
        },
        {
          "say": "A A S. Two angles and a matching side are equal.",
          "write": "AAS"
        },
        {
          "say": "R H S. A right angle, equal hypotenuses, and one other equal side.",
          "write": "RHS"
        },
        {
          "say": "S S A is not a test. It can make two different triangles.",
          "write": "✗ SSA"
        }
      ]
    },

    {
      "heading": "Finding an unknown",
      "lines": [
        {
          "say": "In this kite, A B equals A D, and C B equals C D.",
          "diagram": "diagrams/y10/maths/geometric-proofs-and-congruence-ex4.svg",
          "alt": "Kite ABCD with angle ADC = 100° and angle ABC = (3x + 10)°"
        },
        {
          "say": "A C is a common side, so the triangles are congruent by S S S.",
          "write": "△ABC ≅ △ADC (SSS)"
        },
        {
          "say": "B matches D, so the angles at B and D are equal.",
          "write": "3x + 10 = 100"
        },
        {
          "say": "Solve. Three x is 90, so x is 30.",
          "write": "x = 30"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "S S A is not a test. In S A S, check the angle is between the sides.",
          "write": "✗ SSA"
        },
        {
          "say": "Match the vertices in order. P Q R and X Y Z means Q R equals Y Z.",
          "write": "△PQR ≅ △XYZ → QR = YZ"
        },
        {
          "say": "Never assume from the picture. Use only facts that are given or proved."
        },
        {
          "say": "Look for a common side. It's a free pair.",
          "write": "shared side = free pair"
        }
      ]
    },

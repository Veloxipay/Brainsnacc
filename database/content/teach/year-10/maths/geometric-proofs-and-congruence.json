          "say": "S S S, S A S, A A S, R H S. The four that pass the test.",
          "write": "SSS, SAS, AAS, RHS"
        },
        {
          "say": "The A in S A S is sandwiched between the sides.",
          "write": "S–A–S"
        },
        {
          "say": "Every statement needs a reason.",
          "write": "Statement | Reason"
        },
        {
          "say": "Once congruent, all matching parts are equal.",
          "write": "matching parts ="
        }
      ]
    }
  ]
}
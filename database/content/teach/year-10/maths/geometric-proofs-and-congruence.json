{
  "level": "Year 10",
  "subject": "maths",
  "title": "Geometric proofs and congruence",
  "frames": [
    {
      "heading": "What a proof looks like",
      "lines": [
        {
          "say": "A proof starts with what you are given, and what you need to prove.",
          "write": "Given … To prove …"
        },
        {
          "say": "Then you write statements. Every statement needs a reason.",
          "write": "Statement | Reason"
        },
        {
          "say": "Reasons are facts that are always true. Angles on a straight line add to 180.",
          "write": "straight line: 180°"
        },
        {
          "say": "Vertically opposite angles are equal. Angles in a triangle add to 180.",
          "write": "vert. opp. equal,  △ = 180°"
        },
        {
          "say": "On parallel lines, alternate and corresponding angles are equal.",
          "write": "alternate =, corresponding ="
        },
        {
          "say": "A side shared by two triangles is equal to itself. That's a common side.",
          "write": "common side"
        }
      ]
    },
    {
      "heading": "Congruent triangles",
      "lines": [
        {
          "say": "Congruent triangles are exactly the same shape and size.",
          "write": "≅  means congruent"
        },
        {
          "say": "One fits exactly on top of the other. It may need flipping or turning.",
          "draw": {

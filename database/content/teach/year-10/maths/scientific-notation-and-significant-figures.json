    {
      "heading": "Rounding to significant figures",
      "lines": [
        {
          "say": "Round 48 615 to 2 significant figures.",
          "write": "48 615"
        },
        {
          "say": "Count the first two digits, 4 and 8. The next digit is 6.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Significant figures highlighted",
            "items": [
              {
                "kind": "rect",
                "x": 159,
                "y": 70,
                "w": 42,
                "h": 60,
                "fill": "green",

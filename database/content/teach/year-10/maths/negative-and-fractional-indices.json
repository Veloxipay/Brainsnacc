                "y": 240,
                "text": "each step: ÷ 2",
                "size": 20,
                "color": "orange",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "A negative index means the reciprocal. One over.",
          "write": "a⁻ⁿ = 1/aⁿ"
        },
        {
          "say": "So 3 to the minus 2 is one ninth. Not minus 9.",
          "write": "3⁻² = 1/9"
        },
        {
          "say": "For a fraction, flip it and make the index positive.",
          "write": "(2/3)⁻² = (3/2)² = 9/4"
        },
        {
          "say": "Four to the minus 3 is one over 64.",
          "write": "4⁻³ = 1/64"
        }
      ]
    },
    {
      "heading": "Fractional indices mean roots",
      "lines": [
        {
          "say": "A half times 2 is 1. So a to the half, squared, is a.",
          "write": "(a^½)² = a¹ = a"
        },
        {
          "say": "That means a to the half is the square root of a.",
          "write": "a^(1/2) = √a"
        },
        {
          "say": "In general, one over n means the n-th root.",
          "write": "a^(1/n) = ⁿ√a"
        },
        {
          "say": "25 to the half is 5. 8 to the one third is 2.",
          "write": "25^(1/2) = 5,  8^(1/3) = 2"
        }
      ]
    },
    {
      "heading": "Root, then power",
      "lines": [
        {
          "say": "In 27 to the two thirds, the bottom number is the root.",
          "write": "27^(2/3)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "In 27^(2/3), 3 is the root and 2 is the power",
            "items": [
              {
                "kind": "text",
                "x": 170,
                "y": 120,
                "text": "27",
                "size": 60,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 230,
                "y": 75,
                "text": "2",
                "size": 30,
                "color": "orange",
                "bold": true
              },
              {
                "kind": "text",
                "x": 250,
                "y": 75,
                "text": "/",
                "size": 30,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 270,
                "y": 75,
                "text": "3",
                "size": 30,
                "color": "green",
                "change": "highlight",
                "bold": true
              },
              {
                "kind": "text",
                "x": 450,
                "y": 80,
                "text": "3 → root",
                "size": 22,
                "color": "green",
                "change": "highlight",
                "bold": true
              },
              {
                "kind": "text",
                "x": 450,
                "y": 150,
                "text": "2 → power",
                "size": 22,
                "color": "orange",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "The top number is the power.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "In 27^(2/3), 3 is the root and 2 is the power",
            "items": [
              {
                "kind": "text",
                "x": 170,
                "y": 120,
                "text": "27",
                "size": 60,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 230,
                "y": 75,
                "text": "2",
                "size": 30,
                "color": "orange",
                "change": "highlight",
                "bold": true
              },
              {
                "kind": "text",
                "x": 250,
                "y": 75,
                "text": "/",
                "size": 30,
                "color": "grey"
              },
              {
                "kind": "text",
                "x": 270,
                "y": 75,
                "text": "3",
                "size": 30,
                "color": "green",
                "bold": true
              },
              {
                "kind": "text",
                "x": 450,
                "y": 80,
                "text": "3 → root",
                "size": 22,
                "color": "green",
                "bold": true
              },
              {
                "kind": "text",
                "x": 450,
                "y": 150,
                "text": "2 → power",
                "size": 22,
                "color": "orange",
                "change": "highlight",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Cube root of 27 is 3. Then 3 squared is 9.",
          "write": "(∛27)² = 3² = 9"
        },
        {
          "say": "Root first keeps the numbers small.",
          "write": "root first"
        },
        {
          "say": "100 000 to the two fifths. Fifth root is 10, squared is 100.",
          "write": "100000^(2/5) = 10² = 100"
        }
      ]
    },
    {
      "heading": "Flip, root, power",
      "lines": [
        {
          "say": "A negative fractional index has three jobs: flip, root, power.",
          "write": "a^(−m/n)"
        },
        {
          "say": "8 over 27, to the minus two thirds. Flip first.",
          "write": "(8/27)^(−2/3) = (27/8)^(2/3)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Flip the fraction",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 70,
                "w": 140,
                "h": 90,
                "fill": "blue",
                "label": "8/27"
              },
              {
                "kind": "arrow",
                "x": 190,
                "y": 115,
                "x2": 240,
                "y2": 115,
                "color": "green",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 250,
                "y": 70,
                "w": 140,
                "h": 90,
                "fill": "green",
                "change": "add",
                "label": "27/8"
              },
              {
                "kind": "text",
                "x": 460,
                "y": 120,
                "text": "flip",
                "size": 24,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Cube root of top and bottom gives 3 over 2.",
          "write": "∛27 = 3,  ∛8 = 2 → 3/2"
        },
        {
          "say": "Then square. The answer is 9 over 4.",
          "write": "(3/2)² = 9/4"
        }
      ]
    },
    {
      "heading": "Simplifying with positive indices",
      "lines": [
        {
          "say": "Simplify 16 x to the 8, y to the minus 4, all to the three quarters.",
          "write": "(16x⁸y⁻⁴)^(3/4)"
        },
        {
          "say": "16 to the three quarters. Fourth root is 2, cubed is 8.",
          "write": "16^(3/4) = 2³ = 8"
        },
        {
          "say": "Multiply the indices. x to the 6, and y to the minus 3.",
          "write": "x⁶,  y⁻³"
        },
        {
          "say": "Move y to the minus 3 below the line to make it positive.",
          "write": "8x⁶/y³",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Move y^−3 below the line",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "8x⁶y⁻³",
                "size": 40,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 325,
                "y": 40,
                "w": 90,
                "h": 55,
                "fill": "none",
                "change": "remove",
                "color": "red"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "8x⁶ / y³",
                "size": 40,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Two to the minus 3 is not minus 8. It's one eighth.",
          "write": "2⁻³ = 1/8"
        },
        {
          "say": "64 to the half is not 32. It's root 64, which is 8.",
          "write": "64^(1/2) = 8"
        },
        {
          "say": "In five x to the minus 2, only x moves. The 5 stays on top.",
          "write": "5x⁻² = 5/x²"
        },
        {
          "say": "For a power of a power, multiply. Don't add.",
          "write": "(x⁶)^(1/2) = x³"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Negative means flip, not negative.",
          "write": "a⁻ⁿ = 1/aⁿ"
        },
        {
          "say": "Root on the ground. The denominator is the root.",
          "write": "a^(m/n) = (ⁿ√a)ᵐ"
        },
        {
          "say": "Root first, power second.",
          "write": "root → power"
        },
        {
          "say": "Flip, root, power, for a negative fraction index.",
          "write": "flip → root → power"
        }
      ]
    }
  ]
}
{
  "level": "Year 10",
  "subject": "maths",
  "title": "Negative and fractional indices",
  "frames": [
    {
      "heading": "The index laws still work",
      "lines": [
        {
          "say": "Multiply powers of the same base? Add the indices.",
          "write": "aᵐ × aⁿ = aᵐ⁺ⁿ"
        },
        {
          "say": "Divide? Subtract the indices.",
          "write": "aᵐ ÷ aⁿ = aᵐ⁻ⁿ"
        },
        {
          "say": "A power of a power? Multiply the indices.",
          "write": "(aᵐ)ⁿ = aᵐⁿ"
        },
        {
          "say": "And anything to the power 0 is 1.",
          "write": "a⁰ = 1"
        },
        {
          "say": "Everything today comes from these laws."
        }
      ]
    },
    {
      "heading": "Negative indices mean one over",
      "lines": [

    {
      "heading": "The sine rule",
      "lines": [
        {
          "say": "In a complete pair, side over sine of its angle is the same for all three.",
          "write": "a/sin A = b/sin B = c/sin C"
        },
        {
          "say": "A is 40, B is 65, and a is 12. Find b.",
          "write": "A = 40°, B = 65°, a = 12",
          "diagram": "diagrams/y10/maths/the-sine-and-cosine-rules-extension-ex1.svg",
          "alt": "Triangle with A 40°, B 65°, a 12 cm"
        },
        {
          "say": "a and A are a complete pair. So b over sin 65 equals 12 over sin 40.",
          "write": "b/sin 65° = 12/sin 40°"
        },
        {
          "say": "b is 12 times sin 65, divided by sin 40. About 16.9 centimetres.",
          "write": "b ≈ 16.9 cm"
        },
        {
          "say": "Check: B is bigger than A, so b should be bigger than a.",
          "write": "b > a ✓"
        }
      ]
    },
    {
      "heading": "The cosine rule",
      "lines": [
        {
          "say": "No complete pair? Use the cosine rule. It is Pythagoras with a correction.",
          "write": "a² = b² + c² − 2bc cos A"
        },
        {
          "say": "b is 8, c is 11, and the angle between them is 50 degrees.",
          "write": "b = 8, c = 11, A = 50°",
          "diagram": "diagrams/y10/maths/the-sine-and-cosine-rules-extension-ex3.svg",
          "alt": "Triangle with sides 8 and 11 and included angle 50°"
        },
        {
          "say": "a squared is 64 plus 121, minus 176 cos 50. About 71.87.",
          "write": "a² = 185 − 176 cos 50°"
        },
        {
          "say": "Take the square root. a is about 8.5 centimetres.",
          "write": "a ≈ 8.5 cm"
        },
        {
          "say": "If A is 90 degrees, cos A is 0, and it becomes Pythagoras.",
          "write": "cos 90° = 0"
        }
      ]
    },
    {
      "heading": "Finding an angle",
      "lines": [
        {
          "say": "Sides 7, 8 and 13. The largest angle is opposite the 13.",
          "write": "cos θ = (b² + c² − a²) ÷ 2bc",
          "diagram": "diagrams/y10/maths/the-sine-and-cosine-rules-extension-ex4.svg",
          "alt": "Triangle with sides 7, 8 and 13"
        },
        {
          "say": "49 plus 64 minus 169, over 112. That is minus a half.",
          "write": "cos θ = −56/112 = −0.5"
        },
        {
          "say": "A negative cosine means obtuse. Theta is 120 degrees.",
          "write": "θ = 120°"
        },
        {
          "say": "Area is a half times 7 times 8 times sin 120. About 24.2.",
          "write": "Area = ½ab sin C ≈ 24.2 m²"
        }
      ]
    },
    {
      "heading": "The ambiguous case",
      "lines": [
        {
          "say": "Sin 50 equals sin 130. So a sine can match two angles.",
          "write": "sin θ = sin(180° − θ)"
        },
        {
          "say": "A side of 8 can swing to meet the base at two points.",
          "write": "two triangles",
          "diagram": "diagrams/y10/maths/the-sine-and-cosine-rules-extension-ambiguous.svg",
          "alt": "Side of length 8 meeting the base at B1 and B2"
        },
        {
          "say": "So test 180 minus your angle. Does it still fit?",
          "write": "test 180° − θ"
        },
        {
          "say": "a 9, b 7, A 70. Sine rule gives B about 47 degrees.",
          "write": "B ≈ 47.0°"
        },
        {
          "say": "The other option, 133, plus 70 is over 180. Impossible. Only one triangle.",
          "write": "133° + 70° > 180° ✗"
        }
      ]
    },

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "No complete pair? Then the sine rule won't work.",
          "write": "check for a pair"
        },
        {
          "say": "Don't forget the square root at the end of the cosine rule.",
          "write": "a² = 39 → a = √39"
        },
        {
          "say": "Work out 2bc cos A first, then subtract it all.",
          "write": "b² + c² − (2bc cos A)"
        },
        {
          "say": "The angle in the area rule must be between the two sides.",
          "write": "included angle"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Sine rule needs a matched pair.",
          "write": "a/sin A = b/sin B"
        },
        {
          "say": "Cosine rule is Pythagoras with a correction.",
          "write": "a² = b² + c² − 2bc cos A"
        },
        {
          "say": "Area of any triangle is a half a b sin C.",
          "write": "½ab sin C"
        },
        {
          "say": "Always test 180 minus the angle from a sine rule.",
          "write": "ambiguous case"
        }
      ]

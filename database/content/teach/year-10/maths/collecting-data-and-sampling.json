    {
      "heading": "Simple random and systematic",
      "lines": [
        {
          "say": "Simple random means everyone has the same chance. Like names from a hat.",
          "write": "simple random"
        },
        {
          "say": "Systematic means list everyone, start randomly, then take every k-th one.",
          "write": "systematic",
          "diagram": "diagrams/y10/maths/collecting-data-and-sampling-sys.svg",
          "alt": "40 dots with every 5th one from 3 filled"
        },
        {
          "say": "The interval k is population divided by sample size.",
          "write": "k = population ÷ sample"
        },
        {
          "say": "840 gym members, sample of 30. So k is 28.",
          "write": "k = 840 ÷ 30 = 28"
        },
        {
          "say": "Start at 11, then keep adding 28.",
          "write": "11, 39, 67, 95, …"
        }
      ]
    },
    {
      "heading": "Stratified samples",
      "lines": [
        {
          "say": "Split the population into groups called strata. Like layers of rock.",
          "write": "strata = layers"
        },
        {

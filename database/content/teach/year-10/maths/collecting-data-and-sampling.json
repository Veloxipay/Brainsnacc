    {
      "heading": "Estimating for the population",
      "lines": [
        {
          "say": "80 students were asked about a food truck. 28 said yes.",
          "diagram": "diagrams/y10/maths/collecting-data-and-sampling-ex3.svg",
          "alt": "Column graph: Yes 28, No 40, Unsure 12"
        },
        {
          "say": "Twenty eight out of 80 is 0.35.",
          "write": "28 ÷ 80 = 0.35"
        },
        {
          "say": "Use the same fraction for all 1500 students.",
          "write": "0.35 × 1500 = 525"
        },
        {
          "say": "So about 525 students would say yes. It is only an estimate.",
          "write": "about 525"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Divide population by sample. k should be bigger than 1.",
          "write": "k = big ÷ small"
        },
        {
          "say": "Give each group a share that matches its size."
        },
        {
          "say": "Say about, not exactly. Another sample would differ."
        },
        {
          "say": "Do not just ask your friends. Use a random method."
        }
      ]
    },

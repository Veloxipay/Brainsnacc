        },
        {
          "say": "Leading questions push towards an answer.",
          "write": "Leading question"
        },
        {
          "say": "Voluntary samples, like online polls, attract strong opinions.",
          "write": "Voluntary"
        },
        {
          "say": "A huge sample can still be biased. Check how it was chosen.",
          "write": "SNLV"
        }

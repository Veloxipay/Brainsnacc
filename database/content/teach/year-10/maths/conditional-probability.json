    {
      "heading": "From a two-way table",
      "lines": [
        {
          "say": "Eighty students, by year level and how they travel.",
          "diagram": "diagrams/y10/maths/conditional-probability-ex1.svg",
          "alt": "Two-way table of 80 students: walk or bus by Year 9 and Year 10, Year 10 row shaded"
        },
        {
          "say": "Given Year 10, use only that row. Forty students.",
          "write": "row total 40"
        },
        {
          "say": "Twenty one of them walk.",
          "write": "P(walks | Year 10) = 21/40"
        },
        {
          "say": "Given walks, use the walk column. Thirty five students.",
          "write": "P(Year 10 | walks) = 21/35"
        },
        {
          "say": "Divide by the total of the given group, not the grand total."
        }
      ]
    },
    {
      "heading": "The formula",
      "lines": [
        {
          "say": "Both, divided by the given.",
          "write": "P(A | B) = P(A ∩ B) ÷ P(B)"
        },
        {
          "say": "P of A is 0.6. P of A and B is 0.24. Find P of B given A.",
          "write": "0.24 ÷ 0.6 = 0.4"
        },
        {
          "say": "Check by multiplying back. 0.6 times 0.4 is 0.24.",
          "write": "0.6 × 0.4 = 0.24 ✓"
        },
        {
          "say": "That is the multiplication rule. It is how tree diagrams work.",
          "write": "P(A ∩ B) = P(B) × P(A | B)"
        },
        {
          "say": "Rain is 0.3. Late given rain is 0.6. Both is 0.18.",
          "write": "0.3 × 0.6 = 0.18"
        }
      ]
    },
    {
      "heading": "Two dice",
      "lines": [
        {
          "say": "Roll two dice. You are told the sum is 8.",
          "write": "sum = 8"
        },
        {
          "say": "Only 5 cells have a sum of 8. That is the new total.",
          "write": "5 outcomes",
          "diagram": "diagrams/y10/maths/conditional-probability-ex4.svg",
          "alt": "6 by 6 grid of dice sums with the five 8s shaded"
        },
        {
          "say": "Only 4 and 4 is a double. So 1 out of 5.",
          "write": "P(double | 8) = 1/5"
        },
        {
          "say": "Without the condition it was 1 in 6. Knowing changed it.",
          "write": "1/6 → 1/5"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Dividing by the grand total gives A and B, not A given B."
        },
        {
          "say": "The event after the bar is the one you divide by."
        },
        {
          "say": "Divide, do not multiply.",
          "write": "both ÷ given"
        },
        {
          "say": "After a condition, count only inside it."
        }
      ]
    },

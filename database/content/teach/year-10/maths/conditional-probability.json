  "title": "Conditional probability",
  "frames": [
    {
      "heading": "What given means",
      "lines": [
        {
          "say": "A random person being a pro basketballer? Tiny chance."
        },
        {
          "say": "Now you learn they are 2.1 metres tall. The chance jumps."
        },
        {
          "say": "The probability of A given B. The bar means given that.",
          "write": "P(A | B)"
        },
        {
          "say": "We know B happened. So only outcomes in B are possible.",
          "write": "reduced sample space"
        }
      ]
    },

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Never use binary search on an unsorted list. Sort first, or search linearly.",
          "write": "✗ binary on unsorted"
        },
        {
          "say": "Round the middle position down, using the low plus high rule.",
          "write": "(low + high) ÷ 2, round down"
        },
        {
          "say": "After checking the middle, discard it too. Start one place past it.",
          "write": "discard the middle"
        },
        {
          "say": "In bubble sort, move one pair at a time. Write the list after each swap.",
          "write": "one pair at a time"
        },
        {
          "say": "Bubble swaps neighbours. Selection moves the smallest to the front.",
          "write": "bubble ≠ selection"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Halve it, don't crawl it. Binary halves, linear crawls.",
          "write": "halve it, don't crawl it"
        },
        {
          "say": "Two to the ten is about a thousand. Two to the twenty, about a million.",
          "write": "2¹⁰ ≈ 1000, 2²⁰ ≈ 1 000 000"
        },
        {
          "say": "Bubbles rise: the biggest value floats to the end each pass.",
          "write": "bubbles rise"
        },
        {
          "say": "Selection means select the smallest, then put it at the front.",
          "write": "select the smallest"
        },
        {
          "say": "Both sorts need about n times n minus 1, over 2 comparisons.",
          "write": "n(n − 1) ÷ 2"
        }
      ]
    }

{
  "level": "Year 10",
  "subject": "maths",
  "title": "Factorising non-monic quadratics",
  "frames": [
    {
      "heading": "Monic or non-monic?",
      "lines": [
        {
          "say": "In a x squared plus b x plus c, a is the leading coefficient.",
          "write": "ax² + bx + c"
        },
        {
          "say": "If a is 1, it's monic. If not, it's non-monic.",
          "write": "a ≠ 1 → non-monic"
        },
        {
          "say": "In two x squared plus seven x plus 3, a is 2, b is 7, c is 3.",
          "write": "a = 2, b = 7, c = 3"
        },
        {
          "say": "Non-monic needs a new method. We call it the a c method.",
          "write": "the ac method"
        }
      ]
    },
    {
      "heading": "The ac method",
      "lines": [
        {
          "say": "Step 1. Take out any common factor first.",
          "write": "1. HCF first"
        },
        {
          "say": "Step 2. Multiply a times c.",
          "write": "2. a × c"
        },
        {
          "say": "Step 3. Find two numbers that multiply to a c and add to b.",
          "write": "3. × to ac,  + to b"
        },
        {
          "say": "Step 4. Split the middle term into two terms.",
          "write": "4. split bx"
        },
        {
          "say": "Step 5. Group in pairs, and factorise each pair.",
          "write": "5. group in pairs"
        },
        {
          "say": "Step 6. Take out the common bracket.",
          "write": "6. take out the bracket"
        }
      ]
    },
    {
      "heading": "Why it works",
      "lines": [

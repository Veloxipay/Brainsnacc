                "bold": true
              },
              {
                "kind": "text",
                "x": 390,
                "y": 140,
                "text": "+ 1(x + 3)",
                "size": 28,
                "color": "orange",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Both pairs share x plus 3. Take it out.",
          "write": "(x + 3)(2x + 1)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Grouping the four terms in pairs",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "2x² + 6x  +  x + 3",
                "size": 30,

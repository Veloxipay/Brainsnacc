              }
            ]
          }
        },
        {
          "say": "Expand to check. You get two x squared plus seven x plus 3.",
          "write": "2x² + x + 6x + 3 ✓"
        }
      ]
    },
    {
      "heading": "With negative signs",
      "lines": [
        {
          "say": "Factorise six x squared minus eleven x plus 4.",
          "write": "6x² − 11x + 4"
        },
        {
          "say": "a c is 24. We need a sum of minus 11. Minus 3 and minus 8.",
          "write": "−3 × −8 = 24,  −3 + −8 = −11"
        },
        {
          "say": "Split and group.",
          "write": "3x(2x − 1) − 4(2x − 1)"
        },
        {
          "say": "Take out minus 4 from the second pair so the brackets match.",
          "write": "same bracket: (2x − 1)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Take out −4 so the brackets match",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 50,
                "w": 220,
                "h": 70,
                "fill": "blue",
                "label": "3x(2x − 1)"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 50,
                "w": 220,
                "h": 70,
                "fill": "red",
                "label": "+4(−2x + 1)"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 170,
                "w": 220,
                "h": 70,
                "fill": "green",
                "change": "add",
                "label": "− 4(2x − 1)"
              },
              {
                "kind": "arrow",
                "x": 410,
                "y": 125,
                "x2": 410,
                "y2": 165,
                "color": "green",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 150,
                "y": 210,
                "text": "brackets must match",
                "size": 18,
                "color": "purple",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "The answer is two x minus 1, times three x minus 4.",
          "write": "(2x − 1)(3x − 4)"
        }
      ]
    },
    {
      "heading": "Common factors and special patterns",
      "lines": [
        {
          "say": "HCF first. Twelve x squared plus six x minus 18 has a common 6.",
          "write": "6(2x² + x − 3)"
        },
        {
          "say": "Then factorise the bracket. Keep the 6 at the front.",
          "write": "6(2x + 3)(x − 1)"
        },
        {
          "say": "If a is negative, take out minus 1 first.",
          "write": "−(...)"
        },
        {
          "say": "Difference of two squares still works.",
          "write": "9x² − 25 = (3x − 5)(3x + 5)"
        },
        {
          "say": "So does a perfect square.",
          "write": "4x² − 12x + 9 = (2x − 3)²"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Use a times c, not just c. For three x squared plus 14 x plus 8, use 24.",
          "write": "ac = 24, not 8"
        },
        {
          "say": "If the brackets don't match after grouping, check your signs.",
          "write": "both brackets identical"
        },
        {
          "say": "Don't drop the HCF or the minus 1 from the final answer."
        },
        {
          "say": "Always expand to check the middle term.",
          "write": "(2x + 1)(x + 3) ≠ (2x + 3)(x + 1)"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "AC, split, group, pull out.",
          "write": "AC → split → group → pull out"
        },
        {
          "say": "After grouping, both brackets must be the same.",
          "write": "same jersey test"
        },
        {
          "say": "HCF first. Smaller numbers make the search easier.",
          "write": "HCF first"
        },
        {
          "say": "Expand to check. The middle term must match exactly.",
          "write": "Expand to check ✓"
        }
      ]
    }
  ]
}
              }
            ]
          }
        },
        {
          "say": "So the strips are the two numbers that multiply to a c, and add to b.",
          "write": "6 × 1 = 6,  6 + 1 = 7"
        }
      ]
    },
    {
      "heading": "Worked example",
      "lines": [
        {
          "say": "a times c is 2 times 3, which is 6.",
          "write": "ac = 6"
        },
        {
          "say": "Six and one multiply to 6 and add to 7.",
          "write": "6 and 1"
        },
        {
          "say": "Split seven x into six x plus x.",
          "write": "2x² + 6x + x + 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Split the middle term",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "2x² + 7x + 3",
                "size": 32,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 180,
                "text": "2x² + 6x + x + 3",
                "size": 32,
                "color": "purple",
                "change": "add",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 100,
                "x2": 280,
                "y2": 145,
                "color": "green",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Group in pairs. Take two x from the first pair, and 1 from the second.",
          "write": "2x(x + 3) + 1(x + 3)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Grouping the four terms in pairs",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "2x² + 6x  +  x + 3",
                "size": 30,
                "color": "black",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 105,
                "y": 25,
                "w": 190,
                "h": 50,
                "fill": "none",
                "change": "add",
                "color": "blue"
              },
              {
                "kind": "rect",
                "x": 325,
                "y": 25,
                "w": 130,
                "h": 50,
                "fill": "none",
                "change": "add",
                "color": "orange"
              },
              {
                "kind": "text",
                "x": 200,

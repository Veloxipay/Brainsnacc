{
  "level": "Year 10",
  "subject": "maths",
  "title": "Circle properties: angles and chords",
  "frames": [
    {
      "heading": "Parts of a circle",
      "lines": [
        {
          "say": "A chord joins two points on the circle.",
          "write": "chord"
        },
        {
          "say": "A diameter is a chord through the centre, O.",
          "write": "diameter"
        },
        {
          "say": "An arc is part of the circumference. A chord splits the circle into segments.",
          "write": "arc, segment"
        },
        {
          "say": "Every radius is the same length. Two radii make an isosceles triangle.",
          "write": "radii equal → isosceles"
        }
      ]
    },
    {
      "heading": "Angle at the centre",
      "lines": [
        {
          "say": "Join the ends of an arc to the centre, and to a point on the circle.",
          "diagram": "diagrams/y10/maths/circle-properties-angles-and-chords-centre.svg",
          "alt": "Angle theta at C and angle 2 theta at the centre O on the same arc"
        },
        {
          "say": "The angle at the centre is twice the angle at the circumference.",
          "write": "∠AOB = 2 × ∠ACB"
        },
        {
          "say": "Here the centre angle is 130 degrees. Both stand on arc AB.",
          "diagram": "diagrams/y10/maths/circle-properties-angles-and-chords-ex1.svg",
          "alt": "Angle AOB 130 degrees and angle ACB x"
        },
        {
          "say": "So x is half of 130. That is 65 degrees.",
          "write": "x = 130° ÷ 2 = 65°"
        },
        {
          "say": "Centre is double. Circumference is half."
        }
      ]
    },
    {
      "heading": "Same segment and semicircle",
      "lines": [
        {
          "say": "Angles standing on the same arc are equal.",
          "write": "same segment: equal"
        },
        {
          "say": "They look like a bow tie. Bow tie angles match.",
          "write": "bow-tie angles match"
        },
        {
          "say": "If AB is a diameter, the centre angle is 180 degrees.",
          "diagram": "diagrams/y10/maths/circle-properties-angles-and-chords-semi.svg",
          "alt": "AB is a diameter and angle ACB is a right angle"
        },
        {
          "say": "Half of 180 is 90. The angle in a semicircle is a right angle.",
          "write": "angle in semicircle = 90°"
        },
        {
          "say": "Angle CAB is 34. So angle ABC is 180 take 90 take 34.",
          "write": "∠ABC = 56°"
        }
      ]
    },
    {
      "heading": "Cyclic quadrilaterals",
      "lines": [
        {
          "say": "All four corners of this quadrilateral sit on the circle.",
          "diagram": "diagrams/y10/maths/circle-properties-angles-and-chords-cyclic.svg",
          "alt": "Cyclic quadrilateral with opposite angles a and 180 minus a"
        },
        {
          "say": "Opposite angles add to 180 degrees.",
          "write": "A + C = 180°"
        },
        {
          "say": "Three x plus 10, plus two x take 5, equals 180.",
          "write": "(3x + 10) + (2x − 5) = 180"
        },
        {
          "say": "Five x plus 5 is 180. So x is 35.",
          "write": "x = 35"
        },
        {
          "say": "Angle A is 115. Angle C is 65. They add to 180.",
          "write": "115° + 65° = 180° ✓"
        }
      ]
    },

    {
      "heading": "Denominators like c√b",
      "lines": [
        {
          "say": "Now 5 over 2 root 10.",
          "write": "5/(2√10)"
        },
        {
          "say": "Multiply top and bottom by root 10 only. Not by 2 root 10.",
          "write": "× √10/√10",
          "draw": {
            "type": "shapes",

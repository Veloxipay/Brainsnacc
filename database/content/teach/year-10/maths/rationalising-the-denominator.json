              }
            ]
          }
        },
        {
          "say": "The bottom is 2 times 10, which is 20.",
          "write": "5√10/20"
        },
        {
          "say": "Cancel the 5 into the 20. The answer is root 10 over 4.",
          "write": "= √10/4"
        },
        {
          "say": "Always cancel at the end.",
          "write": "tidy up"
        }
      ]
    },
    {
      "heading": "Where these come from",
      "lines": [
        {
          "say": "A square has a diagonal of 6 centimetres. How long is each side?",
          "diagram": "diagrams/y10/maths/rationalising-the-denominator-square.svg",
          "alt": "Square with side s and diagonal 6 cm"
        },
        {
          "say": "Pythagoras gives s squared plus s squared equals 36.",
          "write": "s² + s² = 36"
        },
        {
          "say": "So s is 6 over root 2.",
          "write": "s = 6/√2"
        },
        {
          "say": "Rationalise. 6 root 2 over 2 is 3 root 2.",
          "write": "s = 3√2 cm"
        },
        {
          "say": "A rectangle with area 10 and width root 5 has length 10 over root 5. That's 2 root 5.",
          "write": "10/√5 = 2√5 cm"
        }
      ]
    },
    {
      "heading": "Binomial denominators",
      "lines": [
        {
          "say": "For a bottom like 3 minus root 5, use its conjugate.",
          "write": "4/(3 − √5)"
        },
        {
          "say": "The conjugate flips the sign. It's 3 plus root 5.",
          "write": "× (3 + √5)/(3 + √5)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Multiplying a fraction by a surd over itself",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 90,
                "text": "4",
                "size": 36,
                "color": "black",
                "bold": true
              },
              {
                "kind": "line",
                "x": 80,
                "y": 110,
                "x2": 200,
                "y2": 110,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 155,
                "text": "3 − √5",
                "size": 36,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 240,
                "y": 130,
                "text": "×",
                "size": 30,
                "color": "green",
                "change": "add",
                "bold": true
              },
              {
                "kind": "text",
                "x": 320,
                "y": 90,
                "text": "3 + √5",
                "size": 36,
                "color": "green",
                "change": "add",
                "bold": true
              },
              {
                "kind": "line",
                "x": 280,
                "y": 110,
                "x2": 360,
                "y2": 110,
                "color": "green",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 320,
                "y": 155,
                "text": "3 + √5",
                "size": 36,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "The bottom becomes 9 minus 5, which is 4. No surd.",
          "write": "(3 − √5)(3 + √5) = 4"
        },
        {
          "say": "The top is 4 times 3 plus root 5. Cancel the 4s.",
          "write": "= 3 + √5"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Multiply top and bottom, not just the bottom.",
          "write": "top AND bottom"
        },
        {
          "say": "Root 3 times root 3 is 3. Not 9.",
          "write": "√3 × √3 = 3"
        },
        {
          "say": "For 3 minus root 5, multiply by 3 plus root 5. Flip the sign.",
          "write": "conjugate: flip the sign"
        },
        {
          "say": "Don't forget to cancel.",
          "write": "6√3/3 → 2√3"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Times by itself, over itself.",
          "write": "× √b/√b"
        },
        {
          "say": "Root times root gives the number.",
          "write": "√b × √b = b"
        },
        {
          "say": "Flip the sign for binomials.",
          "write": "a − √b → a + √b"
        },
        {
          "say": "Check with a calculator. Both forms give the same decimal.",
          "write": "same decimal ✓"
        }
      ]
    }
  ]
}
{
  "level": "Year 10",
  "subject": "maths",
  "title": "Algebraic expressions and expanding",
  "frames": [
    {
      "heading": "Terms and like terms",
      "lines": [
        {
          "say": "A term is a number, a pronumeral, or both multiplied together.",
          "write": "5,  x,  −3ab,  4x²"
        },
        {
          "say": "The number in front is the coefficient.",
          "write": "coefficient"
        },
        {
          "say": "Like terms have exactly the same letters and powers.",
          "write": "3x² and −7x²: like"
        },
        {
          "say": "Three x squared and three x are not like terms.",
          "write": "3x² and 3x: not like"
        },
        {
          "say": "Each term owns the sign in front of it.",
          "write": "5 − 3x  →  term is −3x"
        }
      ]
    },
    {
      "heading": "Simplifying",
      "lines": [
        {
          "say": "Simplify four m, take seven n, take nine m, plus two n.",
          "write": "4m − 7n − 9m + 2n"
        },
        {
          "say": "Group like terms, keeping their signs.",
          "write": "4m − 9m  and  −7n + 2n"
        },
        {
          "say": "Four take nine is minus five. So minus five m.",
          "write": "4m − 9m = −5m"
        },
        {
          "say": "Minus seven plus two is minus five. So minus five n.",
          "write": "−7n + 2n = −5n"
        },
        {
          "say": "Put them together.",
          "write": "−5m − 5n"
        }
      ]
    },
    {
      "heading": "Multiplying and dividing terms",
      "lines": [
        {
          "say": "Multiply the numbers. Then add the powers of each letter.",
          "write": "2a³b × 5ab² = 10a⁴b³"
        },
        {
          "say": "a cubed times a is a to the four. b times b squared is b cubed.",
          "write": "a³ × a = a⁴"
        },
        {
          "say": "To divide, divide the numbers and subtract the powers.",
          "write": "12x³y ÷ 4xy = 3x²"
        },
        {
          "say": "b on its own means b to the power one.",
          "write": "b × b³ = b⁴"
        }
      ]
    },
    {
      "heading": "Expanding one bracket",
      "lines": [
        {
          "say": "Multiply the outside term by every term inside.",
          "write": "a(b + c) = ab + ac"

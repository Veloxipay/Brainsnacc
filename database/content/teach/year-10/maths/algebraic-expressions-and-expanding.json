          "say": "Multiply every term, not just the first.",
          "write": "✗ 4(3x − 5) = 12x − 5"
        },
        {
          "say": "Minus three times minus four is plus twelve.",
          "write": "−3(x − 4) = −3x + 12"
        },
        {
          "say": "Six x plus eight is not fourteen x.",
          "write": "✗ 6x + 8 = 14x"
        },
        {
          "say": "Do not just multiply firsts and lasts. You need the middle terms.",
          "write": "✗ (x+3)(x+5) = x² + 15"
        }
      ]

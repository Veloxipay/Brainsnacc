          "write": "−3(2x − 4) = −6x + 12"
        },
        {
          "say": "Expand every bracket first. Then collect like terms.",
          "write": "3(2x − 5) − 4(x − 2)"
        },
        {
          "say": "Six x take fifteen, take four x, plus eight. That is two x take seven.",
          "write": "= 2x − 7"
        }
      ]

{
  "level": "Year 10",
  "subject": "maths",
  "title": "Average rate of change",
  "frames": [
    {
      "heading": "What is a rate of change?",
      "lines": [
        {
          "say": "A rate compares how much one thing changes with another.",
          "write": "rate of change"
        },
        {
          "say": "The units say per. Metres per second, litres per minute.",
          "write": "m/s,  L/min,  $ per item"
        },
        {
          "say": "On a straight line, the rate is the gradient. Same everywhere.",
          "write": "rate = gradient"
        },
        {
          "say": "On a curve, the steepness keeps changing."
        }
      ]
    },

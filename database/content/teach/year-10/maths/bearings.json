    {
      "heading": "Compass bearings",
      "lines": [
        {
          "say": "A compass bearing starts at N or S, then turns to E or W.",
          "write": "N30°E,  S55°E"
        },
        {
          "say": "125 degrees is 55 past south, towards east. So S 55 E.",
          "write": "180° − 125° = 55° → S55°E",
          "diagram": "diagrams/y10/maths/bearings-key.svg",
          "alt": "Line at 125 degrees true, which is 55 degrees east of south"
        },
        {
          "say": "N 30 W is 30 degrees back from north. Three sixty take thirty.",
          "write": "N30°W = 330°T"
        },
        {
          "say": "Compass bearings never go past 90 degrees."
        }
      ]
    },
    {
      "heading": "Reverse bearings",
      "lines": [
        {
          "say": "Bearing of B from A means stand at A. From means feet.",
          "write": "from = feet"
        },
        {
          "say": "B from A is 070. Now stand at B and look back at A.",
          "write": "070°T"
        },
        {
          "say": "Under 180, so add 180. A from B is 250.",
          "write": "070° + 180° = 250°T"
        },
        {
          "say": "Over 180? Subtract 180 instead.",
          "write": "± 180°"
        }
      ]
    },
    {
      "heading": "Bearings make triangles",
      "lines": [
        {
          "say": "A ship sails 40 kilometres on a bearing of 050.",
          "diagram": "diagrams/y10/maths/bearings-ex2.svg",
          "alt": "Ship sails 40 km on 050 degrees with north and east parts dashed"
        },
        {
          "say": "Drop dashed lines north and east. Now there is a right triangle."
        },
        {
          "say": "North is adjacent to 50 degrees. Forty cos 50 is about 25.71.",
          "write": "n = 40 cos 50° ≈ 25.71 km"
        },
        {
          "say": "East is opposite. Forty sin 50 is about 30.64.",
          "write": "e = 40 sin 50° ≈ 30.64 km"
        }
      ]
    },
    {
      "heading": "Finding a bearing",
      "lines": [
        {
          "say": "A hiker walks 6 kilometres east, then 4 kilometres south.",
          "diagram": "diagrams/y10/maths/bearings-ex3.svg",
          "alt": "6 km east then 4 km south, angle theta below east"
        },
        {
          "say": "Tan theta is four over six. Theta is about 33.69 degrees.",
          "write": "θ = tan⁻¹(4/6) ≈ 33.69°"
        },
        {
          "say": "East is 90. Add theta to get about 124.",
          "write": "90° + 33.69° → 124°T"
        },
        {
          "say": "Boat legs at 035 and 125 differ by 90. So the turn is a right angle.",
          "write": "125° − 35° = 90°",
          "diagram": "diagrams/y10/maths/bearings-ex4.svg",
          "alt": "Boat sails 12 km on 035 then 9 km on 125, right angle at B"
        },
        {
          "say": "Pythagoras gives 15 kilometres. Add theta to 35 to get 072.",
          "write": "15 km on 072°T"
        }
      ]
    },
    {
      "heading": "Watch out for these",

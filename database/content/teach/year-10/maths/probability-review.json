                "text": "actual",
                "size": 18,
                "color": "black",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "That's close to 0.25, but not equal. Results vary by chance.",
          "write": "0.31 ≈ 0.25"
        },
        {
          "say": "With more trials, relative frequency usually gets closer."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Want over all, when outcomes are equally likely.",
          "write": "P = want ÷ all"
        },
        {
          "say": "Not means 1 minus.",
          "write": "P(A′) = 1 − P(A)"
        },
        {
          "say": "Two dice? Draw the 6 by 6 grid. Spinner? Think degrees.",
          "write": "36 cells,  angle ÷ 360°"
        },
        {
          "say": "Expected equals P times trials.",
          "write": "P × trials"
        }
      ]
    }

    {
      "heading": "Outcomes, sample space and events",
      "lines": [
        {
          "say": "An outcome is one possible result, like rolling a 4.",
          "write": "outcome"
        },
        {
          "say": "The sample space lists all outcomes. For one die, 1 to 6.",
          "write": "S = {1, 2, 3, 4, 5, 6}"
        },
        {
          "say": "An event is a group of outcomes, like an even number.",
          "write": "even = {2, 4, 6}"
        },
        {
          "say": "When outcomes are equally likely, probability is want over all.",
          "write": "P = want ÷ all"
        },
        {
          "say": "Every probability is between 0, impossible, and 1, certain.",
          "write": "0 ≤ P ≤ 1"
        }
      ]
    },

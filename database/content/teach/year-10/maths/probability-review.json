      "heading": "Expected number and relative frequency",
      "lines": [
        {
          "say": "Expected number is probability times the number of trials.",
          "write": "expected = P × trials"
        },
        {
          "say": "Spin 200 times. A quarter of 200 is 50 blues.",
          "write": "1/4 × 200 = 50"
        },
        {
          "say": "Blue actually came up 62 times. Relative frequency is 62 over 200.",
          "write": "62 ÷ 200 = 0.31",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Expected 50 against actual 62",
            "items": [
              {
                "kind": "rect",

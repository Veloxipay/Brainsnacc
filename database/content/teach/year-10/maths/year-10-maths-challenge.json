    {
      "heading": "How to use this challenge",
      "lines": [
        {
          "say": "This challenge mixes every topic from the year, like a real test.",
          "write": "mixed Year 10 test"
        },
        {
          "say": "Give yourself 60 minutes. Calculator allowed, in degree mode.",
          "write": "60 min, DEG mode"
        },
        {
          "say": "Mark each correct step, not just the final answer.",
          "write": "marks for steps"
        },
        {
          "say": "80 percent or more is excellent. Under 60, revise and try again.",
          "write": "80% + excellent"
        }
      ]
    },

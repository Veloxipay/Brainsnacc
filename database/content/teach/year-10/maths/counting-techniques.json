    {
      "heading": "Counting and probability",
      "lines": [
        {
          "say": "Probability is ways it happens divided by total ways.",
          "write": "P = ways ÷ total"
        },
        {
          "say": "PINs with repeats allowed. Ten times ten times ten times ten.",
          "write": "10⁴ = 10 000"
        },
        {
          "say": "No repeats. Count down. Ten, nine, eight, seven.",
          "write": "10 × 9 × 8 × 7 = 5040"
        },
        {
          "say": "So the probability of no repeats is 0.504.",
          "write": "5040 ÷ 10 000 = 0.504"

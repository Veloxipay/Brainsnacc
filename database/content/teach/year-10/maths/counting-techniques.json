      "heading": "The multiplication principle",
      "lines": [
        {
          "say": "A 4 digit PIN has 10 000 options. Too many to list."
        },
        {
          "say": "Three mains, and then two drinks. Each main branches into two.",
          "write": "3 × 2 = 6",
          "diagram": "diagrams/y10/maths/counting-techniques-menu.svg",
          "alt": "Tree of 3 mains each branching into 2 drinks, 6 meals"
        },
        {
          "say": "So there are 6 meal deals."
        },
        {
          "say": "Add four desserts. Six times four is 24.",
          "write": "6 × 4 = 24"
        },
        {
          "say": "And then means times. Three shirts and four pants make 12, not 7.",
          "write": "and then → ×"
        }
      ]
    },

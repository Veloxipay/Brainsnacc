    {
      "heading": "Writing a comparison",
      "lines": [
        {
          "say": "Name both groups, give the numbers, say what they mean.",
          "write": "middle and spread, then what it said"
        },
        {
          "say": "Class B's median, 29.5, is higher than Class R's, 23.5.",
          "write": "29.5 > 23.5"
        },
        {
          "say": "So Class B generally scored higher.",
          "write": "in context"
        },
        {
          "say": "Don't compare just the single highest score. One person isn't a group.",
          "write": "✗ highest only"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A bigger range isn't better. It just means more spread out.",
          "write": "bigger range ≠ better"
        },
        {
          "say": "Same mean doesn't mean same data. Check the spread.",
          "write": "same mean ≠ same data"
        },
        {
          "say": "Different group sizes? Add totals, then divide by the total count.",
          "write": "total ÷ total count"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Compare a centre and a spread.",
          "write": "centre + spread"
        },
        {
          "say": "Small range means steady, consistent data.",
          "write": "small range = steady"
        },
        {
          "say": "Outliers push the mean, not the median.",
          "write": "outlier → median"
        },
        {
          "say": "Back-to-back plots: read both sides from the stem out.",
          "write": "stem out"
        }
      ]
    }
  ]

                "size": 20,
                "color": "green",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Skim only the oily top, and you get the wrong idea.",
          "write": "biased!",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A pot of soup: a stirred spoonful represents the pot; skimming the top does not",
            "items": [
              {

                "y": 280,
                "text": "pot of soup = population",
                "size": 18,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 160,
                "y": 100,
                "w": 240,
                "h": 20,
                "fill": "yellow",

              },
              {
                "kind": "circle",
                "x": 280,
                "y": 175,
                "r": 22,
                "fill": "yellow",
                "label": "taste",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 60,
                "text": "stirred: one spoon tells you",
                "size": 20,
                "color": "green",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Census means count everyone.",
          "write": "census = everyone"
        },
        {
          "say": "Bigger is better, but only if it's fair.",
          "write": "fair first, then big"
        },
        {
          "say": "Estimate equals sample fraction times population.",
          "write": "fraction × population"
        }
      ]

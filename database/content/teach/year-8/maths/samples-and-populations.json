                "color": "red",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Stirring is like choosing a sample at random.",
          "write": "random = stirred"
        }
      ]
    },
    {
      "heading": "Census or sample?",
      "lines": [
        {
          "say": "The population is the whole group you want to know about.",
          "write": "population = everyone"
        },
        {
          "say": "A census asks every member. Exact, but slow and expensive.",
          "write": "census = count everyone"
        },
        {
          "say": "A sample asks only part. Quicker, but it gives an estimate.",
          "write": "sample → estimate"
        },
        {
          "say": "Australia runs a census every five years.",
          "write": "census every 5 years"
        }
      ]
    },
    {
      "heading": "Ways to choose a sample",
      "lines": [
        {
          "say": "Simple random. Everyone has the same chance, like names from a hat.",
          "write": "simple random"
        },
        {
          "say": "Systematic. 40 people, sample of 5, so the step is 40 over 5, which is 8.",
          "write": "40 ÷ 5 = 8"
        },
        {
          "say": "Pick a random start, say 3. Then take every 8th person.",
          "write": "3, 11, 19, 27, 35",
          "diagram": "diagrams/y8/maths/samples-and-populations-systematic.svg",
          "alt": "40 people numbered 1 to 40; starting at 3, every 8th person is shaded: 3, 11, 19, 27, 35"
        },
        {
          "say": "Convenience. Ask whoever is easy, like your friends. Often biased.",
          "write": "convenience → biased"
        }
      ]
    },
    {
      "heading": "Stratified samples",
      "lines": [

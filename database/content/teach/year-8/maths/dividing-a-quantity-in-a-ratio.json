    {
      "heading": "Answers that aren't whole",
      "lines": [
        {
          "say": "Share 50 kilograms of soil in the ratio 3 to 5.",
          "write": "50 kg in 3 : 5"
        },
        {
          "say": "8 parts. One part is 6.25 kilograms. Don't round yet.",
          "write": "50 ÷ 8 = 6.25"
        },
        {
          "say": "The beds get 18.75 and 31.25 kilograms.",
          "write": "18.75 kg and 31.25 kg"
        },
        {
          "say": "They add back to 50. Round only at the end.",
          "write": "18.75 + 31.25 = 50 ✓"
        }
      ]
    },

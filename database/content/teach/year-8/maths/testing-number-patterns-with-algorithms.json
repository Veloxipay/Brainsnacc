    {
      "heading": "Finding the position rule",
      "lines": [
        {
          "say": "The rule is difference times position, plus first term take difference.",
          "write": "term = d × position + (first − d)"
        },
        {
          "say": "Here the difference is 5. First term take 5 is minus 2.",
          "write": "3 − 5 = −2"
        },
        {
          "say": "So the rule is 5 times position, take 2.",
          "write": "term = 5 × position − 2"
        },
        {
          "say": "Check position 6. 5 times 6 take 2 is 28.",
          "write": "5 × 6 − 2 = 28 ✓",
          "draw": {

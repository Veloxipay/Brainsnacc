    {
      "heading": "Testing a conjecture",
      "lines": [
        {
          "say": "A conjecture is something you think is true, but haven't proved.",
          "write": "conjecture"
        },
        {
          "say": "Conjecture: n squared take n plus 11 is always prime.",
          "write": "n² − n + 11 always prime?"
        },
        {
          "say": "An algorithm loops through n equals 1, 2, 3, and tests each value.",
          "diagram": "diagrams/y8/maths/testing-number-patterns-with-algorithms-tester.svg",
          "alt": "Flowchart that loops while the value is prime and outputs n when it is not"
        },
        {
          "say": "n from 1 to 10 all give primes. 11, 13, 17, up to 101.",
          "write": "11, 13, 17, … 101  all prime",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Ten primes in a row",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 60,
                "w": 95,
                "h": 60,
                "fill": "green",
                "label": "11"
              },
              {
                "kind": "rect",
                "x": 125,
                "y": 60,
                "w": 95,
                "h": 60,
                "fill": "green",
                "label": "13"
              },
              {

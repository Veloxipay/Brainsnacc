                "y": 60,
                "w": 95,
                "h": 60,
                "fill": "green",
                "label": "17"
              },
              {
                "kind": "rect",
                "x": 335,
                "y": 60,
                "w": 95,
                "h": 60,
                "fill": "green",
                "label": "23"
              },
              {
                "kind": "rect",
                "x": 440,
                "y": 60,
                "w": 95,
                "h": 60,
                "fill": "green",
                "label": "31"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 180,
                "text": "… 41, 53, 67, 83, 101",
                "size": 24,
                "color": "green"
              }
            ]
          }
        },

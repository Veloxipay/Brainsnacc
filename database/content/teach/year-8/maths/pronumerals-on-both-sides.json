                "label": "x"
              },
              {
                "kind": "rect",
                "x": 110,
                "y": 120,
                "w": 34,
                "h": 44,
                "fill": "yellow",
                "label": "x"
              },
              {
                "kind": "rect",
                "x": 150,
                "y": 120,
                "w": 34,
                "h": 44,
                "fill": "yellow",
                "label": "x",
                "change": "remove"
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 120,
                "w": 34,
                "h": 44,
                "fill": "yellow",
                "label": "x",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 210,
                "text": "5x + 3 − 2x",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 310,
                "y": 120,
                "w": 34,
                "h": 44,
                "fill": "yellow",
                "label": "x",

{
  "level": "Year 8",
  "subject": "maths",
  "title": "Pronumerals on both sides",
  "frames": [
    {
      "heading": "Unknowns on both sides",
      "lines": [
        {
          "say": "Gym A charges 60 dollars to join, plus 5 a visit.",
          "write": "60 + 5v"
        },
        {
          "say": "Gym B has no joining fee, but charges 15 a visit.",
          "write": "15v"
        },
        {
          "say": "When do they cost the same? Now v is on both sides.",
          "write": "60 + 5v = 15v"
        },
        {
          "say": "The plan: collect the pronumerals on one side first.",
          "write": "letters to one side"
        }
      ]
    },
    {
      "heading": "Bags of marbles",
      "lines": [
        {
          "say": "5 bags and 3 marbles balance 2 bags and 18 marbles.",
          "write": "5x + 3 = 2x + 18",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 5,
              "cubes": 3
            },
            "right": {
              "bags": 2,
              "cubes": 18
            }
          }
        },
        {
          "say": "Take 2 bags off each side. It still balances.",
          "write": "− 2x from both sides",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Two bags crossed off each side of the balance",
            "items": [
              {

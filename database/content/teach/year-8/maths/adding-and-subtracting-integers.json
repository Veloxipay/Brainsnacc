                "y": 160,
                "r": 30,
                "fill": "white",
                "label": "12"
              }
            ]
          }
        },
        {
          "say": "Positives: 28 plus 6 is 34. Negatives: 15, 9 and 12 make 36.",
          "write": "34 vs 36",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Pile totals",
            "items": [
              {
                "kind": "text",
                "x": 280,

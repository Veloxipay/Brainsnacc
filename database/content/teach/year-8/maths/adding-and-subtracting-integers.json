                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Negatives are bigger by 2. So the answer is negative 2.",
          "write": "= −2"
        },
        {
          "say": "The sign rides in front. Minus 9 goes in the negative pile.",
          "write": "−9 → negative pile"
        },
        {
          "say": "Check left to right. 13, then 4, 10 and negative 2.",
          "write": "−15+28=13, 4, 10, −2 ✓"
        }
      ]
    },
    {
      "heading": "Left to right",
      "lines": [
        {
          "say": "Negative 37 plus 58 minus 26. Go one step at a time.",
          "write": "−37 + 58 − 26"
        },
        {
          "say": "Negative 37 plus 58 lands on 21.",
          "write": "−37 + 58 = 21",
          "draw": {
            "type": "numberline",
            "from": -40,
            "to": 30,
            "start": -37,
            "jump": 58
          }
        },
        {
          "say": "21 take away 26 passes zero by 5. Negative 5.",
          "write": "21 − 26 = −5",
          "draw": {
            "type": "numberline",
            "from": -40,
            "to": 30,
            "start": 21,
            "jump": -26
          }
        },
        {
          "say": "Estimate: about minus 40 plus 60 minus 30, which is minus 10. Close enough.",
          "write": "≈ −10 ✓"
        }
      ]
    },
    {
      "heading": "Working out a change",
      "lines": [
        {
          "say": "Change is final minus start. Later minus earlier.",
          "write": "change = final − start"
        },
        {
          "say": "Temperature goes from minus 4 to 9 degrees.",
          "write": "9 − (−4) = 9 + 4 = 13",
          "diagram": "diagrams/y8/maths/adding-and-subtracting-integers-change.svg",
          "alt": "Number line jump of +13 from −4 to 9"
        },
        {
          "say": "Plus 13. It rose 13 degrees. Positive means up.",
          "write": "rose 13 °C"
        },
        {
          "say": "A submarine goes from minus 135 metres to minus 62.",
          "write": "−62 − (−135) = −62 + 135",
          "diagram": "diagrams/y8/maths/adding-and-subtracting-integers-sub.svg",
          "alt": "Submarine rises 73 m from −135 m to −62 m"
        },
        {
          "say": "That's plus 73. It went up 73 metres.",
          "write": "+73 m (up)"
        },
        {
          "say": "Start minus final gives the wrong sign. Final goes first.",
          "write": "✗ start − final"
        }
      ]
    },
    {
      "heading": "Finding a missing number",
      "lines": [
        {
          "say": "Box minus 17 equals negative 30. Undo the minus with a plus.",
          "write": "□ − 17 = −30"
        },
        {
          "say": "So box is negative 30 plus 17.",
          "write": "□ = −30 + 17",
          "draw": {
            "type": "numberline",
            "from": -35,
            "to": 5,
            "start": -30,
            "jump": 17
          }
        },
        {
          "say": "That's negative 13. Check: negative 13 minus 17 is negative 30.",
          "write": "□ = −13 ✓"
        },
        {
          "say": "Subtracting 17 again gives minus 47. That's the wrong inverse.",
          "write": "✗ −47"
        },
        {
          "say": "Big numbers, same rules. Negative 250 plus 75 is negative 175.",
          "write": "−250 + 75 = −175"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Tidy, gather, compare.",
          "write": "Tidy, gather, compare"
        },
        {
          "say": "The sign rides in front of its number.",
          "write": "sign stays with its number"
        },
        {
          "say": "Change is later minus earlier.",
          "write": "final − start"
        },
        {
          "say": "Undo with the inverse, then check by substituting back.",
          "write": "inverse + check ✓"
        }
      ]
    }
  ]
}
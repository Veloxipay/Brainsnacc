{
  "level": "Year 8",
  "subject": "maths",
  "title": "Adding and subtracting integers",
  "frames": [
    {
      "heading": "Longer integer calculations",
      "lines": [
        {
          "say": "In Year 8 the strings of integers get longer and bigger.",
          "write": "−15 + 28 − 9 + 6 − 12"
        },
        {
          "say": "Think of a footy tipping score. Points gained and points lost.",
          "write": "gains and losses"
        },
        {
          "say": "You don't replay every game. Add the gains, add the losses, compare.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Gains versus losses",
            "items": [
              {
                "kind": "rect",
                "x": 60,
                "y": 60,
                "w": 180,
                "h": 140,
                "fill": "green",
                "label": "gains"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 60,
                "w": 180,
                "h": 140,
                "fill": "red",
                "label": "losses"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "compare the totals",
                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "But first, tidy any double signs. Scoreboards don't have those."
        }
      ]
    },
    {
      "heading": "Tidy the signs",
      "lines": [
        {
          "say": "Two signs side by side become one sign.",
          "write": "same → +   different → −"
        },
        {
          "say": "Minus a negative becomes plus. Plus a negative becomes minus.",
          "write": "− (−) → +    + (−) → −"
        },
        {
          "say": "So 14 minus negative 23 plus negative 41 becomes this.",
          "write": "14 + 23 − 41",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Double signs simplified",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "14 − (−23) + (−41)",
                "size": 30,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 95,
                "x2": 280,
                "y2": 150,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "14 + 23 − 41",
                "size": 30,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 260,
                "text": "= 37 − 41 = −4",
                "size": 26,
                "color": "purple",
                "anchor": "middle",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "14 plus 23 is 37. 37 minus 41 is negative 4.",
          "write": "= −4"
        },
        {
          "say": "Tidy every double sign on the first line. Don't miss one.",
          "write": "fix them ALL first"
        }
      ]
    },
    {
      "heading": "Gather and compare",
      "lines": [
        {
          "say": "Addition works in any order. So gather positives and negatives.",
          "write": "commutative",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Sorting into piles",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 40,
                "text": "−15 + 28 − 9 + 6 − 12",
                "size": 26,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",

    {
      "heading": "When do they cost the same?",
      "lines": [
        {
          "say": "Company A charges 12 dollars plus 4 dollars per hour.",
          "write": "A: 12 + 4h"
        },
        {
          "say": "Company B charges 7 dollars per hour.",
          "write": "B: 7h"
        },
        {
          "say": "Same cost means equals. Join the two expressions.",
          "write": "12 + 4h = 7h"
        },
        {
          "say": "Take 4h from both sides. 12 equals 3h.",
          "write": "12 = 3h",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Subtracting 4h from both sides",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 60,
                "w": 200,
                "h": 60,
                "fill": "blue",
                "label": "12 + 4h"
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 60,
                "w": 200,
                "h": 60,
                "fill": "orange",
                "label": "7h"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 170,
                "text": "− 4h",
                "size": 22,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 430,
                "y": 170,
                "text": "− 4h",
                "size": 22,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 30,
                "y": 200,
                "w": 200,
                "h": 60,
                "fill": "blue",
                "change": "add",
                "label": "12"
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 200,
                "w": 200,
                "h": 60,
                "fill": "orange",
                "change": "add",
                "label": "3h"
              }
            ]
          }
        },
        {
          "say": "Divide by 3. They cost the same for 4 hours, 28 dollars each.",
          "write": "h = 4  ($28 each)"
        }
      ]
    },
    {
      "heading": "When brackets appear",
      "lines": [
        {
          "say": "Subtract 4 from n, then multiply by 3.",
          "write": "3(n − 4)"
        },
        {
          "say": "The multiplying happens after, so the n minus 4 goes in brackets.",
          "write": "not 3n − 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "3n − 4 crossed out, 3(n − 4) added",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 90,
                "text": "3n − 4",
                "size": 40,
                "color": "red",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "3(n − 4)",
                "size": 48,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Children's tickets at 11 dollars each: 11 lots of a plus 3.",
          "write": "11(a + 3)"
        },
        {
          "say": "Adults cost 18 each. The total paid was 178 dollars.",
          "write": "18a + 11(a + 3) = 178"
        },
        {
          "say": "Expand and solve. a is 5, so 5 adults and 8 children.",
          "write": "a = 5 → 5 adults, 8 children"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Don't stop at x. Underline what the question asks for.",
          "write": "answer the QUESTION"
        },
        {
          "say": "Don't use two letters for linked amounts. Write children as a plus 3.",
          "write": "✗ a and c   ✓ a, a + 3"
        },
        {
          "say": "Fifteen less than Sara is s minus 15, not 15 minus s.",
          "write": "s − 15"
        },
        {
          "say": "Does it make sense? 4.6 people or minus 3 centimetres means a mistake.",
          "write": "sense check"
        }
      ]
    },

        },
        {
          "say": "The second angle is double the first. First x, second 2x.",
          "write": "x and 2x"
        },
        {
          "say": "Tom has 15 dollars less than Sara. Tom is s minus 15.",
          "write": "Tom: s − 15"
        }
      ]
    },
    {
      "heading": "Angles in a triangle",
      "lines": [
        {
          "say": "A triangle has angles x, 2x, and x plus 20.",
          "write": "x°, 2x°, (x + 20)°",
          "diagram": "diagrams/y8/maths/solving-worded-problems-ex1.svg",
          "alt": "Triangle with angles x, 2x and x + 20 degrees"
        },
        {
          "say": "Angles in a triangle add to 180.",
          "write": "x + 2x + x + 20 = 180"
        },
        {
          "say": "Collect like terms, then take 20 from both sides.",
          "write": "4x = 160",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Collecting like terms then subtracting 20",
            "items": [
              {
                "kind": "text",

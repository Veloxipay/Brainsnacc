                "y": 80,
                "text": "x + 2x + x + 20 = 180",
                "size": 30,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 150,
                "text": "4x + 20 = 180",
                "size": 32,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "4x = 160",
                "size": 36,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Divide by 4. So x is 40.",
          "write": "x = 40"
        },
        {
          "say": "But the question asks for the largest angle. That's 80 degrees.",
          "write": "40°, 80°, 60° → 80°",
          "draw": {
            "type": "shapes",

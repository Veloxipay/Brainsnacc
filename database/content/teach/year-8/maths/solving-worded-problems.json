    {
      "heading": "One letter for everything",
      "lines": [
        {
          "say": "Pick the simplest unknown as your letter.",
          "write": "adults: a"
        },
        {
          "say": "Three more children than adults. Children are a plus 3.",
          "write": "children: a + 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Children written as a plus 3",
            "items": [
              {
                "kind": "rect",

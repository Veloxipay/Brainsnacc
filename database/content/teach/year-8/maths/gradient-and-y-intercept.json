    {
      "heading": "The form y = mx + c",
      "lines": [
        {
          "say": "Any straight line that isn't vertical can be written like this.",
          "write": "y = mx + c"
        },
        {
          "say": "m is the gradient. It's the number multiplying x.",
          "write": "m = gradient"
        },
        {
          "say": "c is the y-intercept. The line crosses the y-axis at 0 comma c.",
          "write": "c = y-intercept, (0, c)",
          "diagram": "diagrams/y8/maths/gradient-and-y-intercept-mc.svg",
          "alt": "The line y = 3x − 2 crossing the y-axis at −2, with a step of 1 across and 3 up"
        },
        {
          "say": "Why? Put x equals 0. Then y equals c.",
          "write": "x = 0 → y = c"
        }
      ]
    },
    {
      "heading": "Reading m and c",
      "lines": [
        {
          "say": "y equals 3x minus 2. m is 3, and c is minus 2.",
          "write": "y = 3x − 2: m = 3, c = −2"
        },
        {
          "say": "y equals 5 minus 2x. Write the x term first.",
          "write": "y = −2x + 5"
        },
        {
          "say": "The minus sign belongs to the 2. So m is minus 2, c is 5.",
          "write": "m = −2, c = 5"
        },
        {
          "say": "y equals x means m is 1 and c is 0.",
          "write": "y = x: m = 1, c = 0"
        },
        {
          "say": "y equals 6 is flat. m is 0 and c is 6.",
          "write": "y = 6: m = 0, c = 6"
        }
      ]
    },

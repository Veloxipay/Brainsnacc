        {
          "say": "If they spend 36 dollars, we get an equation with brackets.",
          "write": "4(x + 3) = 36"
        },
        {
          "say": "There are two ways to solve it."
        }
      ]
    },
    {
      "heading": "Method 1: expand first",
      "lines": [
        {
          "say": "Multiply the 4 by every term inside. Every term gets a turn.",
          "write": "4x + 12 = 36",
          "diagram": "diagrams/y8/maths/equations-with-brackets-area.svg",
          "alt": "Area model 4(x + 3) = 4x + 12"
        },
        {
          "say": "Now it's 4 bags and 12 cubes, balancing 36.",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 12
            },
            "right": {
              "cubes": 36
            }
          }
        },
        {
          "say": "Take 12 off both sides. It stays level.",
          "write": "4x = 24",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4,
              "cubes": 12
            },
            "right": {
              "cubes": 36
            },
            "remove": 12,
            "labels": [
              "4x + 12 − 12",
              "36 − 12"
            ]
          }
        },
        {
          "say": "Share 24 between 4 bags. x is 6.",
          "write": "x = 6",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 4
            },
            "right": {
              "cubes": 24
            },
            "share": true
          }
        }
      ]
    },

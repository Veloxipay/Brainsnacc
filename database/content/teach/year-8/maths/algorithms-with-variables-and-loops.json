    {
      "heading": "While or repeat until?",
      "lines": [
        {
          "say": "Both are conditional loops. They check at different moments.",
          "diagram": "diagrams/y8/maths/algorithms-with-variables-and-loops-while-until.svg",
          "alt": "While loop asks first; repeat-until does the steps first"
        },
        {
          "say": "A while loop checks before each run. It might run zero times.",
          "write": "while: check FIRST"
        },
        {
          "say": "Repeat until checks after each run. It always runs at least once.",
          "write": "until: check LAST"
        },
        {
          "say": "While looks before it leaps. Until leaps before it looks.",
          "write": "look → leap  /  leap → look"
        }
      ]
    },
    {
      "heading": "The water tank",
      "lines": [
        {
          "say": "A tank holds 1200 litres. Each day, 85 litres are used.",
          "write": "while water ≥ 300",

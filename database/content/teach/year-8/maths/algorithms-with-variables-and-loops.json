            ]
          }
        },
        {
          "say": "Check: 11 times 85 is 935. 1200 minus 935 is 265.",
          "write": "✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Always work from the row above in a trace table.",
          "write": "use the newest value"
        },
        {
          "say": "Leave out the spare c in Fibonacci, and b just doubles.",
          "write": "1, 1, 2, 3, 5, 8, 13"
        },
        {
          "say": "Underline while or until, and picture its flowchart first.",
          "write": "while ≠ until"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "New equals old plus change.",
          "write": "new = old + change"
        },
        {
          "say": "Totals start at 0. Products start at 1.",
          "write": "0 and 1"
        },
        {
          "say": "A counted loop runs last minus first plus 1 times.",
          "write": "b − a + 1"
        },
        {
          "say": "While checks first. Until checks last.",
          "write": "while first, until last"
        }
      ]
    }

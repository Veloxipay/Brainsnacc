{
  "level": "Year 8",
  "subject": "maths",
  "title": "Algorithms with variables and loops",
  "frames": [
    {
      "heading": "What is a variable?",
      "lines": [
        {
          "say": "A variable is a named place that stores one value.",
          "write": "variable: x, total, count"
        },
        {
          "say": "Think of a scoreboard. Rub out the old number, write the new one.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Variable x holds 5",
            "items": [
              {
                "kind": "rect",
                "x": 180,
                "y": 60,
                "w": 200,
                "h": 140,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 45,
                "text": "x",
                "size": 24,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "5",
                "size": 48,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Giving it a value is called assignment. Set x to 5.",
          "write": "Set x to 5"
        },
        {
          "say": "Set x to x plus 4. Use the current x, then store the answer.",
          "write": "Set x to x + 4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "x changes from 5 to 9",
            "items": [
              {
                "kind": "rect",
                "x": 180,
                "y": 60,
                "w": 200,
                "h": 140,
                "fill": "white"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 45,
                "text": "x",
                "size": 24,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "5",
                "size": 48,
                "color": "grey",
                "anchor": "middle",
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "9",
                "size": 48,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "It's not an equation to solve. New x equals old x plus 4.",
          "write": "new = old + change"
        }
      ]
    },
    {
      "heading": "Order matters",
      "lines": [
        {
          "say": "Set x to 5, then x plus 4, then 3 times x.",
          "write": "x = 5 → 9 → 27"
        },
        {
          "say": "Each step uses the newest value. 3 times 9 is 27, not 15.",
          "write": "3 × 9 = 27",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "x goes 5, 9, 27",
            "items": [
              {
                "kind": "circle",
                "x": 90,
                "y": 130,
                "r": 50,
                "fill": "grey",
                "change": "remove",
                "label": "5"
              },
              {
                "kind": "arrow",
                "x": 145,
                "y": 130,
                "x2": 215,
                "y2": 130,
                "color": "purple"
              },
              {
                "kind": "circle",
                "x": 270,
                "y": 130,
                "r": 50,
                "fill": "grey",
                "change": "remove",
                "label": "9"
              },
              {
                "kind": "arrow",
                "x": 325,
                "y": 130,
                "x2": 395,
                "y2": 130,
                "color": "purple"
              },
              {
                "kind": "circle",
                "x": 450,
                "y": 130,
                "r": 50,
                "fill": "blue",
                "change": "add",
                "label": "27"
              }
            ]
          }
        },
        {
          "say": "Then set y to x minus 7. y is 20.",
          "write": "y = 27 − 7 = 20"
        },
        {
          "say": "Swapping a and b? Set a to b first, and a's old value is lost.",
          "write": "✗ a = b, b = a"
        },
        {
          "say": "Copy a into a spare variable t first. Then swap safely.",
          "write": "t = a, a = b, b = t",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Swap using spare variable t",
            "items": [

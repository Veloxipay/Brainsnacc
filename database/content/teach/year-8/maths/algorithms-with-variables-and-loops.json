    {
      "heading": "Counted loops",
      "lines": [
        {
          "say": "For i from 1 to 5, i takes the values 1, 2, 3, 4, 5.",
          "write": "i = 1, 2, 3, 4, 5"
        },
        {
          "say": "The number of runs is last minus first plus 1.",
          "write": "last − first + 1"
        },

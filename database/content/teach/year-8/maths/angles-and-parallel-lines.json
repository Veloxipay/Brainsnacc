    {
      "heading": "Angles with algebra",
      "lines": [
        {
          "say": "Alternate angles are 3x plus 14 and 5x minus 30.",
          "write": "3x + 14 = 5x − 30"
        },
        {
          "say": "Alternate means equal. Take 3x from both sides.",
          "write": "14 = 2x − 30"
        },
        {
          "say": "Add 30, then halve. x is 22.",
          "write": "x = 22"
        },
        {
          "say": "The question wants the angle. 3 times 22 plus 14 is 80.",
          "write": "angle = 80°"
        },
        {
          "say": "Co-interior angles add to 180. Don't set them equal.",
          "write": "4y + 8 + 2y + 22 = 180"
        },
        {
          "say": "So 6y is 150, y is 25. The angles are 108 and 72.",
          "write": "108° + 72° = 180° ✓"
        }
      ]
    },
    {
      "heading": "The arrowhead",
      "lines": [
        {
          "say": "A line bends at E between the parallel lines, like an arrowhead.",
          "diagram": "diagrams/y8/maths/angles-and-parallel-lines-ex3.svg",
          "alt": "Arrowhead with arms at 35° and 50°"
        },
        {
          "say": "Draw a third parallel line through E. It splits the tip angle.",
          "write": "draw EF ∥ AB",
          "diagram": "diagrams/y8/maths/angles-and-parallel-lines-arrowhead.svg",
          "alt": "Dashed parallel line through E splits the tip angle into p and q"
        },
        {
          "say": "The top part is alternate to 35. The bottom part to 50.",
          "write": "35° and 50° (alt. ∠s)"
        },
        {
          "say": "So the tip angle is 35 plus 50, which is 85 degrees.",
          "write": "∠BED = 85°"
        },
        {
          "say": "Arrowhead equals add. Don't just split the angle in half.",
          "write": "tip = p + q"
        }
      ]
    },
    {
      "heading": "Proving lines are parallel",
      "lines": [
        {
          "say": "The rules work backwards too.",
          "write": "prove AB ∥ CD"
        },
        {
          "say": "Equal corresponding or alternate angles prove the lines are parallel.",
          "write": "F or Z equal → ∥"
        },
        {
          "say": "So do co-interior angles adding to 180.",
          "write": "C adds to 180° → ∥"
        },
        {
          "say": "Vertically opposite angles prove nothing. They're equal for any crossing lines.",
          "write": "✗ vert. opp."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Mark it, link it, write it.",
          "write": "reason every step"
        },
        {
          "say": "F and Z give equals. C gives 180.",
          "write": "= or = 180"
        },
        {
          "say": "Stuck? Draw another parallel line.",
          "write": "extra parallel line"
        },
        {
          "say": "Check whether they want x or the angle.",
          "write": "x or angle?"
        }
      ]
    }

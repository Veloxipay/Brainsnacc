    {
      "heading": "Daylight saving",
      "lines": [
        {
          "say": "Daylight saving moves clocks 1 hour forward in summer.",
          "write": "+1 h in summer"
        },
        {
          "say": "Victoria, New South Wales, the ACT, Tasmania and South Australia use it.",
          "write": "Melbourne → AEDT, UTC+11"
        },
        {
          "say": "Queensland, the Northern Territory and Western Australia don't.",
          "write": "Qld, NT, WA: no"
        },
        {
          "say": "So in summer Melbourne is 1 hour ahead of Brisbane, and 3 ahead of Perth.",
          "write": "Melb ahead: Bris 1 h, Perth 3 h",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Summer offsets",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 80,
                "w": 140,
                "h": 70,
                "fill": "blue",
                "label": "Perth +8"
              },
              {
                "kind": "rect",
                "x": 210,
                "y": 80,
                "w": 140,
                "h": 70,
                "fill": "blue",
                "label": "Bris +10"
              },
              {
                "kind": "rect",
                "x": 380,
                "y": 80,
                "w": 150,
                "h": 70,
                "fill": "orange",
                "change": "highlight",
                "label": "Melb +11"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "summer: Melbourne +1 h",
                "size": 24,
                "color": "purple",
                "change": "add"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Crossing zones and days",
      "lines": [
        {
          "say": "A flight leaves Melbourne at 10:30 pm Monday, in December.",
          "write": "dep 10:30 pm Mon (UTC+11)"
        },
        {
          "say": "It flies 14 hours 20 minutes. That's 12:50 pm Tuesday, Melbourne time.",
          "write": "arr 12:50 pm Tue Melb"
        },
        {
          "say": "Los Angeles is UTC minus 8. 11 take minus 8 is 19 hours.",
          "write": "11 − (−8) = 19 h"
        },
        {
          "say": "LA is behind, so subtract 19 hours. 5:50 pm Monday!",
          "write": "5:50 pm Mon LA",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 220,
            "alt": "Subtract 19 hours",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 230,
                "h": 80,
                "fill": "blue",
                "label": "12:50 pm Tue"
              },
              {
                "kind": "arrow",
                "x": 270,
                "y": 120,
                "x2": 320,
                "y2": 120,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 295,
                "y": 100,
                "text": "− 19 h",
                "size": 18,
                "color": "red"
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 80,
                "w": 210,
                "h": 80,
                "fill": "green",
                "change": "add",
                "label": "5:50 pm Mon"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Watch out and remember",
      "lines": [
        {
          "say": "Time isn't decimals. 1:50 plus 20 minutes is 2:10, not 1:70.",
          "write": "1:50 + 0:20 = 2:10"
        },
        {
          "say": "East is ahead, so add. West is behind, so subtract.",
          "write": "east add, west subtract"
        },
        {
          "say": "Change the day when you cross midnight.",
          "write": "check the day"
        },
        {
          "say": "Check if daylight saving applies.",
          "write": "summer? +1 h"
        },
        {
          "say": "Taking away a negative offset means adding.",
          "write": "11 − (−8) = 19"
        }
      ]
    }

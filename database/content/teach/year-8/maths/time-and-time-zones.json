{
  "level": "Year 8",
  "subject": "maths",
  "title": "Time and time zones",
  "frames": [
    {
      "heading": "24-hour time",
      "lines": [
        {
          "say": "24-hour time counts hours from 0 to 23, starting at midnight.",
          "write": "0000 to 2359",
          "diagram": "diagrams/y8/maths/time-and-time-zones-24h.svg",
          "alt": "24-hour time line from midnight to midnight"
        },
        {
          "say": "No am or pm needed. Usually four digits.",
          "write": "7:15 am = 0715"
        },
        {
          "say": "For pm times, add 12 to the hour.",
          "write": "3:40 pm = 1540",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 200,
            "alt": "3:40 pm becomes 1540",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 70,
                "w": 200,
                "h": 80,
                "fill": "blue",
                "label": "3:40 pm"
              },
              {
                "kind": "arrow",
                "x": 250,
                "y": 110,
                "x2": 320,
                "y2": 110,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 285,
                "y": 95,
                "text": "+12",
                "size": 18,
                "color": "purple"
              },
              {
                "kind": "rect",
                "x": 330,
                "y": 70,
                "w": 200,
                "h": 80,
                "fill": "green",
                "change": "add",
                "label": "1540"
              }
            ]
          }
        },
        {
          "say": "Midnight is zero zero hundred. Midday is twelve hundred.",
          "write": "0000 midnight, 1200 noon"
        }
      ]
    },
    {
      "heading": "Elapsed time: count on",
      "lines": [
        {
          "say": "Excursion leaves 8:45 am and returns 3:20 pm. How long?",
          "write": "8:45 am → 3:20 pm"
        },
        {
          "say": "Count on to the next whole hour. That's 15 minutes.",
          "write": "8:45 → 9:00 = 15 min",
          "diagram": "diagrams/y8/maths/time-and-time-zones-ex1.svg",
          "alt": "Counting on from 8:45 to 9:00, then to 3:00, then to 3:20"
        },
        {
          "say": "Then jump whole hours. 9 am to 3 pm is 6 hours.",
          "write": "9:00 → 3:00 = 6 h"
        },
        {
          "say": "Then the leftover 20 minutes.",
          "write": "3:00 → 3:20 = 20 min"
        },
        {
          "say": "Add the pieces. 6 hours 35 minutes.",
          "write": "6 h 35 min"
        },
        {
          "say": "Remember, an hour has 60 minutes, not 100.",
          "write": "60 min, not 100"
        }
      ]
    },

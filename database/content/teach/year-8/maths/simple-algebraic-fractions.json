    {
      "heading": "Two terms on top",
      "lines": [
        {
          "say": "x plus 1 over 2, plus x minus 3 over 5. Common denominator 10.",
          "write": "(x + 1)/2 + (x − 3)/5"
        },
        {
          "say": "Keep the brackets. 5 lots of x plus 1, and 2 lots of x minus 3.",
          "write": "5(x + 1)/10 + 2(x − 3)/10"
        },
        {
          "say": "Expand and add. 5x plus 5 plus 2x minus 6.",
          "write": "(5x + 5 + 2x − 6)/10"
        },
        {
          "say": "That's 7x minus 1, all over 10.",
          "write": "= (7x − 1)/10"
        },
        {
          "say": "Check with x equals 3. Both sides give 2.",
          "write": "2 = 20/10 ✓"
        }
      ]
    },
    {
      "heading": "Multiplying and dividing",
      "lines": [
        {
          "say": "Multiply tops and bottoms. Cancel first to keep it small.",
          "write": "2x/5 × 15/(4x)"
        },
        {
          "say": "The x's cancel. 15 and 5 make 3 and 1. 2 and 4 make 1 and 2.",
          "write": "= 3/2"
        },
        {
          "say": "To divide, keep, change, flip.",
          "write": "3a/4 ÷ 9a/8 = 3a/4 × 8/(9a)"
        },
        {
          "say": "Cancel the a's, 3 with 9, and 8 with 4. Two thirds.",
          "write": "= 2/3"
        }
      ]
    },

{
  "level": "Year 8",
  "subject": "maths",
  "title": "Simple algebraic fractions",
  "frames": [
    {
      "heading": "Fractions with letters",
      "lines": [
        {
          "say": "An algebraic fraction has a letter in it. Like x over 3.",
          "write": "x/3,  (x + 1)/2,  5/(2a)"
        },
        {
          "say": "Split a bill of x dollars between 3 friends. Each pays x over 3.",
          "write": "$x ÷ 3 = x/3"
        },
        {
          "say": "Same rules as number fractions. The letter just comes along for the ride.",
          "write": "letters ride along"
        }
      ]
    },
    {
      "heading": "Simplifying by cancelling",
      "lines": [
        {
          "say": "Simplify 15ab over 10b. Look for common factors.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "15ab over 10b: divide top and bottom by 5b to get 3a over 2",
            "items": [

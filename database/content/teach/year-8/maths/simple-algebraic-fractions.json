    {
      "heading": "Factors cancel, terms don't",
      "lines": [
        {
          "say": "Can you cancel the 5s in x plus 5, over 5?",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "(x + 5) over 5 is not x + 1: the 5 is added, so it cannot cancel",
            "items": [
              {
                "kind": "text",
                "x": 150,
                "y": 80,
                "text": "(x + 5)",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "line",
                "x": 80,
                "y": 100,
                "x2": 220,
                "y2": 100,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 150,
                "y": 150,
                "text": "5",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 330,
                "y": 115,
                "text": "= x + 1 ?",
                "size": 34,
                "color": "red",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "No! The 5 on top is added. Test x equals 5. 2 is not 6.",
          "write": "✗ x + 1",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "(x + 5) over 5 is not x + 1: the 5 is added, so it cannot cancel",
            "items": [
              {
                "kind": "text",
                "x": 150,
                "y": 80,
                "text": "(x + 5)",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "line",
                "x": 80,
                "y": 100,
                "x2": 220,
                "y2": 100,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 150,
                "y": 150,
                "text": "5",
                "size": 36,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 330,
                "y": 115,
                "text": "= x + 1 ?",
                "size": 34,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "x = 5: 10 ÷ 5 = 2, but 5 + 1 = 6",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "With two terms on top, factorise first. 6x plus 9 is 3 times 2x plus 3.",
          "write": "(6x + 9)/3 = 3(2x + 3)/3"
        },
        {
          "say": "Now the 3 multiplies the whole top. Cancel it. 2x plus 3.",
          "write": "= 2x + 3"
        }
      ]
    },

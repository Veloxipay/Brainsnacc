        {
          "say": "Power of a power, multiply. 3x squared y, cubed, is 27 x to the 6, y cubed.",
          "write": "(3x²y)³ = 27x⁶y³"
        },
        {
          "say": "Divide by 9x to the 4 y. Subtract the powers.",
          "write": "= 3x²y²"
        }
      ]

    {
      "heading": "Before Semester 2",
      "lines": [
        {
          "say": "Same signs give positive. Different signs give negative.",
          "write": "same +, different −"
        },
        {
          "say": "20 percent up then 20 percent down doesn't cancel.",
          "write": "× 1.2 then × 0.8"
        },

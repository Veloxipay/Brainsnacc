    {
      "heading": "Real to drawing: divide",
      "lines": [
        {
          "say": "A house plan is 1 to 200. A real wall is 7 metres.",
          "write": "1 : 200,  7 m"
        },
        {
          "say": "Change to centimetres first. 7 metres is 700 centimetres.",
          "write": "7 m = 700 cm"
        },
        {
          "say": "Divide by 200. The wall is 3.5 centimetres on the plan.",
          "write": "700 ÷ 200 = 3.5 cm"
        },
        {
          "say": "Ask: should the answer be bigger or smaller?",
          "write": "bigger or smaller?"
        }
      ]
    },
    {
      "heading": "Finding the scale",
      "lines": [
        {
          "say": "A drawing of a car is 6 centimetres. The real car is 2.4 metres.",
          "write": "6 cm : 2.4 m"
        },
        {
          "say": "Same unit first. 2.4 metres is 240 centimetres.",
          "write": "6 : 240"
        },
        {
          "say": "Divide both by 6. The scale is 1 to 40.",
          "write": "= 1 : 40"
        },
        {
          "say": "First number bigger? It's an enlargement. An ant at 20 to 1.",
          "write": "20 : 1 → enlargement"
        },
        {
          "say": "A 4 centimetre poster ant is 4 over 20. That's 2 millimetres.",
          "write": "4 ÷ 20 = 0.2 cm = 2 mm"
        }
      ]
    },

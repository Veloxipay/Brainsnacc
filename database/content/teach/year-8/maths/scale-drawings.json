                "size": 22,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "What a scale means",
      "lines": [
        {
          "say": "A scale is drawing length to real length, in the same unit.",
          "write": "drawing : real"
        },
        {
          "say": "1 to 50 thousand means 1 centimetre on the map is 50 thousand in real life.",
          "write": "1 cm → 50 000 cm"
        },
        {
          "say": "The second number is the scale factor.",
          "write": "scale factor = 50 000"
        }
      ]
    },
    {

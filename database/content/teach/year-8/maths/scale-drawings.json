{
  "level": "Year 8",
  "subject": "maths",
  "title": "Scale drawings",
  "frames": [
    {
      "heading": "Same shape, different size",
      "lines": [
        {
          "say": "A scale drawing shows a real object at a different size.",
          "write": "same shape, new size"
        },
        {
          "say": "A toy car labelled 1 to 64. Its wheel is 1 centimetre.",
          "write": "1 : 64",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "A 1 : 64 toy car and the real car: every length is 64 times bigger",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 140,
                "w": 64,
                "h": 30,
                "fill": "orange",
                "label": "toy"
              },
              {
                "kind": "circle",
                "x": 55,
                "y": 175,
                "r": 6,
                "fill": "black"
              },
              {
                "kind": "circle",
                "x": 90,
                "y": 175,
                "r": 6,
                "fill": "black"
              },
              {
                "kind": "text",
                "x": 72,
                "y": 210,
                "text": "1 cm wheel",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "So the real wheel is 64 centimetres. Every length is 64 times bigger.",
          "write": "1 cm → 64 cm",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "A 1 : 64 toy car and the real car: every length is 64 times bigger",

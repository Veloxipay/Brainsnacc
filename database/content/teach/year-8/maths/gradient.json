        {
          "say": "Always read a line from left to right, like a book.",
          "diagram": "diagrams/y8/maths/gradient-kinds.svg",
          "alt": "Four lines: going up (positive), going down (negative), flat (zero), vertical (undefined)"
        },
        {
          "say": "Goes up? Positive gradient. Goes down? Negative gradient.",
          "write": "up +   down −"
        },
        {
          "say": "A flat line has gradient zero.",
          "write": "flat → 0"
        },
        {
          "say": "A vertical line has a run of zero. You can't divide by zero.",
          "write": "vertical → undefined"
        },
        {
          "say": "Bigger size means steeper. Minus 4 is steeper than 3.",
          "write": "−4 steeper than 3"
        }
      ]
    },
    {
      "heading": "Gradient from two points",
      "lines": [
        {
          "say": "The rise is the change in y. The run is the change in x.",
          "write": "(y₂ − y₁) ÷ (x₂ − x₁)"
        },
        {
          "say": "Try 1 comma 2 and 4 comma 11.",
          "write": "(1, 2) and (4, 11)"
        },
        {
          "say": "Rise. 11 take away 2 is 9.",
          "write": "rise = 11 − 2 = 9"
        },
        {
          "say": "Run. 4 take away 1 is 3. Same order as the top.",
          "write": "run = 4 − 1 = 3"
        },
        {
          "say": "9 divided by 3 is 3. It goes up, so positive makes sense.",
          "write": "gradient = 3"
        }
      ]

    {
      "heading": "Many numbers at once",
      "lines": [
        {
          "say": "Minus 4 times 6 times minus 5 times minus 1.",
          "write": "(−4) × 6 × (−5) × (−1)"
        },
        {
          "say": "Size first. 4 times 6 times 5 times 1 is 120.",
          "write": "size = 120"
        },
        {
          "say": "Three negatives. That's odd, so the answer is negative.",
          "write": "3 negatives → −"
        },
        {
          "say": "So the answer is minus 120.",
          "write": "= −120"
        },
        {
          "say": "If any number is zero, the whole answer is zero.",
          "write": "× 0 → 0"
        }
      ]
    },
    {
      "heading": "Left to right",
      "lines": [
        {
          "say": "Times and divide have equal rank. Work left to right.",
          "write": "× ÷ left to right"
        },
        {
          "say": "Minus 96 divided by 8 comes first. That's minus 12.",
          "write": "−96 ÷ 8 = −12"
        },
        {
          "say": "Then minus 12 times minus 3. Same signs, so 36.",
          "write": "−12 × (−3) = 36"
        },
        {
          "say": "Don't multiply first. That gives the wrong answer.",
          "write": "✗ 8 × (−3) first"
        }
      ]
    },
    {
      "heading": "Powers of negatives",
      "lines": [
        {
          "say": "Minus 2 to the 4. Four negatives, even. So 16.",
          "write": "(−2)⁴ = 16"
        },
        {
          "say": "Minus 2 to the 5. Five negatives, odd. So minus 32.",
          "write": "(−2)⁵ = −32"
        },
        {
          "say": "Even power, positive tower. Odd power keeps the minus.",
          "write": "even +, odd −"
        },
        {
          "say": "Watch the brackets. Without them, the power only hugs the 3.",
          "write": "(−3)⁴ = 81,  −3⁴ = −81"
        }
      ]
    },
    {
      "heading": "Roots and missing numbers",
      "lines": [
        {
          "say": "7 squared and minus 7 squared both make 49.",
          "write": "√49 = 7,  roots ±7"
        },
        {
          "say": "The root symbol means the positive one. Negatives have no square root.",
          "write": "√(−49): none"
        },
        {
          "say": "Cube roots can be negative. Minus 5 cubed is minus 125.",
          "write": "∛(−125) = −5"
        },
        {
          "say": "Missing number times 12 is minus 84. Divide: minus 7.",
          "write": "□ = −84 ÷ 12 = −7"
        },
        {
          "say": "Check by multiplying back. Minus 7 times 12 is minus 84.",
          "write": "(−7) × 12 = −84 ✓"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Count all the negatives, not just the first two.",
          "write": "count ALL negatives"
        },
        {
          "say": "Minus 2 cubed is minus 8. Minus 2 times 3 is minus 6.",
          "write": "(−2)³ = −8,  (−2) × 3 = −6"
        },
        {
          "say": "No bracket, no hug. Minus 3 to the 4 is minus 81.",
          "write": "−3⁴ = −81"
        }
      ]
    },

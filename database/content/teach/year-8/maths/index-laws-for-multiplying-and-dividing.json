  "title": "Index laws for multiplying and dividing",
  "frames": [
    {
      "heading": "Why index laws?",
      "lines": [
        {
          "say": "2 to the power 5 means five 2s multiplied together.",
          "write": "2⁵ = 2 × 2 × 2 × 2 × 2"
        },
        {
          "say": "Writing x to the 20 out in full would take forever.",
          "write": "x²⁰ × x¹⁵ = ?"
        },
        {
          "say": "Index laws are shortcuts. They multiply and divide powers in one step.",
          "write": "index laws = shortcuts"
        }
      ]
    },
    {

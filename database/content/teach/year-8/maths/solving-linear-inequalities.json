    {
      "heading": "A two-step example",
      "lines": [
        {
          "say": "Solve 7 take 2x is at least 15.",
          "write": "7 − 2x ≥ 15"
        },
        {
          "say": "Take 7 from both sides. No flip for subtracting.",
          "write": "−2x ≥ 8"
        },
        {
          "say": "Divide by minus 2, and reverse the sign.",
          "write": "x ≤ −4",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "The greater-or-equal sign flips to less-or-equal",

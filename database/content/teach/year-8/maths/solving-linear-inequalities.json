    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Forgetting to flip is the big one. Say flip out loud.",
          "write": "✗ x > −4   ✓ x < −4"
        },
        {
          "say": "Don't flip just because you see a negative number.",
          "write": "x − 5 > −2 → x > 3"
        },
        {
          "say": "Only flip when you multiply or divide by a negative."
        },
        {
          "say": "Keep the inequality sign on every line. x equals 6 is wrong.",
          "write": "✗ x = 6"
        },
        {
          "say": "Write x first. Minus 4 is more than x becomes x less than minus 4.",
          "write": "−4 > x  →  x < −4"
        }

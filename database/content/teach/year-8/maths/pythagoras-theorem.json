    {
      "heading": "Pythagoras' theorem",
      "lines": [
        {
          "say": "c squared equals a squared plus b squared.",
          "write": "c² = a² + b²"
        },
        {
          "say": "It only works in right-angled triangles. Check for the 90 degree mark.",
          "write": "right angle only"
        },
        {
          "say": "To find c: square, add, square root.",
          "write": "square, add, √"
        }
      ]
    },
    {
      "heading": "Finding the hypotenuse",
      "lines": [

  "subject": "maths",
  "title": "Translations, reflections and rotations",
  "frames": [
    {
      "heading": "Translations as a rule",
      "lines": [
        {
          "say": "A translation slides a shape. We can write it as a mapping rule.",
          "write": "(x, y) → (x + 4, y − 3)"
        },
        {
          "say": "Plus 4 means 4 right. Minus 3 means 3 down.",
          "write": "4 right, 3 down"
        },
        {
          "say": "B moves from minus 2, 5 to 3, 1. Find the move.",
          "write": "B(−2, 5) → B′(3, 1)",
          "diagram": "diagrams/y8/maths/translations-reflections-and-rotations-translate.svg",
          "alt": "B moved 5 right and 4 down to B′"
        },
        {
          "say": "Image take object. 3 take minus 2 is 5. So 5 right.",
          "write": "3 − (−2) = 5"
        },
        {
          "say": "1 take 5 is minus 4. So 4 down.",
          "write": "1 − 5 = −4"
        },
        {
          "say": "The rule is x plus 5, y minus 4.",
          "write": "(x, y) → (x + 5, y − 4)"
        }
      ]
    },

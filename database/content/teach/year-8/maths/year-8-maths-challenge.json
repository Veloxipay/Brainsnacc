    {
      "heading": "Index laws",
      "lines": [
        {
          "say": "Multiply, add the powers. Divide, subtract. Power of a power, multiply.",
          "write": "× add, ÷ subtract, ( )ⁿ multiply"
        },
        {
          "say": "Square everything in the bracket. Two a cubed b, squared.",
          "write": "(2a³b)² = 4a⁶b²",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Squaring every part of the bracket",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 90,
                "text": "(2a³b)²",
                "size": 48,
                "color": "black",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 110,
                "x2": 280,
                "y2": 160,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "4a⁶b²",
                "size": 48,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Times 3ab to the 4. 4 times 3 is 12. Add the powers.",
          "write": "12a⁷b⁶"
        }
      ]
    },
    {
      "heading": "Percentages, profit and loss",
      "lines": [
        {
          "say": "25 percent off 160 dollars is 40 off. Sale price 120 dollars.",
          "write": "160 × 0.75 = $120",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "A bar split into $120 and $40",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 80,
                "w": 480,
                "h": 70,
                "fill": "white",
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 40,
                "y": 80,
                "w": 360,
                "h": 70,
                "fill": "blue",
                "label": "$120 pay"
              },
              {
                "kind": "rect",
                "x": 400,
                "y": 80,
                "w": 120,
                "h": 70,
                "fill": "red",
                "change": "remove",
                "label": "$40 off"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "25% of $160 = $40",
                "size": 26,
                "color": "purple"
              }
            ]
          }
        },
        {
          "say": "The shop paid 96. Profit is 120 take 96, which is 24 dollars.",
          "write": "profit = $24"
        },
        {
          "say": "Percentage profit is out of the cost price. 24 over 96 is 25 percent.",
          "write": "24 ÷ 96 × 100% = 25%"
        },
        {
          "say": "Percentage change always compares to the original amount.",
          "write": "change ÷ original"
        }
      ]
    },
    {
      "heading": "Brackets and equations",
      "lines": [
        {
          "say": "A negative outside a bracket multiplies every term inside.",
          "write": "−2(x − 4) = −2x + 8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "The minus 2 multiplies both terms",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 100,
                "text": "−2(x − 4)",
                "size": 48,
                "color": "black",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 200,
                "y": 60,
                "x2": 250,
                "y2": 40,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 200,
                "y": 60,
                "x2": 370,
                "y2": 40,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "−2x + 8",
                "size": 44,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "So 3 lots of 2x take 5, take 2 lots of x take 4, is 4x take 7.",
          "write": "4x − 7"
        },
        {
          "say": "Solve 5 lots of x take 2 equals 2x plus 11. Expand first.",
          "write": "5x − 10 = 2x + 11"
        },
        {
          "say": "Take 2x, add 10. 3x is 21, so x is 7.",
          "write": "x = 7",
          "draw": {
            "type": "balance",
            "left": {
              "bags": 3,
              "cubes": -10
            },
            "right": {
              "cubes": 11
            },
            "remove": 10,
            "removeFrom": "left",
            "add": 10,
            "addTo": "right",
            "labels": [
              "3x − 10 + 10",
              "11 + 10"
            ]
          }
        },
        {
          "say": "Whatever you do to one side, do to the other.",
          "write": "same to BOTH sides"
        }
      ]
    },
    {
      "heading": "Circles and cylinders",
      "lines": [
        {
          "say": "A bottle has radius 3 and height 10.",
          "write": "r = 3 cm, h = 10 cm",
          "diagram": "diagrams/y8/maths/year-8-maths-challenge-sa-cylinder.svg",
          "alt": "Cylinder with radius 3 cm and height 10 cm"
        },
        {
          "say": "Volume is pi r squared h. That's 90 pi, about 282.7.",
          "write": "V = 90π ≈ 282.7 cm³"
        },
        {
          "say": "Divide by 1000 for litres. About 0.28 litres.",
          "write": "≈ 0.28 L"
        },
        {
          "say": "Circumference is a length. Area needs the r squared.",
          "write": "C = πd   A = πr²",
          "draw": {

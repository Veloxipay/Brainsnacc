    {
      "heading": "Parallelogram",
      "lines": [
        {
          "say": "In parallelogram ABCD, draw diagonal AC.",
          "write": "diagonal AC",
          "diagram": "diagrams/y8/maths/using-congruence-in-quadrilaterals-para.svg",
          "alt": "Parallelogram ABCD with diagonal AC and alternate angles marked"
        },
        {
          "say": "AB is parallel to DC, so angle BAC equals angle DCA. Alternate.",
          "write": "∠BAC = ∠DCA (alt.)"
        },
        {
          "say": "AD is parallel to BC, so angle BCA equals angle DAC.",
          "write": "∠BCA = ∠DAC (alt.)"
        },
        {
          "say": "AC is common to both. So the triangles are congruent by ASA.",
          "write": "△ABC ≅ △CDA (ASA)",

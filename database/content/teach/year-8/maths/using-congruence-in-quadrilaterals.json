    {
      "heading": "Using it: diagonals bisect",
      "lines": [
        {
          "say": "Diagonals meet at M. AM is 3t take 4. MC is t plus 6.",
          "write": "AM = 3t − 4, MC = t + 6",
          "diagram": "diagrams/y8/maths/using-congruence-in-quadrilaterals-ex2.svg",
          "alt": "Parallelogram with diagonals meeting at M"
        },
        {
          "say": "The diagonals bisect each other, so AM equals MC.",
          "write": "3t − 4 = t + 6"
        },
        {
          "say": "Take t from both sides and add 4. 2t is 10, so t is 5.",
          "write": "t = 5"
        },
        {
          "say": "AM is 11 and MC is 11. So AC is 22 centimetres.",
          "write": "AC = 11 + 11 = 22 cm",
          "draw": {

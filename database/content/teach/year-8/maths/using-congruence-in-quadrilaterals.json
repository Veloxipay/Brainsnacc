    {
      "heading": "Rhombus with Pythagoras",
      "lines": [
        {
          "say": "A rhombus has diagonals of 10 and 24 centimetres. Find the perimeter.",
          "write": "diagonals 10 cm, 24 cm"
        },
        {
          "say": "Halve both diagonals first. That gives 5 and 12.",
          "write": "halves: 5 cm and 12 cm",
          "diagram": "diagrams/y8/maths/using-congruence-in-quadrilaterals-rhombus.svg",
          "alt": "Rhombus with half-diagonals 12 cm and 5 cm at right angles"
        },
        {
          "say": "Each side is a hypotenuse. Root of 25 plus 144 is 13.",
          "write": "√(5² + 12²) = √169 = 13"
        },
        {
          "say": "Four equal sides. 4 times 13 is 52 centimetres.",
          "write": "P = 4 × 13 = 52 cm"
        },
        {
          "say": "Don't use the whole diagonal in Pythagoras. Halve it first.",
          "write": "✗ whole diagonal"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "AAA isn't a congruence test. Always include the common diagonal.",
          "write": "✗ AAA   ✓ ASA"
        },
        {
          "say": "In a kite, only one diagonal is cut in half.",
          "write": "kite: AC cuts BD in half"
        },
        {
          "say": "After finding t, substitute back to get the length asked for.",
          "write": "answer the question"
        }
      ]
    },

    {
      "heading": "Rectangle, rhombus and kite",
      "lines": [
        {
          "say": "A rectangle's diagonals are equal. SAS with the right angles proves it.",
          "write": "rectangle: AC = DB"
        },
        {
          "say": "A rhombus's diagonals cross at right angles and bisect the corners.",
          "write": "rhombus: cross at 90°"
        },
        {
          "say": "A kite has two pairs of equal sides. SSS gives one pair of equal angles.",
          "write": "kite: ∠ABC = ∠ADC"
        },

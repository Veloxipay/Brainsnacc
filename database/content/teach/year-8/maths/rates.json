    {
      "heading": "Converting rates",
      "lines": [
        {
          "say": "A robot goes 3600 metres per hour. What's that per minute?",
          "write": "3600 m/h → m/min"
        },
        {
          "say": "Should the number get smaller? Yes. So divide by 60.",
          "write": "3600 ÷ 60 = 60 m/min"
        },
        {
          "say": "A car uses 42 litres for 600 kilometres.",
          "write": "42 L per 600 km"
        },
        {
          "say": "600 is 6 lots of 100. 42 divided by 6 is 7 litres per 100 kilometres.",
          "write": "42 ÷ 6 = 7 L/100 km"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "600 over 42 gives kilometres per litre. Check which goes on top.",
          "write": "✗ 600 ÷ 42"
        },
        {
          "say": "Write units on every line. 45 alone means nothing.",
          "write": "45 pages/min"
        },
        {
          "say": "Change units first. 750 grams is 0.75 kilograms.",
          "write": "750 g = 0.75 kg"
        }
      ]
    },

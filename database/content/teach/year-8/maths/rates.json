    {
      "heading": "Unit rates",
      "lines": [
        {
          "say": "A unit rate is the amount for one.",
          "write": "unit rate = for 1"
        },
        {
          "say": "A printer prints 360 pages in 8 minutes.",
          "write": "360 pages in 8 min"
        },
        {
          "say": "Divide by the minutes. 360 divided by 8 is 45.",
          "write": "360 ÷ 8 = 45 pages/min"
        },
        {
          "say": "The amount before per goes on top.",
          "write": "per = ÷"
        }
      ]
    },
    {
      "heading": "Using a rate",
      "lines": [
        {
          "say": "Amount equals rate times time. In 4 minutes, 180 pages.",
          "write": "45 × 4 = 180 pages"
        },
        {
          "say": "Time equals amount divided by rate. 900 pages takes 20 minutes.",
          "write": "900 ÷ 45 = 20 min"
        },

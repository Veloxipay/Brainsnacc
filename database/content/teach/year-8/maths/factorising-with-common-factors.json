    {
      "heading": "Finding the HCF",
      "lines": [
        {
          "say": "Find the HCF of the numbers first.",
          "write": "12a²b and 18ab²"
        },
        {
          "say": "12 and 18 share 6.",
          "write": "HCF(12, 18) = 6"
        },
        {
          "say": "Then take each letter in every term, with its lowest power.",
          "write": "lowest power wins"
        },
        {
          "say": "a and b are in both, each to the power one. HCF is 6ab.",
          "write": "HCF = 6ab"
        },
        {
          "say": "The HCF of 6x squared and 9x is 3x, not 3x squared.",
          "write": "HCF(6x², 9x) = 3x"
        }
      ]
    },
    {
      "heading": "How to factorise",
      "lines": [
        {
          "say": "Factorise 12x plus 18. The HCF is 6.",
          "write": "12x + 18",
          "diagram": "diagrams/y8/maths/factorising-with-common-factors-reverse.svg",
          "alt": "Rectangles 12x and 18 with height 6 and unknown widths"
        },
        {
          "say": "Divide each term by 6. 2x and 3.",
          "write": "12x ÷ 6 = 2x,  18 ÷ 6 = 3",
          "diagram": "diagrams/y8/maths/factorising-with-common-factors-ex1.svg",
          "alt": "Area model height 6, widths 2x and 3"
        },
        {
          "say": "So 12x plus 18 is 6 times 2x plus 3.",
          "write": "6(2x + 3)"
        },
        {
          "say": "Check by expanding. You get 12x plus 18 back.",
          "write": "6 × 2x + 6 × 3 ✓"
        },
        {
          "say": "10a squared minus 15a? HCF is 5a. Answer: 5a times 2a minus 3.",
          "write": "5a(2a − 3)"
        }
      ]
    },
    {
      "heading": "Fully factorised",
      "lines": [
        {
          "say": "2 times 6x plus 9 is correct, but not finished.",
          "write": "2(6x + 9)"
        },
        {
          "say": "6x and 9 still share 3. Look inside the bracket.",
          "write": "6x, 9 share 3",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Taking out 2 leaves a common factor",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "2(6x + 9)",
                "size": 38,
                "color": "grey",
                "anchor": "middle",
                "bold": true,
                "change": "remove"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "6x and 9 still share 3",
                "size": 22,
                "color": "red",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "6(2x + 3)",
                "size": 42,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Take out the HCF and you're done in one step.",
          "write": "6(2x + 3) ✓"
        }
      ]
    },
    {
      "heading": "Ones and negatives",
      "lines": [
        {
          "say": "If a whole term is the HCF, it leaves a 1 behind.",
          "write": "5x + 5 = 5(x + 1)"
        },
        {
          "say": "3a squared minus a is a times 3a minus 1. Divide, don't delete.",
          "write": "a(3a − 1)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Dividing a by a leaves 1",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "3a² − a",
                "size": 38,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 180,
                "y": 150,
                "text": "3a² ÷ a = 3a",
                "size": 22,
                "color": "blue",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 150,
                "text": "a ÷ a = 1",
                "size": 22,
                "color": "blue",
                "anchor": "middle",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "a(3a − 1)",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Taking out a negative flips every sign inside.",
          "write": "−3x − 12 = −3(x + 4)"
        },
        {
          "say": "A bracket can be the common factor too.",
          "write": "x(x + 3) + 5(x + 3) = (x + 3)(x + 5)"
        },
        {
          "say": "Mental maths: 7 times 36 plus 7 times 64 is 7 times 100.",
          "write": "= 700"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Factorising is expanding in reverse.",
          "write": "reverse of expanding"
        },
        {
          "say": "HCF of the numbers, then letters with the lowest power.",
          "write": "lowest power wins"
        },
        {
          "say": "Divide, don't delete. A term equal to the HCF leaves 1.",
          "write": "leave the 1"
        },
        {
          "say": "Always expand to check, and look inside the bracket.",
          "write": "check ✓"
        }
      ]
    }
  ]
}
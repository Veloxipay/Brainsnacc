    {
      "heading": "Expanding in reverse",
      "lines": [
        {
          "say": "Expanding 4 times x plus 5 gives 4x plus 20.",
          "write": "4(x + 5) → 4x + 20"
        },
        {
          "say": "Factorising goes back the other way.",
          "write": "4x + 20 → 4(x + 5)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Expand and factorise are opposites",
            "items": [
              {
                "kind": "text",
                "x": 130,
                "y": 140,
                "text": "4(x + 5)",
                "size": 32,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 430,
                "y": 140,
                "text": "4x + 20",
                "size": 32,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 210,
                "y": 100,
                "x2": 350,
                "y2": 100,
                "color": "blue"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "expand",
                "size": 18,
                "color": "blue",
                "anchor": "middle"
              },
              {
                "kind": "arrow",
                "x": 350,
                "y": 180,
                "x2": 210,
                "y2": 180,
                "color": "green",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "factorise",
                "size": 18,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "It helps simplify fractions and solve equations later on."
        }
      ]
    },

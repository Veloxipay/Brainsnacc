  "title": "Order of operations with integers",
  "frames": [
    {
      "heading": "BIDMAS with more layers",
      "lines": [
        {
          "say": "Brackets, indices, divide and multiply, then add and subtract.",
          "write": "B  I  D M  A S"
        },
        {
          "say": "Divide and multiply are equal partners. Work left to right.",
          "write": "D M: left to right"
        },
        {
          "say": "Add and subtract are equal partners too.",
          "write": "A S: left to right"
        },
        {
          "say": "The new part is spotting every grouping symbol.",
          "write": "find every group"
        }
      ]
    },

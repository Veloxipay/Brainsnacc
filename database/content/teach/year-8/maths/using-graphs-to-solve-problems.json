      "heading": "Reading a graph both ways",
      "lines": [
        {
          "say": "Know x, want y? Go up from x to the line, then across.",
          "write": "x → line → y"
        },
        {
          "say": "Know y, want x? Go across from y to the line, then down.",
          "write": "y → line → x"
        },

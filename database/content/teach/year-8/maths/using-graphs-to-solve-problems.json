        {
          "say": "First part. 240 over 3 is 80 kilometres per hour.",
          "write": "240 ÷ 3 = 80 km/h"
        },
        {
          "say": "Flat part. Distance isn't changing, so the car has stopped for an hour.",
          "write": "flat = stopped"
        },
        {
          "say": "Last part. 160 over 2 is 80 kilometres per hour again.",
          "write": "160 ÷ 2 = 80 km/h"
        },
        {
          "say": "Steeper means faster.",
          "write": "steeper = faster"
        }

                "text": "zoom: × 2 → same shape",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Stretch only the width and it looks squashed. The ratio changed.",
          "write": "✗ 12 : 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Photo rectangles 4 by 3 and 8 by 6 keep the same shape; stretching only the width changes it",
            "items": [

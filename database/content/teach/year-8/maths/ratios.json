{
  "level": "Year 8",
  "subject": "maths",
  "title": "Ratios",
  "frames": [
    {
      "heading": "Zooming a photo",
      "lines": [
        {
          "say": "A photo is 4 units wide and 3 tall. Width to height is 4 to 3.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Photo rectangles 4 by 3 and 8 by 6 keep the same shape; stretching only the width changes it",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 150,
                "w": 80,
                "h": 60,
                "fill": "blue",
                "label": "4 : 3"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "zoom: × 2 → same shape",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Zoom in. Both sides double, 8 by 6. Same shape.",
          "write": "4 : 3 = 8 : 6",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 270,
            "alt": "Photo rectangles 4 by 3 and 8 by 6 keep the same shape; stretching only the width changes it",

{
  "level": "Year 8",
  "subject": "maths",
  "title": "Volume of prisms and cylinders",
  "frames": [
    {
      "heading": "Prisms and cross-sections",
      "lines": [
        {
          "say": "A prism has two identical parallel ends joined by flat sides.",
          "write": "prism",
          "diagram": "diagrams/y8/maths/volume-of-prisms-and-cylinders-prism.svg",
          "alt": "Prism with shaded cross-section A and length h"
        },
        {
          "say": "Slice it parallel to the ends. Every slice is the same shape.",
          "write": "cross-section",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 310,
            "alt": "Triangular cross-section repeated along the length of the prism",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    60,
                    250
                  ],
                  [
                    200,
                    250
                  ],
                  [
                    60,
                    130
                  ]
                ],
                "fill": "orange",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 140,
                "y": 290,
                "text": "A = cross-section",
                "size": 18,
                "color": "orange",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "That shape is the cross-section. Prisms are named after it.",
          "write": "triangular, trapezoidal …"

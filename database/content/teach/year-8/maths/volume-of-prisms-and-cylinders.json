                "change": "add",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 280,
                "y": 150,
                "r": 5,
                "fill": "black"
              }
            ]
          }
        },
        {
          "say": "Convert to the same units first. Round pi only at the end.",
          "write": "same units, round last"
        }
      ]

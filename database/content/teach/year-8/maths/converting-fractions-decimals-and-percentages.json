{
  "level": "Year 8",
  "subject": "maths",
  "title": "Converting fractions, decimals and percentages",
  "frames": [
    {
      "heading": "Three ways to write one amount",
      "lines": [
        {
          "say": "Fractions, decimals and percentages are like three currencies.",
          "write": "fraction • decimal • percentage"
        },
        {
          "say": "The amount never changes. Only how it's written.",
          "write": "1/4 = 0.25 = 25%",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "One quarter in three forms",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 80,
                "w": 150,
                "h": 90,
                "fill": "blue",
                "label": "1/4"
              },
              {
                "kind": "text",
                "x": 195,
                "y": 135,
                "text": "=",
                "size": 30,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "rect",
                "x": 220,
                "y": 80,
                "w": 150,
                "h": 90,
                "fill": "orange",
                "change": "add",
                "label": "0.25"
              },
              {
                "kind": "text",
                "x": 395,
                "y": 135,
                "text": "=",
                "size": 30,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "rect",
                "x": 420,
                "y": 80,
                "w": 120,
                "h": 90,
                "fill": "green",
                "change": "add",
                "label": "25%"
              }
            ]
          }
        },
        {
          "say": "To compare, turn everything into one form.",
          "write": "one common form"
        }
      ]
    },
    {
      "heading": "The conversion map",
      "lines": [
        {
          "say": "Percentage to decimal: divide by 100.",
          "write": "250% = 2.5,  0.6% = 0.006",
          "diagram": "diagrams/y8/maths/converting-fractions-decimals-and-percentages-map.svg",
          "alt": "Conversion map between fraction, decimal and percentage"
        },
        {
          "say": "Decimal to percentage: multiply by 100. Two jumps right.",
          "write": "1.08 = 108%",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Decimal point jumps two places right",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 90,
                "text": "0.045",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 250,
                "y": 120,
                "x2": 330,
                "y2": 120,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "4.5%",
                "size": 44,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Percentage to fraction: put it over 100 and simplify.",
          "write": "85% = 85/100 = 17/20"
        },
        {
          "say": "Fraction to percentage: multiply by 100 percent.",
          "write": "5/8 × 100% = 62.5%"
        }
      ]
    },
    {
      "heading": "Over 100 percent",
      "lines": [
        {
          "say": "100 percent is one whole.",
          "write": "100% = 1"
        },
        {
          "say": "So 175 percent is 1.75, or one and three quarters.",
          "write": "175% = 1.75 = 1¾",
          "diagram": "diagrams/y8/maths/converting-fractions-decimals-and-percentages-over100.svg",
          "alt": "Double number line showing 175% = 1¾"
        },
        {
          "say": "2.75 is 275 percent. And as a mixed number, two and three quarters.",
          "write": "2.75 = 275% = 2¾"
        },
        {
          "say": "Writing 1.5 as 1.5 percent is a mistake. It's 150 percent.",
          "write": "1.5 = 150%"
        }
      ]
    },
    {
      "heading": "Fractional percentages",
      "lines": [
        {
          "say": "12 and a half percent. Put it over 100.",
          "write": "12½% = 12.5/100"
        },
        {
          "say": "Clear the decimal. Times top and bottom by 10.",
          "write": "= 125/1000",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Simplifying 125 over 1000",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 140,
                "text": "12.5/100",
                "size": 34,
                "color": "grey",
                "anchor": "middle",
                "change": "remove"
              },
              {
                "kind": "arrow",
                "x": 250,
                "y": 130,
                "x2": 310,
                "y2": 130,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 420,
                "y": 140,
                "text": "125/1000",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "= 1/8",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Simplify by 125. That's one eighth.",
          "write": "= 1/8"
        },
        {
          "say": "0.75 percent becomes 75 over 10 000. That's 3 over 400.",
          "write": "0.75% = 3/400"
        },
        {
          "say": "0.5 percent is not 0.5. It's 0.005, half of one percent.",
          "write": "0.5% = 0.005"
        }
      ]
    },
    {
      "heading": "Recurring decimals",
      "lines": [
        {
          "say": "One third is 0.3 recurring. That's 33 and a third percent.",
          "write": "1/3 = 33⅓%"
        },
        {
          "say": "Five sixths: 500 over 6 percent. 83 remainder 1.",
          "write": "5/6 = 83⅓% ≈ 83.3%"
        },
        {
          "say": "Keep it exact until the end. Rounding early gives 33, not 33 and a third.",
          "write": "round at the end"
        },
        {
          "say": "Eighths go up by 12 and a half. 3 eighths is 37.5 percent.",
          "write": "1/8 12.5%  3/8 37.5%"
        }
      ]
    },
    {
      "heading": "Percentage of an amount",
      "lines": [
        {
          "say": "80 centimetres as a percentage of 15 metres.",
          "write": "part ÷ whole × 100%"
        },
        {
          "say": "Units first. 15 metres is 1500 centimetres.",
          "write": "15 m = 1500 cm"
        },
        {
          "say": "80 over 1500, times 100. That's 5 and a third percent.",
          "write": "= 5⅓% ≈ 5.3%"
        },
        {
          "say": "Doing 80 divided by 15 mixes units. That's the trap.",
          "write": "✗ 80 ÷ 15"
        }
      ]
    },
    {
      "heading": "Ordering",
      "lines": [
        {
          "say": "Order these: 0.6 recurring, 65 percent, 5 eighths, 0.649.",
          "write": "0.6̇, 65%, 5/8, 0.649"
        },
        {
          "say": "Change them all to percentages.",
          "write": "66.6̇%, 65%, 62.5%, 64.9%"
        },
        {
          "say": "Place them on a line. 5 eighths, 0.649, 65 percent, 0.6 recurring.",
          "write": "5/8, 0.649, 65%, 0.6̇",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Ordered on a number line",
            "items": [
              {
                "kind": "line",
                "x": 40,
                "y": 200,
                "x2": 520,
                "y2": 200,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 40,
                "y": 240,
                "text": "62%",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 136,
                "y": 240,
                "text": "63%",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 232,
                "y": 240,
                "text": "64%",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 328,
                "y": 240,
                "text": "65%",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 424,
                "y": 240,
                "text": "66%",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 520,
                "y": 240,
                "text": "67%",
                "size": 16,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "circle",
                "x": 88.0,
                "y": 200,
                "r": 10,
                "fill": "blue",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 88.0,
                "y": 170,
                "text": "5/8",
                "size": 20,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 318.40000000000055,
                "y": 200,
                "r": 10,
                "fill": "blue",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 318.40000000000055,
                "y": 130,
                "text": "0.649",
                "size": 20,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 328,
                "y": 200,
                "r": 10,
                "fill": "blue",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 328,
                "y": 170,
                "text": "65%",
                "size": 20,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "circle",
                "x": 488.32000000000016,
                "y": 200,
                "r": 10,
                "fill": "blue",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 488.32000000000016,
                "y": 130,
                "text": "0.6̇",
                "size": 20,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Two jumps right to get a percentage.",
          "write": "× 100"
        },
        {
          "say": "100 percent is one whole.",
          "write": "100% = 1"
        },
        {
          "say": "Thirds are tricky. 33 and a third, 66 and two thirds.",
          "write": "33⅓%  66⅔%"
        },
        {
          "say": "Same units, then divide.",
          "write": "part ÷ whole × 100%"
        }
      ]
    }
  ]
}
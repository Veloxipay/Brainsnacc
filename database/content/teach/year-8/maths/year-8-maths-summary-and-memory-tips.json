{
  "level": "Year 8",
  "subject": "maths",
  "title": "Year 8 Maths summary and memory tips",
  "frames": [
    {
      "heading": "Integers",
      "lines": [
        {
          "say": "Here's all of Year 8 on one sheet. First, integers.",
          "write": "Integers"
        },
        {
          "say": "Simplify double signs. 5 take minus 3 is 5 plus 3, which is 8.",
          "write": "5 − (−3) = 8",
          "draw": {
            "type": "numberline",
            "from": -1,
            "to": 10,
            "start": 5,
            "jump": 3
          }
        },
        {
          "say": "Multiplying? Count the negatives. Even gives positive, odd gives negative.",
          "write": "even − → +   odd − → −"
        },
        {
          "say": "Brackets matter. Minus 3, all squared, is 9. But minus 3 squared is minus 9.",
          "write": "(−3)² = 9   −3² = −9"
        },
        {
          "say": "Same signs smile, different signs frown.",
          "write": "same signs smile"
        }
      ]
    },
    {
      "heading": "Angles and shapes",
      "lines": [
        {
          "say": "Parallel lines. F angles are equal, Z angles are equal.",
          "write": "F equal, Z equal",
          "diagram": "diagrams/y8/maths/year-8-maths-summary-and-memory-tips-angles.svg",
          "alt": "Parallel lines cut by a transversal with a 70 degree angle and angles a and b"
        },
        {
          "say": "C angles, co-interior, add to 180 degrees.",
          "write": "C: add to 180°"
        },
        {
          "say": "Triangle angles add to 180. Quadrilateral angles add to 360.",
          "write": "△ 180°   □ 360°"
        },
        {
          "say": "A polygon splits into n take 2 triangles from one corner.",
          "write": "(n − 2) × 180°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 325,
            "alt": "A pentagon split into 3 triangles",
            "items": [

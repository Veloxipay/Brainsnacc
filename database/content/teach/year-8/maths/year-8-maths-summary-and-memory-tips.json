                "text": "5 sides → 3 triangles → 540°",
                "size": 18,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Exterior angles always add to 360. A full turn.",
          "write": "exterior sum = 360°"
        }
      ]
    },
    {
      "heading": "Fractions, decimals and percentages",
      "lines": [
        {
          "say": "Percentages use multipliers. 15 percent up is times 1.15.",
          "write": "↑15%: × 1.15   ↓15%: × 0.85"
        },
        {
          "say": "80 dollars increased by 15 percent is 92 dollars.",
          "write": "80 × 1.15 = $92",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "$80 plus 15 percent",
            "items": [
              {
                "kind": "rect",
                "x": 40,
                "y": 80,
                "w": 400,
                "h": 60,
                "fill": "blue",
                "label": "$80"
              },
              {
                "kind": "rect",
                "x": 440,
                "y": 80,
                "w": 60,
                "h": 60,
                "fill": "green",
                "change": "add",
                "label": "+$12"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "80 × 1.15 = 92",
                "size": 30,
                "color": "purple",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Percentage profit is always out of the cost price.",
          "write": "profit % of COST"
        },
        {
          "say": "Repeated changes multiply. They don't add.",
          "write": "changes multiply"
        },
        {
          "say": "Pi and root 2 never end or repeat. They're irrational.",
          "write": "π, √2: irrational"
        }
      ]
    },
    {
      "heading": "Measurement and Pythagoras",
      "lines": [
        {
          "say": "Pythagoras. c squared equals a squared plus b squared.",
          "write": "c² = a² + b²",
          "diagram": "diagrams/y8/maths/year-8-maths-summary-and-memory-tips-pythagoras.svg",
          "alt": "Right-angled triangle with sides 6, 8 and 10 cm"
        },
        {
          "say": "6 squared plus 8 squared is 100. So the hypotenuse is 10.",
          "write": "36 + 64 = 100 → 10 cm"
        },
        {
          "say": "Longest side? Add. Shorter side? Subtract.",
          "write": "Longest? Add. Shorter? Subtract."
        },
        {
          "say": "Cherry pie is delicious, apple pies are too.",
          "write": "C = πd   A = πr²"
        },
        {
          "say": "Prism volume is cross-section area times length.",
          "write": "V = A × h"
        }
      ]
    },
    {
      "heading": "Algebra and index laws",
      "lines": [
        {
          "say": "Expanding. The term outside multiplies every term inside.",
          "write": "3(4 − 5x) = 12 − 15x"
        },
        {
          "say": "Factorising is the reverse. Take out the HCF.",
          "write": "6x² + 9x = 3x(2x + 3)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "Factorising out 3x",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 90,
                "text": "6x² + 9x",
                "size": 44,
                "color": "black",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 280,
                "y": 110,
                "x2": 280,
                "y2": 160,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "3x(2x + 3)",
                "size": 44,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Times, add the powers. Divide, subtract. Bracket, multiply.",
          "write": "× add  ÷ subtract  ( ) multiply"
        },
        {
          "say": "Anything except zero, to the power zero, is 1.",
          "write": "a⁰ = 1"
        }
      ]
    },

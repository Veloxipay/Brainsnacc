    {
      "heading": "Data, graphs and transformations",
      "lines": [
        {
          "say": "Probability of not A is 1 take probability of A.",
          "write": "P(not A) = 1 − P(A)"
        },
        {
          "say": "In y equals mx plus c, m for mountain, c for crossing.",
          "write": "y = mx + c",
          "diagram": "diagrams/y8/maths/year-8-maths-summary-and-memory-tips-gradient.svg",
          "alt": "Line y = 3x + 1 through (0, 1) and (2, 7)"
        },
        {
          "say": "Rise 6 over run 2 is a gradient of 3. It crosses at 1.",
          "write": "y = 3x + 1"
        },
        {
          "say": "Congruence tests are SSS, SAS, AAS and RHS. Never AAA.",
          "write": "SSS SAS AAS RHS ✗AAA"
        },
        {
          "say": "Algorithms: new equals old plus change. One counterexample sinks a claim.",
          "write": "new = old + change"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Brackets when you substitute. Count the negatives for the sign.",
          "write": "(−3) in brackets"
        },
        {
          "say": "Always give a reason in geometry.",
          "write": "give reasons"
        },
        {
          "say": "Area is squared, volume is cubed.",
          "write": "cm² area, cm³ volume"
        },
        {
          "say": "Read each tip before a test, and revisit shaky chapters.",
          "write": "revise shaky chapters"
        }

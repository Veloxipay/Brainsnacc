        },
        {
          "say": "Up 10 percent, then down 10 percent, is a 1 percent fall overall.",
          "write": "1.1 × 0.9 = 0.99"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "A 12 percent decrease is times 0.88, not times 0.12.",
          "write": "✗ × 0.12   ✓ × 0.88"
        },
        {
          "say": "A 5 percent increase is 1.05, not 1.5.",
          "write": "5% up → × 1.05"
        },
        {
          "say": "Two 15 percent falls is 27.75 percent, not 30.",
          "write": "0.85 × 0.85 = 0.7225"
        }
      ]
    },

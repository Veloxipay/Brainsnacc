{
  "level": "Year 8",
  "subject": "maths",
  "title": "Linear graphs from rules",
  "frames": [
    {
      "heading": "A rule is a recipe",
      "lines": [
        {
          "say": "A rule like y equals 2x plus 1 works like a vending machine.",
          "write": "y = 2x + 1"
        },
        {
          "say": "Put in an x value. Out comes exactly one y value.",
          "write": "input x → output y"
        },
        {
          "say": "Each input and output together make one point, x comma y.",
          "write": "(x, y)"
        },
        {
          "say": "When x isn't squared, the points make a straight line. It's linear.",
          "write": "linear = straight line"
        }
      ]
    },
    {
      "heading": "Making a table",
      "lines": [
        {
          "say": "Choose some x values. A few negatives, zero, and some positives.",
          "write": "x: −2, −1, 0, 1, 2"
        },
        {
          "say": "Substitute. 2 times minus 2, plus 1, is minus 3.",
          "write": "2 × (−2) + 1 = −3"
        },
        {
          "say": "Minus 1 gives minus 1. Then 0, 1, 2 give 1, 3, 5.",
          "write": "y: −3, −1, 1, 3, 5"
        },
        {
          "say": "y goes up by 2 each time. That's why it's a straight line.",
          "write": "+2 each time"
        }
      ]
    },

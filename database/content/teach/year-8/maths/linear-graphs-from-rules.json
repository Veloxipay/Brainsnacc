    {
      "heading": "Negatives need brackets",
      "lines": [
        {
          "say": "Try y equals 4 minus 2x, with x equals minus 1.",
          "write": "y = 4 − 2x"
        },
        {
          "say": "Put brackets round the negative. 4 minus 2 times minus 1.",
          "write": "4 − 2 × (−1)"
        },
        {
          "say": "Subtracting a negative adds. So y equals 6.",
          "write": "= 4 + 2 = 6"
        },
        {
          "say": "Here y goes down by 2 each time. The line slopes down.",
          "diagram": "diagrams/y8/maths/linear-graphs-from-rules-ex2.svg",
          "alt": "The line y = 4 − 2x through (−1, 6), (0, 4), (1, 2), (2, 0) and (3, −2)"
        }
      ]
    },
    {
      "heading": "Is a point on the line?",
      "lines": [
        {
          "say": "Is minus 2 comma minus 11 on y equals 3x minus 5?",
          "write": "(−2, −11)?"
        },
        {
          "say": "3 times minus 2, minus 5, is minus 11. It matches. Yes!",
          "write": "3 × (−2) − 5 = −11 ✓"
        },
        {
          "say": "What about 2 comma 3? 3 times 2, minus 5, is 1, not 3.",
          "write": "3 × 2 − 5 = 1 ✗"
        },
        {
          "say": "So 2 comma 3 is not on the line."
        }
      ]
    },

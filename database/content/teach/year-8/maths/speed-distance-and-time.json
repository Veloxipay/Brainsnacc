{
  "level": "Year 8",
  "subject": "maths",
  "title": "Speed, distance and time",
  "frames": [
    {
      "heading": "Speed is a rate",
      "lines": [
        {
          "say": "Speed is the distance you travel per unit of time.",
          "write": "speed = distance per time"
        },
        {
          "say": "A walkway moving 2 metres each second goes 20 metres in 10 seconds.",
          "write": "2 m/s × 10 s = 20 m",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 240,
            "alt": "Walkway: 20 metres in 10 seconds",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 120,
                "w": 520,
                "h": 40,
                "fill": "grey"
              },
              {
                "kind": "circle",
                "x": 60,
                "y": 100,
                "r": 18,
                "fill": "orange"
              },
              {
                "kind": "circle",
                "x": 460,
                "y": 100,
                "r": 18,
                "fill": "orange",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 90,
                "y": 80,
                "x2": 430,
                "y2": 80,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 260,
                "y": 60,
                "text": "20 m in 10 s",
                "size": 22,
                "color": "purple"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 210,
                "text": "speed: 2 m every second",
                "size": 22,
                "color": "black"
              }
            ]
          }
        },
        {
          "say": "Common units are kilometres per hour and metres per second.",
          "write": "km/h   m/s"
        },
        {
          "say": "Know any two of speed, distance and time, and you find the third."
        }
      ]
    },

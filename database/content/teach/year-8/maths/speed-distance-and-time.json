                "y2": 170,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 280,
                "y": 170,
                "x2": 280,
                "y2": 260,
                "color": "black"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 140,
                "text": "D",
                "size": 44,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 220,
                "y": 240,
                "text": "S",
                "size": 40,
                "color": "black",
                "bold": true
              },
              {
                "kind": "text",
                "x": 340,
                "y": 240,
                "text": "T",
                "size": 40,
                "color": "black",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Match the units. Kilometres per hour goes with hours.",
          "write": "match units"
        },
        {
          "say": "Three point six is the magic number.",
          "write": "÷ 3.6 or × 3.6"
        },
        {
          "say": "Average speed is total distance over total time.",
          "write": "total ÷ total"
        }
      ]
    }

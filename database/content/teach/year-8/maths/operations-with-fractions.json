    {
      "heading": "Adding and subtracting",
      "lines": [
        {
          "say": "First get a common denominator. The LCM of 8 and 6 is 24.",
          "write": "LCD = 24"
        },
        {
          "say": "Minus five eighths is minus fifteen over 24. One sixth is four over 24.",
          "write": "−15/24 + 4/24"
        },
        {
          "say": "Add the tops as integers. Minus 15 plus 4 is minus 11.",
          "write": "= −11/24"
        },
        {
          "say": "Never add the tops and the bottoms. Two thirds plus a quarter isn't three sevenths.",
          "write": "✗ 2/3 + 1/4 = 3/7"
        }
      ]
    },
    {
      "heading": "Multiplying and dividing",
      "lines": [
        {
          "say": "Same signs, positive. Different signs, negative.",
          "write": "same +, different −"
        },
        {
          "say": "Minus two thirds times minus three fifths is plus two fifths.",
          "write": "(−2/3) × (−3/5) = 2/5"
        },
        {
          "say": "To divide, keep the first, change to times, flip the second.",
          "write": "keep, change, flip"
        },
        {
          "say": "Minus 3 and three quarters is minus fifteen quarters. Make it improper first.",
          "write": "−3¾ = −15/4"
        },
        {
          "say": "Times eight fifths. Cancel, then signs differ. Minus 6.",
          "write": "−15/4 × 8/5 = −6"
        },
        {
          "say": "Check. Minus 6 times five eighths is minus 3 and three quarters.",
          "write": "−6 × 5/8 = −3¾ ✓"
        }
      ]
    },
    {
      "heading": "Mixed numbers",
      "lines": [
        {
          "say": "4 and a quarter take away 2 and five sixths.",
          "write": "4¼ − 2⅚"
        },
        {
          "say": "Make them improper. 17 quarters and 17 sixths.",
          "write": "17/4 − 17/6"
        },
        {
          "say": "Over 12, that's 51 twelfths minus 34 twelfths.",
          "write": "51/12 − 34/12"
        },
        {
          "say": "17 twelfths. That's 1 and five twelfths.",
          "write": "= 17/12 = 1 5/12"
        },
        {
          "say": "With a negative mixed number, the sign covers the whole thing.",
          "write": "−3¾ ≠ −3 + ¾"
        }
      ]
    },
    {
      "heading": "Order of operations",
      "lines": [
        {
          "say": "Brackets, powers, times and divide, then add and subtract.",
          "write": "B I D M A S"
        },
        {
          "say": "Minus three quarters, squared. Negative times negative is positive.",
          "write": "(−3/4)² = 9/16"
        },
        {
          "say": "Then times eight ninths. Cancel the 9s and the 8 with 16.",
          "write": "9/16 × 8/9 = 1/2"
        },
        {
          "say": "Without brackets, only three quarters is squared. That gives minus nine sixteenths.",
          "write": "−(3/4)² = −9/16"
        }
      ]
    },

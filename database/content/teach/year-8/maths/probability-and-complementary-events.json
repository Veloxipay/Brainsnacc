    {
      "heading": "Two dice",
      "lines": [
        {
          "say": "Two dice make a 6 by 6 grid. That's 36 outcomes.",
          "diagram": "diagrams/y8/maths/probability-and-complementary-events-ex4.svg",
          "alt": "A 6 by 6 grid of two-dice totals with the six cells totalling 7 shaded on a diagonal"

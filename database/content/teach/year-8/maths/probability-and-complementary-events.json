        {
          "say": "A total of 7 happens 6 ways. So it's one sixth.",
          "write": "P(7) = 6/36 = 1/6"
        },
        {
          "say": "Not 7 is 1 minus one sixth. Five sixths.",
          "write": "P(not 7) = 5/6"
        }

{
  "level": "Year 8",
  "subject": "maths",
  "title": "Probability and complementary events",
  "frames": [
    {
      "heading": "On or off",
      "lines": [
        {
          "say": "A 30 percent chance of rain. What's the chance it stays dry?",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "A bar from 0 to 1: P(rain) = 0.3 and the rest, P(not rain) = 0.7",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 150,
                "h": 70,
                "fill": "blue",
                "label": "P(rain) = 0.3"
              },
              {
                "kind": "text",
                "x": 30,
                "y": 180,
                "text": "0",
                "size": 18,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 530,
                "y": 180,
                "text": "1",
                "size": 18,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "rect",
                "x": 180,
                "y": 80,
                "w": 350,
                "h": 70,
                "fill": "white",
                "label": "?"
              }
            ]
          }
        },
        {
          "say": "Rain and no rain share the whole between them. So 0.7.",
          "write": "P(not A) = 1 − P(A)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 250,
            "alt": "A bar from 0 to 1: P(rain) = 0.3 and the rest, P(not rain) = 0.7",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 80,
                "w": 150,
                "h": 70,
                "fill": "blue",
                "label": "P(rain) = 0.3"
              },
              {
                "kind": "text",
                "x": 30,
                "y": 180,
                "text": "0",
                "size": 18,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 530,
                "y": 180,
                "text": "1",
                "size": 18,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "rect",
                "x": 180,
                "y": 80,
                "w": 350,
                "h": 70,
                "fill": "yellow",
                "label": "P(not rain) = 0.7",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "0.3 + 0.7 = 1",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "Like a light switch. It's on or off. Never both.",
          "write": "A and not A"
        },
        {
          "say": "Not A is called the complement of A.",
          "write": "complement = not A"
        }
      ]
    },
    {
      "heading": "Complementary events",
      "lines": [
        {
          "say": "Cards 1 to 20. A is a multiple of 3. That's 6 cards.",
          "write": "3, 6, 9, 12, 15, 18"
        },
        {
          "say": "So P of A is 6 over 20, which is three tenths.",
          "write": "P(A) = 6/20 = 3/10"
        },
        {
          "say": "Not A is 1 minus three tenths. Seven tenths.",
          "write": "P(not A) = 7/10"
        },
        {
          "say": "Watch the boundary. The complement of less than 3 is 3 or more.",
          "write": "< 3  vs  3 or more"
        }
      ]
    },

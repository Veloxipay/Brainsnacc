    {
      "heading": "Length: one factor",
      "lines": [
        {
          "say": "1 centimetre is 10 millimetres. 1 kilometre is 1000 metres.",
          "write": "10 • 100 • 1000"
        },
        {
          "say": "Big unit to small unit, multiply.",
          "write": "big → small: ×"
        },
        {
          "say": "Small unit to big unit, divide.",
          "write": "small → big: ÷"
        },
        {
          "say": "Big to small, the number gets bigger.",
          "write": "4.5 m = 450 cm"
        }
      ]
    },
    {
      "heading": "Area: square the factor",
      "lines": [
        {
          "say": "Area is length times length. So use the factor twice.",
          "write": "square it for area",
          "diagram": "diagrams/y8/maths/converting-units-of-length-area-and-volume-cm2.svg",
          "alt": "1 cm² is a 10 by 10 grid of 1 mm squares"
        },
        {
          "say": "1 square centimetre is 10 times 10, which is 100 square millimetres.",
          "write": "1 cm² = 100 mm²"
        },
        {
          "say": "1 square kilometre is a million square metres.",
          "write": "1 km² = 1 000 000 m²"
        },
        {
          "say": "Convert 3.5 square metres. Times 10 000.",
          "write": "3.5 × 10 000 = 35 000 cm²"
        }
      ]
    },
    {
      "heading": "Hectares",
      "lines": [
        {
          "say": "A hectare is a square 100 metres by 100 metres.",
          "write": "1 ha = 10 000 m²",
          "diagram": "diagrams/y8/maths/converting-units-of-length-area-and-volume-hectare.svg",
          "alt": "1 hectare is 100 m by 100 m"
        },
        {
          "say": "Hundred by hundred. About a big sports oval.",
          "write": "hundred by hundred"
        },
        {
          "say": "A paddock is 350 by 120 metres. That's 42 000 square metres.",
          "write": "350 × 120 = 42 000 m²",
          "diagram": "diagrams/y8/maths/converting-units-of-length-area-and-volume-ex3.svg",
          "alt": "Paddock 350 m by 120 m"
        },
        {
          "say": "Divide by 10 000. It's 4.2 hectares.",
          "write": "= 4.2 ha"
        },
        {
          "say": "And 1 square kilometre is 100 hectares.",
          "write": "1 km² = 100 ha"
        }
      ]
    },
    {
      "heading": "Volume: cube the factor",
      "lines": [
        {
          "say": "Volume is length times width times height. Use the factor three times.",
          "write": "cube it for volume",
          "diagram": "diagrams/y8/maths/converting-units-of-length-area-and-volume-cm3.svg",
          "alt": "1 cm³ = 1000 mm³"
        },
        {
          "say": "1 cubic centimetre is 1000 cubic millimetres, not 10.",
          "write": "1 cm³ = 1000 mm³"
        },
        {
          "say": "1 cubic metre is a million cubic centimetres.",
          "write": "1 m³ = 1 000 000 cm³",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Factor used once, twice, three times",
            "items": [

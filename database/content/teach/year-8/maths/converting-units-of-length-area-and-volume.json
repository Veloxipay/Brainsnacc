              }
            ]
          }
        },
        {
          "say": "120 times 50 times 40 is 240 000 cubic centimetres.",
          "write": "= 240 000 cm³"
        },
        {
          "say": "That's 240 000 millilitres, or 240 litres.",
          "write": "= 240 L"
        },
        {
          "say": "Reread the question. It wanted litres, not millilitres.",
          "write": "check the unit"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Square it for area. Cube it for volume.",
          "write": "² → twice, ³ → three times"
        },
        {
          "say": "Hectare: hundred by hundred, 10 000 square metres.",
          "write": "1 ha = 10 000 m²"
        },
        {
          "say": "1 cubic centimetre is 1 millilitre.",
          "write": "1 cm³ = 1 mL"
        },
        {
          "say": "Convert lengths to one unit first, then multiply.",
          "write": "convert first"
        }
      ]
    }

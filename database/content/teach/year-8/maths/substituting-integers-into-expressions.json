          }
        },
        {
          "say": "So 5 take x, with x minus 3, is 5 plus 3.",
          "write": "5 − (−3) = 8"
        }
      ]
    },
    {
      "heading": "Longer expressions",
      "lines": [
        {
          "say": "Evaluate 2x squared take 3x plus 1, when x is minus 4.",
          "write": "2x² − 3x + 1"
        },
        {
          "say": "Substitute with brackets.",
          "write": "2(−4)² − 3(−4) + 1"
        },
        {
          "say": "Indices first. Minus 4 squared is 16.",
          "write": "2 × 16 − 3(−4) + 1"
        },
        {
          "say": "Multiply. 32, then minus minus 12.",
          "write": "32 − (−12) + 1"
        },
        {
          "say": "Change two signs. 32 plus 12 plus 1 is 45.",
          "write": "32 + 12 + 1 = 45",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 230,
            "alt": "Minus negative 12 becomes plus 12",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "32 − (−12) + 1",
                "size": 40,
                "color": "black"
              },
              {
                "kind": "rect",
                "x": 160,
                "y": 30,
                "w": 150,
                "h": 70,
                "fill": "none",
                "change": "highlight",
                "color": "red"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 190,
                "text": "32 + 12 + 1 = 45",
                "size": 40,
                "color": "green",
                "change": "add",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Formulas in real life",
      "lines": [
        {
          "say": "Temperature above a town is 18 take 6h. h is the height in kilometres.",
          "write": "T = 18 − 6h"
        },
        {
          "say": "Five kilometres up, substitute h equals 5.",
          "write": "T = 18 − 6(5)"
        },
        {
          "say": "Six times five is 30. 18 take 30 is minus 12.",
          "write": "T = −12 °C",
          "draw": {
            "type": "numberline",
            "from": -14,
            "to": 20,
            "start": 18,
            "jump": -30
          }
        },
        {
          "say": "Minus 12 degrees. Below freezing makes sense high in the sky."
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Always substitute into brackets.",
          "write": "x = −3 → (−3)"
        },
        {
          "say": "Square only what the power touches.",
          "write": "2x² ≠ (2x)²"
        },
        {
          "say": "Minus x means the opposite of x.",
          "write": "−x = opposite"
        },
        {
          "say": "After substituting, use BIDMAS. Times before minus.",
          "write": "BIDMAS"
        },
        {
          "say": "Minus a negative is plus.",
          "write": "− (−) = +"
        }
      ]
    }
  ]
}

{
  "level": "Year 8",
  "subject": "maths",
  "title": "Angle sums of triangles",
  "frames": [
    {
      "heading": "Angles in a triangle add to 180°",
      "lines": [
        {
          "say": "Every triangle's three angles add to 180 degrees.",
          "write": "a + b + c = 180°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Triangle with angles a, b, c",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    80,
                    250
                  ],
                  [
                    480,
                    250
                  ],
                  [
                    220,
                    60
                  ]
                ],
                "fill": "teal"
              },
              {
                "kind": "text",
                "x": 115,
                "y": 235,
                "text": "b",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 440,
                "y": 235,
                "text": "c",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 220,
                "y": 95,
                "text": "a",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Tear off the three corners and line them up.",
          "write": "tear the corners"
        },
        {
          "say": "They always make a straight line. That's half a turn.",
          "write": "straight line = 180°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Three corners on a straight line",
            "items": [
              {
                "kind": "line",
                "x": 40,
                "y": 220,
                "x2": 520,
                "y2": 220,
                "color": "black"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    280,
                    220
                  ],
                  [
                    130,
                    220
                  ],
                  [
                    180,
                    120
                  ]
                ],
                "fill": "blue",
                "change": "add",
                "label": "b"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    280,
                    220
                  ],
                  [
                    180,
                    120
                  ],
                  [
                    380,
                    120
                  ]
                ],
                "fill": "orange",
                "change": "add",
                "label": "a"
              },
              {
                "kind": "polygon",
                "points": [
                  [
                    280,
                    220
                  ],
                  [
                    380,
                    120
                  ],
                  [
                    430,
                    220
                  ]
                ],
                "fill": "green",
                "change": "add",
                "label": "c"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 270,
                "text": "b + a + c = 180°",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "But tearing paper shows one triangle. A proof shows every triangle.",
          "write": "we need a proof"
        }
      ]
    },
    {
      "heading": "The proof",
      "lines": [
        {
          "say": "Draw a line through A, parallel to BC.",
          "diagram": "diagrams/y8/maths/angle-sums-of-triangles-proof.svg",
          "alt": "Triangle ABC with a dashed line through A parallel to BC"
        },
        {
          "say": "The left angle is alternate to the angle at B. So it's b.",
          "write": "alternate angles: b"
        },
        {
          "say": "The right angle is alternate to the angle at C. So it's c.",
          "write": "alternate angles: c"
        },
        {
          "say": "b, a and c sit on a straight line. So they add to 180.",
          "write": "b + a + c = 180°"
        },
        {
          "say": "Every step follows a known rule. That's what makes it a proof.",
          "write": "proof ✓"
        }
      ]
    },
    {
      "heading": "Exterior angle rule",
      "lines": [
        {
          "say": "Extend one side. The angle outside is an exterior angle.",
          "diagram": "diagrams/y8/maths/angle-sums-of-triangles-exterior.svg",
          "alt": "Exterior angle ACD equals a plus b"
        },
        {
          "say": "It equals the two inside angles opposite it.",
          "write": "exterior = a + b"
        },
        {
          "say": "Outside equals opposite two.",
          "write": "outside = opposite two"
        },
        {
          "say": "Triangle PQR: P is 38, Q is 76. Find the exterior angle at R.",
          "diagram": "diagrams/y8/maths/angle-sums-of-triangles-ex1.svg",
          "alt": "Triangle PQR with exterior angle PRS"
        },
        {
          "say": "Add the opposite two. 38 plus 76 is 114 degrees.",
          "write": "∠PRS = 38 + 76 = 114°"
        },
        {
          "say": "Check: the inside angle at R is 66. 38, 76 and 66 make 180.",
          "write": "38 + 76 + 66 = 180 ✓"
        }
      ]
    },
    {
      "heading": "Isosceles triangles",
      "lines": [
        {
          "say": "An isosceles triangle has two equal sides and two equal base angles.",
          "write": "base angles equal",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Isosceles triangle",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    130,
                    260
                  ],
                  [
                    430,
                    260
                  ],
                  [
                    280,
                    50
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 165,
                "y": 245,
                "text": "72°",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 395,
                "y": 245,
                "text": "72°",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 95,
                "text": "?",
                "size": 24,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "line",
                "x": 195,
                "y": 160,
                "x2": 215,
                "y2": 150,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 345,
                "y": 150,
                "x2": 365,
                "y2": 160,
                "color": "black"
              }
            ]
          }
        },
        {
          "say": "Base angles 72 each. Together that's 144.",
          "write": "2 × 72 = 144"
        },
        {
          "say": "So the apex is 180 minus 144. That's 36 degrees.",
          "write": "apex = 36°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Apex found",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    130,
                    260
                  ],
                  [
                    430,
                    260
                  ],
                  [
                    280,
                    50
                  ]
                ],
                "fill": "orange"
              },
              {
                "kind": "text",
                "x": 165,
                "y": 245,
                "text": "72°",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 395,
                "y": 245,
                "text": "72°",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 280,
                "y": 100,
                "text": "36°",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "highlight"
              },
              {
                "kind": "line",
                "x": 195,
                "y": 160,
                "x2": 215,
                "y2": 150,
                "color": "black"
              },
              {
                "kind": "line",
                "x": 345,
                "y": 150,
                "x2": 365,
                "y2": 160,
                "color": "black"
              }
            ]
          }
        },
        {
          "say": "Given the apex, subtract it from 180, then halve.",
          "write": "base = (180 − apex) ÷ 2"
        },
        {
          "say": "Apex 40 gives base angles of 70, not 20. Subtract, then split.",
          "write": "(180 − 40) ÷ 2 = 70"
        },
        {
          "say": "An equilateral triangle has three 60 degree angles.",
          "write": "60° + 60° + 60°"
        }
      ]
    },
    {
      "heading": "Using algebra",
      "lines": [
        {
          "say": "A triangle has angles x, 2x plus 10, and 3x minus 4.",
          "write": "x + 2x + 10 + 3x − 4 = 180"
        },
        {
          "say": "Collect like terms. 6x plus 6 equals 180.",
          "write": "6x + 6 = 180",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Take 6 from both sides",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "6x + 6 = 180",
                "size": 34,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 190,
                "y": 150,
                "text": "− 6",
                "size": 28,
                "color": "red",
                "anchor": "middle",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 400,
                "y": 150,
                "text": "− 6",
                "size": 28,
                "color": "red",
                "anchor": "middle",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "6x = 174",
                "size": 34,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Take 6 from both sides, then divide by 6. x is 29.",
          "write": "6x = 174, x = 29"
        },
        {
          "say": "Don't stop at x. The angles are 29, 68 and 83.",
          "write": "29°, 68°, 83°"
        },
        {
          "say": "Check: 29 plus 68 plus 83 is 180.",
          "write": "✓ 180"
        }
      ]
    },
    {
      "heading": "Isosceles with an exterior angle",
      "lines": [
        {
          "say": "AB equals AC. The exterior angle at C is 118 degrees.",
          "diagram": "diagrams/y8/maths/angle-sums-of-triangles-ex4.svg",
          "alt": "Isosceles triangle ABC with exterior angle 118° at C"
        },
        {
          "say": "Angles on a straight line: angle C is 180 minus 118, which is 62.",
          "write": "∠ACB = 62°"
        },
        {
          "say": "Base angles are equal, so angle B is 62 too.",
          "write": "∠ABC = 62°"
        },
        {
          "say": "So angle A is 180 minus 62 minus 62. That's 56.",
          "write": "∠BAC = 56°"
        },
        {
          "say": "Check: 56 plus 62 is 118, the exterior angle.",
          "write": "56 + 62 = 118 ✓"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Angles in a triangle add to 180 degrees.",
          "write": "180°"
        },
        {
          "say": "Outside equals opposite two.",
          "write": "exterior = a + b"
        },
        {
          "say": "For base angles, subtract, then split.",
          "write": "(180 − apex) ÷ 2"
        },
        {
          "say": "No triangle has two obtuse angles. Give a reason for every step.",
          "write": "reasons!"
        }
      ]
    }
  ]
}
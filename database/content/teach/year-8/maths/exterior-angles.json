  "title": "Exterior angles",
  "frames": [
    {
      "heading": "Turning at the corners",
      "lines": [
        {
          "say": "A robot tracing a shape doesn't use the inside angles.",
          "write": "how far to TURN"
        },
        {
          "say": "It uses how far to turn at each corner. That's the exterior angle.",
          "write": "exterior angle = turn",
          "diagram": "diagrams/y8/maths/exterior-angles-ext.svg",
          "alt": "Pentagon with interior angle i and exterior angle e at C"
        },
        {
          "say": "Extend one side past a corner. The angle to the next side is exterior.",
          "write": "extend the side"
        },
        {
          "say": "Interior and exterior sit on a straight line. They add to 180.",
          "write": "interior + exterior = 180°"
        }
      ]
    },

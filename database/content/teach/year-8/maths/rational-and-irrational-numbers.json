    {
      "heading": "Recurring decimal to fraction",
      "lines": [
        {
          "say": "Let x equal 0.45 recurring. Two digits repeat.",
          "write": "x = 0.4545…"
        },
        {
          "say": "Multiply by 100. The tails line up.",
          "write": "100x = 45.4545…"
        },
        {
          "say": "Subtract. The endless tails cancel. 99x equals 45.",
          "write": "99x = 45"
        },
        {
          "say": "So x is 45 over 99, which is five elevenths.",
          "write": "x = 45/99 = 5/11"
        },
        {
          "say": "Shortcut. The repeating block goes over nines. 0.7 recurring is seven ninths.",
          "write": "0.7̇ = 7/9"
        }
      ]
    },
    {
      "heading": "When the repeat starts late",
      "lines": [
        {
          "say": "0.1 6 recurring. Only the 6 repeats.",
          "write": "x = 0.1666…"
        },
        {
          "say": "10x is 1.666. 100x is 16.666. Same tails.",
          "write": "10x = 1.666…,  100x = 16.666…"
        },
        {
          "say": "Subtract. 90x equals 15. So x is one sixth.",
          "write": "90x = 15 → x = 1/6"
        }
      ]
    },

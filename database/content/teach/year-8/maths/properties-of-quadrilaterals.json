    {
      "heading": "Diagonal properties",
      "lines": [
        {
          "say": "A diagonal joins two opposite corners. Bisect means cut in half.",
          "write": "bisect = cut in half"
        },
        {
          "say": "Parallelogram diagonals bisect each other.",
          "write": "parallelogram: bisect"
        },
        {
          "say": "Rectangle diagonals also have equal length.",
          "write": "rectangle: + equal"
        },
        {
          "say": "Rhombus diagonals cross at 90 degrees, and halve the corner angles.",
          "write": "rhombus: + 90°, halve corners"
        },
        {
          "say": "A square has all of these. A kite's diagonals cross at 90 too.",
          "write": "square: all of them"
        }
      ]
    },

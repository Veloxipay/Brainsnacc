          }
        },
        {
          "say": "Pool the data. 40 top up out of 100 flips.",
          "write": "40 ÷ 100 = 0.4"
        },
        {
          "say": "The combined estimate uses more trials, so it's more reliable.",
          "write": "pool the data"
        },
        {
          "say": "With running totals, use the latest total. Don't add them.",
          "write": "✗ add running totals"
        }
      ]

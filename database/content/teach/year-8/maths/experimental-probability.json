{
  "level": "Year 8",
  "subject": "maths",
  "title": "Experimental probability",
  "frames": [
    {
      "heading": "Learning from experiments",
      "lines": [
        {
          "say": "Will a bottle cap land top up? There's no neat list of outcomes.",
          "write": "run an experiment"
        },
        {
          "say": "So we run trials and count what happens.",
          "write": "trials"
        },
        {
          "say": "Experimental probability is successes divided by trials.",
          "write": "P = successes ÷ trials"
        },
        {
          "say": "A coin landed heads 18 times in 40. That's 0.45.",
          "write": "18/40 = 0.45"
        },
        {
          "say": "For more than 4 on a die, add the frequencies of 5 and 6 first.",
          "write": "add the outcomes"
        }
      ]
    },
    {
      "heading": "Two-step experiments",
      "lines": [
        {
          "say": "Toss two coins. List every outcome: HH, HT, TH, TT.",
          "write": "HH HT TH TT",
          "diagram": "diagrams/y8/maths/experimental-probability-tree.svg",
          "alt": "Tree diagram for two coins"
        },
        {
          "say": "One of each can happen two ways. So its chance is a half.",
          "write": "P(one of each) = 2/4"
        },
        {
          "say": "HT and TH are different. They are not a third each.",
          "write": "HT ≠ TH"
        },
        {
          "say": "In 100 tosses, expect 25, 50 and 25.",
          "write": "expected 25, 50, 25"
        },
        {
          "say": "Results were 22, 53 and 25. Close. The coins look fair.",
          "write": "22, 53, 25",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Column graph",

    {
      "heading": "Working backwards",
      "lines": [
        {
          "say": "The angles add to 1440 degrees. How many sides?",
          "write": "(n − 2) × 180 = 1440"
        },
        {
          "say": "Divide by 180. That gives 8 triangles.",
          "write": "n − 2 = 8"
        },
        {
          "say": "Now add 2. So n is 10. It's a decagon.",
          "write": "n = 10"
        },
        {
          "say": "Divide, then add 2. Don't stop at the triangles.",
          "write": "divide, then add 2"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Not n times 180. A square isn't 720 degrees. It's 360.",
          "write": "✗ n × 180"
        },
        {
          "say": "Not every polygon adds to 360. Only quadrilaterals do.",
          "write": "360° = 4 sides only"
        },
        {
          "say": "Only share equally if the polygon is regular.",
          "write": "÷ n only if regular"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Sides minus 2, times 180.",
          "write": "S = (n − 2) × 180°",

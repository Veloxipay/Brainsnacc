    {
      "heading": "The angle sum rule",
      "lines": [
        {
          "say": "An n-sided polygon makes n minus 2 triangles.",
          "write": "n − 2 triangles"
        },
        {
          "say": "So the angle sum is n minus 2, times 180 degrees.",
          "write": "S = (n − 2) × 180°"
        },
        {
          "say": "Pentagon. 5 minus 2 is 3 triangles. 540 degrees.",
          "write": "3 × 180° = 540°",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A 5-sided polygon split into triangles by diagonals from one corner",

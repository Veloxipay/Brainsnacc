{
  "level": "Year 8",
  "subject": "maths",
  "title": "Interior angles of polygons",
  "frames": [
    {
      "heading": "Angles inside a polygon",
      "lines": [
        {
          "say": "Beehives use hexagons. Soccer balls use pentagons and hexagons.",
          "write": "polygon = straight sides"
        },
        {
          "say": "A polygon is a flat, closed shape with straight sides.",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "A 6-sided polygon split into triangles by diagonals from one corner",
            "items": [
              {
                "kind": "polygon",
                "points": [
                  [
                    280.0,
                    20.0
                  ],
                  [
                    379.6,
                    77.5
                  ],
                  [
                    379.6,
                    192.5
                  ],
                  [
                    280.0,
                    250.0
                  ],
                  [
                    180.4,
                    192.5
                  ],
                  [
                    180.4,
                    77.5
                  ]
                ],
                "fill": "teal"
              }
            ]
          }
        },
        {
          "say": "The angles inside at each corner are the interior angles.",
          "write": "interior angles"
        },
        {
          "say": "n sides means n corners, and n interior angles.",
          "write": "n sides → n angles"
        },
        {
          "say": "Five sides, pentagon. Six, hexagon. Eight, octagon. Ten, decagon.",
          "write": "5 pent, 6 hex, 8 oct, 10 dec"
        }
      ]
    },

    {
      "heading": "Regular polygons",
      "lines": [
        {
          "say": "A regular polygon has all sides and all angles equal.",
          "write": "regular = all equal"
        },
        {
          "say": "So share the angle sum equally between the corners.",
          "write": "(n − 2) × 180° ÷ n"
        },
        {
          "say": "Regular hexagon. 720 divided by 6 is 120 degrees each.",
          "write": "720 ÷ 6 = 120°"
        },
        {
          "say": "Regular dodecagon. 10 times 180 is 1800. Divide by 12: 150 each.",
          "write": "1800 ÷ 12 = 150°"
        }
      ]
    },
    {

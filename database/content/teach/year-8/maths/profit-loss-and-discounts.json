      "lines": [
        {
          "say": "A discount comes off the marked price, the price on the tag.",
          "write": "discount → marked price"
        },
        {
          "say": "30 percent off means you pay 70 percent. Times 0.7.",
          "write": "30% off → × 0.7"
        },

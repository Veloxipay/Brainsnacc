{
  "level": "Year 8",
  "subject": "maths",
  "title": "Profit, loss and discounts",
  "frames": [
    {
      "heading": "A lemonade stand",
      "lines": [
        {
          "say": "You spend 20 dollars on lemons and cups. That's the cost price.",
          "write": "cost price = $20"
        },
        {
          "say": "You sell it all for 35 dollars. That's the selling price.",
          "write": "selling price = $35"
        },
        {
          "say": "35 take away 20 is 15. You made a 15 dollar profit.",
          "write": "profit = 35 − 20 = $15"
        },
        {
          "say": "If you only took 12 dollars, that's an 8 dollar loss.",
          "write": "loss = 20 − 12 = $8"
        }
      ]
    },
    {
      "heading": "Percentage profit or loss",
      "lines": [
        {
          "say": "Write the profit as a percentage of the cost price.",
          "write": "profit ÷ cost × 100%"
        },
        {
          "say": "15 out of 20 is 75 percent profit.",
          "write": "15 ÷ 20 = 75%"
        },
        {
          "say": "Sam bought a bike for 80 and sold it for 64. A 16 dollar loss.",
          "write": "80 − 64 = $16"
        },
        {
          "say": "16 divided by 80 is 0.2. That's a 20 percent loss.",
          "write": "16 ÷ 80 = 20% loss"
        },
        {
          "say": "Always the cost price on the bottom. Profit over cost.",
          "write": "profit over cost"
        }
      ]
    },
    {
      "heading": "Mark-ups",
      "lines": [

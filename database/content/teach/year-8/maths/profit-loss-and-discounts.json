    {
      "heading": "GST",
      "lines": [
        {
          "say": "In Australia, most prices include 10 percent GST.",
          "write": "GST = 10%"
        },
        {
          "say": "Add GST by multiplying by 1.1. 220 dollars becomes 242.",
          "write": "220 × 1.1 = $242"
        },
        {
          "say": "Remove GST by dividing by 1.1. 121 becomes 110.",
          "write": "121 ÷ 1.1 = $110"
        },
        {
          "say": "So the GST in 121 dollars is 11 dollars, not 12.10.",
          "write": "GST = 121 − 110 = $11"
        }
      ]
    },

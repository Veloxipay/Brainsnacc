{
  "level": "Year 8",
  "subject": "maths",
  "title": "Expanding brackets",
  "frames": [
    {
      "heading": "Year 8 brackets",
      "lines": [
        {
          "say": "Brackets let us turn an area or cost formula into something simpler.",
          "write": "expand"
        },
        {
          "say": "Recap: the outside term multiplies every term inside.",
          "write": "a(b + c) = ab + ac"
        },
        {
          "say": "So 3 times x plus 5 is 3x plus 15.",
          "write": "3(x + 5) = 3x + 15",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Rainbow arrows from 3",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "3(x + 5)",
                "size": 44,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 200,
                "y": 110,
                "x2": 265,
                "y2": 150,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 200,
                "y": 110,
                "x2": 345,
                "y2": 150,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 220,
                "text": "3x + 15",
                "size": 44,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "This year, letters and powers can be outside too."
        }
      ]
    },
    {
      "heading": "Letters outside the bracket",
      "lines": [
        {
          "say": "2x times 3x minus 5. Multiply numbers, then letters.",
          "write": "2x(3x − 5)"
        },
        {
          "say": "2x times 3x is 6x squared. Same letter twice gives a square.",
          "write": "2x × 3x = 6x²"
        },
        {
          "say": "2x times negative 5 is negative 10x.",
          "write": "= 6x² − 10x",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Two products from 2x",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 70,
                "text": "2x(3x − 5)",
                "size": 40,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 180,
                "y": 95,
                "x2": 270,
                "y2": 140,
                "color": "blue",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 180,
                "y": 95,
                "x2": 380,
                "y2": 140,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 200,
                "y": 210,
                "text": "6x²",
                "size": 36,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 360,
                "y": 210,
                "text": "− 10x",
                "size": 36,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Negative 4a times 2a minus 3b is negative 8a squared plus 12ab.",
          "write": "−4a(2a − 3b) = −8a² + 12ab"
        },
        {
          "say": "6x squared minus 10x can't be simplified. They're unlike terms.",
          "write": "✗ −4x"
        }
      ]
    },
    {
      "heading": "A minus in front",
      "lines": [
        {
          "say": "Minus x minus 7 means negative 1 times the bracket.",
          "write": "−(x − 7) = −x + 7"
        },
        {
          "say": "Every sign inside flips.",
          "write": "flip every sign"
        },
        {
          "say": "3 times 2y plus 1, minus 2 times y minus 4.",
          "write": "3(2y + 1) − 2(y − 4)"
        },
        {
          "say": "The sign sticks to the number. Multiply by negative 2.",
          "write": "6y + 3 − 2y + 8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Multiplier is negative 2",
            "items": [
              {
                "kind": "text",
                "x": 280,
                "y": 80,
                "text": "− 2(y − 4)",
                "size": 40,
                "color": "black",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "rect",
                "x": 170,
                "y": 40,
                "w": 70,
                "h": 60,
                "fill": "none",
                "change": "highlight"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "−2y + 8",
                "size": 40,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Collect like terms. 4y plus 11.",
          "write": "= 4y + 11"
        },
        {
          "say": "Check with y equals 2. Both give 19.",
          "write": "19 = 19 ✓"
        }
      ]
    },

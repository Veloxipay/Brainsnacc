    {
      "heading": "FOIL",
      "lines": [
        {
          "say": "Every player shakes every hand. That's four products.",
          "write": "4 products"
        },
        {
          "say": "FOIL: First, Outer, Inner, Last.",
          "write": "F O I L"
        },
        {
          "say": "2a minus 3 times a plus 4. First: 2a squared. Outer: 8a.",
          "write": "(2a − 3)(a + 4)"
        },
        {
          "say": "Inner: negative 3 times a. Last: negative 12.",
          "write": "−3a, −12"
        },
        {
          "say": "Collect: 2a squared plus 5a minus 12.",
          "write": "2a² + 5a − 12"
        },
        {
          "say": "Numbers work too. 21 times 34 is 600, 80, 30 and 4.",
          "write": "21 × 34 = 714",
          "diagram": "diagrams/y8/maths/expanding-brackets-number-grid.svg",
          "alt": "Grid for 21 × 34"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "x plus 3 times x plus 5 is not x squared plus 15.",
          "write": "✗ x² + 15"
        },
        {
          "say": "You've lost the middle terms. Check for all four products.",
          "write": "F, O, I, L ✓"
        },
        {
          "say": "x plus 2, squared, is not x squared plus 4.",
          "write": "(x + 2)² = x² + 4x + 4"
        },
        {
          "say": "Check with a number. Put x equals 2 into both.",
          "write": "x = 2 check"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "The outside term multiplies every term inside.",
          "write": "every term"
        },
        {
          "say": "The sign sticks to the number on its right.",
          "write": "−2(y − 4)"
        },
        {
          "say": "Two brackets: First, Outer, Inner, Last.",
          "write": "FOIL"
        },
        {
          "say": "Draw a grid if it helps, then collect like terms.",
          "write": "grid it"
        }
      ]
    }

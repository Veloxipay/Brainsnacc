    {
      "heading": "What is the zero attached to?",
      "lines": [
        {
          "say": "5 x to the zero is 5 times 1. That's 5.",
          "write": "5x⁰ = 5"
        },
        {
          "say": "5x in brackets, to the zero, is 1. The whole bracket gets the zero.",
          "write": "(5x)⁰ = 1"
        },
        {
          "say": "Negatives too. Minus 2, in brackets, to the 4 is 16.",
          "write": "(−2)⁴ = 16"
        },
        {
          "say": "No brackets? Minus 2 to the 4 is minus 16.",
          "write": "−2⁴ = −16"
        }
      ]
    },
    {
      "heading": "Mixing the laws",
      "lines": [
        {
          "say": "Brackets first, then multiply or divide.",
          "write": "brackets first"
        },
        {
          "say": "a squared, cubed, is a to the 6. Times a to the 4 is a to the 10.",
          "write": "(a²)³ × a⁴ = a¹⁰"
        },
        {
          "say": "4 p cubed, squared, over 2 p squared, cubed.",
          "write": "(4p³)² ÷ (2p²)³"
        },
        {
          "say": "Top is 16 p to the 6. Bottom is 8 p to the 6.",
          "write": "16p⁶ ÷ 8p⁶"
        },
        {
          "say": "16 over 8 is 2. p to the 6 over p to the 6 is 1. Answer: 2.",
          "write": "= 2 × p⁰ = 2"
        }
      ]
    },
    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "x cubed, to the 4, is not x to the 7. Multiply, don't add.",
          "write": "✗ x⁷   ✓ x¹²"
        },
        {
          "say": "3 x squared, squared, is 9 x to the 4, not 3 x to the 4.",
          "write": "(3x²)² = 9x⁴"
        },
        {
          "say": "2a cubed is not 6 a cubed. 2 cubed is 8.",
          "write": "✗ 6a³   ✓ 8a³"
        },
        {
          "say": "5 to the zero is 1, not 0.",
          "write": "5⁰ = 1"
        }
      ]
    },

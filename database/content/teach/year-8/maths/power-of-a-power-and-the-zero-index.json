    {
      "heading": "Power of a power",
      "lines": [
        {
          "say": "Write it out. x cubed, four times. 3 plus 3 plus 3 plus 3 is 12.",
          "write": "x³ × x³ × x³ × x³"
        },
        {
          "say": "Power of a power? Multiply the indices.",
          "write": "(aᵐ)ⁿ = aᵐˣⁿ"
        },
        {
          "say": "Check with numbers. 2 cubed, squared, is 8 squared. That's 64.",
          "write": "(2³)² = 8² = 64"
        },
        {
          "say": "And 2 to the 6 is 64 too.",
          "write": "2⁶ = 64 ✓"
        }
      ]
    },
    {
      "heading": "Everybody gets the power",
      "lines": [
        {
          "say": "The power outside a bracket goes to every factor inside.",
          "write": "(ab)ⁿ = aⁿbⁿ"
        },
        {
          "say": "2a, all cubed. 2 cubed is 8. So 8 a cubed.",
          "write": "(2a)³ = 8a³"
        },
        {
          "say": "3 x to the 4, squared. 3 squared is 9. x to the 4, squared, is x to the 8.",
          "write": "(3x⁴)² = 9x⁸"
        },
        {
          "say": "2 m cubed n, to the 4. That's 16 m to the 12, n to the 4.",
          "write": "(2m³n)⁴ = 16m¹²n⁴"
        },
        {
          "say": "Only for products. x plus 3, squared, is not x squared plus 9.",
          "write": "(x + 3)² ≠ x² + 9"
        }
      ]
    },

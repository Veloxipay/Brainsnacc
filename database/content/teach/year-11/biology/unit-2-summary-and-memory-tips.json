    {
      "heading": "Reproduction and adaptations",
      "lines": [
        {
          "say": "Asexual reproduction is fast, but every offspring is a clone.",
          "write": "asexual → clones"
        },
        {
          "say": "Remember SCRAP. Same genes, so change or disease can wipe out all.",
          "write": "SCRAP"
        },
        {
          "say": "Sexual reproduction is slower, but makes diversity that helps survive change.",
          "write": "sexual → diversity"
        },
        {
          "say": "Adaptations come in three types: body, biochemistry, behaviour.",
          "write": "3 types of adaptation",
          "draw": {
            "type": "shapes",
            "width": 560,

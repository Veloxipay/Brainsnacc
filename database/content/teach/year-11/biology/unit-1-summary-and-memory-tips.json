{
  "level": "Year 11", "subject": "biology", "title": "Unit 1 summary and memory tips",
  "frames": [
    { "heading": "Cells and SA:V",
      "lines": [
        { "say": "Read a section, cover it, then say the key points out loud.", "write": "read · cover · say" },
        { "say": "Cell theory: all cells come from cells. Pro equals no nucleus.", "write": "Pro = no nucleus" },
        { "say": "For a cube, SA to V is 6 over the side. Double the side, halve the ratio.", "write": "SA:V = 6 ÷ side",
          "draw": { "type": "shapes", "width": 560, "height": 240, "alt": "A big ice block beside crushed ice; the crushed pieces have more surface", "items": [
            { "kind": "rect", "x": 60, "y": 60, "w": 140, "h": 140, "fill": "teal", "label": "block", "change": "remove" },
            { "kind": "rect", "x": 320, "y": 60, "w": 60, "h": 60, "fill": "teal", "change": "add" },
            { "kind": "rect", "x": 400, "y": 60, "w": 60, "h": 60, "fill": "teal", "change": "add" },
            { "kind": "rect", "x": 320, "y": 140, "w": 60, "h": 60, "fill": "teal", "change": "add" },
            { "kind": "rect", "x": 400, "y": 140, "w": 60, "h": 60, "fill": "teal", "change": "add" },
            { "kind": "text", "x": 390, "y": 230, "text": "crushed ice: more surface", "size": 18, "anchor": "middle", "color": "purple" }
          ] } },
        { "say": "Small cells, like crushed ice, have more surface for their size.", "write": "small = fast exchange" }
      ] },
    { "heading": "Organelles and membrane",
      "lines": [
        { "say": "Picture a factory. Ribosomes are workers, the Golgi is the packing room.", "write": "the protein factory" },
        { "say": "Export path: ribosome, rough ER, vesicle, Golgi, vesicle, plasma membrane.", "write": "RER → V → Golgi → V → PM" },
        { "say": "Water follows solute. Downhill is free, uphill costs ATP.", "write": "passive vs active",
          "draw": { "type": "shapes", "width": 560, "height": 240, "alt": "A ball rolls downhill for free; pushing a ball uphill needs ATP", "items": [
            { "kind": "polygon", "points": [[20, 220], [270, 220], [20, 60]], "fill": "green" },
            { "kind": "circle", "x": 60, "y": 70, "r": 16, "fill": "blue", "change": "remove" },
            { "kind": "circle", "x": 240, "y": 200, "r": 16, "fill": "blue", "change": "add" },
            { "kind": "text", "x": 140, "y": 40, "text": "passive: free", "size": 18, "anchor": "middle" },
            { "kind": "polygon", "points": [[290, 220], [540, 220], [540, 60]], "fill": "orange" },
            { "kind": "arrow", "x": 320, "y": 180, "x2": 500, "y2": 90, "color": "red", "change": "add" },
            { "kind": "text", "x": 420, "y": 40, "text": "active: needs ATP", "size": 18, "anchor": "middle", "color": "red" }
          ] } },
        { "say": "Hypotonic outside? Water goes in and the cell gets hippo-sized.", "write": "hypo → swells" }
      ] },
    { "heading": "Cell cycle, cancer, stem cells",
      "lines": [
        { "say": "Interphase: grow, synthesise, grow. DNA is copied in S.", "write": "G1 · S · G2" },
        { "say": "Then PMAT. Metaphase is middle, anaphase is apart.", "write": "P · M · A · T" },
        { "say": "Cancer: an accelerator stuck down, and brakes that fail.", "write": "oncogene · tumour suppressor" },
        { "say": "Potency: Tom Plays Many Units. Toti, pluri, multi, uni.", "write": "Tom Plays Many Units",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Potency staircase from totipotent down to unipotent", "items": [
            { "kind": "rect", "x": 20, "y": 40, "w": 130, "h": 200, "fill": "purple", "label": "toti" },
            { "kind": "rect", "x": 150, "y": 90, "w": 130, "h": 150, "fill": "blue", "label": "pluri" },
            { "kind": "rect", "x": 280, "y": 140, "w": 130, "h": 100, "fill": "teal", "label": "multi" },
            { "kind": "rect", "x": 410, "y": 190, "w": 130, "h": 50, "fill": "green", "label": "uni", "change": "highlight" },
            { "kind": "arrow", "x": 90, "y": 25, "x2": 480, "y2": 170, "color": "black", "dashed": true }
          ] } }
      ] },
    { "heading": "Plant and animal systems",
      "lines": [
        { "say": "Xylem carries water up. Phloem carries food both ways.", "write": "xylem up, phloem flows" },
        { "say": "Transpiration is fastest on a good washing day: hot, dry, windy, sunny.", "write": "washing-day weather" },
        { "say": "Bile emulsifies fat. Villi and microvilli absorb.", "write": "bile emulsifies" },
        { "say": "The nephron filters, reabsorbs, then secretes.", "write": "filter · reabsorb · secrete",
          "draw": { "type": "shapes", "width": 560, "height": 220, "alt": "Nephron steps: filtration, reabsorption, secretion, urine", "items": [
            { "kind": "rect", "x": 10, "y": 80, "w": 120, "h": 60, "fill": "red", "label": "filter" },
            { "kind": "arrow", "x": 130, "y": 110, "x2": 150, "y2": 110, "color": "black" },
            { "kind": "rect", "x": 150, "y": 80, "w": 130, "h": 60, "fill": "orange", "label": "reabsorb", "change": "highlight" },
            { "kind": "arrow", "x": 280, "y": 110, "x2": 300, "y2": 110, "color": "black" },
            { "kind": "rect", "x": 300, "y": 80, "w": 120, "h": 60, "fill": "purple", "label": "secrete" },
            { "kind": "arrow", "x": 420, "y": 110, "x2": 440, "y2": 110, "color": "black" },
            { "kind": "rect", "x": 440, "y": 80, "w": 110, "h": 60, "fill": "yellow", "label": "urine" },
            { "kind": "text", "x": 215, "y": 180, "text": "all glucose back", "size": 18, "anchor": "middle", "color": "orange" }
          ] } }
      ] },
    { "heading": "Homeostasis",
      "lines": [
        { "say": "Silly Rabbits Can Eat Radishes. Stimulus, receptor, control centre, effector, response.", "write": "S → R → C → E → R" },
        { "say": "Negative feedback is a thermostat. It reverses the change, then switches off.", "write": "negative feedback = thermostat" },
        { "say": "Insulin puts glucose in storage. Glucagon comes when glucose is gone.", "write": "insulin ↓ · glucagon ↑" },
        { "say": "ADH: add water back. More ADH, less and darker urine.", "write": "ADH = Add water back" }
      ] },
    { "heading": "When homeostasis fails",
      "lines": [
        { "say": "Disorders happen when one part of the pathway breaks.", "write": "broken link" },
        { "say": "Type 1 diabetes: beta cells destroyed, no insulin. Treated with insulin.", "write": "type 1: no insulin" },
        { "say": "Type 2: insulin is made, but cells respond poorly.", "write": "type 2: insulin resistance" },
        { "say": "Graves' disease: thyroxine high, TSH low. Diabetes insipidus: too little ADH.", "write": "Graves' · diabetes insipidus" }
      ] },
    { "heading": "Investigations",
      "lines": [
        { "say": "If, then, because. Change one variable, measure another, control the rest.", "write": "IV · DV · controlled" },
        { "say": "Replicates reduce random error. Systematic error shifts every result.", "write": "random vs systematic" },
        { "say": "Darts clustered but off the bullseye are precise, not accurate.", "write": "precise ≠ accurate",
          "draw": { "type": "shapes", "width": 560, "height": 240, "alt": "Dartboard with a tight cluster of darts away from the bullseye", "items": [
            { "kind": "circle", "x": 280, "y": 120, "r": 100, "fill": "white" },
            { "kind": "circle", "x": 280, "y": 120, "r": 22, "fill": "red" },
            { "kind": "circle", "x": 335, "y": 65, "r": 7, "fill": "black", "change": "add" },
            { "kind": "circle", "x": 347, "y": 72, "r": 7, "fill": "black", "change": "add" },
            { "kind": "circle", "x": 333, "y": 80, "r": 7, "fill": "black", "change": "add" },
            { "kind": "text", "x": 420, "y": 60, "text": "precise only", "size": 18 }
          ] } }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Use these tricks after you've worked through each lesson.", "write": "lessons first, tricks second" },
        { "say": "Cover, recall, check. Out loud works best.", "write": "cover · recall · check" },
        { "say": "Revisit any lesson where a trick doesn't make sense yet.", "write": "gap → revisit" }
      ] }
  ]
}

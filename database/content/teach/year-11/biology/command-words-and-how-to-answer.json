{
  "level": "Year 11", "subject": "biology", "title": "Command words and how to answer",
  "frames": [
    { "heading": "What is a command word?",
      "lines": [
        { "say": "Every exam question starts with a command word, the instruction verb.", "write": "identify · describe · explain" },
        { "say": "It's like a canteen order. Serve the wrong thing and you lose the marks.", "write": "answer what was ordered" },
        { "say": "The exact wording comes from the VCAA glossary of command terms.", "write": "check the VCAA glossary" }
      ] },
    { "heading": "From short to long",
      "lines": [
        { "say": "Identify, name or state: just the fact. A word or a short sentence.", "write": "Identify → the mitochondrion",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Steps of command words from identify up to evaluate", "items": [
            { "kind": "rect", "x": 20, "y": 200, "w": 120, "h": 50, "fill": "green", "label": "identify", "change": "highlight" },
            { "kind": "rect", "x": 150, "y": 150, "w": 120, "h": 100, "fill": "teal", "label": "describe" },
            { "kind": "rect", "x": 280, "y": 100, "w": 120, "h": 150, "fill": "blue", "label": "explain" },
            { "kind": "rect", "x": 410, "y": 50, "w": 130, "h": 200, "fill": "purple", "label": "evaluate" },
            { "kind": "text", "x": 280, "y": 30, "text": "longer answers →", "size": 18, "anchor": "middle" }
          ] } },
        { "say": "Describe gives the features, or what happens. That's the what.", "write": "Describe = What",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Steps of command words with describe highlighted", "items": [
            { "kind": "rect", "x": 20, "y": 200, "w": 120, "h": 50, "fill": "green", "label": "identify" },
            { "kind": "rect", "x": 150, "y": 150, "w": 120, "h": 100, "fill": "teal", "label": "describe", "change": "highlight" },
            { "kind": "rect", "x": 280, "y": 100, "w": 120, "h": 150, "fill": "blue", "label": "explain" },
            { "kind": "rect", "x": 410, "y": 50, "w": 130, "h": 200, "fill": "purple", "label": "evaluate" },
            { "kind": "text", "x": 280, "y": 30, "text": "longer answers →", "size": 18, "anchor": "middle" }
          ] } },
        { "say": "Explain gives the why or how, linking cause to effect.", "write": "Explain = Why",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Steps of command words with explain highlighted", "items": [
            { "kind": "rect", "x": 20, "y": 200, "w": 120, "h": 50, "fill": "green", "label": "identify" },
            { "kind": "rect", "x": 150, "y": 150, "w": 120, "h": 100, "fill": "teal", "label": "describe" },
            { "kind": "rect", "x": 280, "y": 100, "w": 120, "h": 150, "fill": "blue", "label": "explain", "change": "highlight" },
            { "kind": "rect", "x": 410, "y": 50, "w": 130, "h": 200, "fill": "purple", "label": "evaluate" },
            { "kind": "text", "x": 280, "y": 30, "text": "longer answers →", "size": 18, "anchor": "middle" }
          ] } },
        { "say": "Commentator describes. Coach explains, using because and so.", "write": "because · therefore · so" },
        { "say": "No because or therefore? It's probably only a description.", "write": "no 'because' = describe" }
      ] },
    { "heading": "Explain: a three-mark answer",
      "lines": [
        { "say": "Why can oxygen diffuse through the membrane, but glucose can't?", "write": "O₂ vs glucose (3 marks)" },
        { "say": "Mark one. Oxygen is small and non-polar, so it passes the hydrophobic core.", "write": "1: O₂ small, non-polar → passes" },
        { "say": "Mark two. Glucose is larger and polar, so the tails repel it.", "write": "2: glucose polar → repelled" },
        { "say": "Mark three. So glucose needs protein channels or carriers.", "write": "3: needs proteins" }
      ] },
    { "heading": "Compare, contrast, analyse",
      "lines": [
        { "say": "Compare means similarities and differences. Contrast means differences only.", "write": "compare = both + but" },
        { "say": "Start with both. Then link a difference with whereas.", "write": "Both ... whereas ...",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Two overlapping circles: prokaryote and eukaryote, with shared features in the middle", "items": [
            { "kind": "circle", "x": 210, "y": 130, "r": 110, "fill": "blue" },
            { "kind": "circle", "x": 350, "y": 130, "r": 110, "fill": "orange" },
            { "kind": "text", "x": 150, "y": 135, "text": "no nucleus", "size": 16, "anchor": "middle" },
            { "kind": "text", "x": 410, "y": 135, "text": "nucleus", "size": 16, "anchor": "middle" },
            { "kind": "text", "x": 280, "y": 120, "text": "both:", "size": 16, "bold": true, "anchor": "middle", "change": "highlight" },
            { "kind": "text", "x": 280, "y": 145, "text": "DNA, ribosomes", "size": 14, "anchor": "middle", "change": "highlight" }
          ] } },
        { "say": "Analyse data with TDI: trend, data, interpretation.", "write": "TDI: Trend · Data · Interpret",
          "draw": { "type": "shapes", "width": 560, "height": 280, "alt": "Enzyme rate rises to a peak of 12 at 40 degrees then falls to 1 at 60 degrees", "items": [
            { "kind": "line", "x": 60, "y": 240, "x2": 520, "y2": 240, "color": "black" },
            { "kind": "line", "x": 60, "y": 240, "x2": 60, "y2": 30, "color": "black" },
            { "kind": "line", "x": 80, "y": 210, "x2": 320, "y2": 60, "color": "blue" },
            { "kind": "line", "x": 320, "y": 60, "x2": 480, "y2": 225, "color": "blue" },
            { "kind": "circle", "x": 320, "y": 60, "r": 10, "fill": "red", "change": "highlight" },
            { "kind": "text", "x": 335, "y": 50, "text": "12 units at 40 °C", "size": 18, "bold": true, "color": "red" },
            { "kind": "text", "x": 290, "y": 270, "text": "temperature (°C)", "size": 16, "anchor": "middle" }
          ] } },
        { "say": "Rises from 2 to 12 units, peaks at 40 degrees, then the enzyme denatures.", "write": "quote values with units" }
      ] },
    { "heading": "Evaluate and justify",
      "lines": [
        { "say": "Evaluate like a judge. Strengths on one side, limitations on the other.", "write": "pros · cons · verdict",
          "draw": { "type": "shapes", "width": 560, "height": 260, "alt": "Scales weighing strengths against limitations, then a verdict appears", "items": [
            { "kind": "polygon", "points": [[270, 220], [290, 220], [280, 80]], "fill": "grey" },
            { "kind": "line", "x": 120, "y": 80, "x2": 440, "y2": 80, "color": "black" },
            { "kind": "rect", "x": 60, "y": 90, "w": 120, "h": 50, "fill": "green", "label": "strengths" },
            { "kind": "rect", "x": 380, "y": 90, "w": 130, "h": 50, "fill": "red", "label": "limitations" },
            { "kind": "text", "x": 280, "y": 250, "text": "Overall ... (verdict)", "size": 20, "bold": true, "color": "purple", "anchor": "middle", "change": "add" }
          ] } },
        { "say": "A light microscope is cheap and shows living cells, but can't resolve cristae.", "write": "light microscope: + and −" },
        { "say": "Always finish with a verdict. Overall, an electron microscope is better.", "write": "Overall, ..." },
        { "say": "Justify means claim, because, evidence.", "write": "claim + because + evidence" }
      ] },
    { "heading": "Plan before you write",
      "lines": [
        { "say": "Circle the command word. Underline the content.", "write": "circle · underline" },
        { "say": "One mark, one idea. Count the marks, jot that many points.", "write": "1 mark = 1 idea" },
        { "say": "Answer in the context of the question, with correct terms.", "write": "use the scenario" },
        { "say": "Re-read the question. Did you do what the verb asked?", "write": "re-read ✓" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Describe is what. Explain is why.", "write": "Describe = What, Explain = Why" },
        { "say": "Compare with both and whereas, not two separate paragraphs.", "write": "Both ... whereas ..." },
        { "say": "Evaluate needs pros, cons and a final judgement.", "write": "verdict!" },
        { "say": "Quote data with units, and avoid vague words like stuff.", "write": "data + units" }
      ] }
  ]
}

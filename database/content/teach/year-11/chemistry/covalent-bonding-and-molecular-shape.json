    {
      "heading": "What is a covalent bond?",
      "lines": [
        {
          "say": "When two non-metals bond, neither can take electrons. So they share.",
          "write": "non-metals share electrons"
        },
        {
          "say": "A covalent bond is a shared pair, attracted to both nuclei.",
          "write": "shared pair + both nuclei",

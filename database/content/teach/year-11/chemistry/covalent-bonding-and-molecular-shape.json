        {
          "say": "Like two mates both holding the same footy.",
          "write": "two mates, one footy"
        },
        {
          "say": "One pair is single, two is double, three is triple.",
          "write": "H–H   O=O   N≡N"
        },
        {
          "say": "Use HONC 1234: hydrogen 1, oxygen 2, nitrogen 3, carbon 4 bonds.",
          "write": "HONC 1234"

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Water has four groups, but its shape is bent, not tetrahedral.",
          "write": "✗ water tetrahedral"
        },
        {
          "say": "Polar bonds do not always make a polar molecule. Think of CO2.",
          "write": "✗ polar bonds → polar"
        },
        {
          "say": "Graphite conducts by delocalised electrons, not ions.",
          "write": "✗ graphite has ions"
        },
        {
          "say": "Melting diamond breaks strong covalent bonds, not weak forces.",
          "write": "✗ weak forces in diamond"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "HONC 1234 for the usual number of bonds.",
          "write": "HONC 1234"
        },
        {
          "say": "Count groups, then lone pairs, then name the shape from the atoms.",
          "write": "groups → lone pairs → shape"
        },
        {
          "say": "Polarity needs polar bonds and an unsymmetrical shape.",
          "write": "polar = uneven pull"
        },
        {
          "say": "Diamond electrons are locked up. Graphite has one free per carbon.",
          "write": "1 free e⁻ per C in graphite"
        }
      ]
    }

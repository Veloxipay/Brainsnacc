    {
      "heading": "Covalent network lattices",
      "lines": [
        {
          "say": "Some non-metals form one giant network of covalent bonds.",
          "write": "covalent network lattice"
        },
        {
          "say": "Diamond: each carbon bonds to four others. Very hard, does not conduct.",
          "write": "diamond: 4 bonds, no conduction"
        },
        {
          "say": "Graphite: three bonds each, in flat layers. One electron is delocalised.",
          "write": "graphite: 3 bonds + 1 free e⁻",
          "draw": {

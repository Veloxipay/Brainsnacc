    {
      "heading": "The 12 principles",
      "lines": [
        {
          "say": "There are 12 principles of green chemistry. Number 1 is prevention.",
          "write": "1. Prevention"
        },
        {
          "say": "Prevent waste, rather than clean it up afterwards.",
          "write": "prevent, don’t clean up"
        },
        {
          "say": "Remember them with the word PRODUCTIVELY.",
          "write": "PRODUCTIVELY",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "PRODUCTIVELY",
            "items": [

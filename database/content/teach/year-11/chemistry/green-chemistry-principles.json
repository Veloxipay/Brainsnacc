    {
      "heading": "What is sustainability?",
      "lines": [
        {
          "say": "Sustainable means meeting our needs without harming future generations.",
          "write": "sustainable development"
        },
        {
          "say": "For chemistry, that means less waste, less energy, and safer products.",
          "write": "less waste, less energy"
        },
        {
          "say": "It also means using resources that can be replaced.",
          "write": "renewable resources"
        }
      ]
    },

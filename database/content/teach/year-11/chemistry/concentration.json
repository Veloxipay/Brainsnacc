                "label": "1.4 ppm"
              },
              {
                "kind": "arrow",
                "x": 250,
                "y": 140,
                "x2": 310,
                "y2": 140,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 320,
                "y": 100,
                "w": 200,
                "h": 80,
                "fill": "orange",
                "label": "1400 ppb",
                "change": "add"
              },
              {

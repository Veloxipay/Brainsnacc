    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "Forgetting millilitres to litres makes it 1000 times too small.",
          "write": "mL → L"
        },
        {
          "say": "V 2 is not the water added. 20 plus 80 makes 100.",
          "write": "V₂ = 20 + 80 = 100 mL"
        },
        {
          "say": "Check the label: per 100 grams or per 100 millilitres?",
          "write": "m/m, m/v, v/v"
        },
        {
          "say": "Count the ions, using the subscripts.",
          "write": "[Cl⁻] = 2 × [CaCl₂]"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "c equals n over V, with V in litres.",
          "write": "c = n ÷ V"
        },
        {
          "say": "Dilution spreads the same moles through more volume.",
          "write": "c₁V₁ = c₂V₂"
        },
        {
          "say": "One p p m is about one milligram per litre in water.",
          "write": "1 ppm ≈ 1 mg L⁻¹"
        },
        {
          "say": "Show the formula, the numbers and the units every time.",
          "write": "formula, numbers, units"
        }
      ]
    }

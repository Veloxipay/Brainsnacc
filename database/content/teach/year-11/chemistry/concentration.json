                "y": 150,
                "text": "100 mL wine",
                "size": 18,
                "color": "black",
                "anchor": "start"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Parts per million",
      "lines": [
        {
          "say": "Tiny amounts get awkward numbers. So we use p p m and p p b.",
          "write": "ppm and ppb"
        },
        {
          "say": "One p p m is one gram in a million grams.",
          "write": "ppm = m ÷ m × 10⁶"
        },
        {
          "say": "In dilute water, one p p m is about one milligram per litre.",
          "write": "1 ppm ≈ 1 mg L⁻¹"
        },
        {
          "say": "4.2 milligrams of arsenic in 3.0 kilograms of water is 1.4 p p m.",
          "write": "4.2 mg ÷ 3.0 kg = 1.4 ppm"
        },
        {
          "say": "The p p b number is always 1000 times bigger.",
          "write": "1.4 ppm = 1.4 × 10³ ppb",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "ppm to ppb",
            "items": [
              {
                "kind": "rect",

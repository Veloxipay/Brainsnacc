{
  "level": "Year 11",
  "subject": "chemistry",
  "title": "Concentration",
  "frames": [
    {
      "heading": "Solutions and concentration",
      "lines": [
        {
          "say": "A solute dissolves in a solvent to make a solution.",
          "write": "solute + solvent = solution"
        },
        {
          "say": "Concentration is how much solute is in a stated amount of solution.",
          "write": "concentration"
        },
        {
          "say": "Think cordial in a jug. More cordial, more concentrated.",
          "write": "concentrated vs dilute"
        },
        {
          "say": "Concentrated is about amount. It is not the same as strong.",
          "write": "concentrated ≠ strong"
        }
      ]
    },
    {
      "heading": "Molar concentration",
      "lines": [
        {
          "say": "c equals n over V. Volume must be in litres.",
          "write": "c = n ÷ V"
        },
        {
          "say": "Dissolve 5.85 grams of salt. That is 0.100 moles.",
          "write": "n = 5.85 ÷ 58.5 = 0.100 mol"
        },
        {
          "say": "Make it up to 250.0 millilitres. That is 0.2500 litres.",
          "write": "V = 0.2500 L"
        },
        {
          "say": "0.100 over 0.2500 gives 0.400 moles per litre.",
          "write": "c = 0.400 mol L⁻¹"
        },
        {
          "say": "Count the ions. Calcium chloride gives two chlorides each.",
          "write": "CaCl₂ → Ca²⁺ + 2Cl⁻",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Ions from CaCl2",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 90,
                "w": 140,
                "h": 80,
                "fill": "teal",
                "label": "CaCl₂ 0.10 M"
              },
              {
                "kind": "arrow",
                "x": 175,
                "y": 130,
                "x2": 245,
                "y2": 130,
                "color": "purple"
              },
              {
                "kind": "circle",
                "x": 300,
                "y": 130,
                "r": 32,
                "fill": "blue",
                "label": "Ca²⁺",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 400,
                "y": 100,
                "r": 28,
                "fill": "green",
                "label": "Cl⁻",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 400,
                "y": 170,
                "r": 28,
                "fill": "green",
                "label": "Cl⁻",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 470,
                "y": 135,
                "text": "[Cl⁻] = 0.20",
                "size": 18,
                "color": "green",
                "anchor": "start",
                "bold": true
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Mass concentration and percentages",
      "lines": [
        {
          "say": "Mass concentration is grams per litre.",
          "write": "g L⁻¹"
        },
        {
          "say": "Multiply moles per litre by molar mass to get grams per litre.",
          "write": "0.400 × 58.5 = 23.4 g L⁻¹"
        },
        {
          "say": "Percent m over m is grams per 100 grams of solution.",
          "write": "% m/m: g per 100 g"
        },
        {
          "say": "Percent m over v is grams per 100 millilitres. Saline is 0.9.",
          "write": "% m/v: g per 100 mL"
        },
        {
          "say": "Percent v over v is millilitres per 100 millilitres. Used for ethanol.",
          "write": "% v/v: mL per 100 mL",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "13% v/v wine",

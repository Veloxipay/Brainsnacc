{
  "level": "Year 11",
  "subject": "chemistry",
  "title": "Redox reactions",
  "frames": [
    {
      "heading": "Oxidation and reduction",
      "lines": [
        {
          "say": "Oxidation is loss of electrons. Reduction is gain.",
          "write": "OIL RIG"
        },
        {
          "say": "Magnesium burns in oxygen. Magnesium loses two electrons.",
          "write": "Mg → Mg²⁺ + 2e⁻",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Mg loses electrons",
            "items": [
              {
                "kind": "circle",
                "x": 130,
                "y": 140,
                "r": 50,
                "fill": "grey",
                "label": "Mg"
              },
              {
                "kind": "circle",
                "x": 420,
                "y": 140,
                "r": 50,
                "fill": "red",
                "label": "O"
              },
              {
                "kind": "circle",
                "x": 185,
                "y": 100,
                "r": 10,
                "fill": "orange",
                "change": "remove"
              },
              {
                "kind": "circle",
                "x": 185,
                "y": 180,
                "r": 10,
                "fill": "orange",
                "change": "remove"
              },
              {
                "kind": "arrow",
                "x": 200,
                "y": 100,
                "x2": 365,
                "y2": 110,
                "color": "orange",
                "change": "add"
              },
              {
                "kind": "arrow",
                "x": 200,
                "y": 180,
                "x2": 365,
                "y2": 170,
                "color": "orange",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 240,
                "text": "oxidised",
                "size": 20,
                "color": "grey",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 420,
                "y": 240,
                "text": "reduced",
                "size": 20,
                "color": "red",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Oxygen gains those electrons. That is reduction.",
          "write": "O₂ + 4e⁻ → 2O²⁻"
        },
        {
          "say": "Electrons cannot vanish, so both always happen together. That is redox.",
          "write": "redox"
        },
        {
          "say": "In oxidation, electrons are on the right. In reduction, on the left.",
          "write": "e⁻ right: ox;  e⁻ left: red"
        }
      ]
    },
    {
      "heading": "Agents do the opposite",
      "lines": [
        {
          "say": "The oxidising agent takes electrons. So it gets reduced.",
          "write": "oxidising agent is reduced"
        },
        {
          "say": "The reducing agent gives electrons. So it gets oxidised.",
          "write": "reducing agent is oxidised"
        },
        {
          "say": "Like a travel agent, it sends you on the trip and stays behind.",
          "write": "agents do the opposite"
        },
        {
          "say": "In burning magnesium, oxygen is the oxidising agent.",
          "write": "O₂: oxidising agent"
        }
      ]
    },
    {
      "heading": "Oxidation numbers",
      "lines": [
        {
          "say": "Elements are zero. Simple ions equal their charge.",
          "write": "Fe = 0,  Na⁺ = +1"
        },
        {
          "say": "Oxygen is usually minus 2. Hydrogen is usually plus 1.",
          "write": "O −2,  H +1"
        },
        {
          "say": "They add up to the charge of the ion.",
          "write": "sum = charge"
        },
        {
          "say": "In permanganate, four oxygens give minus 8. The total is minus 1.",
          "write": "x + (−8) = −1",

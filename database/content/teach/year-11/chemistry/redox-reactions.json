    {
      "heading": "Combining half-equations",
      "lines": [
        {
          "say": "Iron 2 plus loses one electron to become iron 3 plus.",
          "write": "Fe²⁺ → Fe³⁺ + e⁻"
        },
        {
          "say": "Electrons must match like a handshake. Multiply iron by 5.",
          "write": "5Fe²⁺ → 5Fe³⁺ + 5e⁻"
        },
        {
          "say": "Add them and cancel the five electrons.",
          "write": "cancel 5e⁻"
        },
        {
          "say": "Check the charge: plus 17 on both sides.",
          "write": "+17 = +17"
        }
      ]
    },
    {
      "heading": "Displacement",
      "lines": [
        {
          "say": "A more reactive metal gives electrons to ions of a less reactive one.",
          "write": "Zn + Cu²⁺ → Zn²⁺ + Cu"
        },
        {
          "say": "Zinc in copper sulfate gets coated with copper. The blue fades.",
          "write": "copper coats, blue fades",
          "draw": {

    {
      "heading": "Corrosion",
      "lines": [
        {
          "say": "Rusting needs oxygen and water. Iron is oxidised.",
          "write": "Fe → Fe²⁺ + 2e⁻"
        },
        {
          "say": "Electrons travel through the metal. Oxygen is reduced elsewhere.",
          "write": "O₂ + 2H₂O + 4e⁻ → 4OH⁻"
        },
        {
          "say": "Salt water speeds rusting. Rust flakes off and exposes fresh iron.",
          "write": "salt speeds rusting"
        },

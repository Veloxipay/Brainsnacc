{
  "level": "Year 11", "subject": "chemistry", "title": "Unit 2 summary and memory tips",
  "frames": [
    { "heading": "Water's superpowers",
      "lines": [
        { "say": "Water is a bent, polar molecule. It hydrogen bonds with its neighbours.",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Two water molecules joined by a hydrogen bond", "items": [
            {"kind": "circle", "x": 150, "y": 120, "r": 36, "fill": "red", "label": "O"},
            {"kind": "circle", "x": 95, "y": 175, "r": 20, "fill": "white", "label": "H"},
            {"kind": "circle", "x": 205, "y": 175, "r": 20, "fill": "white", "label": "H"},
            {"kind": "circle", "x": 400, "y": 140, "r": 36, "fill": "red", "label": "O"},
            {"kind": "circle", "x": 455, "y": 85, "r": 20, "fill": "white", "label": "H"},
            {"kind": "circle", "x": 455, "y": 195, "r": 20, "fill": "white", "label": "H"},
            {"kind": "line", "x": 225, "y": 172, "x2": 365, "y2": 145, "color": "purple", "dashed": true, "change": "add"},
            {"kind": "text", "x": 290, "y": 235, "text": "hydrogen bond", "size": 20, "anchor": "middle", "color": "purple", "change": "add"}
          ]}},
        { "say": "That gives a high specific heat capacity. 4.18 joules per gram per degree.", "write": "q = m × c × ΔT" },
        { "say": "Changing state uses moles. Vaporisation is 40.7 kilojoules per mole.", "write": "q = n × ΔH" },
        { "say": "Ice is an open cage, so it's less dense and floats.", "write": "ice floats: open lattice" }
      ] },
    { "heading": "Dissolving and precipitates",
      "lines": [
        { "say": "Ionic compounds dissociate. Water pulls the ions out and hydrates them.", "write": "NaCl(s) → Na⁺(aq) + Cl⁻(aq)" },
        { "say": "To predict a precipitate, swap partners and check the table.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Silver and chloride ions meet to make a silver chloride precipitate", "items": [
            {"kind": "circle", "x": 100, "y": 90, "r": 34, "fill": "grey", "label": "Ag⁺"},
            {"kind": "circle", "x": 200, "y": 90, "r": 34, "fill": "blue", "label": "NO₃⁻"},
            {"kind": "circle", "x": 360, "y": 90, "r": 34, "fill": "orange", "label": "Na⁺"},
            {"kind": "circle", "x": 460, "y": 90, "r": 34, "fill": "green", "label": "Cl⁻"},
            {"kind": "rect", "x": 200, "y": 170, "w": 160, "h": 50, "fill": "white", "label": "AgCl(s)", "change": "add"}
          ]}},
        { "say": "Sodium, nitrate, ammonium and potassium are always soluble. Think SNAP.", "write": "SNAP: always soluble" },
        { "say": "Leave out the spectator ions to get the net ionic equation.", "write": "Ag⁺(aq) + Cl⁻(aq) → AgCl(s)" }
      ] },
    { "heading": "Acids, bases and pH",
      "lines": [
        { "say": "An acid donates a proton. A base accepts one. A for away.", "write": "acid gives H⁺, base takes H⁺" },
        { "say": "Strength is how much it ionises. Concentration is how much is in the bottle.", "write": "strong ≠ concentrated" },
        { "say": "pH is minus log of the hydronium concentration.", "write": "pH = −log₁₀[H₃O⁺]" },
        { "say": "Each pH step down is ten times more acidic. pH 3 is 100 times pH 5.",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "pH ladder from 5 to 3 with times ten at each step", "items": [
            {"kind": "rect", "x": 40, "y": 70, "w": 140, "h": 60, "fill": "yellow", "label": "pH 5"},
            {"kind": "rect", "x": 210, "y": 70, "w": 140, "h": 60, "fill": "orange", "label": "pH 4", "change": "add"},
            {"kind": "rect", "x": 380, "y": 70, "w": 140, "h": 60, "fill": "red", "label": "pH 3", "change": "add"},
            {"kind": "text", "x": 195, "y": 170, "text": "× 10", "size": 22, "anchor": "middle"},
            {"kind": "text", "x": 365, "y": 170, "text": "× 10", "size": 22, "anchor": "middle"}
          ]}},
        { "say": "Kw is the fixed product. For bases, find O H minus first.", "write": "[H₃O⁺][OH⁻] = 1.00 × 10⁻¹⁴" }
      ] },
    { "heading": "Redox",
      "lines": [
        { "say": "Oxidation is loss of electrons. Reduction is gain. OIL RIG.", "write": "OIL RIG",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Zinc gives electrons to copper ions", "items": [
            {"kind": "circle", "x": 120, "y": 110, "r": 44, "fill": "grey", "label": "Zn"},
            {"kind": "circle", "x": 440, "y": 110, "r": 44, "fill": "blue", "label": "Cu²⁺"},
            {"kind": "arrow", "x": 170, "y": 110, "x2": 390, "y2": 110, "color": "orange", "change": "add"},
            {"kind": "text", "x": 280, "y": 90, "text": "2e⁻", "size": 22, "anchor": "middle", "change": "add"},
            {"kind": "text", "x": 120, "y": 190, "text": "oxidised", "size": 18, "anchor": "middle"},
            {"kind": "text", "x": 440, "y": 190, "text": "reduced", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "The oxidising agent gets reduced. It does the job to someone else.", "write": "oxidising agent is reduced" },
        { "say": "Balance half-equations with KOHES. Key element, oxygen, hydrogen, electrons, states.", "write": "K O H E S" },
        { "say": "Zinc on steel is oxidised instead of iron. That's sacrificial protection.", "write": "galvanising protects iron" }
      ] },
    { "heading": "Moles are the bridge",
      "lines": [
        { "say": "Almost every calculation goes moles of known, mole ratio, then the answer.", "write": "Find → Ratio → Convert",
          "draw": {"type": "shapes", "width": 560, "height": 220, "alt": "Mass, solution and gas all lead to moles", "items": [
            {"kind": "rect", "x": 20, "y": 30, "w": 150, "h": 44, "fill": "orange", "label": "n = m ÷ M"},
            {"kind": "rect", "x": 20, "y": 90, "w": 150, "h": 44, "fill": "blue", "label": "n = cV"},
            {"kind": "rect", "x": 20, "y": 150, "w": 150, "h": 44, "fill": "teal", "label": "n = V ÷ 24.8"},
            {"kind": "arrow", "x": 175, "y": 112, "x2": 300, "y2": 112, "color": "black", "change": "add"},
            {"kind": "circle", "x": 370, "y": 112, "r": 56, "fill": "purple", "label": "moles", "change": "highlight"}
          ]}},
        { "say": "At SLC one mole of gas is 24.8 litres. Not 22.4.", "write": "24.8 not 22.4" },
        { "say": "Dilution keeps the moles the same.", "write": "c₁V₁ = c₂V₂" },
        { "say": "Divide moles by coefficients. The smallest is the limiting reactant.", "write": "smallest = limiting" }
      ] },
    { "heading": "Measuring what's in water",
      "lines": [
        { "say": "Gravimetric analysis. Precipitate, filter, wash, dry to constant mass, weigh.", "write": "dry to constant mass" },
        { "say": "Colorimetry measures absorbance at lambda max. Absorbance rises with concentration.",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Calibration curve with an unknown read off", "items": [
            {"kind": "arrow", "x": 70, "y": 240, "x2": 520, "y2": 240, "color": "black"},
            {"kind": "arrow", "x": 70, "y": 240, "x2": 70, "y2": 20, "color": "black"},
            {"kind": "line", "x": 70, "y": 240, "x2": 470, "y2": 50, "color": "blue"},
            {"kind": "line", "x": 70, "y": 140, "x2": 280, "y2": 140, "color": "red", "dashed": true, "change": "add"},
            {"kind": "line", "x": 280, "y": 140, "x2": 280, "y2": 240, "color": "red", "dashed": true, "change": "add"},
            {"kind": "text", "x": 290, "y": 270, "text": "concentration", "size": 18, "anchor": "middle"},
            {"kind": "text", "x": 80, "y": 30, "text": "absorbance", "size": 18}
          ]}},
        { "say": "Read the unknown off the calibration curve, then times by any dilution factor.", "write": "× dilution factor" },
        { "say": "In a titration, average the concordant titres. Within 0.10 millilitres.", "write": "concordant: within 0.10 mL" },
        { "say": "Rinse the burette and pipette with what they'll hold. Flasks with water.", "write": "rinsing rule" }
      ] },
    { "heading": "Practical skills",
      "lines": [
        { "say": "Accuracy is hitting the bullseye. Precision is a tight grouping.",
          "draw": {"type": "shapes", "width": 560, "height": 240, "alt": "Two dartboards: accurate and precise, precise but not accurate", "items": [
            {"kind": "circle", "x": 140, "y": 120, "r": 90, "fill": "white"},
            {"kind": "circle", "x": 140, "y": 120, "r": 20, "fill": "red"},
            {"kind": "circle", "x": 420, "y": 120, "r": 90, "fill": "white"},
            {"kind": "circle", "x": 420, "y": 120, "r": 20, "fill": "red"},
            {"kind": "circle", "x": 135, "y": 115, "r": 6, "fill": "black"},
            {"kind": "circle", "x": 146, "y": 124, "r": 6, "fill": "black"},
            {"kind": "circle", "x": 470, "y": 70, "r": 6, "fill": "black", "change": "highlight"},
            {"kind": "circle", "x": 480, "y": 80, "r": 6, "fill": "black", "change": "highlight"},
            {"kind": "circle", "x": 462, "y": 84, "r": 6, "fill": "black", "change": "highlight"}
          ]}},
        { "say": "A tight group off to one side points to a systematic error.", "write": "systematic → accuracy" },
        { "say": "Random errors scatter the results. Take repeats to reduce them.", "write": "random → precision" },
        { "say": "Change the independent variable. Measure the dependent. Control everything else.", "write": "IV, DV, controlled" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Water's odd properties all start with hydrogen bonding.", "write": "start with H bonds" },
        { "say": "Swap partners and check the table for precipitates.", "write": "swap partners, check table" },
        { "say": "OIL RIG, and KOHES for half-equations.", "write": "OIL RIG + KOHES" },
        { "say": "Moles are the bridge between what you measure and what you're asked.", "write": "moles are the bridge" }
      ] }
  ]
}

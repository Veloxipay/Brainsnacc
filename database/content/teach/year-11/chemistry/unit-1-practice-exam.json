                "kind": "rect",
                "x": 478,
                "y": 110,
                "w": 72,
                "h": 60,
                "fill": "yellow",
                "label": "4s¹",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "For abundances, call one fraction x and the other one minus x.",
          "write": "62.93x + 64.93(1 − x) = 63.55"
        },
        {
          "say": "Solve to get x equals 0.690.",
          "write": "x = 0.690"
        },
        {
          "say": "So 69.0 percent copper 63, and 31.0 percent copper 65.",
          "write": "⁶³Cu 69.0%   ⁶⁵Cu 31.0%",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Copper abundances",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 100,
                "w": 359,
                "h": 80,
                "fill": "orange",
                "label": "⁶³Cu 69.0%",
                "change": "add"
              },
              {
                "kind": "rect",
                "x": 379,
                "y": 100,
                "w": 161,
                "h": 80,
                "fill": "teal",
                "label": "⁶⁵Cu 31.0%",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Check: 63.55 is closer to the lighter isotope. That makes sense.",
          "write": "check it fits"
        }
      ]

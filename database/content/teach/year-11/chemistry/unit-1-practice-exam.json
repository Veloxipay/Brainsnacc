    {
      "heading": "Bonding from properties",
      "lines": [
        {
          "say": "W melts at 2852 and conducts only when molten. That is ionic.",
          "write": "W: ionic"
        },
        {
          "say": "X melts at 1710 and never conducts. Covalent network.",
          "write": "X: covalent network"
        },
        {
          "say": "Y melts at minus 182. Covalent molecular, weak forces between molecules.",
          "write": "Y: covalent molecular"
        },
        {
          "say": "Z conducts as a solid and a liquid. Metallic.",
          "write": "Z: metallic",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Four structures",
            "items": [
              {
                "kind": "rect",
                "x": 20,
                "y": 80,
                "w": 120,
                "h": 80,
                "fill": "green",
                "label": "W ionic"
              },
              {
                "kind": "rect",
                "x": 150,
                "y": 80,
                "w": 120,
                "h": 80,
                "fill": "grey",
                "label": "X network"
              },
              {
                "kind": "rect",
                "x": 280,
                "y": 80,
                "w": 120,
                "h": 80,
                "fill": "blue",
                "label": "Y molecular"

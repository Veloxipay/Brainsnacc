                "y": 230,
                "text": "use m.p. and conductivity",
                "size": 20,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "W conducts when molten because its ions are then free to move.",
          "write": "molten: ions move"
        }
      ]
    },
    {
      "heading": "Shapes and forces",
      "lines": [
        {
          "say": "H 2 S has two bonding pairs and two lone pairs. It is bent.",
          "write": "H₂S: bent"
        },
        {
          "say": "Water forms hydrogen bonds. H 2 S cannot, sulfur is not electronegative enough.",
          "write": "H₂O: H-bonds;  H₂S: none"
        },
        {
          "say": "So water boils at 100, but H 2 S at about minus 60.",
          "write": "100 °C vs −60 °C"
        },
        {
          "say": "C O 2 is linear. Its two dipoles point opposite ways and cancel.",
          "write": "CO₂ non-polar",
          "draw": {

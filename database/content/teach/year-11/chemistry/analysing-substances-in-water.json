                "change": "add"
              },
              {
                "kind": "circle",
                "x": 320,
                "y": 236,
                "r": 9,
                "fill": "white",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 360,
                "y": 230,
                "r": 9,
                "fill": "white",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 215,
                "r": 9,
                "fill": "white",
                "change": "add"
              },
              {
                "kind": "circle",
                "x": 300,
                "y": 215,
                "r": 9,
                "fill": "white",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Excess means no chloride escapes. The analyte is limiting.",
          "write": "excess reagent"
        },
        {
          "say": "Filter, wash with deionised water, then dry.",
          "write": "filter, wash, dry"
        },
        {
          "say": "Heat and weigh again until the mass stops changing.",
          "write": "heat to constant mass"
        },
        {
          "say": "Then use stoichiometry to find the analyte.",
          "write": "stoichiometry"
        }
      ]
    },
    {
      "heading": "A gravimetric calculation",
      "lines": [
        {
          "say": "A 250.0 millilitre sample gives 0.574 grams of A g Cl.",
          "write": "m(AgCl) = 0.574 g"
        },
        {
          "say": "A g Cl is 143.4 grams per mole. That is 4.003 times 10 to minus 3 moles.",
          "write": "n = 0.574 ÷ 143.4"
        },
        {
          "say": "One to one ratio, so the same moles of chloride.",
          "write": "n(Cl⁻) = 4.003 × 10⁻³ mol"
        },
        {
          "say": "Use 35.5 for chloride, not the precipitate. That gives 0.1421 grams.",
          "write": "m(Cl⁻) = 0.1421 g"
        },
        {
          "say": "Divide by 0.2500 litres. 0.568 grams per litre, or 568 milligrams.",
          "write": "0.568 g L⁻¹ = 568 mg L⁻¹"
        }
      ]
    },
    {
      "heading": "Gravimetric errors",
      "lines": [
        {
          "say": "Wet and dirty weigh more. The result comes out too high.",
          "write": "wet, dirty → too high",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Error effects",
            "items": [
              {
                "kind": "rect",
                "x": 30,
                "y": 70,
                "w": 230,
                "h": 90,
                "fill": "red",
                "label": "not dry / not washed"
              },
              {
                "kind": "rect",
                "x": 300,
                "y": 70,
                "w": 230,
                "h": 90,
                "fill": "blue",
                "label": "lost / not all precipitated"
              },
              {
                "kind": "text",
                "x": 145,
                "y": 210,
                "text": "mass ↑  result ↑",
                "size": 22,
                "color": "red",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 415,
                "y": 210,
                "text": "mass ↓  result ↓",
                "size": 22,
                "color": "blue",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Lost and dissolved weigh less. The result comes out too low.",
          "write": "lost, dissolved → too low"
        },
        {
          "say": "Say what happens to the mass first, then to the result.",
          "write": "mass first, then result"
        }
      ]
    },

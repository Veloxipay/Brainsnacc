{
  "level": "Year 11",
  "subject": "chemistry",
  "title": "Analysing substances in water",
  "frames": [
    {
      "heading": "What and how much",
      "lines": [
        {
          "say": "Qualitative means what is there. Quantitative means how much.",
          "write": "what vs how much"
        },
        {
          "say": "The substance we measure is called the analyte.",
          "write": "analyte"
        },
        {
          "say": "We test water for salt, heavy metals, nitrates and hardness.",
          "write": "salinity, Pb²⁺, NO₃⁻, Ca²⁺"
        },
        {
          "say": "Results are often in milligrams per litre, which is parts per million.",
          "write": "mg L⁻¹ = ppm"
        }
      ]
    },
    {
      "heading": "Gravimetric analysis: weigh the catch",
      "lines": [
        {
          "say": "Add excess silver nitrate to the water. Chloride forms solid A g Cl.",
          "write": "Ag⁺ + Cl⁻ → AgCl(s)",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Precipitate forms",
            "items": [
              {
                "kind": "rect",

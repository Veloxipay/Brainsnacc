    {
      "heading": "Atomic absorption spectroscopy",
      "lines": [
        {
          "say": "A A S measures one metal, even at tiny concentrations.",
          "write": "AAS: ppm or ppb"
        },
        {
          "say": "The sample is sprayed into a flame and atomised.",
          "write": "flame → free atoms"
        },
        {
          "say": "A hollow cathode lamp of the same element shines through.",
          "write": "lamp = same element",

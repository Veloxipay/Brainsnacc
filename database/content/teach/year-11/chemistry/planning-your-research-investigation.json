                "fill": "purple",
                "label": "Purpose"
              }
            ]
          }
        },
        {
          "say": "Purpose matters. Is it written to inform, or to sell?",
          "write": "purpose: inform or sell?",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Purpose highlighted",
            "items": [
              {
                "kind": "rect",

{
  "level": "Year 11",
  "subject": "chemistry",
  "title": "Planning your research investigation",
  "frames": [
    {
      "heading": "What the investigation is",
      "lines": [
        {
          "say": "You pick a topic linked to sustainability and research its chemistry.",
          "write": "sustainability research"
        },
        {
          "say": "Then you analyse sources and communicate what you found.",
          "write": "find, analyse, communicate"
        },
        {
          "say": "Read your teacher’s task and criteria first.",
          "write": "read the criteria first"
        }
      ]
    },

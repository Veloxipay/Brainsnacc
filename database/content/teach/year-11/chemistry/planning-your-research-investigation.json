              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Funnel a big topic into one sharp question.",
          "write": "funnel"
        },
        {
          "say": "CRAAP test every source.",
          "write": "CRAAP"
        },
        {
          "say": "Follow the money, and corroborate.",
          "write": "check bias"
        },
        {
          "say": "Analyse with chemistry, and answer the question.",
          "write": "chemistry + conclusion"
        }
      ]
    }
  ]

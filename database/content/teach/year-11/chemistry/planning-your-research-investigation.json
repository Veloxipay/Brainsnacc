              },
              {
                "kind": "rect",
                "x": 123,
                "y": 90,
                "w": 100,
                "h": 90,
                "fill": "green",
                "label": "Relevance"
              },
              {
                "kind": "rect",
                "x": 231,
                "y": 90,
                "w": 100,
                "h": 90,
                "fill": "orange",
                "label": "Authority"
              },
              {
                "kind": "rect",
                "x": 339,
                "y": 90,
                "w": 100,
                "h": 90,
                "fill": "teal",
                "label": "Accuracy"
              },
              {
                "kind": "rect",
                "x": 447,

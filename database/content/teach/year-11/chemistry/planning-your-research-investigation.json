                "w": 100,
                "h": 90,
                "fill": "purple",
                "label": "Purpose",
                "change": "highlight"
              }
            ]
          }
        },
        {
          "say": "A maker’s page says its cups are 100 percent compostable. No author.",
          "write": "source A: maker’s web page"
        },
        {
          "say": "A peer-reviewed article tested how fast PLA breaks down.",
          "write": "source B: peer-reviewed"
        },
        {
          "say": "Follow the money. Source B is more reliable. Watch for greenwashing.",
          "write": "follow the money"
        },
        {
          "say": "Corroborate. The same fact in several independent sources builds confidence.",
          "write": "corroboration"
        }
      ]
    },
    {
      "heading": "Notes and referencing",
      "lines": [
        {
          "say": "Record each source as you go: author, date, title, URL.",
          "write": "record as you go"
        },
        {
          "say": "Write notes in your own words. Quote marks for direct quotes.",
          "write": "own words, quote marks"
        },
        {
          "say": "Use an in-text citation, then a full reference list.",
          "write": "in-text + reference list"
        },
        {
          "say": "This gives credit and avoids plagiarism.",
          "write": "avoid plagiarism"
        }
      ]
    },
    {
      "heading": "Use the chemistry",
      "lines": [
        {
          "say": "Do not just describe the product. Analyse it with chemistry.",
          "write": "analyse, don’t describe"
        },
        {
          "say": "Use green chemistry principles and atom economy.",
          "write": "principles + atom economy"
        },
        {
          "say": "Ask where it ends up: linear or circular economy?",
          "write": "linear vs circular"
        },
        {
          "say": "Finish with a conclusion that answers your question.",
          "write": "answer the question",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Report parts",
            "items": [

{
  "level": "Year 11", "subject": "chemistry", "title": "Solubility and precipitation",
  "frames": [
    { "heading": "Dissolving an ionic compound",
      "lines": [
        { "say": "Here is solid sodium chloride. It's a lattice of positive and negative ions.", "write": "NaCl(s)",
          "draw": {"type": "shapes", "width": 560, "height": 300, "alt": "A lattice of sodium and chloride ions", "items": [
            {"kind": "circle", "x": 200, "y": 90, "r": 28, "fill": "blue", "label": "Na⁺"},
            {"kind": "circle", "x": 270, "y": 90, "r": 28, "fill": "green", "label": "Cl⁻"},
            {"kind": "circle", "x": 340, "y": 90, "r": 28, "fill": "blue", "label": "Na⁺"},
            {"kind": "circle", "x": 200, "y": 160, "r": 28, "fill": "green", "label": "Cl⁻"},
            {"kind": "circle", "x": 270, "y": 160, "r": 28, "fill": "blue", "label": "Na⁺"},
            {"kind": "circle", "x": 340, "y": 160, "r": 28, "fill": "green", "label": "Cl⁻"},
            {"kind": "text", "x": 280, "y": 260, "text": "ionic lattice", "size": 22, "anchor": "middle"}
          ]}},
        { "say": "Polar water molecules crowd around the ions at the surface of the crystal.",
          "write": "δ− O → cations, δ+ H → anions" },
        { "say": "If those ion dipole attractions win, an ion is pulled out of the lattice.", "write": "ion–dipole attractions",
          "draw": {"type": "shapes", "width": 560, "height": 300, "alt": "A sodium ion is pulled out of the lattice by water", "items": [
            {"kind": "circle", "x": 200, "y": 90, "r": 28, "fill": "blue", "label": "Na⁺", "change": "remove"},
            {"kind": "circle", "x": 270, "y": 90, "r": 28, "fill": "green", "label": "Cl⁻"},
            {"kind": "circle", "x": 340, "y": 90, "r": 28, "fill": "blue", "label": "Na⁺"},
            {"kind": "circle", "x": 200, "y": 160, "r": 28, "fill": "green", "label": "Cl⁻"},
            {"kind": "circle", "x": 270, "y": 160, "r": 28, "fill": "blue", "label": "Na⁺"},
            {"kind": "circle", "x": 340, "y": 160, "r": 28, "fill": "green", "label": "Cl⁻"},
            {"kind": "circle", "x": 470, "y": 90, "r": 28, "fill": "blue", "label": "Na⁺", "change": "add"},
            {"kind": "circle", "x": 470, "y": 40, "r": 14, "fill": "red", "label": "δ−", "change": "add"},
            {"kind": "circle", "x": 520, "y": 90, "r": 14, "fill": "red", "label": "δ−", "change": "add"},
            {"kind": "circle", "x": 470, "y": 140, "r": 14, "fill": "red", "label": "δ−", "change": "add"},
            {"kind": "circle", "x": 420, "y": 90, "r": 14, "fill": "red", "label": "δ−", "change": "add"},
            {"kind": "text", "x": 470, "y": 200, "text": "hydrated ion", "size": 18, "anchor": "middle", "change": "add"}
          ]}},
        { "say": "The ions separate. We call that dissociation.", "write": "NaCl(s) → Na⁺(aq) + Cl⁻(aq)" },
        { "say": "The free ions can move, so the solution conducts electricity.", "write": "ions free → conducts" }
      ] },
    { "heading": "Molecules dissolve whole",
      "lines": [
        { "say": "Glucose is a polar molecule. It hydrogen bonds with water.", "write": "C₆H₁₂O₆(s) → C₆H₁₂O₆(aq)" },
        { "say": "The molecules spread apart, but each one stays whole.",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Ionic compound splits into ions, glucose stays whole", "items": [
            {"kind": "text", "x": 140, "y": 30, "text": "ionic: splits", "size": 20, "anchor": "middle", "bold": true},
            {"kind": "circle", "x": 100, "y": 120, "r": 30, "fill": "blue", "label": "Na⁺"},
            {"kind": "circle", "x": 190, "y": 170, "r": 30, "fill": "green", "label": "Cl⁻"},
            {"kind": "line", "x": 280, "y": 20, "x2": 280, "y2": 250, "color": "grey", "dashed": true},
            {"kind": "text", "x": 420, "y": 30, "text": "molecular: stays whole", "size": 20, "anchor": "middle", "bold": true},
            {"kind": "rect", "x": 360, "y": 90, "w": 120, "h": 60, "fill": "orange", "label": "glucose", "change": "highlight"},
            {"kind": "text", "x": 420, "y": 220, "text": "no ions, no current", "size": 18, "anchor": "middle"}
          ]}},
        { "say": "No ions are made, so a glucose solution does not conduct.", "write": "no ions → no current" },
        { "say": "Non-polar oils and hexane hardly dissolve in water. Like dissolves like.", "write": "like dissolves like" }
      ] },
    { "heading": "How much can dissolve?",
      "lines": [
        { "say": "Solubility is the most solute that dissolves at a set temperature.", "write": "g per 100 g water" },
        { "say": "Less than the maximum? It's unsaturated. More can still dissolve.", "write": "unsaturated",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Two beakers, one unsaturated, one saturated with solid at the bottom", "items": [
            {"kind": "rect", "x": 80, "y": 60, "w": 140, "h": 150, "fill": "teal"},
            {"kind": "text", "x": 150, "y": 240, "text": "unsaturated", "size": 20, "anchor": "middle"},
            {"kind": "rect", "x": 340, "y": 60, "w": 140, "h": 150, "fill": "teal"},
            {"kind": "text", "x": 410, "y": 240, "text": "saturated", "size": 20, "anchor": "middle"}
          ]}},
        { "say": "At the maximum it's saturated. Extra solid just sits on the bottom.", "write": "saturated",
          "draw": {"type": "shapes", "width": 560, "height": 260, "alt": "Extra solid sits at the bottom of the saturated beaker", "items": [
            {"kind": "rect", "x": 80, "y": 60, "w": 140, "h": 150, "fill": "teal"},
            {"kind": "text", "x": 150, "y": 240, "text": "unsaturated", "size": 20, "anchor": "middle"},
            {"kind": "rect", "x": 340, "y": 60, "w": 140, "h": 150, "fill": "teal"},
            {"kind": "rect", "x": 350, "y": 185, "w": 120, "h": 22, "fill": "white", "label": "solid", "change": "add"},
            {"kind": "text", "x": 410, "y": 240, "text": "saturated", "size": 20, "anchor": "middle"}
          ]}},
        { "say": "Supersaturated holds too much for a while. A seed crystal makes the extra crystallise.", "write": "supersaturated: unstable" }
      ] },
    { "heading": "Reading a solubility curve",
      "lines": [
        { "say": "A solubility curve plots solubility against temperature. Here is potassium nitrate.",
          "draw": {"type": "shapes", "width": 560, "height": 320, "alt": "Solubility curve for potassium nitrate", "items": [
            {"kind": "arrow", "x": 80, "y": 280, "x2": 520, "y2": 280, "color": "black"},
            {"kind": "arrow", "x": 80, "y": 280, "x2": 80, "y2": 20, "color": "black"},
            {"kind": "line", "x": 100, "y": 255, "x2": 220, "y2": 230, "color": "blue"},
            {"kind": "line", "x": 220, "y": 230, "x2": 340, "y2": 170, "color": "blue"},
            {"kind": "line", "x": 340, "y": 170, "x2": 460, "y2": 60, "color": "blue"},
            {"kind": "text", "x": 300, "y": 310, "text": "temperature (°C)", "size": 16, "anchor": "middle"},
            {"kind": "text", "x": 470, "y": 50, "text": "KNO₃", "size": 18, "color": "blue"}
          ]}},
        { "say": "On the curve means saturated. Below the curve means unsaturated.", "write": "on = saturated, below = unsat." },
        { "say": "At 60 degrees, 110 grams dissolve. At 20 degrees, only 32 grams.", "write": "60 °C: 110 g   20 °C: 32 g",
          "draw": {"type": "shapes", "width": 560, "height": 320, "alt": "Points marked at 20 and 60 degrees", "items": [
            {"kind": "arrow", "x": 80, "y": 280, "x2": 520, "y2": 280, "color": "black"},
            {"kind": "arrow", "x": 80, "y": 280, "x2": 80, "y2": 20, "color": "black"},
            {"kind": "line", "x": 100, "y": 255, "x2": 220, "y2": 230, "color": "blue"},
            {"kind": "line", "x": 220, "y": 230, "x2": 340, "y2": 170, "color": "blue"},
            {"kind": "line", "x": 340, "y": 170, "x2": 460, "y2": 60, "color": "blue"},
            {"kind": "circle", "x": 220, "y": 230, "r": 8, "fill": "red", "change": "add"},
            {"kind": "text", "x": 230, "y": 260, "text": "20 °C: 32 g", "size": 18, "change": "add"},
            {"kind": "circle", "x": 400, "y": 115, "r": 8, "fill": "red", "change": "add"},
            {"kind": "text", "x": 300, "y": 100, "text": "60 °C: 110 g", "size": 18, "change": "add"},
            {"kind": "text", "x": 300, "y": 310, "text": "temperature (°C)", "size": 16, "anchor": "middle"}
          ]}},
        { "say": "Cool a saturated solution from 60 to 20. 110 take 32 is 78 grams of crystals.", "write": "110 − 32 = 78 g" },
        { "say": "That is per 100 grams of water. In 50 grams, halve it to 39 grams.", "write": "78 × 50 ÷ 100 = 39 g" },
        { "say": "Gases are the opposite. They get less soluble as it warms up.", "write": "gases: hotter → less soluble" }
      ] },
    { "heading": "Swap partners, check the table",
      "lines": [
        { "say": "Mix lead nitrate with potassium iodide. First write the ions.", "write": "Pb²⁺ NO₃⁻  +  K⁺ I⁻",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Ions in each solution", "items": [
            {"kind": "circle", "x": 110, "y": 90, "r": 36, "fill": "purple", "label": "Pb²⁺"},
            {"kind": "circle", "x": 200, "y": 90, "r": 36, "fill": "grey", "label": "NO₃⁻"},
            {"kind": "circle", "x": 360, "y": 90, "r": 36, "fill": "orange", "label": "K⁺"},
            {"kind": "circle", "x": 450, "y": 90, "r": 36, "fill": "yellow", "label": "I⁻"}
          ]}},
        { "say": "Now swap partners. The new pairs are lead iodide and potassium nitrate.", "write": "PbI₂  and  KNO₃",
          "draw": {"type": "shapes", "width": 560, "height": 280, "alt": "Swapped partners: lead iodide and potassium nitrate", "items": [
            {"kind": "circle", "x": 110, "y": 90, "r": 36, "fill": "purple", "label": "Pb²⁺"},
            {"kind": "circle", "x": 200, "y": 90, "r": 36, "fill": "grey", "label": "NO₃⁻"},
            {"kind": "circle", "x": 360, "y": 90, "r": 36, "fill": "orange", "label": "K⁺"},
            {"kind": "circle", "x": 450, "y": 90, "r": 36, "fill": "yellow", "label": "I⁻"},
            {"kind": "arrow", "x": 130, "y": 130, "x2": 420, "y2": 200, "color": "purple", "change": "add"},
            {"kind": "arrow", "x": 340, "y": 130, "x2": 220, "y2": 200, "color": "orange", "change": "add"},
            {"kind": "rect", "x": 360, "y": 205, "w": 140, "h": 50, "fill": "yellow", "label": "PbI₂ (s)", "change": "highlight"},
            {"kind": "rect", "x": 140, "y": 205, "w": 140, "h": 50, "fill": "white", "label": "KNO₃ (aq)", "change": "add"}
          ]}},
        { "say": "Check the table. Iodides are soluble, except with silver and lead.", "write": "I⁻ insoluble with Ag⁺, Pb²⁺" },
        { "say": "So yellow lead iodide falls out as a precipitate.", "write": "PbI₂(s): yellow precipitate" },
        { "say": "If both new pairs are soluble, there's no precipitate. The ions just stay mixed.", "write": "both soluble → no reaction" }
      ] },
    { "heading": "Spectator ions and net equations",
      "lines": [
        { "say": "Silver nitrate plus sodium chloride gives white silver chloride.", "write": "AgNO₃ + NaCl → AgCl(s) + NaNO₃" },
        { "say": "In the full ionic equation, split the soluble compounds into ions.",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Full ionic equation", "items": [
            {"kind": "text", "x": 20, "y": 60, "text": "Ag⁺ + NO₃⁻ + Na⁺ + Cl⁻", "size": 24},
            {"kind": "text", "x": 300, "y": 110, "text": "→ AgCl(s) + Na⁺ + NO₃⁻", "size": 24}
          ]}},
        { "say": "Sodium and nitrate are the same on both sides. They're spectators. Cross them out.", "write": "spectators: Na⁺, NO₃⁻",
          "draw": {"type": "shapes", "width": 560, "height": 200, "alt": "Spectator ions crossed out", "items": [
            {"kind": "text", "x": 20, "y": 60, "text": "Ag⁺", "size": 24},
            {"kind": "text", "x": 80, "y": 60, "text": "+ NO₃⁻", "size": 24, "change": "remove"},
            {"kind": "text", "x": 170, "y": 60, "text": "+ Na⁺", "size": 24, "change": "remove"},
            {"kind": "text", "x": 250, "y": 60, "text": "+ Cl⁻", "size": 24},
            {"kind": "text", "x": 300, "y": 110, "text": "→ AgCl(s)", "size": 24},
            {"kind": "text", "x": 420, "y": 110, "text": "+ Na⁺ + NO₃⁻", "size": 24, "change": "remove"},
            {"kind": "text", "x": 280, "y": 170, "text": "Ag⁺(aq) + Cl⁻(aq) → AgCl(s)", "size": 24, "bold": true, "anchor": "middle", "change": "add"}
          ]}},
        { "say": "What's left is the net ionic equation. It shows only what changes.", "write": "Ag⁺(aq) + Cl⁻(aq) → AgCl(s)" },
        { "say": "Keep the precipitate together as a solid. Never split it into ions.", "write": "AgCl(s), not Ag⁺ + Cl⁻" }
      ] },
    { "heading": "Watch out for these",
      "lines": [
        { "say": "Balance the charges. Lead two plus needs two iodide ions.", "write": "Pb²⁺(aq) + 2I⁻(aq) → PbI₂(s)" },
        { "say": "Only ionic compounds dissociate. Glucose does not split into ions.", "write": "molecular stays whole" },
        { "say": "No precipitate doesn't mean the ions vanished. They're still in solution." },
        { "say": "Curves are per 100 grams of water. Scale for other masses.", "write": "scale if not 100 g water" },
        { "say": "Always include states in a net ionic equation.", "write": "(aq)  (s)" }
      ] },
    { "heading": "Remember",
      "lines": [
        { "say": "Ionic compounds dissociate into hydrated ions. Molecules dissolve whole.", "write": "ionic splits, molecular whole" },
        { "say": "On the curve is saturated. Crystals equal high solubility minus low.", "write": "110 − 32 = 78 g" },
        { "say": "Write the ions, swap partners, check the table.", "write": "swap partners, check table" },
        { "say": "Nitrates, sodium, potassium and ammonium are always soluble.", "write": "NO₃⁻, Na⁺, K⁺, NH₄⁺ soluble" },
        { "say": "Cross out spectator ions to get the net ionic equation.", "write": "net ionic: no spectators" }
      ] }
  ]
}

    {
      "heading": "Watch out for these",
      "lines": [
        {
          "say": "One mole of O 2 is 6.02 times 10 to the 23 molecules, but twice as many atoms.",
          "write": "O₂: 1.204 × 10²⁴ atoms"
        },
        {
          "say": "Oxygen atoms are 16.0, not 32.0.",
          "write": "O = 16.0"
        },
        {
          "say": "Do not forget brackets, or a second atom of the element.",
          "write": "count every atom"
        },
        {
          "say": "Check if the question asks for molecules, atoms or ions.",
          "write": "molecules or atoms?"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "A mole is 6.02 times 10 to the 23 particles.",
          "write": "Nₐ = 6.02 × 10²³"
        },
        {
          "say": "n equals m over M.",
          "write": "n = m / M"
        },
        {
          "say": "Always cross the mole bridge.",
          "write": "mass ⇄ mol ⇄ particles"
        },
        {
          "say": "Write the formula, substitute with units, then answer.",
          "write": "formula → numbers → answer"
        }
      ]

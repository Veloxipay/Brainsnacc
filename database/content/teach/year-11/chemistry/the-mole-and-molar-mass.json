{
  "level": "Year 11",
  "subject": "chemistry",
  "title": "The mole and molar mass",
  "frames": [
    {
      "heading": "Why we need the mole",
      "lines": [
        {
          "say": "A single drop of water holds over a billion billion molecules.",
          "write": "too many to count"
        },
        {
          "say": "Reactions happen between particles in fixed ratios.",
          "write": "2H₂ + O₂ → 2H₂O"
        },
        {
          "say": "Weighing is easy. Counting is impossible. The mole connects them.",
          "write": "mole: weigh to count"
        }
      ]
    },
    {
      "heading": "The mole",
      "lines": [
        {
          "say": "A mole is a chemist’s dozen: 6.02 times 10 to the 23 particles.",
          "write": "1 mol = 6.02 × 10²³"
        },
        {
          "say": "This is the Avogadro constant, N A.",
          "write": "Nₐ = 6.02 × 10²³ mol⁻¹"
        },
        {
          "say": "Always say what the particles are: atoms, molecules or ions.",
          "write": "atoms? molecules? ions?"
        },
        {
          "say": "n equals N over N A. Or N equals n times N A.",
          "write": "n = N / Nₐ"
        },
        {
          "say": "Subscripts are mole ratios. One mole of water holds 2 moles of H.",
          "write": "1 mol H₂O → 2 mol H + 1 mol O",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 290,
            "alt": "Atoms in water",
            "items": [
              {
                "kind": "circle",
                "x": 280,
                "y": 110,
                "r": 40,
                "fill": "red",
                "label": "O"
              },
              {
                "kind": "circle",
                "x": 190,
                "y": 180,
                "r": 28,
                "fill": "white",
                "label": "H"
              },
              {
                "kind": "circle",
                "x": 370,
                "y": 180,
                "r": 28,
                "fill": "white",
                "label": "H"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 265,
                "text": "3 mol of atoms per mol of H₂O",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        }
      ]
    },
    {
      "heading": "Molar mass",
      "lines": [
        {
          "say": "Relative atomic mass compares atoms with carbon 12.",
          "write": "carbon-12 = 12 exactly"
        },
        {
          "say": "Molar mass is the mass of one mole, in grams per mole.",
          "write": "M in g mol⁻¹"
        },
        {
          "say": "Water: 2 times 1.0, plus 16.0. That is 18.0.",
          "write": "H₂O = 18.0 g mol⁻¹"
        },
        {
          "say": "Brackets multiply everything inside. Calcium hydroxide is 74.1.",
          "write": "Ca(OH)₂ = 40.1 + 2(17.0) = 74.1"
        },
        {
          "say": "Use data book values to one decimal place.",
          "write": "use the data book"
        }
      ]
    },

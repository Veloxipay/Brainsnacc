    {
      "heading": "Percentage composition",
      "lines": [
        {
          "say": "What share of a compound’s mass comes from one element?",
          "write": "% by mass"
        },
        {
          "say": "Ammonium nitrate has a molar mass of 80.0.",
          "write": "NH₄NO₃ = 80.0 g mol⁻¹"
        },
        {
          "say": "Count every nitrogen. There are two, so 28.0 grams.",
          "write": "2 × 14.0 = 28.0 g"
        },
        {
          "say": "28.0 over 80.0, times 100, is 35.0 percent.",
          "write": "% N = 35.0%",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Nitrogen share",
            "items": [

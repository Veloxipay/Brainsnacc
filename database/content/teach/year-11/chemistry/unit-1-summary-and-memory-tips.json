    {
      "heading": "Shapes and forces",
      "lines": [
        {
          "say": "Electron groups spread out. Name the shape from the atoms.",
          "write": "VSEPR"
        },
        {
          "say": "Four groups: tetrahedral, then pyramidal, then bent as lone pairs are added.",
          "write": "109.5° → 107° → 104.5°"
        },
        {
          "say": "Polar bonds plus a lopsided shape make a polar molecule.",
          "write": "polar bonds + lopsided"
        },
        {
          "say": "Dispersion forces in all molecules. Dipole–dipole in polar ones.",
          "write": "dispersion, dipole–dipole"
        },
        {
          "say": "H-FON: hydrogen bonding needs H on F, O or N.",
          "write": "H-FON"
        },
        {
          "say": "Diamond, graphite and silicon dioxide are networks with very high melting points.",
          "write": "network lattices"
        }
      ]
    },

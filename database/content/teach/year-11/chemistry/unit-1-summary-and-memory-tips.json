        {
          "say": "This is all of Unit 1 on one page. Start with the atom.",
          "write": "Unit 1 recap"
        },
        {
          "say": "Z counts protons. Neutrons are the big number minus the small number.",
          "write": "n = A − Z"
        },
        {
          "say": "Ions only change the electron count. Iron 56 three plus has 23 electrons.",
          "write": "⁵⁶Fe³⁺: 26 p, 30 n, 23 e⁻"
        },
        {
          "say": "Isotopes: same P, different N.",
          "write": "same P, different N"
        },
        {
          "say": "A r is a weighted mean. It sits closest to the most common isotope.",
          "write": "Aᵣ = Σ(Iᵣ × %) ÷ 100",

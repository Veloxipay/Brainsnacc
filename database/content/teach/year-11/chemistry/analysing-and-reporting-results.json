    {
      "heading": "Validity and conclusions",
      "lines": [
        {
          "say": "Valid means the experiment really tests the hypothesis.",
          "write": "valid = fair test"
        },
        {
          "say": "If temperature changed too, results are not valid, even if precise.",
          "write": "control variables"
        },
        {
          "say": "A conclusion quotes data. Tripled concentration, tripled volume.",
          "write": "0.50 → 1.50: 12.0 → 36.0 mL"
        },
        {
          "say": "Say the hypothesis is supported, not proven.",
          "write": "supported, not proven"
        },
        {
          "say": "Explain it with chemistry, and stay within the range tested.",
          "write": "stay in range"
        }
      ]

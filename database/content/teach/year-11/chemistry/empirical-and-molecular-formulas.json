  "title": "Empirical and molecular formulas",
  "frames": [
    {
      "heading": "Two kinds of formula",
      "lines": [
        {
          "say": "The empirical formula is the simplest whole number ratio of atoms.",
          "write": "empirical = simplest ratio"
        },
        {
          "say": "The molecular formula shows the actual atoms in one molecule.",
          "write": "molecular = actual atoms"
        },
        {
          "say": "Glucose is C 6 H 12 O 6. Divide by 6 and you get C H 2 O.",
          "write": "C₆H₁₂O₆ → CH₂O",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Glucose to empirical",
            "items": [
              {
                "kind": "text",
                "x": 140,
                "y": 130,
                "text": "C₆H₁₂O₆",
                "size": 36,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "arrow",
                "x": 240,
                "y": 120,
                "x2": 330,
                "y2": 120,
                "color": "purple",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 430,
                "y": 130,
                "text": "CH₂O",
                "size": 36,
                "color": "green",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 285,
                "y": 100,
                "text": "÷ 6",
                "size": 22,
                "color": "purple",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "molecular → empirical",
                "size": 20,
                "color": "black",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Sometimes they are the same, like water, H 2 O.",
          "write": "H₂O = H₂O"
        },
        {
          "say": "Ionic and network solids only ever get an empirical formula.",
          "write": "NaCl, SiO₂: empirical only"
        }
      ]
    },

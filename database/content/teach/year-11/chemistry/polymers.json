    {
      "heading": "Bioplastics and recycling",
      "lines": [
        {
          "say": "Most plastics come from crude oil, which is non-renewable.",
          "write": "fossil feedstocks"
        },
        {
          "say": "Bioplastics like P L A are made from plant sugars.",
          "write": "PLA from plants"
        },
        {
          "say": "But bio-based does not mean biodegradable.",
          "write": "bio-based ≠ biodegradable"
        },
        {
          "say": "Mechanical recycling melts sorted thermoplastics. Codes 1 to 7 help sorting.",
          "write": "codes 1–7"
        },
        {
          "say": "Chemical recycling breaks polymers back into monomers.",
          "write": "chemical → monomers"
        },
        {
          "say": "Thermosets cannot be remelted, so they cannot be mechanically recycled.",
          "write": "thermosets: not remeltable"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Addition adds everything. Condensation drips water.",
          "write": "addition vs condensation"
        },
        {
          "say": "Monomer: take two carbons, put the double bond back.",
          "write": "put the C=C back"
        },
        {
          "say": "Structure, then forces between chains, then property.",
          "write": "structure → forces → property"
        },
        {
          "say": "Chocolate melts. Toast chars.",
          "write": "thermoplastic vs thermoset"
        }
      ]
    }

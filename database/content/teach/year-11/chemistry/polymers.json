      "heading": "Monomers and polymers",
      "lines": [
        {
          "say": "A monomer is a small molecule that can join into a long chain.",
          "write": "monomer"
        },
        {
          "say": "A polymer is many repeating monomer units joined by covalent bonds.",
          "write": "polymer = many monomers"
        },
        {
          "say": "Think paper clip chains. A sample is like a bowl of spaghetti.",
          "write": "paper-clip chains"
        },
        {
          "say": "The part of the chain that repeats is the repeating unit.",
          "write": "repeating unit"
        }
      ]
    },

    {
      "heading": "Thermoplastics and thermosets",
      "lines": [
        {
          "say": "A thermoplastic is like chocolate. It melts and can be remoulded.",
          "write": "thermoplastic = chocolate"
        },
        {
          "say": "Only weak forces hold the chains, so heat lets them slide.",
          "write": "chains slide → recyclable"
        },
        {
          "say": "A thermoset is like toast. Heat it more and it just chars.",
          "write": "thermoset = toast"
        },
        {
          "say": "Covalent cross-links lock the chains so they cannot slide.",
          "write": "covalent cross-links",

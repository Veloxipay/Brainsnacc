    {
      "heading": "Comparing melting points",
      "lines": [
        {
          "say": "Aluminium melts at 660 degrees. Sodium melts at 98.",
          "write": "Al 660 °C   Na 98 °C"
        },
        {
          "say": "Aluminium gives 3 electrons per atom. Sodium gives only 1.",
          "write": "Al³⁺ vs Na⁺",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Charge comparison",
            "items": [

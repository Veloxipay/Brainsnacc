                "text": "3 e⁻",
                "size": 20,
                "color": "black",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Al 3 plus is also smaller. So the attraction is stronger.",
          "write": "higher charge, smaller → stronger"
        },
        {
          "say": "That is also why group 1 melting points fall down the group.",
          "write": "group 1 m.p. ↓"
        }
      ]

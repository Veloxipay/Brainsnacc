    {
      "heading": "Reactivity of metals",
      "lines": [
        {
          "say": "Metals react by losing electrons. Easier to lose means more reactive.",
          "write": "lose e⁻ easily → reactive"
        },
        {
          "say": "Kind Nancy Can Make A Zebra Feel Sad, Poor Cute Silver Goldfish.",
          "write": "K Na Ca Mg Al Zn Fe Sn Pb Cu Ag Au"
        },
        {
          "say": "Sodium reacts fast with cold water, making hydrogen gas.",
          "write": "2Na + 2H₂O → 2NaOH + H₂"
        },
        {
          "say": "Metals above hydrogen react with dilute acid. Copper does not.",
          "write": "Zn + 2HCl → ZnCl₂ + H₂"
        },
        {
          "say": "Aluminium seems unreactive, but only because its oxide layer protects it.",
          "write": "Al: oxide layer"
        }
      ]
    },

  "title": "Significant figures, units and the data book",
  "frames": [
    {
      "heading": "What significant figures mean",
      "lines": [
        {
          "say": "A balance reads 12.37 grams. Every digit carries meaning.",
          "write": "12.37 g"
        },
        {
          "say": "The 1, 2 and 3 are certain. The 7 is the best estimate.",
          "write": "certain + 1 uncertain"
        },
        {
          "say": "So this value has 4 significant figures.",
          "write": "4 sig figs",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "12.37 has 4 sig figs",
            "items": [
              {
                "kind": "rect",
                "x": 130,
                "y": 90,
                "w": 54,
                "h": 80,
                "fill": "green",
                "label": "1"
              },
              {
                "kind": "rect",
                "x": 190,
                "y": 90,
                "w": 54,
                "h": 80,
                "fill": "green",
                "label": "2"
              },
              {
                "kind": "rect",
                "x": 250,
                "y": 90,
                "w": 54,
                "h": 80,
                "fill": "none",
                "label": "."
              },
              {
                "kind": "rect",
                "x": 310,
                "y": 90,
                "w": 54,
                "h": 80,
                "fill": "green",
                "label": "3"
              },
              {
                "kind": "rect",
                "x": 370,
                "y": 90,
                "w": 54,
                "h": 80,
                "fill": "green",
                "label": "7"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 240,
                "text": "4 sig figs",
                "size": 24,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Writing 12.370000 would claim a precision the balance does not have.",
          "write": "✗ 12.370000 g"
        }
      ]
    },

    {
      "heading": "Climate and life",
      "lines": [
        {
          "say": "Oceans soak up heat with little temperature change. Coasts stay mild.",
          "write": "mild coastal climates"
        },
        {
          "say": "Sweat evaporates and takes energy from your skin.",
          "write": "sweating cools"
        },
        {
          "say": "Water carries nutrients and wastes in blood, sap and rivers.",
          "write": "transport"
        }
      ]

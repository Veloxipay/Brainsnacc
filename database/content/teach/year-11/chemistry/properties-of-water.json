    {
      "heading": "Specific heat capacity",
      "lines": [
        {
          "say": "Water needs 4.18 joules to warm one gram by one degree.",
          "write": "c = 4.18 J g⁻¹ °C⁻¹"
        },
        {
          "say": "Energy goes into breaking hydrogen bonds, so temperature rises slowly.",
          "write": "slow to heat"
        },
        {
          "say": "Use MCAT: q equals m c delta T.",
          "write": "q = m × c × ΔT"
        },
        {
          "say": "Heat 250 grams from 20 to 80 degrees. Delta T is 60.",
          "write": "ΔT = 80.0 − 20.0 = 60.0 °C"
        },
        {
          "say": "250 times 4.18 times 60 is 62 700 joules, or 62.7 kilojoules.",
          "write": "q = 62.7 kJ",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Energy for heating",
            "items": [
              {
                "kind": "rect",

    {
      "heading": "Latent heats",
      "lines": [
        {
          "say": "During melting or boiling, the temperature stays the same.",
          "write": "constant temperature"
        },
        {
          "say": "Melting cracks some bonds. Fusion needs 6.01 kilojoules per mole.",
          "write": "fusion 6.01 kJ mol⁻¹",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 280,
            "alt": "Latent heats",

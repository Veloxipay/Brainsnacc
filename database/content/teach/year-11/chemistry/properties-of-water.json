          "say": "Boiling breaks them all. Vaporisation needs 40.7.",
          "write": "vaporisation 40.7 kJ mol⁻¹"
        },
        {
          "say": "Use q equals n delta H, with moles, not grams.",
          "write": "q = n × ΔH"
        },
        {
          "say": "Boil 36.0 grams. That is 2.00 moles, so 81.4 kilojoules.",
          "write": "2.00 × 40.7 = 81.4 kJ"
        }
      ]

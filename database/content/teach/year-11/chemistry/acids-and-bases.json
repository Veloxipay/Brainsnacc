                "kind": "text",
                "x": 280,
                "y": 200,
                "text": "− H⁺",
                "size": 18,
                "color": "red",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Remove one H plus and lower the charge by one.",
          "write": "H₂SO₄ → HSO₄⁻"
        },
        {
          "say": "Not S O 4 two minus. That removes two.",
          "write": "✗ SO₄²⁻"
        },
        {
          "say": "Add one H plus and raise the charge by one.",
          "write": "CO₃²⁻ → HCO₃⁻"
        }
      ]
    },
    {
      "heading": "Amphiprotic and polyprotic",
      "lines": [
        {
          "say": "Amphiprotic means ambidextrous. It can donate or accept.",
          "write": "amphiprotic"
        },
        {
          "say": "Water is a base with H Cl, but an acid with ammonia.",
          "write": "H₂O: both"
        },
        {
          "say": "Hydrogen carbonate can give a proton, or take one.",
          "write": "HCO₃⁻ → CO₃²⁻ or H₂CO₃"
        },
        {
          "say": "H 2 S O 4 is diprotic. H 3 P O 4 is triprotic. One proton at a time.",
          "write": "mono-, di-, triprotic"
        }
      ]
    },

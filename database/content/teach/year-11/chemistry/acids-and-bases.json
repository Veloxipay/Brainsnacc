  "title": "Acids and bases",
  "frames": [
    {
      "heading": "The Brønsted–Lowry model",
      "lines": [
        {
          "say": "Acid–base reactions are about passing a proton, H plus.",
          "write": "H⁺ = a proton"
        },
        {
          "say": "An acid donates a proton. A base accepts it.",
          "write": "acid donates, base accepts"
        },
        {
          "say": "Think of H plus as a hot potato. The acid throws it.",
          "write": "HCl + H₂O → H₃O⁺ + Cl⁻",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Proton transfer",
            "items": [
              {
                "kind": "circle",
                "x": 130,
                "y": 140,
                "r": 50,
                "fill": "orange",
                "label": "HCl"
              },
              {
                "kind": "circle",
                "x": 430,
                "y": 140,
                "r": 50,
                "fill": "blue",
                "label": "H₂O"
              },
              {
                "kind": "circle",
                "x": 185,
                "y": 110,
                "r": 14,
                "fill": "red",
                "label": "H⁺",
                "change": "remove"
              },
              {
                "kind": "arrow",
                "x": 200,
                "y": 110,
                "x2": 370,
                "y2": 110,
                "color": "red",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 230,
                "text": "acid",
                "size": 22,
                "color": "orange",
                "anchor": "middle",
                "bold": true
              },
              {
                "kind": "text",
                "x": 430,
                "y": 230,
                "text": "base",
                "size": 22,
                "color": "blue",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "Water catches it and becomes the hydronium ion, H 3 O plus.",
          "write": "H₃O⁺ = hydronium"
        },
        {
          "say": "Ammonia is a base. It takes a proton from water.",
          "write": "NH₃ + H₂O ⇌ NH₄⁺ + OH⁻"
        }
      ]
    },
    {
      "heading": "Conjugate pairs",
      "lines": [

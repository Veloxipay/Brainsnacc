    {
      "heading": "Writing formulas",
      "lines": [
        {
          "say": "Total positive charge must equal total negative charge.",
          "write": "charges balance"
        },
        {
          "say": "Aluminium is 3 plus, oxide is 2 minus. Swap and drop.",
          "write": "Al³⁺ O²⁻ → Al₂O₃",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Swap and drop",
            "items": [
              {
                "kind": "text",
                "x": 160,
                "y": 110,
                "text": "Al³⁺",
                "size": 40,

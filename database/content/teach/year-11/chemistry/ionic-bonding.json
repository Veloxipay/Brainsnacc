  "title": "Ionic bonding",
  "frames": [
    {
      "heading": "How ions form",
      "lines": [
        {
          "say": "Atoms gain or lose electrons to get a full outer shell.",
          "write": "aim: octet"
        },
        {
          "say": "Sodium, 2 8 1, loses one electron. It becomes Na plus.",
          "write": "Na 2,8,1 → Na⁺ 2,8",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Electron transfer",
            "items": [
              {
                "kind": "circle",
                "x": 130,
                "y": 140,
                "r": 60,
                "fill": "blue",
                "label": "Na"
              },
              {
                "kind": "circle",
                "x": 420,
                "y": 140,
                "r": 60,
                "fill": "green",
                "label": "Cl"
              },
              {
                "kind": "circle",
                "x": 200,
                "y": 90,
                "r": 10,
                "fill": "orange",
                "change": "remove"
              },
              {
                "kind": "arrow",
                "x": 220,
                "y": 90,
                "x2": 350,
                "y2": 90,
                "color": "orange",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 250,
                "text": "one electron moves from Na to Cl",
                "size": 20,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "Chlorine, 2 8 7, gains that electron. It becomes Cl minus.",
          "write": "Cl 2,8,7 → Cl⁻ 2,8,8"
        },
        {
          "say": "Metals lose, non-metals gain.",
          "write": "metals lose, non-metals gain"
        },
        {
          "say": "Group 1 is plus 1, group 2 plus 2. Group 17 is minus 1.",
          "write": "1:+1 2:+2 13:+3 15:−3 16:−2 17:−1"
        }
      ]
    },

                "size": 28,
                "color": "purple",
                "anchor": "middle",
                "bold": true,
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Magnesium and oxide give Mg 2 O 2. Simplify it to MgO.",
          "write": "Mg₂O₂ → MgO"
        },
        {
          "say": "Polyatomic ions are locked boxes. Use brackets for more than one.",
          "write": "Ca(NO₃)₂"
        },
        {
          "say": "Calcium phosphate needs 3 calcium and 2 phosphate. Plus 6, minus 6.",
          "write": "Ca₃(PO₄)₂"
        }
      ]
    },
    {
      "heading": "Naming",
      "lines": [
        {
          "say": "Name the cation first, then the anion.",
          "write": "sodium chloride"
        },
        {
          "say": "Ide is alone. Ate has oxygen.",
          "write": "chloride vs sulfate"
        },
        {
          "say": "For iron oxide, three O 2 minus make minus 6.",
          "write": "Fe₂O₃: 3 × (−2) = −6"
        },
        {
          "say": "So two irons give plus 6. Each is iron 3 plus.",
          "write": "iron(III) oxide"
        },
        {
          "say": "No di or tri in ionic names. M g Cl 2 is magnesium chloride.",
          "write": "✗ magnesium dichloride"
        }
      ]
    },

    {
      "heading": "Crystals",
      "lines": [
        {
          "say": "Ionic compounds form crystals with flat faces and regular shapes.",
          "write": "crystals"
        },
        {
          "say": "Slow cooling or evaporation gives fewer, larger crystals.",
          "write": "slow → big crystals"
        },
        {
          "say": "Fast cooling gives many small crystals.",
          "write": "fast → small crystals"
        }
      ]
    },
    {
      "heading": "Remember",
      "lines": [
        {
          "say": "Metals lose electrons, non-metals gain.",
          "write": "metals lose, non-metals gain"
        },
        {
          "say": "Swap and drop, then simplify. Check the charges balance.",
          "write": "swap, drop, simplify"
        },
        {
          "say": "Polyatomic ions are locked boxes in brackets.",
          "write": "(NH₄)₂SO₄"
        },
        {
          "say": "Conducts only when ions can move: molten or dissolved.",

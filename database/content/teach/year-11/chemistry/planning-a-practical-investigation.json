              {
                "kind": "text",
                "x": 280,
                "y": 230,
                "text": "direction + scientific reason",
                "size": 20,
                "color": "purple",
                "anchor": "middle",
                "bold": true
              }
            ]
          }
        },
        {
          "say": "If concentration goes up, hydrogen per minute goes up, because of more collisions.",
          "write": "more collisions"
        },
        {
          "say": "Results support or refute a hypothesis. They never prove it.",
          "write": "support, never prove"
        }
      ]

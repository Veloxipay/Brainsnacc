    {
      "heading": "Watch out and remember",
      "lines": [
        {
          "say": "Boiling does not break covalent bonds.",
          "write": "✗ covalent bonds break"
        },
        {
          "say": "Dispersion forces are always there, even in polar molecules.",
          "write": "dispersion: always"
        },
        {
          "say": "Hydrogen bonding is FON only. Never C H.",

    {
      "heading": "Dispersion forces",
      "lines": [
        {
          "say": "Electrons move. For an instant, one side can be slightly negative.",
          "write": "instantaneous dipole",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Instantaneous dipole",
            "items": [
              {
                "kind": "circle",
                "x": 170,
                "y": 150,
                "r": 70,
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 155,
                "text": "δ+",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 210,
                "y": 155,
                "text": "δ−",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "That dipole induces a dipole in the next molecule.",
          "write": "induced dipole",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Induced dipole",
            "items": [
              {
                "kind": "circle",
                "x": 170,
                "y": 150,
                "r": 70,
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 130,
                "y": 155,
                "text": "δ+",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "text",
                "x": 210,
                "y": 155,
                "text": "δ−",
                "size": 22,
                "color": "black",
                "anchor": "middle"
              },
              {
                "kind": "circle",
                "x": 390,
                "y": 150,
                "r": 70,
                "fill": "blue"
              },
              {
                "kind": "text",
                "x": 350,
                "y": 155,
                "text": "δ+",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "change": "add"
              },
              {
                "kind": "text",
                "x": 430,
                "y": 155,
                "text": "δ−",
                "size": 22,
                "color": "black",
                "anchor": "middle",
                "change": "add"
              }
            ]
          }
        },
        {
          "say": "Dispersion forces act between all molecules.",
          "write": "all molecules"
        },
        {
          "say": "More electrons means stronger forces. Chlorine is a gas, iodine a solid.",
          "write": "F₂ Cl₂ gas → Br₂ liquid → I₂ solid"
        },
        {
          "say": "Straight chains touch more, like spaghetti. Branched ones are meatballs.",
          "write": "pentane 36 °C > branched ≈ 10 °C"
        }
      ]
    },
    {
      "heading": "Dipole–dipole and hydrogen bonds",
      "lines": [
        {
          "say": "Polar molecules have a permanent dipole. Opposite ends attract.",
          "write": "δ+ ··· δ−"
        },
        {
          "say": "Hydrogen bonding is FON. H must be bonded to F, O or N.",
          "write": "H on F, O or N",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 300,
            "alt": "Hydrogen bond between waters",
            "items": [
              {
                "kind": "circle",
                "x": 150,
                "y": 140,
                "r": 34,
                "fill": "red",
                "label": "O"
              },
              {
                "kind": "circle",
                "x": 220,
                "y": 190,
                "r": 18,
                "fill": "white",
                "label": "H"
              },
              {
                "kind": "circle",
                "x": 100,
                "y": 190,
                "r": 18,
                "fill": "white",
                "label": "H"
              },
              {
                "kind": "circle",
                "x": 380,
                "y": 140,
                "r": 34,
                "fill": "red",
                "label": "O"
              },
              {
                "kind": "circle",
                "x": 450,
                "y": 190,
                "r": 18,
                "fill": "white",
                "label": "H"
              },
              {
                "kind": "circle",
                "x": 330,
                "y": 90,
                "r": 18,
                "fill": "yellow",
                "label": "••"
              },
              {
                "kind": "line",
                "x": 238,
                "y": 180,
                "x2": 350,
                "y2": 105,
                "color": "purple",
                "dashed": true,
                "change": "add"
              },
              {
                "kind": "text",
                "x": 280,
                "y": 270,
                "text": "H on O attracted to a lone pair",
                "size": 20,
                "color": "purple",
                "anchor": "middle"
              }
            ]
          }
        },
        {
          "say": "The H is attracted to a lone pair on a neighbour.",
          "write": "O–H ··· O"
        },
        {
          "say": "C H bonds never count. Carbon is not electronegative enough.",
          "write": "✗ C–H"
        },
        {
          "say": "A hydrogen bond is a force between molecules, not a covalent bond.",
          "write": "still intermolecular"
        }
      ]
    },
    {
      "heading": "The burger checklist",
      "lines": [
        {
          "say": "Every molecule gets the bun: dispersion forces.",
          "write": "1. dispersion",

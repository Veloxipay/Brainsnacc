        {
          "say": "If H is on F, O or N, add the cheese: hydrogen bonding.",
          "write": "3. H on FON? H-bonding",
          "draw": {
            "type": "shapes",
            "width": 560,
            "height": 260,
            "alt": "Burger step 3",
            "items": [
              {
                "kind": "rect",

        },
        {
          "say": "H 2 S is polar, but no FON. Dispersion and dipole–dipole.",
          "write": "H₂S: dispersion + dipole"
        },
        {
          "say": "Methanol has O H. So it has all three.",
          "write": "CH₃OH: all three"
        }
      ]
